      "id": "coalesced:b7b5d5e80456255f539a061e2d8b8eb2908506296095aec31dc8fabb6144a40d",
      "source_sha256": "6ecff0ee62d094861603e03684d837b3b67735cb65ee4122d1b5a820e8929764",
      "translation": "能帮上忙啊……"
    },
