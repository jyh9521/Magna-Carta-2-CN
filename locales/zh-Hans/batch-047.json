{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:078c2234b8655573c6c115e4eb2bede2a11d65daac55075226c3b607349c6504",
      "source_sha256": "e8ab5de22b3c0e63929c5c60c45a38c39b956f440864c9a5587b2a85560d95f0",
      "translation": "啊……这是！"
    },
    {
      "id": "coalesced:2bd4ef4b0ab40b5503d3d45d1de632051b8f3c8f42f7124228077ce00539e2ee",
      "source_sha256": "e8cea59cfaba019f55b398ce636746d85df0dea8b93a403a12ef5572fb0a35e5",
      "translation": "啊，那、那个是……"
    },
    {
      "id": "coalesced:046d37c80e445863cf96c9789974374dc5c58122bff5a8138abd1ff8a0c04bad",
      "source_sha256": "775e746501dcc6a1f88fb9527c913d36e1a4ecb4d6fe929f901448352ba096a4",
      "translation": "有好多个朱特哥哥！"
    },
    {
      "id": "coalesced:6eb6fcdd7773b84d96919c287136c14ecb8410a6823e0711110f2f20c3f45db7",
      "source_sha256": "51c5af4f1ebb00e9257ce9c5e75e48922d23831b705fb0b9f289c635e58ab56e",
      "translation": "这到底都是什么！？"
    },
    {
      "id": "coalesced:e1da89b0f118a5c05dbf6a82ec27c37d622e67980076b3d42813e7f62c787e2b",
      "source_sha256": "32e5b05cd783f21e3fa6d2cf50b31f03352f383e2d811467dfd513018c5b3f33",
      "translation": "这些是为了制造艾尔加而准备的躯体。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47f740d9e2117ad7df006ab1fa9a69721a1829001a0249514f8bcc500a144596",
      "source_sha256": "2b36782a5e9246c23f8bfeb530d3f1a69280c7f3c6994b910f2c7ee16bc5f480",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:1e456661f2c788aae63e6ebfd62c4c6295b8662116a1b5b4420632cedfe5aed2",
      "source_sha256": "42c3fc0dce3b7fcf3995bac2a65d9b053180a624b1540981fa05ae62360ece95",
      "translation": "制造……？"
    },
    {
      "id": "coalesced:5d666ecd71e48a828b9f60bcf35613be34d8a9b0d22903986b5a9ed23455329d",
      "source_sha256": "a70577efe1ad56b6961a0ee711e8f8d36dd0e3b3721d831039565d24f985bfc8",
      "translation": "看来……你还没恢复到那部分记忆啊？"
    },
    {
      "id": "coalesced:a2f822766cc886308e1bcf02bb28b0f314a7d9fe93ecf6663628e30b1f38e677",
      "source_sha256": "f7022f9e05f60da08154fc6c524c48df1bd8e4b226c086efad48224f20aadc0d",
      "translation": "说吧，那些到底是什么。"
    },
    {
      "id": "coalesced:ab3a006eb6293dc51c4c1db9c15596a9d1a735bad18288f9ec476c565ade7284",
      "source_sha256": "6ebd19b28ff18e0bea7261c1746e940a69f44a46c3788aa8fcb399a79c4e25af",
      "translation": "艾尔加……是由主人修恩扎伊特创造出来的存在。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55cf1b480444d945150feadba364e9b05488e1730a1824df1cd590887c59c93c",
      "source_sha256": "08f2c27deda8e3a7c5bad1ff285f9bfa8ece3cdd774a2f4129a528a4dad8f229",
      "translation": "通过名为血之契约的连环术创造……硬要说的话，就是人形哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f1493ebf3fb95adf5fc7f2520a95c9c5c8e55a76d851985e6adb7785cfae944",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:7a61b26a42d50f9ba2b05fb57a300bc2d106ddb9caa436bca7a8951b0c1d887b",
      "source_sha256": "8651e6df08c1c30ad122f299635fa359c480a4539856bacd11605f4cd394d161",
      "translation": "人形哨兵？"
    },
    {
      "id": "coalesced:2b06d06d6f929164f6e48ff7b0e51d6846df83ea686f360033aa0d65f5009524",
      "source_sha256": "e1161191bc9f76ceb3ea46b58c364722b4af384cb7beac17a9db14893836cdc7",
      "translation": "以怪物身体为基础制造的哨兵，智力十分低下，完全无法理解复杂的命令。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7594ec27a7a617eb3e2c81f04e598b004eb1d3de187997486e69b0b5396da2c6",
      "source_sha256": "749141a671a40a43ff9bf1aa46f4e9f4328e9fa39751cdc54181b87b674b5823",
      "translation": "所以，为了暗杀反对自己的贵族势力，修恩扎伊特想要智力更高的哨兵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:686025bcd7d7c1bf7e105685ad26a7219ec34db7ad3398696c2357e1d2513989",
      "source_sha256": "c5832daf4ebd80a564af8b756807322e91b2c70e6a64a80b62d14048f3aba75b",
      "translation": "其结果，就是艾尔加。"
    },
    {
      "id": "coalesced:470406d9e8c8c4a10b230c1b8759ccf2b19359017566b60abf7e819cee0bc82e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:a12d161b4024009bcf3339fb0627aa5e97724f873048439354206dcfc738af74",
      "source_sha256": "f8a40037077fff343446d2882464874ac1f65486a640867d9e14a00d0be570a6",
      "translation": "施行血之契约的是修恩扎伊特，但制造这具躯体的人，是我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b50840082fb2a4c8d8be1cb81da9b772ef8b57b7cfd7d385e3715b1b542d20e",
      "source_sha256": "2b36782a5e9246c23f8bfeb530d3f1a69280c7f3c6994b910f2c7ee16bc5f480",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:d10898f608d98ba36956b31873f8030e3905ef44cf8fde73897b46b39705d42f",
      "source_sha256": "7f1ee8fb9c8878253fb8354c7572ebebaea913d3aac583bc741f22009fce000e",
      "translation": "虽然我也是受到威胁，迫不得已才被强逼着制造的……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76c38ac6022293a7b37e4816f8c30532455fa3585987e88064bc54d42ef82f66",
      "source_sha256": "e2bd230082820e7348bbb39d620d8bc80d73005de7a0d77b613791fd52530de6",
      "translation": "你是最初制造出来的一号艾尔加。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f8e484f911446e41034301dc8a1ffa7a094d9fdd73b42217984a1dc00e8c0e2",
      "source_sha256": "b646d0d100b18dd9c8a5498685bf04a3c8892e12019b990fe511c5102001d3e1",
      "translation": "而他们以为你死了，为了取代你制造出来的，就是二号艾尔加。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0009b04018d5983cb8a2355b94f97ccf5302806eff90ae14fe8f8265e3b9863d",
      "source_sha256": "49dda9e1822a045c2acacd336eea9e188ac637f2265217f8440eabbc042d2b75",
      "translation": "所以……要是第二个也死了，你们就打算用剩下的这些躯体，继续制造第三个、第四个？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:371167ef332bd469dbae43d80d8ba4f65b42d1a9e6e472cdefecb0c936f55ae2",
      "source_sha256": "f07e0f7082fd5175a46c19a39fbc5f69a31147da03288c791fdb6727b5255ef7",
      "translation": "……大概会吧。真的很抱歉。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb5fc30831e53f531a7180c3fbf27f0b1fe99ed4bfc0857bab60b7477e4bdee7",
      "source_sha256": "918b0dc5aed6219ffcce6f0302c8e35bd4dea0407dd3c5d380950353a76e0fa5",
      "translation": "算了。反正你也是受修恩扎伊特指使，才那么做的吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bfc210c41036db5b4ce9e93d006995900aa6447b6959182b12fc0558259991a8",
      "source_sha256": "71bf51ce74a42f86e89db451618f75112c9b3deb8772fc56c950c9f4a0a0c711",
      "translation": "怎么能做出这种事……太过分了。"
    },
    {
      "id": "coalesced:0dd600fbe4d78cb36db5248696e051927ff9bd640b7f61ccb54149040e17686f",
      "source_sha256": "0b111ffa45c98140fe3a04f75257d568bbc9769387b115c310235791260ea5ba",
      "translation": "想起来了。……没错，我第一次睁开眼睛，就是在这个房间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:800ae6a415dbcc68027e344db06586d3468997c2bf1c21732a7d0cc4e75bcc50",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:f828304f0e8c53620ca00cc93b34d5794de034a5fb406d1f65cf29744a9db778",
      "source_sha256": "e79c9711a241db97af0afb93b7ed1bdaab49153a811f7da49048ee9734ec8bfb",
      "translation": "尼克斯，你也……在场。睁开眼睛时，我第一个看见的人就是你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d61a6a5143d05985f74293aae7d4485ebdf39166393717094a63ceece1d4012",
      "source_sha256": "45dac68c8a1e519747df119c0367b0853ed9595e6f739fac4f7199a63d0177f9",
      "translation": "艾尔加，你的记忆……"
    },
    {
      "id": "coalesced:cea06448e1df5c219cd16209bad84e4649c7c269f6446062d914217c7bda3576",
      "source_sha256": "f2d6f8303054e9094ebbfabf13e4b69056b583342be2b4950567053c686c5614",
      "translation": "嗯……是啊，好久不见了，尼克斯。"
    },
    {
      "id": "coalesced:8d4d19eea13893fd65a617361226dc0b700600a886c148ce85aeeca4645138c9",
      "source_sha256": "b425da13a82019028c980c97b55ac34b2448c733c4d4d2c35df73bf34a1ab694",
      "translation": "我现在想起来了。"
    },
    {
      "id": "coalesced:a5d61342f12f4c732cb64a605bdf646d9bb6878f00b49e333a2b874e894c35af",
      "source_sha256": "5397f42f4d2da25802db0b43d15b78412527f6b70519d6b0891d37c9fc61da1b",
      "translation": "你找回记忆了啊。"
    },
    {
      "id": "coalesced:651779a1ba703279f7961f1a72ce239b60cc86bc91a3e4a15427b0663f8a24c0",
      "source_sha256": "f1d3367888a713d81c82312b7abd6fcd20dbd2117a55f6ca258e3d1126e6e955",
      "translation": "因为只有你对我好。其他人都害怕我，把我当成怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b49b3e4a585a9394ff1ed4b7c2893f978c83f855afe22dd9b2fce003790f5445",
      "source_sha256": "2e52886e54e83fbdf0e204b25de2b441c5ec0e01ede492e72c0bc202f6607288",
      "translation": "听到你死了的消息时，我真的很痛苦，心想自己究竟造下了什么孽……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:04824a321f0b44c6ee477dc14ecf4a5a02652264a2bc884cad461fc38dc15908",
      "source_sha256": "ea21c23ccd25a8a5b74002d0220f10fa39edd9c0f1639f03425d096078a28fc8",
      "translation": "多亏你还活着……我的罪恶感，也多少减轻了一些。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8cb6b1c94bea8488b17445ad760c1974bae197f22896754a9c72a2b642dda8c9",
      "source_sha256": "f9dec4db48887ec41d2af4ab710b8a18bab3eba202b187f1bd229c17a06c4f39",
      "translation": "这里的资料，如今应该全部销毁了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ababfb1da8d8c0f87b6256ffb703f848fb61c2e507e033907cd1d9dc582c2b75",
      "source_sha256": "c3cb8966a148cd09d2d2d781189b9c8720797e6e468374ba6ddf420f6c957954",
      "translation": "就这么做吧。别再让第三个诞生了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d73c61795d5f126ba03e1483be4c18072e155f2726cf02c820dfc3fc2aac92ba",
      "source_sha256": "0d070a79393b8e907da2971173042d2f8d4501e243d9546dd00fdab753b71901",
      "translation": "哥哥……"
    },
    {
      "id": "coalesced:e345f4211a3a1880ab203f31278f08d573d9b7f623d0f51d0b2a9345d236de1a",
      "source_sha256": "08ddfd25122bbd55ae75bc436496b31dec42c809f122cf3f2a6311c42f53ee6b",
      "translation": "我没事。"
    },
    {
      "id": "coalesced:d2b5248da9f308de65a528955340cdc15179499104f983d0dad335417bc98421",
      "source_sha256": "b2933c0bba28a94e1efcd6b2a8a063378077f61497f5de343aafccdc3ebef01c",
      "translation": "不过，这种地方为什么会有公主的画像？"
    },
    {
      "id": "coalesced:2433e72a24d4feba4e1b21eb24b794e5d85aef15c4191db37241b8a2eec9c62b",
      "source_sha256": "306b5753a4359c7a963302325bd922e2be1b1617b87519f479c6d1af762b82d2",
      "translation": "洁菲……？"
    },
    {
      "id": "coalesced:be0625961e3ac4589ba26f9cf408deeb3b23636aab52041c2cfa3a79e4ee896d",
      "source_sha256": "eab44b145742f50f72fd07c3ed65d72d95a92946492bf0d1a2ecf5f63ee93dd0",
      "translation": "那是……因为一道命令。"
    },
    {
      "id": "coalesced:bae0453dbbaa540b58512f9ec471fc79bdb3fe93a10877381d519f95b93edccc",
      "source_sha256": "ccb56bc7304b6d8e90d2f6ea35ca69dc1d5ae1acc32ef0d6ff5f4e3ec3dcf5df",
      "translation": "艾尔加第一次睁开眼睛时，修恩扎伊特就下达了强有力的命令，将其束缚。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b57e796162ce1b1d69f28722088f9e29e4b263280d15717cbdba9fb3f562cec7",
      "source_sha256": "2cf45e28fd2e3f5a3522a45536ee1daa65449d88c0c5494a7115e26fd24ad980",
      "translation": "那道命令，就是既不能杀死公主，也不能放任她死去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:268dfa8c8c63a4849683896f11e7a54f8ead31270f10ce2a68a203075ca8783c",
      "source_sha256": "c28b645fcd1180c6316a2efe0f31697d0a9a8c1cc105169b112da5232b4e786f",
      "translation": "主人只能对哨兵下达一次“绝对命令”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:318092b7f47151d1d3abfe6801a7e96d97c7461991e362e4b8ae65f71c641348",
      "source_sha256": "58293d3f73ab36b141b4050f401755e2c054864bd3af99a98f8cd1595cc5deb3",
      "translation": "那道命令会刻在卡蒙德上，留在哨兵的脑海里。此后，直到死都无法违抗。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e659d46044e3030ebcde2bfe0dc3b55ab57a3bee8b4a68fe166c050af578f164",
      "source_sha256": "3daf831b8d2150180525ab38c5f48841ed14847505637b56222e5d6e817e6649",
      "translation": "不能杀她。也不能放任她死去。这是比你的性命更加重要的命令。绝对不能让她死去……",
      "line_break_policy": {
        "source_count": 3,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7306698187d6469ad298dd1c4f1b5e65b6fc4c82ac5096f04a87a1f169ab999",
      "source_sha256": "224b07174e27f979aec6d3381fb71866f0662de40c01c71d67a9cf24249b2b54",
      "translation": "没错……那是修恩扎伊特的命令。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:241edbcf100bf150305e0f9186a96fb5f13bb1dde93bd40ae8d50c12e1d923c8",
      "source_sha256": "209e12047f8e64a602798ea7ec36093db7a34c1f30148b3b48a19c3ebaee56ae",
      "translation": "当时，尼克斯应该也在吧？"
    },
    {
      "id": "coalesced:056fcbd1106dbb85fecf372a5f38a2ff23ccc4fb1187e9cefe7ef0dd4e5be626",
      "source_sha256": "3a0cf631fb7254e836d6accd05f542ca1ad572a1d55769c704295aee099e1b88",
      "translation": "是的。我也在那场仪式上。"
    },
    {
      "id": "coalesced:a138dfaf768d1a7474d8da78677ecded180e9cca552381b012e998766877d507",
      "source_sha256": "87bcf4d5c8564a258dc388f97d2c5add597bb88f6f4978946221f014171d58e9",
      "translation": "其实，那时修恩扎伊特称公主为“玛格纳卡尔塔”，你还记得吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40513289af37ab9e9997a606c2363fba54986f00825bc0b77aab6a91ebb8ea0a",
      "source_sha256": "b1252dd1a1b4f241249410a4611a9b952df75701d13b0ecbc6ea7807d2e7387e",
      "translation": "玛格纳卡尔塔？为什么……"
    },
    {
      "id": "coalesced:c5cbd42ba87125bf87cfa20a4aa533c2fd80b958b5fa3fdd887d69f2d41e1feb",
      "source_sha256": "a355695de5c1ae6ca22609d9b2aa9d6866e5f7c896fa55d2baf75fb9ce27994e",
      "translation": "她是珍贵的玛格纳卡尔塔。必须在战场上不断打磨，直到她体内的卡蒙德成为完美的宝石。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdaa3cb318e8c3e608e8f7d5fc2c7dd51ffbcaf7f6901ad9d71513f68de27824",
      "source_sha256": "cbf8b90e47c45203165f913241a17c94dea18bbdc32abdaab2084efa3d326922",
      "translation": "修恩扎伊特确实是这么说的。"
    },
    {
      "id": "coalesced:718f45ec83fe62ce69b087fc7deb7a71981c635d3d8ca98451edd2aa354a2c1e",
      "source_sha256": "1b142a766ca11e766c7df8248d7d15c8fe39bfb9cf246cab9a9de3928084b2fd",
      "translation": "朱特哥哥，你没事吧？脸色好苍白！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbd81ec4bffd0287b3f946c5b839e877c8ca477ca2ee4cce8a77bcbaccf022fb",
      "source_sha256": "ac7ea729f1c530aaf8288de8c3adbacf9c0d14085e938144e954f5b015c187bd",
      "translation": "有种不好的预感……看来，必须赶快救出洁菲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6213901eeb3aec8d9439c4223f852348158ff48c611c0817cd21aa58b29987f",
      "source_sha256": "3e446a3f52d0a1c274cec59299fd40146cd004954e1223f173bdc5388a6e84d8",
      "translation": "我明白了。我们抓紧时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f2608fa278f5cdcc8a3e00a495913c36e8799b5283bd9acae97f077e5182988",
      "source_sha256": "e44a2ef55ac8756cbdf728c041e33a665afba52f369cf1eea4fa35ce561fc04b",
      "translation": "向我涌来的，尽是痛苦的真相。"
    },
    {
      "id": "coalesced:7570fe79c46399433a9035dd6e7b53b3da73108018cb688cae390206cff3650d",
      "source_sha256": "e3d6ed4cfd4a4d197b99d62145887ecd518d7c3a4435347eb4ae541d68799033",
      "translation": "脑海中仿佛被暴风席卷，一片混乱，可不知为何，胸口却空空荡荡。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59730736e098c7aabea5ddd6354f94503ffe537b17dcba3881b7440d6e576821",
      "source_sha256": "c268a0d6af65858f4ed7b45ee44299813049e4f1160b7525342e60166fc5a43f",
      "translation": "这样的过去，还不如不知道才好……"
    },
    {
      "id": "coalesced:0d21791d391a0209913f3b3b0e9e946e85cd8b640ad219925f7aab3bb4323640",
      "source_sha256": "a6dc0db7e2cc105b3d65f67d7b7ffb3ec11169ab02a03dabc14ea9a49d258612",
      "translation": "喂！外面有人吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83d754563f4f63aac2e26f4f8915e4ca2f64549cfb38e41c3455b11684afd041",
      "source_sha256": "592c0711b7adfe2f42674e0cb93e8b41c12d2e8cb0d827381f91cf3e9b81504d",
      "translation": "如果你们不是北部军，求求你们，救救我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:591d8f3ff71488a8ac1c877d8122980f5bf98e311ef478af7e1d097134e30612",
      "source_sha256": "d4ac3680160cbb163d2a6d7b5ba464dcf5d087b78d44eaf995237396a5bb0fe0",
      "translation": "北部军之中，应该有人带着这间房的钥匙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ce2411eb2f63e5cf39c9643ab3dfae628b6a034c7c2ee11137b14ff48833c84",
      "source_sha256": "3de3bd74848014a36b0df62510feddaedf7aa6791cc18fa326d12f30ac255c70",
      "translation": "救我们出去，一定会酬谢你们。"
    },
    {
      "id": "coalesced:5b4076a35d8b5aff36abcc5147d140894335cca12e2c74160cfb1e96004b2312",
      "source_sha256": "d9c68cb0d77af11fa05fdfe7b3480e8ba13024a2fcbcbf3619baaf9ce2e0cf64",
      "translation": "从北部军手里夺来钥匙，打开这扇门吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c042b6e5691f5b8e3fc5ccc767cd8157e654c68f75d7aa8a35b1b5282ec52bb3",
      "source_sha256": "cbd1792290fec05b8c38517106665205c0bee49277085565748b027eeeede264",
      "translation": "求求你们，救救我们！这样下去，我们就会变成哨兵的实验体！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e671ad405d15a25fe6cb67f92badc7ad12c9050e67fc46b9b996b056caeb2227",
      "source_sha256": "10b2ec5eb49f867ec8636aec439bdab82a6cc7a3dcd2a62a93c5254a2361f220",
      "translation": "从北部军手里夺来钥匙，打开这扇门吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:afe2d6934e2a1590a43ee6dfc0f47333d405c936cbb4db8854cf6d5d734ba870",
      "source_sha256": "721dca183eb5ef9c6ee96fef2b7d9559d57ef9e3d4d474cceac1848925d952b6",
      "translation": "先找钥匙吧。"
    },
    {
      "id": "coalesced:703e310c6c3054466d518c96af05256cb1a6066fb0c46e61c8ebc0e3ec308389",
      "source_sha256": "22904979835a6443240a856b9ebec987ee239c85d0b708999d691e70358938b8",
      "translation": "真的非常感谢你们救了我们。"
    },
    {
      "id": "coalesced:6c5cada2b40a1dcbd68e15c4906111bcafb70d8fae1e87a6d00ef174c98cebeb",
      "source_sha256": "4633eabf8b5f92e52300845a98cfcae7a3e0d9b6061f97af0fcb20fbe2907683",
      "translation": "我们原本住在贝尔福特，已经被关在这里很久了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06a4ab78db9dcf55c76db0027eb3d690cd3906d3baf11f06da72e3dcc5d4c8a8",
      "source_sha256": "bf14ef67c4147977b330f8a58819b3014bcba3759c9add97b6b51b719f3f7173",
      "translation": "最初的人比现在多得多，可他们一个接一个被带走，如今就只剩这些了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed70e4b29e792752dc8ae28dac02bb01c0c0fc4af8be57cb93ecf7062f40f222",
      "source_sha256": "e77b08a1844528a84c430ec9aae39f6a48bb31c07d90fc887371e28c78fa8d01",
      "translation": "我们现在就避开北部军的耳目，逃离这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5facd96ac3da517590966d2a186052a1b3d53861fba44122a8ad15b6e9bc7287",
      "source_sha256": "1052ade04d2ec116f87ec3a96e5755621a6d01690bc407b01d4b6b5930398e64",
      "translation": "虽然不知道你们为何而来，还是祝各位好运。"
    },
    {
      "id": "coalesced:f975b3d61eb0eca719d3a8dce1d8743bd68e9e10dd778df506d6bf46584dcd79",
      "source_sha256": "25e7018eddc090f44b9c58d6d5013a4b607f7e9bd5f6a9038eb1a94907bb7e68",
      "translation": "呜呜……太可怕了。"
    },
    {
      "id": "coalesced:ebfc37e64b91a14dd375e83b374cdd68aab4e2b1f0ef54f8d30f245c2657d2ce",
      "source_sha256": "04f8952313238ce4cf95799f1929bf7e18721b340a2e2ae24c2e6af5b37bebbf",
      "translation": "这里就是地狱！"
    },
    {
      "id": "coalesced:7964841c99fdd511f1dbf02b073b291a80ecd3458606a5f7d00a76c9d8808aa6",
      "source_sha256": "f6e0878fc3f6ff8a054d87c32e5a96abdab57dd6e00b7bff553d509c6eb8e69e",
      "translation": "谢谢你们救了我。我还以为自己会就这样死掉，呜呜……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d36c4d24144e57af45cd07e8b0b550d0c70b446241078aba551456d6314c125c",
      "source_sha256": "cef9b770695690e948a6e109c6ccfc6c8a4f62ce4f6a24a874c9a7b691a7a347",
      "translation": "谢谢你们救了我。逃出去之后，我得赶快离开贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03bfa9a5ca5d3f8787a74d41c800a34f3a0d9673cf3504c4bd18cd975c53b03a",
      "source_sha256": "21d56a3a9fc38297539f358c800ea53ac950b74c0da2318e9c73e271b6dff5aa",
      "translation": "为了让被抓来充当实验对象的平民逃离研究所，\\n找到[研究室通行卡]，打开房门。 "
    },
    {
      "id": "coalesced:2c60fdc99227e7df72ad3db69c42fd29525cc25a06017bd837eedb61c9a4e0d3",
      "source_sha256": "1448c940d3079776bca8ac89757f47d708cdf20c714bfc6358ca273c99dabf37",
      "translation": "救出人体实验对象"
    },
    {
      "id": "coalesced:73c20ad53d471abe765f4f9daaa809602dde1d8aeb6f1552d6ab0cf9620082f7",
      "source_sha256": "cae920b971ad4d0623859dafb3dbf585941490f4743a377e962d9642b457e9ee",
      "translation": "获得研究室通行卡"
    },
    {
      "id": "coalesced:e248ee626ebf0589346adb5ad306e2b39df7f643826c4cf05f45bc109e0b7113",
      "source_sha256": "be55fda158fac35519bc5a9b97616cfea7388372614afbde4b313660bafadb78",
      "translation": "欢迎。要休息吗？"
    },
    {
      "id": "coalesced:0b2e4ac914613810d13326408045ae77f91899abf81a306b05ed7ac7673c1a97",
      "source_sha256": "08c64c6a9d03ccec3bee86aa498feb53d6644679abd745f65933fff3c4228517",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 休息\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 不休息"
    },
    {
      "id": "coalesced:37f60d60f10324dc3f342e8f3b691c36e0530a723f39cc873511266a458a95a0",
      "source_sha256": "6bab06ac2a0e89007bdb351ebeba24ae7abfb9ad4f6c4e2ca6d8731314be1be6",
      "translation": "虽然条件简陋，还是好好休息吧。"
    },
    {
      "id": "coalesced:114ff9c5ca04f8380f3b921d8399a2b1fb4988140b980d0a30203f5bc02a71bb",
      "source_sha256": "1f64b162ce85cca3352c7545b35a7ff0acf7b0a303a40ec4f3ff6cde5384329f",
      "translation": "改变主意的话，就再来吧。"
    },
    {
      "id": "coalesced:60d57201e0ffd43fdab81a4d84abbe33eb3db6963d07808ab4aef2a7d154eff5",
      "source_sha256": "e1b8b38e8da71b8d83ca8f75cebee9f9fe2d1e388c2ee12b051457f23fff257d",
      "translation": "那么，好好休息吧。"
    },
    {
      "id": "coalesced:41480d3d2e33c26493aec2504ab8efd18a0262ddc9ab1dd6d0fc8f223723d895",
      "source_sha256": "3b676c1a644bef8083cb99259e3863fb2038abf675f7e65099c03be3a1a6f240",
      "translation": "研究室通行卡"
    },
    {
      "id": "coalesced:8927a102460d509128633c7fac8808a07a1d3a90f1d93a8c71437110fe543003",
      "source_sha256": "0192654a330158285527f413cf767227cdc22bc80f910fbe93aa9c7ebfab9135",
      "translation": "用于出入哨兵研究所内上锁的小研究室的通行卡"
    }
  ]
}
