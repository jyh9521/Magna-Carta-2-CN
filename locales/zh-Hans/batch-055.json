{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:584a4af09424ba52c41bed2347421c7b5fa7bfe16f42e412866b9bc57484ce3c",
      "source_sha256": "6998fb2bb3ddaed01dbbfb2d24ee89bc502139f35548b394bd1cb0d15d1179c1",
      "translation": "终于醒了吗？"
    },
    {
      "id": "coalesced:d88e2d294c65403da0b656394ca57627acde5f43f86ee6cafdd713def30d1674",
      "source_sha256": "8bc72d905f9e46b3b6f4c79657ec0a1173072f8e26f82098c74a9ad8eaffac3f",
      "translation": "是的。虽然还像刚出生的婴儿，但已经能理解我们说的话了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f554a630e2597e8dca0850271c28334cfe66518fe22dff4384b1fb143b301e1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:2b8d85fc4f8513dd853eff6af472aa76f6e9608bcef01612418b65c07dd2ab41",
      "source_sha256": "6d727d13366938eadcde7bc76014815f04d1aa95033a48bf369bc29ac95013c7",
      "translation": "我就是你的主人。明白吗？"
    },
    {
      "id": "coalesced:76a192e7b9c386683732a0bc998c819cf1c49a5d98278e1b73f11ae47c7b6b10",
      "source_sha256": "64fac12e2646739352aa6f683c63335c8e1742670402e08f7e0496843d734c63",
      "translation": "是……"
    },
    {
      "id": "coalesced:b479a95d5157f8befb0c1c85003dad17edac9b01c4ceaa14797f18c327fab8f8",
      "source_sha256": "c2d578c0d955075bac4cb37be665503da0da9170e08af0d1d9d009188b525a65",
      "translation": "我以前养过一只猎犬，叫艾尔加，非常聪明。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:980c69a74295a7753ddacb56e4c9dedca1f71e3574cffe94057891474c47b86c",
      "source_sha256": "da19b6c46c4655cacae5101029ceb27ccc607c93a915877e9525283cf72e1f92",
      "translation": "我就把那个名字赐给你。从今以后，你的名字就是艾尔加。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2959a480113f6d14390bdf34d4375843ee24358ccf47950978b3b051a9561689",
      "source_sha256": "904eecb62411c07f04dee3ed4fa9c6606ed9467f305965a1d92c3ed0914735f9",
      "translation": "你也必须像它一样忠诚，只听从我的命令。明白吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ef8e0b10f43935605daa26440d167046a0c409fa28707ae218664f05ba8ca24",
      "source_sha256": "64fac12e2646739352aa6f683c63335c8e1742670402e08f7e0496843d734c63",
      "translation": "是……"
    },
    {
      "id": "coalesced:b1fdeae22df281235f6919a672e2e2074ce3181e74e6c88de451a282b7835425",
      "source_sha256": "beefbc6f17ed2c25506783642f88589adaa6c8833561b955c2676aee5a658779",
      "translation": "首先，我要对你下达“绝对命令”。仔细看好这位女性。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5691d05afba2bdb529d6c2eb1287a4d7975ab377f8d3928baf069e860a4ea9a3",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:6855abca63ab2ce3eb0c2f99d45019407229316f8936f3ba3a4a268b5cfab6b3",
      "source_sha256": "271d795528d56420414a88a7ef188bce742be68a4b8d971bc80615ff568849f6",
      "translation": "她就是我们珍贵的玛格纳卡尔塔，蕾洁菲尔妲公主。记住这张脸。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58a2ee46cfa1f4aba1fda48fb2a7d93d985186b6f2a93738a21a7e36e78337a0",
      "source_sha256": "2a523504e7bc78a51ce02c058e9a1a44ea7cdb2a540ae27482726097d518a4e3",
      "translation": "不能杀死她。也不能放任她死去。这是比你的性命更重要的命令。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad49c63003d5ec7a860a1487a7f7707633c14e3086992a9fcb42b34db08cc82f",
      "source_sha256": "ee6b099dd02660d847a256e2df34e2752b18c50eaa2eb80ba0555aacd6b594cc",
      "translation": "如果她遇到危险，你就要保护她。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96f1b5bb1aed73676203e999680a6fb992eacb1ffb919da770cdb19da321218d",
      "source_sha256": "ef62c00e5ab5bdc4e331a6946df54f9c22ee267b210e243ec5f07caa07224e2e",
      "translation": "为了我的计划，她必须活着。明白吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5be2c8b87c893ac2c419de8cfcf7d4a0d3164358bd042fe7f6b221317b7828c",
      "source_sha256": "6d8c52c6e40610467a4270dfec23806888eaf916f4a614afa7694b0a3e76d0fa",
      "translation": "是，主人。"
    },
    {
      "id": "coalesced:e0d74135c7fda91e63d636d96c3572dafce23dd3c83995aa8ca1b8306840e2f1",
      "source_sha256": "09095f5a847eb27040e30abf95ab8933a508cc4dbb206843642359859df2d774",
      "translation": "喂，喂，笨蛋！清醒一点。"
    },
    {
      "id": "coalesced:eac7ecc485cb490401985310881c6f37bde32936cd40339c0959cad7f5b5b49a",
      "source_sha256": "c3bd2a7cc5ca6e5c25c9e93365a2e212b12dc85c9c1bff635292398d7cef4256",
      "translation": "啊……？"
    },
    {
      "id": "coalesced:f3bc130e0278a152437aeb7d91b9166155c54829ee48a64237a239e030fbb9d1",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:ca7ee7ae07eab5e66582c3dd1724bb25378708d485e3992b50a656db608c3f21",
      "source_sha256": "aa0231443ecf6cb497b42c9cf8777d3106ab6253140e34eda8a75ec3fa23e787",
      "translation": "你是谁……？"
    },
    {
      "id": "coalesced:729e4bb4063c005b9fd47ce418964ddfe2ed9909f0febee99e55f90092b2a4da",
      "source_sha256": "45c0612178f5873f1f958e57c0c5bf847fcc691c74b1a8721853f2deea29f319",
      "translation": "朱特，我知道。一直以来，你并不是因为修恩扎伊特的命令，才保护我的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa15cd89fd679ed000c4e4bc00080f6d88c9740a0b49984910b6ca145baf6e9e",
      "source_sha256": "f3829cf133e8152819167646d1cb959351f2ccc3cceccb579e1155d1ad38a15c",
      "translation": "因为那一天，你挺身反抗了修恩扎伊特。"
    },
    {
      "id": "coalesced:4f7215752b36093f754baafb96b41da3b8d2856ad200ce01144c26c1a2e773e8",
      "source_sha256": "5795153a735970cdfd2ade905053c244bd14acb9de89eed2996c557257afa7d0",
      "translation": "啊……？"
    },
    {
      "id": "coalesced:a5558735afc470318860833415c79fe299ba14ce8acd03fe419cdb5f9c397bf3",
      "source_sha256": "4661339b0c78fbd674e25e25f8bbd04947d2d034b99ae6def86da91c3672aa08",
      "translation": "睁开眼睛。你已经不用再受修恩扎伊特支配了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fce89a5865403fac3de8a6f9a36a1f175c255aaf9bd2076805fa009ef0cbc92",
      "source_sha256": "eab5c26d47ebf412ed871b66f3f6647c75a942e821d766650e1120ac37f9eca4",
      "translation": "因为你已经不再是“艾尔加”，而是“朱特”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7298f9cc0abf455be51859ae9fc8e8f18fe6eb5e7021f3c725ba0d2dac74950f",
      "source_sha256": "753413744ded0309731aa94a60a1adcedd8a4a068a48c095e9c8f49db4a30abf",
      "translation": "朱特……？"
    },
    {
      "id": "coalesced:7b7004a777f1634d9e7e3b4121ff94fced3321ee8a92645e2e859cdf1017dcc6",
      "source_sha256": "363ced5ee77b2208b50449a62d2c24a07cc498cc62f59814f22aa21e35301907",
      "translation": "蕾洁菲尔妲公主，你为什么要妨碍我？"
    },
    {
      "id": "coalesced:9c07ecacad3912e97a469d19fd1acb06dd0e551fcb2a4f57f91a044d519f3aa0",
      "source_sha256": "7616fbfc03447f825e66bc68649c1284cc24144a22c407385fccea027d44e2fe",
      "translation": "消失吧。你已经不是朱特的主人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0253b4bf6513d2d9742b2900a3634c6f17c1ca6ce8fceddb22b1cfb1afbfafc",
      "source_sha256": "bcfe5378554c8d6a54c3cabccc02644b59b621247475fcf7b862245b9c781903",
      "translation": "我不明白你在说什么。不速之客，是你们才对。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:626754b39c8a69f7c8f1b8df927adfb85ee1951118e626bec76a0a81f61ff8a4",
      "source_sha256": "cc9651747afb71129a7287ff9bb0e91ba0c855f4abe8a1e11a2d4be9277f4477",
      "translation": "该消失的是你……别再纠缠不休了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aede8a0cea43ae55e8046f52e0d70d4e352409a2dab3a2f8f028df387328ad53",
      "source_sha256": "bc0a38cce5279752894abce3f4fd3801f9d627776efa4466a5ea5530284041e7",
      "translation": "愚蠢的家伙。竟敢反咬主人！"
    },
    {
      "id": "coalesced:ea844c7fcc2f546e236362cd6f081f73d32f7a95d679c03df8241fb6a99cdbc2",
      "source_sha256": "3e968285d8574041b42aeb90b5f6a7947c27021d57fe577a99e2a6673806b218",
      "translation": "没用的。再也没有人会被你摆布了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:421553527b8d431ae9fed22322e74702905eb0ab910934b830b8a720d480292b",
      "source_sha256": "cfbafc6d1803f051064762d5f24675a7fc1ac2cb0ce1aea73ccd2ecdd2a2a18b",
      "translation": "可惜了。如果是真正的修恩扎伊特，那可是再好不过的复仇机会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:325cfbaefa522d67d9a8da009997824d120e57dd47b54c29c52961eafa486767",
      "source_sha256": "d3e52a854cd7a8526cc4457ea4bb66aa72c76263f3c5a630f9fb20698fb3301e",
      "translation": "呼……"
    },
    {
      "id": "coalesced:743c8f8ecda4acb15d8200c0c6c5a1b386e1d5f24836fb318421e2ecbe423bf9",
      "source_sha256": "6c155551f5ccf153d4db93c469af45402e8a89afe07c852b16c5be53cb206d59",
      "translation": "你没事吧，洁菲？"
    },
    {
      "id": "coalesced:1644925b5d4ac1e544d692e33800c3fc367b7dfc682bad9b270d1857b4feb7fa",
      "source_sha256": "a0bb3ef9fa325bcdf4ace7ea95b8ee2c22aabb116a140e33aeb4fb328936fa54",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:fd879b3825cebc76fb7fe2e128119da6c85edfd76ac54319b5be7e7d8c4acadf",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:613ea6d1769c196d3718d58645012e43bae28ac909d8ed1ba49df67b796bb1e0",
      "source_sha256": "37c1660339123d1e743c5cd49a36851311770fcf04b4a940d317823c0f76906d",
      "translation": "朱特！？"
    },
    {
      "id": "coalesced:ffd212f8eedad0101e76fd80651eafe865c5e647d4d209d81c42ee7a495f31e9",
      "source_sha256": "a9cc06fabb9287076f68f7bd448615569f2529db072faa8f5f99eedff56234a2",
      "translation": "难道你……恢复记忆了？"
    },
    {
      "id": "coalesced:5b1a920a0ba848c50cf7ce9cf98375a4056424ad0fe9781e1bf8c227730a0786",
      "source_sha256": "0c45f998d3fc29a225d3d4dd68c4555f203d541a81be05eeb5cc74bda8b9048f",
      "translation": "啊，不是。"
    },
    {
      "id": "coalesced:80f9e8351e5a725038c66d4f859f213e732f11c9e045dd5f08598fc7404a2390",
      "source_sha256": "65046cb7fd0dcaf7ad538dbd69b15d320e45b266db6bded1032eaaff26c5ab98",
      "translation": "你刚才不是叫了我的名字吗！"
    },
    {
      "id": "coalesced:7bfd12626d648fb3ab1e6b8415942df9dc0c909db1840f97149a78eab2fb8475",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:7573f9da426e71c5e26f7468ed372f949434d9589cc49fd414248071044eee8d",
      "source_sha256": "51a4794e020793b4621944fe9ba2ce8ea8c6ce1e0b67a233aa5ba13f5d7423dc",
      "translation": "洁菲……到现在为止，你为了救朱特，一直在和朱特战斗，对吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:62c5f9b4500a0720476b61d1bd5f11b3cb7cb8537e3df49b0db19d50b45e419b",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:76583bbec30bca69e87d19d40135de549e3064eeefee2540693c4fb426bad97c",
      "source_sha256": "266c42989c8231f6e22aa793ad0506eacb253aa6216170c0a3caa805800484a4",
      "translation": "因为你是来斩断源自修恩扎伊特的朱特的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a74df08f9e2505f8c15d3f179ab04e48571cc21960e37fba067bb3a56fa50132",
      "source_sha256": "753413744ded0309731aa94a60a1adcedd8a4a068a48c095e9c8f49db4a30abf",
      "translation": "朱特……？"
    },
    {
      "id": "coalesced:c29468eab8950ff0603a67350c7d24e93ae6ae2df2ef6fb01cac9e9943a5da21",
      "source_sha256": "8707addba62e6b7dbc98d9384c8a4573000abc121bafd4f387edfc49325cc7c9",
      "translation": "还是不太明白我在说什么？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4db55b78616bac5cd4a872e1c147db5e530286686f96b4e25c02507a8c297d89",
      "source_sha256": "7bdfc194eec69459a20334eef9875290d4e99ae0449dd134c9d6f196b340451b",
      "translation": "难道……我还得和你战斗吗？"
    },
    {
      "id": "coalesced:8bd62f5c4f94a3f3d60e82f8f62c0e66f9cef1155f57036c1e0c3101097143f8",
      "source_sha256": "6897907d1a97994f942bc911125f66e2a181d49b765ab4d1f907d6ad6203f95f",
      "translation": "怕你有负担，才故意装作不知道……结果，还是被发现了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8782f851616a40b097108681f9b60809b6bf3d568a3d5a8ae0c2e24bfc5954f0",
      "source_sha256": "250b945890f2eb16c658d53bff8e5e8afa38367b4293f462dbdc727cbb058770",
      "translation": "朱特，我……"
    },
    {
      "id": "coalesced:a5f3c21cebcb81ecf715c9ac14bedff2b1d2e8ef6103c2538f549e9e22d7f003",
      "source_sha256": "698318440227f3614817a1ea699f438e6d24ef124817bc70685ae47718afe5f1",
      "translation": "我原本以为，就算没有人来救我，也没关系。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3fd3875cb331752ba5e4385380f51c117cc228f0512bb545aaf87e67e1a22ff9",
      "source_sha256": "e0a494c145f1ea60960f1cad1d88e7cee262ad8e228e875f8210fd7fbe311835",
      "translation": "因为我犯下了太重的罪。可是……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6049ee618dc525c56dd77900e9ee3afd50bfa2a7b678efcfc6deff2f3e86d86d",
      "source_sha256": "070b1d4b966a0c5a2fb2ed391c798e1d8265fe1e4e76f97cd29a52782b981ad8",
      "translation": "你能来到这里……说实话，我很高兴。"
    },
    {
      "id": "coalesced:282d81d8dd5f1edd92f6597e51c8d7d4dc6ee52ff2518361045e650c7d6e8ec8",
      "source_sha256": "68e267c456cd96c15c55aabb7cef0a3120bdbedcb1fa5b969a1926e11c2da180",
      "translation": "谢谢你……来接我。"
    },
    {
      "id": "coalesced:5d1a050a95d94e52e7fc7435f2eada42b80f977b710948d99f78c172b906e03d",
      "source_sha256": "559e34a6be0e8a3fb5fddb945e2e6bfe7370a24f114c981f79cb74d918f8f78d",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:3eb636c7adcb7f5efcc1e5109cda6158bc93726f3938dfee6167cb4a296bcff5",
      "source_sha256": "63e44c1bc9ff14ddd4cf12d4151aa8f88c4e56a2f03306189550fc0c19c00fab",
      "translation": "拜托你，唤醒……真正的我。"
    },
    {
      "id": "coalesced:5e3d2d123e86f33df9d95d6fe45dc6ae995eb77515223d106179a8712b81237e",
      "source_sha256": "798eb26be9815079dfb2913bc444637b87d0a9a24c86b0a228e9677d41cb7b09",
      "translation": "看到你恢复健康，我也很高兴。真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c208fcca74a7bd8858b285bdc671fe978d75b86bfd020a0c8429e7a6d16e7017",
      "source_sha256": "4b426321ff562f36869551db1f358925bb59c04618fe7e73e1356415a8c61334",
      "translation": "看起来很健康，真是太好了。"
    },
    {
      "id": "coalesced:3a89c3e91ddef3d7d6ab3407fbe86b67c3924fbdde614ed609060a04b3a254c1",
      "source_sha256": "e377889a6f27f7c1a3e21f24aa6966a32fefd068550e7931f96261e8dd19f881",
      "translation": "竟然治好了连马雷族的治愈术都无法治好的病……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:360dfa8a26972bcb1b474b23269ee923388315231078edc51457c600423cd6eb",
      "source_sha256": "142dae32942794114b869471703c8ab5abd33ce5597c425582ac125304798185",
      "translation": "那位叫尼克斯的人，比想象中还要了不起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40a52bfa2ca5f4a222cd81d8f879dad56be3886d2d81d8494759499e7d754665",
      "source_sha256": "401afc2b585900b3f83abbc2422a10bb91ebd3cbde96107d08bc9da45bb4842e",
      "translation": "现在身体没事了吗？看你那副遍体鳞伤的样子，我也挺担心的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ea1f9162873bf8976e40390f11f47e85ac8eedc67ac63bcb631d567d47d0abe",
      "source_sha256": "890394dc32545267cf1b91fed8164c2a6360f01ace4d7b9a171a1c2886558ac1",
      "translation": "哼，人类的生命力还真顽强。不过……能醒来，还是挺好的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2eb4b9d0f4a041ae4c5876d8de60873a4e4b244625e340cc9da75f9aeba7930d",
      "source_sha256": "34b25f912f83a067cd7379ca382c44f4a7e92c5e057d710c56b1a783ed25bfd5",
      "translation": "你恢复了！真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3d2ac0fa6be7c5cec59ff12d2002b8d1c622e9e5c529ba6ed5bde2998ef5d6b",
      "source_sha256": "2b1db24f1e9cc57bede74b2ee536bf08808f45ea0e1480ae138dcfcb8b1eef36",
      "translation": "听说，最近可能会发生什么事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe14a00fe534bf18db991a078f3f8c7a00868b04b85b757754c596c955913d49",
      "source_sha256": "c56ef2a7fcbbdbe4b1b1fdddfe6e7eb70626d48b03914b604728602c1585d5e4",
      "translation": "难道又要像上次一样，人类又要攻进来了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59c3e150107daf7aa7b6def734cd43006c613397c8404981f2ee35f7dc4de129",
      "source_sha256": "c00ee31fb66fbe66c26c1e18efd7d34dc287f25475002110639a84eb026d7316",
      "translation": "虽然看起来暂时恢复了，还是要时刻小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d6a99cc917c57644d9a3d41788062c3140b7e259016bb1fd397ed7c1acaad128",
      "source_sha256": "b9db7189e093e71d4486121c031885001afaebc27f3f6be5a55a738e7a92c050",
      "translation": "毕竟，谁也不知道会有什么副作用。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93a178405a103b6e9c464f8ff85554ffb002d03020a34f4c2279abf74f5f29f7",
      "source_sha256": "4e2f8cd032c1f137d875465c9e5560d607ebdb51a76d94218216740ee2860511",
      "translation": "没能在治疗上帮上忙，真对不起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:788c7fa5dd47e7e66a523b5a53872a2780d9acd2a44199ab63880b29c54c830e",
      "source_sha256": "c9305bd4b76e5367b5dede97cd784f71941cfb7f9cf1e021700bad52f6b104c3",
      "translation": "不过，幸好村子接纳了那个叫尼克斯的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2eab074b07484f38f62dafc7de12f556b66305d783663d089def841b26211966",
      "source_sha256": "38d0435ee76afda34b2a98021d47322a6a95c3c5e143478a1a05cc7ce0da8a8e",
      "translation": "洁菲学会了天雷天风印\\n装备扇后即可使用连携奥义"
    },
    {
      "id": "coalesced:a447d763a25e0bb2e80c60becf42296cb10cd9f815da13b5939d2744d5ced687",
      "source_sha256": "b1be737214b3607b25c5a363ad5f7016674f333a2ad820efa4750320908e5a5e",
      "translation": "露学会了天雷天风印\\n装备手里剑后即可使用连携奥义"
    },
    {
      "id": "coalesced:096318b25d0cef2b1c2f3716edec0d6e7f30673f29d006af690bc6c0eb094d5b",
      "source_sha256": "c9d3301d7607710e6d69bfad65708f9a1f8e9bc96db83d42a8f99678d98f6c96",
      "translation": "天雷天风印"
    },
    {
      "id": "coalesced:d02cca0a45466b43635aa14caa97a7a936f0c90f0f5f0dbae180097f716d8183",
      "source_sha256": "092189de54fd4e88eeed72e9e6724cb306120ee93279a537daa9d7876fb51d40",
      "translation": "以风与雷的连环术施展连携奥义，对1名敌人造成强大伤害"
    }
  ]
}
