{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:4b80ae79d2a577a6d8ad5d623fc5ec6370b3a9122df4abe7a07176d2808aa9e7",
      "source_sha256": "ad8afc18a1da9820806f3a1c46552580b76f6b8e78b6f5001b4f44315312e4ea",
      "translation": "去我家后面看看，那里有些灌木。用脚拨开，就能看见隐藏的道路。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02795d3b6756bada8f83fc15d4c0040485032d4c3e9c738da55603884290bb92",
      "source_sha256": "95623cc087a5e2a47dd37d159b7432619bb7a949a0aa584bf36f23cd61841e01",
      "translation": "那条路通往杜南平原。"
    },
    {
      "id": "coalesced:7fdeb419137ce03e9c937de92d8fe0541413c4f1a3427e7ac4b33b7193915ed1",
      "source_sha256": "636af59a461b14481b14b5328f974a007636c8c2df1c5c7f6214734f29f352ce",
      "translation": "为什么要在那里种灌木？"
    },
    {
      "id": "coalesced:1152a4895ead1a85b696222d1b5c438f6eac5b3fe2f80543dd329dab9ded83bd",
      "source_sha256": "412a6fe0e172481941575ac9006a3cc72d39f12169663d76446dadf9bf7bd08b",
      "translation": "因为不能被北部军发现。"
    },
    {
      "id": "coalesced:985556613e71a824cac6f14dd6984b441290121adf2752d59b507a9404fe70b5",
      "source_sha256": "24e64beb63faf8e15e30b362afaed3c736f82e96aaa4e94f0470227c3565fa08",
      "translation": "杜南丘陵目前由北部军占领，还是别让他们看见比较好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4a1f1110082ae6452d57dd474b642a840a99efbc4665db5bbc1c3bb325459b45",
      "source_sha256": "11e54c63578b32cdd01561d62a0a0de78b42262d09231090dbda57b04d342b44",
      "translation": "嘿嘿，不愧是我亲爱的阿尔戈哥哥～不仅肌肉漂亮，脑袋也聪明。真是太帅了！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8551cd40f859cfe9080e405be97572faabbdf2b46970e72b173be32b38c12304",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:44dbeb082336443a4d8ca7bf537ef695194ebb3f70a44d4ef118b84ea463794b",
      "source_sha256": "5d287a6726d16452a3e32801e0ce20a51d18bd131fafff8b7d40c5f1c2941c07",
      "translation": "从这里一直往西南走就行。"
    },
    {
      "id": "coalesced:d3c566ae57de091021afc6778e1c4b39d3a476534b0ff08c4de1ba7ad8b10108",
      "source_sha256": "9863cf71b0e2c965861f3da483bd7c0be518dd17661c7d18abc69107dfe7f5cc",
      "translation": "只要一直走直线，就连小不点克罗塞尔，也能轻松找到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:598364b0d2afcc32a1e02ed18139a66bd8f082a75ba776b8fee9ab4b6bd0ceab",
      "source_sha256": "83a7cf82579df8b9a3337fc2b2a957764e7e3941184ae816715e638677690c7c",
      "translation": "你真的想尝尝火属性连环术的滋味吗？"
    },
    {
      "id": "coalesced:35babd0373f51931961c1cd9880f6d16df9f0db946617ab6a0a89485ac5a0b07",
      "source_sha256": "079ec427ef1ad565ca4e5b579ee75a6b2d0034884925b7fe729a5fd77fef29bf",
      "translation": "马雷族会用冰属性连环术哦？要不要打一场，看看谁赢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6980a5cc0547e87efcf57fbfab541243a97d24ce6b4d6ae9d4a39d05757fe77e",
      "source_sha256": "f42dbb5ddc002d0062bb5a4c543c71b49f34dde9ab798789450c8c26f15ad7b1",
      "translation": "可恶……"
    },
    {
      "id": "coalesced:16e2fa425238ac9d8b1f7372fb124298371f84d9d9a8de0f4519c94cf03d47cd",
      "source_sha256": "fc58a418a3523e247a83a27920c9f096535b2c26ffca919f5ceabd3c73aa7a99",
      "translation": "那么……塞蕾丝汀比克罗塞尔还强吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b659faff19c92a4bfcd4fb547f3f533a92b3a96ec4e7d0203a1de4c2471a14b9",
      "source_sha256": "33b4639d0c27c1d7e9fbfc16b4661e95c5c5a2965e99ea03b67e63e976f39c25",
      "translation": "那当然，你见过火赢过水吗？"
    },
    {
      "id": "coalesced:68b1d8d010d50b2eca31171a4e21875370bc4b99567754586733efca26ffb4b1",
      "source_sha256": "49eb0fabbad1a839d7cd8740897dd799e471a32f9637083f6458d571e0b09486",
      "translation": "真厉害，你的天敌终于出现了。"
    },
    {
      "id": "coalesced:e943f7720fbd36926ba05dc982e92a20df1106c2cc80c4e714378758991a06e6",
      "source_sha256": "8c413976bc6094cd1daaa6b989380eb6faf7802c4b16300679f68a459cb1079b",
      "translation": "不想被烤熟的话，就给我闭嘴。"
    },
    {
      "id": "coalesced:bc5ac4c4816a7228dc27a701ead269fff18bfb770344b9bf3b67a1fda92508dd",
      "source_sha256": "cadf20f92a3dc59cbcaffe4c0e8de193837d1b3537a2b5c3ae53f8403a6198b0",
      "translation": "别忘了，我们是来营救马雷族的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74c40deea085a42d960ed4fbe4560a34c0560fe798b11e3735cd2b03322a2cc8",
      "source_sha256": "834b34e38e04976665a679da19ee28253e1393590d073b5c8616987202f117dd",
      "translation": "前面就是海底洞窟。往里面再走一小段，应该就能看到那些南部军了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:957be4ea00b9ec5f0992c1da856f10560e0832d3d40d51728b1f15cee39c1f16",
      "source_sha256": "174be625e232b29e041ab132356017b976d2b86721ddeda1e609a175bb64eccd",
      "translation": "阿尔戈哥哥，要是他们是冒牌货，一定告诉我。我会狠狠教训他们，欺骗马雷族可不能饶恕。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6f926254e1b62f59294ccc8b24fa938614d1051f2461bd4547c77842cb2534d",
      "source_sha256": "0e693f46c733e3452d22716c9b9872d1f62e150f8ff3b6c65728b76ea6da0a1c",
      "translation": "喂、喂，安分点。阿尔戈可不喜欢太凶悍的女人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c89fc9bf1f01b3652464eb8da09ee15b3f4cb9413ab23537b77c9e20b9fac46a",
      "source_sha256": "8d7fc19f9d2685d73947c8e5fed87ba07297ad1c61df706de5dedac8300adfa8",
      "translation": "没关系，不管我是什么样，阿尔戈哥哥都会用海洋般宽广的胸怀理解我的，对吧～？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3a0a0c7c98e82d14e52febd0a75d52ba1f292eabb095b94a59d9ac0b692acb5",
      "source_sha256": "d3e52a854cd7a8526cc4457ea4bb66aa72c76263f3c5a630f9fb20698fb3301e",
      "translation": "唉……"
    },
    {
      "id": "coalesced:2bdd6be992b4ca710d9dd05f86467eee1aaf900752b01459769ffd82bafa5a05",
      "source_sha256": "5a67a3a0803bb5f0470ce9473f738af42381d50110b84211edb3f24214b7afe9",
      "translation": "总觉得，你好像一直处于下风啊？"
    },
    {
      "id": "coalesced:55defdc5150ced158c74eaffa0a756f76c5a48bd0e904d3e955dbff8405d5c6f",
      "source_sha256": "9253585d51bd842b83c88f7403dee392d4f29f0edc744811afead6b688fd370e",
      "translation": "闭嘴。"
    },
    {
      "id": "coalesced:53a041f62cedc28036bf3a50749d2a42f2c303ca16e41369e7b8ec488826c6aa",
      "source_sha256": "4e9d9b9ddf790a2e143708188d7ebdf68bae0a2a46b36301b6b71575362df2a9",
      "translation": "这里就是海底洞窟。"
    },
    {
      "id": "coalesced:b3a25b61d5f7ed079a4d64b77e61a6275e7988386c5aad1d39cd79dd3ab0a9c3",
      "source_sha256": "ae49010ff15f4f16900e04cdfc14578347470442e4522f9f3c9e339ec7777b8e",
      "translation": "没想到，柯塔马雷附近还有这样的洞窟……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ae9b62bf104dfa13da054052e2e274343baf72440f534aa7be222b4314bbd769",
      "source_sha256": "909bbbad76f78b3b7199b804ff3a45b4cae8d8e247a514b01919e410918ab173",
      "translation": "人类应该不太清楚。洞里也有阻隔，只有马雷族会使用这里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9331c2957e43cd68c83dcbb7f23b0d1efd242153ca097c4b76254f56a9b4e5fe",
      "source_sha256": "8c4f58f86d294b3c453ca53adcb3d0186293f373720f45e19032ffe75513481d",
      "translation": "那不如对这里的南部军使用麻痹香？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91a568cc42313f2e964b9f03139b503c3304130767fd8e4956a3b5a3f5be828b",
      "source_sha256": "0c1dcbdf2f6b617a1b7bd400d6a84085c52ebcee67ac0ff4d32dffe2b1e0997a",
      "translation": "哦，你居然也有动脑筋的一天。明天拉·斯特拉达说不定都要掉下来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:305d63c6f9bdabc1608dd337cc413ef4f5710b33cb9d4ff51ee311a67df55b13",
      "source_sha256": "9253585d51bd842b83c88f7403dee392d4f29f0edc744811afead6b688fd370e",
      "translation": "闭嘴。"
    },
    {
      "id": "coalesced:c24b7fc6e3d3c5dbc214a160eb0b27f990f0cd810c2a3be898d1d245b5950439",
      "source_sha256": "e49e4be4823e6468477105054e07905f66f8766ea9167f8cb66742237ce09bdc",
      "translation": "麻痹香的话，我们已经用过一次了。"
    },
    {
      "id": "coalesced:dfe2ddfd0aa1c66db3d4fa64f9167dd530f086904e341cffa839d542f8be80eb",
      "source_sha256": "2c453043b457eae120cd9e995e9c3aa74d5f1a363be6003f1392d53daafdd827",
      "translation": "可是一用香，就会有气味。对方先察觉了，还威胁要杀掉人质……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8a4e07e6fd0634b6701a2183b1a4cca556025ff00811821273e6b7abc03d5c04",
      "source_sha256": "2c5d645e83bfdd7aba0587480887415bcbabe7d218b51ae9e91057401f6fc65a",
      "translation": "那我们刚才为什么中招了？"
    },
    {
      "id": "coalesced:5f1188bd4a66a0a0285e2b54f9dee803c246cd90f2f5d29450257b148a08c5c0",
      "source_sha256": "2609c8ef5d80e8e448f994b8a44b29cf674cade83a40e4d9b21480a940b5aa27",
      "translation": "应该是柯塔马雷到处都有香气，让嗅觉变得迟钝。即便用了麻痹香，气味也会混在一起，难以察觉。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f410e3c233fe96f9b001d7f070976c527fc30194744712c83f23cb4fe73cb38b",
      "source_sha256": "8ea15923e6a2011853ead92d8d3225f88a33efcd9e992077d37d0bf1c32dfc5e",
      "translation": "香是马雷族强大的武器，所以北部军也不敢随便靠近柯塔马雷。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d11dd778345dd51f724c223b31c6a82c961b854daf35f4ea3dceb8785ed2422",
      "source_sha256": "4401173cb5ddc3dc496d321839c9e39168df4e477a3984908758ce6012f17e1d",
      "translation": "怎么，又送食物来了？"
    },
    {
      "id": "coalesced:6055bf035955082b0a54e794e84ff2ccfa95a50aae52765f31c695832e87fa1c",
      "source_sha256": "238b8cd07deffe6eca507d0c8213e3807a622e750629d8ac9356f2df03e32147",
      "translation": "不对，你们是什么人！？"
    },
    {
      "id": "coalesced:027bb25786fc4c66810c0923d60cc81521ea42e4e02331500597131ddbf21342",
      "source_sha256": "a2b8ffc2f6dcd92d1055f97ab6b512d331cf0cff41ab200b1ccbfbe12aeab850",
      "translation": "我们是南部军反哨兵部队。你们也是南部军吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa0e0e0d1695235db3a382adb3f7fc1fa50ab9a3bec9aa6a1c729eb29d3fee2f",
      "source_sha256": "bfb52c8b8938b2f046fc12f430becde9600e1516c563a37c14830adc2dc58a0d",
      "translation": "什么？南部军怎么会……！"
    },
    {
      "id": "coalesced:ce99a5c316473f17b093e58deeb109d0383a4c61b00dcd26803d6a1604aa435b",
      "source_sha256": "65d24b714389ac979b080140cdfb16f78f40e7556a163f2701f493798654f706",
      "translation": "搞什么，这些家伙，一看就是冒牌货吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f9a0078ae6f7dc989ee9ed8eceac73073ee2da361e3797e5d25fe57e2a4a2ac",
      "source_sha256": "18c9d4b82ac757b7d68c0f26b11b692ee43159ed5d60614e976b99cb3230358b",
      "translation": "我、我们……！"
    },
    {
      "id": "coalesced:14306dd2eb38d8017eeafaea4bf327bee9d457f1bb3f34b1504c23e19badf519",
      "source_sha256": "637c88c2c335171df0ba17facb354c22ff146faad79533a437096dd974e52717",
      "translation": "好久不见，阿尔戈。没想到，你竟然当起了南部军的走狗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c60201898026e34218dcc6f594c2f07a0e81f83187a6505289da9a6d0724d7e7",
      "source_sha256": "e9b3e3062d869e722b2c2bb0a866b80c80f2169e018604b3cd7fd83f97ae4132",
      "translation": "鲁坦……？"
    },
    {
      "id": "coalesced:95b0ad2c88e11c3b15bb7ec74a5f00eaf189ed1df820cea2c14587caae979dd9",
      "source_sha256": "822b2f44aca981d0d0723336214f8ab06e197a866ce7fc3825024bcdeda9282e",
      "translation": "咦，你们认识？"
    },
    {
      "id": "coalesced:58789dd3c2e4281f24fb9cc8b7779f9cef8560c363fa22503d18646d53df950d",
      "source_sha256": "fac4cfebd96955ae1442a54ea52d501bf569fb1d989f01eda58fcfd365bf660c",
      "translation": "当然认识。把我们村子搞得一团糟的罪魁祸首，那张脸，我怎么可能忘？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3fd8b35420e74d562c63046e9ca48dbe4ee85f6573e0076449a0ffbe7ec2e8c2",
      "source_sha256": "2b36782a5e9246c23f8bfeb530d3f1a69280c7f3c6994b910f2c7ee16bc5f480",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:75b75743d811f38a09be738b88497a75de9917c4061bc084f4e0745c8dc65b3c",
      "source_sha256": "36400ca94f50fb37dd9080ec4fc5f4d92f2cec9527b97386bb3e216d253c617c",
      "translation": "你为什么要冒充南部军？"
    },
    {
      "id": "coalesced:268459809173e995b367bd97a9352740f8fd329dd6463820ed8c9bccdca20e9f",
      "source_sha256": "5dcf90d18ce719de075899de3b86eb2c66a4375081ae8ad21419fd4fa16236ac",
      "translation": "都是战争害的。要活下去，也没有别的办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a63c05e70db0f86ac4cf3489a5ed097ecdaa7e9fe1c9a9ca4b329860687bf6cc",
      "source_sha256": "b53fe33ce564d88e1cc0e50090a02d0e13aaccca89c2668f7b307ad0a239fdf6",
      "translation": "放了马雷族。他们明明无罪，你却把人扣在这里，难道忘了自由之民特雷瓦的骄傲吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77adf3b75264cd6bb7b365ec787366ed461430997761e7c3bffe34764aba258c",
      "source_sha256": "aad649b88a338e5941717d79ee314c6d025f191f6f231df1c15ab8e08923f043",
      "translation": "哈，特雷瓦的骄傲？"
    },
    {
      "id": "coalesced:3bd64ba3e66fe16ac5efb52ffe220eb738fcf520ef0685fd37f738ff02e70a9c",
      "source_sha256": "47baa7ccbfe5f326f5c49ec23b77c8f17f97a7f5fdd07d9a60dc5c2eedc3dcdf",
      "translation": "已经成了南部军走狗的阿尔戈族长，你自己又把特雷瓦的骄傲，卖到哪里去了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c3dfa814f6e56b896327084eeaff0197f4e20b336749efd72c762a45b8d407c",
      "source_sha256": "db1098ef96d24cb905a714a6cb16bd27932211c0a712f1ec7426207856a361f4",
      "translation": "你明知道，黑角特雷瓦与北部军联手，毁灭了我们的部族。我正因如此，才加入南部军。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fabeebd39418c052d80a611d5ff8ac47f46ce3beeef1d79f11370f4008c2c5c1",
      "source_sha256": "d47331f00afcca2403e7a6ddaaa0b558dffe6d07474764b2d2658bbdf8e596ae",
      "translation": "少找借口。我们青月特雷瓦之所以灭亡，全都是你的错！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b03b4e3ec9de4fb968ca3e1b931b2091ec6bb3ba02f715489adc994024b8d152",
      "source_sha256": "922f776c63a02d4d44d9e1cdc06a1cd8cbfb7620a7ec0e73a82e053b4d60d46a",
      "translation": "黑角特雷瓦那种家伙，早就该斩草除根。就是你留下了祸根，才会变成那样。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b72f2b93c7c9799b9534b49e2f1bce03beaf2dea920a1ca1c726a5223b957f64",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:361b140f5725aa0b33789ae71e7fed2a73e4ff2cb92840646a118787fdbecde3",
      "source_sha256": "90b9a5cd8edc199e38056c36721d0767088788aa1f0ef32dac3d036a4b1cc909",
      "translation": "没想到，我们竟会这样重逢。拿起武器，阿尔戈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47aa598b2dd35f98e50917a84e731e1a8ea68beedf87708e2994f955ec712dcf",
      "source_sha256": "29562154ae9c2f84302c5093ce7f73554bd73aabd37989e27365914d7bd59de5",
      "translation": "鲁坦……"
    },
    {
      "id": "coalesced:d7118544e848b875b2f2daf8a17b6107f2b571472423ae6cca527089a5501e39",
      "source_sha256": "bbfa07d1ce3cbaa080e3cb8159632487a1d017de7fe993a1e2fda7a77737302a",
      "translation": "做好觉悟吧。"
    },
    {
      "id": "coalesced:24bc90d73243ea9ea20bd3fd332b09056a9084419275022da113952e8f986b44",
      "source_sha256": "7f625d207b1f9a2ee7afa0976338af3182c35d395f4e937e8d5090f8f64e6723",
      "translation": "唉……"
    },
    {
      "id": "coalesced:a5df71ce78342362fffe24fba5617a85b61431619ded37211e8851fda53533df",
      "source_sha256": "2f27fe38dca39dd752318923c366f7cca8ffc56353c68f863cf370f540c74784",
      "translation": "阿尔戈。"
    },
    {
      "id": "coalesced:f4358a55f553ec30e9a80c34055298cdbe1bcdb02622181af0a0f2162ec74f3a",
      "source_sha256": "554d14cf5929928f30f5133017d52693d4d2694be7537867dd4079410f168000",
      "translation": "没事，这是一场无可避免的战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:feccae6c5f7e2c7a78e36e8e45390a5600eb9f96624de438cde2a4384db2511a",
      "source_sha256": "a7e8aca773f015f392476c088cb0a2846359aa55bb870acd7b5ac9dbdde15c1d",
      "translation": "尼尔提哥哥——！大家都平安无事啊。"
    },
    {
      "id": "coalesced:63a74921040a2caf6e2be3bca2bcf544007546a19989b16b20edc77944dc36e7",
      "source_sha256": "b30598f75f152c913dfad324fc40754ac02b9b3dc7fb29f14c736148665799be",
      "translation": "塞蕾丝汀？你怎么会……？"
    },
    {
      "id": "coalesced:812d538e72c7b28842d548d4623d9c623069064e87d491b5e81b89b953f49c63",
      "source_sha256": "ffa99c0eaaaea526c17e3baaf9c83e5e9a8acb71e86469165b209775fe3d16fa",
      "translation": "这段时间，很辛苦吧？"
    },
    {
      "id": "coalesced:a5ae84b06adec0f9a71debcfa578c04541b8839f8cf9fc1b40139ac020d52c9f",
      "source_sha256": "bc41fda16dd24605bdd479e82bb3eae6f593c29bd07af8cf92742fc0b357760a",
      "translation": "没有……谢谢你，特地来救我们。"
    },
    {
      "id": "coalesced:d94abadb81d69fa77388836aafb19df1f71408cc60ba647eb741de6582eb2be9",
      "source_sha256": "e279b4f66c4dc1e0d702d5c03065a2b2e5c66d93bc5631d05c58c99de724527e",
      "translation": "是这些人帮了忙。原来，那些南部军都是冒牌的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58425006eb7c5a0e3d42d041c443dde09e8551380f2f0f0744b0eab3cf7fca14",
      "source_sha256": "84be5a3dc5b6cf2b23e5a6494b7e7afe9fe155a53f60e85830c06b240e4fc94a",
      "translation": "果然……我就觉得有些不对劲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a98fde268abb13683a45d8558cd93e9061d7242f9792508e438948c8bd124624",
      "source_sha256": "8400a7d6d871f3111fe1c196acf4d7d338658b123808da04aebfee3b1395644e",
      "translation": "不过，这几位是……？"
    },
    {
      "id": "coalesced:6df624b8e3426b94c5417b96b03f1d062a55720ab88fcf6d10773871dd532218",
      "source_sha256": "3cfe88f1a7a4bc065b49479b90a1339f02f70d1d1d00324c9cac2e800a2aa1fa",
      "translation": "他们才是真正的南部军。这位高大的哥哥，就是我一见钟情的阿尔戈哥哥。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca6a8c74309b5ca786839dfc76f7736ae21d2daff747a42bc7c570c7eb6bcbff",
      "source_sha256": "7028fce8071f7e99b11c1a9db3283ec744ffd6362143bd45dda94b48e3ec7dd0",
      "translation": "那边稍微有点帅的哥哥是朱特，再那边不帅的那个，叫克罗塞尔。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d49821aaf71a47e8980f0664af9e6145b6a4548f761bb1b343869e7cb8a6709",
      "source_sha256": "c78c8dd9883901d5b25aa92c3fb2f8cebcc249ecfba52e7ff57889f4b9cc5dc0",
      "translation": "……这个家伙，真是……"
    },
    {
      "id": "coalesced:a2584a7be523b28b5ad99619f5faa7e3e52d240ba9535f78c229581c56d9d499",
      "source_sha256": "058391fde5a47e53f71be37d7cae73b43a13d9f56228132779a09b29452c5fa0",
      "translation": "非常感谢各位出手相助。"
    },
    {
      "id": "coalesced:0c22e24a74dd5d69a99fa6a6ed4b8b1b37d98b3281cb3a63f04467f22d903923",
      "source_sha256": "3952f5bb4f4379163dc263e30ada7476afcba3b616445c9a554beda6bf4c50b6",
      "translation": "你们都平安无事，真是太好了。"
    },
    {
      "id": "coalesced:9cc4c758f3b735816ced4de37c4259967b2ef3e8a81cd0693147338d6f555bc6",
      "source_sha256": "deeb6215268183d27650f292ddc5515e7c46e7692a22b34d93b3d04bcc0ce840",
      "translation": "我们回去吧！族长一定也会高兴的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a41fc01b664af01f7827c5940704b19a5ae39e76fa07185d635688a47d830e6b",
      "source_sha256": "b940589a99821a23d8e5640c2ba31077fd30ce76a8f6eab85a891b6612141995",
      "translation": "要做的事堆积如山，人手却远远不够。果然，还是得招募佣兵……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f520ac8225dde86edf47a32608c32c4c1608b400a034b96222fa3a056acaa9ae",
      "source_sha256": "19666569e9c3c64e25fc77acedd2304ad99ad42118098f763b44cd00700e0aa0",
      "translation": "这里是南部军宿舍。原本是旅馆，因为战争持续太久，才改成了宿舍。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:240c4ff3b1a72cd506b5bfcb3b285bdf74a57f07ac1906db51840c105265bd80",
      "source_sha256": "75b51c8d0241364a8b0625c5a2d6367141591303b21782c7eb047f7c1ce03482",
      "translation": "这道门是[南部关卡]。"
    },
    {
      "id": "coalesced:81f7fd193bc52f54181c3d679f27fe080284bbbd9f92fb5eb272ea67ad2712a7",
      "source_sha256": "6ccf9054623f29f5cb73fcc47d60cf904cd2521329ab2b8bff89d3665e0bb989",
      "translation": "门那边是[寂静荒野]，是许多凶暴怪物栖息的危险地带。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d39e3abad99b979ec61ea4b6fd706fb19c6c6e20ddeb3b0bda6d3476b7a7cc0c",
      "source_sha256": "83eafe5465702830ee8a8839efa9239051eb259b78bd3db32cd82255ff5398f6",
      "translation": "尤其是群居的[拉提族]，会袭击路人。太危险了，所以现在禁止通行。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55a4e468cdcca59fd065e812372bbb7a187347594d1607e2a3ae3f1e471b1d0e",
      "source_sha256": "ada3db3989894bd941dab2d3ce00046a5276efa4fd26aa04258106ae645e023b",
      "translation": "好了，好了，等解除封锁后再来吧。"
    },
    {
      "id": "coalesced:c3e6cd238eed48dd0413984c884462410afacba1b7197485366ee26987218a71",
      "source_sha256": "71b3a53c99e719b9a19bd5153e6ebf721cfb0b9b70c4e88efd0061453d3b4e88",
      "translation": "听说，狼人巢穴里发生了什么事？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e051f403197de94fb1c1944e3281334537828d0166fd512f0cad30eb4ea9832",
      "source_sha256": "e6a067dd8d715ea61b8268bab2881a5a619ae0a0f665524737da7c377cb495c2",
      "translation": "听说南部军救出了人质。偶尔，他们也能派上点用场嘛。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb3feb79985578e4972df52d42ab7503aed84131c92d72ec79fc7d95aafe7a5e",
      "source_sha256": "8df1943a0037bde351a3ca372d2c766d7c4c4f2dfe274d9928452af6824c3896",
      "translation": "听说，卡蒙德采掘场出事了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1828d164b03eab96e7bb5572b9d046fae9cc974c1e2a804e93e9954e1111cd1a",
      "source_sha256": "fea1a60dde54b52c89a43ebc4861a64de45aa600f701ac5336ade90c3a6f571b",
      "translation": "你们击退了狼人？真了不起！这下终于能安心做生意了！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:56b10302179a5b72e1151bee320069279f83ab441858f95650d079f0ba5d7d0b",
      "source_sha256": "9f3a820da7f574205520489d647c13014862c3164ec08d1e44f7c363aa7d7987",
      "translation": "我想了想……还是不去了，不能把你丢在这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a7db27a627d4dec358543852ac651069869dd6d09c3901c3b2ad9c9d801e95fa",
      "source_sha256": "6e3d32074127593c5a50d48aa6ded93e1a18761b60222589a31af008678ed78f",
      "translation": "什么！为什么不去！不是说要赚很多钱回来吗！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ec0c3cad168fbca413933f8b30b62df4ebf40c8681c184b86236af8ed67ab4f",
      "source_sha256": "a89063e90eb1bd43f6628b7ff1c629372a3a5b5043892f41dae5fdaf538e0b01",
      "translation": "什么啊……之前不是还拦着我吗……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb78cafc8418a0db0bd48bdd9f3d23bb7262bd927e0ade62a4e7e7e0f0395c29",
      "source_sha256": "c1f352f90fd8e06203c715cbf54dd94e994ea816d941d954798f1ebdb1795058",
      "translation": "再去报名！说过的话，别出尔反尔！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b1b6f1b069f7d7f9e264fbb2d1cc4d4e242421eeb9fd086592c345bd7471ba4",
      "source_sha256": "7686a7ff8ecad02f1ebd5949813d4a1fe183487031a1bb5d79dd26c8546cbe54",
      "translation": "反哨兵部队真了不起，不愧是精锐部队。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c0b863da3e43431f55516aab7ad1e11cf9338686a26f5f0bd7212169cdfe5ab",
      "source_sha256": "ec66af111f90554fc27581e7b98a053447166a015478f6e85856415f9e3f2d08",
      "translation": "当兵的，谁知道什么时候就会死。所以，今天就尽情喝吧～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc809f714207f6fcc15cd4397164f68e430cf4a5b7f3ab3ad1a70675a31ef141",
      "source_sha256": "f78b74ea844a360e24ca1946556140ce18b6e9696bd9dfd19b9f9b05e94d1ec6",
      "translation": "你不是天天都泡在酒里吗……"
    },
    {
      "id": "coalesced:4b4a5f20f8be94b994a8ec8cd1662162f968d839b608f6d8c3831d54a1ddc4db",
      "source_sha256": "3913ec7a38c2366a206effb7a99f60e7695f9813631c53783b56f6af384a226c",
      "translation": "听说，公主的部队总能顺利完成任务？真不愧是公主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e57d61ea09220523a9d17012b7ad5db21d94e4f27118e465f1168bfde733f3ac",
      "source_sha256": "9505bcc1e9ceb6913603c70e984a4c4d7d8cb61183a88693f031df6eec71567d",
      "translation": "老狐峡谷啊……能活着回来吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:854cb26320c24e1073fb6f58c22d0ee50ca3fb19c14de71bfd81371c30391e1b",
      "source_sha256": "c45c54af84091acfc2497680be3f0110de08800c55382e9f10b00983bb3983d9",
      "translation": "过不了多久，就要向峡谷出征了。"
    },
    {
      "id": "coalesced:43fc42afe1d9f546504d06f2eb5e7a679991ecdd9f78a44d736ec0a775debe26",
      "source_sha256": "39694ef6150c81572598111411f25dbac95512735b58ab0bf0b0abf34e816871",
      "translation": "怪物体内也有卡蒙德。"
    },
    {
      "id": "coalesced:be2f26697f8f273df9a05bfcfc12d9efbbf820d7bc43d88bbaa2b52b497f639e",
      "source_sha256": "e3e1128e4fde649e62175eb9e66042df0e7270bb39cf8c3b3d04adb141e2da9f",
      "translation": "至于原因，有各种各样的说法。"
    },
    {
      "id": "coalesced:b8020ffb98c4263544b67a9b586846062d41b0862237cbc2bc907fa11ba93adc",
      "source_sha256": "c935709dcc4d8de28d5737873eb357d918f6dcf22ce6c40bfde49208566536fe",
      "translation": "其中较有说服力的说法是，它们吃下了体内藏有卡蒙德的[卡尔塔]尸体，才进化成了如今的怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09d51a82b62922d31daab1d7f534bbb876ddb68719e99147a87c4f531ae58e22",
      "source_sha256": "b2074ff148dcb7ee8177128b00608f433d1559ec16ff6dec924b71eaeefc7fa7",
      "translation": "把敌人想象在眼前，挥剑！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:26ee933941e851710efd2c78bdd85bac2b5983059a8eb79ecd9e428aa3673f11",
      "source_sha256": "8a4c2e8ba4dc04f2ddc7feefb423c995d6a4ba4602ce7709b98b235341728c2d",
      "translation": "摆出那种软弱无力的架势，还以为自己能在下次作战中活下来吗！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:259387bbd54e461b5b2c8e51bcd03c84d7e17dcb70330830c4878c717d62f8c0",
      "source_sha256": "dbf2d2e5b46f4999cb6ea2dc2a976c5f4228bd44fa11fdaa0632f8c20ac31f38",
      "translation": "再有力些！"
    },
    {
      "id": "coalesced:9bc78e8adb3c902e743ebd25b2f169d009e2349bba71cc2cf4a3bd03c276dea5",
      "source_sha256": "d6f3bc9a7ced7df6a08a463b73cd542147046cc9462ab6b5d0fd65e36bbcf88e",
      "translation": "再用力！！"
    },
    {
      "id": "coalesced:0897e3168fc76339814cd6ca514a9a9890fd0449210a74df56aee9bf42f18d90",
      "source_sha256": "c1a80afd6c08fd1d3423207cbf6b0c58da96b4a93fed0ffe0073113e5d8e7a89",
      "translation": "这次作战最重要的，就是恸哭之门前的晶柱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3354f000837d9a73863dfb36985218b42ec845b0861b3500aa639c05880e9b4",
      "source_sha256": "d184f5c6be64644fd5ffc54d2df813eb2136d1242c2662871348c8e607d70b34",
      "translation": "只要占领那根晶柱，攻略恸哭之门就会容易许多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ab208b88111925b1a94d4be3ce08733e08d18f9596daa104d048ea312964a2f",
      "source_sha256": "c5cc367bc2337cd4be0d19687bdf594595c0c42c7fbed26fda9b4f6aae4d7b22",
      "translation": "在与敌军主力对峙之前，最好先编成潜入部队，占领那根晶柱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e42ff0806d0e6fbf2de7c38d0fc3bb37c873ebb3f6a0a705ded5339668750ae",
      "source_sha256": "bb3784fc43d481421c272b581c3f58ab974f64ef840857c6217384b5a93a4102",
      "translation": "哦，这个作战方案不错。我们部队里有个合适的人选，是个叫[胡安]的新兵……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d9b28c42036b7bee54dc818ae03c2a46463f813b2f74ca9c7259627d4c91d549",
      "source_sha256": "e8c0dbf9d02fa413403e72c265ef775913f565057ba60d31cae8ece8d0f50f78",
      "translation": "胡安是个相当优秀的士兵，完全可以交给他。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f75a04a7764ece06dada81e96d76da5a50aadbe1886513c6ce13a71bc6c11678",
      "source_sha256": "f56c7128fee12f981dbff7d1a3fb0e5deae402c9194e9576d5e328803c4dcd74",
      "translation": "那就这么办。挑选胡安和另外几名士兵，编成潜入部队。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:05b6ed89a2305f008e17fb248f997a8e419d361b529974797794ab8c1cba65b1",
      "source_sha256": "cbd8bb37a9472640018824892227d6acca74e874ba2b4734528ceb2da7e923cc",
      "translation": "嗯，我们负责这边啊。"
    },
    {
      "id": "coalesced:ffd0ca97986f75c6791e49baff74ea32905b26651be394130e73f6a72dfea394",
      "source_sha256": "1a59729336d6addfc9aa8a52e90376d2b65e06b332314afe00bd154901287bfd",
      "translation": "我们部队似乎在这边，是扰敌部队吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd6ea256e0850f89f2d0f66380fbd68c0f29e34ec9577da801790a6aed9e825e",
      "source_sha256": "258beb6eb82f8f6ae69ed127386cf53ff3ab80be51e51845b23700f397acf0c3",
      "translation": "啊～可恶，早知道就不参军了。"
    },
    {
      "id": "coalesced:a0ccfa8975f6e019a9e63c9c9b43a07cd99d0be11c09702db63ad3d102783980",
      "source_sha256": "a6f3044a1ebda53ce9e8e1f73ada4ac7080c53d3ff04a559dd5864ac82c88855",
      "translation": "求求您，给一点钱吧……"
    },
    {
      "id": "coalesced:c960544c291d7e7b437b2a5086d616b1973e0170b7c98e1fefa13db5edf1ce6e",
      "source_sha256": "9e53d493dc4b3d660ddc25cd8e8fe259a460a3b06fb169403b0d91415c2d28a0",
      "translation": "求求您，施舍一点钱吧……"
    },
    {
      "id": "coalesced:2c3e69380f0a589b9c954cb6f29534e6e01f83e5443e1d5ba17c559e5e6dab2a",
      "source_sha256": "103d2f6d1cccdd4eb2e2e144eb743fa73b7965a5f38c8faf94adf3d76b632807",
      "translation": "如今……已经没有希望了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:616c862110071e43638c7c4dfebc3f592b73559b47ecd068e87013cd7f0da3bb",
      "source_sha256": "3c86727b27e63d4c7833360e1cdef8c55fee31428f3ef5f0bc5f89fd67851edd",
      "translation": "战争把一切，都夺走了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9e372cf83e68245f02c6b0a5102b218cfb4967bb4fe4ebe46230559fecdaecf",
      "source_sha256": "60b5e6ad59dc648d986be67e64c116937f68bd36c1bbc3f99fba453890f963dc",
      "translation": "让开，让开～别妨碍我打扫！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:265db3879af97dcfdcdcf28c887b140a9a0ef6540153fe2d754bcd71321be139",
      "source_sha256": "905115103d276540f4fe87ef75ded0f9c902c488dfeb7ce8caca4a697eabd396",
      "translation": "啊～真累，太辛苦了。"
    },
    {
      "id": "coalesced:1477086533a96804ec6b5b995bb2830cc3ff8a9d17251aa932e7f27839706de2",
      "source_sha256": "7d02ded8ae06e214e62bb993bb83740349a1985e514ceaffee860399ecf102a2",
      "translation": "贝尔福特的难民不断涌来，每次打扫，都快把我累死了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e0419701c7d136846feb38422ef67387d3cb4c0e0f54b5b3a678915ad28ba36f",
      "source_sha256": "eca501762b5e7076c38d8ffd2c9462d88f56f7a15be1ec8c9a6166cbcd642e97",
      "translation": "当然，他们也都是可怜人。"
    },
    {
      "id": "coalesced:ed3db4aae3e89a1820f99383ddaefe9b124c9a590d52da06194423f8903a6743",
      "source_sha256": "1126ec3a920d11ad27c51542d5d0176086afcbce6999e9fff93471e8b94f2869",
      "translation": "呜呜……"
    },
    {
      "id": "coalesced:183d09fccd2139cd65fe9c487bccffa5a21587bdb109d15a505b32aa3edf9bed",
      "source_sha256": "0270bd0d8c36f4a4d63b9b82b7782cdd8f9e0992523e6d158bf2d4157fb1eba3",
      "translation": "这样的人生，毫无意义……"
    },
    {
      "id": "coalesced:1f8983ea364581b51c16b50a9c071c9cdfec271b035c0bb734000ed97b895119",
      "source_sha256": "9950237d8325206b2ae2f366638b1ae1e0f5d104d0f0eadefb9f7b804de175c8",
      "translation": "好东西可多了～来看看吧～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67b0039ac120b0e957d77fd5eff4bdbf0a8df818c57ed1007bd41dc6f40feff1",
      "source_sha256": "fd9912eb9b9a226cc0d37da3ca78d02ace96b7613109f04d3005d70c1217381d",
      "translation": "都说了，我不是间谍！也不是什么可疑的人！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a691d85ac5f83762ba0ca0250c3624bd20e525de083bb05d558116450f3e5c7a",
      "source_sha256": "cf64eb5f8e25d84901506177d4fe35e0f47f0765ca82fe950db73e00efc22fdf",
      "translation": "嗯，这下麻烦了。乌鸦兽比想象中还强……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b1ef0db6c36baf09a3f08135550f92c8478a870491a14fb6414cbd0fcf2cc4b7",
      "source_sha256": "add498439160ec86e7fab12c83219fef47634f5c42ab349e8337414f89f588f4",
      "translation": "这道门里面，就是总司令部。"
    },
    {
      "id": "coalesced:cced7e7b889a664bb7cc8d79970c5eedfa2f306c250bf9dbfc42e4e7d186e65f",
      "source_sha256": "09f9842bc01a36391d41b8ba2a4804fe36a4caf71f81e906eaff1cf2430572a1",
      "translation": "里面是总司令部，未经许可，禁止入内。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca8f42fac17f50df1f2fd4f96b975d4db9946a9ab5f508e180ffcdd97f2752b2",
      "source_sha256": "b2f8c4d31e87317e190d4a2ee13338cf31dee8c5780d50731918313bcf71f045",
      "translation": "这是英雄[斯特拉斯]的雕像，他为了拯救兰兹海姆大陆，牺牲了自己。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:07adccf774b68f050e30c81e93220772b64202489d4d50d0b64aee561d7469d1",
      "source_sha256": "5befe519bce229336e58dc0567090ab96f8a7f9be995c61e067c791392c085e5",
      "translation": "话虽如此，他早在一千多年前就去世了，这应该也是凭想象塑造的吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e530fd85bff58747c032749289a295ed00fdbc5e681942789938d02909ea1776",
      "source_sha256": "13f7138c0cd7bd74426f1cc337bfbf620b44d4887be7cae28bc4efcaf50a6eb7",
      "translation": "为了拯救世界，献出自己的生命，难道不伟大吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9879b077c4c274e135c2429818e2c9dae751e0d0c4434af1b545c3264bec044",
      "source_sha256": "376e7ba8390fb5204639396a8515fcdb5a7c60837f5a5a1e06220e6da4276b9c",
      "translation": "斧子由我代为保管。"
    },
    {
      "id": "coalesced:72c32a00c983e7cea91602c930fb5dbb9f76e0a30893a301f324aa6ea9438670",
      "source_sha256": "76ad128f28dfe94cbe118931eef6bfc01d017bc1509e61e9622f73f18ac5b1a8",
      "translation": "南部军里，能挥动这么沉重的斧子的人，恐怕也只有阿尔戈大人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6117fdcf8a6c7ea0ff3283c6348f968710f04c4847b771635098101021fd06cf",
      "source_sha256": "475feff1c28117640915b093d92295f0a6500f1acf65c6de7ab1319814927b24",
      "translation": "那么，请务必保重。"
    },
    {
      "id": "coalesced:16890c5c3ee71ebe7306c904c6b150f5574f3bee48b831ab5cb73d49576bb6d3",
      "source_sha256": "de82e30a2e26ac12150ca48b76c91c42ddc71d25aafe62fcf741a696cc397b98",
      "translation": "竟然打倒了那些外壳坚硬的变种，真不愧是阿尔戈大人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43980ad29bbb934eeb27070c34fa6524806320f09ba910d6d7e50ddfc0982d97",
      "source_sha256": "42cc91a4dcc1cca8174a8e28e5f0f43671a924a65f377d48a1e4bc440ff80a49",
      "translation": "我会向上级报告，此次任务也已经顺利完成。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92aea3caba209818192f7b79c998e91b1934c01d943e2d3961e16d21db948936",
      "source_sha256": "1e68d04d34f782d17b4f3110343efa1a088f4f6f9bd82197a0d6420b08da7690",
      "translation": "那把斧子不必归还，您可以继续使用。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e41508f6df60bb1f3068b8231ebf5ab0aceade233b2caaaba8dae3e2abb26d2b",
      "source_sha256": "dba108ed34536cfa0e0dd616f19a98aa5d870b6dccb81c4022c46ab020503cd3",
      "translation": "向阿巴泽特入口的士兵领取斧子，消灭从港口通往\\n阿巴泽特的路上出现的3只[强壮拉普斯]\\n之后，向阿巴泽特港口的猫猫族\\n领取炸弹箱，再将其交给阿巴泽特入口的\\n南部军士兵\\n对付强壮拉普斯时，阿尔戈的[破甲]非常有效"
    },
    {
      "id": "coalesced:352d5e6da6207d4fee877b07a77d1b0b51777b330b91dad8532e79cb5bc43daa",
      "source_sha256": "24078931581a6486da05a739f2056c4ddb1423f3e3b7f399f8df09617e880d97",
      "translation": "QUEST%s: 消灭强壮拉普斯 (%s / %s)"
    },
    {
      "id": "coalesced:c86a5fb2bd20df44f89a1716113959ed7bbc7dc604aab8b4a5f074b9c11b9cbe",
      "source_sha256": "91da62b0e143b95df9ae87d95409200bcbf602767bcf41b51510d2965fffb239",
      "translation": "追加指令"
    },
    {
      "id": "coalesced:6a416c2cc4086f355d7e8a2209fbc69a100b0c03fa5a80f4d07e244ecfc825f1",
      "source_sha256": "89aad3e1873b7b92401e4f06687e347ec9f02b26ad32abf6854dd49b23ffc210",
      "translation": "消灭强壮拉普斯"
    },
    {
      "id": "coalesced:cbfe51fa48814d618b43c032e25ea4d204f370457b92e1cc83e28ed145aa9b02",
      "source_sha256": "f84077a1c185eb6c09f72ef51f98524af2d5ea059470e4d0ac5c6fa9807feecf",
      "translation": "领取炸弹"
    },
    {
      "id": "coalesced:f6163ae6d5edcd16d01af4e1bcd42b4a408cf9ab3f0877847a8ce3c107f08561",
      "source_sha256": "d7aaac8d1c1b0c4d7b807081b3676485f2fe458d5d72c98741f48c20ca49aef6",
      "translation": "反哨兵部队的各位！！下一个任务，不是需要用到斧子吗！？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:325ca9b1ce65009c134ae6b749972c9df795304ac673b07c59a7b78ae94da7ff",
      "source_sha256": "0df037a143a403842dba76318d002a9226d79dcc66f0ec023467aab01c75f122",
      "translation": "鲁坦"
    },
    {
      "id": "coalesced:7ac94eaad596bf71f5771cdb4e1b30c1be747a9626675ffb8493e7c9501d2b08",
      "source_sha256": "de70d18ea2171df263501c97d3651b3d0df91326b1167e942917b183e3bce27d",
      "translation": "尼尔提"
    },
    {
      "id": "coalesced:543ee75abb3c9fe5fd503a9872a7cfd4ee9782339a138277920d909f53383f1b",
      "source_sha256": "7e97978ceae3673d15a6b87e3705405c13665b62af7d9061dc113dc53b169d63",
      "translation": "杜南平原"
    },
    {
      "id": "coalesced:0ccaf985aff709fb9e1e2e3296496a6958c61e15066e4ed0f8ce9e4889637b56",
      "source_sha256": "0b8c889f10cb15a0dbf3242e76fda79e3336e17e7614021655dda61090886fbf",
      "translation": "寂静荒野"
    }
  ]
}
