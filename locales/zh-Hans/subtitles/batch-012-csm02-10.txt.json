  "input_sha256": "1c73bee6ead164c8d3f5ec02b04113a7f503eee44c5e9ddb0f4cfcd57629f93c",
  "entries": [
    {
      "start": 6497,
      "end": 6968,
      "source_sha256": "5fce558f8c08db80d186d657c26436d9d0ea643ee91cc424b96347517d07c262",
      "translation": "嗯？"
    },
    {
      "start": 6868,
      "end": 8477,
      "source_sha256": "92b7bf702e1dda78242fef51eba93d65e5b491357674eadd5d3b74bcb6efbbd6",
      "translation": "呃！"
    },
    {
      "start": 11141,
      "end": 13511,
      "source_sha256": "42a7a26df6956f0eb9f98df4e52050aea459b1f5815308322f99aa748e673018",
      "translation": "谁会向你这种人乞讨？别开玩笑了。"
    },
    {
      "start": 13511,
      "end": 15582,
      "source_sha256": "e42ffb1dc9e02fd38fb0b65fa909237c07419ecc973c985a78d8b34dca63c190",
      "translation": "亚历克斯大人，您没事吧？"
    },
    {
      "start": 15582,
      "end": 16081,
      "source_sha256": "d5497132543a548cde53e56d0bb4590db2d53c98576abe1148b291737217314c",
      "translation": "无礼之徒！"
    },
    {
      "start": 16081,
      "end": 17699,
      "source_sha256": "45e18d73c2d4feacad3d4e00ec23a7cbb4d94955e8aa4f4eea7c654e180761ae",
      "translation": "无礼之徒！<br>竟敢对亚历克斯大人动手！"
    },
    {
      "start": 17699,
      "end": 19036,
      "source_sha256": "937b339abaac35a472dc54079b0284f1bc9266653faaca0a296f7f4660dca8fc",
      "translation": "你想找死吗？"
    },
    {
      "start": 19879,
      "end": 22408,
      "source_sha256": "502e1bdd8e4137d37d7cac5c14951b1cf20e423c877c5ce07a38a232bf30abe8",
      "translation": "住手。<br>他是平民。"
    },
    {
      "start": 23060,
      "end": 27623,
      "source_sha256": "c7db9be5b8433e1d1773f853cb25d1458e46828adaa8dc5cf15f0a41a26c35a8",
      "translation": "哎呀……他莫非来自那座岛？"
    },
    {
      "start": 27864,
      "end": 33428,
      "source_sha256": "e5727156ee423160c0fef0c155c097bb385915fd23d02ad09211c1d22b33dda9",
      "translation": "是的。他在这次战斗中，失去了故乡。<br>所以……"
    },
    {
      "start": 33428,
      "end": 39134,
      "source_sha256": "146c675b6ef79805f7c9d363e43f07eb686e677b0f99447400f9b462d2d701d0",
      "translation": "够了！<br>反正南部军和北部军，都一个样……呃！"
    },
    {
      "start": 42571,
      "end": 46820,
      "source_sha256": "db68f3a55746ebd2581b72d40540e983d60a4cfce52aeefca1d522b4a12b0c8b",
      "translation": "亚历克斯，看在我的份上，<br>请原谅他的无礼。"
    },
    {
      "start": 47583,
      "end": 51469,
      "source_sha256": "a09cb434c2ad525234634da0ff3339a43a64571c819ecc79e90c8921710f78ed",
      "translation": "既然公主开口请求，那也没有办法。"
    }
  ]
}
