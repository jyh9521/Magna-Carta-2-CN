{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:c03532ccf68085153e8a1902e8ea416953220142175268a295da05f24431166f",
      "source_sha256": "4bb39731974c283590b4cbbd5da115dc2a45814a82e3b6a5793aa6cf237e4316",
      "translation": "对不起。不过，刚才也是没办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a0b03c4a5ea1f00693116cf413b3542d794c84e06c4d7dd734d9912721466f6",
      "source_sha256": "e7cd432c5a78ba0ed43f8c2e526e675078af6af53b1b8f5ce6b95d5dc3fb34ed",
      "translation": "你忘了我们部队的目标吗？"
    },
    {
      "id": "coalesced:c484340e84b7d4743b4bf23decab2b7f95b05edff64a1aa020f5dfa4dca7f55a",
      "source_sha256": "8251baf8d39ee84e0f34f85f98e9c9ef880884e138315782ea49d8ca0b23633e",
      "translation": "……我知道。可最后，不是你救了我吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9204148e04847782fc6ca0dd42d5c462cffab0cf85079ce412ac2486fc1ac1c",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:ae24191cc3a4dced6d16c4e9d2de29ec9813655e86731baa86f41b937d8c1d7b",
      "source_sha256": "21563fc0a5cdf76b5a711c73c75467f02a31d1467009ecc3afc560d5f39de425",
      "translation": "哨兵自爆的时候，是洁菲制造的保护膜救了我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f383d3c1dbc7dfbffdbeedf832e03aa078b9e3f4b8ffaf4223036cd857b0278",
      "source_sha256": "726b0485f0c126d97713cc6ef4014f225127c02a9a3c564f9cd769305331d678",
      "translation": "难道……是我在无意识中……？"
    },
    {
      "id": "coalesced:4662a95b1a93013de8b85d65b8f6261d4f88f2b5113f9e42a6ef81f4e5007aab",
      "source_sha256": "bee503fcfa693caa07b9a7a88df48232ed6b5a28f1c5ec536102a03543753fee",
      "translation": "应该是这样吧？"
    },
    {
      "id": "coalesced:ca694c6a8d50025cf66f1acb3dcbbe8d984f44f15a825bfa935fc7bc04dc5be5",
      "source_sha256": "d0b50d70b5993c068d25597c877772bf17d4c402469347d3bca26c847bee4954",
      "translation": "我差点吓死了。我还以为，朱特哥哥真的死了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e6a9ec6eb318fa6c2b0625813d488425f9bee85d43f58bae8ddcc2a3a935c1ef",
      "source_sha256": "6fa58c7498664f0b459b2a2c7f6892380127a2a912d22b4656cae5549e7cc870",
      "translation": "可不能倒在这里。我还没给艾尔加那家伙一记狠的呢。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a122bb07f38197c9465eb522320aae87be42a6fc962aec5d70f5c905a53296f7",
      "source_sha256": "141d05a4a753e3a9bdbf3431ce14d7ee2be8621fd4879c53b2260f354e2da28e",
      "translation": "你这家伙，真是吓死人了。不过，你从什么时候起，开始直接叫公主的名字了？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83b8e15880600c71c5d88af7cfecc9e98f4ca9e18d9b000444619bcff4c74802",
      "source_sha256": "cb349175cb5758f92fdabdd5ae917897110524c053a7c4987131d0eddd5eb19b",
      "translation": "啊，那个……不知不觉就……"
    },
    {
      "id": "coalesced:96079568656da21c1a3f0ec67a2a4a64fb0c1c0b7757469598e6f15536e2d4c7",
      "source_sha256": "a6991b93ded47e989a69392df9659514a90b3f718bcfbba902a39ed9513ff47e",
      "translation": "哦……看来有情况啊。"
    },
    {
      "id": "coalesced:35bd808bc693011f2ac94e280ed9b47be69b4a88c4e7261d9a94eb5a2b4b6a1e",
      "source_sha256": "6e0d70a03ed0009db95cc0d85ba3572a9ec7969c87f115d1ce61fae460dc96e8",
      "translation": "今后，请克制一下，别再不顾后果地行动了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:217b8bf298aed918e69b6adf4e264fcfcf65f163b174aa5540b7bb237e719cad",
      "source_sha256": "a8348dcc6aed3cc4e44a4414932fddafbbd6e73f2797f1a4b390ceb132e6969b",
      "translation": "这次纯粹是运气好，才平安无事的。"
    },
    {
      "id": "coalesced:56ec903d74ab979e16f6e8372ba91f52fab2f3abbf17e5b739dfb0bc15d88e10",
      "source_sha256": "810f1059d2030152f73aecab213e494b555a13382fc0a5e439a377b5e5367648",
      "translation": "又开始唠叨了……？"
    },
    {
      "id": "coalesced:411aeedcf3e55d674b699b9804ed958b7191c55bf9ac40d2f84ddf314e965701",
      "source_sha256": "53f9f3c2a52c2bbe55447170d817a1f13c73c13d8a49cc6e65e0a995053ad88a",
      "translation": "正因为是同伴，我才会这么说。"
    },
    {
      "id": "coalesced:fbb2382ef751d1d47150526872d2b331e80a1235b416de23814788d814bf6c16",
      "source_sha256": "dab616d71095c88049641397ca3ef3efb9a2e3fa30ba2688f72db62e7d7c34a7",
      "translation": "总之，多亏了你，我们才能平安无事。不过，以后别再这样了。你也是我们的同伴。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f3351ca462a36cf9db8161e3f5e5fc129b0cea6fa14847748a0aaedb8acbd6d",
      "source_sha256": "d51ebd5f327b5f4dbd54caab14bcc28efbd07dc1bb08106240485e3b5d966997",
      "translation": "嗯……对不起，让大家担心了。"
    },
    {
      "id": "coalesced:2ee0bc05783d4bdd31bbeb7aa6d034572bd817ba6b9e71bee55de79e82a4fc42",
      "source_sha256": "f328fc0ddc4f95d8e3b0faa851da7df727744f0c295a3a74ba8276a480377f76",
      "translation": "那么，我们还是先回黑刃要塞，和南部军会合吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8baa4109ad8a614a713e025e27396b69ed472870bb5ea3c4c40b5c5a4b1e7dbd",
      "source_sha256": "8361eb0e3ffdc087b7cfe9293ecedabb1c2d66f0f310c681c83384b58e865abf",
      "translation": "话说……我完全搞不懂，这到底是什么情况。总觉得，只有我一个人被排除在外了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e152d7ec7431806c95defdb6c514a4d9c24de077932c4ff78103dff4a705c4fb",
      "source_sha256": "fdc45e907c22a54051f14822329dbdc8dd87996ad16ce82c39712490b45854ac",
      "translation": "过段时间就习惯了。我以前也是这样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:97e2003f503128215bedbf4161c06691dce5fb0128dd8e7e702ff46fc5561dd0",
      "source_sha256": "238ebf28cb05c28354b0f3441ad81ad2368190e96613bae0a4a8b0c7a13e0fc4",
      "translation": "我没能说服梅莉莎。我们只能满足于大家都平安无事，动身前往黑刃要塞。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b4879d9bd7d64544e0542d2806d00930a4e3bf9216044a30aef54c277d2a9e7",
      "source_sha256": "5f37f09a2de812cad5967879a229b49f98bfc1c51b0ad5bd865f8ca86cc9f913",
      "translation": "可是……在那里，一场意想不到的灾难，正在等待着我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4192336955a855aa969c8a94af0e26f43fc4d2265e56a8f691fa6d3df8910756",
      "source_sha256": "19b87238e59cfc18a1aaf8d6c5aab494e1ebd2f6e7212211d36742476e8df69a",
      "translation": "你是……！"
    },
    {
      "id": "coalesced:5080280e7dcd6fdb8288569f434cb8d8fe20e258fb4c9e9bb9789d89be769708",
      "source_sha256": "c08ec38d93ca05f21fb6268b2b1387d1722dffb23c359dea5783842dda98a8d8",
      "translation": "修恩扎伊特，你为什么会在这里？"
    },
    {
      "id": "coalesced:c78eaf446371172da3924933767a90bcce9f95d7362d7dfdcb9a3e241eb0ece1",
      "source_sha256": "20da9da62a839bb8c41d6bcf8b5f7aabc6a81afbd474d3f6e3bd283b8bb339f3",
      "translation": "时机已到，所以我来迎接你们了。"
    },
    {
      "id": "coalesced:a1d55b64ca20b00552bbcf4ffe92ff9168c7b589e283783128a02d2defec353d",
      "source_sha256": "7affd3b6a521cc5ce57bd385402b4df28939896e1d6d2036b000e5bde3b65790",
      "translation": "什么？"
    },
    {
      "id": "coalesced:6781feb897be062b7e34870ad4b867015c275456d40ee57102ba8db1389f7eeb",
      "source_sha256": "300e7a7715d68815e8311bf3aa22fd761ffbfef0ef7d242eed230a1fd9141993",
      "translation": "不准杀死她。这道命令，比你的性命还重要。绝对不能让她死去。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0de96a35090c83ad80790eb9c2fbd2d61ecd54e691f1e53a76e925b1e675e698",
      "source_sha256": "b2a4564f833c8cc5c8a71ba407d3c09f5d8923fc7505f1e227b7d06addb3f4ce",
      "translation": "你还记得这道命令吧？艾尔加……"
    },
    {
      "id": "coalesced:e38400b48745c757e47a50bf3f41a734347997fb1e8cbb5818d113813347a172",
      "source_sha256": "a9b2842e188e6aeafc7d60773169c54f632c45000c864158941983b3b3b00a06",
      "translation": "你说我是艾尔加？别开玩笑了。……这不可能！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40b2f396c99cfa2a2d5c488ee71e8ca55d0ea37076e394737f4646636ef6354c",
      "source_sha256": "a6effaabf32f6d1b8e4577a6ded7f435788c2d22a134047ae550b06387f96f19",
      "translation": "你忘记自己的任务了吗？"
    },
    {
      "id": "coalesced:1ea5134e433eac25f11281acfa0054d51959d2b55da5c7c0cc6e749dd072a645",
      "source_sha256": "59ac6f828075972f5ff8f0e090de262de88ece7bd5ebe70f463b58d7fdd632ab",
      "translation": "啊！"
    },
    {
      "id": "coalesced:da5434dbd2e9fc3b08e59e01e9f705dd8fec9770d9993128ad19ea7598574efe",
      "source_sha256": "e9b0d0fe85722b76b0d36c2bdfa53688307a769136c46e8df048d510a3df4230",
      "translation": "朱特，你真的是……艾尔加吗？"
    },
    {
      "id": "coalesced:c6ab424c21b60045f5cc7c877cf37ede343042890dc2c7e39879eb7bc4d31ba8",
      "source_sha256": "3115566ed710b1414842e50687801f40b1d7a9d2e7b0c5b613dc1ec5e5cabc0d",
      "translation": "不是！我……！"
    },
    {
      "id": "coalesced:568148ad1510017bf338ddcf1e2917c8f54a4fbf358d0e406f582d0744913e2e",
      "source_sha256": "0d76f7a2901281b46508c37b7c817c4fb29d96a30c0750d6784d4fb0fdc1b908",
      "translation": "你骗了我们……"
    },
    {
      "id": "coalesced:575893f121338a952c74bcbd5473ccd9f280658f7b2de77f04b61bb308d21b51",
      "source_sha256": "33d3b276066f6291562bdf831e65e75f7a9ef3fe25c45587774470f0a7eb9e51",
      "translation": "相信我！！我、我真的什么都不知道！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d255bfc0488194e6ccdfc48f2a3f9de308c34a62a449da9553cfa498ea30df07",
      "source_sha256": "12693598858a18f93bfed6b1b0248117fa3a89227dc451015d9222714792586c",
      "translation": "那就证明给我们看。"
    },
    {
      "id": "coalesced:210158fa81f8c1dff06b82d0bf24748ae156a1e6a841cee7e41fdb99aefbec88",
      "source_sha256": "74ab1214f3b0a9ec9ea9bc815533f9c8cf820f6ae6df5e9c3b99f8c467915790",
      "translation": "洁菲……"
    },
    {
      "id": "coalesced:085cf3dc462e93f888a2c4133e4ef437a1642eca542b0a9e283303efe88275af",
      "source_sha256": "8259fe2d5e19932e9fecc90296d5611bf3e5fa7869d4ca287cd40a55c15578dc",
      "translation": "想见公主，就来贝尔福特吧。会有场好戏等着你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d6fc3717783c7b507f2594c042342e5efa187eb39e0679cf5583a3c06242c9dd",
      "source_sha256": "03f1241c3520688b9933fbab291e42919b93eac4d192c732d32327a735b86649",
      "translation": "公主殿下！"
    },
    {
      "id": "coalesced:a3f7aa1b8181ea72f574a3a1dc10a90a60b22a7bf2bce499be30df34f3eb6220",
      "source_sha256": "bb31c5b7c70ebb84794633d1661943bb5f797067307049f7b875ef5bd925f3ca",
      "translation": "你最好别耍花招。"
    },
    {
      "id": "coalesced:904511188f89bcc06cec369ccb5492ce8051e33d404a1c7abdf36460f6af27dd",
      "source_sha256": "a04e15e523937839836127aa43087bdf8068426e7ad5c7742c735bebb6e10846",
      "translation": "呃……"
    },
    {
      "id": "coalesced:e04392748813acfa8b893f3d9567132c5d8775f677c850fc7c01073b14f57c72",
      "source_sha256": "8a985ecd880c412c562353dcfb8dd6db45170a1b17b59f6d077c533dc5a86c5e",
      "translation": "难道，这是降给发动战争的人类的惩罚吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b50c056d696e984c7df5ef779c0f91463fb312206d8c1c59584d0f97c2371400",
      "source_sha256": "91df85964ab29e2e018ccd9859c7199870a8e4092f42d08d7ae0d08a2f9ae627",
      "translation": "修恩扎伊特那家伙，离末日已经不远了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2fae08f9a96ae55e5188f1fb3a35da782edc6ae1c86629f976b3cf40c38bfd79",
      "source_sha256": "565ba6935d0988625849ac160c517d2dd2696a5fe73413fdfabd812ae6b2c036",
      "translation": "真是的，得赶快打赢战争，把这帮流浪汉送回贝尔福特才行。"
    },
    {
      "id": "coalesced:7819760cf11665885edd29ead1220ead68d631b5434c583d80b5a05fc1ad678f",
      "source_sha256": "8b88e7b4e5453adafbea09f611866003c20f6fa8990cb5bfaf80e410fab00aa3",
      "translation": "给武器装上更强的卡蒙德，武器果然也变得更强了。"
    },
    {
      "id": "coalesced:27930e8941dea709aa1419d9c8a9ef02de646389b2dd476b7cde619993a268f7",
      "source_sha256": "39cdfd298b8c81abd0d2a09298510bb64abf0b5252f80383cd83e3625213638d",
      "translation": "你也去找些强力的卡蒙德，给武器装上试试吧。"
    },
    {
      "id": "coalesced:feda95480af130b9095943d5cc106e765d3e1ada3ce5b793bd4538884ac92159",
      "source_sha256": "361ee742a527a6d92b7692ad7705b7ba9e7b905e9d6792ca37c6811be145351c",
      "translation": "战斗时，善用属性KAN，就能让战局更加有利。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcae235f3d4749d82ea4b38f2185514f1919910974efa5e015dfb16f3fe13337",
      "source_sha256": "8b26cd91b4542feb21b53275fe25bb0e23565f34b843817b83efcb17a8aac39d",
      "translation": "你应该已经知道，属性KAN是由连环术师生成的吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b580039455515d5f38f9ef190bb7fe668d68369bce5236e4a2ed82ed44b720d3",
      "source_sha256": "688b4cb6a129ae4ec9587c18ddcfc8b61503949999f5bd38bc92ee3960e3df87",
      "translation": "好好考虑环境KAN的数值，再生成属性KAN，连环术师就能施展强力技能。 ",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf4b5ce7d49cb320f338716fc81c88808c8bf6b15c229f1d3cfcc87059f001b0",
      "source_sha256": "2b30f15e854385c2e6d5d26e3c59fdb2e5470f49966bb34a09a5cd10510cca90",
      "translation": "最近，她不知为什么变得很冷淡。难道有了别的男人……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1737864f3b5da11030617646e450907e2b99be049721fe369df6a4b9bcedb3b1",
      "source_sha256": "6f18a8fffa544b715ae0477d9be29c34f7aa2cafa5c02ed4ab5544d29bd3aade",
      "translation": "约她见面，也不怎么答应。我是不是被讨厌了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06b1ee9977e464e4f5e9c604993bcea640d8a6922c54e1d45519db4b4f3ca517",
      "source_sha256": "3bf14df35ef9745773ac15a3d40a66a159bad78bbf20b7703abd9e8319018f88",
      "translation": "最近，男朋友好像不再爱我了。和他说话，他也只是敷衍。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ed04a0573d7f39ccb7f52d189c92af0772eb04499cf9c2498f7d6bae613e271",
      "source_sha256": "d045149b1c2d7fa4310948e23f9516c801f620ad9ff2f2cedd923778eaefb217",
      "translation": "就算见面，也像是在想别的事……难道，他已经不在乎我了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:856eba45fbddc2e38cca1baeff6771d48b29668eb358807b1c1beeb17d86e24c",
      "source_sha256": "ec0e11c3c557efe4df69a0d9f8ae63751a00ff603dfed0265e542ee3035ff587",
      "translation": "饭都好好吃了吧？老兵们没欺负你吧？有没有哪里受伤？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee6891d59ff775c7375e100e15a236d66877f774c925165720ba74ee5ca6f5b4",
      "source_sha256": "22ce69160dcc15f29155870c9c9a680594f0971f5a394d510400352bf55a08e1",
      "translation": "我很好，父亲。我不在的时候，您一定很辛苦吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2927d8a606cd3b64b4e8cf1bb0597c2e78779c68b26dd1723072a440ca3ba6ce",
      "source_sha256": "91cd9ea69c10043250312b077b42ad4b6d7927057803240af4f3bb721d8224ae",
      "translation": "没事，没事。一想到你在守护这里，我就觉得无比安心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:375190a3050117a0392bde029a76341548a7f55ddc1b3bfe890e71055c9163de",
      "source_sha256": "0d3610ef8807e1b90abaa169ab8feec0eab1de1c3f47f54b3c0c87a8646638a5",
      "translation": "父亲……"
    },
    {
      "id": "coalesced:eee610b4542fac18537906bc31702183283ccf7f83fd1729dfcae77c0d8a89f7",
      "source_sha256": "d88fef6f872a86dc0c00f3c565fa2c0418e27e6c004814c3169ac5c7a3bff4b9",
      "translation": "投入鲁哈尔特作战之前，最好把武器好好整备一番。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd8127186e0b5e2852e6f04f829e62430fe51dbcae56ce624ed6e9b31ffbf155",
      "source_sha256": "5fd69238eaa8d7edde04779743623c5cc304ec6591c79d3dffac5ebe2b79a2fa",
      "translation": "我已经给武具装上了一大堆卡蒙德。哈哈哈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d7cc973ca05b86d7c286fe8889d181075e6811c440c30e3043676c6ec841e36",
      "source_sha256": "f2bfb2b6e1255bdfe6da44b9488d6c56697f76fa5f848471ebf57705b44981ce",
      "translation": "这样捷报频传，反而让人有些不安。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa5c4e854e61d2af243ac79723f1421a7e53fb4f6f341ec6ef68d67619ce58cf",
      "source_sha256": "a45c2015157f84993f1181fd395b6a4e300938f7534f87805d72ffb50f4f649c",
      "translation": "修恩扎伊特不可能一直这样节节败退。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5159f6e9557d9a7bd0e3785d9ced6b2cf45b20ac5d0713c19178e5bd378e8bf6",
      "source_sha256": "acada22934528ad016fe2f54edf798e34ad311e84fcd7ddd55f26c94f4fe80c3",
      "translation": "知道最近流行什么吗？我想换个行当试试～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bed09b54c519b26501729140554fe3132cacd5844c1c908d46ba6ebcc3e81976",
      "source_sha256": "6b6abc167b17abd25d9d6c3eeb9055f744e036e941e6faf81918c24efca29e90",
      "translation": "听说特雷瓦原本是住在沙漠地带的部族。那里叫特雷瓦沙漠。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a1b576d8f2474b2ff5ce35a42cdb2da730b19e58889a58930e1361e1216c22a",
      "source_sha256": "d6bf26931b4813e95cb9b930358b4207f62079f08eaa31b6c291faaf5ce95f86",
      "translation": "可后来，那里发生了纷争，如今村庄似乎已经消失了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63c24449010ea15265f7d69f1f89deddc8cd010d2b698f38c896ce4cce65afa2",
      "source_sha256": "347043bdd8ef74149f71cd485e8093ba30142ff20fcf6b84df5a6fd5319d7c78",
      "translation": "只要南部军再夺回贝尔福特，战争就会结束了吧？南部军，加油！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cccdd64966168c1ffa65258d01a99066096d74c6ae20694fcdf6b2b7aa2095f2",
      "source_sha256": "dfe10a6aea6a734306fca42727ed9235e8c53002dd43a2b51ae02f0a838cae85",
      "translation": "是真的吗？再过不久，就能占领贝尔福特？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:592ae68cf118994b88c03c05c0b4f9c8be696b9af799ba54276cb320c1b98627",
      "source_sha256": "d338eb849efa7bd00391d389a266810228f5f2f466f4cb8ba4ee3f6e2a00e83b",
      "translation": "那这场战争，真的要结束了吗？"
    },
    {
      "id": "coalesced:f3819572db57e1d541090ec33e8179b1fe2b03cb063782f051629c5bfa7ea5c3",
      "source_sha256": "c8eecf3324a9e52f8152bc84754ea78ee6c17f6601bcbede16f703f93635a107",
      "translation": "嘻嘻呵！"
    },
    {
      "id": "coalesced:8abc0ea2c23e507f69ee42dfc7f98fe9977b7075ba0cd8ff4408572486898fdb",
      "source_sha256": "e69bd87526de1cfe7b491429cd624fd98e23a7d9b99b1e8ab0b805a4b71ddc50",
      "translation": "我接到命令，要护送各位前往黑刃要塞。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f23eefa060f5cc0156d4fd35cb830960fa27d9edea478c62239fd6cdd2b7011",
      "source_sha256": "ce3aad75d437b1996604a925098404386c6ec6a2505edbd5b7d374c80a6531fa",
      "translation": "各位要出发吗？"
    },
    {
      "id": "coalesced:027a704e6cbd0a56595aa50effea4c2ad4a13c7c6b0f048ad8072f857e00e4eb",
      "source_sha256": "bd2e4053dd03a68a95f5ad02e5de862c655ea21e5644852a2c55199b9775b86b",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 一同前往\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 不一同前往"
    },
    {
      "id": "coalesced:36774cda36f3459498e4930c27a15844c5851e496b09f45477a6afae69c6d288",
      "source_sha256": "edcc2b60a83a711d49dbfac091ad01ee529b0c61412d17aa3caf32f8a87fe775",
      "translation": "明白了。我们马上出发。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb43ea02f2ca8230d13593d76a776b05551f7f17d551c932b093320d16db878f",
      "source_sha256": "90d31d093e4814fe47ecbdc63e16efeab5f26a336abca63e280a44d9a7ad34b4",
      "translation": "这样啊。如果改变主意，请再来找我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3732ee4eec635b3052576af23cce400d77377bb3bb0ab46b51dadc0a4c81040",
      "source_sha256": "c6490fb5acdb2944f8319fa6271ec3c818a9606686fa0d3a0bd643a4d8a15ec5",
      "translation": "(应该先占领鲁哈尔特盆地。)"
    },
    {
      "id": "coalesced:aadcd2bb70cb00d7e15f9e76aedd2bc7b49254ec7d0d05146bed94350ef108f8",
      "source_sha256": "1e46a5e8ceb8959bae71d59649d9a5efd86d4273bf8d0169f8fc05d0fe79a933",
      "translation": "(这次的任务，是占领鲁哈尔特盆地。)"
    },
    {
      "id": "coalesced:992ebb5202648fd2d35c43fb909bcea2216bfd69be4f5b359f03447f9691aefb",
      "source_sha256": "86146b357a50878eb971c20287c1e064690675c9696b2f1a7ba93ab0a0c97c1f",
      "translation": "(这边是通往鲁哈尔特高原的路。)"
    },
    {
      "id": "coalesced:79d54b2e3fff0053a67e075a3d1b53434885ad4becd0636764bdb10c1440faf6",
      "source_sha256": "e0c2763fc5dd2c82ae6ee8b051967f087ba16d443bfcc02d0f7c6021dd623193",
      "translation": "(鲁哈尔特高原，等任务结束后再去吧。)"
    },
    {
      "id": "coalesced:8a64fed6f0d5080088c2e8147607d37c397076869cc5d428bca8dae80f62d7bf",
      "source_sha256": "1437bef1641c7eee555954bca95288ec96e566eda906f29e832242a567dc8f3c",
      "translation": "(现在应该先占领鲁哈尔特盆地。)"
    },
    {
      "id": "coalesced:2f31e0e5642c4f278de15749bfbb14cb07e864e4ebdbb028975a26e16a67849a",
      "source_sha256": "5f0410bac7471e9a363f8fe269fb086cdca10d2ea7de180bcf23ffec7e4969c8",
      "translation": "(北部军营房就在眼前。快走吧。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5e2cc0d747bf8801fc03dee6bb374fe82bf034ad42f30e09447f2c4817f0ff1",
      "source_sha256": "889ce5cc4ab3f88e559ca50758ba9e6f15867df73eb951a19fc796a3602c39c3",
      "translation": "击退北部军之后，怪物们又出现了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3cd6cf2cb6260b8b38702033216ef7e4808625ee925d1b086fe8f523e080d94",
      "source_sha256": "5e1a66b11e04be46981be8eaffc4abd246ff8aee425f99ff7dfa3d504ecbb4f6",
      "translation": "执勤中，一切正常！"
    },
    {
      "id": "coalesced:41e89e0fc0a8ea92f9f2fcaa8678280e78df201d9b35af8935813d47035686cc",
      "source_sha256": "fd88f239b5ea5ea8c2179adb397abb86bd1ab52144d71c5517e202f16676198f",
      "translation": "旁边那家伙，太死板了。"
    },
    {
      "id": "coalesced:7a0db5cf50fdee9025d053aff7cb281d5f402850649e116538dd53562790386d",
      "source_sha256": "75354745562d5b553ac296eb2d302c0161091702421a0be6790773b02c754572",
      "translation": "也该学着适当地放松一下啊……"
    },
    {
      "id": "coalesced:a65df17e29ea72ca83d690f7f87a1be18f5e7147dbfd72829a75528ae4d3ceb5",
      "source_sha256": "cf35f266f8c02df52f248277f41a27debb056a8a9cae9851b619756d79cd38e7",
      "translation": "上次战斗中，壁垒没有被摧毁，反而帮我们挡住了怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b6999977dc29d13635ea8a8d7cdd7bf7cace50d4c1bf388ba017b43771f2874",
      "source_sha256": "bbea74e0f9eff2b65e7599d5ab1392187f1d0883d40da0a68e2e2acb34c183df",
      "translation": "能亲眼见到反哨兵部队，真是荣幸。"
    },
    {
      "id": "coalesced:957c371995c8ac127da28251be5d34764ea2fd378de93a5ee699f446e136b5f4",
      "source_sha256": "d58b764702d35cb5212f959737f630d4729416bb5418ab648fc7b76b4f9c99bb",
      "translation": "下方与杜南平原相连。"
    },
    {
      "id": "coalesced:d430ceef390ec3baafcad2e5522ca92aa644b6d3f667b77fa25025438a7072dd",
      "source_sha256": "9e820f2586cf4fa3d775289c8b8ba32c69f552f333c64f53ba11b4eabf7f622f",
      "translation": "北部军为了拖慢南部军的追击，把各处近路都堵了起来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c400ba9f258ed656a145ce4b88fea454042658dd13fdca6b13cbed36be3f39ec",
      "source_sha256": "0752e2a141a0871565256dabbb3713970ddfd094bf39dab4d5ac00f81fb57ec6",
      "translation": "还有相当多的敌军部署在附近，难以正式展开清除壁垒的工作。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bb18cb173636cf4d0646a6f57651a2fd46c83eebc75b96ba53d989d37fd6f2b",
      "source_sha256": "86af0b1ebd27460d617b7e99b958c21474e40172ce9b9969897a42d6826b260f",
      "translation": "北部军守在狭窄的道路上，很难继续前进。我们相信反哨兵部队的实力！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dabfb981351309c70d6a84539dea460aca5cdfd042b7a2d14c5b7ea06e8ba29e",
      "source_sha256": "1904b816cf18d729873212fe9f6c67105b5414794516ad786fe06d4bfece72d1",
      "translation": "据说，中央桥梁附近有一只名叫[雷卡斯]的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:86781cb92e96769a69559d933010a3d0291e1738ff59c47a23f2ad86844e2896",
      "source_sha256": "2cf2c46aa061454373ecd8c12a74f364a36a380545a1c8ded14f062fe0b6c205",
      "translation": "它会使用异常状态攻击，必须做好万全准备。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7ecf2952c0560db7babe2a32fd53941c0f0727688830ed10361af8a590a357b",
      "source_sha256": "7daf86a7f33770aca742f412cff06780e20ec27284f29bca9917ced6f6b3a0dc",
      "translation": "敌军部署了为北部军治疗的治愈连环术师。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b5d04081c4822a5b09e827245457217b57e3409cf81b8c1721d7f4bb4a45c0e",
      "source_sha256": "76c848e5a8e9adaba847ab05f53edf5969f5370fb38cc423269c0a91b650ef1f",
      "translation": "战斗时先打倒他们，就能让战况更加有利。祝武运昌隆。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4adc2467baafea1d979fff1d61788b82b8c5c68921baf964d84706871c2aff7b",
      "source_sha256": "0070e28c74390abcaca24a5d1de0952f271f4d9e8ed64a894120a6889b962829",
      "translation": "能夺取晶柱，真是太好了。只要再拿下东边剩余的那座晶柱，就能向贝尔福特进军。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3d34ee4fddf50a1ce5d1f7326aa714470fd5297214125b8a0817d06c0bce334",
      "source_sha256": "cb4282d211568a2283e8365397286c8c85f854faa01264f28da783b4ae36722d",
      "translation": "北部军里，到底还有多少怪物般的家伙啊？哨兵也是……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b3ee845b00c35640ef260939929188ce378a17f3b9685c76e7a320edbd880cc5",
      "source_sha256": "4f92d16ca25ce22ea0e4aaf0706fa19999e75c0274276108d9248bc418c861c2",
      "translation": "我还是头一次见到说话那么快的阿维斯族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9639ba1a15e372f64fdf314a64270d0c55abaa2b2c8450e456ebd944cc30b67d",
      "source_sha256": "e08adacd27cb617845a9ed465f63dd3791e094568bde4171595056e3e4b5dddd",
      "translation": "桥的另一边，也有被北部军封住的道路。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea7b749dbdccf2154df9082a7e6781b2f41e89b09b2f59eaa9719daa5e12c2fb",
      "source_sha256": "3e6093a3e1c50d1b3fe9d3f2480168f6c16fd9d18fe9a7d6713d06aad2e7ae5c",
      "translation": "我们准备清除前方的壁垒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0011d0042ca9ceddeba457700ce6e784dc88808afd6be871291785e26ac90848",
      "source_sha256": "ab1b28df0eb48ae8ceeb19663758e03f5c43d47c389b65b6ecf561ab2f4c59cd",
      "translation": "下次来的时候，应该就能走这条近路了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb30255eb9b35e1ab455125bfdcd515c878e1c3b72aa6e515fc8fa5d03a8fb24",
      "source_sha256": "407ea5de8ffac71475d4ba1ec2f964b4318d331adf9465067146ebf4d30f137b",
      "translation": "外面怪物虽多，可它们进不来吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
