{
  "schema_version": 1,
  "resource": "MC2Game/Movies/csm10-70.txt",
  "input_sha256": "a47cb1be25162cb6b6a3fa0cd90353f7cdd95628a0b191848bbfae80f9953a66",
  "kind": "timed-subtitle-text",
  "entries": [
    {
      "start": 10318,
      "end": 11355,
      "source_sha256": "74ab1214f3b0a9ec9ea9bc815533f9c8cf820f6ae6df5e9c3b99f8c467915790",
      "translation": "洁菲……"
    },
    {
      "start": 12095,
      "end": 15794,
      "source_sha256": "3784aad925f47b5ac38006f0e4748568268ba9bc01ef59e978f25a421a36a7cd",
      "translation": "笨蛋。又让人担心了……"
    },
    {
      "start": 17737,
      "end": 23355,
      "source_sha256": "3754ef5efed961a064a98d6ed05552baad290fa8d79bb317d0697e4525e9dfcc",
      "translation": "对不起……<br>我绝不想失去洁菲。"
    },
    {
      "start": 24997,
      "end": 30928,
      "source_sha256": "73f24d9d834c865f2623f583b3244d0e2e5faf60b8d8857890fd005ff72c22e5",
      "translation": "我也一样。<br>所以现在……回来吧。"
    },
    {
      "start": 31268,
      "end": 36174,
      "source_sha256": "30be2941dfe418f151f55a6192a8a27f89579b3a0a7a6f4f3b36ba5c5d4126df",
      "translation": "只要你答应，不会放弃你自己，<br>那我也会回去。"
    },
    {
      "start": 36587,
      "end": 37966,
      "source_sha256": "7affd3b6a521cc5ce57bd385402b4df28939896e1d6d2036b000e5bde3b65790",
      "translation": "你说什么？"
    },
    {
      "start": 38783,
      "end": 46087,
      "source_sha256": "4aa186b9a3a8909809d08b6943ae909b3be302bacbc07746eccf04cd52b89588",
      "translation": "如果为了拯救世界，需要你的性命，<br>你一定会毫不犹豫地献出生命。"
    },
    {
      "start": 47000,
      "end": 53781,
      "source_sha256": "89e46532e0a1a1a822447a310f24501b94f795f5b970730df541093c08062a9f",
      "translation": "一定还有别的办法，<br>能够拯救兰兹海姆。我想相信这份希望。"
    },
    {
      "start": 54104,
      "end": 58429,
      "source_sha256": "b36a91213c7334e7226f9bae95245cca34002a30e1036f76c9cf51ef721e6697",
      "translation": "所以……答应我，绝不会自己放弃。"
    },
    {
      "start": 59212,
      "end": 62145,
      "source_sha256": "91b86904e928dfdbf233c673fee02aa04503e80d081c41cf323a83ce47fb89a1",
      "translation": "要是不答应……我就不回去。"
    },
    {
      "start": 63169,
      "end": 67110,
      "source_sha256": "6d5046dc72f40f4898800ab09e05aa7affffd2b9f126f2a6d3db63fe0c7aed7b",
      "translation": "你现在是在威胁我吗？"
    },
    {
      "start": 67530,
      "end": 68626,
      "source_sha256": "562b1bb98886f07957d8206de23b64ab1ee0366dce1a55320e27d8c2e132fb99",
      "translation": "也许吧……"
    },
    {
      "start": 70109,
      "end": 73876,
      "source_sha256": "b28cab777e7ae3aaf813183466fcac4ece664af46ffad0c199f67b46a338a9c7",
      "translation": "如果……找不到办法呢？"
    },
    {
      "start": 74342,
      "end": 81839,
      "source_sha256": "a86c1edc0c3c6dc4c6d855cff9e6ae80c5f58f39a682fa1a201042b550061a16",
      "translation": "那是以后的事……答应我，<br>绝不会独自做出赴死的决定。"
    },
    {
      "start": 86030,
      "end": 88809,
      "source_sha256": "fa9a7a12020711b0b2b15c33ecd3fefb1f49775ad02c2a603c10a01d84700d5c",
      "translation": "……真是任性。"
    },
    {
      "start": 103051,
      "end": 105688,
      "source_sha256": "009dd3d27e7317c4ab78635ebfad15df4fc6969e86621b1a8d7df7b7cc4c84ad",
      "translation": "直到如今，我也忘不了那一刻。"
    },
    {
      "start": 105960,
      "end": 112831,
      "source_sha256": "da26a16b76b37dccbc600d9c85baddd0dbcbbb2d7659f5cb5c909eb1508c87b0",
      "translation": "自从风息岛的日子以后，<br>久违地再次感受到的温暖。那就是“幸福”。"
    },
    {
      "start": 113921,
      "end": 119224,
      "source_sha256": "c631fa12b24e3a947c84aa86aad8cb7dd552cf4ed53225569834a50df037ab1e",
      "translation": "我想永远将那一天洁菲的笑容，<br>留在眼中。"
    }
  ]
}
