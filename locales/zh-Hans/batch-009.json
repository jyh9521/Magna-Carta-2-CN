      "source_sha256": "a3b50733ecb717e2a894205fad00d17baf4631026806ac481ae625eed9922506",
      "translation": "现在，我自己也能逃走了。"
    },
    {
      "id": "coalesced:35928a6b8bbbd25c3c8997b1ca6817e965a4d07ff58d53499016d64264298b21",
      "source_sha256": "3d0fda224a85b84895f9e10449531da8d26d70ba9a22bd77929b53c5e115dad1",
      "translation": "谢谢你们救了我。"
    },
    {
      "id": "coalesced:dcf7a98f3dd7dfd8cf46458c5ac70922554c9829def329179da6963a5f451f46",
      "source_sha256": "e22b91e59e793965b056c47009fbbcfcce31a5469f8fc9eba121e8cf4f47c9d1",
      "translation": "我还以为，自己一定会死在这群野蛮的家伙手里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20a7893257cb17efc90235b3812d941ea947a7642f775ad47c78fb5c5079a6d5",
      "source_sha256": "1b757af28f21db1bd1698f1a3e5433e57f84fdb9817c10db6e315bd409e49c81",
      "translation": "现在，我自己也能逃走了。请务必去公会联盟领取谢礼！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:836417b0c463596f112fc2d9eb54f2ddac653b9184398123079f9707d5d1da19",
