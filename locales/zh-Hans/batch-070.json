{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:e194c02b03b4c5da22af4425d78342a0b11974557f5444e4a26248c690608f60",
      "source_sha256": "bed4c02475648c50dfd98534a0cfd9246d29c79176bdb91d53b34aad411a837c",
      "translation": "真是了不起。如此强大的怪物，竟然这么轻松就被各位打倒了……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19b54c07edca3d6c954b3386384253990a6ea015adb5ed7d6587436cf9fcaf27",
      "source_sha256": "759f045c8b9c3180d0859643e940bdb3f6fff969802d02d7254ce6432533b5c9",
      "translation": "如果是各位，想必更困难的事，也能办到吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2852f02af72ec07c9e57d16971c311f0acb9eb5587633b842d00375a3720686",
      "source_sha256": "1792f31ffcb484e40df082e301266dfc5103ad477b3488f5937476c7253a6522",
      "translation": "我倒是还有另一种巨型怪物的情报……不过，数百年来，还从未有人捕获过它。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:214c7d62a783055e0ff7526623b50a4ec2fd52b5878894140e7d01983edc42a1",
      "source_sha256": "bf603d4fb78b8f1778ca2591e4a67c3833152c6f33505875fa9a2e529e44a41a",
      "translation": "那是种名叫[巨蛾]的怪物。即使只得到一块翅膀碎片，也能赚上不少钱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:586d682a2b7e642f7fc2e51351e0dd8a342005e283b8969c4e62c3ebd47b2263",
      "source_sha256": "64b0023df9980b7d0ea4346bb01929dba7235678f27724c3c31ff0e01fffa745",
      "translation": "光是一块翅膀碎片，就有这样的价值。要是能抓到它，说不定，就能赚到惊人的财富。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0593944db1e2b3aa306c4ef4996b32cc67560944da861960e74565387aaa150b",
      "source_sha256": "249437ffb3aa7ae25338e0f2e8f7272e0f91050aa54857a071bdf5629d180719",
      "translation": "请去向迈耶，询问详情吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a064148ec3843163e82d7ef06db6cab83ff63dea63ff2e0162fb713d9d6d1f7",
      "source_sha256": "06bbf406bf4f3b5593ca48e6c3dee1a8ddd2547ef834f0e90c5e57f332ae46c6",
      "translation": "这可是能赚大钱的机会，请再考虑一下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d90276b2aec31e5e33c1ea7269ac002fb8cca5851815a32a2fd479dbf820dada",
      "source_sha256": "0d526effb4ccf536ba70552b8697f3d85e35f8048bb82247d387e2b276b3b9dd",
      "translation": "霍格顿似乎又在计划新的狩猎。请去和霍格顿谈谈吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:209739a1b8e95f3c898c234b7646d1b880b67f1cdb2f870d2b47857701b0ac47",
      "source_sha256": "2e500cf7d24c18464f51946801756c6ddefd55d28d83073fe34630cad93691ab",
      "translation": "请向迈耶询问，\\n另一种巨型怪物[巨蛾]的详情。"
    },
    {
      "id": "coalesced:77d9bc75158747e9821227713d95d8b13df63544a5754359083535b0dcca44f6",
      "source_sha256": "6caa551c1548c9a030e552a696b8cb1e3a065f069c85b18b741034d772cf1e2e",
      "translation": "另一个目标"
    },
    {
      "id": "coalesced:7ffce1be45a1600fb52ea1532c37161ba693455f454801c15a6f41a896339260",
      "source_sha256": "134f702279f586a0f8479457ef1e452daf66c98a386bd0b51a494f6595c091c4",
      "translation": "巨蛾之所以难以对付，不仅因为它十分强大，还因为它独特的行动模式。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f576dce8e6c4ab4b70137113016bf33a079456164911ad3be497f86173f25df3",
      "source_sha256": "ace6a264eb3b02a5a1a4c1b55af344d7ac91b9147e9f910b7d4fbe74749854a4",
      "translation": "它会飞行，难以追踪，而且总是只在夜间出现。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e46b3132fb6fb8f77abede58c73b8903dc699a084cbf09e95ac812c419cd133",
      "source_sha256": "0de623aff2deda3be4d0e1df2c4475de7f44fbbf1f620804eb7597be530cbee9",
      "translation": "它从空中悄无声息地飞来，所以，在夜间对付它，几乎是不可能的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a91fac84a79ae1d2e85ee7870f1a511ab83e3c009352e2d51530670efc9ed7c9",
      "source_sha256": "c2cf7fc3628d0110e45a59d93404db70115f0fe62337f6e3652f536af347db84",
      "translation": "因此，需要找到在白天引它出来的办法。根据我的调查，过去，巨蛾只有一次在白天现身。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0cbc7d8c21b0df323d5b64354a9b6126c9cdb0bbec6f7acb4fdf00ffd33876c3",
      "source_sha256": "43c908976feba2dd57e49dcad9be20643713a9c8daed499a3581a543520f9ab8",
      "translation": "据说，很久以前，巨蛾曾在正午时分，出现在柯塔马雷。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76d3026ad5e737c01bbd215fee1a378ef529509846f0aed8596727a3957cd10b",
      "source_sha256": "6bc19fc42a2cb45484b5d07ca3a3193b67f47017ba9067573b7ce4765ed886fd",
      "translation": "我与马雷族没什么交情，所以，没能查明原因。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:79d28169549ae91f476f51ac0f85bbba488c6c9e0c329b88641acb31106339c9",
      "source_sha256": "57677d953aff7f75cfc6c9fe6c0d723dcf67ef03235f288d3b2be0616041951b",
      "translation": "请各位，帮忙调查这个原因吧。"
    },
    {
      "id": "coalesced:c24b98a7d0dc8bd3532c55e449cab2e74d424d67853fa30dc90f244c04f9f9cc",
      "source_sha256": "2165f69721590fb1a61d6576b0bf0a601b77565388879f197236e2c4d4489995",
      "translation": "请去柯塔马雷，打听一下原因。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad8814188403186a90d26e5d82a8e17809350afee3a9304f6673f5788fb6b340",
      "source_sha256": "412720f1c7258f5ed871408e8591ce7e6afd2ac2a1d67d49c0090e3aa5a034c7",
      "translation": "我会一直等候，请再来吧。"
    },
    {
      "id": "coalesced:aeaab6d3e5531ea4fe2a0f07285a94b1183579cd58552e59e6c955bdfd7d9387",
      "source_sha256": "4f61b684e8d1b8d46f21383e3b4fc46ef07839b2db5b30dfb5c882ceb65f6724",
      "translation": "我会和霍格顿一起，前往它最近出现过的地方，阿巴泽特南部的[寂静荒野]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8c96f4c6e441b5cc9cdfe321ae63aa06d5cdf6b041ab4c5bcf3b25e9591c676",
      "source_sha256": "95063cddfce06508ae7c771ed64383a315bc3c8f4f0f143c4fee367e6980c69b",
      "translation": "我会在[寂静荒野]等候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddf198ca4c0a2c6bec953d9d27076ed39d2031bee6263558c3f894803538d4f6",
      "source_sha256": "0aec049f93a680f5f8f8c66b75bfdf028afe2512928f352a115b58d56cfb482a",
      "translation": "你说巨蛾啊。我很小的时候，曾见过它。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3c051cf1c74686cf890415e8cb068e88deb0a3cbd92c1508a1d92c63da44dd93",
      "source_sha256": "625e5e702ffe966e6ea03c1c583deba897752a97c725d94184a1fc303f21100a",
      "translation": "那时候，成人礼结束后的烟火庆典上，除了爆竹，还会使用一种叫作[KAN精气]的东西。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f108c9c6eca0bf6b3cf69437fd91e87eddee33e2b0a4b93d3f7be5ba0bf9ad43",
      "source_sha256": "8821bb0b44ae8d74096fa1e31c423bf875779a4b913e1887302d1c125091bf6c",
      "translation": "将KAN精气射向空中后，就算是在白天，也会爆发出耀眼的光芒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a64e208e8caa535716f1bd2d16428bc6ff5f339465e831841011f9089a1bce1d",
      "source_sha256": "2ab46958246a024110db4f1912e57408cb75864e9881f7adb032f41e2f90a300",
      "translation": "那天也和平时一样，成人礼结束后，庆典开始了，我们便向空中发射了KAN精气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb93b1c201a7345312c7a91059e7f45d8d4bcfe8b49d7d3ca33e7a007f5f43f0",
      "source_sha256": "313a0fd4b8d4131d6e5cb3ae3c29e33ffcbada483c3b7cd34b4df0c8215306cb",
      "translation": "随后，巨蛾突然出现，许多马雷族人，都丧命于它手下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:30345e9b8b0491b4a469245c8ae5af21c01868374b7edec0fbbac8f7805133fe",
      "source_sha256": "00dbcba3ee017f94a891053d8b2af3a115c2e72e0dbd8724a9f84b90abd82e01",
      "translation": "从那以后，成人礼就不再使用[KAN精气]了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ed69fd645ed8566efe50585fac616f97444b471f3dea05de0d51fe56f5f8719",
      "source_sha256": "1a9d500141c3786366d00232b82f100bd66ca5438cb6b63a978d01ea1413e2a5",
      "translation": "我想，巨蛾大概具有追逐光亮的习性。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a50d386e371308ba7ad45dac17b364efac4621ef019411a828138ae24067650",
      "source_sha256": "6e7c59d1373bcd99d50a508ffc6212bd8bb6ff5f48e751d15aee0549fe2de700",
      "translation": "所以，它才会在黑夜里，袭击那些点着灯火的村庄吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:baa7294256b5ba2188a6992aab115453cc3e5569b7bd9f2d32d40cb632d83043",
      "source_sha256": "4a7524fd9f98bd4482c4574536ebd9f839ffe39ea5e3634bffb1d76cbe4dec73",
      "translation": "那时虽然是正午，但它大概也因为看到了极其明亮的光，才袭击柯塔马雷的吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12857ac12435604e1b1fe082a415b38297d0354670039595a98a3fe6872afbfc",
      "source_sha256": "ca262726529edafce414efac48fab4067f8f6a2ff53d0eb1b89f147c4d4c0584",
      "translation": "据说，过去只有一次，[巨蛾]曾在白天\\n出现在柯塔马雷。\\n请前往柯塔马雷，查明原因。"
    },
    {
      "id": "coalesced:039d0cf2dc1aed44eb5ed8d616a97e61e399505d80f98908b7899255604634fc",
      "source_sha256": "a2fe7f291dae7c7497f41daa13eb8364143c08a4d25f28619419bf6c9f0d5dd6",
      "translation": "寻找秘密"
    },
    {
      "id": "coalesced:7e2a053edbf32c856a8d97f18e1fd890199f8488373722cb74d7cc25def96271",
      "source_sha256": "bbe6590574da8e2c99a010e7efc6344a976602e5066db8c38464b1e731a9f7ea",
      "translation": "你说[KAN精气]啊？要制作它，首先，需要4种属性的精气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0e98df07644154965c57aa81062dc0ea57b7f282f4cd76c8ff36af97fda51b4",
      "source_sha256": "4a3491725a574a708bb47c22c9512586926256761b50433b9b4fc4c3c25a8202",
      "translation": "[水之精气]在海底洞窟，[火之精气]在老狐峡谷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ba878afeca38d3192b04e47e4529f9d171b0132c42dcfabb66ec35d59a58bc9",
      "source_sha256": "ba1b30d080512d3f5a5120aae0d6336faa3bde2ddbf9f5217dc225ed9419bc83",
      "translation": "[雷之精气]在鲁哈尔特盆地，[风之精气]在阿巴泽特，都能找到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0e4e26fcccc255c03648824ee8f12b97b4d4237496c98ecd61d19c3da4405a2",
      "source_sha256": "e767ff78553bf40a1f3e0356e352a1f0d150c47b8c7f2b1205efcced9375e5d6",
      "translation": "只要集齐4种精气，我就能为你制作KAN精气。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80f7a20ffdd39350417bb6ea435be71b5edd09028a347b198d4683583c78f416",
      "source_sha256": "3ed49c226be5e732373d5970505e0f740799ee0e09909e277e3442500f75553c",
      "translation": "还有，把这个拿去吧。有了它，就能看见平时看不见的，各属性的精气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e8a69094410ae9a1ca71e1e533855888ac5a995a43e242ffee6ae28f25f4c80",
      "source_sha256": "5f9ba271431d3e524882c4b29d446422c1db3ea8c46770819d86d8db8a411ea2",
      "translation": "另外，这个也会派上用场。有了它，就能收集各属性的精气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3acd567df9bd3593713006f333271b16c2639052d0c206ba2c366a918cc4a0a",
      "source_sha256": "d79f94c780074ef16d0df9ade670ac666c11e83247596b3cf8abd16daa1a574a",
      "translation": "需要KAN精气的时候，随时来找我吧。"
    },
    {
      "id": "coalesced:5a11eed1168ae8eb89f4475ef38f9809482a1c00983295c638adb6e154b083bf",
      "source_sha256": "1b26d186b768385379a5df0bae0fd7bc912eff2869fb82fe709124ac60eea0cc",
      "translation": "4种精气，都收集齐了吗？"
    },
    {
      "id": "coalesced:0bd21b6e34aec3ceb60216f94a9107377e97d957cedc222fa7399e285462c091",
      "source_sha256": "7563110f4a1131f167aad3fc5a86cb957142f3b61351342f634ca84116c1cc84",
      "translation": "4种精气，都收集齐了啊。"
    },
    {
      "id": "coalesced:4c7257eb04503ed9e76d21de15fbc6e683f0e0cb022596571ba439cd32dfae6c",
      "source_sha256": "ee6e80182e782e4dadf314bae39851d173a4fa7f5c45b6dd3ddebde900705b5e",
      "translation": "来，拿去吧。"
    },
    {
      "id": "coalesced:c1911109561583ff403efc5b34b3db3f2a1b78da4e2a7d2d55f97fa9dba904c1",
      "source_sha256": "f42281af62328104d5c028a3e9ed0d114715861868bb6e1d7cd7f77b0ef5c966",
      "translation": "QUEST : 获得火之精气"
    },
    {
      "id": "coalesced:165ecca9e0bb438029a15973fcf0f683c44258c5430c3e9a837c48dfabb3747b",
      "source_sha256": "d9b215953d77c32561e397e9420548d5f8706e988979df7fac5c0d44d045b47a",
      "translation": "QUEST : 获得水之精气"
    },
    {
      "id": "coalesced:bc5163bb06e40059e257f7dd6f441ffc993d3afb9a12f03731214cf4dad0f8d7",
      "source_sha256": "1c0a2dda11c92de908565ff4e05a541048fae43ef7a1e91f86904da2676684cd",
      "translation": "QUEST : 获得风之精气"
    },
    {
      "id": "coalesced:653499447d0f532abfd4304477e4713d98a56eac22baaefcd81b889724f1a97b",
      "source_sha256": "746510cddc646db996cdcb0618b5d22bb1638110bf5a9cd31f430a5772c0ad2f",
      "translation": "QUEST : 获得雷之精气"
    },
    {
      "id": "coalesced:36730eeef3e19e2e7af72a343f7369f791b0749a1dde6e5aabb3953930fdf9d3",
      "source_sha256": "6f8908a7949891bb7a41edcbd5a92fea4db575fc8222f816a9b96fffb3bcfaf1",
      "translation": "为制作[KAN精气]，请收集4种属性的精气，\\n然后返回柯塔马雷。\\n[水之精气]位于海底洞窟，[火之精气]位于老狐峡谷，\\n[雷之精气]位于鲁哈尔特盆地，[风之精气]位于阿巴泽特，\\n均可在上述地点获得。"
    },
    {
      "id": "coalesced:83dc2a043b35a9851e072df9c4af2693a6100536be9ddfb7b92bcc413b26e0b4",
      "source_sha256": "689f9d0c6a89d1c6315153d3f9bf6af3f5a72bd1292bc8c82e272c311f967076",
      "translation": "寻找KAN精气"
    },
    {
      "id": "coalesced:bcca6e854aef76de8eb5ee18dd9e10ad5de4624db328d719734572f39d3eb5c0",
      "source_sha256": "c02c737f3b24db37b630054a728c7951c1d5161048ae7c1279e8fa574e631886",
      "translation": "火之精气"
    },
    {
      "id": "coalesced:e072315b593413242a86b6006c800377c529b2e6dafab7475bdf7981384e5efc",
      "source_sha256": "6be77718b1d011eda2fb2c21aafe07aad206af8f75734580fbb80280d67f1044",
      "translation": "水之精气"
    },
    {
      "id": "coalesced:76e613c7d44c6c31da4de5b9c6a1b1a52bdb9c11df4e92705a2c115ae7e60de4",
      "source_sha256": "57416f0c131b78eac6bfacc34209c23435405b9b2788ca2d980cace330581c16",
      "translation": "风之精气"
    },
    {
      "id": "coalesced:0bf956d60c6b88107ef8e2422e689eac64765d9cc35760b57573a541172cb322",
      "source_sha256": "bbda00eb38dc2215d406ff0af424db793f73ae4d3faf3128361a37867ceb6bca",
      "translation": "雷之精气"
    },
    {
      "id": "coalesced:9151f62129c23e8884b1100808bad017ca0d26c586c7fa3c99f02137ad4a4ff5",
      "source_sha256": "e84e548d55cf7224175a62d75788f96b84a98c22d8de0dcbbd709da25783d4e5",
      "translation": "您来了！！准备好了的话，请和迈耶一起，开始行动吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48d26099383d6dfed0cc8f39c4d8a6248f9546f788ec5ea54cf6937a3b3942fa",
      "source_sha256": "df9c716f3e32804580a5d921c38e2782894df1f82ad3437fa87dfdcb579d7a83",
      "translation": "请带着KAN精气，前往霍格顿与迈耶等候的\\n[寂静荒野]。"
    },
    {
      "id": "coalesced:0b4344273f6a97af8cc1d22491faa846f4d1650440628a97ddb8aadc27d3a4a2",
      "source_sha256": "a2028bdc4a8cf31922b8257636e3e0350c46ff210b710d5e6771a17fcf26df18",
      "translation": "前往寂静荒野"
    },
    {
      "id": "coalesced:588875613bf22a076fdd204eb4f19cfa7f2756ad527970379157e2574533fc79",
      "source_sha256": "e9e458bfe55b6e1b424c7bcfed16fcd11ccf711271cc4cd881a89d260d402f2c",
      "translation": "啊，您来了。"
    },
    {
      "id": "coalesced:d615e58e90a9024d3d35572fb786dfe997ecb21ecf7aa0e2d2e43529e4016cfa",
      "source_sha256": "7cd06484a92e4f90ac38a3c564544cf5f9a34cb8dc1ca66416cc3dcf299c63d6",
      "translation": "KAN精气啊……原来，是这么回事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:99857c2e92e4d3d7cd6b24bd55b94355787a1c59683b6515bfdca0575ab7af9a",
      "source_sha256": "e0341045f357d2c488f60d78e4e4157754974eb1c402f19dfd00bd959d7ecb6e",
      "translation": "看来，正如马雷族长所说，巨蛾大概确实会追逐明亮的光。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b4f5c3a0b0d5beb4b21c75d54c1767e6a72bd84f2de8a8b53e160857776db711",
      "source_sha256": "168a8846cb30ab7036baf645f5897866184391382e4111ebb1fd351fcdfbc9cf",
      "translation": "我已经找好适合对付巨蛾的地方，只要在那里，将KAN精气射向空中就行了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:936fe4300ccda2d3931b0f43317841af44d37d3b0e0698dd65df6f413e6ce5de",
      "source_sha256": "5bada6a162d5e3268a00c54f446651f3bcf154c6e76b487860c62b37c167327d",
      "translation": "请将KAN精气射向空中，把巨蛾引出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e367b7238d4b28463f0cb2a948a2acc88e83b4f60a89f271d8f498363201e75",
      "source_sha256": "093f18fedaa0175fd1634c6aea73201c8cd9b5c777548972abc292cd151278b7",
      "translation": "得在巨蛾转移到别处之前，抓住它。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:905ca5ae97c2c0cd7dace09113ae88e17163b0388b7c7b72aefe7a99924604e4",
      "source_sha256": "4c64d3e3778f028702f19d59e2de87bf4e28c85b4083a1251ec6aab6a36a0eb3",
      "translation": "请一定要打倒巨蛾！"
    },
    {
      "id": "coalesced:b3dbaa47d2c5625a475273dd73b779abcef4516e825094d0875aa467268271ef",
      "source_sha256": "7d7da88adc82822d48750049a8006ff1f3dfa7cee4fa77ce7cc741d8e903815e",
      "translation": "成功了啊。请去找霍格顿吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12caf4af94814739382c5f5ad234405a9a24c0144b8f6dfbaea32c0d2d140f28",
      "source_sha256": "486a36427711c38ab53119bbfc2696ac5222ddc2285397dde44037bdd20f090f",
      "translation": "万岁！"
    },
    {
      "id": "coalesced:05a339a7eda5bddd04786bb4a43892b0c0417587f7408063bc0e3012bcf115fc",
      "source_sha256": "e8716ff989ec2ffb25a5176aef4393188213e948713cb68bd11a92b656901bc5",
      "translation": "哈哈！我现在成了有钱人啦。这都多亏了各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:815bde852bc21e7d19d4310a1b9000f3b664717dcd022f41a1f8247af4b2d20c",
      "source_sha256": "6ed504d20acde2be2c52d76ea7b3780ebd4cb8e7be14c14c3f7bdbf26ca30df7",
      "translation": "以后，再也不用做抓蓬蓬来卖，这类生意了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72fd6e27c83253c10b39ec44036fd6032c7b24a499434048fc5c84bcc1ef96aa",
      "source_sha256": "cbf90892ef38cbf172128d666484c099f4a8241b2d12da821053ebecdd9ce739",
      "translation": "来，这是我一直藏着的压箱底宝贝，请收下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:febca3fae6a57a92db4ce76fbb465187e47055732a5e07748d86167c9e82e238",
      "source_sha256": "a3ed894187e6c81220788b22f78097c952da46c0f63fae00a1186c68bd85b141",
      "translation": "嘻嘻嘻～发大财啦～以后，等着我的就是美好人生了！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02f3cd5169b666432f7cc9dde2edb8fd2ccf5e9572f41876d6298cd79573f37c",
      "source_sha256": "d927bef546c102782710196bfcb5584c881d72ada0ab97fc62e7486acf68f26d",
      "translation": "都多亏各位啦～辛苦了～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48dfe8b60b746566984195ee0df5fb028049a9b3bb4ee5f5e78421d05f708caf",
      "source_sha256": "bd3b4803f5e8f451aca67b82d14c113bbadb453ef683cdbd72e1d860d8517642",
      "translation": "你们的实力，真是了不得。怎么样，要不要来我们猎人公会工作？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea36ad694cdbc639ff8034ec578abd4597ed0e8ad1a10d04fef698f4c5fe348a",
      "source_sha256": "e70844a44e3af95763a550b85a2b3cf8aed3bf3d7374da80d5739294fe9517c6",
      "translation": "有这样的实力，赚得盆满钵满，还不是轻而易举？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0eb660ca7239c658ab8a1be1ca73819ffde16b8f485d3ad353e5997f11e4b16d",
      "source_sha256": "28a7437672a8c646c8302bab0375168808cea99d96761982fb59db491a781754",
      "translation": "请在寂静荒野南部，迈耶指定的地点，\\n将KAN精气射向空中，引出[巨蛾]，\\n然后将其讨伐。"
    },
    {
      "id": "coalesced:16ab09abfe3b08311c1d0f9e0f039019521a4d9e6eac9eab698afef7e30e9115",
      "source_sha256": "1c99da8e89f254f2c52a441a8ccecb1b342d2356c808260c9f43b7e9a1247194",
      "translation": "讨伐巨蛾"
    },
    {
      "id": "coalesced:5b2a0992e086e10aaf4060fb611288ae1f5a0e0fba58c3ea90e21daf63e521f8",
      "source_sha256": "3b4d5f4adc1ed83f6398ea906c5e39080041f063fdd92d8287bfa3f28db7da70",
