{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:ce728cd237dc842d7e8021ab88027704dbbcecf0f8583fcb06ae5872f78bfc4a",
      "source_sha256": "a0b98a4c5be60f53056702b3a8ebec2e4ce572e43d7018a6ca3356ca70fee5a0",
      "translation": "以上就是全部情况。至于信件的来源，我们还没能查明。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c512c8ced87fd609e932642ead62b24ea8905fc6e6f01155a46438bbc8af0b01",
      "source_sha256": "3bc036542c7e43ee08bf56f3aa764fc7d8fc4ab85bfe853b01abf464455b9721",
      "translation": "最近，亚历克斯大人总给人一种旁观者的感觉。"
    },
    {
      "id": "coalesced:a01bbcb1318f8a426d14b7e447edc009f87957dac3429cee605b4489659606b9",
      "source_sha256": "af5fcf52217075015ab9bd53413b90aa6fd6cbb675ee86b142b8f04f79ee7c8a",
      "translation": "他只是静静地看着，目光仿佛早已知道一切。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08b4ace3d0b0371c644f22ae8d74e1f7a5e869b85b93e18815b897f1e5f2fa12",
      "source_sha256": "497de8fa355680bd98d8ea6302abc3cb3e0f6b90ad515d63eec5dcdafeda57aa",
      "translation": "他本来不该是这样的人……"
    },
    {
      "id": "coalesced:dbe713c2e6a1c748a6272c9a37a91f703739b36e0a386cbe0a8a6c41137b35b5",
      "source_sha256": "0e2760f33b0f5eea50fed85906b346d47ee5aa0fb05ef407062551c4b571e011",
      "translation": "要不要调查一下，寄给亚历克斯大人的那些信，究竟来自哪里？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:15887147db842f6bb3b41ce384d8bb49b68f80c489f217d6a772bef736e8cba9",
      "source_sha256": "dbffd3fc2ac546e125819f9ec9e366c52d0052bb39bf4e83ec4b6a8802f59504",
      "translation": "不必了。那样做，可能会给你招来祸端。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6000c3810cd5e34e82964d6c444c5a96a6c77d8600412968fee0ea3da8a1acec",
      "source_sha256": "1d837a9ccc0e2dac489c895cf4b804a8a815e1cb82e8e0474094f636066ec0c1",
      "translation": "今后，就由我亲自出面调查吧。"
    },
    {
      "id": "coalesced:9ff487d09ec9bdba94b58e9a63710b408344a48ddea1d5c06e845cfba0316f23",
      "source_sha256": "7f625d207b1f9a2ee7afa0976338af3182c35d395f4e937e8d5090f8f64e6723",
      "translation": "唉……"
    },
    {
      "id": "coalesced:9ca50d93a8e86141cc10ea8da85e14fd99cc8b31c9f054d26929c5e3c527e869",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:409d30c7f53056d7d48a7f45dc5718f1eeb811a0bf6988aab608524a09020ace",
      "source_sha256": "29c082afda2e072c2307ae9da79468101d9ad1e1d483b913a95af00da188e53d",
      "translation": "怎么还不睡？"
    },
    {
      "id": "coalesced:b3790d21b724e3f5b7bae8b2ab22c37e1982cef2a9807cc6dab9d07bc63d004d",
      "source_sha256": "10118e098a72fa12f325b980c456834ee3ab4f870d6b6b793162cfd110b8a7b3",
      "translation": "你不也一样。"
    },
    {
      "id": "coalesced:164e8daa093bf81577465a196202dc18251a0ba2f861df4b10f645ce1f3ecdf9",
      "source_sha256": "e9f3662a8649734da1d931fec209f5c93d622c2b3c09e14b8e4f4ee9cefb3dcd",
      "translation": "只是……有点睡不着。"
    },
    {
      "id": "coalesced:0fe462256c1842d3f880d8380342eec6953531cf36e0e0732b102d8a2096014a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:442a66b82c81b4cfd404378fd0b63a0b078cd0020c2093216e3f9db7c4701daa",
      "source_sha256": "e5d8943cf42610b0b952ef7e09c778e2b59b5f3af55b41ae2ed57969800878a8",
      "translation": "接下来，你打算怎么办？还会继续留在这里吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:109d2b2a59dc8ef4871abd76a17f9449f413629f7b90009123a083c52cff7966",
      "source_sha256": "b250c69c8ba21a3b59f74de438ae2410b58c24da57b6ed7a4aae5b6864c1927e",
      "translation": "我也不知道……"
    },
    {
      "id": "coalesced:966eddac301ca40c97f82010e6e2f58d0ea769b23c08cfaaf80f9ab1b733aa60",
      "source_sha256": "1744681e60c103cb4fb4f62d68ceea9e38d5ec7eb0cea5fc63a3d5e3075e6b24",
      "translation": "我做梦也没想到，梅莉莎竟然会加入北部军……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e75efb15155962fa47cdd5d428654349ef7447e033a24b2be414195d8c39fe3a",
      "source_sha256": "0e76b020a6c3ddfa8940e184b8b1495b20f7dfd0f70ff81ea2bbaf272fe7b4d8",
      "translation": "不过，说实话……我有点羡慕你。"
    },
    {
      "id": "coalesced:25cef225f2e56973d27ccf691d55dab7eeadc7f3bf102fd605ea5a88d420e3d8",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:bc4a58f1758aface19db462d69c8d477454750609a6d0c6bafa1c0ce062bf399",
      "source_sha256": "469b487582f1bf4ccd8a12832642a641a7e5cf0deeb72d5a4497fa60b2607cd9",
      "translation": "总比只剩下遗物好吧？"
    },
    {
      "id": "coalesced:2f722a5764c7a07647022049031a6aac992f0a69d6e02be21092587bc916371e",
      "source_sha256": "2fb85283a9933c473559f7e3ef8eab60f2c778a626098cf68feaab677f20a8b9",
      "translation": "可是……她已经成了北部军的一员。甚至还叫我加入北部军……艾尔加也在那里啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ddb8505848f14ed004b12f0140288d61f4b7c586f55505f4ef373a6dca86680",
      "source_sha256": "4b81897b55296e7f3f7ccd935efc8cedc31ff5504fb95fb0e389d84139f55613",
      "translation": "我真不知道，她到底在想什么。说北部军才是正义，简直不可理喻。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edd856e64c0c406611d846e6de630e6907f0070727b64e30ee0bc9ff0ab962b1",
      "source_sha256": "6a63c5ef058ceee4af9131028fec34560e6e221e0026071df53b25b914713a52",
      "translation": "竟然和差点杀了自己的人联手……我真的不明白。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad6cbea06f74e2ec4020d71e3ec0875bf5a6b45e36e194ce0b32872419231dc9",
      "source_sha256": "b8c0f88abaa0513e93f2e03ca89bf73f4235b54dba9f2ead04aafc6f7c874561",
      "translation": "那就只能亲口问她了。"
    },
    {
      "id": "coalesced:bcf65dff9716516bad627fe2df31ae0e1120b68baeca5efdab73f4b82ab0a6ad",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d5c28143d6f2396e4dca8b66496d9f045f898d0f65937de2cb998d5b2ca28988",
      "source_sha256": "f021ad91c00b54f09f865ad25ffb6f92718f8551d46ee33162262ffcd137e2d6",
      "translation": "在我看来，那个叫梅莉莎的人，似乎并不想和你交战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa06565891f38cbfcdedb7319d0ea7f96d320c24c820ab45b3d6687a28f71c09",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:372be0ad5d43c1cb5a62744c1d784f5547e232b515fa8c3ab3ce2c03afbdc3ae",
      "source_sha256": "6754b90db76d4029e459f208bcd1d6c2ffbaf3098693bab4ff400cc602b8e5eb",
      "translation": "也许，还有希望。"
    },
    {
      "id": "coalesced:4ae805be5de613ed3ee032f0a10765cdb88a30b915eec355a019c7b3e3cfd433",
      "source_sha256": "e10fdcb85cf5c0071d61bdbb7327a1e6749f63b6273f4097bc4e4d6b4ba5ff7c",
      "translation": "我能说服梅莉莎吗？"
    },
    {
      "id": "coalesced:4ae850a88fa40407274825890f77ab7a9d2d9f5876f8fc17b7cef917c1a9ffac",
      "source_sha256": "e7990f7791c72026076b62d485e623e68eae75f8924729765ab9a2e74dcab2fb",
      "translation": "其实，我心里早已下定决心，不会加入北部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edea67e73e427cd60c6de45e082cee8146d6962f5cbe1eaafa20da0e711c5e38",
      "source_sha256": "4464cc1da1bc18c48305b5b34a81c62304b1298fb45f02073cda0b48b3f5f103",
      "translation": "因为我觉得，反哨兵部队才是我应该待的地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5eca21c0a3b9256ec97ab3e14a1bccce47c693fa35d6ea9af72983c74822d274",
      "source_sha256": "a050b4e5973bb060834733a4015e4abb674bd6e7e94f58e85be27cadbfc13c08",
      "translation": "怎么样？见到他之后，有什么感想？"
    },
    {
      "id": "coalesced:6c967d879cfaf81e2860cbf91b4afc79800d8ef0947d0f14d203860756aff323",
      "source_sha256": "28d21456c7f9ffa86a192d7fa98cd65fcbca2c650da7f4eb85b43a6d9d3870e2",
      "translation": "朱特……还是和以前一样。只是，变得更有男子气概了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28949d042cc834175035e0d711b14da33c0dc52dc7b3e5d6bcbd5d0c3662fa0b",
      "source_sha256": "179cd2785f58ccbacacc05a7ba798ddca030f4f0c1276dc487df1c1cd5639e2d",
      "translation": "别太担心。等他找回记忆，就会回来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:33f74f76bb1e432bd4c79f688d9c0fbb11093c9ec50cf7235cf73b1bef4086f5",
      "source_sha256": "a52d4fe1537362e7f29cbe7f1ac090db0c345de04150820ac5ec1ba3714db145",
      "translation": "比起这个……北部军应该已经撤出风息岛了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:534bd5e5a0a65d7cb4789f4c55d69d27ff27188e32c327fe7eff53802ddea826",
      "source_sha256": "72b20c5ef36bfc280935a02d0c8b546b5e63ece4642871387b6d708cc10c53b1",
      "translation": "啊……是啊。你最关心的，果然还是那座岛。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9be916e0d1d1321d53a445b9892255792e88f438d4061eef165ea87c0c20a18e",
      "source_sha256": "0388cb9df4449eeb8b91898b62630516c15fb2928882ba3b11c84481c2c43f0b",
      "translation": "我可是个遵守约定的人。"
    },
    {
      "id": "coalesced:ea94501afe89705c71c7223ba97eeb9fb996f9e3629a27544e7f213ed5ceb03a",
      "source_sha256": "bc4c0fc5946405c75712e2c5d8e361a1f52d19202c90f962e9248492dbef6422",
      "translation": "所以，今后也请继续为我军奋战。大家都很期待你的表现。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38205101a94eeaeaefde692b5ac39c3fda636f72eaf9d2e7d67d6a69939a9e70",
      "source_sha256": "d272cbe13ba08370c2058dee3afcd76f1111a93c352db7cd88d10db148760062",
      "translation": "我……不是在为北部军而战。"
    },
    {
      "id": "coalesced:74abb8aba5edcbd00714da91de4699f1e1543807bc68ebc03e92e11935bd4e87",
      "source_sha256": "5484998479e29a1bdc510b2bdbafd4b7d2981322a44a814b4b23e1b39c085aed",
      "translation": "我只是……想尽早结束这场战争。别误会了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9f0f55a375b983b65301c8b94e00f14378d67dd335828181b56b15109fc4c0f",
      "source_sha256": "9cb5ccae099ee4fea1789aa9dbc3b2c07aeb8fa57db6d37244bbe90530234205",
      "translation": "呵呵……嗯，我知道。"
    },
    {
      "id": "coalesced:11df969a617dd679da1ee39a328f4203a72128da01a9ae57d125714d2464e6f5",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:68bbab163f9cb6f5be3bcd134fc76e5b130b15ce3b59794445aaf4981f20392d",
      "source_sha256": "bf09ba862473516471282551a9ce63cca769ff74ab14125d8c70589d5f7f1eba",
      "translation": "克蕾尔大人，已经抓住她了。她越狱后，竟然打倒了10名卫兵。真不知道，哪来那么大的力气……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6cf8e26bd59d050e20c272b758bfcd41b64c87e516dc17cf8ae5a95bc4fd399c",
      "source_sha256": "e0682e40a26618e8aa32e5c910cdf8126db2a8fc6d1af369f385d788d26b1172",
      "translation": "你叫什么名字？"
    },
    {
      "id": "coalesced:9a1eeea99b7dc1e57770d15075a186030d68aac8d3ba79a72fcc332567c6c984",
      "source_sha256": "ee75853afd1dbde41d739c39d3344dafb291428b856af4c06baba5d66c9ff193",
      "translation": "反正你也没打算让我活着，为什么还要问？赶紧杀了我！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ffc8d2241ed411f78ef0f3209c02133821842e95676fb1575e0f8dfd104dc05",
      "source_sha256": "b0f7940365ed48b2950f36a79a51c09a6ba4caebfb4eae7ec34ccc4221a427dc",
      "translation": "呵呵，是我救了差点死在艾尔加手里的你。你却又要我杀了你？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e33316408618ce572092c749942e9d929c8c2b767053282cbd709edbb62284ca",
      "source_sha256": "3c4e72f402327e183dc6e16bca7fdbbf591442b6e050e610e42b34e41cba3df6",
      "translation": "什么！？"
    },
    {
      "id": "coalesced:04e60ff857e2935942422e3d773ad7f7136dbfc8a53e190d4d463be28da6ece2",
      "source_sha256": "2add9b1359ba9d1737563f14195a5b0c8efdb08d11e594dde838b60c725fb4c4",
      "translation": "为什么……要救我……？"
    },
    {
      "id": "coalesced:180fb23da325ec15d3cf3eba1ea99a00af1da8d308661326803b36afd215b916",
      "source_sha256": "d0582bdc46f67341ab76dab536a3f891f21325e2f5f6908ae56a3909bfa8a875",
      "translation": "我听说，风息岛上有一位实力出众的女战士。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d950b723c8e75c25e79cc67d82f6ad5a167edb0a4591c260bdad28a6a5043ef2",
      "source_sha256": "332a6ac67a7f26ae428db59bb1207e466d4ff06aa6662df7d4263b2ed14988e4",
      "translation": "说的就是你吧？"
    },
    {
      "id": "coalesced:910e6c80032fffe6a93d2831e91e5edd4089debd0859e672ae1a1e9b17c53e9e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:e1232279b3143fc34e9c6931b404d64ab38a608ed2e1253f0fb7629601c3f1da",
      "source_sha256": "8eebcc47febd6f8e24afd815343773c04d810e8b6d2f0b038340ca333cefc348",
      "translation": "当然……岛上发生了那种事，我也很遗憾。可是，如果我们才是对的呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69461b54b8f674cfa8b5025447117fa0ef49751553ee5063506fd5199147cc4c",
      "source_sha256": "e4ec998b007557a54e42bef60636b96f66f1ab19fd8d09deb98863e102b45cd6",
      "translation": "你说什么……！？"
    },
    {
      "id": "coalesced:1770daca76a9bb8157683e084ad88d7209c2928677af798ae52c3ae2b5bc0894",
      "source_sha256": "846030d1bf7323544ae0d99137f139e7afb496b71c34ce53789dd9ecd231c1ce",
      "translation": "知道真相之后……你也会理解的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f69c4f3df06426cce1c4722d8b007bc7f09d69e8537e4ca3cebda78361f9add1",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:6de68fbe8e7787b959d16b539e92ed8e81c3d89213d45bd4b494e38d15108d29",
      "source_sha256": "b45ec58184ac5f0f2157d0bf472990871b51e65a382815b7c15fa1e2510e2304",
      "translation": "你看到了吗？商品比以前丰富了不少呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:473160a4075bdc6da449baa65d495534211e2bde15bde4436e2e5d8f3cc3dc0a",
      "source_sha256": "e3b5da669e029e1166f0b055ff021f25484c7aa20eeebbf6a4171f4a3f5218e0",
      "translation": "也许是因为南部军正在打胜仗吧……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7459fc534a1314a4cd7e6038306f8b13ee3ccfc3c03bcbb1ca27ca7272108a8c",
      "source_sha256": "bed3acc3f6b0ef64da96a596fd9c702ec385f7093e10a90e87f091f03f113c5b",
      "translation": "我去了前不久才结束战斗的老狐峡谷，捡回了不少战利品。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e683693eb325d6f90063c848aedaca7867a3bfcd00489908200828e1819a5bcb",
      "source_sha256": "f23e0ffafa06ce98a0e82c781b2dfe35aaeaee641c35ca1f0d615b4c3e8a3371",
      "translation": "像武器、辅助装备，还有各种道具之类的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:21bf4e899b3c08f83eb4a9718df7338e106fc41bb97604ed0f2aaf5f9e8b5fc8",
      "source_sha256": "1a2402b3af5e88d260403477a5dddcfcf7a391d46e11ae7518cd24f635d7ff64",
      "translation": "拿去卖给商店，还真赚了不少钱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a22ef66d3208ac1eed01efdc07563b6d6cfe9968659d8b400477b4cd388bca19",
      "source_sha256": "fd798fcdf6824b7152d7ef3e254a1cd1fcfc32567db68a56062b43ab03052224",
      "translation": "你这丫头，到底有没有点正事？难道要让我这把老骨头，一个人整理所有货物？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e601d1e5416ae0157ebf4923e8b8b1a1f8bfa885f33e09c160529023e16ac45",
      "source_sha256": "8b0e73bd25d950812b3ed31f5e4d9d00bf71c35987f2262dd55cbc9df53444af",
      "translation": "对不起嘛，爸爸～人家好久没来阿巴泽特了～这次就饶了我吧，好不好？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28344269f259db4049501618360947d4abf15f87e5469465c1c7ed10ab6b93ca",
      "source_sha256": "39a308f7b30ab5b013aa5a8ef5298e47017d8e2d3906a2df40a772f70558562b",
      "translation": "唉，真是白养了你这个女儿……还不如早点嫁出去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74f2988e36b22f1343831d12aecf6c5f3acc33846c6089b11202d98d2e15d6bd",
      "source_sha256": "bec00877914364032b4e98bb6b652d4abd964c097e38de1adce1162788f4aa4d",
      "translation": "啊～爸爸！你忘了，不准提这个话题吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:056c61d677a46b8c9a9b9a74197faea34190cc03272cd23945b430d8a5356452",
      "source_sha256": "438d6f090346282e0a2334ca7f021cf25cad5893a7cc96b847b41aa4d420fd0f",
      "translation": "上次我买了一把剑，可总觉得，那把剑不太适合我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b70f68968950df9e1888139f81aa61f3f032c227ec06d8eea3220ab30f048ca0",
      "source_sha256": "24411e36f90516f9cc86dd0c31f0bdd83836d0916a79351ab1887ca67ad9c59f",
      "translation": "要不，试试斧头之类的？"
    },
    {
      "id": "coalesced:ff0a7442b195ec86eab12ad9eb3edeaefa1feb016e389f5374e355106d1ef83a",
      "source_sha256": "70229ddaf3dc8c12fb5de378fd78335d04cdc95573ad1d460efd6743ba9bc529",
      "translation": "卡蒙德真的很漂亮吧？"
    },
    {
      "id": "coalesced:77c5d93bdad5ae1dd3f2b92911455f24b9687a3450ddfe266b7a884e9f52dfff",
      "source_sha256": "18061ee69194ff5518fda97fe3f14c854e36e3e2d2d1e985e8489120d0d445ba",
      "translation": "把这么漂亮的东西镶在武器上，你不觉得很野蛮吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:95886be75006534d0f90362ba476a83879d27afa1a8f1cddeeb7393f126bf7ff",
      "source_sha256": "48b607fc57aa621393b168c7dc6ab81da467f084e8b4883d86c971a0ca270613",
      "translation": "加工成饰品，戴起来多漂亮呀～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:53bfd42f9d9289e1873dfb39c24b911a006c5a583324913154fef7f7de78b71f",
      "source_sha256": "dfb8a52cf2a5bd39400884ac5fada6c1220263c780aac99732d34d0ddbe3e703",
      "translation": "我可不容许有人在这里闹事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb80ad9f915eca41fe91c8bb2f2889eff9308739f34986728d0b1048476f42af",
      "source_sha256": "fbf48d71f5fd8f8c2dd6d10dd833d5b28b3b0b7e79789c7c6128acfab75803fd",
      "translation": "前些天，我把卡蒙德加工成了饰品，可不怎么合心意。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:716725829b20bca450a22e55741efc2a30894e7400ca723868caa69400356ec2",
      "source_sha256": "0e08e9b8a2fdd6036ec78c1e044b27ab1b814b54b14315178265e978a0603524",
      "translation": "明明是好不容易才弄到的卡蒙德……"
    },
    {
      "id": "coalesced:cfd9cfc90fb2695759a6d1496de74209d61f3dfdb48177ed23b37c84ccab90f1",
      "source_sha256": "d250cc63003082c9f103d03fe16646f736d8392692831f544c40dee7083948cf",
      "translation": "要不要便宜买下来？只要500SID。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d77486654248357f31a305d1c2391efc87b7a485293ce65b1fac5e80d50ac1c",
      "source_sha256": "39a4c2f3cf83dd0a1bbb23c53a6f7e59ef58af97f3e54172297f4dd715a5fa08",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 买下\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 不需要"
    },
    {
      "id": "coalesced:b055a2963da6fc2f57ba7074158fee6bbf6bd8a557a5f3263ad00deb536bd3af",
      "source_sha256": "f688a154cf6c6bb7c08aa7bf1abb59fc710be5341dec9d362a75264d4ff601bf",
      "translation": "呵呵，谢谢。"
    },
    {
      "id": "coalesced:3b40bcf73dedc66aab7c870efbe28b5f3b5cfaa0fd026209af4c00d6d69d7918",
      "source_sha256": "d8ff061b11fdab844e570da9cef0333cd8c28a1c181c6f2167b8343c58b5d381",
      "translation": "啊～看来，还得凑合着用一阵子了。"
    },
    {
      "id": "coalesced:38720d0406868c11db9be62f1e678509bf35aff277a4fd2b9b00f9dc3de48c26",
      "source_sha256": "a0799d4ffafa95f35b6b2426a066eaeeb42c191bb75d7ee6e984aa2740919369",
      "translation": "用什么样的卡蒙德加工饰品，才会漂亮呢？呵呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8f7b0fb58b1e9904148124056587ce86db3373e45f70d04d96a3c6f5ad9fe12d",
      "source_sha256": "abc7b29f40b3773e1b53814f73105c4df5bf2fac43afc6991d3f34caebd4e653",
      "translation": "最近商品丰富了一些，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:caa318e13c8b299dc6a3cf91523f47cb35ac70ebef938c117a0b653cf2729b4d",
      "source_sha256": "2609fdf09fd45230dd30eac5934bf0752dfe49442c85c4c29d416f2ffd525410",
      "translation": "不过，机械零件还是不好弄到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf98ad085d48ab3704227d4f3fc1295daa707fb3f5c0262af57b800baa8486dd",
      "source_sha256": "8223f520b5ed369586ace9526d246e295b141f8d4a5c421618d2290de23a24d5",
      "translation": "我们打了胜仗，民心似乎也安定下来了。真是件好事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6e64fc3cf0cd54cbe1528055c6abaac76988ea1cb6fe2e5725dbccabf31974b",
      "source_sha256": "d72ac1c60fe7dfa93b9d1c90c7c7851e4a02a7bbff8d0d975166ba725de2b8db",
      "translation": "战争拖得越久，流浪汉就越多。真是烦死人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:adbf12dbcfa542c1a05f48f9d01b8298bdd295bb5c3f86f51bafd036aa9e6ac5",
      "source_sha256": "738c4f66eeae54311e77c83d2629be136830c44f81aeda9c40b6bf8eb2ded5c9",
      "translation": "[露]已经很久没有回来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6329698c0e6b8119ac52647c136c29690c22dafa6fd5345e103ac9315f4a9e4d",
      "source_sha256": "7b3ca30f4f14a581855b909d880ad6ba15b4cbfc8338a09170ee4569dd8287d6",
      "translation": "看来这次任务挺漫长的？"
    },
    {
      "id": "coalesced:c44ea22cee4e258ad8db0b7b4f8c26d76a09857d48b2c89bc8ebd8a651db4bfb",
      "source_sha256": "87eb9d774a8e273b54464efa9e3e7abc2a786f2dd5ee939ef64604307b6f10aa",
      "translation": "这里是南部军总司令部。"
    },
    {
      "id": "coalesced:e0685736367edb1dd292180c28f536147206eab649acf436bc1d5bc617d9455b",
      "source_sha256": "29a4e8a8f84853252c3c2a316dcc0fd78afba3c602a59ac7ccd95291b3a00677",
      "translation": "南部军的高层们，都在这里议事。"
    },
    {
      "id": "coalesced:a3dd93e615c89d9c7f4afb221df222a3c7d74e5a4b2efb7b572ec89dac36fee2",
      "source_sha256": "2c83d379fbc9311de31a06107912fe694c4956fcb9c10dad871e9678894dd33e",
      "translation": "处决叛徒"
    },
    {
      "id": "coalesced:4aebb84ad0727a209cb61fc9b1d5d67c7846c96bf7bf1e6c79d720766cd1d42b",
      "source_sha256": "5201be73d78fcd28ebe18867531046faca5e3869a99573400e1cbce3d34ea456",
      "translation": "泄露情报的叛徒逃往了老狐峡谷\\n请找到并消灭叛徒\\n据说，叛徒正与峡谷里的北部军残党一起行动\\n\\n完成后，请向阿巴泽特入口的士兵报告"
    },
    {
      "id": "coalesced:db5cb4aee6521c5197e7225c8cdae3c840f7a972b6e7331c9a8084250d31c18b",
      "source_sha256": "ca41c6b64876b5b9525973ecbd3b42311d311a4b8e1aef8fe49c3a437f5f485b",
      "translation": "前往老狐峡谷之前，有件事要告诉各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9d31ee0386e30277c7ad6a510f3548569e7a5083b7f15fcdc4fb05e27226a61",
      "source_sha256": "16b39466fd5ca3d6af35d3c42ca6453d934820ddd7fa63962877c52b71a61ad2",
      "translation": "其实，目前还没能彻底压制峡谷中的北部军，是有原因的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1342eed76bcd96686f72865527a2813959a6f3c9f4c2a6affed75ddb6588c70e",
      "source_sha256": "270f56b648b00913cd1052047f49c90f450f4a02be8922356ba1021a68e9ac06",
      "translation": "我们军中出了一个叛徒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:119f30d8ad20429faf7c338a84d8b343a0eecb769007a0a918c2ea1eea192c40",
      "source_sha256": "5b98b9974ad1a55139a0b86566451a154a6cd789e3d80efaf4b8f0afacee4d27",
      "translation": "那个叛徒泄露了军中情报，所以，即使反哨兵部队击败了哨兵，我们依然陷入苦战。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:75c563346aabd051425fa6db4829895103a6cc9acb018756b5ef136afa437ec6",
      "source_sha256": "37466cf075fe7412e6674aef828a7a65f674bc1e457da277135608fc4a11e3c1",
      "translation": "我们发现得太晚，正想抓住那个叛徒，却让他抢先一步逃走了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:764efbbac6270e871d3f54a807ac84fa907add2672c461ae2f7eafb146d47d2b",
      "source_sha256": "72127dc887a95fa59b1ac65272ca68f952ddaedc6036f971ebae3932f3d4caaa",
      "translation": "各位去老狐峡谷时，请务必处决那个叛徒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d453c64a150e791eb9d152895b86c0e3457146afd43684808f87cfc499830368",
      "source_sha256": "1d0de05ee9c2bb2094b9bfc24668363d84510237ec8f9a97865d2d057988a206",
      "translation": "叛徒应该还在峡谷里。"
    },
    {
      "id": "coalesced:cc36bc63d98b0368d1c6bc6678fb3c96a8cd67082b32b0a2b7269bdc6922e71b",
      "source_sha256": "da7033e744a4c71e784209a4a185cb550d8b38e08aecc4b6ab8a428b1c99a5eb",
      "translation": "办完之后，请向我报告。我会转告上级。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83b4ec63931d0a0cd520e08a8267a72794a3792a1aaa773d986e2835cf81c39b",
      "source_sha256": "ed5b592105c92c6a92f90c96269625d55667561635332af076400178db349c59",
      "translation": "难道，还有比这件事更重要的事情吗？"
    },
    {
      "id": "coalesced:c911094c4d7002414409b9c4e887e771ef02378aaf1a055e2e4fbc7c253d478e",
      "source_sha256": "db56b3142fd8011863103ebf05e713c86a7759199adc323bd5a21c9a4029ff28",
      "translation": "请一定要处决那个叛徒。"
    },
    {
      "id": "coalesced:f3b0e3eaa12f8aea9af4a6f4d2fe0d436c5b2d3c6ea7c7921cf2118d929a16e3",
      "source_sha256": "48901149a90d5bacfd67d999addee975cd7163db3149ac09dbdd5bcb954d0697",
      "translation": "辛苦各位了。多亏你们，我们终于能把北部军赶出峡谷了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f1e118d3005e1dcdb26e764829bb2b7a86faba5ee9e010b001b5848a308d1af6",
      "source_sha256": "71b326496baff24de87cfc5a3faa032642b904b46c1a09fda6f12bec3601d412",
      "translation": "QUEST%s: 消灭叛徒"
    },
    {
      "id": "coalesced:a283102111d4a694e5612bc0b69d7b1bf811f54f465197440a75dacef6616127",
      "source_sha256": "f0e26c6382fb27da1f25f99fed8b2b88d6daf576f4e01a06e65382cd1d1557e6",
      "translation": "消灭叛徒"
    },
    {
      "id": "coalesced:ccefd35685428e74a7c04b9d4334613017bde162d252927ac84ea4adb0b88e89",
      "source_sha256": "9f1da85d5b7a59d89ff372b8ce75c1367f3a83a8c45d0dd207b5cbd6c95bfee2",
      "translation": "最近，拉提族甚至出现在阿巴泽特附近，袭击居民。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:29f6dfb67039f0a89b76cc83379ef0732d391c3d0db1118cef7ce9d5452d528b",
      "source_sha256": "d9f4394179a18827ae368b597d7181dc741475c465f29349f10376e5347ede9a",
      "translation": "尤其是南部军出征、守备松懈的时候，他们总会趁机袭来。"
    },
    {
      "id": "coalesced:3cb76321511a4a7a5e7fc658d99875cf07704c8585f4555e1f4998b6af53684b",
      "source_sha256": "d8908898fe3e64724a3494cde529dc7463e689c5fe014d0fbf64f761455a2937",
      "translation": "拉提族造成的损失越来越大，可听说，南部军忙于和北部军作战，根本无暇应对。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:71493067463e9ba47416d281c80c2be21065f56820f09a3589f7d6c3c8117ccf",
      "source_sha256": "522ae87d8b9d6d9a7e823a241d097994508ed4f08a0036da8e38e4791781e2a0",
      "translation": "我的一个朋友，丈夫被拉提族杀害了，连尸体都没找到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:630904bd3811b66a2fb787fe063b1fdfc4c855edfb0705c43db6ef8b4b6bf2e6",
      "source_sha256": "e20ad7b9e2cc5b85fb49e012cf253f0a0611cc45128f192303b05137a01b5e44",
      "translation": "可几天前，她说自己找到了向拉提族报仇的方法，要亲自去复仇，我实在很担心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8fbbfb637d9771cbf6f7a2ba48aa97a250528ea508eab671d1c12972b3b0aa1",
      "source_sha256": "4f0f21e9430bca48396a847a6082c0cc3172690029a9152ecb8ec55ce507051b",
      "translation": "请各位去帮帮我的朋友吧。"
    },
    {
      "id": "coalesced:7f944a72b2c59ddffa2305a177f81ed5419b9218cbd81f7c8b845343a372aac1",
      "source_sha256": "1271b888c6ab2c29fd57b8873b6ccc7ec61ad4ad1dc55af70ec26c44b7c439b7",
      "translation": "各位愿意帮忙，真是太感谢了。有你们出手，一定能击退拉提族。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7809fa8410589cd103d29b6f999a4830e340f348e8f5c9a8535843ee587e7662",
      "source_sha256": "9ee923673edd97616d330bf28359db791e025a35591c5e3ecc96b0d962cac935",
      "translation": "请再考虑一下。要是放着不管，我的朋友可能会死在拉提族手里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8e412c9415b6a08954458dfc0a3e233d2606d0ed838348ad67d6299895c141a",
      "source_sha256": "34e7f579f996f7a08cb1bf85ad215cfc975f8f45a81ab798e84c7348ac101739",
      "translation": "请快去找我的朋友吧。"
    },
    {
      "id": "coalesced:ada399bb1f2e3a3ef31d3f3c3fc66b71e2facb9e1d25a13a83760c4364b0dba5",
      "source_sha256": "84ccd0d3cd1c261c1d32bf8165afff86bd0d9a47ba90be8119a4009da20ebe67",
      "translation": "请与丈夫被拉提族杀害的[黛芭]交谈"
    },
    {
      "id": "coalesced:b68b9c1c7f624b5aee80bb3b2cdb0fca5e6bc4de730c711b97ca65602617bae2",
      "source_sha256": "ae124069d5c54904a10e718887e3e0c9894955a23a5bb4c09160769ef20e9537",
      "translation": "拉提族的袭击"
    },
    {
      "id": "coalesced:d09927cbd7bd384fbf0df1300c07ac9a8f8ec75e01e9b62c8e146b229a611db9",
      "source_sha256": "c12f1c795d23361590a4ceabd372ba31e6c34f3af0bab1590b2a96ee04510cb6",
      "translation": "拉提族入侵"
    },
    {
      "id": "coalesced:47ca7bb501d0cbd288424af8cd4fc46fc676d1e768c8f21026867d44977decfe",
      "source_sha256": "aaca8d156b54bb98816c115011f06a449dd59af222e5c42cc80e3676c5bc8771",
      "translation": "生活在寂静荒野的拉提族正在发动进攻\\n请前往[南部关卡]，阻挡拉提族"
    },
    {
      "id": "coalesced:9eadc2b2f76fffb8a9af60189dde333c64c379571f391ab9904c7ba487b3c819",
      "source_sha256": "581b56a7b5a5306eb63379fa0f6accc3852d1c84b8d9e695a541208b63a5c047",
      "translation": "紧急情况！通往寂静荒野的[南部关卡]，正在遭受拉提族的攻击。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:715753498ac43279e2d5138e14c6c922e3fdb0ec2d4815198c99c3f4fb5ba422",
      "source_sha256": "46574922604307e8fd89d4de859e46236ae5bbdf241e318e53f026cff01145e6",
      "translation": "目前，大部分士兵都已出征，能派往南部关卡的兵力不足，只能拜托反哨兵部队的各位了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e17773984ea1e6d4a12caf16b8b1f62e34dbcf5054b068971a2bce8234f0ccb3",
      "source_sha256": "1039d6219ae9a67f601ebe90a7ff1acda5478159e2d1ee84266f512e4644e12e",
      "translation": "请前往南部关卡。"
    },
    {
      "id": "coalesced:f7219e80e61cbe9d5201004b6cd482bd78bcb12a365fa80e6fc213af6f2c484f",
      "source_sha256": "c9dfeb62e6f877067cf11463d1de56b8841eb0a49429889bfa2cfad051ab8f9e",
      "translation": "稍有耽搁，关卡就可能被突破。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8fa205ea0a80fcf6f20abd9ff6633214cca758b15c5208003aca18d94eba6e4",
      "source_sha256": "7b3494e95e6932692a9ca64523e0b768d66a9173450edd52f8e547bbfc8e4441",
      "translation": "拉提族攻势猛烈，关卡就快守不住了。请尽快赶往南部关卡。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a6f0956638bf86f3afa6dd2db8ebed5541c57635fe158bc13919e8c1402bbf3",
      "source_sha256": "aaa20575ef291708a41423fcecc441defa99e052fa3a264e662ca75524e1698b",
      "translation": "拉提族单个实力并不强，但数量众多，正面交战恐怕并不轻松。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f85ddce54a11541176c518c7e7d7d9c96e0c1728e9b7c2cf72a1aebe814a6f8",
      "source_sha256": "dce29b34f579d784c62b7c8ff8ba8ff8a217996bb5f87d7861f0eda09b45acd6",
      "translation": "如果由擅长弓箭的人，从远处用弓攻击拉提族，应该就能轻松挡住他们。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e460092dc729fa2b51c5f5baad1288c3ce765a2e7d500ece51963b92942c474",
      "source_sha256": "121b9b2e30e6a4ec606e8e9332ffd2fcab6f8eb4abc6b359d41656b2833b03be",
      "translation": "辛苦各位了。多亏你们，拉提族总算暂时退去了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d724dc4365dbe9757fb7bb4c0cb29cb21a503bbe4800f834a2e77d5af8829024",
      "source_sha256": "f256c7874e53487b2a3044c2494b5c4e390dd4b5b3e607cf0da296674f3ca007",
      "translation": "失踪的侦察兵"
    },
    {
      "id": "coalesced:4e209003fd18928c2c62daf1c00ae4def9b3fdd18ca0f04a0df9653e5d7e5ce3",
      "source_sha256": "aeaee1bdab967b8752de48d82d175ce6b8639ca80a2111479413a7eb0dc182f3",
      "translation": "请寻找在寂静荒野失踪的侦察兵\\n侦察兵前往荒野南部侦察后，\\n一直没有回来"
    },
    {
      "id": "coalesced:5bdbc8a52e6d7a6b36afdd39e9013aeeeefa81319bcafef6d838d6034aaeed32",
      "source_sha256": "62409e5124bda72fb0bf447b8f13015c23ca2e34779e1d6c1517b1367415c6ae",
      "translation": "有件事想拜托各位。"
    },
    {
      "id": "coalesced:02b325ecd951d75fd91eb9b9a691426755c9240786c0cd16533faf9665d364af",
      "source_sha256": "0544932a51a5e209d6f162fc8d34d8cbea7cd9d205e65d833c71da19fb0a6e6f",
      "translation": "收到荒野出现可疑人物的报告后，我们派出了侦察兵，可直到现在都没有回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e0614e354fb39ab1db74fc4b6e0752b275547b07bcec0ff0af61990676305a44",
      "source_sha256": "4db23c706229a4f92844354ecd65bd5c4d44ae42244606000dc851f4390ee4ab",
      "translation": "那就拜托各位了。"
    },
    {
      "id": "coalesced:ca718cecfc8bff0884e7e8619231a2f6d170ce26cf82fc4614d0ed1c6be46c09",
      "source_sha256": "440dafd6baeeee44b72db5a7ee10784bcfb5e7d2986213d0443c32ce4c4c626d",
      "translation": "这件事可能严重威胁阿巴泽特的安全，请再考虑一下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c97103fc4c7ea1f497f0a1f669b86d4039d7c9f8e4155ae5717e35ccecdaf1db",
      "source_sha256": "2564ce25ae1618da37048eb85c3cdd7c69a69b972a37b68e2a3fb4f3b88629cb",
      "translation": "听说，失踪的侦察兵是去寂静荒野南部巡逻的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66d30e54386b6b347b6cf7f6427cf0754a47394ae64a2e0eb7a78ed4e79d540e",
      "source_sha256": "6150175fb63e13ec9bc04fec08df141e8dce03eacce4933cee915077508d000c",
      "translation": "谢谢各位救了我。没想到，北部军竟然已经潜入这种地方了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f5f5fa10ba5c87288814ea406e56fc14ea4516a96aa4a0ff5275108efb9978a",
      "source_sha256": "3b40c30171b39f3683e783bcf901dce4006d3a35ca7fa5a9b75f78289239350a",
      "translation": "要不是各位，恐怕就糟了。 ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a070e6b4d0a9991e5a3e5f534e8bdbcaebfe66864743c8472d0ed4e356abe854",
      "source_sha256": "b944a8c787235aca0efaeffa9f2c28f6abdce79240ddfaacd50d3c33d6d8d412",
      "translation": "我再调查一下这里的情况，就会回去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf6e17f2e5c8ec650383fdf2f297e1227150faff26a82121abbdc2a0aec9f384",
      "source_sha256": "f21d048ccfc14cccf30e4d90c50f47b54714f806c64012b84f1d79a03e2ed0d2",
      "translation": "采集九节草"
    },
    {
      "id": "coalesced:683712003d92a21ae839e2dfbffc7e2107dae155a6ef8e09583517bcd6bcbe4c",
      "source_sha256": "d0e4ac782a40a5388c77a6d4be554096eecdb0e7037990c54bd17bfe10e00ef3",
      "translation": "请前往寂静荒野，采集[九节草]\\n据说，在九节草生长的地方附近，\\n聚集着狼人残党"
    },
    {
      "id": "coalesced:1ff7dfdfdefba37bef65048cbe22e26eded2594528f1fe8e8b2550efaf03a787",
      "source_sha256": "ae21b976a9bbf9ec06094260b8f4d42d568e599a15f308cece11d040d6c8ff28",
      "translation": "获得九节草"
    },
    {
      "id": "coalesced:36815a61076ea0f3515263748a3445f1aefd154135ce5d6897e759f389d6d4c7",
      "source_sha256": "38a54d6c93b954e63a5358fccc5c262e44f51fec807d3bc6d47c20d64c036f28",
      "translation": "QUEST%s: 获得九节草 (%s / %s)"
    },
    {
      "id": "coalesced:5cbd9bc550d5a3823e0ccaed3400bd33bf19dd95d7dc115cff0ce32af75de4ce",
      "source_sha256": "6ac4944967ab6f60f5b25de904eba7f11e552abce99a22faa3424f422e2f7819",
      "translation": "啊，是说九节草吧。接到委托之后，我们调查得知，这种草生长在寂静荒野。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e00ccc08217bf7dada4af3ea489168686da59585ad611766fcdca1834d81bd05",
      "source_sha256": "f5c9fdd9bda6796718e525fcf53a9eedfc0db2be13e5a2fa26bc4cae138b66c8",
      "translation": "所以，我派了联盟成员去采集九节草，可他碰上了狼人盗贼，只好逃了回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e6e060fdf1094e31118c4fcd08d0d9e6b63d634623f8db6c4d8fca66e3285bb",
      "source_sha256": "afb5d41ead395bf2497db79056f206071a62232e0c0acb18f1e61f066e678503",
      "translation": "我们去那里采集九节草，有些危险，恐怕得请各位亲自去一趟了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db2f6647f1b518a78e4a914c88972998f3787ac3dbee39659ebdad4c4c81287e",
      "source_sha256": "5a1a1e0673e80ac1a2c39c9a7e996f62c0a76d53b767f7d4d2b50af9f26de05d",
      "translation": "我们去那里采集九节草，有些危险，恐怕得请各位亲自去一趟了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1033d6e4b87dfce64b296e09f518fba299e42883bd036d12743bc25cca630251",
      "source_sha256": "ca91a53064067745582dc8a0ad0f1e6afe7d7bf7637acbc1e031eb2cb2f8270c",
      "translation": "在寂静荒野找到狼人聚集的地方，就能找到九节草。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:37d5052e73ed90ec2bcbf7addaf3019d82b861040ce2e3df5ca71cb89488cfb4",
      "source_sha256": "6d99b3abf9149bf2b62f7a5a2495095a3b5f4d5cd5e3d4f7eff59a712c7a14ce",
      "translation": "另外，公会联盟也有些事，被狼人搅得很头疼。方便的话，希望各位顺便帮忙处理一下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1957242b1e54020a3f0b8326b86ab2f34a5f895d081877f95d551f75ae51f76a",
      "source_sha256": "79bb2b99d6a138a4225671def09bb2a6817efcaa453e05f999016fb3361dd00c",
      "translation": "要是方便，就去和伊尔谈谈吧。"
    },
    {
      "id": "coalesced:7d23ca3233c303b80bc9f0007e2e1cbc15ed680c503040aeefba73cede148bf6",
      "source_sha256": "ef7044b416a1cce48cb44de0861270a47b706981244c3b9e64da88b07e8a3e9a",
      "translation": "如果各位不亲自去，我也没法保证，什么时候才能替你们弄到九节草。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:303805a3b203b900b6035bde8ca5770c5ea02573c2a70727b4e2d2adeda0c86b",
      "source_sha256": "ca91a53064067745582dc8a0ad0f1e6afe7d7bf7637acbc1e031eb2cb2f8270c",
      "translation": "在寂静荒野找到狼人聚集的地方，就能找到九节草。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d91f039ebabdbb6d0a938444d17ab63023766d3a33cd6bc5f0d8a84134e5b593",
      "source_sha256": "d972cc6e3393d246e296dc4345386943e2e9f4c7ad585b88d076370f0d2668aa",
      "translation": "听说，各位打算亲自去找九节草。路上小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:649a0853cb5d899b016df11c131be173f150383fb1814207027417ab25190da4",
      "source_sha256": "1e0dc1b94e1225e02ea83755dd8731cc030fb8a1f5182de4dc1a8d2f640da48f",
      "translation": "九节草找来了！制药还需要不少时间，等药做好之后，我会通过库布联络各位。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e7fefbaa2d2def228cfe944c3ae56d9c7f59004f25f5ec369e23d53cfbf7b2f",
      "source_sha256": "55c3af71a0bc958084af1849510e6faf60a696a70f4a7743eccdc030796708c9",
      "translation": "等药做好，我会联系各位。"
    },
    {
      "id": "coalesced:587f9c9b3dfa13cd33695c266ae0103fab18bdb554e4b91de3b32640ea3e1fdb",
      "source_sha256": "520c8b39868263e4cd9c69a592c35e096c864cedf09ce61f61cbe6fdda2877ea",
      "translation": "别太心急。"
    },
    {
      "id": "coalesced:9a3e6bab814637b53cd4253811ff3fd27a0202970da2f87adafa154da3b17466",
      "source_sha256": "0e3928ccca65c8bb95f1c6a070fbe2572864d4bf02e6a34618cd378c1e9ffa5b",
      "translation": "回收卡蒙德"
    },
    {
      "id": "coalesced:46a7356e6783eb96fc9ab1b3e7f9dfd4fe13e013872aeac868c85a6a7f9a9070",
      "source_sha256": "441152a89d917e56c9e829ac196432ede0c511b464fa62a3c3f8b814939696a1",
      "translation": "请回收被狼人残党盗走的卡蒙德\\n据说，那些残党目前出没于[寂静荒野]"
    },
    {
      "id": "coalesced:1207bda4f6ae0347645d0205674d64d89e39a5476e798ad9a63d681c0b9218c2",
      "source_sha256": "5ac9b21568ae5699c8bde863cc8f864fd7ff770ef95cab97a1073926cde31830",
      "translation": "前些天，多亏各位清剿了狼人，货物总算不再被抢走了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6727b8d3b7c5c95657ca832ee803e32defb19c8c38bd4cd19e6802012811b302",
      "source_sha256": "ce6f3817af065064dd8ae0a5282095fc45e393025d35d109452e31070c1905cc",
      "translation": "可是，各位离开阿巴泽特的这段时间，狼人残党又出现了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:86c1dac21aeb456496a4c87361b35c2f59326187358ecea929e331a9ddfdf440",
      "source_sha256": "755994dcabc4dfae2ac5f22bbd8a7d07caa0662066dc897d1c5b119c2da01e06",
      "translation": "那些残党从卡蒙德采掘场偷走了稀有的卡蒙德，逃之夭夭。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7127fe275fc6e6ecf4520f7d85a91d5152d45e84badbfdf3c8fcd43fc21ec85f",
      "source_sha256": "69bf8b8e818ff1c1b868cff863694bfd2c5942c3ef1248055e53e1b7195508e5",
      "translation": "那批卡蒙德过几天就要交货。要是找不回来，公会的信誉可就要受损了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b4f7839399bf33b95966973e7e9d0fc17c45a9823d016a9b5689c6ecc3368fd",
      "source_sha256": "63a5532d14f93b6ecda094efa70f87fdb9ea587ace2ac9592f950fea691bf7ff",
      "translation": "如果各位能找回被盗的卡蒙德，我一定会好好答谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b215b6ee2f4801d107b6716e40b80fc63c4235071b1d17ebacda74da5c79432a",
      "source_sha256": "6eac831eeb0dec90b8d4838342a1ab31f9bf4fbeb3be91fbf84388fb899270dc",
      "translation": "听说，狼人残党失去据点之后，主要出没于荒野地区。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a16ccccf7b7f9ee3e22783eba17e2203127c1d50816dd493b681b17781cf1d4",
      "source_sha256": "9cdbdc05d7e85933cc71626def02f12e7cb8c2f6d4ec1d488f12b3847079d6f2",
      "translation": "这可糟了。这件事，恐怕会让公会的信誉一落千丈。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:146e91054b81fc28df5b45f9aec22422f715b6962e4c38ce0a0af2966ffc1e63",
      "source_sha256": "73004060a01029d70115ffa0af7ca5b7942e80c22602fad28bbea3abde0272f2",
      "translation": "狼人残党似乎聚集在寂静荒野。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93170ae8b7d46ccf8bab2f1b48fbe9246169cf0e18f84ab69e083f30564a64cd",
      "source_sha256": "4da505db8b449632c8f08f46aa3e4437030c81223db5a926acc8708585a5e901",
      "translation": "没错，这就是我们被盗的卡蒙德。"
    },
    {
      "id": "coalesced:5fa18f5959b16c8fd3f94bcb035364acafb662a9c9b92ed3959484a587a6f09b",
      "source_sha256": "09587f200ef2a6fb403cff34565b60f88486c983b09e4943d268a1344aefd01d",
      "translation": "多亏各位，我们公会总算渡过了难关。这点东西不成敬意，请收下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a9b4d186530ca50e8946dc48c17a924d9f5168e9376f3e21f229d8c745acdb16",
      "source_sha256": "fa69b297dda1399cbde92c620e02313ae976dbd5647475ca44f1bda701050dde",
      "translation": "QUEST%s: 回收被盗的卡蒙德"
    },
    {
      "id": "coalesced:422d75b8156559abc32607e6fdc68018e952a1e0627c73c98e6dd6fea5272961",
      "source_sha256": "6953d12f1de11bbd229e85ebe5bcac5e26ddb2443e3068a9da29fca02bb8d58d",
      "translation": "回收被盗的卡蒙德"
    },
    {
      "id": "coalesced:c37efad20f86a2d382abbfaf382d57bd46b3281194c1ee858e988da3c508e238",
      "source_sha256": "b8c7ed673ce4cf8dda517b37251470e4f074243f821dfa3bd01a37b36aa760b4",
      "translation": "被盗的卡蒙德"
    }
  ]
}
