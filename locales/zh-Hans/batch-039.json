{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:a10eda3db2d48e2e8534c84c508f541ffd442e79febeaf996f1f5df7252dfe9b",
      "source_sha256": "783eaf33df9096c9fcaadd1aaf0071f6940dae776765973c3b978b1792eb608b",
      "translation": "那么，塞蕾丝汀，现在开始举行成人礼。"
    },
    {
      "id": "coalesced:7f263764bb7fb602894e69b47a313227d8c3460079f7e3bb1a3725aca93082d9",
      "source_sha256": "0189a196d8eb351bc10825b46ee9c14158b562ba267235885de44299f282dcec",
      "translation": "成人礼需要完成自然仪式、力量仪式和香气仪式，共3项仪式。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0f00fde13feacdd9902c102acf543b329830ce256269d44802d8520cce55439",
      "source_sha256": "44871027ae40db682d45db510f661f7f92fc59806e145242267fcdd64865a792",
      "translation": "自然仪式去找[内斯汀]，力量仪式去找[基洛蒂]，香气仪式去找[斯维汀]。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3adc4e2a1827522563d57ee1c2827de2745d894ac504de0aa136c68420daa0d6",
      "source_sha256": "1eb9b47be370ee621fc5a7d06aa72642dc2c4951ba2084b9ce6c693dd26bf166",
      "translation": "顺利完成他们各自交予你的仪式后，再回来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93dc97ea5240d05d4be921f048f7bfd4cf1152f671f8898d93c80c95f7719669",
      "source_sha256": "a5e18b96a6ab70fbc599c9bc23aa816f31786d9940bac9803b4b8a6e927aca11",
      "translation": "那3个人正在村里的某处等你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d5b01d234fb384fd936d07d4fd79a538077e27141d53f58cba4060a3d29fc3df",
      "source_sha256": "b5d1edc39b2ffd5d4259cf6390d1f519a16f51ad92ef6ab8518b4aa1f41210ed",
      "translation": "带上这枚仪式信物，就能参加仪式了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cffe6e2e8c8d5c17c7a3e00faf936a510bd5c08ec9e0036c58d1febe3b3f9508",
      "source_sha256": "1f7ee1beca261958b8d896c2f577d98dc144dc2ef7a2f02b08b57cf946d8efe8",
      "translation": "你不打算参加成人礼？"
    },
    {
      "id": "coalesced:aff80cc23204ec2dde236cf5cc056b2c3a7a8b12d095ccdf8784eee39f29f97d",
      "source_sha256": "f6a9783a4e3fe4c89e64e19f89aaf50e3408dd7f1f68cb81759d613655bfacaf",
      "translation": "也罢，随你的意愿。我不会强迫你，不过，你不是也一直盼着成人礼吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6ad87428dd86d2bbfa170ba96d9103e9adf98858629fe46ec533d747888c890",
      "source_sha256": "88e1e4c0252c158a19f12b037865b7e2869de35dd647012b2549ab1b2558f66f",
      "translation": "顺利完成他们各自交予你的仪式后，再回来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9892c8f6a4ec9b4517affdffd6f0b64a339aa3247add3a1f9395777efd86aa86",
      "source_sha256": "362a8aa716e743b98c69d1b5c5465bfdc63512b5d743d56ba1b17d77a4af215f",
      "translation": "辛苦了，塞蕾丝汀。你顺利通过了所有仪式。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b49e5d9b91da04ed658683b5950a39ca6511ae846507c46296805be4d8ad43b6",
      "source_sha256": "ddd8c9761f0ee154f38cd3bdc7f7f46e508e361e672e3b83aa88d8c706504cae",
      "translation": "所有马雷族人听着。"
    },
    {
      "id": "coalesced:e2d9b86f2465ad546eb3bb3ddee0a59eedcf471740f803c9594e67acd836f3e7",
      "source_sha256": "a92418da8ad7444a02d444c2487d99f71db4b833cc4e2a73ccb65d9970e049ae",
      "translation": "我在此宣布，从这一刻起，马雷之女塞蕾丝汀正式成年。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a406c5645f5d90b017036ceebaa29d44a0c37aa86134bf1f767eed6887b147b9",
      "source_sha256": "081776ba6885b0131ee9ef8285592dfe0dfb623b121365fe13295a8ceae88fbb",
      "translation": "所有马雷族人都应认可塞蕾丝汀已经成年，塞蕾丝汀也要有与成年身份相称的心志。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e37807cb24b4165a7d745d0ac09518711e5a188dc8dbe47ab09741635ef006c",
      "source_sha256": "31f6efc8dfce346de599e2c2916a1021c52874e47d7dcd7815953b351d1cf5d1",
      "translation": "如今塞蕾丝汀已经成年，我将赐予她这枚成年信物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:874273ab0fc73b0a0fa6775ffe5f42baca9842c903b8fa2d1ac3ebe81003754c",
      "source_sha256": "c7f40b1863dc6f0a7c03c8892b054df0ec89cbfef5aa13d0c03f8b94c5d7fc47",
      "translation": "此外，为庆祝塞蕾丝汀的成人礼，明天定为庆典之日，大家尽情享受吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f46ca0cb105d727287a291f41a9b72fd96bd7b5f79e7737106f7918c96b9ed95",
      "source_sha256": "5a7554e05e5bdfb8ddf09fa6bf89f6fedb2e54b2d9dcab3228ef71baf90b8a29",
      "translation": "你们也在塞蕾丝汀家休息一天，享受马雷族的庆典吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a59161814d0d78f41539ef9142f55ee60a0a63751c7b19dd9b3ce685740816d",
      "source_sha256": "4afd52132c77daa56c2ffaad58b37487a2b20365b3624d423ece31db54d57681",
      "translation": "需要参加三项仪式。\\n\\n自然仪式找[内斯汀]，力量仪式找[基洛蒂]，\\n香气仪式找[斯维汀]。\\n完成仪式后，向凯汀报告。"
    },
    {
      "id": "coalesced:14250e06d6b34920a47be8d7a7a0d576696faf85cc515ec21e1197ea4ee96f6c",
      "source_sha256": "49cb4a113c34e24db432de0380ed3c0080ed17951c9fb7668ce757a0880f43f5",
      "translation": "塞蕾丝汀的成人礼"
    },
    {
      "id": "coalesced:7e7dcd5134c2e72a9247cdf0eabeb7daf44f06507661347c40f6fa536839192b",
      "source_sha256": "ecb4cca8ee8a2b53c32dc3cc50ccc3b82c1d4a519eca9324f9f0bb9b47a748e0",
      "translation": "完成自然仪式"
    },
    {
      "id": "coalesced:c68cc6d472d72ce8720c00bf0cbf26e56336fb1b05fcc555468e38eae2fa4c36",
      "source_sha256": "095883cd0aa10e0084ad15da613c03046f8a2cfb5bfca9621fc13cc1fd8e302d",
      "translation": "完成力量仪式"
    },
    {
      "id": "coalesced:f5b495d7af3fbd2adf506b0518abf0a2048d10e496abb2a80954a6dbd332473c",
      "source_sha256": "041941325a323dd3fec59429d82843925a45a203b8f5779742f8ab3da320903c",
      "translation": "完成香气仪式"
    },
    {
      "id": "coalesced:a965c402df1a898b4e9dc9d6b3c58c46340425a30e3509b070326aeca20ffd5e",
      "source_sha256": "4b11008047fa7162b657903d42cef4a147d1bd58ed412f104365ded8c7291621",
      "translation": "那么，塞蕾丝汀，开始[自然仪式]吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ef0e414155a65226036c71d9bb6b783ead3611a4e398d9912e168ace4de06d5e",
      "source_sha256": "2e524a0b5faa28cf19854ab53ad5d39ad3a2f6ad6e5fa697468403690fa33601",
      "translation": "自然仪式需要你取回生长在水色湿地的花——[阿塞莉娜之泪]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b14205411e73d4642ca57c4b6c96434029bc3e058d11605c6a58446c0d082ae2",
      "source_sha256": "7eb4b65668d320401679e87389b63adba5c61ab5ae8a5a39a413cee585941890",
      "translation": "阿塞莉娜之泪长在胆小的怪物[格拉米]头上。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c8191f0b501fc3083d5419f3e4ed0f133b6fdea3330a7f77ecb1ea90f38b372",
      "source_sha256": "324a1774d2d45a807d37d11a9b9fde0a26f586b3a3263dc641ff0dd73615c9c7",
      "translation": "它们非常胆小，稍微靠近就会逃跑。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de7a064bcf455303a4cb4c35d9ce44bb83c31838db9d7476f29593573fd81c73",
      "source_sha256": "717f50cf6b3c0b1b3f5476c9eefae6a02ac579acf21b777cde86039d05ad6e3b",
      "translation": "而且动作快得惊人，根本追不上。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5c35bb9353dacb1b9f806359d72e12f60dcb62211154596ef172cab41fff184",
      "source_sha256": "299335629b96871c3cc8cb49c76c337a9aa522b50a5423b1887e27745dd01259",
      "translation": "所以，要从后方慢慢靠近，再把花摘下来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:39e8dc37cbb717b1855698b42e12374ea112b474ecd9a4901d414243b804d650",
      "source_sha256": "9ea75d87217d258d246899258929af388cc0a3357881504b544a2d9bfff82891",
      "translation": "格拉米在水色湿地各处徘徊。从背后悄悄靠近，把花摘下来就行。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d689d026c477ec7de1d78817f0fed10ac1a6846205c26b2c53af595bae28667",
      "source_sha256": "bc7ab73fe0bec5d2a18f48e4cbf28892eacff41c01ed14fb8c79c7cd47a5f5d2",
      "translation": "你不打算参加成人礼？塞蕾丝汀，你果然很特别啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ae6cf513bb4c4dd8c2265fc190e0e0c482d16fed6ee9a6d4feff37003596c9ba",
      "source_sha256": "9ea75d87217d258d246899258929af388cc0a3357881504b544a2d9bfff82891",
      "translation": "格拉米在水色湿地各处徘徊。从背后悄悄靠近，把花摘下来就行。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68e69a8ecf9b66d0ca0a717cc212d7b4563196a394c5708895a725783b21d3f6",
      "source_sha256": "fd661d6c2b721e73d55f659fb851b0a4ccf56ad6b738ea290f701178dfff0568",
      "translation": "嗯……确实是阿塞莉娜之泪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dcbb05090f1b669207b4a3002f43b10aa084baf30e8915441865300bce75b04f",
      "source_sha256": "b835b03ffa56659587cb770f76bf59b5aee60153129c4c153822bdb579aad467",
      "translation": "做得好，塞蕾丝汀。这样就完成自然仪式了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:49d114e9556d6a6124bc29447da261f2e37af1ea425d8f6b04f1fa1597df041d",
      "source_sha256": "b67f22d086d5bcceb06fd6cd56a8ba324dd9ae1eb6b7f2608b91815cc2252a48",
      "translation": "其他仪式也完成后，就去找族长吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:252d09e467fbab417306ace138c54753510625809ec9bb5e94266612ab5d4719",
      "source_sha256": "679d9743ca5f2fed6107d7a6af9a589d840c6703d502ff23d3382daf23317c8b",
      "translation": "取得长在湿地胆小怪物[格拉米]头上的\\n[阿塞莉娜之泪]，交给内斯汀。"
    },
    {
      "id": "coalesced:884c76b9a9a5a1e000562c62a633aa6fa1d4dc070de70e9e36cb3884599889ef",
      "source_sha256": "5a3f3c6f64ccb265cbff77ef6fd557e10e551e6ab2bc376763a06e566596bb78",
      "translation": "自然仪式"
    },
    {
      "id": "coalesced:bf84a2a0142109f108ee668ddfc829c3cbbbb9739d69274045f618492cfc1825",
      "source_sha256": "bc62c5a3f9e18c24a196dcac37d53289407ed188975e50109b84f98afa1860ad",
      "translation": "QUEST%s: 获得阿塞莉娜之泪"
    },
    {
      "id": "coalesced:292011b690a5d4c8c76a0a7a67f91441d82b6825219194d92e8be2ad709cfecd",
      "source_sha256": "0ded2036df4071670ffb5e59e293140c0becb8758a510babbb7d7a76ab04e9e2",
      "translation": "获得阿塞莉娜之泪"
    },
    {
      "id": "coalesced:338b5ad7091ba8f0e73965bf5f3c4465556c54b64ecfb373cf4d053494648d95",
      "source_sha256": "abfcc4d9db7949245e145f1192aeed660ef9db13fe310774763fd3ff854a2a3d",
      "translation": "需要参加成人礼的是塞蕾丝汀……你也想参加吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:716cb05007cf6c54df811e2005a62d91b66ef717916af5a44e297dc7e9220797",
      "source_sha256": "e1f6d660b4c2cf4d31fccc746bde930a0252b4459998bdae49219ff356775e17",
      "translation": "来得好，塞蕾丝汀。开始力量仪式吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edcbe6706623417e7a40d8644f77bccde797be65de6b3726df8c9e0e56305881",
      "source_sha256": "882c11cfaff7fc853adb60a61eb6fadef3e8576f612683f8428582235ba1fa28",
      "translation": "即使是与自然共存的马雷族，也必须拥有守护自然的力量。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:374d7e486a00dfed05b0495a5db200a4d2709628cc5074ad39c222ae48e01821",
      "source_sha256": "e3c8fd1d92805b227238a4709637bded587447478ad8ff488babc1adca2f38ba",
      "translation": "检验这份力量是否足够的仪式，就是[力量仪式]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:881c11b18bbbfb9b721ac76136ad16d442ac93c2e89469eb7f54d7c0876c5587",
      "source_sha256": "3b4b6c8d7c17d601c8a46341f67f298be1ecb7baf5e37a9941e7c71eae08e67a",
      "translation": "水色湿地东北方，通往杜南丘陵的路上，有一种叫[尤尼昂]的怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b81c8067cefe2ed2f0fb616bd6bb3caf76c21a4e7f5577ed72a6a2fb584b04a3",
      "source_sha256": "ad86269853b0620219a21e63915dbb8eca38f8431a459a946e7344ce8560ac1e",
      "translation": "打倒尤尼昂，割下它的角带回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8d98f37e54bb9871421d4109fcd5ec98b5e156289d0687d3edcccd851ba8ab40",
      "source_sha256": "9506895db771ae03690e81cfd2d849d68bb83d4e17a099993bdbe4fcb131a7ce",
      "translation": "它是非常凶暴的怪物，一定要小心。"
    },
    {
      "id": "coalesced:a359f574a80f62411b7ca57d6adb406760fc5e5db4bdf3ac3333af960af40f50",
      "source_sha256": "d72cc59619567d8422e22c761e35cce651a0e5acf3a0ec589590a1d5675809c4",
      "translation": "稍有大意，就可能身受重伤，务必格外谨慎。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80c82926f64cde0d4bbbc8c1031bfe5e3dc51fb034414d6ff002deabf6af8ff6",
      "source_sha256": "31616800a5016c14bd1edfa61d7cd5c9140fd831fc2217b09680a215a56e0544",
      "translation": "你害怕吗？但要记住，所有成年的马雷族人都通过了这项仪式。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edc30f501bb97aba2a2af738410503b72d6a9e1dd1a929f48c63c3c1601b871d",
      "source_sha256": "ee7714e288f412206baa6088c9941ee7ca65bd2051d5792507becb71c4a365a7",
      "translation": "尤尼昂就在水色湿地的东北方。"
    },
    {
      "id": "coalesced:dd5893f06166c2556dca9a1fc9df8f4f085efba832c64100e39e465dd5abc071",
      "source_sha256": "b08a7ae74dc8206a36480f77aa3ca8e645c6892e2a8384cc393ad1534758e7af",
      "translation": "你带回了尤尼昂之角。这样就通过力量仪式了。辛苦了，塞蕾丝汀。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2f566ea398e27e77c26c30c05474170749f989a1e371f2e6770bed655bc6334",
      "source_sha256": "67d09dce66f36ece8895c19c3abfa94012a1a0fcad1760381cdefd067dd5f9a7",
      "translation": "所有仪式都完成后，就去找族长吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f567ab02491040f68c01fc064862d0cb80fc498afda8a18572d6f6d3f8295ee9",
      "source_sha256": "74bd79c14aef1954b0320e02e50d905ca64a6f6a4ab00e4a40b87e7422436543",
      "translation": "打倒出没于水色湿地东北方、通往杜南丘陵道路上的\\n[尤尼昂]，将它的角交给基洛蒂。"
    },
    {
      "id": "coalesced:507466ffa8bfb7de81e5b8574ee54f1fdfd58fc45ead3e5e6b5bfd3dce4b8a10",
      "source_sha256": "0a6bb6afaa24fcf2f144e7bf4e1f7474d434a5907b0fe0f39c3f79e0fee8fd89",
      "translation": "力量仪式"
    },
    {
      "id": "coalesced:fc9d251fd97e9c3eb552f03370105daac5213dc170bb9d2e9eeb73ec9413bddb",
      "source_sha256": "54acd6953930768a77bc63b9882fa2eb6141f8d272c9ac347316be32d531a14d",
      "translation": "QUEST%s: 获得尤尼昂之角"
    },
    {
      "id": "coalesced:79c5dd5220164b5521f35da0eb644d9945048f2b847c82f04e19cc7389a86c52",
      "source_sha256": "0d26d581c1668299d1c9c4b373240e214dcb8c61f469cce17b8c9913f63f52d4",
      "translation": "获得尤尼昂之角"
    },
    {
      "id": "coalesced:295f2db1aa5104746d80bef95aebaf4c39d2250b7a30990230a846c861ba0078",
      "source_sha256": "42ad55e718ea2701e80a7b14ff5114a703f592deb49febebb3692a0c6e628897",
      "translation": "能够参加力量仪式的人，是塞蕾丝汀。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8cbca771d47085234f74b5bf5b339119054d7827fa5956b0f02ccca11b6dcf1a",
      "source_sha256": "7a5cd4e22d48914db63e5b26ec19137fffddda59017d53d0de386f573ecfb6dd",
      "translation": "欢迎。我一直在等你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c5439cd175fc545041fe62bd0306b045f4e562a819fda3f766baa2e8c3d6bdc",
      "source_sha256": "7a66c17cbb02e54c7226ff6e2b13efcc89cf86c4a1e4aaeb957f36bcac999130",
      "translation": "我负责[香气仪式]。"
    },
    {
      "id": "coalesced:c1d99680d06442a5e10cbd78920f7dddf192c139fb31c30d0168010841d460a4",
      "source_sha256": "0fc09bc29996091e8cf11799e950506cd001a11f826b2e51f9e6ea6457dcadbe",
      "translation": "香气仪式很简单。"
    },
    {
      "id": "coalesced:12b3e867eb96e101e7fb89d03f82e53bf8251e0084f23bd580e4be29e3d6a50c",
      "source_sha256": "5c137a87a3e99c5439d3bc1deb0458915f6158c966b6006efdecc54d28d08570",
      "translation": "带上这个瓶子，去收集散布在水色湿地各处的[香气之源]，再带回来就好。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13b5744308467e679d267f6b560e091605a7976cb3cffd6a2b91c4385b51cb9c",
      "source_sha256": "c0820d2946c45c863b0333e789ba33576f5eadc1594df0c12b4177465d343a27",
      "translation": "仔细观察湿地，就能看见香气升起的地方，那便是香气之源。用这个瓶子就能收集。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38d564f7e93c325c9678d93d56fdf1f8a5a668004d5e23a9ccbef7ee04d217a5",
      "source_sha256": "e179b9b1e761017a40fa424e2df128d5a1ddc7a267d8b6fa552bc5e05786d333",
      "translation": "平时看不见它，但每到这个时节，就会开始出现。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb44974d33aef20439eb6fbbbbe1d1dfc487a81ec183cd9c9602c8989f475696",
      "source_sha256": "f93316cd250e085b09d0812e7781875e02b54fe6b1c27b973a2b8e374ad4e50b",
      "translation": "所以，马雷族才会在这个时节举行成人礼。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d26207ef07b4605bbb10b1b9a35c7771375dcf4e25388265132cbf01a7eb9376",
      "source_sha256": "a021877e5d572177ae446410f129af116e4bc2b22d60098e5653fb0d6d6d04d5",
      "translation": "香气之源一共有4处。每一处都必须去，不能遗漏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9b3f84731b95e3e1e8d89f3a41bbd91a3aacb2987c665c7d70c39b22a3f1e197",
      "source_sha256": "03cfb5e1e0a4369edebcffc3b6f49a6830e4b1e96aadb1867af2264be1ca68da",
      "translation": "成人礼必须通过全部3项仪式，你不感兴趣吗？我会等你再来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:95f8e3f6b4af51db508539ee87ad06dfb5dc2e8532392fd8f643abde91ed7609",
      "source_sha256": "a021877e5d572177ae446410f129af116e4bc2b22d60098e5653fb0d6d6d04d5",
      "translation": "香气之源一共有4处。每一处都必须去，不能遗漏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5d24ae979bbd3e21984b5bd9e7e5b729d2a73adf4d00957d231d788410851ee0",
      "source_sha256": "c2c9c500ed69d7f6d9f82a92ac120871b575f0afdd61b5ed8cf798deb8625bef",
      "translation": "嗯，4处香气之源，都已经确认了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a68ec8d7b4f89a41bdd21b0be6775bb2e4c79f44bcfce30a5329d441a3f25e8",
      "source_sha256": "a7adc1b5cb7b129d5cfe9d923c341c13b98b72a7ef22fa5a13b23025382318b8",
      "translation": "香气仪式到此结束。"
    },
    {
      "id": "coalesced:23b3c2b7c69f0796559d03d0c25966672af166b2a0f7c782b1a3c6fd4d25a3da",
      "source_sha256": "6f49f5cf35ab088bac6950d85fd1b25d766f3bc782c82ce8065042b6b99d6593",
      "translation": "所有仪式都完成后，就去找族长吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:186a036e63508d381d94d61de819e3523fc980a87f98546706a3cf504e1f83c2",
      "source_sha256": "c148ca54566bbc3bcfb7ecb7951eada6145252d001bd4f022db9b172f3152172",
      "translation": "前往水色湿地各处香气升起的地方，\\n收集[香气之源]，交给斯维汀。"
    },
    {
      "id": "coalesced:2d9d50e5961a375d03f49c149e9b6ae9a001c121db36135e6ce119b3cc20fe63",
      "source_sha256": "4cd8a88db09946422f1c840ad08440df91a521caeeae1ee1013c92b0a007b455",
      "translation": "香气仪式"
    },
    {
      "id": "coalesced:ae83a0a2340a5fada90ba9b705e0aad27228adf7b2c17cb8740ec35d56d88b57",
      "source_sha256": "e06f73d191533850e1e7e21dd2d39466511142d8c32cd4f4c04328c7ab136da7",
      "translation": "QUEST%s: 获得香气之源 (%s / %s)"
    },
    {
      "id": "coalesced:dbe6fbaf4068ace506ce144f6d222068676f693b0acf7dfe22267d34dafa8381",
      "source_sha256": "94d1ede51b41f0b9f44bdaeba35fb27b0ec6ed93763d199beb089ec7b0e29641",
      "translation": "获得香气之源"
    },
    {
      "id": "coalesced:81ebb769af496e97ae65b659c6c60aebc94eddadefbd3427ca045f91c178a5f7",
      "source_sha256": "6cd8e4f00d9d5ceb0291b9fd2fa9963925174e7f32cade28709070ab27ff4452",
      "translation": "我理解你想参加马雷族成人礼的心情，但现在请把机会让给塞蕾丝汀吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f5902528cc34143ce2da0018cbfe10ad5a9242b05cc43bdd81b142a8e009f872",
      "source_sha256": "a39060b26d0a9b37a6c167b8d48c229107c230b4e918ecd4ad94637341dd41dd",
      "translation": "亚历克斯大人说，这能让鲁哈尔特之战走向胜利，并交给我一封信。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d5a1e0df3c2e39716bb471326fd5beb18b03dd643d8962bb753318b5baa28f8d",
      "source_sha256": "615f27369b0d3f903232cc94174f03c8eab4d0f8983cc6478ccbb83020db9b63",
      "translation": "信中表示，会接纳那些打算从北部军转投南部军的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f5051b546fb8f89539301ca8325a2818b1026411e1a86733113e5b7edcdaad5",
      "source_sha256": "939835d6268fa30979cd289606fbdfd2bec41ea0259c7bae509b509c171e6f81",
      "translation": "只要把这封信交给鲁哈尔特盆地的投降部队就行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16cd298e530a460de63049a691a0d59f7db90ba50730a3f1836299c4eb529b43",
      "source_sha256": "0a9e6af32a4f160b0ce847138634c7c23e025e54a64a21154d6bffb954502ec3",
      "translation": "嗯……不过，有件事让我有些疑惑……"
    },
    {
      "id": "coalesced:e29d9d1028400f4981722104a04fe98ef77048e6fb752bbb749896c8fa6fb86c",
      "source_sha256": "1b53f38383ec807062d7a51a1bc04a20093b3c7fd40f1d6774f7bf7baa2d9ba0",
      "translation": "实在很奇怪。亚历克斯大人是什么时候做的这些事……竟然亲自联系了投降部队。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e350d8c71634d1b44264b499cd7cca2654d69f5110316a5283c96189a78bb1fe",
      "source_sha256": "ea79278b468c8f7f27a81ba747184aa15b9c18259aae38ea6982ab44784d8b39",
      "translation": "而且，连商量都没有，就独自决定这样的大事，也不像他的作风。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c453c75393b861d11a8080414fc47a5d65ae64d0f8b5416911663fe2bbe9db03",
      "source_sha256": "0d39f6e054ef24f915f195e5ab86e6c7c86fce700f68efdddea93b6eb1d7ccce",
      "translation": "看来有些事，是我们还不知道的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:37167907bd57d198317a83f0039dd2da6f72cb9e96a7987fe9ff0919b9dc66ab",
      "source_sha256": "b1a738a7cd7ae019a7f3573154273dcc953d9a611cf938c60a9f2b36b5b2afa6",
      "translation": "北部军的投降部队应该就在鲁哈尔特盆地的某处。具体情况，我也不太清楚……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d191dcdcf4474173cf3cfdf2293f02e1d39c69e9fbb90a8663c14cd771df68d2",
      "source_sha256": "412b87374fad4960984642c070cd6ff7d3c07db6bb40a97eddad322f07329b50",
      "translation": "他说只要靠近就能知道，应该能认出来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b931f1fbd1d2ba5ef500fa6e8b90f83ba565ee8a3e575446f3d07348afedf2e0",
      "source_sha256": "a7c4ca5bfdb8caab398c02fd7ed7da1162eda42656345991ffe01647be0c344d",
      "translation": "违抗命令，就得承受相当不利的后果。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87653819dcedfe84b5ef765533a8725088e52581e761c24a4f6c200a71d1eaf0",
      "source_sha256": "c773d6022db8655540fcd8213a861d0002dbc9521ceb09417b24051d868c6691",
      "translation": "请将那封信交给鲁哈尔特盆地某处的投降部队。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7adabeb76c811fdeb63f54829e64c7d9374829a484ab7d46967eb5d1aa75fe41",
      "source_sha256": "301c14554df0734b1dc1aff448a3c5f9883f5a4f85666bdf0fce819e62882058",
      "translation": "据说，只要靠近就能知道。"
    },
    {
      "id": "coalesced:5d0270aa7ebb5aa63014976cdb3f263c1a8e932b3d4677a9327001b93052b335",
      "source_sha256": "59c8ae190b221edaaf78e380cb3d9b2e77240091bf403d1480a5c134896a560c",
      "translation": "南部军果然派人来了。"
    },
    {
      "id": "coalesced:9b29136e8f644637e607584df86ce2a73d9c7901004ad9b4b06ce24020134a54",
      "source_sha256": "ecb41dd4c04b5ec81aa2fb8a7211b1884dd051ffb30e9614002e24df2b27f0c7",
      "translation": "不过……目前的情况有些不妙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9705396b7d63ef0accd3fce5d753ae97f0c444330cf1fdb781b4168ba438f98a",
      "source_sha256": "96a97154c513f49c12cf0fc3ffeac43efac75fd1cae61a6b854825acc17821eb",
      "translation": "队长！您没事吧？"
    },
    {
      "id": "coalesced:54086785985143abf9234db4407e3610a757c3f6ba3fce07f9a578626136a9f3",
      "source_sha256": "48fa71a08e9c8dbf80b4b9ae650cdb5fd0ed57425d33f441cc1144191c86e140",
      "translation": "与转投南部军的北部军投降部队会面，\\n转交亚历克斯的信。\\n投降部队位于鲁哈尔特盆地的某处。"
    },
    {
      "id": "coalesced:d7f2e21a89107c23e6cd80d6167ec384e0ca57c46be49d246dcc52b3907107e8",
      "source_sha256": "5889445bd7f23cc4c10c14d1c691f64dc5a547c2ab036c2e9ba72f051f4a6414",
      "translation": "亚历克斯的信"
    },
    {
      "id": "coalesced:27f3c6cc4fc7e8187bab1820c638c5eaf02e2393c14580fd971c5128a9a9a1d2",
      "source_sha256": "4c9044e8d4a50071dfa6219382a9547c29ecac84f0a7de24cdf74220581cea8e",
      "translation": "内斯汀"
    },
    {
      "id": "coalesced:0bf5ac3fdc789e84944b05422b03c93e8e3f610466c6a4535a099ebaf644d366",
      "source_sha256": "f865190035160666973e5932e7301559c77710114b7a9b550755bb062db44636",
      "translation": "斯维汀"
    },
    {
      "id": "coalesced:d5bb13f3119b06d71f12ff1f5a44d1357358f18cbe331e4b0feae2edf43f25ee",
      "source_sha256": "b6df76d89410ddb8ec908a36100b91c7d0abc69e41de8c6de477069115acf033",
      "translation": "格拉米"
    },
    {
      "id": "coalesced:2afc7d78dad356c017dfa7fe6217d83e7f7220856d8f19f7a35c2c2ccdc97a53",
      "source_sha256": "c577349e019571cba0e707b1a1ecb78d1749db5719b5300f76936412e16c7132",
      "translation": "用于收集香气之源的空瓶"
    },
    {
