{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:dca253da8fcfee10d9e56aa0a46e7439a433a35c8db03b634b27b83c8c135a95",
      "source_sha256": "40da96f238e3153c5e54b5430a3c7335941d73ab2317e6c6a0d675e001fbf2d5",
      "translation": "终于见到你了，阿尔戈。好久不见……现在，来做个了断吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3fcbf38abb08e89a11a062a34219316a614e5dea4e8217838af04e07ae53c367",
      "source_sha256": "45f1903dde5d2be6ef51be345a261adc844a4813b4b2ff796728329ecc8fe3a9",
      "translation": "德雷戈……你也对我怀恨在心吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:069f7636db1d5f757aae10e7f0f849ab67f1824a6004b63341400b430d75a0a2",
      "source_sha256": "3e8824f5100bfa08b87e3b8ce64797833c2558e9b8b0e616c59f49a3a8d36309",
      "translation": "特雷瓦不会妥协。拿起武器！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5543793c2e9b82faf0ac0913fbd7bff73f6a55555cf9e4e55b896bf73d2dfa98",
      "source_sha256": "0f3d6869bcbfb5977f01a799225e14b2275dad8f91998e27de31d66680cb81a0",
      "translation": "德雷戈！"
    },
    {
      "id": "coalesced:b0cda1c45af33a6c12fa7818275687ee30154688b37265a0472e035205438fa6",
      "source_sha256": "2a0c4b6fab01e29f20b6a713f1e868c7da80b81e9a3443cd4369cb228a0e051e",
      "translation": "做好觉悟吧！"
    },
    {
      "id": "coalesced:58add299d553eadd5cdeecdeefd25e57af2d9531cc09c8b10b0cc2793ffbbc8f",
      "source_sha256": "22cc3c1dc2fc5d5a21b5593135750ec1d76e0287bd56832e4e5c7171aa755dcc",
      "translation": "呼……不愧是阿尔戈。这段时间，我一直在找你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa7501102b8e4a628af3df1134ffb47c8e34e6a8a2bd80e7ffdd75a99ad43306",
      "source_sha256": "d4d2c3148db4bd619f0bb1f91804add202de52c1e54cabc0b2782d3b6948e5d3",
      "translation": "你也是来找我报仇的吗？"
    },
    {
      "id": "coalesced:8455a995c88bc3bbec0cf45e02cfe8d1ee970a5f2ad9932ef13d0cc8bb9efb07",
      "source_sha256": "a444672b89372ec3079c4929edfd37b38194fe40cf4d5f729f3aa16dfd40afd3",
      "translation": "故乡覆灭的时候，我确实怨恨过你。不过，现在我改变想法了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94d8c3024fae379e1ac379797a31c669c2dd70c0c9ad83b39cf133fab9efa4b5",
      "source_sha256": "d1ab8096f07f2ff0a36244972e8af31cc389564656acdc79701bb5a870a4e241",
      "translation": "青月特雷瓦之所以覆灭，是因为比黑角特雷瓦弱。仅此而已……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9edf0094e6b5fd7506b819be23e2d72155661637ef64965d690b67bc87fc9c79",
      "source_sha256": "9b5252f7c690cff3c54c611e2b6d87c8141015a5bfea0d28398c5bcfbffbcef6",
      "translation": "青月特雷瓦需要力量，才能对抗黑角特雷瓦和修恩扎伊特。所以，我在阿巴泽特成立公会，开展活动。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e08b160f8556069bd6f98fb893a5058e9c22271981640ebd68364b68b0c2faf1",
      "source_sha256": "b1bcbdb533e68bd9530856e685b9b235badf7499fc77b95aa46ed69c280cb75d",
      "translation": "难道是商人公会！？你竟然建起了那么庞大的组织！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f34e77dffef1790af2e1269e69e186061b99b8f5e47f0f9eadcd281dc1e67c36",
      "source_sha256": "e4ea3b648324003e11a33d6399ee808550ffb12a787d6074c7309636b9ab414b",
      "translation": "都是为了重建青月特雷瓦。如今，总算有些规模了，所以我一直在找你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4bbb6d5a0448c142aa62abadcb49bfe6771a00da03d96fec0a0c636a0205bb8c",
      "source_sha256": "413290edfc96e4b8f9121ed1434f99b172b5d69b87098108fe0b590e35ed4ead",
      "translation": "为什么……？"
    },
    {
      "id": "coalesced:0ab75c2eedffcfcd6037930cce22c89059ae91c238fd59f6587b6fa3b545759c",
      "source_sha256": "d007d3c70f3971259f46dd5676df2378901e8381cd00b631e0747ebbd25714ec",
      "translation": "青月特雷瓦需要一位领袖。"
    },
    {
      "id": "coalesced:011fc8b2def53aaf6da7f16e55934879d97eeef5417d18e3a22b8e1e70248cce",
      "source_sha256": "1b12d293d5fcefcb4ba39a9a0dc47608c87a1a5cd6f6df43c7eddb811f21eb7c",
      "translation": "四散各地的老朋友，已经在鲁哈尔特高原聚集了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f0f61c3634d1f7fda14f17a3992b80e55b88497152b4d8df19f9810d0465f3a",
      "source_sha256": "229c72ea48e3008bdb4e891528f80ec17bbbb30032e0c761830cde78b9759868",
      "translation": "如果你想为故乡的覆灭承担责任，就再一次以族长的身份，带领青月特雷瓦吧，阿尔戈。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:888b5b5c784c900b83171ab3089ace1189f82a303b3fff2a19634ad8035b2c83",
      "source_sha256": "0ece722a29103b13ceaa2067a44b67bf4d16898a6adf57be65b21ab6c1ac3062",
      "translation": "接下来，我也打算到各地，召集同伴。虽然，这会花些时间。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:29d39f4b2b39186fc711d9e08c69b99aaf58c2dd25eb362a662dd72c88dea428",
      "source_sha256": "6127a1a3524d364cd19caec83262b9cc54ccf470a2c841fba8e492cf343f1a7b",
      "translation": "德雷戈……真的没关系吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d552daa2bdf48ce55a803a8940c950e44f98b4a5bbefb3f8c60f0355d3e705c7",
      "source_sha256": "1d13a6bf62f7cb22da0fa1a9f14b1980365fde8d33948423e62d22c3d4ec3c98",
      "translation": "我真的还能，再次带领青月特雷瓦吗？"
    },
    {
      "id": "coalesced:e41490beee567e74a87aed89ae855b047169cf102eea6022afc6ca945dd884cf",
      "source_sha256": "2867194c71bede70a16a5d2412972b56a3992d1285cc442aa862afb149cff108",
      "translation": "我只认你。去鲁哈尔特高原吧，同伴们都在等你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8fa93e4ca4d1f05e21e26132b691201ac9f0e2fe0ee320a5ceabbe1309d69e05",
      "source_sha256": "f19c0345ae379a235edf17dea9c51581628501b0538a1dc07242f9ba0bc920fb",
      "translation": "后面的事，就拜托你了。我该回阿巴泽特了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:952beb62b5ac583051b28607f0deed025a538495d3c55b4acf980dd8840d19e9",
      "source_sha256": "8a52d27aed37be192caa388a6b8dcd8f5f9ae7b3b385dd04e7fb646c675ccc86",
      "translation": "谢谢你，德雷戈。"
    }
  ]
}
