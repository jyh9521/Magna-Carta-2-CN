      "id": "coalesced:66f9702f88e719e73023220fd2c4e6c562d0eb70c14c698f1e1d1a48e7ed9002",
      "source_sha256": "90e21acfd15d91b8dc0cc5b16219ebd6648344725d45e98451ad53f849dd092a",
      "translation": "这么厉害，我在后面休息一会儿也行吧。"
    },
