{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:07b454ef6818e15eb89595b39221d3757e9132889647ce203126bd606af3e182",
      "source_sha256": "16df734ee60c18a5c74e60544d365fb69477e86a3d8d810dc5ede1445c9164bc",
      "translation": "梅莉莎……"
    },
    {
      "id": "coalesced:9ae71ed0059df3630c29c0faad7e346a03d7a2e6b44015938400aa75750d3c78",
      "source_sha256": "4077454375e5fe2a034d2d6c98ccdf66b31f06f949c9d4cb2cad02c7494e5056",
      "translation": "……唉。"
    },
    {
      "id": "coalesced:d47199ff7ee674ef00e622ce3dd5e92196b916670a72a7d097f2029860614891",
      "source_sha256": "2d85843ae2e57a0f5d81ebc0094a93363c6b580a5b1835c04827c8ca70df0537",
      "translation": "杜南丘陵的战斗结束后，我们返回了阿巴泽特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d58dcb8e103999c7dcf9d75ec365eb7d7a881076fda2f5d63c28ad63a3e3f059",
      "source_sha256": "ad4c020d1547aa81c5611d88b5d6d5d81e58a5bd1428d3a02e55902911ca5cd6",
      "translation": "然而，一心为了复仇而走到这里的我，却迷失了方向。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b836db83e9e05c61942396f09e98669651cbd384044aaeb331978fb152c1964",
      "source_sha256": "f41e11c5bbf53f02358a4be8847dc56f119fc9dcaee281478dae32b88750db1c",
      "translation": "梅莉莎为什么会加入北部军？我怎么也想不明白。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20899a932eafca0a1560dfea5635fc2c6fa4e684b07c08c668c884131cdbbe23",
      "source_sha256": "6011bad5d8930ae0b8f6e32392e1e0061fd1de0d8cc4cde9f8f0c5f9d66aae13",
      "translation": "只有这些没有答案的疑问，不断在脑海中盘旋……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a71a5b64097520c78ee36de1d9751c81160683426b382fa3f78ec739af6bb7a",
      "source_sha256": "8590a0a0648a442a5b5f6189bc61d5a2478a47c1a67eb54b8ce4134989bfc319",
      "translation": "大家辛苦了。恐怕很快又会有战斗，今天就好好休息吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81508d0e2f21f85111ad36f429edc0c74bbedf3f484585bb5b50787f30181adc",
      "source_sha256": "359e9eb19b7c2957b33c7589fb31a4e4227d42c5520277badd88a9d463d1ca5e",
      "translation": "我去一趟总司令部。"
    },
    {
      "id": "coalesced:54b002b1e9fb47fe0497b053fc7bdf0232c51e9932fe4096baa65d23fe94e18d",
      "source_sha256": "77faa21a052b97324580b79872ff049b1a1d4961fabaf3205e565faffa430729",
      "translation": "克罗塞尔少爷……？"
    },
    {
      "id": "coalesced:9db199d9c9aa2ccadadc2b557c658b2bc85d4d9242b666fd3089d7c861cbc8b6",
      "source_sha256": "c5e426ca4d2e4e46b1c59a628117b3e623dda3f571675b935a662b735ba09289",
      "translation": "少爷……？"
    },
    {
      "id": "coalesced:98b794195ac3f276a2c5093345e799bc36fde833ee88a634a25dcbf738f050ff",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:2690bcadcc8d1038a2aa57d14d0303f782b3a3fc9ad8ba230e7210db2537a0f8",
      "source_sha256": "cf9805040b944d5201ba733e09faaf8308bfe67f904d675f20d1bd916bd4422a",
      "translation": "玛莉丝……你还活着？"
    },
    {
      "id": "coalesced:4e13b7dc8de8d425fd2b4264ed3db25321db7187b8b03d8bd19f7596876323b6",
      "source_sha256": "9392f56cadd4a84f2a3a0701868aecf9b3c89515229d6071e1326336e7d4684f",
      "translation": "克罗塞尔少爷……您果然在南部军！"
    },
    {
      "id": "coalesced:4e6a427099970b64fcc051d03334e0d94861c13484b3b25ee0cdf1776a19888b",
      "source_sha256": "89db3182449a3ec418f59adac068d68b61951cf57cb010bd22cad3fe6f42e9c6",
      "translation": "玛莉丝……"
    },
    {
      "id": "coalesced:39dc7a31520045aab3d8a9d83e484170024b77012b23da6669c62f180302439b",
      "source_sha256": "c3dcff02a50212d63a8a97464f5d8b173682dd5006c98e4f431f5f36cf435f2d",
      "translation": "您平安无事，真是太好了。没想到，我还能再见到少爷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:110f69ac49bbe92fd10d01b24c89f17fc00a886afde1f316ffcb2ffa6dda95cd",
      "source_sha256": "5c551d6d3c8b207b4b72e2497ea06a483cf17fcbdcd006f716848c1521f96961",
      "translation": "你也是……太好了。我还以为，你已经不在了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d5a982b40270c6290ea7619db6d41d05d886005190c18b6150d6cdc7fb4aec2",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:6512dad393e49bd2e16828b6a3f3117290b176af7d93a624ad0f2353e295f43d",
      "source_sha256": "864f79baa6f01b4ee714d8e57fea621308c500549e5a4391aab64738eb978b1a",
      "translation": "怎么了？"
    },
    {
      "id": "coalesced:c34b7872d7561390deabed3e0ddbb293426c7bcc76780d5562c3f920860df0d5",
      "source_sha256": "c41ccd776a0b6bd8cb6920f988ec9183ad87bc81156a7aaec00ac9f8b6954e4f",
      "translation": "我实在没脸见您。都怪我没用，竟然……"
    },
    {
      "id": "coalesced:b950d478d975a70e94a1423277f574d7293dbdbd2946622fd027e47e30347ba8",
      "source_sha256": "058ff3cfa43f7a5790676dbfa740d41fd7deaa365cbb01fbdf4735eb27121856",
      "translation": "出什么事了，玛莉丝？"
    },
    {
      "id": "coalesced:bd481eeb4faf028f1806746d736fe333a7f20d677a13518ba8310ae39888c2ce",
      "source_sha256": "3dddb46eb9b00dfeba57eadd72222c33cdafce73001800b42138a52bb41e81b7",
      "translation": "我……从过世的老爷那里，收到了一件东西……他嘱咐我，一定要交给少爷……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02d18cf15c494543ca3ff338488b958cfabca8aafd38c07c22f94c39274cf195",
      "source_sha256": "1335275f31f32c459a45e6216dc74efaf578b1c749cca341bdadd3806b0481df",
      "translation": "可那件东西竟然……被人抢走了……"
    },
    {
      "id": "coalesced:208d9b4f106791ed4530d7b8b4942ad71e7a0915939742f67498540479eab525",
      "source_sha256": "b276789fdd612948693fd6b71b2f7cb8ad65de2db3875e24d06953f22e3ae3e8",
      "translation": "被抢走了……到底是谁……？"
    },
    {
      "id": "coalesced:21baa28488694cfe954c51ca42be629032957a46272ab853b1776244fb79436b",
      "source_sha256": "bdc2c7af8c5b3f55ace7f36274e0f836f4014d77b8a2373f82815123dee0e5d7",
      "translation": "来这里的路上，被拉提族……"
    },
    {
      "id": "coalesced:14d4968fa56f507210763794313c7892f89e045dbfe4151eb99325c5ea2d9744",
      "source_sha256": "a7ccdeeaa5457879a8e7c9a2fde8152aa00201e234885ce8b080fd8644a0de90",
      "translation": "对不起，克罗塞尔少爷。"
    },
    {
      "id": "coalesced:714886bd8f9d66aeaf4097a377c8c0dda5032c90f20173526662068242f0e2cf",
      "source_sha256": "d572bd064305cab4bb4452c36e0adcad1c59df330c3edc4e980756a06c6eef5e",
      "translation": "算了，没关系。你没受伤就好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea492b2a6b4a2d768617b6eb3c2285bfcd066216b66e95b8d31f50f9884179f2",
      "source_sha256": "369525e0af268b08348ac84d908318edd4897493368d1a0d093bcc17409a357e",
      "translation": "可那是老爷非常珍爱的东西……"
    },
    {
      "id": "coalesced:9df5ca6e9bf114bcfe3622bd9d1d1afe5a2bf587af5864abf094a2b35ee342b7",
      "source_sha256": "5464f080897e293b66488e773552dfd973317880a6f9541a74d88fe7d7c95158",
      "translation": "够了。我自己也要上战场，不知道什么时候就会死。没必要执着于身外之物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c643284c2adb45e0af893a53f015e012658826f83a7df50dffa73b1c003a327d",
      "source_sha256": "b40f6b4743164d5e2b3f1ec00d60b8d74576e7ecedf19c4a519388d479d1d134",
      "translation": "克罗塞尔少爷……"
    },
    {
      "id": "coalesced:e0edb28ea23ea6eaa47d603126a59f97e876bb57c7fd8f25c8cf4da6114b74e1",
      "source_sha256": "3b2c7fcf1d9b3d7ac2d7827664598df64675765dd6829f149cb1e5b2d55ce49b",
      "translation": "谢谢你特地来这里找我。一定很累了，先休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ed29030af599533c828da011494fbd0748fcf512ed79013d8d091cb7af10aac",
      "source_sha256": "410c37cb632eb22496e5b57d8741025bee39a6e58e3f676317b5455db2fad0cf",
      "translation": "……是。"
    },
    {
      "id": "coalesced:4186dd9e50a2d5f766362461fb206e6daf70447c90e31e5ab11384da6090712d",
      "source_sha256": "0b24b9bc46415b0c528b7d1f489df9b9ca49830abb357e3452ab17ad9109ddea",
      "translation": "克罗塞尔，你原来是贵族？"
    },
    {
      "id": "coalesced:5f275f9bc4b059fd6a17fafced582f0af569f45ce6e780986bc092301b71793d",
      "source_sha256": "7e6c09f85869541f9c99ebfe8634d7200ab499cc9e3ff1ddc91dc41497fcd05c",
      "translation": "没什么大不了的。只是个下级贵族而已。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8278edf734a1957a6619193ad3235b50a12bf858da00dc42047ba5272eda70c8",
      "source_sha256": "bc38d175b13f7b85944304de9f8e683c6843c1481e2d36bcaa476bd63c0c6291",
      "translation": "可叫你克罗塞尔少爷，总觉得很了不起呢。"
    },
    {
      "id": "coalesced:30969645517146563a3557c37ebb05a13b36c1b3449af884645f69c771328f7f",
      "source_sha256": "85d34d08491c6f0d68e05593d10c7cab4b00b0e08b6c5597b7b59fa44aad504a",
      "translation": "都是过去的事了……"
    },
    {
      "id": "coalesced:4894dd5e660512d0b82496316f20914d481f61f4845f54cf2c0c083598d3a5da",
      "source_sha256": "692df5874f8ca347b822d315e310485d5eb8967816e0dc59fc0f4d2e127972d1",
      "translation": "“拉提族的据点”就在阿巴泽特西南方吧。"
    },
    {
      "id": "coalesced:bb0bf9a9b8ff732ff5919d8307130ddd35ea532b9f9f0d0a9b048792d10bcc1b",
      "source_sha256": "6ba11723e03cfb0091d0447f531c7eb88a744eea83078f89d18426591bfab364",
      "translation": "那又怎么样？"
    },
    {
      "id": "coalesced:9283b496b51e5f9f0a07e068cb7bd04f1a48fcb1c1adeee8e39019ad02f9e3b0",
      "source_sha256": "9e8371741b920252f0c0728e02ba1a5c7d50ca4a2fb097eb7ea4fe1eb7bebbaf",
      "translation": "去找回来吧。"
    },
    {
      "id": "coalesced:5d72d027ac0e6bceac7ef352eb821b99c522e914c799b14a4982751279dcf77e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:3d9bb0c3b9d933075a5ac1e9d83ab106af3063a99cbb3e934443dad62bc2cf30",
      "source_sha256": "9484be5d6cfea01d736a3738bbc1e677217f4339199eb81c6af9a4e1292b47f2",
      "translation": "是啊。毕竟是家人的遗物，还是找回来比较好吧？"
    },
    {
      "id": "coalesced:a237aa4b9da84add18e127b3aefffa8d0295ebda67d33b3fa0711ae12a868b06",
      "source_sha256": "dd2aa21568c61c67f697bbfc2e3f239fbf1c9d0d8914eede660651b929bc6c51",
      "translation": "好吧……既然你们想去……我倒也可以一起去……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e384c4529d531e7658d5ff460506fc1b385316531a4884e4fcfcb4049c802d9a",
      "source_sha256": "4c4942770ff3abe3fc3c6bedd162715d2913f0cf4455041771080601b7535aec",
      "translation": "大家都知道啦。就算一个人，你本来也打算去的吧？"
    },
    {
      "id": "coalesced:30770877c06894478cd9e5d814456268934a4fbe42a6396a1dd04cdcc2f85395",
      "source_sha256": "6cda419c8107606eb293592736d97b0de46ce0304e07b964ab6d6f1a12b51169",
      "translation": "啧……"
    },
    {
      "id": "coalesced:8dfeb40d67bc39b6d76781f75000829131006421e1550107b99a763db91337a6",
      "source_sha256": "df9fb63e2773e8c6f47210f80ef0fc0f87b45e075d422bb383e042a0dcfaa2f6",
      "translation": "终于找到了。"
    },
    {
      "id": "coalesced:c4c7e0fffbd8158fd31daea66c9e8f23c6dc37943e3e5390b63736dafe85fc27",
      "source_sha256": "fd0a856ab22953798a701202f0a350f968c75c9c510870c6ed37c105290f9adc",
      "translation": "谢谢你们……帮我。"
    },
    {
      "id": "coalesced:de64244c02da001502528b5fef9d6317d1350d539724971b9930fc7126a13d20",
      "source_sha256": "e148a1dff00d5881f578cf55e66198819af8b596e80a6d5c77109b1c239e6ce9",
      "translation": "哦，你刚才说什么？我还以为，这辈子都听不到这种话呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9c1a346b4daf9c76f5c8b32de8a9a5a68b9607be575749215dcb5d74ecd1dcb",
      "source_sha256": "3fa858774b1eff9b52fa9480aecfd0bb5d1051bde88d4bc07c7625a0df8dd705",
      "translation": "我可不会说第二遍……回阿巴泽特吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a81d4b93745f8b7e8984c48ce8dcd27ea5d9eec3acdeae5b69b92d64dc368bf7",
      "source_sha256": "9a5270cf21bb05600d12ab9e6749337d598390f006f7435bd1024b27d2f14140",
      "translation": "总觉得不像平时的克罗塞尔啊？"
    },
    {
      "id": "coalesced:74f8831097a5f3b6866aa019d80ece4f06291263427b4948b908c9dabc34e1aa",
      "source_sha256": "44dc85d0ef96d218980df9a41b96f7d678403fd95d55cfdac2676c29b709e4c7",
      "translation": "克罗塞尔因为战争，失去了家人和家园。和你很像，朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87d6803db77dc0fa78f74f997a445dff5c2eaffe0c0c6488f9b1968546d020a8",
      "source_sha256": "a6d1fb9a427207846450a7396a012eb4943c4a8c6425ae81e4746e6fdbcf3247",
      "translation": "原来如此……"
    },
    {
      "id": "coalesced:c12114e42ac52ec33e5e948984b6fdb5f2efea0647ee66435cad3a820b2ddd2c",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:0bbdf1a9392672058e6dcfe7b4bfb1772ae104976d71012af280d8476c2ee52f",
      "source_sha256": "ddad60b51d1be58b3055205fece82f49b8933f143a01f2aff24a1a645ba75f0b",
      "translation": "洁菲姐姐好像还没回来呢。"
    },
    {
      "id": "coalesced:71976753bef6b73f4cd39bd4d5bb76239093717306977fee8227331ce1ac95f1",
      "source_sha256": "48054696fbb6a680aca5089dc99b2170d58a902001c70447e91390e7766603aa",
      "translation": "看来会议开得挺久。"
    },
    {
      "id": "coalesced:1cb7c00bee3da3d73f92e1636182764e7e9c01519c977b6d4959e19f1891459d",
      "source_sha256": "d37a738955b224a22d9fb8f45b2ac219fa03a3e4674a7026bb2380ded4d7175c",
      "translation": "那……是真的吗？"
    },
    {
      "id": "coalesced:e9b9028338a0112f8b35617db41921bfcafde175adf9089441d89a731450f152",
      "source_sha256": "8f5e1d5945ff2dadc9561813324ceb05021a2d188488ed692e7d062e90ded5f9",
      "translation": "是的。哨兵的身体，是将包括人类在内的多个种族和怪物合成后制造出来的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dd622570663650c800fb49ba2d4802be4946e994200fb3d8e5767eed8bc5a183",
      "source_sha256": "d93b21985e2b779d589f7cf6da4704dec2de17495da44b2ad0cc2406a8c5b4c3",
      "translation": "这下，总算知道哨兵为什么长得像怪物了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4c5b329811e5430c1eb2b223ce7723d505ad28f72dc53dc9176344f88495b16",
      "source_sha256": "c627cba31b8b8a0aa3d3185a8a39fd7ee98618c242686157c3bf5a3d2cf58284",
      "translation": "去侦察的露，很快就会从贝尔福特回来。到时候，应该能得到更多关于哨兵的详细情报。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63ce1ec567da49eb51a6e0022e1b491319e8ecdd420a721edb46d96ee6894f68",
      "source_sha256": "94c967fcb906d656b5ce9c790e5101ed7c5638d6e9f6bf18d11fe2ca4e0eac31",
      "translation": "北部军那些家伙，披着人皮，竟然做出这种事……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80d2db4115ee660ee2f1b6aba471d4aea5d1867097a6974d6ca3a1ce2e8cbdfa",
      "source_sha256": "85bd27de15ee56b017bc5b218f9bfc6cca04f999117c19094841ea8303efdd3e",
      "translation": "这种行为确实惨无人道。不过，为了取胜，恐怕也没有余裕去挑选手段了吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4251784b76f1e691c72884e2f7e7fa9f536464de21becab41b4256a535a964cf",
      "source_sha256": "bc09c8dd3b2a26b8f09337b5bb4ad0b4c5e1c447363ac7b801f58ce91123e91f",
      "translation": "再怎么说……这种卑劣的行为，我都不能接受。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a565cd15084ffa99a76b88cb9d056b73d1e87ae8b296cffbb8d03b552d26adb",
      "source_sha256": "6e59a41c383fb9b0a941a19f57f93ab996b940a53064e1990c9ffeb371113dc2",
      "translation": "没错。既然已经知道哨兵是如何制造的……身为兰兹海姆的公主，我就不能赞成制造哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44fe804a450eeff9bf19ffd3b4dbd8d815cf02f3bfddafcd77745f50ace809ae",
      "source_sha256": "2505ae12d6b6278c3010735d48ba0459416b1e24e1b8bd330d4e55295f5c0233",
      "translation": "之前，为了对抗北部军，我也认为我们应该制造哨兵。但现在，必须停止这项计划。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9683677de91c47c34014fe06f0a98a1050bfeec89c833548321b08c3187c69f6",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:88ccfc401fd1fbfa3b17ae7c6695a8117680a6867a9066d35658e1552710c884",
      "source_sha256": "496045461ed0644be574798e2b099bdcfa1b675181020e3db333bee090eeffbe",
      "translation": "我当然明白各位的想法。不过，反哨兵部队有足够的力量对付哨兵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cd9914fdd5e37715bae53a0e0d1ae9b4164146f955e29aefbe705fc629db7c73",
      "source_sha256": "c66b6ca6133a0a6d2f0ad4bf57a5f636862bea2d5e9d02281a3093a9a073ecb2",
      "translation": "这样还不够吗？为了制造兵器而杀害人民，这种事绝不能发生。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b0c07cc12ddcff6a311080527ccf78827b05b932e5e8c1160de951e13a37ee1",
      "source_sha256": "1863611c5c6e5447b3300380c3338634aac6c2407a6b0ac636e741ad7121563f",
      "translation": "但有了哨兵，战局确实会对我们大为有利。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c86e4dce7e337942ce443e9a98330e2bb118c90fa40e109cd3c7911eab686aa7",
      "source_sha256": "1f6fe757904150682a15aa8839f675dfd00775b37b2709155bd89ada95fa5fe4",
      "translation": "即使因此付出一些牺牲，只要最终能尽早结束战争，不也是为了国民吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55bbf39d49f6185f1943d8f4a00f4b26967fd004f604f1783362342f3e7cef2d",
      "source_sha256": "13160757255cefda1bf7a003219ac3d3252fdd8cbf99b30b39683c15df8a30b6",
      "translation": "可国民要是知道了这件事，就不会原谅王室。再怎么隐瞒，迟早都会曝光。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:35186fd990226444ddbfcffbf7e86603ac5fbae7ab79aa211a66034435e08efd",
      "source_sha256": "f92d8344e0fd52507aef6bc6bf9544bfc57195ce125f81c731f67cbfd74c66ce",
      "translation": "那也是战争结束之后的事了。到时候，也可以处理掉相关人员，让他们闭嘴。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a21e676f1ab612de13530f1aaa728a6526f52720b10f9ef04c9f981795ef8a0f",
      "source_sha256": "955555ae1c9c90251e6d4b36891b45e78a462d4dfbd2426b2e365e97a8da89ed",
      "translation": "……您的话，未免太过分了。"
    },
    {
      "id": "coalesced:12d19224702c4e5ab22f5936a1a1735b8a7282d45ac72050f7b301f9202c7982",
      "source_sha256": "7955ba68b7f709beae7aee74cf629e07be5ede5112895dc0995b7aa643acb8c2",
      "translation": "我也赞同公主殿下。我们是为了保护国民而战，不能把国民当成工具。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc76f85417234b188eee3c1a1b78d55a164d13b625df5d54eaaa5b14297498bf",
      "source_sha256": "e1c5f727255f06a76ecd29c73ed92ac2f2fd0750b8cca2f6b2f3a9f672cb73f3",
      "translation": "亚历克斯大人，现在可是在打仗。比起正义，胜利不是更重要吗？战争中还要追求大义，哪有那种余裕？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f6035a0a9956ae297d7c025bfc2d3194fea0b8926ddfa9ed4675183a80c243b",
      "source_sha256": "a3e050f86fd5a38b2c38145a67862513ffa12940678cb85c0ac99287ed3f7b25",
      "translation": "当然，若我军陷入严重劣势，我也会冷静地考虑制造哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0834ae4c9b044863d287687607055be0937e5023cf4e0278f72cd99b00de7a7b",
      "source_sha256": "8461438b81259481686bf92300c14a82fa4f45b2be14d63aa9b3f3766213c9a8",
      "translation": "但现在，我们连杜南丘陵都已占领，形势比过去更有利，并没有落入下风。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a9bb710f412d862dde7befb9603bdff838a66e4b0b5e3cd4d884f02f7de827c",
      "source_sha256": "6092a102eb4891e75f925ba720ae457deee20ba3393373139b54db3c4a403db3",
      "translation": "是否制造哨兵，等观察今后的战局再作判断，也不迟吧？各位意下如何？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9061eda9c869fac9b941cd5fc474c5af582ac54cacd963324245bfd342ab9b71",
      "source_sha256": "095a576a3d9b19f4b63fb2ee2cdd11a31095a95b7d471e553d9868a9ef702eb6",
      "translation": "如此悠闲，可不像亚历克斯大人的作风。"
    },
    {
      "id": "coalesced:8536c494f245f6058b93ff675a1c00d8af5a07401a9ed82ecc2e3221a092f5f0",
      "source_sha256": "d5bcddc772fdbe492afc9910cf41c0d263ff5c8b6c416d2e0c3b65ab599a97c8",
      "translation": "不过，请各位仔细想想。"
    },
    {
      "id": "coalesced:a3e32dfd004d28c78d49e09f60f8afdc0d4b769d26890db100478d91335134ad",
      "source_sha256": "c49bff33b7f9461c55ee3732b5e49fadafd97d8e5e963306606cef2080e2a954",
      "translation": "哨兵是模仿一千年前的守护者制造出来的，这件事早已广为人知。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:90ea53486577af18e1a92d051a3d3ea2f2bfc01247bfee89633efa934c8e8ea7",
      "source_sha256": "fc9726e8e09d6da5b151ceb1abf8baf2c5b2d3baa0762bf1cef490a986129a59",
      "translation": "也就是说，过去的守护者，恐怕也是这样制造出来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f86be26753d38a623ca0479bd8c1997d8c2a233904876015dc61f758a3f2d896",
      "source_sha256": "987f3fe4a453f73c86fe9a2edc805a5dface5d8daf6dbf621b3b65a9cc04075f",
      "translation": "那么，守护者也是人类与怪物的合成体？难道斯特拉斯大人，竟然会用这种方法制造守护者……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5d758a9d96873433b1b0c9b50b0f207d4e2e350ae1610200002881fa4ecd07f",
      "source_sha256": "c22d83ff04f2562c0fefae52c5a34ad416fa06103eeb1feaa6abcb24777c7958",
      "translation": "可我亲眼见过的守护者，外形也是来历不明的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dff8010e45971d2a3b5ddc24deee14f5f1d94240ca9cff62783120fed0b888ac",
      "source_sha256": "49a3964d93a45dcb068170bf2d6c54fda0948fda88a82cd7658558f4b29963c2",
      "translation": "卡尔塔大战时的情况，比现在更加惨烈。即使是英雄，也不可能完全没有过极端的想法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3aaee2168d84f4ee3115cbe57d8a0890eb2643e41652158856d60bba954c1d73",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:7bd9158bc4fbfcdc6c4faca1d343516d4c5b51362987b15a8d24b2d71bb0beb4",
      "source_sha256": "0539f8fc17e72b131a555ad2f3d14b5dbf94785d60c721fda945a6bbca21e095",
      "translation": "我认为，哨兵这件事，还是就此搁置比较好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9516275f3e55527320b6ecd77b41133f8bdce20fddbcd2fdab6ebbdaea1862a8",
      "source_sha256": "37779f02d8bff6b6f6ef265d5feac3cd0cac0f46340dc981b61836404b9ddab0",
      "translation": "稍有不慎，就可能引发足以动摇整个王室根基的问题。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08fac22b0c236a40c2076d8216c0fdfcccebcc4db5aef0c9e0e4bf202b3d4759",
      "source_sha256": "690f6df835683a3dc47c1dbdcac400b200179e3160218ea1ec065e3b792093b2",
      "translation": "唔……看来，必须小心，不能让关于哨兵的事实在军中传开。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f331976bddb320f0b87ad43f0be0177bf1fd7fea8f1c9287c8e9b0e4e892788",
      "source_sha256": "c1d2b5a7a5ca3a924e2141fa8d8fb7a54500ef83947420cf8d83ea17b4ea2b68",
      "translation": "王室一旦崩溃，这场战争的大义也就不复存在了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:57108a140cafbacf0594bba60b6576d901910521ec0d7810f2ce842109ea1769",
      "source_sha256": "20cb261da3a36086fcb84b181a94578378f956d98cc1265883247a6d823213f3",
      "translation": "修恩扎伊特那个人，已经不只是厉害，甚至让人感到恐惧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba583a2b1423282505a2ba424aef7b181b7e12ef077930fcdcd3ca1dafcdce53",
      "source_sha256": "789c8f7b647a141f2fadbc44cfe23145cc4894b2072fd3882d6ba39c266afd5b",
      "translation": "关于守护者的古代记载，应该几乎都已失传……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:418b7a81926674ad773d0d6c86187ba80f8fe7cec7837da85b3ff482c34bf527",
      "source_sha256": "a9749f196f3e621af424cd7ff5efe468cd9937c87d380945b49bbbbdaf7186fa",
      "translation": "他到底是怎么找出制造哨兵的方法的？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bea12370025198085a764080d4034a7b3e0fbf64d4cded5110e37469358850cb",
      "source_sha256": "25e118ca32ba78a0f6fcd706f786f06f602ed272eff695598e22400727dd4e17",
      "translation": "我也很疑惑。等战争结束，应该就会知道了吧……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:56c5d786f88597076bf1ab9187862a50ea63c400177b71f8210d573d8b7a8052",
      "source_sha256": "1157e20978024f733422da5f058448065ba730a54e88b55a11993d35de16d9e8",
      "translation": "这就是我收到的信。"
    },
    {
      "id": "coalesced:7ca6170b9576f11c950d9601ee8f2c82aeb504abfcdf4fc3a6d208b1d140690d",
      "source_sha256": "87a5fc6b140d9534a23d6cf67159ad1973a0a8a8eab8c453cd0f1f227c40d874",
      "translation": "知道了，你退下吧。"
    },
    {
      "id": "coalesced:eee5c1b4f4a8228cc4a37eeb3b73b5c4d95bf4307dd21196d1441dbeb0f71c9f",
      "source_sha256": "52eb431f8c2833c5f19a05123880b927ac15b3e30a53a6935289547d4b5cea68",
      "translation": "……是让我暂时继续维持现状吗？"
    },
    {
      "id": "coalesced:d720c53fd3dc109518975db2b5e5d96bd09a9a875a1138187c2995645451a8a2",
      "source_sha256": "b5e92cb76badd1a8965984f714141e5d61719e843683de05ce43bebea75b33f2",
      "translation": "到底有什么打算？"
    },
    {
      "id": "coalesced:2ed7f4378e3c93a99c67f8a0506b4e2da533f189dcf7680a4076433919c23ade",
      "source_sha256": "a8eed1cb5f222eec782772ee8611dd76ef230518ac50d7acdefe769506742e54",
      "translation": "算了，这也不是我该操心的事。我只要让这场战争按计划进行下去就够了……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad2ef8e45c521c6d9eb0facf71e73cd4497139663cd0649f92cccab9a8e1822e",
      "source_sha256": "1666fee06efa28f7dedb7df7f730f97bf8d95ceffc9a0c90b5ce4b18bffbd89b",
      "translation": "啊！您难道就是去过柯塔马雷的那位？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d30fabd6e12a017ca80f4ecfbe6663a259c77f753a7d1971aae87ebf3442eac",
      "source_sha256": "bae82e7e5d85d3ee710ac20659dc61231744c4bbe20958c97fbc118f4806b3e4",
      "translation": "柯塔马雷怎么样？那里真的全是美男子吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2938e4cce1c97bad138c4bea251112891c560da69fb31a396647c58ff1fd690b",
      "source_sha256": "247849dbf34712e5fe2fed05e3df41da4d96bb8a5719a94e032cd3814e6eebaa",
      "translation": "听了你的话，我又报名加入南部军了。过不了多久，就要上战场了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:454865d6a60e24b0a13ecd19b7a66c6aa662534be894202994155e0e3cc18e69",
      "source_sha256": "378e3fe11fd1fb2d30e957284a170ca379e1e91e96750ae594edc0014c62b68b",
      "translation": "嗯……保重身体，别逞强。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ce46cf5be0259310b4e3599d8249b64b60a9614a6e22bc5ed76bffacfd92918",
      "source_sha256": "e4e6a150f4ff89bba089a7dfb6ef7eaf35638cb719c58925e498007947adf034",
      "translation": "我一定会活下来，赚一大笔钱回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f23acf79a26c176a1a44fb3c50c8fecccd8ea335f59d0d9a19631bfbfeb76718",
      "source_sha256": "6a260c1c45c3b4e7a6813083fb5353408b24a420df4cf491bd03489aac94013d",
      "translation": "一定要平安回来。别死啊，呜呜……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:813dc217e58d67a9ca47f573cc4c35d3736b928419fff8617f0ada10c1485b60",
      "source_sha256": "d1c3efe675bafe12eabf06f03fabc6d3f6ab5169d42cdadd2d47b67f18de8a2e",
      "translation": "南部军总算发挥出真正的实力了。太好了！一切都和我预料的一样！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:439b3030325fa29626424b3634d02f772512a3d69a0f7d4ddb9580339efd4fbd",
      "source_sha256": "b0839b7e2fbeaca10daf03e96e28ddc4c0658c243320ec751dceba729e6c7cfa",
      "translation": "这场战争，到底还要持续到什么时候啊……"
    },
    {
      "id": "coalesced:d3ef3b18ea3acc4140892c3093397a223c9e6cb7c7b3e38287a235bf525b08ec",
      "source_sha256": "5b23cc916b35d73cd96ca655ca384b42624893c877acec78ee185d32bb671ad4",
      "translation": "战争让大家都难以糊口，可工作也不好找。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76ec6cfe47ba9251d8ce17b509893905620e837d7c4f89296edea3e9a05b7ee5",
      "source_sha256": "4434121e04013b0f76fef205dfdac4f1fb833780de7dc484742b595e62ada183",
      "translation": "所以，每天能做的，也就只有这样看看附近的风景。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:af8212401f51c8c150f4540e012b3d7667fbf0db37f40dde6470a5064de5a6ca",
      "source_sha256": "960d9a67b1ab9e4cb2ccbcaa3bff212e71ed17ba19d624f70ad7f32b637557fb",
      "translation": "如今这世道，大家都不容易。越是这种时候，越得打起精神。嘻嘻呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e005f8d42ab3eaccceb198bb022e84a5e5f6acc29f70fce843b0edf2920d08e1",
      "source_sha256": "4d225f56d8061be1601474550b58f79ad3e4e618b5fda396f71b0f99d0bc4f64",
      "translation": "听说南部军打了胜仗，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8eb92fcf709a6397251066d5877e39b7861afa98893b8dd7e8dece73a37f6fc8",
      "source_sha256": "a95819677232f0aa5dea8ddbddc9a194acdc56c99dd7780b03c8b74d961b3ff7",
      "translation": "应该很快就能再去贝尔福特了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:856cb58fbe6d06fa854fd2d4d34f6e2a68340361b059fcfcf4a81223447d2b98",
      "source_sha256": "23046254cf301116f3a2990dd4ae9204658ed5caa366fe07d5498932f70612b7",
      "translation": "听说您去过柯塔马雷？"
    },
    {
      "id": "coalesced:d5b744568324b5db7d5d05ad34a2dd97a2241d93a32db87646324d173edcb633",
      "source_sha256": "9d1e8773973ead5456f4cfc6df22d52d3db1be8d5442a2543be9bc19da73baed",
      "translation": "真好啊～"
    },
    {
      "id": "coalesced:82414ba400045574bf93e0ecab4b6e1203b2f98410adc2b56007ff0338136d07",
      "source_sha256": "afc9a9a84d360a61be183dd00330821f67030a3ba0b582b36ba60561ceb3c7b1",
      "translation": "你知道吗？兰兹海姆各地都有猫猫。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3a0a5f60eb83c99ab720a6eaadcb168fe9b58b3ad9497f7d8a5d8e9b4380a1c",
      "source_sha256": "6c76d50957faa3ce3b278f320db7da0bb3c02eba84b9a8d4fb95ce47766bdbc9",
      "translation": "我还一直以为，只有阿巴泽特港口才有呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e90ce62cda0f5df0e17e82fdd177b18c7db0bfc2780f00fe8294a89542a8105a",
      "source_sha256": "9cba922aeb852951ad5621bfaf5ae562aae1277125fb61f03e7fe4164915fd22",
      "translation": "得尽快夺回杜南丘陵。"
    },
    {
      "id": "coalesced:c00eb4ea768769d2e05e84f74f9ad2e43c9c043cd249d540bf3826aad9167334",
      "source_sha256": "0a0e3a9aac2d623c605a6a2d36809ae1f516d16c4d49fbebad01fe20274160eb",
      "translation": "杜南丘陵顶端有座黑刃要塞，听说北部军在那里谋划着什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9a04d057da952d5ab8ed5668514b602391348e69ab41cbfd76efad7829d2327",
      "source_sha256": "73e659dfdfd88568a56263d7ce271b82706a033f49a808e904d61dd6283469db",
      "translation": "每一天都像在地狱里。"
    },
    {
      "id": "coalesced:8873120bf995e4322da932fd6ad7af344fd76e01d2a3490c81bb4b3c6ae53b70",
      "source_sha256": "45a62efc084357a5cd4b620ed01a544db35a9ee77e2ce2039a51b92b3e6488f5",
      "translation": "每天早上睁开眼，都希望这一切只是一场梦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27620512fab4ef6fd55c41d1515bfa64316407b1a8f71ac9ac11a4a451236304",
      "source_sha256": "1f7274ca2741f438dc66010376c13db3b54adfb8bc2fcc1615a25dcec7066061",
      "translation": "我在古书上读到过。听说人类很喜欢战争，是吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dece3cf12570a187a54c02732ffb31f7b8da2a186e8cbf941db95f1ab2fb4b6a",
      "source_sha256": "d151ea73743c8eebe8d40b248bca62f1937c97072173308aee58f786b9d0f9e7",
      "translation": "据说每隔一段时间，就会再打一场，难道不是这样？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e3b3fe677f7f544c69a3e061072f6fac955646a7a890a02fd59ecbec3c1c200",
      "source_sha256": "13c9faccb6f36341b4930484497d0f9903b96f6e96e3f842edbe4350aef2963e",
      "translation": "都说了，我们不是鸟，是阿维斯族。您这么快就忘了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a665ba4f62eded2091039a90aebe3b95467fe604e276494ba686a084cc6e278",
      "source_sha256": "67dd930457f4436fe88cab54ca41439f9f962b36d1493bb22ac3e091d0c49870",
      "translation": "灾祸种要是再这样不断降临，连环术就会用不了，庄稼也长不好……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f632cfbe798d0c6dca0c27ed08597ce32b996cd80a1c2839580476efa50c767",
      "source_sha256": "793df58d5d897525f9367f228da8409cb6565039b7a43a2dfceac8cf4d37ff76",
      "translation": "不知道世界会不会就此毁灭。反正我也到了快入土的年纪……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2783537b39a1224894ec041b2c7d452041909bb124b1aa52fc7398dac8acee84",
      "source_sha256": "2594d31cfc36e3d0cd18b50cedd5eee37c583333e3dfc85df63a19c5e7df3c9d",
      "translation": "难民越来越多了。看来，除了阿巴泽特，已经没有地方能住了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:716b4e8834acd86ab7237d3a58394d05f8cb22c5952f1951af86832e55c34d0a",
      "source_sha256": "32f2d4dcf026cb8dfab14ff89f7eed1a82972647f93eff74d9cef21edb77fb53",
      "translation": "真想回故乡去啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17874694588b469258949faa909e6d339689af557c7db7bcc2f63865ca5fd61a",
      "source_sha256": "c83efb04bbae4f82b1af191062fb12418a3078735b0e38978f4f09ec6949c749",
      "translation": "可是，港口还封着呢。嘻嘻呵——",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc9bc87c42e1f3ce405b3a624765dceec458dc853f552c29e156c3031c3ac122",
      "source_sha256": "b7b4d625fdd33b8bf836f3456989d6798879ed7f8f8fe7160394f83fc00a54a7",
      "translation": "这里是公会联盟。"
    },
    {
      "id": "coalesced:b8da5b8b26713fb3113fadacc0bb4f46a88b34b17356c29089e370552e0c3a4a",
      "source_sha256": "df6c61438755f8834e1c65862e145a042a83311e61e72b2886c9b7a07e0275a0",
      "translation": "呜呜，我丈夫被拉提族……"
    },
    {
      "id": "coalesced:2b5e325bc3220b2807b521940fea9c19672df97d54cfa7366cfaff79258c6975",
      "source_sha256": "f558583265d2423fa432abfdb1214e3609cf289df453a8f944006c3bd57deb72",
      "translation": "不只是我的丈夫，还有很多人，都死在了拉提族手里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5d7c1bd0d011223aaae83ed2ab2dc46e2350e6c7dafc6fed06c237ad1a12123",
      "source_sha256": "df19dc18bf19b273d5d407cbfad306ebc59677d72f58de496f079ba04f6c33a0",
      "translation": "我一直在找向拉提族复仇的方法，后来听说，有位生物学家正在研究拉提族。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cee0d4fef932ab4a9fdb32c7e314424a4a3d4ec30a0f67c49312fe4cc829de87",
      "source_sha256": "e02d41552f66b8055b33a21d6d0486588d5a662f6f7574ccaca19d21c57cf4cb",
      "translation": "所以，我打算去问问他，该怎么对付拉提族，然后亲自去报仇。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd6705d169368987f2f2b5304ec51305b9ffc039db25ea353c6dc91ba093eaac",
      "source_sha256": "2445ca9315213f64dd94d7605ec7a0caeedc289a1f17014994232d1b50a69e83",
      "translation": "各位愿意替我讨伐拉提族？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c9de06bb60b5f927dc7ab52bd517dac75bbfd270cd6814bbb5301b21eb6f7f9",
      "source_sha256": "932cbe43dbc879910b8a470462bc9a43f954c025093a721102e61cbcfbfb5783",
      "translation": "谢谢你们肯挺身而出，真的非常感谢。"
    },
    {
      "id": "coalesced:fc2642649758ac28c046d727c1f85800b112d6af0ee6c2b83f521d0e51efb8b8",
      "source_sha256": "2e2e0db878f00976a29cd4f733a9dce5c2787b83d20321bfbd075b09343cf589",
      "translation": "请各位一定要讨伐拉提族，替我，也替那些受害的人报仇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:021d01389cc001d629e29b18ce4d73f2577a93967c122cd5945a5699491bc824",
      "source_sha256": "2239324f38ad2d2c3affb2575bbfc5527b10be99b22cfae6a087255912450927",
      "translation": "虽然我没有什么力量，但无论如何，我都会向拉提族报仇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4329287d336781f23feece6c4ca44fc6019f05eb161f8497cd1f0c9ef79c1aa9",
      "source_sha256": "cedf31b660e8d967ae080e60e3df5b6fa82cf3d62411f15a0877be656b70caab",
      "translation": "请去见见住在阿巴泽特的生物学家。"
    },
    {
      "id": "coalesced:2d6975bdc6dbc322e73e82b623c58743b5dd5710bd4efc2ea46bd63e9b47fd2e",
      "source_sha256": "320eb9e76bab46d0962d62b8b0c8402bcf4c316a2468472b505fb6d8d9d7fb27",
      "translation": "为了讨伐拉提族，需要去拜访\\n正在研究拉提族的[生物学家]"
    },
    {
      "id": "coalesced:4aa43213154f82e1b0a9874b7078211a27d75b32495e06dd4b1e57790f65587d",
      "source_sha256": "88beaf69dfc6459b887cc54766637f15c1aa243ad93b78593266c7e6245e2f31",
      "translation": "黛芭的请求"
    },
    {
      "id": "coalesced:e2b1cda147bc05b55e6a02ad520746f5adff63232499ab54bd62d661c0612eb2",
      "source_sha256": "db4b2a04feae7bb0da57ad47abd418b9bc810ed5fe7c554975a671f86920a05f",
      "translation": "拉提族的秘密"
    },
    {
      "id": "coalesced:116929f9a26d36012601a1cce330411a0734c66611d62d448a736bd04a7ae1df",
      "source_sha256": "55a5f5739e7456f3aeae0dddb5b563ceef95d3179c5b3270c368d0ae69334507",
      "translation": "请找到生物学家的儿子[阿尔斯]，取回古文书\\n阿尔斯是出征杜南丘陵的南部军士兵"
    },
    {
      "id": "coalesced:fb1967c73f56127f2bf6531426eea9b5713e6447ebc0f39cfaca3f5c87fcee8b",
      "source_sha256": "e295a55639aef3a647f7bde41868c4f2a93144da658b8895d23605b78da3d7d7",
      "translation": "拉提族是杂食性的种族，以女王为中心，群居生活。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:952f2006be0bdec57e3282a67b28f4ea3b101e0436a3649cd947b5018af77a20",
      "source_sha256": "38dd7086926bb7a117ea1a8e863fec284d5927b42fa38d82088fab30281021bd",
      "translation": "原本，拉提族藏身在人烟罕至的洞窟里，所以很少被人类发现。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38be1fb8010fdb339d3b79f538b2d6287ba9623e9c3732dcd6dff472e95e5c03",
      "source_sha256": "a1b7035297f776211f03f01417bfe699d8eba547e82ee935ec6972f3158d7f63",
      "translation": "但战争长期持续，大量人类尸体被遗弃在战场上，成了拉提族的食物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:916f0f4ea8f2c954f02400b0de868c092e0ee1800aa127835e196bbad82df834",
      "source_sha256": "695d0213bca1d7e8eb22726faa8e39f25b407647a5f2a11101539c4e83f1e7fe",
      "translation": "因战争而有了大量人类尸体作为食物，他们开始以惊人的速度繁殖。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2bee4ccb8773d9f9fa5facf8fb10a3bf70f3c858e79e6fb6b545579be0983287",
      "source_sha256": "e83f01cd9ba15d6f36da45d0748ace585bc85c55c729da91f4ba286144b9251f",
      "translation": "最后，终于开始大举袭击人类。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:23c08a9b92a93d890201c3ea5d54a23e8c2bd2cec720f868f99b8befabb28038",
      "source_sha256": "5b2b61739eff67c69996479dedb11be95ae5e946c41960b77d1690e432cfe974",
      "translation": "事态比想象中严重得多。"
    },
    {
      "id": "coalesced:a91bf9d3517a2104b27ba1eec31ddab6c9387745bf622c4e409499c9e3628d1f",
      "source_sha256": "514fb1b0b432cf91e1a3fc64fdd439b308d32d85e5eea504aa740ae4291ab40d",
      "translation": "不过，最近我找到了打破这种局面的方法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d77d1933a5b26f6a8592b0ce8300374259b7cc60921d9508d532b99c9291ab7f",
      "source_sha256": "8648e26696003af2c17295107bba45d5cc3694d087ff3150910f2d83d9bd713c",
      "translation": "我偶然在一份古文书上看到，用一种叫[九节草]的植物，可以制成消灭拉提族卵的致命毒药。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e4f057746bd5bb2659e66fb3c13564116dbc20f60b9a96b2d07c4a1af3049a2",
      "source_sha256": "ad66c5280d54cfc4e85301ad83cf32837ad89f3f665480bcd1100b0070c3e63b",
      "translation": "只要使用这种药，就能大幅抑制拉提族的繁殖。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9b194a955a9c55c45374240c17940f654d7587d65fed885100ed791fd3b2298",
      "source_sha256": "6f5f58571df69fda5f94431f40fb08b21b2a64a12230f03acf8aa586df6c834f",
      "translation": "可是，那份文书，现在被我儿子带出去了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b994c875e6cbc7bc7becff1a21883f857c86e9a9da8a0fcc4137358dae47aa2",
      "source_sha256": "c6840017324b6110585bdc8da05046f02d9cf619808b368797545d5a9b80f075",
      "translation": "偏偏我儿子正作为南部军的一员，出征杜南丘陵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b2d277b11629f7ce1ce5531f98a971978127d4c98b1634cc34a5e3b69d1c39b",
      "source_sha256": "45743d0e91b50cfd2c917b8a621359b25b76d7970b2058659ac26e9759dc368e",
      "translation": "他平时就对解读古文书很感兴趣。出征时带走的书里，好像也有那份文书。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:066d96314801476f001a5b7df5b79bc11445c8b9112c29bb00b984f84ce0cff4",
      "source_sha256": "d3b538ce65d82f753483cd83d1c593fa497f4ce39aae5df5d19442e24d732574",
      "translation": "去杜南丘陵，找[阿尔斯]吧。"
    },
    {
      "id": "coalesced:e5bcad9feb8076f1f73112db9517fd965049308eebb66c06689973cd7f1c9b22",
      "source_sha256": "88e1fb198c82b71ed7bc1655efb47e7c5c8de8bc1fc8130d9e4e2b02d07a7080",
      "translation": "拉提族的威胁，已经不能再视而不见了。这关系到居民的生存。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:253f5b01a7607569b1d9dc9fcf0bd7cdd7960e7be6d4a0182aa90a1a85e89bda",
      "source_sha256": "fb9ece811e2cb7bc059e908b83ef175d8c5454fac8ffbbf491ec373b7cfb98cd",
      "translation": "去杜南丘陵，找[阿尔斯]吧。"
    },
    {
      "id": "coalesced:bf9cf81c8b75c2576209ba2050fb225cd6af443b8c01185041873781c537f1a5",
      "source_sha256": "b827f8d28aa554600b4dca43961af7ff9bfecbb403683f3992741e4ba3696c09",
      "translation": "请问，你认识一位叫阿尔斯的士兵吗？"
    },
    {
      "id": "coalesced:fe470a474be413c0588fb99d801decebf7edbd6215400eb3687288e3ec013e63",
      "source_sha256": "dd5114e2abbaa652b3eb46895800227bbb24cf96861687fa74c24aed70664874",
      "translation": "寻找九节草"
    },
    {
      "id": "coalesced:2e9d87b741cd8af279e4f79e1a13efa75fcb4ba25c93d82d378ceffaba0bb9c5",
      "source_sha256": "780044ed45f024b5ef964b830aee69ed4ee6880c6c55786562907e6e6ec1ffa9",
      "translation": "请前往公会联盟，领取[九节草] "
    },
    {
      "id": "coalesced:216daeaef0033ffab076697c6b89363f268d11905c59f580b45ec720c939a7b2",
      "source_sha256": "0c8356dfd2d12860fc66e6175d2c08387ff4fc11f6df7267030b3b94b9981ec6",
      "translation": "啊，你们回来了。"
    },
    {
      "id": "coalesced:e63345a0a66a0c3bfd410279aa4a5c4085ee76cb370eda2e813954211d94e623",
      "source_sha256": "acd18af6f130a954ad9e8527229be97dc5f4545273ac9e35f3c0d0847e416394",
      "translation": "接下来，只要备好九节草，就能制药了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91c61dc5774e8ded0a75a4e3c904ec136d475a1bbbadfc8116b98798ad34aaff",
      "source_sha256": "33daf37bf73f8d721a0dd18b78eed14475b145f3dd7f01c870fa40a80988e361",
      "translation": "我已经向公会联盟订购了九节草，但现在还没送到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76e454fd93d1c6455827e54cf5f3640a266edb646b2d3c8e8461e121eb195796",
      "source_sha256": "a852cad172451f5fde55e999b9a9b014f1ff31d8b0ef32730421e2076646b883",
      "translation": "方便的话，能替我去联盟取回来吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fda940925e21623d3f3aec1674afed3eec9d16c2bd3bd139f3443a4b8b7bbe67",
      "source_sha256": "672fa31a160d4a6a12827dfe27aaad0cfaf2c8da8ea078b7bd19e5bdfdc13460",
      "translation": "能去公会联盟，替我把九节草领回来吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:af7ea11244a31955fea151793f4960ee85ccb7643a892df1c4a9dec5b85010c3",
      "source_sha256": "7a36d7bc11da99107493faa32f97e71a1005de8224b5ee447bcdb2538ccea26e",
      "translation": "要是还有更重要的事，我可以等。"
    },
    {
      "id": "coalesced:dac4e9e55f329081013e0d0db380b86634cf99c9e9ef3e3e3797340721356055",
      "source_sha256": "672fa31a160d4a6a12827dfe27aaad0cfaf2c8da8ea078b7bd19e5bdfdc13460",
      "translation": "能去公会联盟，替我把九节草领回来吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38df874d5fa7def3adee44d546fd8f4166028db9170df91773e37e2cd46a7842",
      "source_sha256": "3593b78eea54f4b853a3f2fa3ddf56dc9c78565f33e910aba4e0cfc5d6009095",
      "translation": "玛莉丝"
    },
    {
      "id": "coalesced:861ae0180945a3e01ef631ec80aab5ef7e511b870c7739c7bf084eaee4991bd2",
      "source_sha256": "65b6f47558288cc692ad31162446dd784607d9eabd9d112f8334a010f2e0d51e",
      "translation": "黛芭"
    },
    {
      "id": "coalesced:84892a148d6fcee79df21af00bd90203ae3c36965c0a29170ff5f11e4874e574",
      "source_sha256": "6ed2f64e4aecff27c4691d9bf5fe72d94b79c23713e529601376de29ebb70025",
      "translation": "九节草 "
    }
  ]
}
