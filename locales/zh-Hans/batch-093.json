{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:f00bc90bd0b547ee4d1cce32bf0da1abc5f8667e9fceaa4f3a267d6684be4d36",
      "source_sha256": "71d858435ff56d848e09e308993d236c6fccfb5d6fa0078dd0d3b09093ab558a",
      "translation": "能听我一个请求吗，喵？"
    },
    {
      "id": "coalesced:f85514ffdb284dc5208dca9c6ea1785334941c8396bff3c90fd2675061368465",
      "source_sha256": "57eaa7a867c250dfec5b048dec34dd6fde27490b6291d842c8188f74e0446c90",
      "translation": "得把[卡蒙德碎片]，送到阿巴泽特的猫猫村去，可现在还差一些喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7e7edf463057daab5ccede687f78a2cdce095fb5dba292f7380cc43e6ed0564",
      "source_sha256": "d4ce658a436b9325c7fca1f1bb4a50dd5ba14a8dcb1a84a4fd7fa079a5bcf698",
      "translation": "还得再收集一些卡蒙德碎片喵。"
    },
    {
      "id": "coalesced:a620a5e4cad8209e3ec3158174ad1694f3ec2cc4befb848fa1287279f08e03ad",
      "source_sha256": "1f5d65c8aeaa93c4111ed5e7ce086c894bab59358c2c6df33b8633e7a308cfcd",
      "translation": "能帮忙收集一下吗，喵？"
    },
    {
      "id": "coalesced:7fa6672b2ae5548f8e57e4eac680581195ad6359e8457159b74c5a7ee660a24d",
      "source_sha256": "2d76533819cdd805af9564e8a1eeab8609403a666c09cb9d765a5acbf3a49777",
      "translation": "谢谢喵。"
    },
    {
      "id": "coalesced:4b651d0f3c4ce1fa66bb85bbe4ba6e6f14a23e9602160abe1084243d62adfeac",
      "source_sha256": "ad9e718520f3b66809a45ce5325ce4da208d5f76880fd49431ec4e3e971b6e24",
      "translation": "卡蒙德碎片，应该能从这附近，所有的怪物身上得到喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40b22f3cd8fa935225e4056ea5fdb3a2da29a635a7481d2807b04f8d987db6a2",
      "source_sha256": "43d28005fa6ec590a45b910f491f3951eb76ac23a1facb7c2f63c1d5957e484d",
      "translation": "只要收集8个就行喵。"
    },
    {
      "id": "coalesced:bd4f621227e6391329e503489251ff261acbf7b03b9e07649b17b06168fed5ed",
      "source_sha256": "59ee2dfcd928c2c4165a916fb178eab6da670a127eca4fb86484cab09d5f9377",
      "translation": "不行吗，喵……"
    },
    {
      "id": "coalesced:25ff96ddc79918d671e1531569a5a2e1d916d5b00f0236378d1e8f1df9a5c16f",
      "source_sha256": "ad9e718520f3b66809a45ce5325ce4da208d5f76880fd49431ec4e3e971b6e24",
      "translation": "卡蒙德碎片，应该能从这附近，所有的怪物身上得到喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcc41f866033232f392b4eb9579973a246f150b69c013d1775cbce2a10d53262",
      "source_sha256": "2ed0d862ac4f88f3fee7e163db78f74954fb22310b7a0a06a91d5b9c2878adf9",
      "translation": "谢谢喵。这下，就能送到阿巴泽特港了喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:494afea338ee17da797376712a8081a3157594cde0f744529c8c2ceb14c30e59",
      "source_sha256": "d5eaf6b8682f8e50a539f5126d543a0389b8e149d1bcc2902127a953969dd1b9",
      "translation": "猫猫族的村子，就在阿巴泽特港附近喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f8a07a0149545a3e2e9cad749f0e29a0b4281568d7204ed9bd9022d915660d2",
      "source_sha256": "f793752e1d9b12c83facd3baa34a5b517819cd005c91d17834ae078b6a6d3142",
      "translation": "你问，卡蒙德碎片有什么用，喵？"
    },
    {
      "id": "coalesced:f9847abff13edf559ec0c9f8f36b73a72587b6c7d35e71ddd496b856a7914161",
      "source_sha256": "192b67b2178cf36473f60302f0b8da1261256474c1f0d95a36d5d1e455cd0fb5",
      "translation": "你不知道吗，喵？我们猫猫族做的炸弹里，都装着卡蒙德碎片喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e24f9abebbb4efbcd8aa9a4767886cedb0548767c07c808555ded11b309587ad",
      "source_sha256": "3826603c8fcda8b99fe7a6693a158c438f616f4238e168a44df4ac1799083311",
      "translation": "这样，就能做出更厉害的炸弹喵。 ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:99fbd1fe5f6c0b87db158a1477e9a099224333154dcaa86bc29b4481aef5759b",
      "source_sha256": "da2d59c07f4cdea46c82db1623954959b7716dd589700791b98297b31b9c0593",
      "translation": "从水色湿地的怪物身上，收集8个[卡蒙德碎片]，\\n交给猫猫"
    },
    {
      "id": "coalesced:f40837ec18ba4b07681eb4c3499d9086c6053dc25544ba80330e7aad8c47f983",
      "source_sha256": "5cc3f64c9ea6ed5164be00ffe5394a650c644c37001f96bf68524155fc3865e4",
      "translation": "QUEST%s: 卡蒙德碎片 (%s / %s)"
    },
    {
      "id": "coalesced:3167e6e05e1a978fcc71d50cf70cf8ffac5ef9a06545113813b2417112c45947",
      "source_sha256": "c271fef8dfabf6f6368466d5b96ef450f5ee169d2882f7715956515487a461a5",
      "translation": "卡蒙德碎片"
    },
    {
      "id": "coalesced:5153b3bc1651f69ae04152cbeeb71549460f0e3cdceb6cb6ad41023df1ac0d5b",
      "source_sha256": "c271fef8dfabf6f6368466d5b96ef450f5ee169d2882f7715956515487a461a5",
      "translation": "卡蒙德碎片"
    },
    {
      "id": "coalesced:15070f67e36d0be49435b0669911c714c02cf60bf5f22b2589421016ed6b591a",
      "source_sha256": "98f67c38c2b667ae352a1c57c62d11b7aedacfa8b110fdb69af1724fadd90531",
      "translation": "还有一个请求喵。"
    },
    {
      "id": "coalesced:d3abd518ea84db3e50053aeeb574ab01cb6b4155969b3865f5cdf481c9ee55de",
      "source_sha256": "0b54f6c313189e4370beb48dc8032e8d65f71074c2ca76ad104ad1f7cc7334b7",
      "translation": "希望你们，把收集来的卡蒙德碎片，送到阿巴泽特港的猫猫村去喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a79b762c05f2aabdadfbd3361c73e887a13a3d700b08576d7ca10c0c67e4cac0",
      "source_sha256": "b02a0c122a5c82cc349827d6b5156fab6ddf7f0bb8bdeac5e75e5d8cf89bff34",
      "translation": "谢谢喵。原本，一直都拜托阿维斯商人，可最近，都没见到他喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d65440b07b44b7994390bde41344995cdd4aa70cffeeda5a02e0cda2a240df64",
      "source_sha256": "0151eb082a49d1bd9bb428e88adde18721c93f45ef1e131a787063366bbadefd",
      "translation": "那就拜托你们了喵。"
    },
    {
      "id": "coalesced:2d4f56cdd281c2d3d5e56812a89a671429ef2d0be14d2036a837caaf3bddf144",
      "source_sha256": "18bed4e9beb2c9dfa66fd2b08c494604ef0091a1a7314ca4e25c834600ca4e5b",
      "translation": "喵喵，那只好等阿维斯族的商人来了喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01918e843f8f4865d3f89133092530737aaee5a5e38376d02424b8c8ae350606",
      "source_sha256": "7000f85c916f941623cfa68c44a13b8705ae1b82fd9f9ab1c0714d49529789f2",
      "translation": "请把这些卡蒙德碎片，送到阿巴泽特港的猫猫村去喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a667aa1a0fb0c186b81d2b09eef6a5bb1b65288ae9dfc074baf74617a7e83d27",
      "source_sha256": "7666c5da190dd649b9ccb1b4f1bea0a1d064ee0602032e21925b70ff90d269b4",
      "translation": "哦～这不是卡蒙德碎片吗，喵？"
    },
    {
      "id": "coalesced:c249dfd7f4ae8c450268f17eebd4274b388cbd9bc6e56c121d6ad14ecca3b1ab",
      "source_sha256": "9dfd10107d448d4dcfec07f05b5f1c0df8e04e7a7dabf89494ada1f5293637cd",
      "translation": "怎么是你们，送来的喵？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d5cc0ce3413eb34f6393282885fd7e2c726a98e31dfa38e44b49a12e0bd4354e",
      "source_sha256": "b248bd18d072e93ca22eabe2036bda8de822d6255c8fbe410ad4ff5a54bcd993",
      "translation": "喵～原来，是湿地的猫猫村，送来的啊，喵？来的不是阿维斯族的商人，所以没认出来喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c346352d02b587ceee4683a044f2dd7b46b2792d6e5132f7b6827787291e1da8",
      "source_sha256": "2d76533819cdd805af9564e8a1eeab8609403a666c09cb9d765a5acbf3a49777",
      "translation": "谢谢喵。"
    },
    {
      "id": "coalesced:d772ed6b505905515c8545c303402e6e3a44f1ba16a05b372c41c803f865ebcc",
      "source_sha256": "7e0f1bde57169deeeb0e5c463e2d08382a4ea7e4a2a9f9935856d677bb58f28f",
      "translation": "南部军，都是好人喵。今后，我们猫猫族，也会协助南部军喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44a9a39078e1a34092ddeb52efb3ac26cbbd3bfca2abc925d64ed5c7af15631c",
      "source_sha256": "93e06c3dfad5d27dc80ba63d18eba3520ee1f5ebf2c54386ba86aaebe23e8290",
      "translation": "下次作战要用的炸弹，也交给我们保管吧，喵～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8028e4ad253a251af4ab2beb319307f02f5ae5dc2f054036395aa635e0ffb084",
      "source_sha256": "20a8d8a6d9c073a67da6e04798adfbc61eb0f0ee5795fec0f8f77bfe26a60354",
      "translation": "将湿地的猫猫交给你的[卡蒙德碎片包裹]，\\n送给阿巴泽特港的猫猫"
    },
    {
      "id": "coalesced:894547d28b7e62c8ed2d7bccfd9dd3d479898e98668fc5f36cf83845fa015a7f",
      "source_sha256": "100994351bb181f340597ef96eb596b52c0976e431cb6c9af71ed17d850f3890",
      "translation": "送往阿巴泽特"
    },
    {
      "id": "coalesced:71d9707b39d8f30e290fefb9d6b4b540642bfe9d3e9f107d7d12391d0eab0bbd",
      "source_sha256": "a917c784157e9a3a0b10477d9704a672074c46e73caf6cee804ce3e86f375b84",
      "translation": "卡蒙德碎片 "
    },
    {
      "id": "coalesced:e57a2913ca4b3d7216cb188c5b0656562b55c8c8ec1012bda9f5a6ed67213884",
      "source_sha256": "3293e0b8f28f862b38d162adee4baf6f413b86643b4089e4721cc6b1f6b0ffcc",
      "translation": "水色湿地的猫猫正在寻找的卡蒙德碎片"
    },
    {
      "id": "coalesced:12e11ed2831c12e9aa185391f0851837868f6cd38443767507edca0dfeed6b40",
      "source_sha256": "ab214cc4a50b3b0c884d78dfb057834b4a7efc3149bb31fb6baed2f250f9a4ed",
      "translation": "卡蒙德碎片包裹"
    },
    {
      "id": "coalesced:2e44a83521dea2ff53734c3b3dbcba92443af3d946ee489dbd71f272ec2b4557",
      "source_sha256": "e3a5d911bb34e8ddd6b3332e9b320a2aca61a413e05984ef5d4dd67df8b7539f",
      "translation": "装有受托运送的卡蒙德碎片的包裹"
    }
  ]
}
