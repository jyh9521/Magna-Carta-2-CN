{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:3d299e50298b02acaedbd068f02f96657a5f62a5865a54dee6245fa2c18d8762",
      "source_sha256": "735b53c60863122904bc6e45e3a50d756aa250a16feb50aade182af9ed186cfc",
      "translation": "进入贝尔福特城内，寻找情报吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68e7a5f5664a99818b57185475ac8de25f4e1b1bb3b9657672ed04c23ddb04fc",
      "source_sha256": "d88f0927e0f385d7eea83d7d3ded05616c6f75f01fc648dfb058677a04eb87fb",
      "translation": "用我告诉你的方法，应该很容易就能进去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7bd29315ad79b085122d1b267737e1c2b5cf07f0d47378b24179cdd8b67ccf65",
      "source_sha256": "75e39536f8f86addccea09698609a1a9132c3997e93b8171f2c4fcbc72f57a27",
      "translation": "在哨兵研究所内部，寻找有关拜泽恩的情报。"
    },
    {
      "id": "coalesced:d39ade6c8bf273475eb60d015792cf37a65512e35004c3b5caac8265f0585f6c",
      "source_sha256": "65e6161f6c69ff2b00ee692512c290fbf18ce9a0288e6a7cf803e16e490e631e",
      "translation": "拜泽恩的下落(2)"
    },
    {
      "id": "coalesced:ef7c7faf4ce0dd26d6b40ce3e59461c0e3abebdf73488ac316711a099183a055",
      "source_sha256": "3a89ca34005e9406f627379ada8cf621c06497b881ad05ee81978211da856c88",
      "translation": "打开利登家族的秘密之门"
    },
    {
      "id": "coalesced:45fabc8e404da5c1ed80300f0d8e9fad63d0ff4b70403ec5468da4f9800e90a1",
      "source_sha256": "0fefd3ec4d1297d90f8042dd552dfa8c941727ac5b54264ac7b696ae1978e22f",
      "translation": "利登家族的秘密之门"
    },
    {
      "id": "coalesced:32000e4599fbcff3c70ad27a7c5f5af84e0ba3bfe995622409786a7b6ed6ec8e",
      "source_sha256": "8aa0bc6160acd9805ffc93a7d61528215f14f03101fae414e99832e89275816c",
      "translation": "这是……旧库布？"
    },
    {
      "id": "coalesced:46930f0ee915d215a45ea094bfe926f4a7238e1c4eef7df936fb6cf99b1cf0a7",
      "source_sha256": "380fb5b31708efd8daf94d6af107571f5970c4412147299cd9cd254171f27435",
      "translation": "读读看吧。得复制到我们的库布里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eeb68e5a0eb4c72ff4e34573932dd07796a4e453fab6f229abaacfd8999e164a",
      "source_sha256": "c25a43dd4c1a8bede137835e7c2a72d56339b4a5b9affa77c9b8f7529a1dfd0a",
      "translation": "好久没有客人来了。"
    },
    {
      "id": "coalesced:4452c718f3363f0e8b872c4feef7841d4fc00d8380498e48b7c045cb71aadb83",
      "source_sha256": "1e2649ed21c70ba83dc8a624771a70d824fcd67092ce65b1369f2849343e1664",
      "translation": "那么，找我这个避世的老头子，有什么事……？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:461468e522a44ce4655aee23c3a26b816309da8727c354571d9d375372db20e1",
      "source_sha256": "38668e10ac7583af600f599e793273139c61bc724c7fd9a8300e8124e52c0354",
      "translation": "前往杜南平原东边的[隐者洞窟]，\\n寻找与利登家族有关的人。"
    },
    {
      "id": "coalesced:ccb96b6e947fe1fc9f3db7beaf812c267d547550fa5dbcfcc50c79d3727d428a",
      "source_sha256": "f0d6769fc01123e6ed7544b31fb3c4ba91c793871c49c0a7d673448bb3e5fdfa",
      "translation": "利登的遗言"
    },
    {
      "id": "coalesced:873eec7a5f1a9c242308131dc2a52401fe0e3024817488db90e7022ddf265092",
      "source_sha256": "d89e48aa2220a0d9f4682291978b0a4fee842454cafefc1ac1ce1b68115211a4",
      "translation": "原来如此……是利登家族的那个小鬼啊。长这么大了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ad5ca598d435af67f0e92b2eb93ee1acee84abba32b9be3cd2c28fe80cf41fa",
      "source_sha256": "6fdb5775b4eba920105032aff8f7a98955daa339ee391ddb7e6dcbaf381955b6",
      "translation": "你会来到这里，就说明利登已经不在人世了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5735956439ce71458081fb68b47909904fa5e17d3df589b55b02ba36d1429956",
      "source_sha256": "f0f05a6e5617a51a9185c336a685a4937489db8de2e92242f5ed2d5ca0c698de",
      "translation": "看你的眼神，似乎也不必多说了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b78bc5aa0910d4b7de90cfae3060d96087404773921808fac48f7eb6c691675",
      "source_sha256": "42dbd27c7a6d896b9dc6f13a3bcf326a34330c7029e327c755f86abf12292d4d",
      "translation": "既然你来了，我也该做自己该做的事了。我会将利登家族的秘宝传给你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2cef95d475b3d729018320562bc69d47f8b690d8fc6e27965a4c8934fabf424d",
      "source_sha256": "5606b83c8c6cc1850ea87e47c12c5a130b41903b38964f2e1298bb3b8a684a2d",
      "translation": "你见过这片辽阔平原上的巨大封印石吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:566f4ea605fab6e59f628572f79c3a8c6ba76f2994dc2178e6b96bda6561cd88",
      "source_sha256": "8e87e8a8a247d6439fe67ce4fcc0acf3669c1171f7688d7692281c04c25ea5a2",
      "translation": "一共有5块，是利登家族用来封印一个巨大巨人的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d44a949317d0891517ae17fd3d7fbb0ced7e17864c77021863daf95240e069c",
      "source_sha256": "ac2779bbe1dda62228105ac65a2719aecafea08b828d62d0222158606bc88ef1",
      "translation": "你必须解开那5道封印，打倒那个巨人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2636be15dfc9f70ed9e63d8c0b2881863fb8c8c281cbb92ff3efd9e39b1ed8a5",
      "source_sha256": "6c6b204875e1b5c66f13155c9882c7e8ada5a356ca2d8d213740c8eda24cbcd3",
      "translation": "怎么样？能做到吗？"
    },
    {
      "id": "coalesced:303454c3e4328661ea299bd866cccaf33277c5ff42e9e9e9bbd99dc9fcdaaa0d",
      "source_sha256": "7fce08312210d9f40fcb0693121d642fc2e53febd907ca121c2de30f8777d780",
      "translation": "呵呵……小毛头，倒是自信满满。好，我喜欢你这态度。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f28c6809ee47676bd665cbcda70ed139030a475f1e035488cffd46229aebde1",
      "source_sha256": "7347c22cbe8f7683b9c5a9251cba04fbc6bb7d5cca906556f9066d5250a6008d",
      "translation": "详细情况，我会通过库布发给你。"
    },
    {
      "id": "coalesced:4fbef323b2d13705f113449aba16a398ef0ea5c45b4b4fb3faf246b2628b27dc",
      "source_sha256": "e6f637a90ca3d2ca5af80f06ef419fcfc3d0d49ed87dbe89747098c0c1198f13",
      "translation": "看来你不想替父亲报仇啊。从某种意义上说，也许是明智之举，呵呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:561367bb117f1f1fcb126683f5bd66da83b053507e8246ade89b11e12b350ebc",
      "source_sha256": "bbe4099c061bad3a8ee5c901924849de190a889cd7305cf44fd1c0621b355c3a",
      "translation": "详情我会写信告诉你。读读那封信吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb22edd25fbf7b2e48b430f277be973748cc90bebf972b90c267ad924961a26d",
      "source_sha256": "25cca358e36d5a8fbdceecc0e5fc8b7ed262edf22d6e9411560376b79d7ce058",
      "translation": "我苏醒了。"
    },
    {
      "id": "coalesced:effde7518bc4d3eeffe5033a9925f84d5cb236451daf4ce9c49ee25e4b4780e1",
      "source_sha256": "2701272b7f894892bbe95e86c4ec98f63a7f241a1ac00c0c1e834dc576e0e4f3",
      "translation": "封印我的卑鄙利登，将跪倒在我脚下，乞求饶命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d622435dcc523f27cf369a66a6819dcc38e2f4ac0e23f9a6d08aaceb6b36a44f",
      "source_sha256": "508c284423d0fe91a288ad65963e0d3063fc8c6aac33dcbb61d16706e54f0814",
      "translation": "看来，小毛头多少成长了一些。"
    },
    {
      "id": "coalesced:69c397015f6e060b1c66d69b4e71f2ca67e7465153bda9561a1fe1f829f0db72",
      "source_sha256": "3b858ccfd37aeba27440b60b97cbb44aba20d517a7af42afa2d27d1d8db3361c",
      "translation": "解开封印石、打倒那头怪物的过程中，你应该已经比以前强大了许多。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ec954e6962ab341bde5139327203c9e18d456d45b304a758b7525090328d42b",
      "source_sha256": "6baba1a41e8d06c742baa9c21d0c61b080cc10c452ed12ac42307a4540ea8386",
      "translation": "而利登家族这件强大的武器，以如今成长后的你，应该已经足以驾驭。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3084bc7d47f38781807be50467af2dacf0e95714b2eafb7b2e77c229966a515",
      "source_sha256": "6e567a43a70b48c4ecb269f678e563d2676ccfdbea9d9b69698112e275407c02",
      "translation": "解开位于杜南平原的5块封印石，\\n召出巨人并将其打倒。\\n详情请阅读凯纳罗斯寄来的信。"
    },
    {
      "id": "coalesced:810500de9d822b4730091fa975d99ba67ab07f5591940ce0dd2d71dde6d15fa7",
      "source_sha256": "acf078c4cab8523219beada01dc9ec64b147728a370a5188d7337d76581258b0",
      "translation": "利登家族的封印石"
    },
    {
      "id": "coalesced:214b41ce79f5a7787ec6d619222e48f48c6659d35f1375213534846201b8de69",
      "source_sha256": "a31b1690752c125364d2470f7e204ef12aa548e0b38ced81f195566bfaa06f0c",
      "translation": "拉诺阿拉湖方向传来一声巨响……"
    },
    {
      "id": "coalesced:eb3de002bd7c0e22dc93fd242541e682d49818bef0d458754f9be3c240836edf",
      "source_sha256": "a8b4b45387ad6bc2fe1703cf9c4e1d15c71725301b8169156cd9069e43d97431",
      "translation": "利登家族的小毛头，你在那里吗……？"
    },
    {
      "id": "coalesced:a72e3f8de5b74cff5d223244862540efde418cf937c30c2a945545af48d2a773",
      "source_sha256": "c0c4df460c37ae9dcca26033236f3c9e673609b40ec54a711ab25592625094f6",
      "translation": "抓捕老鼠"
    },
    {
      "id": "coalesced:3f44913d649ca016bad991ac6da5ef8b9a15de85b87e31c346a4b27914cd861d",
      "source_sha256": "eb840cd51d7a4cd8e105ed8ab973b557fbbeb2a4cddab9622797b607ba57b3ab",
      "translation": "押送一名疑似南部军间谍的人时，让他逃脱了。\\n目前正向西北方逃窜。\\n\\n向那个方向增派人手，将他包围。\\n\\n绝不能让他逃掉！"
    },
    {
      "id": "coalesced:554e772a78567a9d008c8102e785a114dcb9e3176c16f9dbf2eb660308867dad",
      "source_sha256": "65bead42baaf17f11336f3634dc8878a6a1f25033ce3533f574280f1127f6ff0",
      "translation": "致儿子(1)"
    },
    {
      "id": "coalesced:5dafaa5621b016d23e1ed93af412d072befb6a50abf1ebf189337493bfd0534c",
      "source_sha256": "4ade2ba5d236082c0a48dfd4032db383ee41f9c5be5cbd210a206e755953a2b9",
      "translation": "我的儿子，克罗塞尔。\\n如果你看到了这封信，想必我已经不在人世了。\\n对不起……因为我的固执，恐怕会让你承受巨大的痛苦。\\n\\n我们家族只追随兰兹海姆真正的王。\\n绝不能追随那个洒下鲜血、夺取王位的修恩扎伊特。\\n不过，我的反抗似乎也只能到此为止了。\\n修恩扎伊特的野心，究竟会走到哪里……\\n他还会让这场毫无意义的战争持续多久，\\n我实在看不到尽头。"
    },
    {
      "id": "coalesced:edd3813eee8ab2c848b789f2e21c444b1110dbfccf9dbe4d512178d7bafdf219",
      "source_sha256": "9547a9cb660ee25f2573e3ae1b3bc0a459039857e0cf46e1aaf4da6af25b58fa",
      "translation": "致儿子(2)"
    },
    {
      "id": "coalesced:cf150f8853248e08237b05020e4a2b81ec79a75858be5f1523363d0c15abb651",
      "source_sha256": "819229c3aafea2402f3f64d06524c728805fe37e39fe163b7d2db2cdb43d7145",
      "translation": "儿子啊。\\n我不希望你为了替家人的死报仇，\\n而鲁莽地选择死亡。\\n\\n……杜南平原东边的一处古老洞窟里，有一位\\n能够指引你的人。\\n去找他吧。\\n\\n最后……\\n希望你千万不要被愤怒蒙蔽双眼，做出鲁莽的举动。\\n你从以前起，就总是压不住急躁的性子，动不动\\n就火冒三丈……\\n就写到这里吧。我爱你，儿子。"
    },
    {
      "id": "coalesced:8f8138010ad40e0c7f9f2e247441cddcb25fbdbe8c33eac3df8033bde9ce287a",
      "source_sha256": "b6b3f5e7797db189a945d349d837155ee3f9773843a8cdfb341d699b02029372",
      "translation": "对不起"
    },
    {
      "id": "coalesced:874a9e551ce1903b72ff2f001a3d966d4724335d3279391cdc10c94d8b0f6f07",
      "source_sha256": "77b38f605dab309a121e1ef2c838db8e7c25466f151098c699e77e401b154ec5",
      "translation": "我知道，自己甚至没有资格说这种话……\\n但我对大家都心怀歉意。\\n我知道，自己犯下的是无法挽回的罪。\\n也没有资格得到原谅。\\n可唯独洁菲，我还是想把她救出来。\\n无论如何，我都会救出她。"
    },
    {
      "id": "coalesced:8e97a70e93d50fbc340bfa26f5ea46dc25aee75a687419b136c4967b0859fea9",
      "source_sha256": "12e0f6536a4d8b5bc1c62aa379d0deb4742adf169b85dfed8290be702bc265c7",
      "translation": "必须抓紧时间"
    },
    {
      "id": "coalesced:da65f1ae5fb8012447331bea8a9324f9adf55c4274e8c690bf206b9da35f886f",
      "source_sha256": "e36217b47e6048d1da15a534e4c7e001ff780e03c91b84b6595d62a9efbaa763",
      "translation": "我已命令所有知道公主殿下遭到绑架的相关人员\\n严守口风。\\n不过，这恐怕维持不了太久。\\n\\n必须赶在消息传到贝尔福特南部军占领区之前，\\n尽快救出公主殿下。\\n请设法取得潜伏在贝尔福特的南部军情报员的协助。\\n\\n请一定要救出公主殿下。\\n一切拜托各位了。"
    },
    {
      "id": "coalesced:72ba30c2767b8d65de5cd68867e0090aa92414e16d8f74e1d91528d760e02d29",
      "source_sha256": "077f4672bbb2d7aeaaeb7ce6caccbabed12e01a861e7cd176c39af9644f46ae9",
      "translation": "关于贝尔福特"
    },
    {
      "id": "coalesced:fab5cf8dfd9479fcfe0d6f923d2a971b3013df2dc5c3d15f0efc10722d5cc845",
      "source_sha256": "29a4a0c6cafabde8e98ef3808fe19f9c1a5a3712d2c606598e90721bff638a4b",
      "translation": "贝尔福特大致分为三个区域。\\n贝尔福特南侧入口附近，目前由南部军占领。\\n在劳德司令官的管制下，情报应该还没有传开，\\n所以士兵们应当会友好相待。\\n\\n中央是已经化为废墟的市区。\\n据说，市区内不断有灾祸种降下。\\n\\n而贝尔福特北边，是王城。\\n越往北走，北部军的部署就越密集，\\n各位最好做好充分的心理准备。"
    },
    {
      "id": "coalesced:afbb1adc917de1e2aa25c8b08d665e090400aceb39d393f973cdb07ddbe4c7dc",
      "source_sha256": "8751212bf651bd92d7309198005670683c8e1df23ed459fe66ee65d2f3003044",
      "translation": "已开通鲁哈尔特盆地线路"
    },
    {
      "id": "coalesced:43ebc399e03a2de46226d65bb75fd751caa36de0886cea37ea1aa7a0936e3cfe",
      "source_sha256": "c3ddfb5bab3d4acfde7ea7cd68c01fcd38df9286a37802a91928271b145e39ee",
      "translation": "这里是阿维斯运输队的消息简报。\\n从今天起，开通鲁哈尔特盆地线路。\\n\\n在阿维斯运输队的任何站点，都可以前往鲁哈尔特盆地。\\n今后也请多多惠顾阿维斯运输队。"
    },
    {
