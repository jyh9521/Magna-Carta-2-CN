{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:beb0f1e734401aee4c2cd30041f14da5a54de5111af06ba94ab3361a72413e4d",
      "source_sha256": "8f28fcba6c57bf8bf87ba9b6c557dd0b660563e9a9b203286b3965416e16d1aa",
      "translation": "你怎么会来到这里……？"
    },
    {
      "id": "coalesced:887e622dfa83b525cee2abf58cae060c70801aced5ef11faaad52b845f544bc4",
      "source_sha256": "f9a1369a615ebae1eb126c2ed0f2c81d275ccdb2519f459d8fce8e5080db90e0",
      "translation": "好久不见，亚历克斯。"
    },
    {
      "id": "coalesced:54688eb934b44091238d6beef09572800941fa2c453ed5902dc1b9799ab8e41c",
      "source_sha256": "aec1ddbe10c631d9867aba93b637835466a34057b298dccf82d05505c52e427f",
      "translation": "这段时间，你一直很好地遵守着契约。多谢你让内战顺利地发展到这一步。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b60e6b81cd31e8826a8e7a258d9ad66686d6b8528511d2265f9390e8548d4d6",
      "source_sha256": "3f582620bc797987590d3e9925b2c606d6eaa03fa8b331863ac82309b7e48807",
      "translation": "那么……内战就要结束了吗？按照约定，女王身边的位置，会属于我吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b963011f664ff9baea5aad505fb0a5144147a2b5b43ea818ecd7e4749eb7300",
      "source_sha256": "8e64a17eecb7bc7d5f40156453776df9b15d7124836fef6f546d66b7913e97d9",
      "translation": "遗憾的是，恐怕不能如你所愿了。"
    },
    {
      "id": "coalesced:7a78be7ded1ae7ed77285d9b32af0f24f501575a3ab67fc3c9c5a902c9097ddd",
      "source_sha256": "65de4aa8f3b3ddc2a5f086746e1908b4ec524d6d01d86cafbe57b2b7acef6148",
      "translation": "事到如今，你要反悔吗？"
    },
    {
      "id": "coalesced:6de64ef67821a5bf4c4e55ed283907970bd95ccdf6788774c7041e01672b8f93",
      "source_sha256": "96340275465bfd55a9748218c3b20c535a28141dae6e315b1b9703b91736e1eb",
      "translation": "你只要成为女王的伴侣，就心满意足了吗？器量还真小。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f37b45a3930c2846626cf2bf43d245b5a753fca3680221398e0637fb8a738bd0",
      "source_sha256": "de0d10557f6c6efd48f83c69c2745caaf641297bdc5d4fd31da54e9715ff91d7",
      "translation": "不如……由你来当兰兹海姆的国王，怎么样？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8101200604038135a02bd6b8a3a9f1014d76ea74543a9437ed06f510d8873567",
      "source_sha256": "934bd7c3eca73c94d0d94e52e94e4be32015478836e4cdbfe380ae7839de3509",
      "translation": "国王……？"
    },
    {
      "id": "coalesced:eca5882c95a044b33ab43d479a7f64865a14cba2aaa95f7e0d00010038387138",
      "source_sha256": "9507d054fa9f4167fe487315a18e0bfafa183aff6b951f8898623e7e40fc34dd",
      "translation": "有什么好惊讶的？是你的话，就有这个可能。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e831349cdeccb1e28bb2563a1a6888186669311ea79fa04611cbec2ad28704c",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:98a4e808badf288b142bb76b1f971b198f75e71fbd3253243c04b8f36ec08dac",
      "source_sha256": "b32477c090586ef6674f3e5b0a3fef23b22013ef57686e28466f3d06ff1e95c1",
      "translation": "果然是这样吗……亚历克斯大人……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:931ca0e3765293094cb8759e2497d5a5a9d77946602a2fff5adec55a005d449f",
      "source_sha256": "f4a0bd107a28d7ff32f0167b4f4555cbc3673550b81fab118348b52507b908be",
      "translation": "这里就是鲁哈尔特盆地啊。"
    },
    {
      "id": "coalesced:0b7c8be4678ef67d1f6e9fb0b86216a04a014ad097e949d471bcd42bb790d65e",
      "source_sha256": "5a7a60f2f618953b1101cf4331aaeaad35f1885f8668a0a35bc2e2a1c8861809",
      "translation": "哇，有好多芦苇。"
    },
    {
      "id": "coalesced:6a4e89fa8e03f5dc578f73d5183629008e28f5b7ea90303a91032f74e8a84d22",
      "source_sha256": "f44d9428e28973d1ba8eeeecd7b281a95e46cbfe51729b80bba976a4e3ebd209",
      "translation": "大家小心北部军的新兵器KAN地雷。尤其要注意，别让属性KAN生成得太多。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c2967b0d464042b4c80aeae980f09547ff3ff8e239ddb87ed8a108d586e1e2c",
      "source_sha256": "84891e8407eb1ce32c15b75174830b52b5afc2a58d4a2501b76e3cdab56368e6",
      "translation": "属性KAN生成了，用技能消耗掉不就行了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7b116e694cace938a3f826034d96b00e05e253b1f727d81683f066f82aede2c",
      "source_sha256": "798c0991bc09ee527e871f8fdc8b128bc7221521aa9164626d30b72c6f373c42",
      "translation": "KAN地雷可以由我来解除。发现了就交给我吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4039ebec47c48b1fb8b2d8468d13844af7610ff5b79901140ff3e67e6b99900a",
      "source_sha256": "be94922036d2b73b8d177a65a8641994884f7bf2a63ca0a851f7a1326e201ee2",
      "translation": "拜托你了。"
    },
    {
      "id": "coalesced:9020b9b1aff1adb9c08c6540b82926871ea901114492c6e7eeb5be40a2b40d58",
      "source_sha256": "bc9a855b4b7503ef31324997b5e678d973bb1357d682223bf9582618186482ca",
      "translation": "雷电炸弹也准备好了，运用得当的话，应该能应付地雷。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3e8f8e30a78bafcff613374e06c469eeffba851b5e9c017af49b2cbc49fc786",
      "source_sha256": "71929f028e9de93f22c462f90878495e26b28d2b7b73cefbab0e904033927ef3",
      "translation": "那么，别忘了，这次战斗也绝对不准死，大家都必须平安回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ab0217689e01b73b7a9a158deda68034509ab6323adaed4bda005b653b02ecf",
      "source_sha256": "850cc5ea33b537dc6b27230a69034f85f5da610c0cc3d5225102ca92eade1140",
      "translation": "你说公主，她给人的感觉，是不是有点不一样了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba7c8a7ca2c45070ae9e99846d6f673c3a181a2bcc5b2f8c100fe4247d52cb2d",
      "source_sha256": "e8d1b71a683ff97445c212e32f43296859532fc0caa1de141d4df75bdd5623e9",
      "translation": "不清楚。"
    },
    {
      "id": "coalesced:f0ee5ba282e6ec435d758d56a75b3326ec0e276e2e8cdde25047551cf240a652",
      "source_sha256": "9c84a082a8e9176b124d43a446a68e254cc408ce77d315649e6d65ac77d66763",
      "translation": "好像遇到了什么开心的事。你是不是知道些什么？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:46a777222e8fc53c3fc3ff94224c7784fa1a034d96ab97af3acbc5ca9c4e6f26",
      "source_sha256": "b250c69c8ba21a3b59f74de438ae2410b58c24da57b6ed7a4aae5b6864c1927e",
      "translation": "这个嘛……"
    },
    {
      "id": "coalesced:d1bf13eb6f118d6b18b76ea14ec598e3e83c9d47a16fb97ace67fb8e230a814b",
      "source_sha256": "867efb623cda99f189abd46fa0fb5973a479164010ed4dfb9ceb8065e0220dd1",
      "translation": "塞蕾丝汀，你把阿维斯叫作会说话的鸟？继朱特之后，又来了个乡巴佬啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:615a0e3ef9cf589de86b8bdac51f374b20efe4c9a81552c6ac54ab98ce6ddb94",
      "source_sha256": "50d592c59134eaa09cc7d39d4b0fbd31051c9b0390d5cf53492fbca320561a6a",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:5aff8bc2b9578705a4650f1650291dc8dcac18f3bd35aa2f32ee5a17b6f0066f",
      "source_sha256": "a8c5da08df58f8111e86a6d7c1bca0ebde2f3f256d0f249c5b9b974fddb28fb0",
      "translation": "啊，说起来，柯塔马雷的那个商人，也是鸟！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb37319e8cb908c36cff0c99a45838acd0a121d73a60235e1646a0ed84087235",
      "source_sha256": "9ca1df72ff10cb1867533a791731037ccc1f6d4ac4b89688781e0076f434dbff",
      "translation": "不是鸟，是阿维斯族。是个有着鸟类外形、性格乐观的种族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb94af823f5297f0f5d479ee83055106d39fc09f918e403fe55cb8a2df14d554",
      "source_sha256": "cbb78527650180bd044d9ded2ec691b898e1a64aa74210380e0fa628cc5ac15c",
      "translation": "是，是，我正是阿维斯族。南部军的各位，真是太感谢你们救了我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0902516d244ab26a0ad4085ffb11beeea766ce6bd2135a48540e54be15902334",
      "source_sha256": "1ed8300157a5dad0f881c850258dfebc13b5e974eb6c9d952870fba9547b8b36",
      "translation": "我还以为，自己就要这样被关着，结束一生了。真是大事不妙啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6726f260c34976b67a71afc6ba4165130d58085fb888fec0f9bbecbc74f032f4",
      "source_sha256": "aed03a339f6c0525f50fe9d1dc2fb175967c85deddaa194d084a0d80b2a2a787",
      "translation": "不过，你为什么会被关在这种地方？难道是北部军的间谍？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8d4cbaf6d96e14f7d1f24b86b8cd09825ad8baaba7998782f901511091b77e3f",
      "source_sha256": "c64f2ea8c0ceaa67ddaae935742f3f93081a96d5e32719f8b74772ec1711db04",
      "translation": "哎呀，冤枉啊。我可是北部军的俘虏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:194f617659e26cf88468975c06362fa2c9638ca054c42021f9b26de40579c251",
      "source_sha256": "9dd05453871cb2e6e717d1db26a3087e982787e85375d0b1ae1da33b8a10678f",
      "translation": "我不过是想研究拉·斯特拉达而已～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06500f2203faa8dff6eb4c9b2dc20f75b7093077371ac3958af6a0e4418c3dbb",
      "source_sha256": "d50efda8bdd7f00842252539737fbd95116e1bc3a17cdfb7fa48fa0b0e3d718e",
      "translation": "可他们突然就给我扣上叛徒的罪名，把我抓了起来。再也找不出比我更冤枉的阿维斯了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edde95bbfebc3c9125d90e5d2ef50dc3c23a4a71273b51a1ddabc1a903a7bc07",
      "source_sha256": "7c3bb9812d9c30e87af4ef6d7133056bf4a0cd1a2e0acd7795900c61a05ab18d",
      "translation": "拉·斯特拉达？为什么要研究那种东西？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:75c4057f8f43af47fac128550775a0d317acab8f9c4848542ea22b6f32ada986",
      "source_sha256": "7aebf3d57438e8c805be6068c4ad336ee248e2563bdfb919a6a734a91f13e9df",
      "translation": "那还用说！当然是为了去拉·斯特拉达。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8ec86470c293abddaaff0db593482e26c7056f3fa77b8925dd7916d9e519a45",
      "source_sha256": "86330beb87f3c0fe00c45b14b27af6116813b04479097b117439f2b0f3f31879",
      "translation": "根据我的调查，拉·斯特拉达虽然浮在天上，但似乎有办法从地面前往。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e709b1931c562defe93bc06c7460c8194e56801a1c8c03c3602b0c4afe46a102",
      "source_sha256": "e50cfba5a12f9a1f1e9c8fa7c903d9812a75d2467cf4ef703a005e3467664b38",
      "translation": "你去那里做什么？"
    },
    {
      "id": "coalesced:b9f1cc975d048cfa68dae3eebc2ee718dfab1eeedd725eabb7943aaa9fd7f119",
      "source_sha256": "35ef22d71a221f25b65ae01b5bac4e17d6814d0f55524f6c6c5902359a625454",
      "translation": "也没什么特别要做的。登上那里，本身就是我的梦想。怎么样？是不是很了不起？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cdd5655aee6c2986ac7e6cd76a30ddf736073990f921378f1f618060718c92cf",
      "source_sha256": "01c7bee9b2c6cf3498c4c49de050e1622a9f3d610208d31ae687bb57d28beaaa",
      "translation": "我要把伊格顿大人的名字，刻在谁都未曾到过的未知领域里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78fcec6ec0f35645ecdf8e5d1dd917aa36e45c54420d0834b2cffb80b7c0720a",
      "source_sha256": "ec53b2e38631dd5b8394483b7da58fd335ec9acc1391560307c3138b2f094495",
      "translation": "就为了这个？……我实在理解不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:56efdfb60470503be92824a37b850c5920a86e4a0e4f401c75f743145fae99b6",
      "source_sha256": "5223251578b5f0e69daac2813eed69af488e3b09c78fb90ccaa1c1baf6bd7c56",
      "translation": "我们正在执行重要的作战任务。这里很危险，你到后方待着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96ba98f59332f957c9e45bd17cab0660d0d6e1c4488d8e9669850917182169bb",
      "source_sha256": "12b9ac9d5fbaff46d0f4657cb3f75537f34e45c9485fc2f97f8bc1d32797ad59",
      "translation": "啊，是，真是太感谢了。嘿嘿嘿，各位都是我的救命恩人！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:719004765f936e1201c0c125ff67dd5303a3b1ec518543e6da214a92c9b4ded1",
      "source_sha256": "8bf029790f12efa09571aa3f4384a1f01b383a1253f0a4254568a09a83023925",
      "translation": "他在说什么啊……语速太快，吵得我头都晕了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b07c534962c104902ad39e48d5cf29d67e76a446bb86db73dc6536c55bd65905",
      "source_sha256": "e5ae2b2cc5b8c19157a1568013a3e2ae593d1cbb5396bf4bca81b4f116774c02",
      "translation": "梅莉莎……"
    },
    {
      "id": "coalesced:2260c02074151ab0a6002e512683d855d82a9c2d4c95e28ebbdb794a56a5fc1a",
      "source_sha256": "ab31cdb58b36c5e58cb0775471f92711f3190e2dd89b23299da7fdf196186dad",
      "translation": "朱特……你还是不打算回来吗？为什么还要继续在南部军作战？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0eecae49faad6ad1ed830e4f8b6bf17678f4567f802ec023a2326a1e3ef0780",
      "source_sha256": "4586c9f5ad890835557aeabbdf440f0cc0fdf9a47fe1f2c4adf55fc9cf8e23d5",
      "translation": "我不打算加入北部军。我已经下定决心了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8f968cbdd5640bd55805f7b7cf87edbf72866775069b25e59210ac988719871",
      "source_sha256": "20ab29eaf37676a2080daada4e193ae0e05e4483612bda7980c88790be008f71",
      "translation": "梅莉莎，你知道吗？北部军是怎么制造哨兵的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10e1941debff0086381e060151bad82b9dda92c3c7c662931bf2bf94268f9735",
      "source_sha256": "8025c713f26164a6787608a6cbce1b8ac0cfe963a42e1416578db60193e95224",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:082d24bf84ae034f89c89aaaef7509131196c63d9e028854da4c19b3fa0bbc69",
      "source_sha256": "6d21f435bbba74264a536fc32f86980e45ac9e7c7b4663f60eee6c4fe3213d49",
      "translation": "知道这些，你还要留在北部军？"
    },
    {
      "id": "coalesced:d34b810ea92fa3e5fcb086fe863b0696ca4921156a07d8c2ce7c07dcb74a89e6",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "是的。"
    },
    {
      "id": "coalesced:b156f8193cf4c3a9c944ad2db006780a6fcbc4755c535a43e9bb37e71e39ea8f",
      "source_sha256": "9e0c07630ce514b0e05b3d312d0a2b5f288dc693d861b3dce528c435cf0656fb",
      "translation": "那些用哨兵滥杀无辜的家伙，代表正义？是这样吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2947cc45c6f083569ed21b62011c69bc0db0069a4ec262f880e5716fa46dce37",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:07fc9e8f02326e9094c409579d657245551af1e7760e723241f15a5044cbb911",
      "source_sha256": "b5096547909d7c92dce6a5078453d14e96b0103ba855bd37381bd0e3ed94d150",
      "translation": "回答我……难道，我真的非得和你战斗吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b91ae59834f9a89587b127a3bf1899607c186a2fcdc8bb358fe22135d9eaa36",
      "source_sha256": "45ce99ea0e36088fcfa1edba4eb874091cba42ff12f2cce6c67ce4e04c39912b",
      "translation": "现在，无论我说什么……你都接受不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c44ea892d2242e0089697a5dfa0deb5bc28798888fab0dc342da3511145aa4f",
      "source_sha256": "6432bab8a82bd2f3af3be61d7800a1c9efbdb3b0057c604d4037e7929665051f",
      "translation": "梅莉莎，够了！"
    },
    {
      "id": "coalesced:4686c0e0c0ba7b9948d58d9dca2cd5455aa4021eaefbe79a977993363989c520",
      "source_sha256": "9ba3521d8d4dc6a25d88ddf26883165c077bed980cee0969dfba82c112d83e88",
      "translation": "回来吧……你没有理由和艾尔加那种家伙站在一边。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f7bf5e2300114209d7d9abe80a88fbf0240bcb0929c5cf4a9daa64876af3a25",
      "source_sha256": "15fe26e5c5f66e7f2b96bb6f260ebe15b489e35daeb0998cfe6da20c7386244c",
      "translation": "你真的什么都不知道。睁开眼睛，找回记忆啊！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d923c89a9e121263d6b8a6f44f507b2ea77adb7db0c280959724587ceb915302",
      "source_sha256": "8b6a1a70c13b926ee53031959d50073c8f689b20589ad2c9c4fe017ed532dc69",
      "translation": "别转移话题。那和现在有什么关系！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5f1a42b8b363ff31ad7bbce355987f8735d493062d8f8b4fbe2fbc2bbba1d48",
      "source_sha256": "9fcc5683dd6f5cc84768e375c2c3920ff5c0c22724852afd83e19a963a02c150",
      "translation": "你知道艾尔加那家伙干过什么吗？"
    },
    {
      "id": "coalesced:52277a2a07492c0f82ce74042d9be2b00905795d0661dd6d164ed999645b8497",
      "source_sha256": "b81dcfad760fbf2d51efbfeec67645d1e051269628120428fc60b540bd3ca673",
      "translation": "那家伙……杀死岛民，用他们制造哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a95b795bc7cebc3a145e7f8c404015f89b5d93430cc25891d9bac32dec5fab5",
      "source_sha256": "8a7705411d669b4e0f2406b2b74eb313489078cbb1bb3e62cdfdce768346818d",
      "translation": "即使这样……你还是要说北部军代表正义吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ae83007ab92028eb97335db532615f7591ab9a8da66e9119c946205aa1a26e6",
      "source_sha256": "2d608b18f25d3c8f5d6318733e6708609f0f816e95e9723f5610d535df3f3d77",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:2a0eb1bf71f31d9cd8eb401aa2757fc6cf93f45da1f7ee0edd1f6b2ecf6653f5",
      "source_sha256": "d0439b7b177593c8a31532b61db5077b33d6e4ef0df9e3372c57db3813f57c0c",
      "translation": "该睁开眼睛的是你。清醒一点。我已经绝对不能原谅艾尔加那家伙了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17ec0d951407d3856e3dc5529eebb824a4bbe9d1821f2a6a25ae98b3aa514b7c",
      "source_sha256": "a8fa1411280d5edc883b5632743aaecfab4c65fb010071f745f9de6fb68c74a8",
      "translation": "我要摘下他的面具，让他露出那张邪恶的脸。让你看清楚，他究竟有多么凶恶！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88609cd00143f1c3e523d87c89bc9bc213aa30b2edf91c66a8a2f88c20f31610",
      "source_sha256": "adc4f35bae44be6974147a764626d9c566ffe8517433f67f018631393da1fb79",
      "translation": "……不行，朱特。求你别那样做……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:11e6935e84ee76f1d116ffad7a9085cae68e95d65364a18cd49375f4b88e8f1a",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:e6ad2efef91f16d70c5cc87d16b2b8a582b0995055734c995bac0c6cfdbd3ca7",
      "source_sha256": "0e8e251a6323b4ee22f4356a652f2502cd88478a2c1ffea6c1fc2ad7c8b3380c",
      "translation": "朱特……你……真的什么都不知道。艾尔加他……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed73de7fe2eda67392bdd624abb73c68ac4e6601848cf185a798e71393297fe2",
      "source_sha256": "5cd8e3dab9dd7348b3b26392bab336076b526abb6d92c34310726a707252ee3e",
      "translation": "你在说什么？"
    },
    {
      "id": "coalesced:35796ef0f5bab5326712a264bb1af60eb936fd48fe2cff9875a01c71ccabb843",
      "source_sha256": "8666a91361fe827d21a65884f80b40a25009c91c3e62c5246b928966ee9eb138",
      "translation": "喝！快喝啊！"
    },
    {
      "id": "coalesced:bd06142d48d98d39c40c500b52b7366c07db45c2d96374fbf02dcc31a92696c2",
      "source_sha256": "877aee2f1119f7b5b01fe8b3fd4f95ca37581f3ed238690aa18cb1103d9fa2d1",
      "translation": "我真的已经没什么好对你说的了。"
    },
    {
      "id": "coalesced:24a3c9b67d9200ade7b7068801ed300617727b6f2180bbbb508af4c1b80d63a8",
      "source_sha256": "c825a6ce561c1cd8f22acd4602283dd634356dca5f3d0bff6c8ae44115fda11b",
      "translation": "到那边去啦。会被发现的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dd775247e3f885712a3fc1596d741dfd880e6cdd9bb30db581fd2eb315f4eeea",
      "source_sha256": "646f1861470b11a62f18587ee2c4db138cade2ec435b4bbcc747cf9e6818edb9",
      "translation": "嗯～会在哪里呢？"
    },
    {
      "id": "coalesced:ea621eccbb7344db42327140800efc2b2cbe7f5187972a9243e2f81fd254c521",
      "source_sha256": "bc62910683a07d406790046879e0281be05a5ab0653c7239ad59968349b1a18a",
      "translation": "我们在玩捉迷藏，可我找不到他们躲在哪里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0771b40431bebbc5d130c7e0881e1b8cc065bc5d3a0949ca490e0fc879e30110",
      "source_sha256": "40a568ece6934afc24255b1ceea97f630615d08309997b5844782e44a65f29f2",
      "translation": "听说接下来要去鲁哈尔特？穿过杜南平原，再到鲁哈尔特，可是段漫长的旅程啊。 ",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:32550d323c15553a18e371afcf8c4f8debbf602709ada76a01c99ce3ada9e54d",
      "source_sha256": "7dcb54d7a487f84da547ed577b3922a55cd4d4d2ce87f2826821e7e1427dff94",
      "translation": "陆路虽然已经通了……有机会的话，也试着乘坐运输队吧。听说很方便。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6de52d2b96540c363fe4b3f45f029007fa0abed4159f49a61485ec683e69f66c",
      "source_sha256": "d9e003149a35b618dce88cf8fc600a024d20f1e5c48d45b7a9e775f907187975",
      "translation": "我也想趁这次去一趟柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e589ada3dbbef21ac5a44ae3d0b9e60b64dc6a3d1135d0227f611dad298bb07",
      "source_sha256": "c14ded8fb80d60910d61e63b5d74d613e96dbb75d01a01689f5148096cea03d1",
      "translation": "既然和南部军结了盟，他们应该会热情欢迎吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c10541a47c5956b0f4bea554e5e9e65a54ad6bea39c5079c60c064587b080b7f",
      "source_sha256": "9c3e63207bdedbfe7c4fa8004dba5bb864a8408cdaa2dee880ac62650fcf89e2",
      "translation": "得给女儿办婚礼，可在战争期间举行婚礼，总觉得不太妥当。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:acde6b6a3015b52eec06fbf919c73a813a10221499e24458950e2d049846b9eb",
      "source_sha256": "97b7e4ce960ed457e04d27d421f133c91ba34be637827fb8cc3801d1b94b014d",
      "translation": "就不能快点结束吗？"
    },
    {
      "id": "coalesced:d4e4bdfce2174b40305e63ed4779b85408f30510252b45b2090b39a19dc76d22",
      "source_sha256": "dbe1ce2861b759b66a214c385813971871fb07d41361e4271aa960b61bdb0f0e",
      "translation": "忽然想起了经营阿维斯运输队生意的伊格顿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf2bd158c9a953e1aac8cb7f135d92ff8357e41efb355fe489e4036bef3370fd",
      "source_sha256": "a5066b79adda60dfd8873f6db59c72483cf1465f22e71f445bd6004539e2bc28",
      "translation": "他在阿维斯中，算是相当成功、也很有本事的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b8a96af0b6dfd0e24aedc1b7f5e5a6762999465f5a3d20cc5a587171a9bf993",
      "source_sha256": "0095c83106020098a38ff2aa6b989c2c3036bf94612ede2853ef897a157fe309",
      "translation": "不知道最近在做些什么。"
    },
    {
      "id": "coalesced:368377793dff6715552908a7f6ed55c81e5371fcb866e5533aeedc91f888ebed",
      "source_sha256": "a01b2adde539cd4029ffc3fcde6ed79c0d77f86d55a05105ee27b61d9f9e4e57",
      "translation": "听说贝尔福特因为战火和灾祸种，已经彻底沦为废墟……传闻是真的吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca104ebe2c9af5f2417f3fd7c86018d8b5b39c126f6f12f48359fba107ce338a",
      "source_sha256": "c828ddb58ac290396b8393e62fa42b3260093d0f6a9113ff41fd4096cc9d880b",
      "translation": "马上就要越过鲁哈尔特，向贝尔福特进军了，大家多少都有些兴奋。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38b1af416c42d9d5a404270d5a31df8343ff5cce724a8d144aae049892ce4655",
      "source_sha256": "f59c161bdda1607719607f5c4c183f07a0108c89bb54ea6b8b39866f3c86dac5",
      "translation": "这种时候，往往最能发挥战斗力。"
    },
    {
      "id": "coalesced:0a6ae3d76d3ea28df3f3e5dd3877ef129db937d9ed738ee6f9caed841ae9f91d",
      "source_sha256": "f85f4bbe68de3ec52564dfb18e21f5b47308083eacae50366d1a02135dbc7944",
      "translation": "我深信，各位在鲁哈尔特之战中也一定会大显身手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59984826a2521b41b901a6987f67a9a1779b78666d615cf8c0e2249f8a9c8ae8",
      "source_sha256": "5dc4b41927eec46d1efd21267f92cd1d7b9c54a85dd14b509da82265f365bc7f",
      "translation": "只要推进到贝尔福特，修恩扎伊特也就无处可藏了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:903ad5eafc5b6f1f708c9786040ab65f962f8c8ba5accf18096d77f4e0f8e2cb",
      "source_sha256": "e0ddf206c47acdd2378885d034bfa019f2d78e1c66ed0a4e69dffa2756beb274",
      "translation": "离讨伐逆贼，已经不远了。"
    },
    {
      "id": "coalesced:d0c3530a083342b0b735c64224499e8db666472068e4c63d6b960a490d303fb0",
      "source_sha256": "056d2332cbee766340c96843442b17a0c1fa0955051ecdbcc2b47c00cb1915f9",
      "translation": "不知道他现在在做什么……"
    },
    {
      "id": "coalesced:60c605da8ea0cf254f10a97ea1da54ac1d711230abb37c96858bf4abeddba78c",
      "source_sha256": "bf3fe080e0cdb5523ad93646d94146d28e5a7f29e12fc25647fd94c2db65d1c4",
      "translation": "当初真不该催着他上战场……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:277a50ba2183d6d15268313faccde9e67245df17920a8d0710e1ed385f2d7e8b",
      "source_sha256": "02889d296254ba42a7c2aa9e4a13eebfe2f8c60ac5e840f63f83a714e1f5c0fb",
      "translation": "即便打赢战争，修复损失也绝非易事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ac2cf18b43b06e5dc39d0dd30f7acf0e95b6b6a1b80776a3c620d1f77de1c10a",
      "source_sha256": "37323a231736af0669a73aa31cc1cbf236061d3d816cd68359285dbfb28c4707",
      "translation": "就说贝尔福特，听说那里已经被彻底摧毁，根本不适合住人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e036eb6aed5e9509a0f7d69d63da4b9c54390e4e9e0c01c4d5f1095878f3d7d",
      "source_sha256": "b1080fbebb9f79a20ceae7005623ac81056c201ff9937fe86146e0e617341a07",
      "translation": "听说最近反哨兵部队大显神威。坚持到最后，加油啊！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dfeded2c8cd819dd35c65d6d5f266cfa5f920fbcbf5509bb2b5651d9b8d559c9",
      "source_sha256": "b40d8b3f2ca7b8819e45e47b052cc94a489f27ded7a9dafed50058561466b2fa",
      "translation": "听说最近灾祸种降下得更加频繁了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d816fc891cbc1f55ece343537752fb4c13b294170d57eb17c41315b6a2034e3",
      "source_sha256": "75278e5c0731ff07353fbbc28c1a751ef22b57e9d84f7783066569cbbc24b79c",
      "translation": "啊，一直在等你们。"
    },
    {
      "id": "coalesced:69382aacd47ecc606af0fcc45a0af247df6ffc869f5cd60104d2eebffa61ff7f",
      "source_sha256": "2e6d523d6f0cf189c4e514bce0992ca898fbe76aeff97683fadab90635eb1480",
      "translation": "据古文书记载，在拉提族聚居地的最深处，生活着拉提女王。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6227a3fb3b99a252ca7e8114a5008142e92c54c62bd0e4060a5586f085b8ca23",
      "source_sha256": "47e1f66224781be38535a673ba365f81492ce7b810a37baf53025851982442a4",
      "translation": "拉提族通过女王产卵来繁衍，因此只要消灭女王，就能阻止这个种族继续繁殖。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea5005c4141512b8f61820336478e79df1971a24f19edf5fc727e8edab80db1a",
      "source_sha256": "85d05dff0aaae0dceff3cbe8adf3d29a0df37e22364daf0b776762990550c98f",
      "translation": "而且，拉提族的卵若是放任不管，也可能孵出新的女王。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b79f183692ad2dbc456aa979cb93c4a04091afe87812478d695570e5450f4bb8",
      "source_sha256": "4805eb74613711e46e90bcd63675a0c31f86f41a9ff14cc9d43d3fbadf7f2ace",
      "translation": "所以，消灭拉提女王后，必须给卵撒上药，让它们无法孵化。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf26f45b2be831db31a316096c8f45bbfaca110193ccd35aa37b6ccec853dbf9",
      "source_sha256": "b944bc5550f24ba3cc8f387c2247b8c505d31c007616748971b0023bf78dae28",
      "translation": "拉提女王和那些卵，应该就在拉提族洞窟最深处。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:027175817d3743dbbf9eb7b669b0795dd717d7145ca52998c618ca9350c2e61e",
      "source_sha256": "6f2700f3979cd9d439125891cb46023912e84e41ffef1ab9907c0686918ad0c7",
      "translation": "最近，拉提族的动向很不寻常。请再考虑一下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:04f1c85b9c58ecb4e5e2a1f45a4afa47b5d89caefb9692e1203616f946bbb429",
      "source_sha256": "b0203fe629856c43a04e935a148849b61030af5ba26bfd0e5b2cf9367525c39b",
      "translation": "听说公会联盟也会酬谢消灭拉提女王的人。还没去过的话，不妨顺路去一趟。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f40be86735075ecda2c896c74355f89fd91d80299a7f89d7509387e6b9dd803d",
      "source_sha256": "a45e2421208349a1f7eff5d20c9980f34186715c292135bde55fcf63d033375a",
      "translation": "辛苦了。这样一来，拉提族就会大幅衰弱。这是用剩余材料做成的药。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b44ec1717d84b62cfe1b72067a0eb7709f81a56edcb36ab8bfd93e6be90a15f4",
      "source_sha256": "525648bc9cd1655053ed2609c52a35702426eb03a285bb5d34737050305452ff",
      "translation": "请消灭拉提族洞窟深处的拉提女王，\\n并给拉提族的卵撒上毒药"
    },
    {
      "id": "coalesced:85e8f3c968394f5b17c8acb33180d4487000f95f458b482ea0996aec72f5e776",
      "source_sha256": "dad72ed0604b60bf936c6aafb2d4106c9f0ed769f20f4dc31d3974027e1ddee5",
      "translation": "进攻拉提族"
    },
    {
      "id": "coalesced:bdeff7bb88143fc53b4ec1ad0dc422ec987767e268ba34d69d0c9005b2f53bfd",
      "source_sha256": "26de7c7054acb690f16ad42e00336b749c059379e0fa4c8a4d5c30a85252b49d",
      "translation": "QUEST%s : 撒布拉提毒药"
    },
    {
      "id": "coalesced:1c5d32114da15f5579e57ffc12ef6fa5309ac9bdd0cf4096337f55e8f6a7bd31",
      "source_sha256": "7af7d1775a70a2a5024d4ad9373aba7cc2ef489a2ee10eac51c0d3b84a7f66b5",
      "translation": "QUEST%s : 消灭拉提女王"
    },
    {
      "id": "coalesced:48eef20f8745d02d287a39fc5aabfea0992b9ab258fbacf4d5db87e1430e6a73",
      "source_sha256": "ab33e4aeb39ded486416cf7b9bc1e87f95bfac7ee2e2c2331be1ab6b72693fa4",
      "translation": "消灭拉提女王 "
    },
    {
      "id": "coalesced:95f1982e018060100b37e025340324230653a8c8e9c0a3d966c02049b2919e03",
      "source_sha256": "0b53550fc689012d57919285d4f209716ae69c1a1831bdf753c22d625b3c01df",
      "translation": "撒布拉提毒药"
    },
    {
      "id": "coalesced:83ef245ac729438ab6640fe26a462cbde2d3b8d68053fc8ca922d7ffb351f79e",
      "source_sha256": "6aa3bd523853aecedc15862b5de2dc1cdc11766d19fa9166377c8c483cbd8aa1",
      "translation": "我们查明了，之前你们找到的九节草，是根除拉提族的关键。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f00be7d9c82aa4fdbaa9c6411c2e0e720e61021bddb8331d98bbeee8fe2084c",
      "source_sha256": "32850a19424e755cc51954945f6ba6bbcfda200646fb9395525aa93e1eff935f",
      "translation": "我们联盟也遭到了拉提族的不少袭击，正为这件事头疼。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48aac046e8caa2540d8358faf57d7dedf74cee1db5d3428a20a86a7c2232ef58",
      "source_sha256": "db4b53ffd32698a932bba9243e0fcf05a976d9eb52a5cfc06bce67e10ebddaff",
      "translation": "如果你们消灭拉提女王，我们联盟也一定会给予酬谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5015dda628526545641925cfcda75007d8ead6ea0eb35c734d1f0e560809351",
      "source_sha256": "cba1bc86bc97077a29caf3fea193fab94e754baa09dd28f7fe5774336e13004d",
      "translation": "听说拉提女王和其他拉提族不同，戴着特殊的面具。消灭它后，请带回面具碎片作为证明。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2bba0efe2526ce6357db0f78cc4d1c3a54f4f95dbf32975b57204a52ed8d696b",
      "source_sha256": "56aa63e644ee0fb2caaa38e9b010cadb30de2c12ea685c6fb80183c4c27fd70f",
      "translation": "谢谢你们愿意代为解决拉提族这个麻烦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad90e4db2950ca3f0af092e46f11d54faf351b767aa522a607da31fdbeb15fb7",
      "source_sha256": "c26f3998cc5504ebf4d6c2ba2bc343e8c7db71d8f5e58d411c844ccc0a7e3c86",
      "translation": "如果有其他事情，那也没办法，不过还是请再考虑一下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e118762beb07dc9d0faacf643d92ade16875a7b6e64be4d77cc616d943ceb002",
      "source_sha256": "66264f2f7ebf1ebab82a7af4ce0506ec76b06861a19b4a6b052c8443d858adc4",
      "translation": "听说之前委托生物学家制作的拉提族毒药已经完成。如果还没去过，请务必去一趟。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7812924176fcd5feac36d0a4051d2a88bb648a547100a96212e37321c260673",
      "source_sha256": "b7051e9feef33b6019869d285d3eaa51d409ee6f622eac13b8f56725d379279a",
      "translation": "辛苦了。多亏了你们，我们终于不必再为拉提族担心了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8f012b4f4a5c56a1f08784d745724137df9f7d42e05c6db0bec2aa9fa3ce0d7d",
      "source_sha256": "f76da06e994c9b1c2e1ba90c99ad180d6570e3a998dee676328937ada325c04c",
      "translation": "请消灭拉提族首领拉提女王，\\n把拉提女王的面具碎片带到公会联盟总部"
    },
    {
      "id": "coalesced:fe425c6d650087e55c686dd767a49ab86defe71d3550232bbb64758d7843697c",
      "source_sha256": "f0bd99c965d75d70fe719bf317119d1e5b31783a0bf6e4e9caffa93120de5b17",
      "translation": "QUEST%s: 拉提女王面具碎片 (%s / %s)"
    },
    {
      "id": "coalesced:4f925058dce001a40a08a35403da376360d801dbb82f0591290b3e080b95abdc",
      "source_sha256": "8f953f688f25dfa63f4d592e37bee00c0f7707ede55cbaf7a4d52a9ff6223410",
      "translation": "消灭拉提女王"
    },
    {
      "id": "coalesced:7be20e7cbac26f952acf448d685a8d0c5d75b40512695ac72e3868178d9924c6",
      "source_sha256": "1d3db041a6a651eb49749ba06e65ab10da8791e4097cd4014962b70d716dfc55",
      "translation": "获得拉提女王的面具碎片"
    },
    {
      "id": "coalesced:d5ef0814f165d604ac13e7096ad64aa4ce2ebc9ad162e16f0fb5ec90fc98ce47",
      "source_sha256": "eb5875bdbadec458bebd166cebcbfa74b0364c19f79c16a326fd099ff5c7416f",
      "translation": "拉提女王的面具碎片 "
    },
    {
      "id": "coalesced:97286ea8ea935799c3587fdcb51cb5e9e8053c90d6db11b45088bb97879283de",
      "source_sha256": "4842c779e4c864fbcb85ee6c963ce51f48bceefac9959bffaec8c740aadaea15",
