{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:3f91a09ed085890f05a5c0ea0051adf919de199fb07276a0ee46249299e2b9f1",
      "source_sha256": "4c621a6838b6c7e478a4f47062e580d3634045e42c109e8894fa90703bcab38f",
      "translation": "看来……我也到此为止了。"
    },
    {
      "id": "coalesced:42dab618ede5c7b3bd33b4770b27f967fe73c6038cf93cdb2346dd5731a18df2",
      "source_sha256": "9db48b670478b9b5829638bb5c5767f423bb7cb8fa395ba37697267fd105fed2",
      "translation": "快杀了我吧……修恩扎伊特大人，请给兰兹海姆带来和平……！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4369d6abec133c6a40fbaf845eb24050f4c49040d1dcc8d87a0ad5a333b9d351",
      "source_sha256": "549ccad2907cc5d94ac0ce4e4c3c1bad8a10152ecba711504203fc5e06f17e42",
      "translation": "挑起战争的家伙，能带来什么和平？那是公主殿下要做的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3326b3291d1a778fd262b5570a6546f7d56d0d16ec3797cdb304cf877a0e481b",
      "source_sha256": "9770feedbd6fbcf16baae99a58b39b44927d7c13bff3a10b25ca1be4b320e8cf",
      "translation": "哈，哈哈……公主？"
    },
    {
      "id": "coalesced:30fbb1589e7d1942a14c5bcafbc0ab4480ec0feb9a96cf2d2a915fee86dbbdfc",
      "source_sha256": "80cc3f11d570f7098e06ae1580d24366710fb450f5732ad87061d4a8f5a5d0ef",
      "translation": "连“王之证明”都没有，算什么公主？"
    },
    {
      "id": "coalesced:8729c2b29a49f6a635abebe386109caf7c89aecb0742bce1492e35ddda278418",
      "source_sha256": "91337d656f16ed8662c8468b15e7269ddc99c97560b810d53ac19a4b9c1025aa",
      "translation": "王之证明……？"
    },
    {
      "id": "coalesced:ec9ed7330b7cc3ec737d78ba56930dd47efedadcce2726076decdab133669404",
      "source_sha256": "61954f4b5899cba029421cefa8d943084145c92e2f9795745bf8451769b190da",
      "translation": "哈哈哈……真是个笑话。公主，你连那是什么都不知道吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bc311e59e64c20b6c608e33643c7b0ad30eb47a6c66f818ce090f306abab0730",
      "source_sha256": "8d98b36cb66590f5d2d23471480435f1997251e8e955c1f6e94cad5999ff4e7a",
      "translation": "果然，傀儡终究只是傀儡。"
    },
    {
      "id": "coalesced:960aa8a8e74c7467efe325a6033ebcd3e7127ed7114157155687c6fc2464d1ef",
      "source_sha256": "563ab2486b4b1491fb8fd413a698c5a7922d4d9f9e8bbfe69e228ae90a2d3c75",
      "translation": "你这家伙，还真敢说。好啊，想死我就成全你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e874d1f0d3c3347c912566a652bbea61c5d7655c7cb06adfa8673e24c72ee2d",
      "source_sha256": "60d335e2f43af6a974398d5e3146a38c130277b4a348857dafc362dda5b4b7bb",
      "translation": "住手，克罗塞尔。"
    },
    {
      "id": "coalesced:d0a2665477e07c1e3cf271f35153e37fa6337173cdbad1c2e1a22e2469ee3753",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:ba378326db8c072fb9658488a9367062e21b885235de43377a0c833cb07b6907",
      "source_sha256": "44ff0bca661b18e8c06440d6a6148a99dc80f5ac5c9f9a5a64344a7f2e415ed8",
      "translation": "关于王之证明，我以前听母亲提过。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:407319604cc24a253b1b6b43f720c68471145b6f947139c0100ee30cb94cb39a",
      "source_sha256": "23c5d880a62fd577f3b223a0ce2679bd073e499f4feb8f497b5ee1cbd661da23",
      "translation": "她说，那是只会赐予王室后裔的东西。不过，我一直以为那只是传说。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6978b8116ae0282d4205f7cd30e15689ef9ea91ea97b65e7cf5d59e23ceded7",
      "source_sha256": "7bb7ab8c4088edd32b81e21a3d0d635b31b5e4b720c358e10bdc115810c8f381",
      "translation": "“寻觅王室之魂，倾听其言……道路便会开启。”这句话，你也知道吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28e6f853f757b6346dde641d2d2d0eaff0d477683ac5d61d8a4b47a64329d8e4",
      "source_sha256": "3c82be8a6be100f4b282beadd1aff4b4f973d291de13b54bb1b10828f0a11cf6",
      "translation": "没错。和你这傀儡不同，修恩扎伊特大人早已迎见了王室之魂。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9442cc928bdd31428c8df21ec13f232c78726f060e46f89e67152629bc27fc98",
      "source_sha256": "9f252ffe34c797c4baef1ee8147ec7ffd68631aa9b20d398a1dfda154107e186",
      "translation": "而且，4片王之证明中，他已经得到了两片。这才是真正的王者之证。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:674e5975e5408410108ffb3f1fabb8507cc2d9d22266d5f98e029db489b031c6",
      "source_sha256": "01079e8e0e244a1da5f93310fd9ebcabe9381bb90694c54bd0413a55f397ebf4",
      "translation": "够了，闭嘴吧。"
    },
    {
      "id": "coalesced:c2d652cf7fd4e4a0cd8ba256a29faa3f1201f37afe2f5e2087af6465d1f86d0b",
      "source_sha256": "8a8f90000d0dd6207f64891078e46c8c6e314004a698e6d1ab65673cea531485",
      "translation": "克罗塞尔。"
    },
    {
      "id": "coalesced:b64e518a25b521114c72a9ff601e8f42f45d257f097c3ddf8f8ca39737b68292",
      "source_sha256": "0de38985fb6a7ec096a5e3c98347b57352c0c97d7a4f6ff8a1e3eec706136b56",
      "translation": "公主殿下，你该不会是想说，就这么放了这家伙吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c932c88e4c13a7e988729efc7a4ae211d2cb7d0d4a66d810ec693553aec299a4",
      "source_sha256": "b37963cd94806c035a192d335f81a5328c0abf4acb552f6dd3281c33ca7ef357",
      "translation": "没错。放他走吧。"
    },
    {
      "id": "coalesced:a0aa2b0ad99ca4eba971de566e509feb37a6bd16eecd0ce9c799a5f0b58bc3e3",
      "source_sha256": "ea63d14269570bd383fdb954ecbff5a0775d79b88853803f36268354332c4d92",
      "translation": "这样好吗？……他以后说不定还会像这样胡说八道。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81fe08734e9cb5200642a2224641b259bc45d165ef6234b16bfbc602dc7709fc",
      "source_sha256": "e031feb992a2cdfade2c2400c78fd9dad8357ae6eb2c92e643ec2ec4c10bfcfa",
      "translation": "没关系。"
    },
    {
      "id": "coalesced:59f134435190fb8fa38ef0a875747dbabb98e4326101c8f952994c4a18e10279",
      "source_sha256": "2e42829779ae05a3d5834c560a2db59eca5c6875f4e573c3ab903ac343379c70",
      "translation": "好吧，既然公主殿下都这么说了……"
    },
    {
      "id": "coalesced:4d832f0a6105990a784de70ef093671fd8743bad1e22885203fb4bf39f2ffcfa",
      "source_sha256": "6c66f3f190561df779b228d2915bfcdad0a325b51fa93d32c9e4114194c56e27",
      "translation": "哼，不知道你有什么打算，但别以为这样就能让我回心转意。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09b417c9fd65fc291b22065f1cb3602fddfe84931b0cd6517226fc6014bcc412",
      "source_sha256": "1274b0df2248d6cecc20b1fb650b8159bb192e3c71c91ce7ae0565ec5c0961dc",
      "translation": "你这混蛋……不想被烤成焦炭，就赶紧滚！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:422d0ba51fb86f19679c10453afe56110efaf71aaff998a84dd44ecf43d9de9a",
      "source_sha256": "bfe001416afc0e4aa51e4c1b874373efcc0009fcdbc978f041fe54eed5f3d068",
      "translation": "王之证明啊……"
    },
    {
      "id": "coalesced:77de6c2eb2469e9b97822b87ae465aedc0edec452eefdba8147f6f932c3fe233",
      "source_sha256": "6192f84e8686aa679bf5654714736ebdd9e149c1dadb34dffae8c89ab18489bb",
      "translation": "真的有了它，就能被承认为王吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce0bbed8c030c905dd4367067d3c5d9d8c7132f9db6ba2d4867c25b5ff5bc180",
      "source_sha256": "06be093ba01841a6457ebc29708b7711623aca14995f8ade5c4762f7c6d83b8a",
      "translation": "辛苦了。稍微休息一下，就回阿巴泽特吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b2af8ea0918c4ad7abaebbc45fb92abc122a9396783efcd62d2cf51499ac6f3",
      "source_sha256": "f419f5c8a366e659ea0c81502da467a889ad7539a4571e36ff1705c67fa0e26d",
      "translation": "呼……战争果然很复杂啊。虽然我明白，有时不得不战斗……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f0bf2ac8c12490a090997242e921c75b5273e389dcf38a12b7521eb4e2c3b25",
      "source_sha256": "9417adfac6123e924750a6c0751f7977279e0d9bbb2b8ed78f15583c622a7be5",
      "translation": "怎么说起这种感伤的话来了？这可不像你。已经没精神了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:137de6894422b43447ee3c8f316bf30497904fb4fdc5cd1cf3bbf31f893d74a8",
      "source_sha256": "63520e4383285f253bcbaad1d8f70365c95e43e9c9961b17750a1e4132badf67",
      "translation": "可每次战斗，我总会有这种感觉，这又有什么办法。"
    },
    {
      "id": "coalesced:943dc8a83c06928d804c0f4ed1b71b320de13ab0236f786a48d27f9c8de81931",
      "source_sha256": "ea5d90cade0b7f14c731fc9fb2c261b0e0db25d8fdd2453d6260a514b672b5af",
      "translation": "阿尔戈哥哥，人类为什么要那样争斗呢？当王就那么好吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5a82da2dc43b659bf41a9c9ce8277524bb496d9d009c39f768018b14852746c",
      "source_sha256": "fdec69d1b0643bd8e576eb25f0303ce3c8211b0734b8a99e28b96b2d4b6ae98f",
      "translation": "看来，对人类很有吸引力吧。虽然我们很难理解那种欲望。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:048b7782372576bd09b789bbbe878840ffabbb2ddc23387ce18f5d71c9e98255",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:bb7bb28020b5cafc0ab6dd9c0b79dcca30389e2c73a4fe2f60867b9e03865f57",
      "source_sha256": "926c831016ec726d68752dd1c56e8c4e2bd3a03034bb1d8475c80c8e94dc5e23",
      "translation": "我去这附近转转。"
    },
    {
      "id": "coalesced:48a2d01c3922b136e01d289b2391d4241b1b73ef95246f2b57abc179a3fbf37f",
      "source_sha256": "8c9b67538f4f6ad3cdb9c7f5f5119b944f92ba336a0d0ab55bdfa4dae8e00ec4",
      "translation": "咦？为什么？"
    },
    {
      "id": "coalesced:8c3dc51f0e68ca2f03e934c478878198089ec9404b970b7c116dc3ba40da485c",
      "source_sha256": "5f2d6a454c69b4f3a2dd4282b8557c189c2a9e69139e3b6e9bb47c228ce69f37",
      "translation": "我想看看周围有没有什么异常。"
    },
    {
      "id": "coalesced:16d54c60f90d7c63be46f2aa6d3d4fb85d9e545471df7851a1e0f83ed3a04ed8",
      "source_sha256": "ab7cd32f819cbb372a22d8a3b1848e030d8773900bd6c31420f6fc3c5c7a4b85",
      "translation": "那种事交给我……"
    },
    {
      "id": "coalesced:86886850fb8b789546a3904cf5a23d9fae5363b20b6bf530110d46a6e2642728",
      "source_sha256": "3fac660d0d007eb2b7bfe71cef288bc3c460ca263987f1d51baf4ea006992813",
      "translation": "没关系，我很快就回来。"
    },
    {
      "id": "coalesced:bf5a00905d1d742748f3577d0221ccdb514e2cecac4071ad872117613a8b47a6",
      "source_sha256": "fad2eaf21c3b59e8b08c90ea76a4a9c3698da2a4ba5352e6e0ff2fce3231f731",
      "translation": "要是发现什么危险，就马上回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:738d52feaa4de1a76eb02943715812ae6612e0d13f0a603611c398df2126e782",
      "source_sha256": "f7aba9f97b78919607c958e8fef9d91b5fd4c0fe817de613d00413789c35019e",
      "translation": "嗯……别担心。"
    },
    {
      "id": "coalesced:2962763b4aad936b8fd4236f3ac09e47ba3b04a2310e190d8162cdec002b3526",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:af2e31383b1d5d6e06afb0ebfd7e89f2af276d891f7e3702b345e532bcd2b36d",
      "source_sha256": "a9fffdee52927dd395748d5f74c3560a4f5f55614bf41515d2b07477f854e1e8",
      "translation": "那时，大家都看出了洁菲脸上的忧郁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1737ee6adee80d561100edf1f12b7594bb106b12b6108fdf8d0a11de08b3a5c9",
      "source_sha256": "1542892e7f4eb8a406abd206ba5ea0770993f369cd4f2a4a53c58ab525bc7462",
      "translation": "可是，唯独我不明白她为什么会那样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0dc8e6cec4cc2305f228aedc73e4a4b1380ce7eb7f9f681e9e708779b9b1975f",
      "source_sha256": "07b06e978708b68473f0caff57509a239a8f1ee0ac42364ec1e00636a3fca815",
      "translation": "我不知道，她早已赌上自己的一切，投身于这场战争……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c95683d133ee86aa93661f3639cc075e673f977ac6e1fc8a9e96574e0e8c585",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f91ec799e2e50328397d78ec3ecb9fa826a67547c4f26c800ed69c4b0282d21d",
      "source_sha256": "6b7ee245f724cc57855bd3754f8ff1794c31bd6450913ddeac6aa1b24a30544a",
      "translation": "您去了这么久，大家都很担心。"
    },
    {
      "id": "coalesced:0271be5f1b703c3be1c85a3ed15bab7be2efa891c7fa1fcf792c7a2829b94344",
      "source_sha256": "e1ee0dedb5c079d29c7533228e5de1040c8bcf08c334af34e048f923f0cd42c5",
      "translation": "啊……是吗？原来已经过了这么久。"
    },
    {
      "id": "coalesced:ff10609aee562c732a2ead0c0f8befca3b11c787b6fcf0aef2071672b171c0d5",
      "source_sha256": "7e36f3ab6266dc462d432095c925357eb53d38a8205c0553a38213a5429b7995",
      "translation": "您的脸色不太好，发生什么事了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e1b0cb90033bf9a722a4abe05ff908fd975fb46510df7778c681f9626b6d396",
      "source_sha256": "d8777c4718ef653f4e6cf8a5c8b1338d2e216979251b486255cd1df32ee7b6b1",
      "translation": "没什么。我们回去吧。"
    },
    {
      "id": "coalesced:d8317523abfbf772fda455bf89b54bb11c11537bab8b934091eb0a031a1fd864",
      "source_sha256": "c7fd65698a5069344209e423f078575229489d9c086ab354d0faf9d95619672c",
      "translation": "说起来，最近……确实净是些好事呢。"
    },
    {
      "id": "coalesced:91c4cfb360b18b9cd8ade952a27f40a648d90b346b674a3cf7141abf61012d07",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:3fcb33d668a3d9acfffb6d6de474af3876eaf12019b0d8f7516182c89631a32a",
      "source_sha256": "10bb121c6bf91cb23d8eb2824d5694f5176845503681a24cbf2fea9533b4b940",
      "translation": "啊……"
    },
    {
      "id": "coalesced:9397e781b06bb99df301f628c064cd9fad8dc0ae7d2d75b75a3728c3df95b7ae",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:6bbba1a549b94a046b59c69a3e4c86d3e9b47954b5a7ef0834418aa7eae40c37",
      "source_sha256": "eb9998ab685788f7df9ef4751d9057e7a783e90f738cfc7844b456299f113266",
      "translation": "那个……"
    },
    {
      "id": "coalesced:5094507180a0480e00cb549c95823e88fe87cd67e3de8aa97ca2c2702aa26e3a",
      "source_sha256": "3591e5439b1d2e05500126145688d17338074e45a643a8215e47d2b7bcb9c4c7",
      "translation": "嗯？"
    },
    {
      "id": "coalesced:8808e280e6346bec9ec28a23185c5939c948e1dc1381a69203b3684ce0205478",
      "source_sha256": "55d9128291547e4a73b8efc724c13333614bfa0bff3d55a566bef8518aeb0a12",
      "translation": "请问，您和亚历克斯……关系很特别吗？"
    },
    {
      "id": "coalesced:14236b4ecc6b34390ed26fe4cfcc5cff83dd9176c1d5454d2e59a02a17b14df9",
      "source_sha256": "fda065f6b438a70c0c8213de066a78b6a238d0874956894dc3835b6648ce7125",
      "translation": "我们订婚了。"
    },
    {
      "id": "coalesced:43d78a7667a20cd08a660934a3c791f71d1b2c40a00f925c320bd8ff42d4f8a4",
      "source_sha256": "730e729f81c0aa03ba784024fe6f8c3383d729a8488593180ef97a484ecb40d3",
      "translation": "……订婚？"
    },
    {
      "id": "coalesced:723160746d6b6e7ae526b99af854567dcbb691273ed3defb1da0411c8aea4009",
      "source_sha256": "a5da9ac815b36278292939992b8ceb0dca4f198fdad53f7cd9d2ddb32bb20a3b",
      "translation": "嗯。我们约好了，等这场战争结束，就结婚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc3d0920018f94d28642e6d69d4b3a8056bc7c5eaafb17e51703a7ce86e4bc7e",
      "source_sha256": "e9ff4d75431a75f13cb9857f17d09034e58264fea879ecc504c0e6b0d63f2a1f",
      "translation": "啊，原来如此……"
    },
    {
      "id": "coalesced:34e46abc0f7781e04e506c0be13cd03e4a68ab4ba45a31fe0b478ad3d444d487",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b611a2859eae1cb1b4f19a99e9ad0dbccaa92c4f71d5726d74dbb9aa5ab8e13c",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f596def3c2a2754d88f9123e7f4dcbcd3dbb342c8933e94a21c8e7790a642958",
      "source_sha256": "4476a3aea63021ea484e2ce2ab45e6c78a6218ecd3bac7d6d7db8085020b3b66",
      "translation": "……回去吧。大家应该都在等我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b833c90e3b80f2b8049dac1c0a0cca8636b29d978fd5ff037f1236fb3ac7ad6",
      "source_sha256": "0203cf338f8353635086a136d6c51ca863a9ebef47641f5e90232ca36a8afd95",
      "translation": "这场婚姻……是公主殿下自己想要的，是因为喜欢他吗？"
    },
    {
      "id": "coalesced:c6c64788b0f9a42a63d6111cfd6a98d9fab9ed4d0aabdae9ddf4b469c32bd641",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:235149bfed2a5c1e73e553f09dffbe9c8eb159474fd1adbbef5a01b6366d75df",
      "source_sha256": "d797725571e210ef75141f2ffe92b17ca863339255292c55cd8ff0227e19c862",
      "translation": "这是很久以前就定下来的事。"
    },
    {
      "id": "coalesced:673d86eedc6605364a2f48fa6989b8eb8848ca8108773f253784ec82c350bf91",
      "source_sha256": "7fcb1e8366f75bc146c9b42f2243391935f8d255f1296fcafea0c014bffcea1c",
      "translation": "事到如今，我不想再提过去了。"
    },
    {
      "id": "coalesced:4624089756457ff24c132ac472cae7cbd25ffc3b343fb629d5a79b7f4c2fdfc4",
      "source_sha256": "289e80ad5f022e72a195dc9d6f8968e00dacfb2a7b4dcf987eecb28f0fff1a88",
      "translation": "啊，是我多嘴了……"
    },
    {
      "id": "coalesced:2fa87a812bbe30d61fb9f33d8a0be880389895acfada70cc8912a5658bdb102e",
      "source_sha256": "22567315dd65132318f147f99c2118027c14648cf1b5bbbc2edfa13ecb06260d",
      "translation": "算了，没关系。"
    },
    {
      "id": "coalesced:d6a1cc677eed90876562d51248e39997287a0ef205435d2f1fa16546bec923e2",
      "source_sha256": "4cbf3696b891a82397d959fc8aeebf7c1ac566de1982ca83751ab2e92484b261",
      "translation": "胸口仿佛突然空了一块。"
    },
    {
      "id": "coalesced:2a6b35d2ede045fef8db635809668b57f24e137969d66c9d28598756ab8504c5",
      "source_sha256": "30668d1c95128c63bbeb66000efd75ab2855a7e453864d82e6add781f375513a",
      "translation": "她是公主……我原以为，只要能在她身边并肩作战，就已经足够……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dac13748e6c010c17473874916120eee781ad446a38226b4d5254a68e095a639",
      "source_sha256": "60c50f6374acd7eca0781af287a17562355a5451a2115b5ff191d1f670500df7",
      "translation": "可为什么，我会觉得如此空虚呢……"
    },
    {
      "id": "coalesced:ae127644db589f8079dc0ad0f2f6fcf7b8bf00142e3fe5f3afe1c15e7fb9d672",
      "source_sha256": "f35a0ca07777a67346f30405bc1c1b23ad6533fbc67f55c1f251d34bc494fff1",
      "translation": "杜南丘陵之战即将打响，反哨兵部队已接到出击命令。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9efb2036d486db454e11c51aee137dec5950bfffd59906db9cc722863976bd7c",
      "source_sha256": "e5031832bb19234bf124683853b7560daa361930b14800ca4ae52278094efb41",
      "translation": "请各位准备完毕后，向劳德大人报到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91db62baa3fe6adc0e95ff206d4a0f20ffe34ed657b7e4652ec634cfa41b35ea",
      "source_sha256": "6d03c7c14f3ce677bad46cf2b77210a447ecd9f1f6677be8d26fd6eb6b6753cd",
      "translation": "杜南丘陵位于杜南平原中央，是这次内战的激战之地。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d12f15cc67260e8bf5dc2c2a614a6cbb8ab0ce0dcbeaf64690679721796e52d",
      "source_sha256": "206e78627d1026ccd6f4abd5ac28f323120b63297df7e7c28ba8a0b914c22999",
      "translation": "那里驻扎着大量北部军，还部署了不少北部军的攻城兵器“死亡弩炮”。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e9aaf24c0f2bcf2c3eb37e75936e563738e6106febd20b616807301bd612ef3b",
      "source_sha256": "049bcaf684eb59e056f1e35c19a510701f8694fb53b36fd0e7ad1f52f772481f",
      "translation": "杜南丘陵道路狭窄，大军无法进入。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:746b9248cf3b95e42da2e01502182e6ee60dae15db078a95fbcdebebae2f2064",
      "source_sha256": "60782c4aab1e741ccdef8749c3a88b7723c49b0cd5cea0cbd32585735bcc5e1c",
      "translation": "虽然很危险，但这次必须倚重身为精锐小队的反哨兵部队。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a6181a4bca6c45fc4f8e2d571b23c32ef3b1f6091611e18435b147026029e145",
      "source_sha256": "acee33ed2333fcb41b94965413b8ad3d366688635d9b836fd1a4b5bfd3d1a881",
      "translation": "杜南丘陵顶端有一座“黑刃要塞”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:42c12c54ce327360c7820e09493a7bac9349bee6283706ed953e23243d48ae55",
      "source_sha256": "440c8b3c3e91fb019d968430b292e9a3453954ba8a4003105e11319a515bf3e3",
      "translation": "目前镇守那里的敌将，似乎是最近在北部军中崭露头角的人物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81f69f5034e41df0304f78e8bb5e795b13495d248857087b0fece666fd995980",
      "source_sha256": "6550eb58337dce94c30dd2d25f8ae8d7fdcfb6d699703d5c1dafdd9c6abc1c43",
      "translation": "到底是谁……"
    },
    {
      "id": "coalesced:85cd99a43975aa39bb7418ceeb7236c7ff254743cbafe38e5f0b66a15432d87a",
      "source_sha256": "ee849ab10a42c04e4645445826f3dfc6b67ba221215f49a54cb7bb3929ebba19",
      "translation": "遗憾的是，我们还没能得到详细情报。只听说此人实力相当出众。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03615c4fe64b2a99fef293bc39f3043bb374258c69757d68eb9d85e821ede45d",
      "source_sha256": "3b6812423ba1b3bbef30d543ad34de06477ada647c277478e52fb188bcf8ef36",
      "translation": "另外，这次战斗还有一件事，请各位格外留意。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:70caba692c17b3ce5f36583eace1631c1e16eb6fe0588e7dcafcbfae9f867b34",
      "source_sha256": "4970ba3b09cd83916cf056e307bb6e8685068537ccb344e99c34cddede221679",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:58ccf234fcf3c40f15dd6c3f95e1efd5278032225b5b60c9b00fbef6294c67e7",
      "source_sha256": "368874d927e015e88ed369ca76bd150a0368a3abcc4862b3be15259fe46b763a",
      "translation": "前往黑刃要塞之前，各位会经过两处哨所。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:79f9f7ea5ecfcd4be68795e02ca1c1e76589b68d4070a22c27c622cc3caf77b8",
      "source_sha256": "55e5d346c02a5c8b12491e0226720603a20e2943a6e570035392547d23517fb5",
      "translation": "不过，每处哨所都设有晶柱，据说戒备十分森严。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ac83a5475a54243a53bd275bf4b920c7408fd61a02eec2069cebd2e273cddc9d",
      "source_sha256": "5759510de9f44c28e55622180ff6976a99c777b239d4b70f9de7b9b02442a9d5",
      "translation": "确保这些晶柱落入我军手中，也是此次作战的重要目标之一。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a281c428a1a0ff6ceac31556cf6e94549a6b69a3c2f0b5a52653b02919fee2c4",
      "source_sha256": "f6e7f16766fe16e86745a3840ab0daf41a2b32f38fe91f380365def5e7b9c80f",
      "translation": "各位占领哨所后，我们会将北部军的晶柱转换为南部军的晶柱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c61c2d4b3ecbd2268d191ad3051347c9b2d2f6e967f9155342225ed436f0567c",
      "source_sha256": "cd39d9a4643109d3a4b7dbceff2109b2e4f89e9913da3763aad87394f99f93af",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:1a24e06493de6c313c91e5d6cb5b48b0a5325f847359a626d4d893121a5b1781",
      "source_sha256": "2f0bd26fe639c7d78db8a1185ffec06db5632050dfac152cf4e2f6f79822f86c",
      "translation": "那么，请出发前往杜南丘陵吧。"
    },
    {
      "id": "coalesced:e4673ae9cba40b2d78e6172011dd939d16a9139cb09333ebd2aa1a30657ad915",
      "source_sha256": "40f1200d8b4d87fc5ef300dc0ad161e93e69c5bab80466e56cab2e62f26c2367",
      "translation": "用卡蒙德强化武器，还真挺有意思的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14c6b65bf6eaaf20494b3d89ea020beb9e80abd32f76a24cd3c4a85485cad409",
      "source_sha256": "44bb62c1463c742f491f1e64e9f35300d9860960224ed0be2f7827b0e932649b",
      "translation": "再强化一下，就连狼人那些家伙，也能一击打倒了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:829dda42d746d92af8d6a208b0356a6eec5e7f4b8392a4d2ea1a60bbaf9fbe35",
      "source_sha256": "66c2e083fa1a5089baae3b27b513bfaa1ee246f1b7ac3aa4676b7a8ce933d186",
      "translation": "上次辛苦你们了。"
    },
    {
      "id": "coalesced:cc894b58da09e76fd1e4301b027e7e3f4a3feb659c669aa78eea9736661f927b",
      "source_sha256": "926a5568de35e5377f4b4b45aa395fce32ce79cb4ec2741a1a662f22c9cf0825",
      "translation": "要是再需要帮手，我会通过库布联络你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a5dad0330cba0fca3e3661b28367f908e5076191cfbeed312a4ecf87f53fa7ee",
      "source_sha256": "f585d02404a22706834b66972798560b796662a1d8681751728cc773ed6881a8",
      "translation": "欢迎。有需要什么吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9afddbfa86de0730e0bae32882ba59cedd9c047c12d4c83f7911488331642079",
      "source_sha256": "3871755792cfcceabf1168df29d65b4ce2692f53e24986e766e27e01bd87d4a2",
      "translation": "您在找什么？这里什么都有。哈哈哈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b29ac9fcd6ff26e3cd4bcbff9071988d8396e1f92e9d0c4288442767e108488b",
      "source_sha256": "7157d7ce1d47a632a89942411beb60d63d3767d7737a63ab9266ee4ea30aa0bc",
      "translation": "当然，也可能有些东西没有。"
    },
    {
      "id": "coalesced:235c7029c9de1937a4099f56148d0922bc9c62955dde235b3843d2449182c497",
      "source_sha256": "6486b056b7b88f7d74f3041fccad415e7f3feff3b272c4bb709402c1767be4e7",
      "translation": "施耐德先生～上次处理的那件事啊～听说完全搞错了呢～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab0e9988e990129d415346b9be8de98f14ffd76883ab465872123246cef79d88",
      "source_sha256": "c53db48c591f787f4cb59cf3b8e16336f9e715d2d01155c3f2615e9483776cfd",
      "translation": "我是负责商贸事务的伊尔。"
    },
    {
      "id": "coalesced:0c9ca5c4fbccd6adbcd162466a7d2454e777e420775faa2732d46cd12bfa3c7a",
      "source_sha256": "3541bf93a0ced78d9e0f413474e341b5562124c1c08dd7a166a539556e54a9c5",
      "translation": "施耐德先生～上次处理的那件事啊～听说根本毫无用处呢？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c496aa8698920582f3ef559250cbb096498d362d3777c2f638ab4eaaee18e88",
      "source_sha256": "dcf53f8d463f89d4d06a28ac6c54a79a81f34e27bb8f258fb3d13b6912f84377",
      "translation": "我是负责盗贼相关事务的伊姆。"
    },
    {
      "id": "coalesced:214a452710a321dfaa69edd7bb612468948e3fc43436dfc78d40c84504891eff",
      "source_sha256": "a387e81509eda2b8b6a5d96dcd9edcb318c128f6c9cde19b207fed98915f0796",
      "translation": "施耐德先生～上次我拜托您的那件事～怎么到现在都没有进展呢？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fde4cd11a7b0029377014f1fc1b3888739efe1941b64a177ccadcfb996a9b1e7",
      "source_sha256": "fcd2ed30ed9aae3c759297ee295e717df47a6646f93651af7ebbe529542425d6",
      "translation": "我是负责库存与仓库的伊恩。"
    },
    {
      "id": "coalesced:188a056077cb542c9d61e6b4264ed9b6482aa4d2460ccf3b89a67131f33c17d7",
      "source_sha256": "db1271e440c5fa6eb2c3a2a112d5e58503092673cd07338d63fc32d31f5170dd",
      "translation": "啊，吵死了！谁来让那几个家伙闭嘴！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10c272c3bce3f7fba6c2730aff5b7c27fde30c7729f366956c13eda13076b9a9",
      "source_sha256": "1661c9c82627ce60b4a38972628dfe845ad0de6eb4a5ce79957cf334dfaf54cd",
      "translation": "听说贝尔福特不断有灾祸种降临，整个城区都成了废墟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:36745d677a35044babb0ed4907c9d267e859cb8c32c364d36fe243060c62a647",
      "source_sha256": "df9fb228bf95ff0c0f582e253175a7bd84ff6b8a01e64ed02f9d4750c59647db",
      "translation": "得赶紧找个地方，妥善安置不断涌入阿巴泽特的难民才行啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:82b0f72e838ed36b100704589cf533f5777b16cbbe0b3ec610d781608de0767b",
      "source_sha256": "15f7603558f2e0932b591d8418f0c2df7e580031122b2c39a567b634efde149c",
      "translation": "啊，真是的！再这样下去，连糊口都难了！！"
    },
    {
      "id": "coalesced:e475ca69ce3f6b7be28f818d3a2c1977a68c17c4b3475da99627b393d3d6959e",
      "source_sha256": "a5f1d99aa98092f5827bafc402a571795251475106f0b7f7878f90cd267bf958",
      "translation": "最近真是顺利啊。既夺回了老狐峡谷，又和马雷族结了盟……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdb5fec6f41e736dbd8378aed5a6aa303a5465be21caa7d049afeffe0e49991a",
      "source_sha256": "69ac8c58cd57847ab417bc2ca4602d734ef4367747668e056b4abeb73ce491af",
      "translation": "这种时候不喝一杯，还要等到什么时候！"
    },
    {
      "id": "coalesced:e88f5bf1818e7f6b35a261cda25e4c67b8049ac8c4bb448dbd1068416e911b99",
      "source_sha256": "ad9dc4ccce0baaf3851ca7da06cc800b58b5a0686756aa4d98c9de8e580f75b6",
      "translation": "这家伙就是太爱喝酒了。怎么劝都不听。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9418ddb161b93b3111cdcd775e54d2336a9ab7e3ec0a7d966a48537b43b25914",
      "source_sha256": "b397239f33d786b20378f12aefff5273728ab70e74b938ead1721d29aefbfc1f",
      "translation": "这里，这里～"
    },
    {
      "id": "coalesced:2c434cfa657043ec9470d0bd18bc31c92e419f0f800a94d4a196049bc9390068",
      "source_sha256": "94fc8d0466d8d653bd1b5dac399c986256d527b6a470424abcfad41c80cd25f4",
      "translation": "等等我～"
    },
    {
      "id": "coalesced:62e055c1e61576f8bafcb01a77031c9de01391a8b6c76c77b147707f523d73db",
      "source_sha256": "0701482fd6c9a5fbf704c5dbfcf3ec70d77a1a6813b4937f2f7416c1f56b50f2",
      "translation": "听说老狐峡谷里，还留着不少北部军残党。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:640757de595da08cbcef97ea67458e55f150014dfce384d2ec7dddebef2470d0",
      "source_sha256": "04fee95995ec68967fa550f9a288bdc66c2fcef25a5ae4cce59f22f6f6226a72",
      "translation": "我让你去商店买的那些东西呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:772de4624b44f56fca5f81cfbffa19fa928fed35477f1372e99c028915bd24cb",
      "source_sha256": "4b9ceeed06c9226a5990fc9fa5dbe5bcd1bf39ec33af5ee05d17e9922721973c",
      "translation": "也许是因为战争，东西全涨价了。那点钱根本买不起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d257c0f5bf251c3aa292b4e253e8ddeecd3fbc3a431fba724c79457900b4a92",
      "source_sha256": "9ee58c7fe1d2ae27f11458dbfca25c97007c5790b76379f9af03c3763b1979ab",
      "translation": "所以说，你平时就该去干点活。"
    },
    {
      "id": "coalesced:5d7c76abdfda4683344454145073c172eae1981f27666f50ed5c782cbbc7af7c",
      "source_sha256": "8b88a75d497c413398d44556fa9c9294ca420371704339d8ff9cc2840d2ee438",
      "translation": "整天窝在家里，当然连饭都快吃不上了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c442929268bc0dfab2e7aa29201ac68e5bd218cc823d571a95df7701ce75a82",
      "source_sha256": "8f09f078db6eac07fe606de1c80bb16e492d91919b826f29b6628f4900c725ee",
      "translation": "这里有兰兹海姆最好的武器～剑、盾、锤，样样都有～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3b1f8b3aab6f9b6baa1e34fca0c89e0f125eda03d3e2f5a21498723325592978",
      "source_sha256": "99481c041066844d292b20bc178183e1f9b5b9546f44624678bc746754948bfe",
      "translation": "路过的各位～来看看吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7eee57740ce30f8f4df5871d8835a3d4f52528be825023b0ef8d81e194b4fe9c",
      "source_sha256": "2990cb694d1a58c5b0f018581b1c609080a3f9548cf95dd28775fdaacff6cf05",
      "translation": "盗贼也被清剿了，现在正加紧开采卡蒙德呢。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1418fe6f81c026955d0f2ecdfe0b7a4a8fb8733d197f880a48bc773b9b57baa7",
      "source_sha256": "b34d742f4b8f73f5647a12c104ecdf97c2e5216f18d7b5820e4a9b3dcde09fdd",
      "translation": "不过，虽说在加紧开采，目前的产量其实也不算多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58a96be9bc3f2909ea91f45bac4f2d0e6d313a14b6ee79ecd91090243633f226",
      "source_sha256": "581613afa75c269c8319879314502a917a7cabbad8b32d0c80827e3aaa3d01da",
      "translation": "回收机密文件"
    },
    {
      "id": "coalesced:bb5b4aedbc42c7f7f9ae7bab77cb6eaa4d40debb02a9ac8b0206af0a9d0feceb",
      "source_sha256": "b4be8c37b519183e542bbd848f90895df6c44555fa1eb84aa7b567d5cad88e75",
      "translation": "请回收南部军叛徒窃走的[机密文件]\\n据说这些机密文件被老狐峡谷中的北部军残党\\n分别持有\\n\\n回收后，请向南部军总司令部的南部军士兵\\n报告"
    },
    {
      "id": "coalesced:931b6f1fbb7a7d81e3e1e969c3e122eb519f44d5eb6452a09d0e7420c54507ad",
      "source_sha256": "265a98b014dce15563064717fa498f202afadc9be8149fd666ec743d3b0e16fc",
      "translation": "各位应该已经知道，我们军中出了一个向北部军泄露情报的叛徒。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4dca2b1f5b27d1653a14b82f828e6289f778ce060f9c5ab15f8ffc45f0e1039",
      "source_sha256": "f2361ed8a22d824d91ad3391dd1af708e867eb86702c6632f3bee79dca198e2b",
      "translation": "那个叛徒逃走时，还窃取了大量机密文件。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28d425ee9028856736691361ac35f3df41971cdc99798be4527340ecd886033c",
      "source_sha256": "847e236900162b3d77a5e7e60ffe80bb9afdb4dee94e7fb8bc58acbc27c4f6e4",
      "translation": "我们审问了俘虏的北部军，得知那些文件被峡谷里的残党分别持有。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0d9a19bf97feba9b759f56e2f3a3be333061f57d86aac2edf57c32783fa34d3",
      "source_sha256": "89c5fcecc8b7e2a57ed73ebe12bd4efd12c666db347ce38ba2d25db5da4bab36",
      "translation": "请回收那些文件，带回总司令部。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:480f2ce1a5634dac10ff7cbdc030fd762de2744187fad8658a0a300a5bbda033",
      "source_sha256": "be3b5b24220f55a1371e725a6425ce9b84437e08c26e06163774460f7f0854cb",
      "translation": "要是那些文件送到了北部军总部，后果不堪设想。请抓紧时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dfd620eeb7c7b638c5d910586073eac0071940be7a3746708f04a46dc62bfc6c",
      "source_sha256": "76ef3d26ababdcea24f41db1a1eb50221bc3d1dba79d412458398e42021e152d",
      "translation": "要是那些文件流入北部军手中，可就糟了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:387a3d7bad8e5f86fe5ffcdcb84a3f599fde7c76cd679190f00ae44e4c83f622",
      "source_sha256": "ab77e910b57a2f8836052fb8bf54fb39ccb0592a169d6b65b1f269f2712b3682",
      "translation": "请尽快回收文件。"
    },
    {
      "id": "coalesced:8eca831f27f98aed4f66b695fb7dfb8579b01f2e5bc9ebf8e6272749a6d0c6a4",
      "source_sha256": "96652b35ff9edcca0d6f42604a696e52faa2e8fe1a311ca28eeee3671b0ba800",
      "translation": "QUEST%s : 获得机密文件 (%s / %s)"
    },
    {
      "id": "coalesced:881d895c0b99bed2633b6e0996629eaeb73640e16c4f6876e7fa2178b49023bf",
      "source_sha256": "0900fbf10cbf0afcd863254435a70e69b3fcbf9aca8bdf503c1c5db1bebc466c",
      "translation": "哦，你们把机密文件拿回来了。要是这些文件流入北部军手中，可就出大事了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8879ae2928478aab83de9831d21688db041067172fbf401c91e1f7144ab55b0",
      "source_sha256": "98264bf4c815d4e08164946b4aeb93af58aa76aaa4ced345430d528bb6e0e67a",
      "translation": "今后也要辛苦各位了。"
    },
    {
      "id": "coalesced:b7884a0df71b158f16a73ee96681d8b7a62334ab3297326e02ca2f0f6a1ba2d0",
      "source_sha256": "b2ea78a353998a37908f68f403c28e9b40f62431a0fa649ac4373b34e432dd5a",
      "translation": "获得机密文件"
    },
    {
      "id": "coalesced:67f3b4fb779118fbca0cf3fd9ad48e63850ff238ea16e0597495215382d47de1",
      "source_sha256": "af81203280bbf81617cf0b6c1b644f4daf9cba1abdaba1d34c5c318d7edb98b3",
      "translation": "营救阿尔斯"
    },
    {
      "id": "coalesced:567c2a71860a96a6186eaac0cd487b4b0368da849197ac38986cbcb39d12f159",
      "source_sha256": "faa9cdc136178ecf011e2bd7d0bd1853a3747bfc687b88a4fb1f69af4b4858e4",
      "translation": "请救出被北部军抓走的[阿尔斯]\\n阿尔斯被关在杜南丘陵的某处"
    },
    {
      "id": "coalesced:ceb3707f8ddcb6e26ea030292a21585d4ef4ef91d9237eb73bdd5699cfa55152",
      "source_sha256": "edd5397d241677fdf0c7875e35f6edba8e5a7348c85fa7b402d234cbaa91c311",
      "translation": "你们在找阿尔斯吗？"
    },
    {
      "id": "coalesced:4449d007c797bdd3cc9a7ee7fa7ac6423b8c1ee9df20228fd2a7f8f7fcc89ef1",
      "source_sha256": "0b4130fc60603b2f01f98fb8f7a7f0d19747c7da4bface58e9ada0f23cf7d4bf",
      "translation": "其实，昨晚我和阿尔斯巡逻时，遇上了敌军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:763e9bb15f4c88ce1fc9474cd77ab020139bd5149d5fca0ec8157ac5d84eb1a7",
      "source_sha256": "d7a537927f6e70a47c22957c44be1a32cf30837ba2a88c1736ae706330998af5",
      "translation": "多亏阿尔斯，我才能逃走，可他自己却被敌军抓去了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9980549b17260abe704e90d4d4f34c385e47a44d23060d42159f7a1f13af2063",
      "source_sha256": "4912981dff51367a5c0486c7fae9ddc5bd270e35ca26bd9de5d7ab2dd935b900",
      "translation": "请各位一定要救出阿尔斯。"
    },
    {
      "id": "coalesced:98cdd2f5f561ce43be5e1ffe36595ddeceb0191226964eebd86ad246a364b5c4",
      "source_sha256": "955c65424ebc4eaf30361092ead9ed1d9a9e84579c59c6c59b8afe47a88960cb",
      "translation": "阿尔斯很可能还被关在杜南丘陵的某处。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:25a4137f8b0e001d2040a5d922358af0b77c96a605cecc638be5aae23a4f28e5",
      "source_sha256": "1487333e6e6830fb3e62a6da665b16ea4fc741f4e82110b44289ae067ae0db7d",
      "translation": "看来，还是得由我亲自去救阿尔斯。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba7606454f54a9f37423a7dda40a498f3ca527f1f5d9bc6c11da0c9892d676ff",
      "source_sha256": "418f86abba9d6ac2231bce409a915c3bcc6f39320b66410b8a7e0ca30819d26a",
      "translation": "阿尔斯应该被关在杜南丘陵的某处。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d8618d92af854941f1a21a500fcd5c8bfe993d9e3a9d2c91da211968811647d",
      "source_sha256": "e6e93c17e502827a8274f548c96b580fd131e554614c3a5c4e165944c0b8596e",
      "translation": "谢谢你们救了我。我还以为自己死定了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c00f127842e5bd28489b0c3ab214c5c8734eeefb3fb973582d61f7afe7fa0796",
      "source_sha256": "e4b1480080b599bac9a26bec47a033527d91e9105945e09b5e52defb12da1878",
      "translation": "请拿上这个。应该能帮上忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7dc8e5e4968caf889be32dc13aafe1cc627f42991ff6f576e76f8bb34f3a9d51",
      "source_sha256": "975ccdeff9b0895fa3b712210dbdc5bf14215f8c80946b3188ba449cb557b25c",
      "translation": "QUEST%s : 救出阿尔斯 (%s / %s)"
    },
    {
      "id": "coalesced:5fe7cd7a4acece22e4a87c56b224d26a5d5a9218bf9c35e9cc6fb8a8a2819dfd",
      "source_sha256": "3c27112f44e6e19f0039a14eab0c1c65360aae88dc8b523bd49296c538e38107",
      "translation": "救出阿尔斯"
    },
    {
      "id": "coalesced:3d317442e24516484514292c522be5fb31e935d282a1fbc59f15a2ebad56fe61",
      "source_sha256": "e5c164fbd737b7bd4ad4ccb40e3a45d32fd927cfa36aba95419e3a10b45ddc35",
      "translation": "支援南部军"
    },
    {
      "id": "coalesced:e471165cf6a402268df0ed8dc87d5eb5e4c0a8eef5628c2cfef0dbf5c14778f0",
      "source_sha256": "91118a202f1df24405dbd51f8438eab8bfc9007045991b96be357ed0c8554613",
      "translation": "正在进攻杜南丘陵的南部军，目前处于劣势\\n请在前往第1哨所的途中，救出\\n陷入险境的南部军"
    },
    {
      "id": "coalesced:c7c2a2fb04c95cc9e17f6394df163deeddc0f40cf1f62690fb9310d41c1a3761",
      "source_sha256": "a661da0470f7575652550fe3e12aaf90b88329f6a94e9ef5381e10eb4a9de4c5",
      "translation": "连日战斗下来，南部军的士气和体力都已大幅下降。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98ad2c2133c3f7910cb80e9e819d4c1ac8b1a8ba01f29a2de141a42deca29bcc",
      "source_sha256": "d5c1832c98389c59c08b4f925b2c3883183f3f398e8f5bb54e4b6940674dbdb6",
      "translation": "再加上地形不利，我军陷入了苦战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a73e218af310a12c5f4db50fc00bed7c03ee217c682548ebf99feee49a2efab",
      "source_sha256": "f1d47e55d24514b094fab4b95402e92b2ece4d71e335ea7bd520803fa0949dd1",
      "translation": "想要扭转局势，反哨兵部队就必须尽快突破敌军的第1哨所。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d56d5e35e4c516bb2803244cbf137ad6c7654cb591b075ccb76c003b869d965",
      "source_sha256": "2be0550ea029f8924b14558944d5ea4d2e34534124471cb5d74860f0b1464f82",
      "translation": "此外，也请各位救出被敌军孤立的南部军士兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ded00c7f115fb9140c12737fd663b2482bac0b2acdeddcbc85ddbd28558e436",
      "source_sha256": "ad66e7d4e3745e0b996b5cb1b0dcc36096f3d87c7fb8d35a0286ea098e2797b8",
      "translation": "拜托各位了。"
    },
    {
      "id": "coalesced:8f4844bef57e405965243df61fdd43564b90b00b13a96252bc50f10172143d5e",
      "source_sha256": "5ef2d3cf71ff8ae99ddc4994819b28700372099ac271d3d7e096b8390ff681b2",
      "translation": "再拖延下去，可能会造成极其惨重的损失。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
