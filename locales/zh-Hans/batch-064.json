{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:d034650773cfe4aca486cbcd3db7edd037df7e00bad757a63290154fec807f9d",
      "source_sha256": "823427ddfd0423e21064dbae66ce08e8d715fdeebacee8b2a3dd72b445d7a24a",
      "translation": "让各位久等啦～前往拉·斯特拉达的高速移动装置，终于完成了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8a9e0030b22831df742c6e9cc89ca4edd4dda0a3ce40e8291c0afcc01e4ac282",
      "source_sha256": "e84c93f27645ac9cc51126c7391f929054eae42b3e07a47f00ffdd46def1165b",
      "translation": "高速移动……？"
    },
    {
      "id": "coalesced:152f54efec0ce7b595b586c5196156759b9404458aeb887674a37b4ecfcb91c8",
      "source_sha256": "bc5674c19bead084eaf12ff5ece6126f899db0b20096a4ff882851b6846d1ae5",
      "translation": "没错～因为，这可是能在一瞬间，把各位嗖地送到拉·斯特拉达的装置。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4466fe7f4ce36ba786e156e832a4aa610c633d859ea240ff70fa328d51963b38",
      "source_sha256": "ab54dd36496a4d855a825ad04dbcf695fb8d3f95e5dff1fd217f215d26b60295",
      "translation": "这个装置，只有我能操作。所以，我想自己也得和各位一起去鲁哈尔特。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a1429189144a31ddb0a8306284e5ce7a2abac44c5c27b3a4faeec5d2877bedd",
      "source_sha256": "1550cd260a67ebb02efed9f2cd8c4f74590018680d084090447ddef0b2c8fe52",
      "translation": "是吗？会很危险，不知道你能不能应付。"
    },
    {
      "id": "coalesced:458c7de7405cac3d9e8e2535f6162eadd863fe82839b79bd3347d068a95b6f34",
      "source_sha256": "a012b59aeb9762d7ec33219ef6fb358445b2100d9f23c99b1268e7f678282dd2",
      "translation": "别担心。别看我这样，逃跑可是很快的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6666a21b220a9b510e46c3e48a09e5210e7bebf15de028b5d2e98a894c2a1e2b",
      "source_sha256": "71c83f1d8b966265bdb7471faf204ada4722e460c01ecb9877b7d0c3898d8766",
      "translation": "这也值得你拿来炫耀啊。"
    },
    {
      "id": "coalesced:2bfe0c08be93f68b0dd6be2cc96772c7b0bc6d5ba185096df3e542f4606797e2",
      "source_sha256": "b6163064158886dddbe2e99b6079887a596b5cd18080084c90eccd1c414b8548",
      "translation": "这次战斗会很艰难。联合军正虎视眈眈，想要抓住我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa99640fc830c37f000097da3f0a560e81b50ec77ffb86e6acf910c5ca479e79",
      "source_sha256": "520af3652a4dc4880d2234b0964ef266d254ee35ecf5e05c0194e86f20648d2f",
      "translation": "没办法，只能杀出一条路了。"
    },
    {
      "id": "coalesced:646540432de257d4de378284d42fca478b9a46be02df5fff3ed4374e7bb7d8a6",
      "source_sha256": "a0b2c2eb522fd702f893643f4a001ea68c576bf71786d2ccaab48e20dc99ead0",
      "translation": "目的地已经确定，我们也只能向前。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:49aadcd2c87bf8c97de33fce8de32a970a39b42ab63ba1beccfe07375bd5e929",
      "source_sha256": "9162d5deed1c31489245c93a47b47ae5cd6a1eaab0a64033fc90cd52b0045c40",
      "translation": "反正，现在也没有退路了。"
    },
    {
      "id": "coalesced:3a415de2eff23172bf6930b08adc1f4b4acf975942ea835f1f64f27f34f35414",
      "source_sha256": "c24ab5cdb503daab7fb4adfac96a6c41e8dab9919eb762d95f61ef6b4a3cdd07",
      "translation": "这将会是最后一战了。"
    },
    {
      "id": "coalesced:9ed6dac9b468115c4bc0c6bf35a1d2e855d3a06b43bb7fa0dbae5dd0b55dfd96",
      "source_sha256": "74ee4602eaafe2986428741895f86ea97fe67bab59ef5cb1fbc083a6c2b1fb27",
      "translation": "嗯。大家都得做好觉悟。"
    },
    {
      "id": "coalesced:77de18cd3dffff941d5c149505ae93cb4e473de4564f1e4c4e3478586e6f1e97",
      "source_sha256": "5f760eae545800b74cab28b64ef38805f295fc088730b947acfc13ea282145a1",
      "translation": "那我也差不多该准备出发了，请各位做好前往鲁哈尔特高原的准备吧～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6836b31a9ba571e3bf3a65fe995237516f4145fb2dae83eacd8d75ebfdb9674",
      "source_sha256": "6370661f09cab4eafa7fa97a27a5a30ded5f252819e14c2715af789484e20f02",
      "translation": "真的要去拉·斯特拉达吗？"
    },
    {
      "id": "coalesced:d963c7116b00ffcdd2cfe45432200194290a7b11afbd0016437df3e98d76cadb",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:24accf69a49458bfba9fb1b062ee5ab4deb087cd541eb31c365ff0816b037bb1",
      "source_sha256": "4b7032367ba37d1e95a5e11a47f571502dae96c874601075337ae19158da0809",
      "translation": "我也想帮上点忙……可没能做到，真的很抱歉。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8de9e6ab23b70dd514cc58955e256762f8d61410868a9ae311c73541a4ef667e",
      "source_sha256": "f93e29f4a4e152c676b978aab2cba5a8252cdec2e9f4204298f4cbee526c6812",
      "translation": "你不是救了我的命吗。那就够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f956282f9a9f4ffeac53319ed59a9968a625ba12ba5e93212c0df5075cc10c6a",
      "source_sha256": "d94a78b6edcbf4673ac2a154d50586037b930ab0598bd6107ef8b41d6a41451c",
      "translation": "哈哈哈……是这样吗？"
    },
    {
      "id": "coalesced:d2d2efa3a7d800a6f90f95a4c207bd219debb632f3dc0bbcfb5ec80d73402ec3",
      "source_sha256": "4eeae2c661338bea02c92c5b1b06881b87d8b15b702beb208ed6ac2e63729872",
      "translation": "有件事，我有点在意。你说过，我是靠名为血之契约的连环术，才活着的吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:49396a8a2d8e5066378e09418ce56a67b1bb3d2a1b84aac42b2d48ea1e62acfb",
      "source_sha256": "3a177a3b500f440daf8dcd40136726954bcde802cb34e36803f007593154471a",
      "translation": "是的，没错。"
    },
    {
      "id": "coalesced:3623a1babedd150cd45470f12e5b437ccfd981f25ea811a5523295ae756ee49d",
      "source_sha256": "7c11942b041a3ef4bd09dbc0ce3a757a40a2470c5f47f4b1a9959e3d51c0c5e0",
      "translation": "……这样啊。"
    },
    {
      "id": "coalesced:60e632cc3a1655becc3941ef66d78199ec315b2c66c097c646633250ac938db6",
      "source_sha256": "8aa6efb4c8414fb7a4cee924f5492bdfb14405433606dccca7c67e1ed8d958c7",
      "translation": "我该不会……再被修恩扎伊特的命令控制了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:379e88cb726225151997c88291bfe7c783e1db1889938d4f6d8d35be45e6bddc",
      "source_sha256": "e6560cb316096fcb56160a3d18758e7b4d22d4d047b85177c3d399f7e14bd3aa",
      "translation": "不会。主人已经变成公主殿下，不会再有那种事了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ed2e5d4d87fafa1b92157d2b767049625bb9598c6e0aab7521aea5f716248f6",
      "source_sha256": "5568eedbae215144f493f13a7bf4f03fa039efe48bad0c691bac27d2eac4ec0a",
      "translation": "那就好……这次，终于能作个了断了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b4784b87f324d35dc35d9179cb7a68eb7b66e96099713d2190efd7b078deaf6",
      "source_sha256": "6487c6e76bb936bd29d6b0fb9ac687c9550922e17ee6e0293b252a4420d90a1a",
      "translation": "看来，你对修恩扎伊特……积了不少怨气啊。"
    },
    {
      "id": "coalesced:1790771e60e5e7ed55604e3242345b76634cd67004ee2a44dfc228e5669a5215",
      "source_sha256": "2063b112d99820beb1af5f54de0b300e17234988fa9ded2df83463bea3a53789",
      "translation": "光是那家伙发动了这场战争，就已经无法原谅了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8cae6559a4c0dbbf6ba6a46045a6bb0797398e5667b7c2d80531b5976305eb2",
      "source_sha256": "20ebc4fc189aaf0bb98a3ca6f5bc2a7845841993606d7f7d2095d4c50722ec98",
      "translation": "不过，毕竟是他创造了我……心情也有点复杂。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e8d99ddb79f184126c49478ea753e7e81828a91e4a1c97a79f66bb5fda07b0c",
      "source_sha256": "9451ab2b16f95dd566c48b76713f6cb15e0f601958caf32a7423d0d2d8e9c416",
      "translation": "对于我……对你做过的事，我也想真心向你道歉。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d4ad9592dc77b41094d7b804397d8b89131b918373f71ded18184d3330f3d60",
      "source_sha256": "97c490301811f77071592f622cdbc0bb42292c7b08e1be34af6fe1290d707ee1",
      "translation": "因为，我也做了和修恩扎伊特没什么两样的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b1d17a6accfdce328fbc96fa1d75086a283d4d400c4e5b814b52b6097ad0f866",
      "source_sha256": "6ffeb68711fa149a421c8c36f5db6470c7f1654ae5b208a5570de06a4d7a7d7d",
      "translation": "都到现在了，还说这些……多亏如此，我才能体验到这么惊心动魄的世界啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:af9de8e0b9587997b56da0c8590ed620e251f5022358a01a7595959b58c1ca84",
      "source_sha256": "2cd5d2a421af9ea06c471be3bb3bf72ec4225fefb13812473702ebb57dece5cf",
      "translation": "我不想就这样，以一个被制造出来的工具的身份，结束一生。我想找到自己存在的意义。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:24185f636d51203c74d734cd463a01c169ba5030266bd08dffd4d79819cfecf5",
      "source_sha256": "c6389203df104eae84b10c2357da36a27961cc59c61a7402b730485f75176a68",
      "translation": "……虽然，这话不太像我会说的。"
    },
    {
      "id": "coalesced:d8881e8743af660f7d225ae7f96701f258bd96afbdbedfd737d19d95f5c1bf73",
      "source_sha256": "794e3441b7b9f438a014997b0a8e105e6ca85ddbddbc93f4b07165a0dff8ab8f",
      "translation": "不。你能说出这样的话，我真的很高兴。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:557742022e52368e0c2a0e0ad9e3e16bfa05c273f1247017685788142b5361e7",
      "source_sha256": "82e0c973ac61154da8d5ee9d220c20a2331ce58db392bec06a336733715b5d4e",
      "translation": "是吗？既然像父亲一样的你都这么说，那应该就是这样吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b1831dfc1412ae621f6b1ee91c2fad86c5c30b3091d3814624eb994bca99b497",
      "source_sha256": "14b31c549a0509d8396ee518791b1a576009a86536001fa50d26b6202562fb31",
      "translation": "哈哈……是吗？"
    },
    {
      "id": "coalesced:c7c0979dfa13a16967eeeba78b5edb5c855aa3a59e5d4eb346d6d7decfc81280",
      "source_sha256": "60d63cd8b4256b0fa5700b57e75bba8f752ad53a5b35cd9ecc6e447aa7baf207",
      "translation": "好，那我走了。好好看着拉·斯特拉达吧。我会痛痛快快地把它打下来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9db26f3411ae4fa912e5ac5c6492986346fa25d87960aedbf16bd9324e269c7",
      "source_sha256": "f72158086d648882fb6a8005bb2f3d2cbd2c23e43a874629a49f82adc179d398",
      "translation": "好。我会一直看着。请多保重。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c4656ffe9055a878cc799d306feeadce57b035621b08c61c296ca7aa24b5fa34",
      "source_sha256": "0f45088a06898e476d81a267cc7d1d80d930fc3a4682738249403ce290e376b8",
      "translation": "紧张让我的心怦怦直跳。"
    },
    {
      "id": "coalesced:ab845737543fe4ffde0b1980b7cd282e0f352337fdc87e1001863aef0e9d4285",
      "source_sha256": "a4ce6268b0db7603158bb0427c50ffbcd4dc709796f5e6bf30f90756f3b0cdc9",
      "translation": "踏出柯塔马雷的这一步，既轻盈，又沉重。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6577aa395c8b554f4139d6d605a94bffc1b56e0a0763d3cf47807b62efd21bb3",
      "source_sha256": "cd8fb0d92479c5d88f7426ea7fb6c41318ce3743a014862dc5451c206403ac19",
      "translation": "所有人都会谴责我们。明知如此，我们仍向前迈出一步。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59a2a374319269a0f2ccff969e57e22fe4eef604cfff7b48afe50f00cd773bdc",
      "source_sha256": "c9385fd15d52586c220cda2276f31de015ff27704083215b863d54804765de74",
      "translation": "这是只属于我们的孤独战斗。为了真正拯救世界。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da941b614534c077c42e9f176ae4ec0512c79332590cba0536c73c3a14ca6572",
      "source_sha256": "815280e9eb6c626af8b9b36b72776694034f802c8cc172f5b052e4a31e4829ee",
      "translation": "前方，拉·斯特拉达正等着我们。"
    },
    {
      "id": "coalesced:9b2ab7a82c872d7695ff2b445927bd75392463b8a400a563fe23f66ef7c0e44c",
      "source_sha256": "66e65928589ca0e56a648e62b69d2dd6a611633e8307112d26f54af092de6b2b",
      "translation": "我的最后一战，究竟会怎样结束？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc48e5300a4dcf12eb77c8d58327da205a8b60a2b8d4d6456500e803d4891268",
      "source_sha256": "c357979aa83a4bff941c57c26193b067102785015fd061cbd59a11dcac2891c5",
      "translation": "这……究竟是怎么回事……！？"
    },
    {
      "id": "coalesced:d4c4d12ca5c5a6ba0d5d6873a83f879d45c63f47f80c0af0de7e8676b381ff1f",
      "source_sha256": "bccf2537c7e3c4200a7de96fb7eb77d3c7d42bc8b0b850fca3f052212af870c8",
      "translation": "吃惊了吗？"
    },
    {
      "id": "coalesced:14264bc5090caab743b8a61b569e27d9a7d4c08149e05ad961f03067e200d41d",
      "source_sha256": "e68b9ae530855c9082847c47bfb329149659c34c0c2ccd85c4dcf593e69fda8e",
      "translation": "你……究竟是谁？"
    },
    {
      "id": "coalesced:ce6ae0a53a2c9723e4898fc98b44b6837c0e778eca42db9b8ad73c8a08f6a81f",
      "source_sha256": "47ecea175942a3495701f681febae3514023fb0e22c8674a98f57cbc16cac8e7",
      "translation": "既然看到了，应该就明白了吧？"
    },
    {
      "id": "coalesced:22c297adb377b54c251e0bf30a5422833241044bdb508e1a3e3412a9b6cc7346",
      "source_sha256": "46b7155ed63b4d478763ff8624e612a2c7cc11e40e0804339550e532ee902062",
      "translation": "为了兰兹海姆，我一直这样活着。所以，也请你助我一臂之力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9498e14b758eb5403c429151c047c33be39c523b0505c03ec198bec654e8ae2e",
      "source_sha256": "b0aaaa1e51f37fdbb05cf223221e3c8eb3c45075e0846568419f440e1ff68fe4",
      "translation": "剩下的，就只有卡蒙德了。"
    },
    {
      "id": "coalesced:dc40fd4b1b5d8bdb8a726b6f1ca6f9299a96cd04bb32c5382db33d8c3900049a",
      "source_sha256": "c34a72e9c9febed628e1952d46b8969ac9a8ce1414e754b81b19718388c5e39f",
      "translation": "如果这不是别人的请求，而是您的……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d0b480386de82339e23802620154da0697c0ae7350434ea93fd74b932e6c81fd",
      "source_sha256": "96771a90343b05e71791431fac4c8f7c88f73cba9bda1d6f64d17d4b8636bd26",
      "translation": "我就无法拒绝了……"
    },
    {
      "id": "coalesced:b75172d5078e4f5346ff295ede0f6d9513cbfd9bdb6e763d8a0ff3a6040269be",
      "source_sha256": "ad95656f7a73934af7c6aeae67226c12fd5177b95278f3f2fbe84a5b122533b3",
      "translation": "可是……您真的想让我成为王吗？还是说，就连我，也只是被您利用了？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c1463f530f792cadc821be9784401ca9830f24c63b4b6325e3c8893155623f6",
      "source_sha256": "3287b216c70b6e5f057d8526a6f07333018d68d205a422001da31b69dce82b25",
      "translation": "王家已经走到尽头。我们需要新的王。一位知晓兰兹海姆的真相，为了守护兰兹海姆而存在的王。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7daa6172bdbcf65b0d9de5e14ce073e3f7a30d2757b39211f202e9eb23aa7d5",
      "source_sha256": "6011c575f604c06c6e5cf6fcf96bb18048f95cca8641d06f543b58006a64508c",
      "translation": "你拥有这个资格。"
    },
    {
      "id": "coalesced:9ed5c2f85225a42a98115ffc181c62ece9a381cf282eb086334d25043e0cbdb7",
      "source_sha256": "e83efe2a780eaf1775957fe82fb60bcc578fd99cf24ab0d17bf1cc51f7924460",
      "translation": "我很荣幸。"
    },
    {
      "id": "coalesced:a71b8188e2b8bf20a55d1615b926351aff081d6456ab68d87beaafb3080f3319",
      "source_sha256": "028267c235079c6804670e4ba9dc70dc5da7d3000969e0a9c89fe2410c634492",
      "translation": "差不多该向鲁哈尔特出发了。"
    },
    {
      "id": "coalesced:5e0eac2650ddbfda48633f0bcf5e8004307853554df2da846d6429322fca65b4",
      "source_sha256": "79a15317e4c56cb06e10c2fa91753b64174ff7898fcd4340aa07b9b7325a946c",
      "translation": "嗯。这将是最后一战，大家都做好觉悟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:645a54778fa34888e6eff7fa68b00b74235750d7c09df160e8360a1295b6d95b",
      "source_sha256": "e31b43cd5da7c5caac02bf670942ad22857f954fd890bdafd312f5aa2b930ff8",
      "translation": "现在，只要穿过鲁哈尔特盆地就行了。"
    },
    {
      "id": "coalesced:33e104b069e58c69dac3cfae5ed41f46381439b0f7ce50b96044f2c886a74b36",
      "source_sha256": "f4d45974c140e1144e343c5d814d4f9583acec3b1f06d74461217d7070ec4de6",
      "translation": "我会一边搬运装置，一边前进，请各位负责迎战敌人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca6885833d1df99a3d137f6428e1a463c4179e79d5a948a91afb3905843e355c",
      "source_sha256": "42ad872423a19a484e467c89f6e26007d229327e23a2949e27d8b6a7a05bd98a",
      "translation": "不过，因为我得搬运装置，恐怕没办法好好战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0be50b3cdcc1506f4815cfafd2edb5fe927474038babedade271cf1e4088cbb",
      "source_sha256": "a0d14bdad4221dc0097b86d44096afc3d92c889563d8acc11e0c6742faecc41c",
      "translation": "要是我遇到危险，还请帮帮忙～！"
    },
    {
      "id": "coalesced:ffa246b1fe6d01ff94a3c94a061754edc03e3c8fd2ecaaf57e9e929651bc204b",
      "source_sha256": "72165bf8c500a63123863c46cb134354ea981125e96c660e747f0af0f393a3cf",
      "translation": "别担心。我们都会一边保护你，一边战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab7f1556cef7cbafef01ecc91171b19c3fdc6f003272ecc446b8e14d29a3a1c0",
      "source_sha256": "d81de7ff468927e1266df8e1a691635b5d55770f73badffdcdf4554c57a0af82",
      "translation": "各位上次救我的恩情，如今终于能报答了。我一定会把各位送到拉·斯特拉达。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:45a89fa0da328d28ee84075bcc65e44c9627937e599311847c6ef12cec6c04bd",
      "source_sha256": "4fb78bc79d5efdbbf5d3691d26cd1d1d7290525c9fb3bf0a42f824975f01f670",
      "translation": "那就期待你的表现了。"
    },
    {
      "id": "coalesced:66db24277d1f760ee1c5a006070ef91bd9aa5459119555ce90d25cf3d226ae8b",
      "source_sha256": "5ea642075c4843546473556bec21979a086e41e0eb1a53573915f8bfd54ecf5c",
      "translation": "好了，继续前进吧？"
    },
    {
      "id": "coalesced:1b28c813c187a2949eab984b8df0ae35ef8a2d1dab290d369e3ab182095820dc",
      "source_sha256": "f6b4da20e6f120e6da3c0777a6164c5b2f017777d37d96ddb6239a8848568e68",
      "translation": "（得守住伊格顿，\\n让他安装好传送装置。） "
    },
    {
      "id": "coalesced:75df44dc392ea572286086912c3da958c21a89d5e1e3a66c3c5ec9d2c6ae063f",
      "source_sha256": "3900107799381ce5c79d80d1bdc3105e9918c5e635926147b2e219b2ae0f80da",
      "translation": "（传送装置安装好之前，\\n不能离开伊格顿身边。）"
    },
    {
      "id": "coalesced:4c2acaff192e8c7f674e9dbeb4956a4afdc54621096cae6b39c2a433c0f64e55",
      "source_sha256": "d6eabf97ddfb7750419d932cbcf33d51a6592aacf55a7bfc8e26facaf8a03ed7",
      "translation": "（在伊格顿安装好传送装置之前，\\n不能离开他身边。）"
    },
    {
      "id": "coalesced:dec3b523dbb1dbf9efc219a08e5e9faac2d648e8a573cad46c886e75ebdac4a1",
      "source_sha256": "0fdfb5854daaf25db3a5a591eab5b831c64076e39408ca65d5031e9d0d45205a",
      "translation": "（得保护好伊格顿。）"
    },
    {
      "id": "coalesced:2ae6ad78d3ded912630e66f0b8d309ed51f7f6c4af61211065d34d698710d2a2",
      "source_sha256": "2c1ebace32ef99103b3335beb38763772f84a775c4c7ee8fcb8d7b1e4989bb65",
      "translation": "（得保护伊格顿，不让北部军伤害他。）"
    },
    {
      "id": "coalesced:3be44258be861e097f4a7a5dbce324fe39b97e27aab574fea2fd4770f9aaabc8",
      "source_sha256": "a9b398984d1ccb89644bffce5e12d1e80cad29b8abf95b3fe136140c5445d045",
      "translation": "（绝不能让北部军\\n靠近伊格顿。）"
    },
    {
      "id": "coalesced:ccbd5d38667d01f3447f37c65027cefd0cfae3d5522d3e0c141e99d9a9948855",
      "source_sha256": "cfe8275372cc367b1f46385a90c165211eea76ca420290c441c601518633a21b",
      "translation": "准备好了吗？"
    },
    {
      "id": "coalesced:40e7e0a29cd827238369cc7b23522798a8dd545e7060f576ed55e33c1fad3302",
      "source_sha256": "485c6c3455eb7e98a5e6acd3191e46df5f7e03d917245ef4263f56bc3d95cc57",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 出发\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 还需要准备"
    },
    {
      "id": "coalesced:41d719e830bcb3d5f4cf2c4b170af19068223ff44c5d2c41067cd1d124ec1ca8",
      "source_sha256": "f25fad49849bde42cc0a2cdaa73a54281b810c248821c74a6c4da62d3fa1fc42",
      "translation": "今天已经晚了，明天再出发。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9e4472af5dab42ae7f2e47dfce13acb329a32dc781bdc22041cf7311c0be95f",
      "source_sha256": "7812feaff86356c5cbe4ee4ff6471c4d98b1b6e1e2c3488dbc256169ade71684",
      "translation": "我会等到各位准备好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    }
  ]
}
