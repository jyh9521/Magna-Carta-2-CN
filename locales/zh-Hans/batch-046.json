{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:f6c68aa820195b9d253034bb8eccd51c16edb9f26c569e753ae5e0fd1d475f19",
      "source_sha256": "3562db2e5b3b827e57392da72a0afac372fa12ebc0b0531b4b8c529ad4c01097",
      "translation": "这里好像就是泽罗哈说的地方。"
    },
    {
      "id": "coalesced:4ecc8e968df9cc448ed672c04e69e5ec56e906a1c9f1595a57ba983b1d3aacd4",
      "source_sha256": "46cc0f137cde6ce5bb897c6f15fcb6c5534cf856ca4aba7e71b6435d1e385de2",
      "translation": "试试漩涡炸弹吧。"
    },
    {
      "id": "coalesced:7a46d04cab56136cb11ed1333d2fe05fab50a1a6b2499fdcaa2679dd89cdc359",
      "source_sha256": "441b2ceb3083aea2c9cd98e218b7e75f40e51e7df62bbc1551e849d5a1702f38",
      "translation": "成功了！快进去。"
    },
    {
      "id": "coalesced:e803bb9cb3025d74e2583e1606bd604fa40de6d34cb9f8a06d551279acf44ce5",
      "source_sha256": "987cf414015450b4a87c7d00a9ee1801c99465753fd869b0503d805fbe1cea62",
      "translation": "研究所在左边。抓紧时间。"
    },
    {
      "id": "coalesced:4d7b3ff9503957e281efce1893d4d13ae1476dec5ea85015442cee85b64a22c1",
      "source_sha256": "80f63c25e5bc90f62fe88c053a4d743c928cdac0d960a8b310aff33e96ee6100",
      "translation": "哨兵研究所……"
    },
    {
      "id": "coalesced:b38e0ee5a958cc3ae0fa3ca0d6a307278bc152fe03fee1eb6d906a29beee92ee",
      "source_sha256": "f494d56c0ee8b5bbead7d02e5e3bd496feb1e771dd63dc9cc51a22604b90fe17",
      "translation": "这里的气氛，怎么完全不一样？"
    },
    {
      "id": "coalesced:a3dc4bb9977c898dc27c1325a1fef42459dbc3d0b9c97a8fcd602f4766715872",
      "source_sha256": "1c0ee03e9ce2b2d86b48bb8209b1be4b0b6a5f7260999ff4e4b9b5eb950d8b11",
      "translation": "嗯。这里和王城的气氛截然不同。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:71a5066353fd165737849c55df66586e0cb0ba68248d98ceba5ab93038b7a23d",
      "source_sha256": "66f02254aba773ddc94710c395ad556078958896dbb1fda68afd6252a666984a",
      "translation": "你了解这里吗？"
    },
    {
      "id": "coalesced:13edd4f51b45ca3331ad86c049b8eda0433fae43a4785f9bcdc277a64764bcae",
      "source_sha256": "f8283ff8dea5c66d20734fac39df69de9d71ad4c07896deb16883e184ac2ae34",
      "translation": "多少了解一些。我也曾在这里生活过。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da0f48fc844589559347b35f98d4015b557033482bc7475aac55378b99266d98",
      "source_sha256": "ab5df625bc76dbd4e163bed2dd888df828f90159bb93556525c31821b6541d46",
      "translation": "……"
    },
    {
      "id": "coalesced:e0989c92cf9efb6b1e611c9a340eba85252068fa6b4620e93870db20011297e4",
      "source_sha256": "bc158037422714ab72c638992fd56aa4bd20d4b08f1731deae8ed20de68afbbc",
      "translation": "不过，我的记忆还没有完全恢复……"
    },
    {
      "id": "coalesced:6129762591a5ae0fc1546d6b5aedcf1fb0bdf7687ed2f4f4fd4a5b6d9f6e1e82",
      "source_sha256": "661681ffaac2592a2a7d0927f2552103ed3d178cded2968aa91b7069028bee9c",
      "translation": "进去吧……"
    },
    {
      "id": "coalesced:1c3c6d99ffc0823fe1e44dba3270a82ffcaf56a3b09dfad31c083d1ec0a265aa",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:da0eb0852071819d7f205eae4c8be321c58d268fc46a55fee90e1cad6deac313",
      "source_sha256": "41a82184b13076befd62b6fe9028abdea22b48d3a62c2911ea85f592361c4317",
      "translation": "可是，我们现在没法使用连环术吧？就这样进研究所，没问题吗？万一被包围，可就完了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3ef00ba29854f4aad6fc65193f0537bfd5cd2e964a7d3804895324241acdef5",
      "source_sha256": "7804e91d0651da14783fe31135607526c81dcaeeba1cc5e364520f5f3ea1088d",
      "translation": "研究所在地下，应该没问题。那里不在灾祸种的影响范围内。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88af9a29ecfe2f01844dd8eb6bf5c5f0e2ca0ac81268f6f345ef4e8144a09137",
      "source_sha256": "170904019fc16f007591bf712910050293dfb0b77dd46052d3f41729e8790fb7",
      "translation": "是吗？那就能尽情战斗了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4a1b017cd6009fe70b57ab4a3e8d558ed04d4b0cd0e3458d0adc55b8cb004c5",
      "source_sha256": "17159bcb256fc1d9aef2878348c40fe5727fda5c19e6054c8308200bf31e9203",
      "translation": "艾、艾尔加……？"
    },
    {
      "id": "coalesced:b2957a8c27b5678e17932a601bbeae7b1aa87fc4067354a61747f875b9fe13cf",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:17007952b94c745496a19dbfd2e7efb9c44a29f6a06685776ae4bfe78f4eff13",
      "source_sha256": "eaf1693ee15a99a91b6720f3b5dc809a8789b1b2b53c9e4be039c1fcb8f3f5d4",
      "translation": "饶、饶命啊。我、我还……不想死！"
    },
    {
      "id": "coalesced:00b9b05cc681290d52d306bb2bf6bcece8e9f1f1898acabbbb0acaa163187820",
      "source_sha256": "4fab4a5e238571185abe2186d819e5241c995fbc4afa2e07f0d1c910d966df75",
      "translation": "喂，冷静点。我们可没打算杀你啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f13b05e09a32d449640a454834c77eee669c91304e3881d56cb2fcc2736d9c7",
      "source_sha256": "40559ff6eda0039647bc4b591c5b90ad512e90387d479685ee7f8b74e9f1d05e",
      "translation": "什么？可、可是艾尔加……"
    },
    {
      "id": "coalesced:5aea334d7c66816a376811ab92b109e2de659c35547ca94a86aec61fb6612930",
      "source_sha256": "7f793d12e0d83da0ced4798e80aaf0bfc29a641852329638cebe2d1a9863b802",
      "translation": "看来，你认识艾尔加？"
    },
    {
      "id": "coalesced:1bc51a3a2c965e34248aa1a925461c8b8ead5ea54ac86a276655fd4be919a62e",
      "source_sha256": "446c05e097e295426f9b4a35f59ba8e63c7a5e2c45a84cb32549cab3e6c4a011",
      "translation": "你、你在说什么？你不是奉修恩扎伊特的命令，来杀我的吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2410dbf3ae74b8ffe69267bd558795af01ff569bf1a4ec07203f50d6460d5c8d",
      "source_sha256": "ac7ae3e1578fa3a88e40e508a3ba3ecb9c531a473cc0542163bb912f24595cba",
      "translation": "虽然我曾经是艾尔加，但现在和修恩扎伊特已经没有任何关系了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:95f4063dfabda4a81265030505e6832fd6c6b78771b61c8a7d49df033f369231",
      "source_sha256": "9b2b104141b1dcfa1bfa972b336331b340aab293bfcec7edf8dd4f10d0cdb7e4",
      "translation": "他的名字是朱特。或许，并不是你认识的那个艾尔加。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84ee9ae63f01a981049dd200fd4a46a00fb14d54d9fd5a85866c1ce300911d2a",
      "source_sha256": "9189bf5b1c8e155ea8a4a8e3b0d6c3d95be9922695d67ca297903012604d3a5d",
      "translation": "什么！？那就是一号艾尔加？"
    },
    {
      "id": "coalesced:d6f542f86b83738d41b265798eed7c60fa3030aa32a192d124f488925fcc7830",
      "source_sha256": "d934e3bde6f202312c501f7552d7449dc73b1bd3c0616b2721a4d22584fa2f02",
      "translation": "一号……？"
    },
    {
      "id": "coalesced:b35d2167169ccde6d724d1d867e1fb61558326cc008305b7df5856eb65136ac8",
      "source_sha256": "12ec1320ef1a78fb5856acba672ec61436190d036ee991f40d23c11d05173f4c",
      "translation": "说起来，修恩扎伊特也曾称朱特为一号。"
    },
    {
      "id": "coalesced:b84b3a7f799de546f327b008e65bb8956fa1e56fa5b1f043a8bf3b5d63469824",
      "source_sha256": "2abacaab5bafb66c71e3355176f711ab465ae66ef0beca23ef314a8a4d954317",
      "translation": "我听说一号已经死了……"
    },
    {
      "id": "coalesced:93d862c25cd80035f090a40d13e43b28730451f3c792616840ef5dc3390e267d",
      "source_sha256": "04f2acdfb198d3d39b45414b57a618ef597ba56f9d1fda351b3c21cc71e46ebf",
      "translation": "没想到竟然还活着……！"
    },
    {
      "id": "coalesced:4df8d0621ed3b54b330456dd51586eb462517afdc5361263be96a3d090f6e8af",
      "source_sha256": "eade13bf3af0bbafd56211160361ee58ab72b6fb52f790c0524c57aae382a1b1",
      "translation": "只是失去了记忆。虽然现在正一点点找回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f41e3989ee425b1fd9a352cf18f31a16608a6f805c27480281403951826b2e91",
      "source_sha256": "7278d8dc7424a561ebcb71041981af5ab99dac32053a74e045d672095a0cd3d3",
      "translation": "原来如此。所以，大家才会以为你已经死了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67c2f45ae53592ee7ea3c976463d15591cdc05af40f5eab33f64e20e116e1124",
      "source_sha256": "d594e2480ce2281a42f6b1487365988e9f579d23a24c0ec9ecfc5e0b5d3b9ef2",
      "translation": "你是谁？"
    },
    {
      "id": "coalesced:06703b8a307be81916a7cdbfd498557cbb21d5fac5e9957086c16e4e971025be",
      "source_sha256": "5497718986c6bf3d60942b7367ac07924f9643b29ff1b5cc716c60be234c5a60",
      "translation": "啊，你还没有想起我啊。"
    },
    {
      "id": "coalesced:e1e81efb98e3a2a7759cc44db0bfac93bd0b7aa354bdea1bac2f84bc49e7e741",
      "source_sha256": "8025c713f26164a6787608a6cbce1b8ac0cfe963a42e1416578db60193e95224",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:28d4d6113512ea44c17273062e5a718c1ca3a1f669fbc69a04cbbbcb2ef419b2",
      "source_sha256": "de1eaf181ba5a96ea91866dff21916d7dadca42fcbf59069ea99d0fd3ef39914",
      "translation": "我的名字是“尼克斯”，曾经是这座哨兵研究所的研究员。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bc2f85ea0ba18137c30572769afcb918cfd89d5e6f74ac2e385ca467c836b250",
      "source_sha256": "e33ff4e2cd57ede29f9d3d79e42474aa1faf496bf80bd5f475be39023fc8f2d2",
      "translation": "不过，我拒绝继续开发哨兵，结果就被关在这里了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ef0428384277314bb798447cfeb6d2da010804c38a87368c31acc804a683c49",
      "source_sha256": "e62a3c61bf9f51b664cd72df6223e1c539ba676be19bb091d29bc1745208b967",
      "translation": "为什么拒绝开发哨兵？"
    },
    {
      "id": "coalesced:d387824c13965d3e57fb7f77ad1999ac594e944c77977180562db57243add74e",
      "source_sha256": "a59a7da477c79e1a25747109acd3ca231463463825aae87a4dc9f3968218ee76",
      "translation": "因为那……是身为人类绝不该做的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f11c4daa9543f65153c16dd7cc78e2488a031fef0a68a4f6dc681e9f7eacd573",
      "source_sha256": "2d65faaa384c601ab5610fa290b52699148a7867cb517cd25c75e8440a84433e",
      "translation": "虽然为了钱才参与其中，但如果早知道是那种事，我就不会加入了。我真的很后悔……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f37d12ee0f5332b42b0ae84ec510d95873108147b7910cca2819d02378a51f8e",
      "source_sha256": "312b9a2b1b3f34afc267a90bebb030c37f8e92e2bd6a9d2014a73cc6883d7802",
      "translation": "那么，你现在也不属于北部军了。其实，我们是南部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:acdc8feaf22fcccea3d4b5c2d19157601130aa8f7ecf822bb6c1a18b9be01255",
      "source_sha256": "aec53c944adffe76815dd9c7d3c84da0296028468f4207ab6cae07b093b76e2f",
      "translation": "南部军？南部军怎么会来到这里……？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e6e5d72a4e9694d0707c2c5c8e1020687d76dd01b014e518dd5a99c632ca114",
      "source_sha256": "68196d2721661bd6249c444f3d0f9206c043404a7dbdaa192e547a6cd2f63435",
      "translation": "公主殿下被带进了这座研究所，我们是来救她的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55f213499f914bf12376f196d6180e341623ef91db25228b964a8d44aefead63",
      "source_sha256": "1d6d768731f88ecc2968ab0cb1ee7011be5af74192cceece0ebc6d4ff78f4e0e",
      "translation": "关于公主殿下，你知道些什么吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2b29e852a51a3851aa75a3880c4afd0c229bc08a05f7d27fb95185d2366a614",
      "source_sha256": "8f5feed8e2efe1da4c360ae90580b44fc2390a908da6097e0b705d24e6b6b02a",
      "translation": "或许……"
    },
    {
      "id": "coalesced:9520a7e26b56800c5d278040d7821e44a90c548cdc8f8395b2d4e56bffe55745",
      "source_sha256": "9567c671aaf72a10c92a576312eb172472e8e31d76f37dd9a30b56a75146a5ea",
      "translation": "你想到什么了吗？"
    },
    {
      "id": "coalesced:5de58b9203336df241335a070f953a712251476340ff246d87aa04edeaaa53ae",
      "source_sha256": "e7392cd50b6275f168a3f2c1b80d051d28fdf85f9271ee76bca99a2db5627321",
      "translation": "我因为拒绝研究而被带走时，曾看见一位女士也被士兵带走。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b5e5c151a779e7e3114cdeec8187371ae7e4cdf3956cb0c0478b623cee63415",
      "source_sha256": "cfa2abe76ebae9d980e3c9262e7abece621ca7a3ff14dd6fb890a009af0eb819",
      "translation": "她非常美丽，看起来身份高贵。或许就是公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:716e836c1cd5eaebb24b21cdd4a130d441bdd952806b96a42f4fcdb5bc8fc84b",
      "source_sha256": "e3283441cb9a061f6802ac229520afd0072441978e1f0f0de68bab4c69f3fef1",
      "translation": "她被带到哪里去了？"
    },
    {
      "id": "coalesced:f2605f82938ef6313b830265fe6bacfa88e24bdc5b7f6a3d6168638fd230d48d",
      "source_sha256": "64f78b675af154e407a02022eb5eb41f5bdc21e167cd116311c1309ffaede98f",
      "translation": "往那个方向去的话，应该是地下2层的中央研究室。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6070774fd98bdb2e9e5a3f746d8e24d6e8c538a85bbefb0b994274d423903c1",
      "source_sha256": "729162e5f303baaef93394b65b3aad83cec6526f58af7f1abfc8c7ed73aa603d",
      "translation": "中央研究室？那里……不是得启动动力装置才能过去吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba55054d639da63ac79d420e934c7f4a232968b823a710ff4077fbddbdedd35a",
      "source_sha256": "1b6ae203a2afe5d5642fbfec63f20e35755dd17fee4eae9997d512fbeea23ca9",
      "translation": "是的，没错。看来，你想起来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63c9bdfb8f806fc6590e3eb4ba0d69b2a37d086640b14b91707aac83b84976f7",
      "source_sha256": "c1c4090802a823d828c68d34d139fee09433929b8cfd6a799ab9fa47b470335a",
      "translation": "启动研究所内的动力装置后，就能使用通往中央研究室的传送装置。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f5976b2a7d727380bdd6824454c4e3e79dfd8e3e21e078cfebb7ac681e380036",
      "source_sha256": "ee96eb28e642e65c30fc4e245339ff3bac731c9fba49a91e18ce2ac16147a0a0",
      "translation": "我知道动力装置的启动方法，可以帮你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad93c6452c46a847b9675ad2f9535469a8f1ef77f33db6fbf5323dbd96992686",
      "source_sha256": "46c772a411ca543ed51a35b74a1f248e8aa3f0dd395832214bbedc1026dc7bfe",
      "translation": "谢谢，尼克斯。我们这就走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d03c72929fd9f58e2b84d8cd0e44cfca50bf586ce50be7a0a216f231f33a1dd",
      "source_sha256": "6fed1d2c6991da0787c6573e088e2c1c9cca5a88bf70dbbb01a531b44cb22564",
      "translation": "(必须尽快救出洁菲。)"
    },
    {
      "id": "coalesced:77b4bdce351e03c725a0deceb33a2468add2ba4fecf1001437fb66dad6aa56cd",
      "source_sha256": "01856db22a9a4fa971afa54896aeb2afe8c346f6c1a7cf7a1f19a5db84026a88",
      "translation": "(不能就这样离开。)"
    },
    {
      "id": "coalesced:a9df7234e8b1d5808ae2b50a497a76572e1df26031a3d7cf7b3985df3ee2d822",
      "source_sha256": "49b46321a9a6cc23864fbd49230aebae110f65b0fe5cc819c945d7efe43fc00e",
      "translation": "(洁菲姐姐应该就在研究所里。)"
    },
    {
      "id": "coalesced:2df651d347312497f17663c6f771991cfaa9da09bfc91f16a62c803630aee1f0",
      "source_sha256": "cc6b74deca7f7fe120119a338d6357539321c4cc9532cd663f2cf8e1bb95d35e",
      "translation": "(必须尽快找到公主殿下。)"
    },
    {
      "id": "coalesced:b61a48747fcb6ba05ff83458d3f5caecd2141f554bdabe32fc95f4986a357c50",
      "source_sha256": "e09aba6c6be5b4e1569c10cdc7720a684198087c6ae7eaf104aa0f89b33187e7",
      "translation": "(还没救出公主殿下，不能就这样走。)"
    },
    {
      "id": "coalesced:b0c94df901eab25d119cdd07608c0fa8273d2257cd6ff056d377eec1f4397aaf",
      "source_sha256": "e0913390b301846e9298b7076c3d8631e3901934911b5a11f8add66b0caf3c76",
      "translation": "(动力装置还没有全部启动。)"
    },
    {
      "id": "coalesced:99f5d2884193ae653d2d4e10623daae5fa3864e580bd9b74f9029892e781567f",
      "source_sha256": "eccf8badb851f38f5048a15e4af72e0156f47ed69a7afd2e3767bdea7edcc6f0",
      "translation": "(必须启动所有动力装置。)"
    },
    {
      "id": "coalesced:5c98ac37ec48ba299ef1be8abc152fdc884c80e818bc3e7ccc6000bb43a22f4b",
      "source_sha256": "72b9da25ae5fc17667487c5370b732955d42500c9850a3d8e13292e612b03b0e",
      "translation": "(看来，还有动力装置没有启动。)"
    },
    {
      "id": "coalesced:58ea2372e468b5dda0fc19ecc763e8806b0dcc942456f4d8897b253edcf3fde4",
      "source_sha256": "d750de5508193f2ea63965973f124015c9db83ed1257edaa4d4f584533a5a374",
      "translation": "(动力还不够。)"
    },
    {
      "id": "coalesced:ab7178b781fb66bac8c54ad948641e3723ba9563429c9211c21a42ee2acf7932",
      "source_sha256": "81f77d63ea9c3a19d154e3624e8ec3c781495ccde695f0f4736c542ec2d3c709",
      "translation": "(还有地方的动力装置没有启动。)"
    },
    {
      "id": "coalesced:0273bd64926cef077d0f5f9cdb4c2aadbf134c2b728c8c2e796af85612d5bf2c",
      "source_sha256": "bc029e0a198121d83c67fb57378d15d31dd40044cf9a592c27c93034561b70b8",
      "translation": "我们现在位于研究所1层。"
    },
    {
      "id": "coalesced:1a082ae7aaa02f5b1608c3d3b981ff54dc3a9295751c249891169634b9e1fa8b",
      "source_sha256": "7ad4994ca278b488761b63390f7cc640e63107b624eeaa2c3c6d692579ab3a32",
      "translation": "最近，新哨兵的制造数量减少，所以这里驻守的兵力并不多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f007dc0713b5ed61838e6f2ad7966f03ce02976e6d53719357f6a92af48f3381",
      "source_sha256": "53b88d162bd48647686af60e7681d8f07c1888b0c21e76d3d2b1e0e822eab786",
      "translation": "研究所1层的研究室一直排到第4研究室，第4研究室后方有通往中央研究室的[传送装置]。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d66f343fb8821cddfcd8d0e68f95e95fd58fc535ad066db91c8d9f5ac9f30524",
      "source_sha256": "9ef8a49bfba99350c12ffadb8886272853d8d46955106ac3bd7f9910aba08a90",
      "translation": "要使用那座传送装置，必须启动第4研究室的[动力装置]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9eb2c201d300b6ef7ddd4cb5380cdf675285dfa9d702fa803ea04444b148575e",
      "source_sha256": "d22652d666e27a8cd134b926ede5d244ee77c1c6938827545ca7effdec2e1cf6",
      "translation": "出于安全考虑，动力装置平时并不运转，只有使用特殊钥匙才能启动。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83a867c63596f2313103b1b4c1f37ad223185eb10ada85599ee89280777460ea",
      "source_sha256": "286cf1645fc0dac77b5670d383064530ec892441da8ecaafdd25091ff07694a6",
      "translation": "我也有那把钥匙，在被带到这里之前，已经把它放进了我的保管箱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b447158eeb3298d2c9351b9eb518a76c16d99cb0059bf6575e36e451b087eaf",
      "source_sha256": "fb5a43eec4368d7879c899b675c3fe7477a52541cd97450fb042e48c2f0811f4",
      "translation": "我的保管箱在第2研究室。这是保管箱的钥匙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da14d1f7d3f235cb0fd57221a170fc68cf2ca7d5c1b4bb6bd3a6172f3eb61208",
      "source_sha256": "546e9400b818ce6823079f253f923d749e9ed4bbef8d206e3a161f9765991ae4",
      "translation": "请前往第2研究室。"
    },
    {
      "id": "coalesced:78d57d77052aabf2ac4048c8fd629afae37b393d75619465872fdff275014cd8",
      "source_sha256": "1cfc5d226c4430533b674d041dd006489e4c806c96734ef77b43b067609f1398",
      "translation": "现在，传送装置应该能运转了。请抓紧时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4503c4dfd368939fba411e368756a90935d50bdd365cc9a902483e614453a467",
      "source_sha256": "b9d7dd6233f07dcb7334d725a8a1ac811ffcd6d375a2914f34bdd238f3adf0a6",
      "translation": "要使用通往中央研究室的[传送装置]，\\n必须启动第4研究室的[动力装置]。\\n\\n前往第2研究室的[尼克斯的保管箱]，\\n取得[动力装置钥匙]。"
    },
    {
      "id": "coalesced:80325be8425bfde7d7cbcde1a3bafa125f027e2b5331d151a3d3bfd837c65bbe",
      "source_sha256": "624b0cdf71488a6b659973dc0c0feea4e236052218e5fc834ff797ad97e0f003",
      "translation": "动力装置钥匙"
    },
    {
      "id": "coalesced:a67f25d0d9a4520be6d994cc2b758646c8aec52c354f54e63a0f2aad32ea425d",
      "source_sha256": "e05fbc9bb406c3477ae9121c317cd823491671be664445c9328a291b110208e0",
      "translation": "获得动力装置钥匙"
    },
    {
      "id": "coalesced:e99d5c7bc7a3c7f8704d055532d8c9f25263317aefafa1993f95c605b472c071",
      "source_sha256": "7ff4b3ae7998d0056a3c833608bce795ab561ffd141a1ad254fef81a03b0aa03",
      "translation": "QUEST%s: 获得动力装置钥匙 "
    },
    {
      "id": "coalesced:ceb34aec9f3e8ede9678fb8b3c6121976454bd922cdfd8a8bd82e562f36e0b3f",
      "source_sha256": "d977f59e428b855b462aece03d13d8029d9cd7a157c99f1546b191b7c77a1cec",
      "translation": "现在，前往第4研究室，启动动力装置，就能抵达中央研究室。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08946d056f80b98cd175a8582bb094052d6efce60162ca26fb8855fe63a5bc14",
      "source_sha256": "d0dd12b20730be573d4512ad35bfc5418d67ef5835faa4047558030c7d7a82fd",
      "translation": "因为有传送装置，第4研究室附近应该会有大量北部军把守，请务必小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:821e87e6e7fbb0d123303ad392f8ef99c695b89e44a190944b731b53afaef733",
      "source_sha256": "147ab43881f5eb94c91cc09af161bb40c32ca7c671c33747c4a0a17f1344173a",
      "translation": "请前往第4研究室，启动动力装置。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92a2bf9b84ee26355cf6155988d4f3eb822f16582ba339d4e6e7b4b02412aa21",
      "source_sha256": "147ab43881f5eb94c91cc09af161bb40c32ca7c671c33747c4a0a17f1344173a",
      "translation": "请前往第4研究室，启动动力装置。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe0b66cdf8e1e776ebd1a96ee63a318058a973217c55f7c78a39670651efb567",
      "source_sha256": "4d1628a12a739cf739ac282547a6bea8f3de2d04eff8287afef5bad89b0e509a",
      "translation": "前往第4研究室，启动[动力装置]。\\n启动动力装置后，就能使用通往中央研究室的\\n[传送装置]。"
    },
    {
      "id": "coalesced:feee470c258b52f02c3b44a6178dbc896e52643e791e6aee8410ebb09d853540",
      "source_sha256": "9434c8e63281c369dbed1fe913ae99452f626888bb74c479e28e15ea317a5b84",
      "translation": "QUEST%s: 启动动力装置"
    },
    {
      "id": "coalesced:bbc387867f0a3b7a15e2bf26e21228949178c2f28290cc16a674f8b93c45e766",
      "source_sha256": "caf78c2e8939e3f8c82cafca77c084beb72f355077cb2fe65ae0a8574a657f4d",
      "translation": "启动动力装置"
    },
    {
      "id": "coalesced:3853e847e772fbe785a2beb4d7deaba07eeefeafb51e3e0e36ab2a594a0dcba2",
      "source_sha256": "9cd34851dc3a927b9292e89e17b5c32bde721e4935115a7634fca3bb33bb44ec",
      "translation": "启动传送装置"
    },
    {
      "id": "coalesced:b19c80fb44ef557a85bf497fef8739398d940e955865eaa7a0ee2cea9a3137d5",
