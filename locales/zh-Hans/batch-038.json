{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:87cd31f3dd8b7cf3b73473df3606fa35a3ac4168b163f4d93cac216dab260e52",
      "source_sha256": "08b4a60c4083abbf8730516555866658783789e77d8995dc8ac8c436b4e2a454",
      "translation": "来吧，塞蕾丝汀。我一直在等你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba8c653e14700f54724a61529fdd8fea405c5fc3dc9b6c1bd68c5dac343b6d65",
      "source_sha256": "efa2ae2ad24f15f6dacd47dff978c0f81ae349ca1690de1b0939778f902fb013",
      "translation": "前往柯塔马雷寻找凯汀，\\n听他讲述塞蕾丝汀成人礼的事。"
    },
    {
      "id": "coalesced:4d3d6a98141f978590c98d335d3b7bfe069229c99107d4bb4c223228e5b85049",
      "source_sha256": "550024d0731990c1984f2e291cf01d691e2a23556305410f0a51c0c32a71221e",
      "translation": "凯汀的信"
    },
    {
      "id": "coalesced:133fb2f8185859e74d97f1b15b7bfacac33d95cb76a24cf7f9836c3984a39ccf",
      "source_sha256": "ce661640f373497db90d378a0dfcc05e6a3ddb11d70500ab779d25ad8aa0b24f",
      "translation": "我为了成人礼而叫来的人，是塞蕾丝汀。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a088591bd02139fc7fb450c051753ccbc7a1b74ee327fe22f7280269643afb2",
      "source_sha256": "e662a5486e97d4959883ac3e847a16d396f22a959dccea2ac4c0fd0c8cb85470",
      "translation": "唯有继承王室血脉之人，方可觐见……"
    },
    {
      "id": "coalesced:924f0766f89b81e9542607580fb721991942306aefc3aac007a453a8e4174f1f",
      "source_sha256": "498ee8328b34916470bd3722a626bb0f436f0904ac20adb39b6f178b8176d121",
      "translation": "唤醒我的……是你吗？蕾洁菲尔妲·格蕾娜·贝尔利内特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdbdb171c2c74d5120383ce301780a482960a977238ec3b7299a9d37c2654d67",
      "source_sha256": "162e0e440e9071e9e3c8dcb31a6229557edf80a3fe79ee77118092dceaf78f34",
      "translation": "继承王室血脉之人啊，接受试炼的时刻到了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7c692b51831d44a80dee23a193484b6bb70c47c1046939f0a191a2368d4f7d0",
      "source_sha256": "6af1ebcea993c8e899c39e9b5bf69f56b4933ead7ba7af4ce9cf31712f877f61",
      "translation": "你是否已经做好准备，接受王之试炼？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a779d256cfa71e74b177b3b8071366ce0078bf7747f83f38edc52d3e5a9301f0",
      "source_sha256": "8590882de787e0d38d3bb05da7912d60b2df4dbcb5767e690aecfae31b651b52",
      "translation": "你必须前往水之力充盈的[水之神殿]，接受第一场试炼。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3338e0379844eb14e8bad76c52a8ebf2d6dacfa02fe2f8c644eb9ec564e5d77f",
      "source_sha256": "93f39bf1e9fa9781dcd9c8fd14a7a66a09fdb4980289d77834883e9e9c959686",
      "translation": "水之民会为你指路。"
    },
    {
      "id": "coalesced:57fef6a9c176d3d09b97876d46913aa3836b7b4923e49daa8d76086b5dff0670",
      "source_sha256": "b938e2ae1909aa32a8dc00c095394eb72200c33c871726d9ef7a4d28eb3516f4",
      "translation": "看来你还没有下定决心。我可不能让心志未定之人接受王之试炼……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:62765abbe6abf3503b1b446a6559b46cab6e6e33f8785a2e61dfee41bb6ba0a3",
      "source_sha256": "333e0ef69418081c4676567f6beb4b375a4b5245d9b3f351a97a9fd972591f8b",
      "translation": "你已经做好接受王之试炼的觉悟了啊。你见过水之神殿吗？就在水色湿地的暗影藏身处附近。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e81256646efacb65008ece2c92801efb8d85981dcc97e7c8617d5f087781a367",
      "source_sha256": "8aef43e52430d57579861f1bc212976899087f9c6eaf53ec3bbb9b8bb1f9947b",
      "translation": "王室神殿设有结界。为了不让邪恶之徒玷污王之神殿，只有资格获得认可的人才能进入。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b64e2a253d1d10e6f1d3c03201b295b8d768eb038c81a6d83318e24b4235e527",
      "source_sha256": "c41919021792f6f4a61ca22d48bd55049ea97c031ca1868ab1efb208d89b77c1",
      "translation": "兰兹海姆王国的初代国王惠西斯，对王有这样的看法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93e2c5bec5122da31114d24bf99fca6a605bc3736288908e42785e4370283de1",
      "source_sha256": "acb4b6fa6ec6e7087fa753062c3e3a106cd02222f34fe1ef0ffa166f884fdbac",
      "translation": "身为王者，必须获得的不只是人类的认可，还有世间所有种族的认可。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b1cea29e898ec5ba1e394e8f5c89f22b16a3d484b6ed1c8aa1497b9e52e473f",
      "source_sha256": "eef5135b1f957be49b77c1361be173e2e2a8fe746e1b29c6d26be1c056cdc7db",
      "translation": "未能充分获得认可、尚有不足的王，最终会偏向某一方，作出错误的判断，",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:911a77bbf05e93a27c90ab9b65eb72f4fa67e657cc110fd7923997a53934e973",
      "source_sha256": "f0e3b60d00c6f7e9b2c585fb5312ebd9d2848911cea57405c4b4e36aeb5a56a6",
      "translation": "甚至会像当年的卡尔塔与人类一样，相互争斗，将世界引向灭亡。这是他留下的话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93fe1c9ad0214e92e51e49cb1a3c08f5d8af11c46c7e0d690dc5a1bd0627e725",
      "source_sha256": "a2c747f0324e3265db4299eed48ffbcb1513386e127d0997a33b51e883eb8a53",
      "translation": "因此，他在各地建起王室神殿，让守护神殿的各部族给予认可，赋予王穿越结界的资格。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5cba9024423f9df2dddae70c41a0f39c582f62cc8c2259b5380bbf05b6d6935",
      "source_sha256": "e57b9a4605f6869289659c7c9fc229eacbdf4be176f8cd032cb443222edb04da",
      "translation": "穿过结界，便能在神殿中觐见水之魂。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94941470b34d6fd837e5982f9ca9f04253e79e2fb1c56ff7554f1c7245b6c82b",
      "source_sha256": "f160490ad239d7d84369129591f06ba225cd7b431ce5be53ca03b7f90b4224c8",
      "translation": "你可以从水之魂那里接受王之试炼。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed9576be49b748f983d207d5122119b06527e10405e2a3b9ee2be0d6a1c18a1e",
      "source_sha256": "db9fa351ef11c0724234ee5a8e97a913c884a7adcf46557ae4e0f651c425db36",
      "translation": "听水之民讲述王之试炼的事"
    },
    {
      "id": "coalesced:35ce5d02e2d81b57905a66e9c1985ab30596cb37bae5dfc3c6950109cd8ef2c8",
      "source_sha256": "d888a99426e271af44f9f8719fcf1d393730279de35e919e1ef78744441ecc34",
      "translation": "王之试炼"
    },
    {
      "id": "coalesced:49ec5a84b0c804ba10ac8ba1ef4e9b03c816262acf08452609ed21a0cf3fe526",
      "source_sha256": "59f0b7b09a070201f2ce41243be82e1434b199e75cfe7392cb549d27482be1a3",
      "translation": "关于王室神殿，我要直接和公主谈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14bbe6a1f3ff12373508d01aace9baa308f2d32114cf1e1f381fa52afcd38c39",
      "source_sha256": "22f2751d2b9eeda61b44f22cd9533da144a8b08279928c96c8bc270f8b63137a",
      "translation": "你是兰兹海姆王国正统王室的后裔。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6767939be389951b8772a25a6268a200571b303cadce151c6e1c62ba4494224",
      "source_sha256": "27d7c9b5dd11e0d352a88a0ab63b7dbae7bfcf72e16a476c95a117541b92e590",
      "translation": "而且，我认为你的人品也足以获得前往王室神殿的资格。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb2efebb58a991c8a9e87dc4727b1d168f6b22c4bdfdb23eea695dffb0b77c15",
      "source_sha256": "68ec2a6fe03b72c4b37f7da399c69e8c54ab1897e432e782e002510124bec356",
      "translation": "我很乐意为你开启通往王室神殿的道路。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab930c616f7c797695114c985f3815af7e1a382fcb4adf87efebc9fc5a452d92",
      "source_sha256": "79c9f9e46f108e5ecd242bcc69a2bfc28f89ad3a7a5216453bc12ff6b9d4f38b",
      "translation": "但你要记住，得到我的认可，并不意味着一切都结束了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:176255cb79e0bacb59548236681265af77fb92eeaaa8e1cfdfe7b995cf487809",
      "source_sha256": "e216048e70d59c3a8324e805ec8920fc22b7e51e0d8fb50f29bddd90235346db",
      "translation": "带上这颗水晶吧。它会为你解除结界。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf28bfcdcdb64cd4fb646974f8d67bcfdee1e9eef19547b3662ca7e19eae26fe",
      "source_sha256": "4cfb026a27813cc79d8ccaa9f8f0377ef46d173aea30d78fbd354a001e5e5726",
      "translation": "去觐见王室之魂，接受身为王者的试炼吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84248857ec12d37ae01ba3dbe723fdd12f8645c4648f018f0ab68666dc49410d",
      "source_sha256": "2ac9189998c8af52baba1ab31b955e36dab29e7129f38499c2d2f803b6dca4eb",
      "translation": "没有成为王的打算，接受试炼也就毫无意义。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:759bb6a79a0e15cdcf90218db2cdcffb2371d1d26047785b779530d8d7ebe468",
      "source_sha256": "ee50466a4645f435aab9ca792adbcfd8c13b0430883e20f99f7fd903e1513bb2",
      "translation": "那这颗水晶就先由我保管吧。"
    },
    {
      "id": "coalesced:17f521b88c93f074e912badb57fe221e79ca5fbe383adf96b9523d94073ba3bb",
      "source_sha256": "dea3e43af2148a8e3dce0a47adefa055b3e6972d107bc4a19ab9c6f8142d3150",
      "translation": "去水之神殿觐见水之魂，接受王之试炼吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9842937e8f0ac6bf9d553528eadf68c81ac71da974bdea269104827e8db5af9",
      "source_sha256": "ab2ca383d92a6a5371a57c637fda49cbf5837f0095cb6b2236cddbd48d6f00d7",
      "translation": "我一直在等你。蕾洁菲尔妲·格蕾娜·贝尔利内特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f509a987c53ea3528928fd39608f1ac40d512baebf8a97f7a2101554158fd2c6",
      "source_sha256": "4fb23ffbcc4628a239cb94883efa6554476bad8d2340d5517ba07e9508c8cd63",
      "translation": "你来到此地，便意味着你已经得到水之民的认可。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fd2ba6fd7c160993d1b52257c342d6eb370b60bd749a4855e2d979b91eb31a2",
      "source_sha256": "3c44ea785d7764f1febb9782ead809d39e2930e9e658f3c627e2e8208b0f6f50",
      "translation": "王者需要有足以斩断一切混乱与纷争的力量。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2af2c7fd58a6a404d8acdcb01af1100be4d07da9fb0527ea849772a660d6199",
      "source_sha256": "a88338c05fe16ccc5366fa734afb5a9293664f4e876ebf3b2f1089f3a9193d80",
      "translation": "但也不可过分炫耀这种力量。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48721d2ec5d481f97868d43493ed728d12e647d01d4968b18d52a7b6fdf25eac",
      "source_sha256": "0c2650bd8851a80d01a5cc8d4f10c58af515ab0f99ccb944e81f0b68319ec0ff",
      "translation": "适度展现力量，众人便会追随你；滥用力量，众人便会离你而去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c5575ffa17b8604e2ca740079a41ada55c1bff5095b0a5765cfe591b6a14455",
      "source_sha256": "f2775f26935d08c388c1f70bb3daf51bf70799b68e5ba306a8bbd4e04ab5a0cf",
      "translation": "务必时刻恪守中庸之道，治理国家。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d822099c443c8a705daab9b0d8d8ddb54a3625352cf90fa7418906b6a220962",
      "source_sha256": "052f0d95dd20f8fcd265de8934c47f8ad3aec007252b057fdd3dfe2048594cf5",
      "translation": "前往水色湿地的[水之神殿]，\\n接受成为兰兹海姆王国国王的试炼。"
    },
    {
      "id": "coalesced:f0f2fa80f9a587e97e14f88c0d74b12063478cbae738f057b0a198dd55fd6837",
      "source_sha256": "300790b63d61f98971c0d0785c0fc56e7b3b3ddb127072082fa6b75746188b39",
      "translation": "王之试炼-水-"
    },
    {
      "id": "coalesced:9c2d8bee28f7a6629ef4695a903bce1a00bc93124da6191b26c776734a7d4e6f",
      "source_sha256": "b2cd71769eac53714894035df6d7ff9900b274b08a5767acdf8125ea11566a80",
      "translation": "QUEST : 完成水之试炼"
    },
    {
      "id": "coalesced:050fa8a686f4bad9b9220398de3322f767117172a438a3c0ae136f9339037a34",
      "source_sha256": "63be7fa42164d3197dbf5726995586ce9c6e41fa9ee6358db3e8251f6f33963b",
      "translation": "即使得到了我的认可，你的处境似乎仍不怎么乐观。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9cbc09855f325db8d4fa0b61542cb0bf8c7ff9cb863b096ef63940eaa2952d87",
      "source_sha256": "f0e8b5c02f5b7ddd0ee12e0287b02e70f51ea0a9650dd15c95f9370c2c5e2881",
      "translation": "赞达利亚峡谷……不，如今被称为[老狐峡谷]的地方，有一座火之神殿。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16f2ad820779ba4da1ec4254b263ba5b0f2c502cc4ee26947f59145da9ef94a8",
      "source_sha256": "ec0a758dd7570ff380c1441e2f7ee6f99c7ca6a90da260dfe820ff3d19d42e0f",
      "translation": "去觐见那里的火之魂，听它讲述吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e3ad600ff8809f517661fd8c79c9695fc8521953a70ecffe535f8e881fd70f25",
      "source_sha256": "a83382715d75d9653045053b6621069e7f8afac38b95e2ce613ac4e6a180f093",
      "translation": "我们本不认可两位王，但似乎有某种未知的力量介入了。那个人究竟是什么来头？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:51b2b96b8cbc5ebc05451bd68583172c873fb9c9a221a47d82ca95692c208fa9",
      "source_sha256": "889a7ea42a104578441ecb5911addb05490b1fe7715f4ce7a2bc5596e213d0e6",
      "translation": "火之魂似乎也很困惑。详情你就亲自去看看吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:887465926f3014beedb21a3368d2cc6117263d6c3dfe174a950d77f6bcb1c960",
      "source_sha256": "096e8d8bfb27db2723e4564fe57ee1e1611bd287ec6f5c5ebaa3692ba84e22ca",
      "translation": "带上这卷卷轴，应该就能解除火之神殿的结界。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3480c0258ce1cd6ad53758316e2c99677958fda5281e5018acdb83554bcd6184",
      "source_sha256": "826be66bbf303923eeb1048fcc89168a1eb9557cb0b36aa0a452bec30fb81851",
      "translation": "若不愿意，也可以不去。你的器量也就仅此而已了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7494b37b349b8e87e33972463a8fbc3d5db39718fd12f078ceb197a6f565cce9",
      "source_sha256": "5a2c6ec6af13842c4a20357c2c025b6b3ed2c683d8a3fde6c600b18fdb8899a5",
      "translation": "前往老狐峡谷的[火之神殿]，接受第二场试炼吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:461d7c660be3340b656928beb408ca076804958efbf8fc602608b9c489720468",
      "source_sha256": "222cb52e6de9c29ced4918de02d61103d740017feb99fc7e27efd7d5d6fae821",
      "translation": "你来了吗，另一位王的后裔。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5dce96028ab1eb7136bbb2246b158b7da557e982b020a2a1ed00bd03ccd9a419",
      "source_sha256": "3846693200ff3edf05d02a5f32030b9e3dc597e1dbccbda89c28e38f6b22fc24",
      "translation": "我们十分困惑，因为两位王的后裔同时出现，实在前所未有。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d0e2f5cb7248a7f9c78a24cd85e1ad24f982865e62bb86616c46316f3bf0eb02",
      "source_sha256": "e442ab82476859dc5fd0a88d6d3a55cb3d480aed1d234b18ca5139d93d1b6c4b",
      "translation": "你也继承着正统的王室血脉。真是奇怪，太奇怪了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9402bd67692a8449dd4aca963b999887e4c20c8b3627c658dd60506e24abc1b1",
      "source_sha256": "ffeab7607b7410b02aec1f4c6d0bfb2cffd74ac5b55efb131e183f7004146cdb",
      "translation": "我为何会认可那个人为王……虽然懊悔，却也无可奈何。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7853ce444b0634cd9dadb3e00a9a63f37f6e741b5163583dcfad77c0d9dd585",
      "source_sha256": "b47709cbb1addcbfc42627cdf73b99b123d5409d993c20e5d07d8b26136c30cb",
      "translation": "已经给予的认可无法收回，但我也会让你接受试炼，好让你证明自己同样拥有王的资格。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee0882fdab969496bf4919aed1c8c14ac2b7b445ffe53b248b860da76a8bbc0b",
      "source_sha256": "f5edf2764a57a78f6ee71c8cda5c112c5ebb66d43fb6961a68a033368055c21c",
      "translation": "现在就开始试炼吧。你必须与火之试炼战斗，并取得胜利。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4893bffdeabeaec5f1cb26c158b90470f1d93d1571e8a177fcb197082536459f",
      "source_sha256": "bc769177e911f7013aa5e4dac1a2b0d7ca97af550c4372545e1fb9bb44367f98",
      "translation": "果然出色。兰兹海姆王国的王室，向来刚柔并济。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:069782e4d0996e2347a98ee48188cd7ffa8ac297b01bd0b637a7673a28ed89b2",
      "source_sha256": "17fd1e164337becc0a8b85c7532ee3871f6ee1d9e54a0febf0cfd875085331a6",
      "translation": "你也要成为一位刚柔并济的王。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e6db3da9ae55e9891cac1a551446960739b7f3c27e44e5973b2a91bc8387a39",
      "source_sha256": "8fc6eca9be5b9eb1845e56fd1c080672a90e42786990fbf4587a0d00bd81dce1",
      "translation": "鲁哈尔特盆地的[雷之神殿]和鲁哈尔特高原的[风之神殿]，尚待你前往。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c31df39aa05fdd0079caf81686e986359fb3902104e706a88c8dd1819d254512",
      "source_sha256": "41de5023fa3058aa17b2af4291880cd14637c987f27b974d21df05082bdd370a",
      "translation": "先去鲁哈尔特盆地的[雷之神殿]吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c9437fa29452c2841f4cad58011ef821661fd6d3f507c865a086cae0926c3c8",
      "source_sha256": "61bb453c2feff0212aba4bfdddf2f530ed91ab7234cb761ec19ac980d7fdcca4",
      "translation": "前往老狐峡谷的[火之神殿]，\\n接受王之试炼。"
    },
    {
      "id": "coalesced:255b203e17d1c32d0cac871e691a6919d19492f9cc9da762dfbc8f1ee2dcc423",
