      "source_sha256": "a060cc647261b7295ee9c2d57cd6569407ba820482bd22c37a44740f6445a44e",
      "translation": "谢谢各位相助。请先摧毁死亡弩炮。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
