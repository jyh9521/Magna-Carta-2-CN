{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:3f4d1b62cd2664d94d379bda87b4485e11cc28a835433626b25e9ed909b60a4d",
      "source_sha256": "75223756c8151233d8aa934016bdbf953d920024ace4f2edea9becf604f2b209",
      "translation": "大家都睡好了吧？"
    },
    {
      "id": "coalesced:cc800f778c42616b948d2658d6bba323d13ac4288ee1f32ed3e028fa135d032f",
      "source_sha256": "a80f296787c0bfd37c919d5198ff23dcd1a898c86b8b477f48f4f9ede1ee0d81",
      "translation": "虽然还想再休息一下，可我们已经没有时间了……快去见族长吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:328dd4ffdd5eb2e5434b85bb022d2431d5bf0f841c4dc4ea895c6a7db6886a0e",
      "source_sha256": "e156a141ee239fe842717b43d46702d0c3beab7c35bf01ba9d6b02708a774974",
      "translation": "马雷族的历史资料，全部保存在海底洞窟里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:82396bfedb78b26b6490265e2ef95ffa0ebb718a6afafc76838a613e34a4fded",
      "source_sha256": "f12aa1ee024a5b50814dcab5d1da6957ae40fc6e667a03274c9d228a54b51216",
      "translation": "那里有一间只有马雷族才知道的密室，是为了妥善保存记录而设的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2294b7745f70d77ffd0a146ae03711d4f187a73adbb0f6a44e95afeacd66d601",
      "source_sha256": "5a4909b49889d20c57495bd12e4f65e6efdca00a494a2d7eb040a741c968924b",
      "translation": "我们进出海底洞窟好几次了，竟然完全不知道还有这种地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:70873fc90fe4cfd8d7f3ac87a0ab6370e2a4edd70d7b8a88d8eb8f77f6db1e08",
      "source_sha256": "8ce7443a294d5d917d127ef2f6e7c5909f3aa77ec21bfe5ad9240c519d22e845",
      "translation": "洞窟里，还有一道隐藏的门。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff7a62e706fe291ca3d0fbe64723ce4ab73ba84d57fc1b4ca86e645dcf832749",
      "source_sha256": "26371bc010069c8555c46c90e1bd7416f2cc7ff3ec891ea42d6c91910af4cb15",
      "translation": "斯特拉斯石碑上的文字，就是打开暗门的线索。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:464747ffbba52bcf5428c55654609d4d694e5c65efa064ecd08881fabd36cb78",
      "source_sha256": "b1c6f89e91db8ac167cb17e06054c084e2ee6bdad5579e7e98adacc7d15fc163",
      "translation": "应该不难。只要熟悉兰兹海姆的历史就行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6bb43416e585102bfcc03d24a051bd582c5535903d11fb9f034094ff5915d3a8",
      "source_sha256": "80030a6d877b874166220af39911a0d598ff23e4a99d6924e0ce3c54078c62f8",
      "translation": "把这枚印章带上吧。"
    },
    {
      "id": "coalesced:ae8872202c34c99e6543cbe7e3f8b4bf751e07d781fd07e74b9b7c494134b460",
      "source_sha256": "4c4e3f732cb0836cf897eebf4019d4c8ffc1440ea28f00d75b2bcbbbd43e435e",
      "translation": "这里的斯特拉斯石碑上，写的是千年前的历史。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77308274feed58739b765e26331368ba2ae1d915a6b949d01fbdba972daced62",
      "source_sha256": "bd110c1b83f68a6e8d32bae9b7f40b438d2c33cced21201f5c35350a88ab6e11",
      "translation": "拿着印章，按顺序阅读，石碑就会发光。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06d1075f10578dafde033ce63e84210cc345af6bcc84384278eeb79991b5ec89",
      "source_sha256": "78b796a99c785419baad2a0799fc5ab8585b0df622bb6e11b24e63291e7c922e",
      "translation": "等五块石碑全部亮起，暗门就会打开。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd695078b9a046581356c5b5ce05e1cd37d2f2667e787c82fbba429ac3c39bdf",
      "source_sha256": "62d3480e0187731abf221c11e8d8bac7336b3dcb06c0fdbf92914e3be89a7474",
      "translation": "很简单吧？"
    },
    {
      "id": "coalesced:92dd51e230b42333bc43d2fc70d7c2b8e5d9f64916d7b56b671b9a07eaaa7e35",
      "source_sha256": "6eb5d0d00f4edda2dafc7a7b72bb7dbf6958b307ace359fb79ba9d89003ea2be",
      "translation": "为什么现在才说？"
    },
    {
      "id": "coalesced:3d0d908b9df426161164ea2e38f3105d78b7cde0c26ac7d0dd1b132135dc15f7",
      "source_sha256": "dad4bfe9253456b6e60d1e3fed6209a00fad2c62129ed145db3248ac48fed8f6",
      "translation": "一开始，我也不知道啊。毕竟，这里就连马雷族里，也只有少数人知道。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:00573431454ed635580b8a521e4bd6e2c05b1e4f9de2a1020486b438e1615322",
      "source_sha256": "714133b471451be15ba0dd00e19d023f291d7676ad5843853770223e09f45824",
      "translation": "族长也是因为信任洁菲姐姐，才告诉她这个地方的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:50ae0ee8426b2f5681b35fba4ee9e12d2acd078c8dda01955f266d625fe79354",
      "source_sha256": "83847f100990497415277b90cbbeed0d3f0b686c48429bd879dcbf5958bb72a4",
      "translation": "得好好谢谢族长。"
    },
    {
      "id": "coalesced:8d96d6623f369fb6e454f8384e387a6efc5c8a5243ee1ff712126fe02955dd59",
      "source_sha256": "5d0c74948432f3688a10990dfa826f2c81408b793d594a703fc62a6e09546d67",
      "translation": "这里就是保存马雷族记录的地方。"
    },
    {
      "id": "coalesced:af4c6e6af6d44742f114cb04eed32de86004a708cc0daf6c388f0cfdbbc6aa0b",
      "source_sha256": "f39119752e49385170773bafdce7c33e8e77859dbe10958f364953cd32d8d5c5",
      "translation": "是水晶。马雷族的记录，就存在里面吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:628565c425c2b29aab1f66eb7bd512b2b1f4034ddc2be22e867a33e96f668d24",
      "source_sha256": "83e3e202b67bc03f7d49a6201ddf2d7be0086b24994a52b90f32326a7d77c61a",
      "translation": "嗯。听说，马雷族一直以来收集的全部历史，都保存在这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:85fe294f77688a3069cb89b14e25f6d83975c2b7ff69d9a4a943183c65c7ba6b",
      "source_sha256": "daf6d55cc370e9971e9750b35c1999bb67b00cf79a919dc81444f61e3d3ffdaf",
      "translation": "那就马上开始调查吧？"
    },
    {
      "id": "coalesced:38075418d34fb5bfe24220106e7726703cef8d37782a54ae49492eedb904fb65",
      "source_sha256": "6962d1800fed10de7b1cae8bfea2a6ab6445fcb5b6232142374af6a0f248cf8f",
      "translation": "啊，不过，记录是用古代语写的。因为担心外人拿去做坏事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8ca3bee2c28f0b598828a47a061dee3a23c10db603e58294d13f51d0f78f105",
      "source_sha256": "b6f142bb5c83a6e0357da826ea19aafbd40081a6033c7306d20e36efdf022a6c",
      "translation": "古代语和马雷族过去的语言很相近，所以马雷族都会使用古代语。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd9f302a063489f8bf4a5dbf67423348bf1783e29ada90badc95974f8bb7098a",
      "source_sha256": "90d9ddfaf9c79b22810752668f052b18793108aca2c8adfbb6226925fc4c0000",
      "translation": "就由我来解读吧。"
    },
    {
      "id": "coalesced:33d83776595ef9a6daaf93a84298d2eda4c3993a85f5b021f8d6aa29f872f333",
      "source_sha256": "bccd39796afc3a89456ec5250679c688b693d963186575932a6c42634c0b124e",
      "translation": "什么，你会读古代语？真是没想到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f589ba89c3fc7ea5fc2816fc1f6d1e074fac017ed4e43029c553f82cc632548",
      "source_sha256": "8c0232c88d756d9f4ba9e4f41c7ae45ca1b2d70ca08e20c8e2b09edd5ab5fc70",
      "translation": "吃惊了吧！接下来就交给我吧！"
    },
    {
      "id": "coalesced:0a9c4896d6f66ed7dd231e7a46a726a0335dda766e77c6f605cd2dc1fafcf547",
      "source_sha256": "51033b0317b494362439c68f70fb2bfbaee2e87f36ffdd43a791cf873bc560af",
      "translation": "那就拜托你了，塞蕾丝汀。"
    },
    {
      "id": "coalesced:b45b84353d90702e415af1e517ff4dfe7a881072c55873c34420adda6806df93",
      "source_sha256": "1265f3b9f9e705377f91dd7a1c0d01a687e6d02af9d38a7e790eda75d8e21d68",
      "translation": "嗯～这份记录的标题是《持有卡蒙德者：玛格纳卡尔塔与混血儿》。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e319140a1309b721aae7d00ab2ff233f8d818c1f273580f361c3917ec056ad6",
      "source_sha256": "5755c4862923cd98d53e1d0a4e411f143204887949debc5d2e3c902f3c41560e",
      "translation": "能先读和玛格纳卡尔塔有关的部分吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:660a33a299784c981e6f2b4641d4879a0b5a88ed0a710a9b7080b4cb48a3047a",
      "source_sha256": "28264acc012a10e27ffb73b70cfff52250e15d4505f6518300a7b01b941fb933",
      "translation": "嗯，等一下。从这里开始读就好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4036ef6525627337097a313b96f8a76722d49f09f4c1e456f3769eb47e093f3",
      "source_sha256": "6fd94a2a3b7a1408973cae4b44b0f809772b5f778926a9b25a16d0ad167f623c",
      "translation": "然而，并非所有卡尔塔与人类的混血儿，都会带着卡蒙德诞生。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bc20a5e953eb82ca865ebe12d938ef14b30f69152587535c499b38cc562ef1e8",
      "source_sha256": "19b41bccc4049881803270e75970e3ecb32aca06b710ca00efc527fd21ffd0f2",
      "translation": "卡尔塔与人类的混血儿，天生拥有卡蒙德的情况极其罕见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d9427b344fd95734f00bd2258a2ec8a59881352869bf3bcaadee3cc321da4e86",
      "source_sha256": "a98f2cc470d0cfd6fd464a5d3b82461cdbabdb438b5eb3d8d6bb7c684a262094",
      "translation": "混血儿的卡蒙德比卡尔塔的卡蒙德更为特殊，是因为混血儿的卡蒙德会“成长”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b038ab5624f5482e3dc8a808bda43f697d60d44e528cf11e805ba686638d0d90",
      "source_sha256": "c5d20aa66f9c831a20cd27d27840eced72cea0660f4700695011d872fec8546f",
      "translation": "卡尔塔的卡蒙德，其能力在诞生之时就已确定。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:70fa818f94b991a472d815a07eab5c9baa2a0560f628adb93451065872209dae",
      "source_sha256": "7e0ff3316027316550e79f040b76e627372ebc7bd1cc6283f4ba4d9866dbd32d",
      "translation": "相反，混血儿体内的卡蒙德，会不断成长，直到成长极限的18岁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c195ef0c6fdfe8cba87e3449c932da1f7d8e47ce522480fb7ba679e21a20006",
      "source_sha256": "56d110e6ca0a2c2957cc5f9cc03e544d88c422370f6c45e302d434dc84fd2ac3",
      "translation": "尤其是生活在严酷环境中的人，卡蒙德有时会得到惊人的飞跃性强化。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b27154bd193f4a3a6cdb5637e04c61b2323a46be3a9215eba294565cf8dfc945",
      "source_sha256": "a2afba4e08e2fd6f69f3e2fc7ffbd30ac41b4abab8a55c51f50335c94e475175",
      "translation": "所以，修恩扎伊特才一直等着我的卡蒙德成长啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3fbb300947d7054406b0714edf45a26010734ad57ffaf2a65736840f750c521e",
      "source_sha256": "8151d1d11e728af16aa3d3aea2fa10738eda12ec3910d273ab39a57656561a4f",
      "translation": "看来是这样。"
    },
    {
      "id": "coalesced:e4a5ceb6de5f17a4fbdb7ff8922f89abadab072cda194074bcb66a1dd599ecce",
      "source_sha256": "0cb96141a0c4c9d2b4dd2cb0e49418047c90a1d9ebf014c3e36819767a7e1030",
      "translation": "此外，混血儿和卡尔塔一样，也具有卡蒙德被破坏之前不会死去的特征。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7157db0565b1d1b1d3781f48aa8f8e7ec84225a19ebc146b1549520e798538b",
      "source_sha256": "6045af5a64f65c1c72e855d91a7537f5848eb4f0fb30c7c00d6b5a67f3c7d2cd",
      "translation": "与人类不同，在卡蒙德被破坏之前，即使身受致命伤，也不会死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c09b13ca7976ec819900c69db3fe88e7600fdfdbfb656ec5b39de41ff18d912",
      "source_sha256": "30e286210f8208752b5f12de2183c7096f8406d2737cfbb402db5ecade10a459",
      "translation": "嗯～这不也是哨兵的特征吗？"
    },
    {
      "id": "coalesced:d102a85f9cf034e9cff7f724a92665babb96fe2e467cfbed6270ccf7c7474b6a",
      "source_sha256": "3cd7c7c8f2a6e9413962d8945c25f38d969a652df74ca93b798f6149e481faed",
      "translation": "没错。毕竟，哨兵也是模仿卡尔塔制造出来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:951920d1b6d2411257969b20c8ea9794be7ddfeaefc51a55590d64c3c2cb244f",
      "source_sha256": "a213fc263450b3da8b00b4f85156b4c59a8c5fcc7b5e9f66b43ba26ec162785a",
      "translation": "不过，遗憾的是，与卡尔塔不同，混血儿无法吸收生命体的KAN。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a2e430ea894b4ee5d1ec0266a20a96fdd0259317a184cc7acc1ae040a3adb799",
      "source_sha256": "5912811359aea2cabb32e99fd395d15014600659fb25198816f35ea37d9642f8",
      "translation": "相比能容纳庞大KAN的卡蒙德，混血儿本身拥有的KAN并不算多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd13c808b7c4785345f2abe66b5ca1c846be3c3811fc3b52935f59d71a61693b",
      "source_sha256": "9a7a58556829cfa588f9c8e05a54f5ae79802dcaf5cbe9571129a7ab31d4a76e",
      "translation": "如果从诞生起，就拥有足以填满不断成长的卡蒙德的KAN，混血儿或许真的会成为极其可怕的存在。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a367c5c48e4f7935aa915bd6c51edafbfe7395dd72d0320cdda034043ae4b9a3",
      "source_sha256": "ef99382e7dacfd5bd4b6fe91a1b4ba73207262847d410c67217f5c2c51638fca",
      "translation": "那斯特拉斯呢？他不是从一开始，就同时拥有这两者吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e911a42f5cd169fc12848ff733858627e55c95c1c1ad2ddaba6abdf782e7441a",
      "source_sha256": "34f402ef72a8040d1bdeb8d4907131ad45128caae826cfb50079d94f8a47317e",
      "translation": "这次有一份题为《不祥的征兆：灾祸种》的资料，我来读读看。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a82e2d8783144de72bc6bea8fe6f9369d76f4215e6746e4c437e8fc0f16bcc3",
      "source_sha256": "ea8927924a287adff65591562d1f4037195404b9d4f35d7ae93ef3ed1fb6bff9",
      "translation": "拜托了，塞蕾丝汀。"
    },
    {
      "id": "coalesced:726116f7924800e5484e00ef058e87a5c26fd835bf3b0e082b3408766b0c6b87",
      "source_sha256": "7f966d57b0b5c8f4b84a1cb905470fa2abedffa7c7ee351338f5832ecae6b300",
      "translation": "……灾祸种真的是使世界走向灭亡的罪魁祸首吗？"
    },
    {
      "id": "coalesced:ee08182ebfdfc6aa21188fa4a9510e21390481f2a7d385b8a2dbb80f3667e181",
      "source_sha256": "63cc2969a7de8a318752d012359e5aed56d2a7f8f9c340105c5130cb84bdbb06",
      "translation": "灾祸种降临时，作物难以生长，连环术与卡蒙德的力量会减弱，甚至失效。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1dcc4e093d6e7cde8b5ac60bfa14803afed701d03f2b09eb628b6bfa5242c030",
      "source_sha256": "de91d8cb64526e9f0bda659b537d3f018d491222e696328c164ab20bacd71294",
      "translation": "然而，接触灾祸种就会衰弱而死的说法，被认为是毫无根据的传闻。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e105563b3b62050bc3d6444c386f9636681afd4012a2d0740274aaaac4515f5",
      "source_sha256": "a2e0f230487a0a961d107995f1c673e560e05da15527a0df94df742d692639d9",
      "translation": "仔细看看上面列举的现象。精通历史的人，想必都能明白。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66da877954c10e4393bb9d2becd6168c657dac514fdf0307e7dd3e5129d62ac0",
      "source_sha256": "d219d138cf8931b73860ec44d9bd5c98c45468efae96e5c8db7974f3a19cd0c8",
      "translation": "灾祸种笼罩下的世界，其环境与拉·斯特拉达尚未存在的时代相同。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f79a5383b29fef2ea52cd395cd32952cf8a95c24774561cb0f686619ad4a234c",
      "source_sha256": "5c2e1bbbdb371f0c41bb16ee12a4737969e7e6c05914653989fda4a09d85419e",
      "translation": "如今，我们凭借拉·斯特拉达，享受着过于优厚的恩惠，却没有人意识到这一点。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47aefc62fc62eae9fc349683de268da965eeaa89c0185ffeb07fb5708b78eb81",
      "source_sha256": "95cfcd6a6d1aa75f42762a250756da035d625b009acb65f4a284c1344226ba1e",
      "translation": "灾祸种会不会是自然发出的强烈警告，告诫我们不要为了人类的便利，而浪费KAN？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72a756439e6d9d84721601fb7e049de425031eaa9f6ff56a69b7111435cfc514",
      "source_sha256": "8f151bab55eb57f966aae3873309da6220669d289122350904838489b7410ebe",
      "translation": "虽然现代人已经忘记了“耕作”这个词，但在卡尔塔大战之前，只有耕作才能获得足够的粮食。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cfa8fd93d448fbee996e4d9faf6303ac5c711d34f4285fe9ecf4a5f18472bc50",
      "source_sha256": "a2bc21df5fca0f98c45163563a2231a4221894fcafebd28569bfce4fd32afc44",
      "translation": "在没有拉·斯特拉达的时代，人类的连环术只能点燃烛火，根本无法与能制造巨大火焰的卡尔塔抗衡。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d42e2dd3ff0ca7393b387f255aad24490bc70eefc58604882a6de4c0b4fb4d4",
      "source_sha256": "39e066061df4de8ba5ba0ad5960dd8458d4d8730cd5d71e3789c064fbffb1f2a",
      "translation": "人类的连环术之所以拥有强大的力量，是从拉·斯特拉达升起以后才开始的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7fa1a5305fed1de1601f7405e73e9eb0405024b6915037cead49f7c79bf9b31",
      "source_sha256": "ab81a303f7605642e6df7f5a7ea39c61e8af7f68ed396fc8d85f35844f4293e0",
      "translation": "这份记录……简直像是在说，灾祸种并不是灾难。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4a3377db4c3da54162d858295d8ae7f2bc34b6d1a862d7eec7d5e9cc9a47c5e8",
      "source_sha256": "5066ed697a732f05bb8e4e4c91ce4d5e676f7eb5cc16d8be2c46a726a174a0df",
      "translation": "我完全听不懂，到底在说什么。"
    },
    {
      "id": "coalesced:bddff6249b969408da4358512584c6dc7c44a9d272e0513aa0829fe77287a72a",
      "source_sha256": "9f5a24ce6007bdf61ff7152bb1e1c12e335a494a24323e1bebf8c1a15d69135c",
      "translation": "也是。对你来说，确实有点难吧。"
    },
    {
      "id": "coalesced:e1ee5c004e05118e3ab54c7a82d2d5cfb4eec48cb12260b8cd115368df698acf",
      "source_sha256": "7be54441bf55c3c448d6b093f1b33d9512fc27dc4855b18ad82beca40643de21",
      "translation": "喂，你是在嘲笑我吗？"
    },
    {
      "id": "coalesced:6b614d2ece50ccdc899c981157e0311122cc825427fb02abf34923649159bb35",
      "source_sha256": "33cf6eb49a8784f219e4f2cc25f8f3808aba34a48cc5ab5f7348aa0b13bf0c6e",
      "translation": "因为找回了记忆，我知道的事也比以前多了一点。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:286450556808c0008b68cf450c9dfd92271e72d3d4996bb85fbcc2c4423e0145",
      "source_sha256": "4e260bd53464c76ff2a5434d4f872a48954d247a52b31635ac4b30c78b53827d",
      "translation": "嘿嘿，这下你们反过来了吧？哈哈。"
    },
    {
      "id": "coalesced:2a2446500104b955ca55274e02663d0ea65737c544c29092890e2dda5e59268a",
      "source_sha256": "df560038cbb5af81be49bddef3dc2c229d11067e42f5ee807e245ffea6effc74",
      "translation": "啧……吵死了。"
    },
    {
      "id": "coalesced:c7092e706a7fe33afb633a58d8656566219c5d706093948d6600d851c590b2d4",
      "source_sha256": "90812337d7f27bcb92ecf40d3ec34061b65ce008f594a8b69a49399335fee569",
      "translation": "还有其他记录吗？"
    },
    {
      "id": "coalesced:b590b3f1a0806a581fade24a5dc774e2e5de73fbedffd673c9f74cfbddba8de4",
      "source_sha256": "8f4c7b761542a57ea0a8a734c5ed289d7941185ee986eff85ee5330107296336",
      "translation": "《兰兹海姆的战争与奇妙的巧合》。还有这种记录。什么巧合呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:736c067fc30cec4297d3466f2c98c37a776910674c711dbe3fef7c0e67d14a14",
      "source_sha256": "2175cb7cd96d8fac6b6788ebf413afb25478158b42edaf1df877b3d3859c0a30",
      "translation": "总之，先读读看吧。反正，就算我们看着内容，也完全看不懂。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1df1de7b0c8a79bee5ff0bb01bf7b3ddbf019d6cd62707da206f015240b6ca8a",
      "source_sha256": "9c670199b9e85a6ec6c3d16fc66e70e1ee72045a0678921617dc0752c2c48b1e",
      "translation": "知～道啦～我看看……历经800余年的和平后，兰兹海姆先后爆发了两场战争。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e044359094b84cf5361ab01bfdba686e55ba6619e1088af931d757f9c98009b7",
      "source_sha256": "1470ffb351f15edb7cd9ef6708315414af273c4e52e0ebc558cdb285a395d729",
      "translation": "其中一场，是令阿维斯族的国家阿维斯贝尔克灭亡的“阿维斯战争”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc678427c70c58d83f7d814b1722bf93e85d94c2e01277111b756536054ae8dd",
      "source_sha256": "aacc0215cc6beac8173533d7c9377544b9bc63910bcf7294eb6f27dad439ef21",
      "translation": "另一场，则是在鲁哈尔特爆发的“鲁哈尔特内战”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:506b6f1032564dc80d8f2f0f6e06b283c0b8a6fe7ea479d24e2957aee440990e",
      "source_sha256": "c40467002fe2db00f1de93eb8b70f0f4e244fed96abfa7bb591cb645082d8813",
      "translation": "一个名叫“塔斯”的人，以名为“恶魔”的怪物兵器为先锋，入侵了阿维斯贝尔克。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:784d6cbf6e71b52d714637732b76c57d917641116d0b367525f3c4718a14322b",
      "source_sha256": "44c3a9c95b9a76ee03eadb00a6978e5ef9d04fd9b63f9b7603c72c3e82d0d762",
      "translation": "数万名阿维斯族因此丧生。此后，少数幸存的阿维斯族失去了国家，沦为流浪之民。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2eb70e810c075169aed2028a08e2e05301fa831f9d509c3b56ecfdca96cdfd1f",
      "source_sha256": "b180ce91b0ed11d6f8c87aadad1469947a0e2e042840b9ec04e4864eef7b97b8",
      "translation": "关于这个塔斯，人们知道的并不多。就连他从哪里得到了恶魔这种怪物兵器，也没人清楚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0545e59350dd81a0535bfb4cadb7450bddd811ceb2f0b2a3de07448e41a97d8",
      "source_sha256": "c98530f51e2c3e7cd24fe305651977cc73b8ba81b6cdf444985eac20852b548b",
      "translation": "我也不太清楚详细历史，不过，王国军似乎曾为援助阿维斯贝尔克而参战，最后却战败了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2539695ddb161da213b5d335212d322fbe02000dd40478b86b9b19e7fd3ea128",
      "source_sha256": "c5ef96db4f48fae2c396331a4ced7f0e1132a96e3dac0921f80d288bd55088d6",
      "translation": "恶魔使兰兹海姆王国军全军覆没。"
    },
    {
      "id": "coalesced:f07d8f26808dac3e10d66c11df4bc0ec9072cfcbc65cbc8940873f2ee5199dee",
      "source_sha256": "817ad3c251d11c5ccc0c46653407e50288b33de371ca2e6a0a31b686d729a1e3",
      "translation": "然而，阿维斯族流传着这样的说法：恶魔的能力与外貌，竟与千年前的守护者十分相似。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:61536463b74475baf0529a59824aa981ef005850c37d626cb9de92fb1bb86a9b",
      "source_sha256": "6367ec94ca1ecf7ad5fcf9313bd8d8e2955deda4a9ef8322b1288230583b6387",
      "translation": "守护者？"
    },
    {
      "id": "coalesced:a1ca0d2c2723d00ab2cb064b88feedf2c73c0de32bd7061f1908d0451153b433",
      "source_sha256": "ca07f07d03513d443ecc111767ef68832c574e493a369086a67e72b30c894b57",
      "translation": "继续读，塞蕾丝汀。"
    },
    {
      "id": "coalesced:c7b55abdbecb2aef79615c046ff1190a455cd7b94f339d3e3b800be393594208",
      "source_sha256": "ee843bf9c502bd7280603cf120afc1ababf2671da1ca357f5d0ddf7b138bf8e0",
      "translation": "据说，发动战争的罪魁祸首塔斯，某一天突然销声匿迹。战争也因此突然结束。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1472eb06293a8850a98164d050563cc44a8d3af75b039efd40d221d8204a8612",
      "source_sha256": "28ca68dfe79aa4edb7770b50a0abf869b895037e21c09c46b0b82eb73e9dcd72",
      "translation": "然而，阿维斯战争结束150年后，兰兹海姆再次爆发战争。那就是鲁哈尔特内战。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:65f1638cc211767bf467b842022c9325e1f90bfab04e03df530f1aa4edc1ef86",
      "source_sha256": "055383d896af96df353bb9975df2e0d4a2f19706035dde3086f730cad86e5232",
      "translation": "这场战争，是一名企图推翻王室的人类贵族“斯拉茨”发动的，据说最终被王国军镇压。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5648c5dbb488e18b40f8514a56d33d1386d6d4ee3e36d9341ef2ac235a6b885b",
      "source_sha256": "380b139e67c532421ea9d3371e4b58ca619cb000f777508959ea598c68cc3b29",
      "translation": "然而，这场内战同样造成了数万人伤亡。发动战争的斯拉茨，也在战争结束前后下落不明。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a24d13f9c6dd603a3c2136093076a3d82e73c3cb7a3cbbdf03187e2e0bd060b1",
      "source_sha256": "b009eaa079d69759137ea3278e6d43e517a252499c5e691deb4fd804fde5e58f",
      "translation": "而且，据说斯拉茨同样使用了名为“暗影”的怪物兵器作战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ac4cc82d80c1c6a69efd7d2484e1717eda7dd036a2a1cbed926542c6ba16f630",
      "source_sha256": "5595b2a3e77d0bc2b8b5c6cbab109e060224d7921a3246fa976fb7831f96c1a2",
      "translation": "塔斯与斯拉茨，还有恶魔与暗影……真是奇妙的巧合啊？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5d5b54604b32ae162424de3ce60fc30dbdce12132cd196a5cbb85f4af02747a",
      "source_sha256": "02ef957ba2ddce6e426dfa6db808170008454be973d264e7ff5b5674b018abdf",
      "translation": "从遥远东方的异大陆渡海而来，\\n胸怀闪耀奇迹之石的异族啊。\\n“卡尔塔”啊，汝等终将因自身强大的力量，招致灭亡……"
    },
    {
      "id": "coalesced:ff0cfd2f8aba08c1e8b5a0de930e16dca386cb7b276858bac8a8a57aeb8abdcd",
      "source_sha256": "a9c4f3260cea6a340b755584a36a6d096e7b0c2389c23f51cd033127c74939d7",
      "translation": "预言化为现实，冲突的火种引燃战争的烈焰。\\n灾祸之源、大陆的支配者卡尔塔啊。\\n万族将在他们面前屈膝，乞求慈悲……"
    },
    {
      "id": "coalesced:aae4d4c086603063ef36d9a3711521a83c6f4a543204a7bc520a41f7d8d15fbe",
      "source_sha256": "955c89e5a66f8335716a9a35590a895e9d893d72d2a3455eedf35f8c5d589f89",
      "translation": "看啊，那从天而降的闪光。\\n那是英雄的诞生，救世主的降临。\\n建造天空要塞、灭绝卡尔塔之人，身怀卡尔塔血脉之人啊……"
    },
    {
      "id": "coalesced:296523e9b1a2b8e9b52943f52dace52304a5fbfe00d416a2573efb665cbe7d0e",
      "source_sha256": "715fa907e494a3c0b81e050d5c14d9f719c909057b3145e6d61b0e1e34c3283f",
      "translation": "战争终结，黑暗时代随之降临。\\n在绝望与恐惧的哀号笼罩的大地上，灾祸之种无声飘落。\\n生即痛苦，软弱的生命啊，终究无法摆脱死亡的诱惑……    "
    },
    {
      "id": "coalesced:7940d28bbf75ee01ab170e1e71af737ca342ef8fe249a47fcfaa3046bd114a96",
      "source_sha256": "05d6ffb9916145505c0cc86774200eaa63911263d2d3cc3774045e333e09b8d3",
      "translation": "光明终将驱散黑暗，为这片土地带来希望。\\n赞美吧，天空的要塞！  歌唱吧，英雄的镇魂曲！\\n为大地带来富足与繁荣的重生，那正是英雄生命的力量。\\n兰兹海姆啊，乐园啊，永存吧……"
    },
    {
      "id": "coalesced:c54891a5d6cf85a45ef5bf2f5c2294369b5e54f7c2f5a67e35038a3b125033dd",
      "source_sha256": "1aa773bc16a84d2b4de366646a1d3c3bbdf7eb585aaf1e580e08735dd7172ec4",
      "translation": "马雷族印章 "
    },
    {
      "id": "coalesced:e6743e8bf7db3ad040dc9ba802da75317c252a2ac4905de26fc0f1deb9f3a6c5",
      "source_sha256": "06ea1447a33401364bcfc9943e85216099855ecf2c3fbbcb3e7aabde4c6b511b",
      "translation": "马雷族族长持有的印章"
    }
  ]
}
