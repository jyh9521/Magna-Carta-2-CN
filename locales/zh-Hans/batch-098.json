    },
    {
      "id": "coalesced:cad9380c5464a8d55d4a9e7767837e7387bc397ed8df66c8f6d757d78b40ba75",
      "source_sha256": "dde0cc5834232a5d0966b3a069957790924ca814c663933637f501e8bc85a805",
      "translation": "攻击队长的目标"
    },
    {
      "id": "coalesced:1358619b2bd682351f9365159e86e5d7b12dbec26bdf9581e697e9bff313b573",
      "source_sha256": "36f1a30c553a84b8938f87cb4f276223e20469830e527193c31f6aac8cb7cdf6",
      "translation": "积极使用技能"
    },
    {
      "id": "coalesced:4b6a8e3e23bc8d6e0c8e5a5a74faeb8209c0a0a92cfbd6394ba2c6a0a9b85fe2",
      "source_sha256": "900551b50e365677c96bfa355ff861c401c380a7a6fd7752b3e24d5ce6a08d1f",
      "translation": "看来，很吃力啊。交给我吧。"
    },
    {
      "id": "coalesced:6beee871b7c774b1f5a6591a1091465ee88b43a06fd1f2456e4ac0c5c42b7191",
      "source_sha256": "c28f73365c958a23c731a72bccd4b03085c7282d4c80b130211c9d214e4c452d",
      "translation": "很辛苦吗？我来帮你！"
    },
    {
      "id": "coalesced:ca310ab4880c160bf8d2c151f552329222f3f1186836a884b2e7167d4dfcaef1",
      "source_sha256": "805f8e1aa872e0549bf885b5ee1043a10c4b12fe9c836d05207a68d1b6525305",
      "translation": "哼，就让本大爷，来帮你吧。"
    },
    {
      "id": "coalesced:e38040cea79583a7fa47466f8bc1481102213dec21cd8bd1646a8f2ed29503e3",
      "source_sha256": "ddc857fd79d8ea0c25257e0d9d696f0c86c2fe062430fe20a2d08c85e087eb37",
      "translation": "哦，看起来很吃力嘛，我来帮你！"
    },
    {
      "id": "coalesced:d59f359d7c3cc56b8d901c5678271bcf1d183a5d6162cfbfab1f99936f0d9080",
      "source_sha256": "422cb4d6b2ccf2fc6141e38aacd41f37e0debf1b16d4ea45d4eefb64252fdd1a",
      "translation": "没事吧？我来帮你！"
    },
    {
      "id": "coalesced:52b57bf53e4c772554b491e6ab2c56fe643bd957388ac462d4876f6412cd9e8f",
      "source_sha256": "d63f9db33a8acc4297a4f1bea64177527c85dd2bba0d8abbe24d0c13eb035a56",
      "translation": "看来，很吃力啊，就让我来帮忙吧。"
    },
    {
      "id": "coalesced:57e1877ea271dfe1eb06beb7e91f63eea051196241fa733cbbb87ae5e8e86dae",
      "source_sha256": "c28f73365c958a23c731a72bccd4b03085c7282d4c80b130211c9d214e4c452d",
      "translation": "很辛苦吗？我来帮你！"
    },
    {
      "id": "coalesced:ecc93aef532798b4cdb2ca77e80ab2c2091893f6eaf773d1ed74cb3e06038da2",
      "source_sha256": "9ef60ebaa78f56815393446f03023a8d0999de5176c0ee1c90521116dd5e60c0",
      "translation": "您还好吗？请交给我吧。"
    },
    {
      "id": "coalesced:225ecf2d46c3ca13079823ba438d211852913d0c9921aa7b0fb7ed68f5806598",
      "source_sha256": "41e2ea2a1f100a54c9b466098ee7028253362afce090675f431cc5c645430421",
      "translation": "公主殿下！我来帮您！"
    },
    {
      "id": "coalesced:2f34208bd2317393940f8e419333b8d24d7e6edfe8d92442ff3a3f57abbecaea",
      "source_sha256": "aba60cedd303fd5c692ff43768a1e96c211f1d3d41eb49b2fc8513ea8e4c89c0",
      "translation": "你也不怎么样嘛，我来帮你吧。"
    },
    {
      "id": "coalesced:7d3b56442e6052b85f33246dea7af51a535323a467ee396789615004a550b653",
      "source_sha256": "8dfc78aff19be6bd6a7eeaa07d565303228330ed481edf63b74c653325dfaf88",
      "translation": "没事吧？交给我吧。"
    },
    {
      "id": "coalesced:af9f240fd67c9c2184fa92b86b9f47d5a1ce594d707d40d7e16eea85f7a16058",
      "source_sha256": "422cb4d6b2ccf2fc6141e38aacd41f37e0debf1b16d4ea45d4eefb64252fdd1a",
      "translation": "没事吧？我来帮你！"
    },
    {
      "id": "coalesced:71f3232b49f3f2f178619c837e643b88033e3a68f84c6207551b643bbdb36ba9",
      "source_sha256": "d6b29a6266baf61de1ce9ac3f5c06e3155ff1e40bb9d8bebc04c6d6c268d285e",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/> 下一页"
    },
    {
      "id": "coalesced:5303782f74382d8406a7dd29d581b9770b039dd53fbfaac2ae1debe61519dd6a",
      "source_sha256": "f964907c207fdedbb17530104f7a1b0306e6fca9addb7e770030cac9a4acb1c3",
      "translation": "按<Styles:MC2_StyleFont_0>L<Styles:/>键，可在移动模式与战斗模式之间切换"
    },
    {
      "id": "coalesced:bd96e21d50c34054b562ea3d3e2bdc715781834a3344eb8604997df71c259042",
      "source_sha256": "fc7cc617f33cc9edca7b3de93abdb63bd7377ca9cea88320d2a69add1157835d",
      "translation": "战斗模式中，按<Styles:MC2_StyleFont_0>A<Styles:/>键，可使用普通攻击攻击对手"
    },
    {
      "id": "coalesced:d1504e85fb836c06ee1fb604efd2f65441ce0d8ad1fc03b90864cfc2df8114eb",
      "source_sha256": "83e066378d9da32e38ce8e81cf0de5715fa2895dbe5ece225db860aa9fb952d1",
      "translation": "与敌人距离较远时，攻击只会消耗耐力。靠近敌人，待目标光标变为可攻击状态后，再发动攻击，才能命中。"
    },
    {
      "id": "coalesced:1123ef54e0debcc79e7f79d188fd078844224ade4bd66b3625449886414e263f",
      "source_sha256": "f75e05aad142e836a4bc57cb45e470a88a3a653ecf31f03d003fca504e8f4b60",
      "translation": "从敌人背后攻击，可造成暴击伤害"
    },
    {
      "id": "coalesced:1605f6671c91d4becea4691528366d353a4128d1328af80a879685a01aaec430",
      "source_sha256": "5f5903728c4d65a9e306f97ca6c96bd9c10f88b92fec9083a59864ec02421e79",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/> 结束"
    },
    {
      "id": "coalesced:0b5f45740aaa4d65214ac1dc52d1e69017df77849ef498b46436fdb1f3e9c3f6",
      "source_sha256": "d9c204682838d99a2995fa560d67a93b3809907e734d5c31c168ebf27c0ffe0a",
      "translation": "战斗模式中，除移动以外的大部分行动，都会消耗耐力"
    },
    {
      "id": "coalesced:41e5d02524acee4a1b4de8b85fcfdb4028d47684c363de97a80710a5c0815b85",
      "source_sha256": "c6518b84553fca6dd97080665df6f839ba70c129d887e8240bb5d4f977eb864a",
      "translation": "行动超过耐力槽的限额时，会进入超限状态"
    },
    {
      "id": "coalesced:5afd0ccadb745f424bed1769546c569b654d5c4bfb7a65caeade944f82e00471",
      "source_sha256": "5a7083be766025980b8a3546d8ee527d22bf355486cb90460e91ff83bf5bd9f4",
      "translation": "耐力槽超过超限界限后，便可对敌人发动强力连续攻击。但攻击结束后，直到耐力恢复为止，除移动外，无法进行其他行动。"
    },
    {
      "id": "coalesced:0a0282bee4ee7c116c471cdbf48bc8d650813267433317a3d5a6d98ac57b2914",
      "source_sha256": "0229241cad715cdeef097df5ae251710ccd123e6a83fed231330277a771e778c",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/> 结束"
    },
    {
      "id": "coalesced:06124cacbdedc844afce4bc4cfde31d34992f7729367851ffe87818ce03b3406",
      "source_sha256": "d6b29a6266baf61de1ce9ac3f5c06e3155ff1e40bb9d8bebc04c6d6c268d285e",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/> 下一页"
    },
    {
      "id": "coalesced:a16965b09fedf86883ac3ba5dc54ec1a610cc3196a28df2f164ae060c928ee50",
      "source_sha256": "62418adbbbf6d0d406f885199f41657d9e926e27754434fe0de354f779153873",
      "translation": "《玛格纳卡尔塔2》中，各角色满足特定条件后，画面上会出现固有技使用标记，此时便可施展各自独特的固有技"
    },
    {
      "id": "coalesced:559e69bb83d707744b65b5a0c4f8ff0478419df031e69fd2d57a73213998ce7d",
      "source_sha256": "3b20e669adcbf017b365974a2b2cfdaebffa4c90a2feddffcbb7b59c40a7bf75",
      "translation": "按<Styles:MC2_StyleFont_0>B<Styles:/>键使用固有技。若一定时间内未按键，便会失效。使用固有技，不消耗耐力。"
    },
    {
      "id": "coalesced:d7fd922a06248bf246fb9c970b87a617abe25b2098b907f330c2b0721207ab51",
      "source_sha256": "c8a3f13bc62e4b820d2adb29a555ee120a3085abceb6845c35c2372f5bfa9c28",
      "translation": "战斗中的各种行动都会生成KAN，KAN槽会显示已积蓄的KAN量"
    },
    {
      "id": "coalesced:3dfc401a45b1a19f55b9c5a899c6cc37255b561ce51fec92913aea9aa6b36d40",
      "source_sha256": "15498cbe61e61038cb20700260d2337bd4439a5a730c6f7dbe37484029068045",
      "translation": "积蓄的KAN达到必杀技或连环术的所需量后，便可按<Styles:MC2_StyleFont_0>X<Styles:/>键使用招式"
    },
    {
      "id": "coalesced:34241c77d140305ae2bb9437cbf4875d9cf58bb46ced18aafd7a5035c71c08f3",
      "source_sha256": "d6b29a6266baf61de1ce9ac3f5c06e3155ff1e40bb9d8bebc04c6d6c268d285e",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/> 下一页"
    },
    {
      "id": "coalesced:b0035ac4f5c32928011b0207cede2fcceef326f9ffcf9b8065e1a088bc893cea",
      "source_sha256": "46027d9c2f1dd5139d5062a077b1733bcd5a0b849c98a829b29c2a242a9e1f91",
      "translation": "使用武器进行近战的角色，会使用气之KAN，可利用战斗中生成的气之KAN施展必杀技"
    },
    {
