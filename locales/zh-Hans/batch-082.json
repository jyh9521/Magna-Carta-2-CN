{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:8f8bb489352856606594ee0d46e8012d955bd76714be601ff76a759d549f2132",
      "source_sha256": "155b97545161963fb2a3812058c18511c06db7797f1e535a93685bab948449c5",
      "translation": "这些灰烬……"
    },
    {
      "id": "coalesced:467915bde558758d1eb80e7482b085cf61b79c46979a16170624744766dd5a6b",
      "source_sha256": "29e9f19731619856f36db7fe90fccb413ed7c7cc76f2937db3b5f59f58442b25",
      "translation": "嗯……应该就是爸爸了。"
    },
    {
      "id": "coalesced:04f99faba95e45b3ac5de6e34fd86a1c421e2446e0e06285ca203216af9950fc",
      "source_sha256": "5deb768dc7de88fb72f60d4a4f4947ab2ecdbd81ad96330a71ada5c2d5303ca1",
      "translation": "爸爸，我来了。我已经长这么大了。你还认得出我吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a79e8b30276ffb93b1311e66d7b5bea07ba4a07898c3bd487ce80882a1347d0a",
      "source_sha256": "7af515874f0d37bf3c89e8c8208a6ecbefd35c8d4d7679f1a5f15e356020f443",
      "translation": "本来想在爸爸变成这样之前，见上一面的……"
    },
    {
      "id": "coalesced:67559cae32beabbc6df930feb64ea30983116265b695dc7a6e2608e53a70ace3",
      "source_sha256": "26ffe1f280eb56b67692188b4f0c3096838598a7cabaf1c0b1c830b07a20bbad",
      "translation": "风……"
    },
    {
      "id": "coalesced:80509d3d5ce8c60ed7e31e25435e920951e7ea7e8171d62097f2b21fae331a2d",
      "source_sha256": "3fcdc0dfa9b4120d11d3e2e95187f5582a1772f76e3dbda39569ff4582c5017f",
      "translation": "看那边。"
    },
    {
      "id": "coalesced:9691edb232d85c31141cadf3044a0111f19005ccf5c8229a8c54734223f77a1d",
      "source_sha256": "19d3c19c9c6435f48892c793737972dd77b098a20c728de086443c5feec26773",
      "translation": "塞蕾丝汀……"
    },
    {
      "id": "coalesced:96ace4e50473eb4180c4fe39d0b8b723e4eebf772ac4e49af675f33402b16c7d",
      "source_sha256": "125fa060efec0d7409b95b9e1dd1a157cb62d0eb3896a2df5515220339494d8b",
      "translation": "爸、爸爸！？"
    },
    {
      "id": "coalesced:679de2f98d5414583a97c65f9a068328ab1176bc84c12c90014e6542225210be",
      "source_sha256": "672817bbd9e45acdf1b7c5583e8dc85daad592bf9aff63b1cb9fb6e2ca1439eb",
      "translation": "我的女儿，你已经出落得这么好了。"
    },
    {
      "id": "coalesced:8e4f91046f1c0153c0ee70eb0d5a0b03a97fa4276145fde8829df814df86e863",
      "source_sha256": "24785fd45c2c08110ee2509d502bacdbd862a23528fffec39d502eaeff1f7f96",
      "translation": "没想到，会以这副模样与你相见。对不起……一直没能去看你。这件事，总让我放心不下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ae71314c52e166c228016ae5ba55b03e0d93dff5490fa14a1f59bbacb83ad424",
      "source_sha256": "601d8c694d353fe09569823cb70be21f11491cd4d53d65a646a6055b8ff21fa0",
      "translation": "不是的，爸爸……你也过得很辛苦啊。我好想你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ced64c9f1aa6bd96529480b60c7816d589774e5cbf87f7db97642ebddf4db05",
      "source_sha256": "13e9743f7f9cc6ef8dcf9734e0525447c93c8a4aa49f4d3736379f95d33a9f8e",
      "translation": "族长把你抚养得很好啊。替我向他道声谢吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9872ca81ce35d7c1e129fce6f5802d5adc518372669b3cf20384e02eb045d1dd",
      "source_sha256": "c287bf86897d5f840539e0484563adf099074f547b1bd4abab85a8baf49e4583",
      "translation": "嗯，我一定会转告的。"
    },
    {
      "id": "coalesced:b7da964506066708ddf5714fe4dba73d5c41fa679f1beeda67d04f6740418069",
      "source_sha256": "b4826c50c2d9949bb51e84b1aa2628b3c9756e6e2935044ba33bb00d5907a216",
      "translation": "虽然有很多话想说，可留给我的时间，已经不多了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:520f118ac02df815fbe7cba6f14cb02006e79ec731728c0bb22ee55cbe1ec76d",
      "source_sha256": "faf4f688a703f50b9f62d6cd4411e877718e9f8ad8d9fa7da4fd949d7d05991c",
      "translation": "不过，哪怕是这样，能够见到你，我也已经很高兴了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a119ece1216cf5d4b809ad51cc2db92889008feeef92894ef4aa3b48483f75e",
      "source_sha256": "3ed0475f22bbc1478d23d55e47883cfbd76cefded197e49383480d3e7c271068",
      "translation": "爸爸……别走。"
    },
    {
      "id": "coalesced:1129a5e4009b48918b67ff26c8d8b18f9ae73d33db3069ee77619d131a82faec",
      "source_sha256": "6cfbfe84fda216e5bb7156836c9e9a69a8cc8af621cf5bc787eeb1b47a4bf0a0",
      "translation": "拿着……这个吧。带着它，去见族长吧……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d335ff65dd1c47028675a71c6f46102ca0d5fa26fb1839f33d93e5c79a8e9081",
      "source_sha256": "565362b1a5eeaa749cdee6fda730fd55d1a8c70c666593fb3965c01832b7b009",
      "translation": "爸爸……"
    },
    {
      "id": "coalesced:93392c8c2ddfa6faa416ce1a98a8037178700466511c01e01c50ce0c82a68d02",
      "source_sha256": "a4d00009c4f3484bcd1241fbd16d87ece5002fb1203b0ccafa84afecea41c6c3",
      "translation": "塞蕾丝汀……你一定要幸福。"
    },
    {
      "id": "coalesced:dc7752439d5fb40676c2ca0fa84cef750976a6d8885c453d5edeb21dc07dbbf1",
      "source_sha256": "43190f2d3cef613eed7e055f6dfdf5b1f33da8e11b450ff7b196d923c6ab8789",
      "translation": "这样啊……拜泽恩他……"
    },
    {
      "id": "coalesced:06c6241e2ed4d7837a7a96e6a479bd41c7fda30c0aa93eb6b40edbbde2452d53",
      "source_sha256": "f5236cc16fd244791d31f29126c15d0bf6849971cf7bd8e4aa6877262840b0a6",
      "translation": "辛苦你了，塞蕾丝汀。早知道会这样，还不如什么都不告诉你……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78a17cb6d1faca189953d2a52836cf2c8d50092ca036618a5348f9b60ea7e744",
      "source_sha256": "def576a2a65afca72db6f9c710629975dfe36cbbfe7ef6c3c63e90464234248a",
      "translation": "你带来的，是你母亲[塞莉汀]用过的武器的原形。原来，一直由拜泽恩保管着。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d310f54db7a55ac46cbbf3f1fae695937d3267e553ec18cda48dc46b9722d5a5",
      "source_sha256": "53cb270cc70bb9c1e40f8c652fc44dce1ccad8835a6688113c894b40b4bcc80b",
      "translation": "看来，拜泽恩也希望，你能继承塞莉汀的遗物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aee0279e5de43669944496be1475507a61378a180c0300368eefa65e24b5611b",
      "source_sha256": "c3497ac12209b707702f2c577a808294974d72655de1f0375827d98ff6a07b78",
      "translation": "我来修整一下，把它打磨成武器吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f010461272f72436948eff9c570ba1fcd6a5582bee91af48e3bfeaa64870bd37",
      "source_sha256": "8a3f3fce601ac4659695555a85f9226cf0c34397168122e3b7c5eec70005b36a",
      "translation": "将[拜泽恩的遗物]交给凯汀"
    },
    {
      "id": "coalesced:a9f59efc262445a847ab9302a31acfc7952f14d8d99a35c3c11005c6ab76ba65",
      "source_sha256": "0dd11ed5fd54bbf8c418f033320bda6d9096112b9fd419974e083dc4b8dd8bfd",
      "translation": "父亲的遗物"
    }
  ]
}
