{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:a90e0855b488bf76a28a55d25c6e58c969cd7b338ec71795dba7df31f626e4bc",
      "source_sha256": "cc8803f847f16193606268fda00f44228ccb0379583e937530a6566ff390a15c",
      "translation": "请帮帮忙吧。"
    },
    {
      "id": "coalesced:56d50e305ca5bcc667802da54895079dfd2ff8ae13a99b0d1701e007a997ff5d",
      "source_sha256": "7500f0e999a5a7629f363940c5723fb7439591411f48d9d90a1806c6a5202f0a",
      "translation": "受北部军折磨而饱受痛苦的人，实在太多了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f55021c3b2095166bef3af1f5569fe5f2a9b900983a84aac9f17d65dd32b3541",
      "source_sha256": "1aa8f9ab2c91402008c85279e58dee4f7f97a96c39496b703ca3f50a392e0543",
      "translation": "可这里既没有治疗药物，也没有工具。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a2857819088094e12f182cb74e3d123e8a58739ac2ecd7ad15537a884e4b410a",
      "source_sha256": "28aa7ad3fa391d32ad88886d7a1898939302e82b9ce442d8c6a97128894007ab",
      "translation": "唯一能当药用的，就只有青灵森林里的利安达尔果实。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40d5d75de7a189ab7124dc6cb692aaac7bf4ea66aba2296df7effda880442e67",
      "source_sha256": "17b1569a276ff5127c50590eb7c741672ca75dec51f0e811e5f5e6789b94d64c",
      "translation": "而且，不是谁都能采的。必须熟悉这种植物才行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:adb5473156a8c74e27d8868118599cadae7cba18d76250a39ecfdec296d7eda6",
      "source_sha256": "cdc8136ef878cf764fcb5ef0253f3945a5a7337c056d95de65d949c6ebd46b3c",
      "translation": "以前交给朱特去采，结果弄得没法用了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:24d929f77ae5c1920d07eb367c0f297f444a7b2639e32e5e71bc84d7d9e34377",
      "source_sha256": "d4648488d17ffc450bc3ee68a52dda3c3fa0e9b3091746d9403d31fa63da4767",
      "translation": "所以，我得亲自去采。能帮帮我吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d681a4abfaa66b3e9171a605408da11c06a1ce21efba19f5a541106301b092d",
      "source_sha256": "8e3542ea24dfa90f7c04ee1a59d125f63d4e00f1dd950c61330c78716b937700",
      "translation": "谢谢。我先到森林入口等你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd77ccd389051261c72d6a9d53ccee577f89d0328f64acd3a930e1242fc7d3f1",
      "source_sha256": "18581c74843cd39aad2c29d0e22bbbdb838b732dfad32e64f05981331a0bf1f5",
      "translation": "准备好后，就过来吧。"
    },
    {
      "id": "coalesced:ddabfe6c9f3629b781884d83e048bc4386fb0527d1f0f7dbbed3918448a55d3d",
      "source_sha256": "22da63953d5b92710a9ba965c31484ae69c7859d59e790e327456278f26ace00",
      "translation": "怎么会这样……村民们今后该怎么办……"
    },
    {
      "id": "coalesced:a1af550e7073079975a635825e61f1c368afb1ed494dc46d28b0048359deb0d4",
      "source_sha256": "4b955a5aa920185797ee7a4e253fceee01ccc88bd3adaeec9ba8ca64b58a9ee4",
      "translation": "那就出发吧。准备好了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c757dc9359dc572c95de525b06903e22807fde92b806c4b6cfd4c28b7042eef",
      "source_sha256": "8ee63e182fab47627653931bca2d369e6797be81a4becc83ea8e41f8bcb4f8e6",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 出发吧\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 还没准备好"
    },
    {
      "id": "coalesced:d737d19d612243712e795949230ace08ed693e8e7244be1cf827e78c555fe59b",
      "source_sha256": "62fcc3f1bd5998ab108e10278c6bce5894c131a429757a27506b398959d4bcce",
      "translation": "就是这种植物。稍等一下……"
    },
    {
      "id": "coalesced:2efceb7df75c83ee9c116c091eb7f5b70f7f9988e4532878059b1ff2ca07ab54",
      "source_sha256": "d7d8291b19027a7ba20143d3f20c60f0f719b4ba6664fa6c9161ff32bf3271d8",
      "translation": "别弄伤叶子……小心，小心……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e179de25cb4671c179252c39d7e7b8a6a3473586264bcb3b5b42d298cb9d48e6",
      "source_sha256": "34baa07d1db2a7c649513a3285001016e56b8756f92a0340ae9cf22b2c55cbfe",
      "translation": "好，采好了。"
    },
    {
      "id": "coalesced:7ac64872ae6d1c2f7466e320f7b9ca6b3aeec5347680b6c04e9857db80cb6f1f",
      "source_sha256": "1efb13c3d9b9cc278a633c1f6ee743c24f8ce9674d523f6164956859b5279520",
      "translation": "好了，现在就只剩下回去了。"
    },
    {
      "id": "coalesced:0c0d06043823cb176d9f25df9c2b8b0d35914d13f13d45bcfde5324abc3c33bf",
      "source_sha256": "f60e28101327a3217d161a2ec6aa96915e161458cf7443a685e7236ca60a5ca1",
      "translation": "到了这里，我就能自己回去了。村庄见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2953963b3e17fe245afb1b344ab731c328feeae6d524393f7d8ea7a672f10b2",
      "source_sha256": "ba857d9a8c1be8783b088c8c6e686d3ff37ae1f39ad06dcd5832557a9b50b884",
      "translation": "谢谢。多亏了你们，我才能制作用来治疗村民的药。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7a05b51b8ba08bf2f8f1c8b1bd7f87b9f49969a83f4610bd2c98026cf3cd4c5",
      "source_sha256": "34175faaae82d077274c9d6f40fb9b0435da2d2c4245b689bddab1bf254964ca",
      "translation": "虽然光靠这些还远远不够，但多少也能帮上忙吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aaaebeccc87efebc6365f922fcd0afdc08f07ef445a628d5cee104af18295bd8",
      "source_sha256": "d1de7c7601979a700a2155e4d041bd280b91eb3b8729d443da0a1209798dfd9b",
      "translation": "真是太感谢了。"
    },
    {
      "id": "coalesced:8376897c4d5e75be42eac17366a0da33efcf5e5bc91b91c21bc76403faa22434",
      "source_sha256": "d66d7521a887f4e68447e9bc906a0fbdfb03de730e5df64b753dffc4590eb734",
      "translation": "必须保护风息岛的护士，让她采集利安达尔果实后\\n安全返回村庄"
    },
    {
      "id": "coalesced:8e7f8022870b9eb847b2754bf5293c5d0c6608047b818313c9259a0c774d198d",
      "source_sha256": "77110c0a978a9da91a2918dabd921e0b499ccdf7ac6f1471d3a768080b14d09f",
      "translation": "利安达尔 2"
    },
    {
      "id": "coalesced:acf56239b8b61cea6275ee3519d41c47ca3cf26fcbc92a65532888536ffab50a",
      "source_sha256": "6f1a8364793fd1c2375e6d66314de9ee27fd5370a21596b081120c8346e9286c",
      "translation": "那么，就拜托你们了。"
    },
    {
      "id": "coalesced:5e9f5432a6e982c7f97ec51bd5190324ec8809c8f314abd92f73be95e70887cd",
      "source_sha256": "91d15a26a0fed80fa8a64e29249fe36226bd1577ad1a58fb04b406e39a8e94bf",
      "translation": "请稍微抓紧一点。"
    },
    {
      "id": "coalesced:558ea06559937a934ec1c77934db21f43c99d7896fb8060874960ace7b1cb41a",
      "source_sha256": "15d69191625f3b10c08ba98b752874f89ad2e4347a786b0630cb59cd944a8118",
      "translation": "Quest: 护送完成"
    },
    {
      "id": "coalesced:c14b8a02fdac0f240e2b489cf100ccb9652731b518a980b3913674173460a6c0",
      "source_sha256": "d489b02eed7e556e6e982f8983cef3767cffca532a0caf76617a484eb2978c25",
      "translation": "村庄里的北部军虽已全被击退，但还有很多家伙逃进了森林或海岸。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20d715e03cbc02db0fff05274b6d85aaa645f6d0a87760a9ddc0a412a0416564",
      "source_sha256": "94211fe6adb9fa733b45d752cdee4258f30b722e90d8ee506908e1e589a3ee03",
      "translation": "要是放任不管，不知他们什么时候又会来侵略岛屿。这样根本算不上解放了岛屿。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01ee93775ce1af498ceef2fd44ba488c65ac85f49056e0b73157aaf1e54202f5",
      "source_sha256": "79b9264b6a7d9c0a93d303fc421f798c48f3ba3937be49ca70fd7824a158a16e",
      "translation": "必须趁这个机会，把他们彻底赶出岛屿，或者消灭掉。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:29af9ad0c3c2d2d49dfcccf943cf0becfe38178f1d8a0de6c8274c974afae887",
      "source_sha256": "e0782092af77ef1d6198def9da0a56210f2727f8ebb0b686d2c08800cb2b7b7a",
      "translation": "能帮忙吗？"
    },
    {
      "id": "coalesced:b3d434250e15f6addd9d47370854d909311b0a278291af3042e116f1542daf5f",
      "source_sha256": "ae0d4243d3ac539353902b175db4846d478d660acecde3fe9d00ea320e94a82f",
      "translation": "谢谢。放着北部军那帮家伙不管，连睡觉都难以安心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3661900671da4dee23de902e21f6036f71d7ecb38d09d9b294f03c70e10d2094",
      "source_sha256": "e450e0ba82f673d6e7f9d5d099e727629410504617eede0111bcfd4a642433df",
      "translation": "海岸和森林那边，南部军与守备队正在追击。"
    },
    {
      "id": "coalesced:af3085a9dd2ce5114193272ed015bff96cfd4443e2917305518ea762b30a01f2",
      "source_sha256": "7f633ba046e6f8821c95a73c6009469505187bf63f0bdb36557df36a4a26803e",
      "translation": "逃进洞窟的北部军，就交给你们了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:133118c5d79564df68863318e51bc7184a8c0f081a99c727efe0fc2741ccc055",
      "source_sha256": "b90faae4828c07323f7e5495931979f05a7a2f1c871987b27f035bd319274452",
      "translation": "错过这次机会，我们可能又会遭到攻击！这点你还不明白吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a0fa70531918c98948367d4cd1d0197ec3bd4adaffd0f90e00cb869ca7db815",
      "source_sha256": "8d50dde34d365b5da2265475fe534cdae181ef9a952fbf2278454cf9571f3f44",
      "translation": "这是千载难逢的机会。必须趁此机会，把北部军那帮家伙一网打尽。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fac475996c7e49b020aade421f8881ff80c5f27626061b672981b10597933e78",
      "source_sha256": "b740fca42f4dde7b529366ae4c1216bc5baeca92136137533c21bae8d4a7fd63",
      "translation": "这下，总算能安心休息了。"
    },
    {
      "id": "coalesced:d7125113d362db0623d1aad889d62ebc64f65806e2a0e27bbb4f71b8bcf65465",
      "source_sha256": "a408b4782490c47d9f3d4cb5ee426bef145b9dfcbe41a2438f17939df466635e",
      "translation": "看到朱特成长为这么出色的战士，我也很高兴。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e9e483fb342228f993da8df2c643e0e0b9c524c4d23a0b429ea94b9485b22237",
      "source_sha256": "b891d8a84dc3669aa948c68e9974b32b5208e3bf6c4e0fa0afbf1d362dc258df",
      "translation": "真是谢谢你了。 "
    },
    {
      "id": "coalesced:9de6d558c5d74ea3a22de30a21a1fc4337311b162c0abf5edf8f28c64ca2ab0b",
      "source_sha256": "a862302d96b54f2967cac8776876c2e8e015184d30792b1c4e19acd91bf80a06",
      "translation": "逃走的北部军"
    },
    {
      "id": "coalesced:fe7d47aec3ffaaf0852ba00e848fa3d0e547383d816cec14d0ba9088506beffb",
      "source_sha256": "f710db751629e4d9f36e50ae26c44e89dc040f26a65c2af3bece1ba081540965",
      "translation": "必须击败逃进风歌洞窟的\\n8名北部军"
    },
    {
      "id": "coalesced:9c65acab52d9f00c086bd4159ff08649bdfc4a207b80c82daff23dca308bdae7",
      "source_sha256": "983e9cc36d2ea3906b6c856b5eb6a79c7f464c6e2472ab27c3b2441743595147",
      "translation": "QUEST%s: 击败北部军 (%s / %s)"
    },
    {
      "id": "coalesced:ecd9220b1b48ce957077cf8156aa6693c1dca57b2812d96ed8ad372b06dfd84d",
      "source_sha256": "24ff16add4b2f48dbb424b664e91ea10462323c5d118e6669502647f57d6fcde",
      "translation": "击败北部军"
    },
    {
      "id": "coalesced:f3cff504a0e40dc3bcf4fe629bf7748981d022d2ccff62c7fef33461e4357375",
      "source_sha256": "8634ed3b54e8b82ca765c7ef88b42bae905087dd9fcd16d982e3aa4a33fdd0a9",
      "translation": "南部军的各位来了，看来很快就能夺回岛屿了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0cf545c31760ac29837a278acc95389adf15dfc532730e90314c198db95afa3",
      "source_sha256": "403903378f665b1ac22551795b7149ce821a4b99304a872523282bd4dde6d1a7",
      "translation": "不过，还有一个问题，就是守卫海岸的死亡弩炮……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74aab597a5a676df71d73d364af7673ba535ece5dd9c4c6abf6f13d876c396e8",
      "source_sha256": "1344fed908e15f93ba165aaf96d58679ef53e90eb0008a101b7707b3e8aeab42",
      "translation": "只要进入射程，攻击马上就会飞过来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f310c330d2db2400f98acbe9fcfa7650f77ebc21825f0f00af44a966c67c954b",
      "source_sha256": "9a22fb96ef79fc8415bcd5a2f2449239e6782de8d8a192f9f88060710300bc21",
      "translation": "不解决这件攻城兵器，恐怕就无法进入村庄。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0e4b17e066f10d002e4ecaf06fff2ea5da0ea3c7dbe88b07cacb72e83847574",
      "source_sha256": "294f758b2cef432c8e44f108bd70de1740bbfbb51c1a148401317024bbfa452b",
      "translation": "必须先处理掉那台死亡弩炮。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:162dc90e400a8b6eb6ec3b3286311591e90e58b686d7dcebe302e4e30d0975fd",
      "source_sha256": "c79a828bc91aec6f41a76211cd64b03e474a3fe31938d1befec032c372774241",
      "translation": "我也会帮忙。"
    },
    {
      "id": "coalesced:68ce572beb4eeb329439a730e2550f4099653ea59993fd5d6f3425bd642601a7",
      "source_sha256": "1da472e6df761d3de40fc8899964585e6a91678a7c57f75dbbcf449d020d8d19",
      "translation": "您没听见我说的话吗？"
    },
    {
      "id": "coalesced:b7192fd420c1455fbdc7cd26015b1ef446ac84ee0e41ea1d54772a13a9789fc2",
      "source_sha256": "f9120fae851367ebb55942fa893b1bfed3f1e3cefbda66f910f8cb6a2a283f67",
      "translation": "不摧毁死亡弩炮，就去不了村庄！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78edcdcaf4db5e32efef81d6805f770f4a7d47c24eec91f0829a82d9b6c0fec8",
      "source_sha256": "6c5e9f61b1688931673c5a49f7737f465b2e75e2fa63edbe37055d972babfed6",
      "translation": "必须摧毁死亡弩炮。我也会帮忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b642996f76d63658a9c12ad00d6defc4e26a85caef706e5f499756d8c3633696",
      "source_sha256": "5bac55ad0b43122078161d0bc6b0025f0133bc9cf766bcd1398a24da2203ee57",
      "translation": "多亏了南部军的各位，我们才能夺回村庄。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:708181dcec8384f588cd1e6e7c314d1241c87b75fdd8a375133afca26ded3066",
      "source_sha256": "2dea1aa52b456fd13213138a3432bb13c5ba5dccfab60a39e2b9f1c50f45ca39",
      "translation": "真不知道该如何表达这份感谢……"
    },
    {
      "id": "coalesced:bf61bfc8f4511fea43b8279a7c4ef7ae4924748427ed65a75a771ea629f57a6c",
      "source_sha256": "7f025b7e495cee313ca27652838f57dac23cce02b2e5df904c321e61b4304ffd",
      "translation": "这是我的一点心意。请收下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fd96a5674f8ad5e234e9823d16ccfb74d17fc09848f211e3a10e05f8f6b2a22",
      "source_sha256": "7c8eadf45c68f0016ecc8a936396ee25c1ba0de55e936850bcb5a5648d304d9d",
      "translation": "协助者(海岸)"
    },
    {
      "id": "coalesced:71f9e54cfca0f615acad66cb65c6c7e2294c3c2d92d0770deb78503c4ac7113b",
      "source_sha256": "1901356f5b655ca3693ef835a9fc904058b9bf7e15d3f85c04f6a0ae4baf8408",
      "translation": "必须摧毁海岸上北部军的死亡弩炮。\\n强化版死亡弩炮受到屏障保护，\\n要攻击它，必须先破坏屏障。  "
    },
    {
      "id": "coalesced:e8ebbb01877e84a4fdb7a53c1423a1d9872bb8b595a6c499b76e7147f508cbfc",
      "source_sha256": "0ba31a0963be2de36548d86ce3455c370108b63b747b93eace0999a324a81191",
      "translation": "QUEST%s : 摧毁死亡弩炮 (%s / %s)"
    },
    {
      "id": "coalesced:1be7914b51def1cdd62c8d6da2d6eda57262b3086660bf13828d801eca452025",
      "source_sha256": "a71732fa35c157815bc79c191b6bedbd02595d637cb588c6f38d388c52e39e58",
      "translation": "摧毁死亡弩炮"
    },
    {
      "id": "coalesced:f5c266fa3afddf11a48bf09ed12edac475fea6ca8a19fc814b7e298c996188a1",
      "source_sha256": "e199a244e751edf6ddf7dba86eea561fa9fd3577f07bf53569f4d42b1e899976",
      "translation": "南部军能来帮忙，真是太好了。那么，现在就去解放岛屿吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c156d9ff0d5d896d8fe3021788866eb8c170c0383a14b118cf27eb399022969f",
      "source_sha256": "d859f152765dc5a2f472917c22c40d32033e525884343ac6e0304c26d55a0328",
      "translation": "率领北部军的，是一个名叫[杰巴萨]、模样恶心的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a0f63207be8d2f48f7e7bfe4944f2ba7bed7fd1e3abce1ad3bcdf2e026e62e9",
      "source_sha256": "4571dc0e8f237f1ed0b0f547f1c20005ab51621012f6add363f942c9b40e7098",
      "translation": "只有上半身的躯体上，长着虫子一样的脚，光是看着就让人毛骨悚然。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:225632b4cf090a9ef66bae3ee625b98b8aa66ced799ec48eabd043aee268864d",
      "source_sha256": "78d3836dbea48aa608d4b7639066681583fe8df3d03cfd14fcd64986d6864792",
      "translation": "而且，那双巨手的破坏力十分惊人。不知已有多少人因此丧命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b13b4e40d523592e7189d70dca4bb24d2f835281224ade62b4f221ef3bbd1dcb",
      "source_sha256": "7ac505fa06e6ef98eb81f26c4a026a2dece9ecc457228085100fe3d51c541644",
      "translation": "有时，它的手上会燃起火焰，那时候尤其要小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:785e556387bf77695e9c544cd457bbba8eb2413d2ec5b144abdcb6c41003c001",
      "source_sha256": "17d8c1689f6638c318cb6ac4423c0aba1033fc16362aede3f0e1929f85ccdb15",
      "translation": "不打倒那家伙，就连村庄都进不去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6f8c83a28434e603f0cf6b2a818a436164a8cdc02cf4958492e824bf9602b40",
      "source_sha256": "b41e450066fe0915228ad4583bd0ba094a778f3d6bcb745c3bd7ad3adc4da88d",
      "translation": "好！那就去打倒杰巴萨吧！那家伙现在正在青灵森林附近巡逻。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a6cfe23a1d95f00da46d5c2f7a95965b3f6ea380567240a2266f357f42eb574",
      "source_sha256": "18977f5c885ab13b03448f80021dcd6795b57489ce8134f9dae44351a46f92ad",
      "translation": "不断击败北部军那帮家伙，它就会出现。"
    },
    {
      "id": "coalesced:336d75717152f85cb155b489aec71fe7f9165b4beb1f420b5f8417d361126268",
      "source_sha256": "e39e572fc06e26d2dc12b1d89e1cff1276b77be6b166d1935c7615c8fc2b6c3a",
      "translation": "不打倒杰巴萨，你打算怎么办？"
    },
    {
      "id": "coalesced:b241b4d59d27d3a3d4216bf85f786d446d22422d7b46a44a180cac28fc3efc44",
      "source_sha256": "80ac933734b00a287002ec3dc446f5094ce18a55e88ce403cd98dedbba7403fa",
      "translation": "不断击败北部军那帮家伙，杰巴萨就会出现。"
    },
    {
      "id": "coalesced:506b6aa368503413a2bc82e85aeb09ed5b1f2e787f4b7f2a9a69cb3a0d01ad1c",
      "source_sha256": "9be7eac723af758fd76d7233b48807bfa0750c4fdebb3809c8cd8b203fda6195",
      "translation": "多亏了你们，我们才能打倒杰巴萨，夺回岛屿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:95656d647f863c18715db724bf8152bcae3215832dec46725b954159fefb8bc3",
      "source_sha256": "a4390384cccb05fbb8edb210c0d5663ea32de9ea2ed374425e105b922488ed4a",
      "translation": "谢谢你，朱特。也谢谢南部军的各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:65f5727404bbf0afdfd7b9970c858b1e59dbc1171816bf0e6ccded4838e29966",
      "source_sha256": "5b24acc58db267122d22466a8b611b5ebdef103744f62988ebe3a939cbdd3564",
      "translation": "虽然不是什么贵重的东西，但这是我的一点心意。收下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58ad58aeef3690b965e7e1f0f7d73beadc15f1dc51fff29cdb75ee2df88d7e11",
      "source_sha256": "764e281379fc1926056da0ee1c2f9fd1c249f1d262adfc1c090145d9b5cb0b40",
      "translation": "协助者(森林)"
    },
    {
      "id": "coalesced:4faf1aaf2860b76f7ed483c621f90611703068926b5632362d0ceed54b50f626",
      "source_sha256": "9e5b647da32b5a6dd52cb849f572ce4957d46b71b4991a24e1bc953de347fd48",
      "translation": "必须击败北部军的怪物[杰巴萨]。\\n击败散布在青灵森林里的北部军\\n15名以上，杰巴萨就会出现。 "
    },
    {
      "id": "coalesced:d9f7b92a4a8a87057940efa456dd5df0d771446cb38547f6f01a8a30b5f415db",
      "source_sha256": "0a7f8973708f6497b3bfefc069dd452a34900378b044263cfdbf045828eadc82",
      "translation": "QUEST%s: 击败杰巴萨"
    },
    {
      "id": "coalesced:4625d8114843d3ee54d01a9e326f9162f63416b53994ee57d4836312a699a63f",
      "source_sha256": "4fab9f8b6fcaf1a12ea37ed11cc121e0e14b6f3e54f6f48928ca491a2a64fbfb",
      "translation": "击败杰巴萨"
    },
    {
      "id": "coalesced:0f1deaa17b20eb0b0cadb8cc4793e2caf0c34e17e35dfae5ba6a414d2e0624ac",
      "source_sha256": "83201bcf6221ae216ff271e9f81e60d0ef86e0ae21221f8ade7c081585a1d09b",
      "translation": "现在可出大事了。阿巴泽特城外的阿巴泽特草原上，出现了一只巨大的怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:228398fa16ffc4f50d22b58735a3cf3d983ce9c5bee4cb19807cfda399374233",
      "source_sha256": "921434659cb46758276a3f672fb508f8c2ecf896762bd9b579a6849b77a4f573",
      "translation": "可问题是，这只怪物怎么都杀不死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:142dd58ca8fd93e9f6399ead25f37ac92f94f875195907339aabd2b403c7d969",
      "source_sha256": "b50d32dac61ba1def1503fe5699ecfed0845e48f3072b830615229e489b969c5",
      "translation": "无论刺、砍，还是打，都没用。"
    },
    {
      "id": "coalesced:42d57ec535c5d8e80c9a98f05e073b961c7078d2c6c46c2a91753d6a23f17394",
      "source_sha256": "5beee8049810a2b5b4abf1d8cded28eb04742c3249012d9f07bff05f473461f3",
      "translation": "已经有好几名猎人闻讯赶去，可惜，似乎都遇难了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de6dce39675a7c1bbe470e47e5577d7c233df714bf5e510570b65ffb7a726b0d",
      "source_sha256": "cfcc1bd060157851932925110718d916758ccb190c20278d5160ed2b2650b959",
      "translation": "不过，反哨兵部队的话，也许能想出办法吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa28d5f38c388b8fc62ecf2782976ab41d822bd10251f94fb62d8372d829f888",
      "source_sha256": "5a6d230e3b18b99730f0ea4c78203a939f319e8713436754343072e8db4ea612",
      "translation": "每次都麻烦你们，真不好意思。听说怪物就在阿巴泽特草原。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ebc5499f2312cd4e55b5829b061c250a9848a878dc1a9d223dc2e50286847bc6",
      "source_sha256": "36e0f80d24c77cca405982c3fda0638dfe837e54296da2d73f078d003661dfbd",
      "translation": "也是，这事确实不容易。"
    },
    {
      "id": "coalesced:0de95767c3c54d94441e537568cd365818a4ac51d5521ba277c2fbd857f975a9",
      "source_sha256": "efab730467510f1887043791ad1b6923a1dfef664003db786f0531eb9d7e73e9",
      "translation": "杀不死的怪物，恐怕谁也对付不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab97068feb470de92749bebb214c11365dcc64deb701a3d4a30d8069b77ac2e7",
      "source_sha256": "6542d6df5d05bbee644b7068eabc2c439f368f558dfaf81f92c730a7d2f68a1f",
      "translation": "听说怪物就在阿巴泽特草原。"
    },
    {
      "id": "coalesced:48a3aa773e2efd20c701e0fc01972905d92cc2fb8aa28072446479a3b20e5430",
      "source_sha256": "1fabb74b651935ab1ea0e68b1e8be2b2d07225c26d0c4fe0797d0711921b6439",
      "translation": "天啊……你们竟然打倒了那只杀不死的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d6877d6b74ad86a80aee99ccc86df98e621023a25513ee846daa44933b167a4c",
      "source_sha256": "3e8468418f405266c880e1b887636614ade082514e93ebfd79fc45b6c9a322fc",
      "translation": "到底是怎么做到的？难道“杀不死的怪物”并不是真的？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f4190a108d023fd276b55b826ba4cef95bbbc077f507bc1d936c3d08ec89b4b",
      "source_sha256": "9fadf37c8be6fb816cd37126002746535725c3c947d1c981f868e11272b5d192",
      "translation": "总之，辛苦了。之前一直担心它杀不死，这下总算能安心些了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8de8fce38844e795707ee2fa2559454d8cc989cac61692a2a271042d0456d07",
      "source_sha256": "0b218069741891d057efe9218b707c75be2a97aa933584e94b419eb038c7fb40",
      "translation": "Quest: 击败不死怪物"
    },
    {
      "id": "coalesced:d99385d86a38a755fc44e15195883cd7528955ffe2c7a6c2fc96b1a96686650f",
      "source_sha256": "bf7d3a0b5187141b40a851e3fe8128de53ecb932418c397a10b7f9985f11eb1f",
      "translation": "必须击败出没于阿巴泽特城外阿巴泽特草原的不死怪物。让露来对付，也许会有办法？"
    },
    {
      "id": "coalesced:27545496e21293a1c3baadaba7df217a12fd7f4f029e4ccdc890e020bae4e86b",
      "source_sha256": "ef425e210e04d04d08be39c66a2d8977db507b5819105c2f8f462200429b2253",
      "translation": "不死怪物"
    },
    {
      "id": "coalesced:6c9669cfba718e1685a6752c3e239bcbb8be18255e6dd94ca5f0cfc0ec7d4ef9",
      "source_sha256": "43e580722c5102a55e96d673729530abd4487197bc0d0417c5d6e14cd290247d",
      "translation": "啊，我正找各位呢，来得正好。"
    },
    {
      "id": "coalesced:b130f120a70d397a17a2546c6788d0260c9196612a5055199878775f6d9349f8",
      "source_sha256": "f4e4a93edd8900cba3c9caa9c6a6ac3ad59d08004444a30b8e926f1fb65b8e95",
      "translation": "听说有个人从风息岛逃到了阿巴泽特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce145dbbfcd530baa515a89ddf4f952bbd0d1dea9e959ddb8aad68ad1346551f",
      "source_sha256": "382dc8e17e3b6a83626448aa9612c8da8197c58f4fb312681ce588a786b26c28",
      "translation": "反哨兵部队曾去过风息岛，我想，各位或许认识他。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01bcbd2c3f71cc759b6f9e7e1702b51f704f5c77ac0220227785383cbffc0198",
      "source_sha256": "988a9098f95f812846836d6e2a4694d14759148ae6f536ee81bb2ed19897acc0",
      "translation": "不妨去见一面，如何？"
    },
    {
      "id": "coalesced:e6a8ea74178b9e63c7920acfba2bebc408301fea5735f25cc1eafb181dccaa2f",
      "source_sha256": "bde37e2ac3fabe3475e59fc55fbc20c0b9f2a97201ef25df3155a45287efdf3f",
      "translation": "听说他现在正在阿巴泽特港口的猫猫村静养。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1c8f54c9c8dab0298007cf7fe5ce45ead0867a0a24c5c06a93f67205658266f",
      "source_sha256": "1672d8ae1abd595065281be2e9c925d52d6625f4c4312f9e47cee41c0f306740",
      "translation": "那可是从风息岛来的人。您真的不关心吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bdf44c88244a6785daae1d605bc739bb63e31d6ebdb16a029786cf68f6ccc996",
      "source_sha256": "bde37e2ac3fabe3475e59fc55fbc20c0b9f2a97201ef25df3155a45287efdf3f",
      "translation": "听说他现在正在阿巴泽特港口的猫猫村静养。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68e14356a886931ed32a950c29d65349518288909826b78d777b44f346ba18e2",
      "source_sha256": "d21463c7c174a4902fa64857eb775b08ce8bebea18ded61b8e552b6d86b40b07",
      "translation": "你们是来找这个人的喵？"
    },
    {
      "id": "coalesced:7fee3408d2658d71f7a3d75a657cf0975dfb780f45b7fa82fc5b7f59ba730668",
      "source_sha256": "28d62f01f181faaa5555633980e4d374c079d8b522fc16ff4305fdb1ffb1478d",
      "translation": "难道你们认识他喵？就算认识，他现在也需要静养喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe7644ade7eef410d0b757a8dd00d997c8fbe9a78e9a20a85cb4d44ea04e39ff",
      "source_sha256": "b748b2db5db73d03ea1c27bcb11335be063825023bcbd05994398b5779ca4a91",
      "translation": "必须去见从风息岛逃出来的人。\\n逃出来的人据说就在阿巴泽特港口的猫猫村。 "
    },
    {
      "id": "coalesced:0844e7544c054975f12c77ff48a51647fb9d86cdffc3edd9be4016b7d8e5414f",
      "source_sha256": "f33887df8d208cb4ac8986f525d7703e3a90fb221c2460652e483f4d1a1539f3",
      "translation": "来自风息岛……"
    },
    {
      "id": "coalesced:ffec73c6dce28857a6861777739072ec519c7f3bf64e4833dde57eb440c2b755",
      "source_sha256": "d0cf927ff2dbffadc9d28d99261d471fe2bec453bc82c15878d41aeffe10ffff",
      "translation": "姐姐，真帅气！"
    },
    {
      "id": "coalesced:78ddc73ff60f11ec20a0684c7eefce8c6160be4b794393f812ef287d14a9eb3e",
      "source_sha256": "596d21e21cdd983cea987b82d3a478e401d98a6e6f5a04cfba8ad0de9ce07854",
      "translation": "我虽然不认可个子比我矮的人，\\n但露姐姐，看来也只能叫你姐姐了～\\n冷静又沉着～简直就是我想成为的\\n未来的模样。\\n今后也请多关照～"
    },
    {
      "id": "coalesced:518f104ec615876b7fed8a5833026aa723c63618d3cf85cf8ad76569a474e790",
      "source_sha256": "a566d10d8c257eb9b1b675b6375ce5078db2293c8020e2095a832e6f17ef3588",
      "translation": "喂——"
    },
    {
      "id": "coalesced:5524d32f06a2b7411317b8f1cfeaf266cfbaefb99b922afacd25ca0a77089ff8",
      "source_sha256": "404613d23a33c25670cc93d41a45361618b2e68ba9180624cbe6756b9edaff70",
      "translation": "公主看起来有点没精神……\\n该不会是你又闯了什么祸吧？\\n不过，我想你大概也没那个精神……\\n公主总是操心太多，这才是她的毛病。\\n也许，坐在那个位置上的人，都会变成那样吧。\\n总之，你也多关心一下公主啊。"
    },
    {
      "id": "coalesced:1224f79fa206ab3bb3e67b27f8670f782010f456f7a6468f269ae5283fd9feac",
      "source_sha256": "12bbc951b62d609acde897b464b491087a00c125860d140a72f44221fe20368e",
      "translation": "公主殿下"
    },
    {
      "id": "coalesced:32303c63af3dccd43c2505fb957c4a8c30727591d789c0e6b5ba3be104f90fab",
      "source_sha256": "cc1ddce474693bd4d5985fb767a888fb847bf45ebac714373e913d7aa6b721db",
      "translation": "公主殿下，您还好吗？\\n您似乎有什么烦心事，\\n是连我也不能告诉的问题吗？\\n\\n我一直都很担心公主殿下。\\n如果有什么心事，请随时告诉我。\\n希望您无论何时都能记得，\\n有很多人都在关心着您。"
    },
    {
      "id": "coalesced:20a2ef568ad31c22d9e55ebec87719fb7f183985433940dc3deb211e8868d543",
      "source_sha256": "746aaa620aac0165a9847982c7a63207656a772213295c56a996ea02b5e4db13",
      "translation": "也许是我多管闲事……"
    },
    {
      "id": "coalesced:dde1fcb4247ebece1454de8759a8e0a4e000ffdc0c5197742912d4cddf13fd0b",
      "source_sha256": "9da563d7ac181408348447a9b460210d09e5421396fc1d0aef3f15aa26bacedb",
      "translation": "最初听露说你受了伤，我吓了一跳。\\n露也一反常态，显得很焦急，\\n我还很担心，幸好伤势并不严重。\\n不过，还是希望你小心，别再受伤。\\n即使你正在这场战争中亲自作战，\\n你终究是将来要登上这个国家王位的人。\\n当然，我并不是要你怀着身为公主的义务感，\\n希望你别误会。\\n我只是希望，你能比任何人都活得更久。"
    },
    {
      "id": "coalesced:f3e03c2a5f4bd18881181804500f0c28a3cb90cb5af59a3ee9d081f7377254b2",
      "source_sha256": "8d64e2beed1cd1f9664726df8c088292a6166afdd89d9e1e438d0636fca14344",
      "translation": "是我"
    },
    {
      "id": "coalesced:2c7dfe493d4f00dda319bca93f29de845df41b50a763023834ad3f5f634b7d33",
      "source_sha256": "444e8aad3beee002aef8cd40a30f0f097112f69cc2d4cfdd66e1c19258d726df",
      "translation": "真的谢谢你帮了我。\\n好像每次都是我受你帮助，真有些过意不去。\\n不过，我们也久违地说了些真心话。\\n\\n今天的事，今后我也一定不会忘记。\\n谢谢你，让我暂时忘记自己是公主。\\n不知道今后，还会不会有那样快乐的时刻……\\n不，不能这么想才对……\\n\\n应该相信，那样的日子还会再来的。\\n毕竟，我已经决定，今后要想得更积极一些了。"
    },
    {
      "id": "coalesced:9da6b1648b76bec8a21eecaeae6e27210abedf8f75074aa96d0ef08aed2e9e8f",
      "source_sha256": "337ff818f9a4c38e348b90c082fa0bf9d535732210d61c36dd3c143057a6014a",
      "translation": "阿尔戈哥哥～"
    },
    {
      "id": "coalesced:60a2ea0b470bf36c2c82f5c7dfe2ff3c7c26d6ba3b902c4a764700df46b07319",
      "source_sha256": "f1181d127e61db39d6fc0d41bccc474dcfd0225d293719faac063077acfa9ab1",
      "translation": "你好，阿尔戈哥哥。最近还好吗？\\n虽然这么说，可明明就能看见你在旁边，\\n说这种话，还真有点不好意思。\\n\\n最近，我开始希望这场可怕的战争能早点结束。\\n我并不是一时轻率，才决定加入南部军的，\\n可有时候，还是会感到后悔。\\n我会重新振作起来的。\\n阿尔戈哥哥也要一直看着我哦。"
    },
    {
      "id": "coalesced:ce947a69967f3672a610707eb78b3a2fa6759591a1d961201a7b359c45ad136c",
      "source_sha256": "12bbc951b62d609acde897b464b491087a00c125860d140a72f44221fe20368e",
      "translation": "公主殿下"
    },
    {
      "id": "coalesced:17122c1e1460eca8462ec192f72a125c96681d1a986efcb8f9327e06e0629d81",
      "source_sha256": "bfdeff5c3e9974acfce62861310d7cd264769eac493f9a5e8699ef74232a348c",
      "translation": "前些日子，我一直很担心公主殿下，可今天见到您，\\n又让我放心了。\\n您找回了原本的笑容。\\n我希望，永远都能看到这样的公主殿下。\\n\\n直到这场战争结束，不，即使在那之后，也一样。"
    },
    {
      "id": "coalesced:9cdfc9454d7518cec6a8c251a300cc624f2b3631d72c3734e9d93f48b3ef2b58",
      "source_sha256": "3d2ed692ab788d9770d784248a9306c79797880b874b9789cca96f57a660a774",
      "translation": "新商品上架了！"
    },
    {
      "id": "coalesced:4d11f0948b398bb99463496351d8ba604da39af2b31f798535080ee745196e49",
      "source_sha256": "7f326d9abfac22fc655baaac4e16abc930a520ad393f897dbb95cd380143264c",
      "translation": "您好，这里是公会联盟。\\n我们开始出售比以前更强的武器和辅助装备、LV2 卡蒙德，\\n以及新的饰品。\\n\\n此外，状态辅助道具也有新品上架了。\\n究竟有哪些道具，请亲自到商店确认吧～\\n还请务必光临一次！"
    },
    {
      "id": "coalesced:a8160588a079ed87583a30d78ecebb87668bc90b81857c8a624135ab90885d87",
      "source_sha256": "17d54f8becfefbda7125df9bc74f67846ddb419098dab9f7523d5466ad29bb9f",
      "translation": "利安达尔果实 "
    },
    {
      "id": "coalesced:d54afe314e78711e1449803a53512ad36e852c8bc86e267850ab867dbb7dcfa1",
      "source_sha256": "f9c39eb80ec680be1dcb1bc5171704080b5560c5ff75e2a60c8f90c74cf39109",
      "translation": "可用来制作恢复药的果实"
    },
    {
      "id": "coalesced:6af2cb037b6d1d60fffcb08bfa64e42d342db17104b479583d00f227aef017db",
      "source_sha256": "bcc5644d53fc84697178e210d1e48adf8ab214f223bc0071448ebf3bc5c56cd7",
      "translation": "利安达尔果实"
    }
  ]
}
