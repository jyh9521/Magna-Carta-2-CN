{
  "schema_version": 1,
  "resource": "MC2Game/Movies/csm13-50.txt",
  "input_sha256": "6f9ea212be40ac5675c9760ebe21d3c81a5eb7dc9c1f811b37553d4720f61f27",
  "kind": "timed-subtitle-text",
  "entries": [
    {
      "start": 943,
      "end": 5849,
      "source_sha256": "c93b25a55d148b2f01c4ef3a9a92babb2f375cc6194f1b9c504ce22f92a95e8b",
      "translation": "当然。<br>这种事，我从一开始就知道。"
    },
    {
      "start": 15806,
      "end": 19965,
      "source_sha256": "3613dd0550c2a66c2caba637c136285cda4575e89f9b1ebaea09bb3afcf70ec6",
      "translation": "朱特！不行……快住手！"
    },
    {
      "start": 27119,
      "end": 30712,
      "source_sha256": "de437d23a8087e5598a19c793976bb206085fcf34fc26aa67ba3d0d3fe6e8678",
      "translation": "朱特哥哥，求你住手！<br>这样下去，会死的！"
    },
    {
      "start": 30949,
      "end": 35566,
      "source_sha256": "6951963c8cc77f9df63ee7698fc689310297c281d49a2a283e508f0de7e0a097",
      "translation": "不存在什么注定的命运。<br>我不会死。"
    },
    {
      "start": 36831,
      "end": 40035,
      "source_sha256": "5809c4ac5263321e12ce2f523cbddb23d116c46a8fde23a027e644b6cc784b40",
      "translation": "我叫你住手！<br>你没听见我说话吗？"
    },
    {
      "start": 44542,
      "end": 45748,
      "source_sha256": "29b675526db116530806f19b591845a07e9ac651fa5dcee4e2da0267a7bcdc17",
      "translation": "请住手！"
    },
    {
      "start": 46699,
      "end": 51777,
      "source_sha256": "365cd67d98af7a684659e72b02b6126efcf8d0f12b5960c2140ffcc121f53547",
      "translation": "照这样下去，像修恩扎伊特那样的家伙，<br>无论多少次，都会再出现……"
    },
    {
      "start": 52357,
      "end": 56632,
      "source_sha256": "a9d4a5c1384aa33fff13c098ab49cb0e90915cecf58f3b4bf84525e1acaa4ce3",
      "translation": "我们来到这里，<br>不就是为了斩断这可恨的命运吗？"
    },
    {
      "start": 58710,
      "end": 64739,
      "source_sha256": "d34e6731bcf188977bab0c38fb34972314677855cc9dbed1e92bc4dffd3b21cd",
      "translation": "无论别人说什么，我都相信，<br>这是兰兹海姆唯一的出路。"
    },
    {
      "start": 66917,
      "end": 69560,
      "source_sha256": "41e037154c0f9b416f5adc43cec452a74cf79e3d08c02256c5f00fb48d5d9107",
      "translation": "即使如此……你也要阻止我吗？"
    },
    {
      "start": 70605,
      "end": 74833,
      "source_sha256": "47ab65cccd43b9c8168f1281880c9ce1fef045aed5bfa2314f1fbcc4ba2a8464",
      "translation": "命令我吧，洁菲。拜托了。"
    },
    {
      "start": 78849,
      "end": 84511,
      "source_sha256": "22ee34c3db0f51833cecc1baf36bfcd910b451d86705db67486ef7b861e9c6d7",
      "translation": "亲口告诉我吧……<br>命令我，守护这个世界。"
    },
    {
      "start": 85717,
      "end": 86954,
      "source_sha256": "5fd00ccb07aebaa1b7da7d3787b83a25a73c60b6275afdff6ed0b99c12fc6896",
      "translation": "洁菲。"
    },
    {
      "start": 87839,
      "end": 92919,
      "source_sha256": "2c6df8a8cee1026f876c6419f9340ad8a04efaf023da05703fb91b42cac4d592",
      "translation": "你啊，直到最后，都还是这样。<br>……好，就随你的便吧。"
    },
    {
      "start": 93226,
      "end": 96127,
      "source_sha256": "d35d77126a1acdd5566018bd6958f2534c65dc24677982aa6800b5102cf92b32",
      "translation": "不过，这是命令。<br>绝对不许死！"
    },
    {
      "start": 97188,
      "end": 98591,
      "source_sha256": "740171bbcb7bf2e824bc5b80a852b5f38f764bc1dbc9e639d5844b45b8799261",
      "translation": "求你了……"
    },
    {
      "start": 100364,
      "end": 105142,
      "source_sha256": "d3bac6fc181353993b63f5945614f999963e8eee183d12b462389eddec09c882",
      "translation": "求求你……一定要活着。知道吗？"
    },
    {
      "start": 106274,
      "end": 107417,
      "source_sha256": "a64a267121331500a63a79e6acdfaa6b6902e3e4edda83be4dd76dd77f1d66af",
      "translation": "我答应你。"
    },
    {
      "start": 123922,
      "end": 130435,
      "source_sha256": "b365b1a6bf161d83aee3a7e4bab2775767fae864f143bf2d2a90165f677f284d",
      "translation": "愚蠢的家伙……到头来……<br>连自己的命，也要丢掉吗……？"
    },
    {
      "start": 133725,
      "end": 137296,
      "source_sha256": "d72e29a3fe55b1e14511bcbd4eb854c4eee57e0a101368b94bd6f744afb44e69",
      "translation": "我的最后一战，结束了。"
    },
    {
      "start": 155686,
      "end": 159956,
      "source_sha256": "a92d16e4ba6a18b777678b10ead7c214a21fbce930bf476c82b118bd90f7713e",
      "translation": "原来，是为了这一刻……<br>现在，我似乎终于明白了。"
    },
    {
      "start": 161243,
      "end": 167748,
      "source_sha256": "70751d63c499d4d0b737f3eeda0bb767f744a29364bb1044e350bb7b031064e3",
      "translation": "我正是为了这一刻而诞生的。<br>所以，我不后悔……"
    },
    {
      "start": 168151,
      "end": 173803,
      "source_sha256": "33910f444604e13af224da72e7f7e8c666d64621209d996b74fdc7520d8fd24e",
      "translation": "我答应你。<br>我们一定，还能再次相见……"
    },
    {
      "start": 174491,
      "end": 176139,
      "source_sha256": "74ab1214f3b0a9ec9ea9bc815533f9c8cf820f6ae6df5e9c3b99f8c467915790",
      "translation": "洁菲……"
    }
  ]
}
