{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:bf0b9e49f52bc6c08056938c8eacd092d5cd1792f56679690eccca9973748bda",
      "source_sha256": "1cd701ec3e85e5fb68506dc696864a6ec7ba06a7a9fbe72614b443af02ef6527",
      "translation": "库布现在似乎恢复正常了。"
    },
    {
      "id": "coalesced:b0e7d76d28cec16134221936b68c57be499f72a3cb1f032f568a300646d82293",
      "source_sha256": "daf6b822545772666091efd7ba68b17e752b8c4a33d5044b7f630ab981f913cf",
      "translation": "联系总司令部吧。"
    },
    {
      "id": "coalesced:38a78324f1f26511a367c078b3c1c896672c5db3d9b4ec1f0d6c51643130d156",
      "source_sha256": "77a7d385662a9b92e17e660c147892335dc524e0f4dc97207ee3c1d7d5cde351",
      "translation": "得向他们报告，我们去了一趟柯塔马雷，正在平安返回的路上。大家一定都很担心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5b6515e2d3c7cf70fa60c5edbe8469d598d66151baa99e368f0d442df907386",
      "source_sha256": "342a13abb5a49d81a03d3d306ccff711ebe6cef4d040eb71fa872bc4d2c21a65",
      "translation": "那就回阿巴泽特吧。"
    },
    {
      "id": "coalesced:efd56d19c029048c8b637b4510cff83ff08efa93b514d612342fd3cecc7931e5",
      "source_sha256": "a347c683ed4678eb2a2cfe3d75d8e49624f15dd96372cbacccc768df876e0d3d",
      "translation": "公主殿下，您平安无事就好。失去联系之后，我一直很担心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:534c0d3d2e30947606732866fbb82d867c9864a62e8624a806a05f2362f1b089",
      "source_sha256": "426d7c96fde66d90f6a417fff3a5744c4d45747065e12f8dce25fa8ab8924758",
      "translation": "我派出了搜索队，可随后又接到消息，说北部军攻进了水色湿地……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5c222ffcf7d64639f1594e2ac677447e4d1ed9a390434a0de24d526f0cc80df3",
      "source_sha256": "fb4767cbcf0df5b48ec15cf66325edbdc7f583a8d8e2ba40a011ed952b6343d4",
      "translation": "峡谷的路被堵住了，我们只好暂时躲进湿地。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8da11c1ab7615dae1ed84336efdbf95d7c0f2e5858f69412e9ae1951a955ea7a",
      "source_sha256": "108244170d9bb2b611df2d0b180506e34e60a61038f248665cc26b911f566d2d",
      "translation": "不过，库布在湿地里失灵了，所以没能联系你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de134e808cc51569fc6c60977ff00d6aa8026f2d476a41bcc3dd52cefb48d34c",
      "source_sha256": "e73c3b7e64a16ab7474b71759a70f9c1488e82303e4a16b89a33da5507209f15",
      "translation": "抱歉让你们担心了。发生了不少事情，耽搁了些时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8de581025d35d55601469423748c7299f93fba22fe4f6e6fb2f2282c91553bc",
      "source_sha256": "7160d8bc4f9870e981ba589cb8c7ed4b14fc3e25064b6dd279e6bab193b309a9",
      "translation": "不，您能这样平安归来，就已经足够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:593040c59e469868eb9f1315e4787114355bce36db021fce557a9d88fac40222",
      "source_sha256": "19dabd7cb59ae999517602b40874d4fdcf53fc769860f39ee4e12180d9e3e2ee",
      "translation": "不过，我们也带回了好消息。"
    },
    {
      "id": "coalesced:804cba10714527889d21275e9628639694432043358d48c23359964dc044ea88",
      "source_sha256": "d004e3a11aa4cda7763c07f919ad86f41b6d74a9dcb54b6e7f9ce60b61739fee",
      "translation": "对我来说，公主殿下平安归来，就是最好的消息。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e759d745299a1215012ff04f0a8267b4dcb6ac57c950130109f3b9da573a91f",
      "source_sha256": "bb5fc24204f4dab5405af7c21636e3d2722e47cecaa41089a2a2976b74887d38",
      "translation": "亚历克斯，这下可以了吧？"
    },
    {
      "id": "coalesced:da1c6d8d4b6ffcc341ecbadab18ef40cd27189b67ea453eaba848d14264611c7",
      "source_sha256": "5e9d0d544a2cbab84a86f1559db2984edaca87a728f492e2fea935bf039fda0c",
      "translation": "刚才也说了，我有消息要传达，希望能召集大家开会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea77a8eba1093f585a73359f815b8efbad83863a086751b6395a7880dd8d9534",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:392678b3fcc5c090e442e15b2a79dc678b12ccbf0c69ba0178a3dca5b9d98b74",
      "source_sha256": "4cea8e1055c6d82e43b602016ee82d0ce84be49be7bb5e4423efad122fc44471",
      "translation": "我去一趟总司令部，大家先回住处休息吧。这段时间，真是辛苦你们了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:97e359378cedff8becc9222d904dd931cafe65c5818f19686413d49179ee7d5b",
      "source_sha256": "309c31129c0468d3940d6c6bf690e029f8d54851c69c28a393e9b41b5ae49b19",
      "translation": "我说，刚才那个叫亚历克斯的人，和洁菲姐姐是什么关系？他们在交往吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fba7badc918b02b0783352332ceaebfbf0d00b0968a50656d61e89f804dce25e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:0407288411ce0d04e713f0b29a7776d12ac832fd6598257e67b32c2a3838cc86",
      "source_sha256": "ac40fa44036a115c4eeb82fd229fcf5da71ec385685d92c7633a6304f5cc5275",
      "translation": "唔～怎么不回答？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b340f3ee94f468b5c3db485ba5344a442c37c6a5bc5b094d427500e71b69674e",
      "source_sha256": "fba3e2c79134e109183e33138ccdc1a0c6aa83c5619b9ccd64ef88d510ec9c71",
      "translation": "喂，别这么刨根问底地打听别人的私事。懂不懂礼貌啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f97e55020613762620c041878ea1159ef77beb75910e3ce6765af69f15571c3c",
      "source_sha256": "f3dffe6f7ca243d91fd6affdbd188c95ba8b497f2f61cabba27bdb0dd4a36088",
      "translation": "哼，知道啦。人类果然很奇怪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fbba531ea84b423eb00922f50d5f8532e0baac2b6237ab6ec82bda7ca1f008e",
      "source_sha256": "004d6506d322fe2a240bcda0a38a43e5f5f8ea8011a1dc7ba4b983b4f024a757",
      "translation": "那哥哥，你带我逛逛阿巴泽特吧。"
    },
    {
      "id": "coalesced:705bbe50508d51a29fa2372b2c193ea1676e318f73e01f0503a3f58c61010e03",
      "source_sha256": "6d6314544a221923f978f07d0698b8ae201df360c6137e6da183572dc53840cd",
      "translation": "找克罗塞尔或朱特，不也可以吗？"
    },
    {
      "id": "coalesced:cac28f2b9a7ca4bb6e45161edc7d6ca5d336f5668332469645bdc9abb1263382",
      "source_sha256": "46113abe92b55bde036ccfdbf0830f3d6a6ec912b3680805a81945e6cd4e3ddf",
      "translation": "人家就是想和哥哥一起逛嘛。得好好享受这值得纪念的第一次约会呀～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5fa0c165287daf3f60035a1082eb254f5358e5ad132918b46d1e74075f739a2b",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:1e51c805b0873759c4272ec43e8c5ce508ade1e6055e8081d4fd9c8e4c2b3006",
      "source_sha256": "46af652ebd6ed0ee31db8ebc731ec40c7d44951ee62e60bf6b100f9fca3ec2ff",
      "translation": "好，你们去吧。"
    },
    {
      "id": "coalesced:37b8358998d417e426bec93b1ca90213f05497573157093652b22ea5fa0af1e6",
      "source_sha256": "f43e96461adb6f71d6b6465b3b2cc5ed3c4a1f8ac3b8cee51ba5db75f3b68ebb",
      "translation": "来，走吧，走吧。"
    },
    {
      "id": "coalesced:b103aa29dacaa6ae74084a5b9d48b85b6bddb6062170e55491d48f244eccf6cb",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:cd73d773164ff9ea2c80b845b4f5c7af420ae16f66e62df2a254e5ea2c2aa99a",
      "source_sha256": "f3ef038951e43e5c660f6c5be0e158988a0b67184a00296ae1dde1878d56e9cf",
      "translation": "你从刚才起就一直呆坐着，怎么了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2e5fd6f92a2f97cc9c765e29d981636b249636e5bb612c3c2b639f0d2795452",
      "source_sha256": "c615da3e50d05d81491542f9253e29fd56cb505f7ecc9b1735d38e2965a87ec9",
      "translation": "没什么，只是……有点累。"
    },
    {
      "id": "coalesced:1afaf49c737d5ea71b7fcf983ce70f4729aaa01918f124b9df518fa58fec3133",
      "source_sha256": "92b2cd918df9ac07ba1b4b756a930dc566efb29451822aafc9416a6bfe5ae201",
      "translation": "公主殿下……"
    },
    {
      "id": "coalesced:17c1bc69839a343ff17207e05003c06419b02ea6cfdf5ecb3f419e75ba85d153",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:8c0e9e1a85ff2dee5b5e8fa20e382b4a516376e525a1abb2a652db9b6f40c4ac",
      "source_sha256": "2ec07fd3df3bfaad5b53cf6d9d6d219b1720cbfbc9fd82324e516fc4be0557ba",
      "translation": "没，没什么。"
    },
    {
      "id": "coalesced:cd77e63fa7abeeb39cb615d64a720c2ab8a9ebde2d959d0caec06c51a6504aa1",
      "source_sha256": "8f8da75d4b61a492572d92753017f5b369689b38313a615be68d29abe43cad0f",
      "translation": "他这是怎么了……？"
    },
    {
      "id": "coalesced:7d610648c80b55b68fcfd3cfbb5cae22a75aac2e777acded1ef2ce7547013728",
      "source_sha256": "290c29b4463198277d0913bf8369beaf3fe1456190684f344d343bac171ad1c2",
      "translation": "这次能和马雷族结盟，还得到了海底洞窟的情报，真是收获不小。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:64b32ac2447c331118e028af7550338e21208bfcb961415d5b564d8ee6496e66",
      "source_sha256": "d2fcf6126c5a853eb63a835b5011080bb935af7648e30f78c81db4476d7cdc1e",
      "translation": "而且各位已经夺回峡谷，我们终于可以毫无顾虑地向杜南丘陵进军了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f780353f6f85246b9a18a958005f8eee9ffc695cf971cda907200a5966274990",
      "source_sha256": "eb9998ab685788f7df9ef4751d9057e7a783e90f738cfc7844b456299f113266",
      "translation": "那个……"
    },
    {
      "id": "coalesced:f6c873c85f0eaa8540ad262696a9109d181ae98c4980f843a01712bfa9d50adc",
      "source_sha256": "85d239656f796ceb0e69ba1921520320a66ebf624b615a5707b80a392db4fd3c",
      "translation": "我听说反哨兵部队击败了哨兵。公主殿下，请您原谅我上次的无礼。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13086d4673e08dc573f3aa11eac24b5280e8a0117838a6fc2dc9442e36512691",
      "source_sha256": "79b12ade5247538960b0ee9a55273855f7051f8c9d7fc5dbe73f0f794bb90a0d",
      "translation": "我太心急了，竟没看出你们一直以来的训练，如今终于有了成果。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a6f8e85d273dbd2fc3c3db25eeaade77181bf725d790f425e58c7fb10ffc6ec",
      "source_sha256": "e4f3d8a4904919a3cac9fe4f19c49914ea7a54eee40ae1a4f9da23491140b211",
      "translation": "没关系。在那之前，反哨兵部队确实没能立下什么显著的战功。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f8653d0a622afdc3a1dd15b98ffbeddb9b55fb60ab599dbe62a358ee1e9264a",
      "source_sha256": "c88e593c717b5f87f12a3737ffa5fbb3975674f2e730bdf843531b21ad1107ff",
      "translation": "不过，希望您现在能打消对我们部队的顾虑。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a921c342fc829190e854e96c80f35f0a1ceff689e3bfa88ece6aa256a416d70",
      "source_sha256": "b61bd05447fcf46b80653601b5861198401162f05585b694d2f40afe2a07fb48",
      "translation": "因为哨兵已经不再是可怕的存在了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b6b1a2f76b8219775f6b542bf0964d54f27d558c7a79dc3b5ea65846cb7c52a",
      "source_sha256": "64a2ad69f5cf36f913da486107da1afb55b9bdb88cdfba46d068c013a1cb3ec2",
      "translation": "这段时间，实在辛苦各位了。今后大家都不会再对反哨兵部队有什么怨言了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a534193a84e96af5b5ff24c4b1ab5740c1e0b8d9bad024f222c15f3d12265570",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f17e2b15abbeb21d28e47c7f1bc3e058e89438510452a4b5ef6c2b65501d6ff4",
      "source_sha256": "50ae2ef0b11139f30c8b8b0eaa6d99701ecd1ac366c6ff9b1c5c864ed3509e69",
      "translation": "对了，听说是朱特在危急时刻救了公主殿下，我得向他道谢才行。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:641629ff019bb9ed20d4f2e08dd9308604ee36091fd7311b9fcd3e69a2c779cb",
      "source_sha256": "87879aeb43e28be49c260784c24443079d5585abe0824ca4b3c6bc7058b759ce",
      "translation": "是的。要不是朱特……恐怕我就回不来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01569d72f19c281b649d07f56f6d195ef66fa09dae45dba7b235d93b63a6c9b9",
      "source_sha256": "fae793f357107da524ed77f04d25aa98d34c36d029938bcb3082eec73a2a22d6",
      "translation": "明知道有这么危险……您还是打算继续上战场吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:332f6e11d7d18bd31af156a17b3ee8cee28fb57bf97e00bdc2f3895f027b62c0",
      "source_sha256": "9e58aed406d06ac21131232af9a6c41ff63d0139f2a02d9a770c435798b6715e",
      "translation": "我想，公主殿下这么做，应该不只是出于责任感吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bfcabc631356e41635298e95d765abbc495bc8cba4c047152be292f48077bf1a",
      "source_sha256": "4d86902f4df4196bc41d05e0f92ebcb5b2f2f76d5040d95db4077e707cd90bbe",
      "translation": "您是觉得待在我身边很有压力吧？脸上都写得清清楚楚了。老实说，我还有些难过呢。呵呵呵……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d99ba822c9c60b3ff099631c9b140294b9bdac9504e25e268221c921bed354d2",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:bceda685aa182d87ddd4d2899a7d81010f7af25a99357c7d5870acd753e32182",
      "source_sha256": "9933c107d32887ea2560967a45271051550760f0fe98d0f85c74cda1e2ae67b4",
      "translation": "我会遵守和你的约定，你应该没什么好担心的吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68034768eb3efffbf809dfc7286209a94dc19f8aea44c756e2598a43d59793aa",
      "source_sha256": "6b7a7945f5b8457200c710f68e182407d7094b10812d21ce4def53180cd5b1a6",
      "translation": "那我就放心了。"
    },
    {
      "id": "coalesced:3474698322efd3f0d76db295add99e7dc892fde5dafcae9e8d57d96dc9fe4b60",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d2a28367264a8163d77bd392c92bc4f85bb40579bfe1e2650dc89892317e2635",
      "source_sha256": "b0966742b84271a3013709ea70acfa2c14132376ffeae108c879a67fbada90b6",
      "translation": "我知道大家都想休息，不过有件重要的事，先听我说一下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0e21d80e74cef0736d662a2ac395386292dbc6e46d46038ea5ecc2615801be2",
      "source_sha256": "badc444778bf9f433952ef55dde503e41cc144ca7612a1acf1a32747588f5084",
      "translation": "大家应该已经听说了。我们在柯塔马雷的这段时间，南部军成功夺回了老狐峡谷。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d2e4aabf377c23f499dcf3e4d39b51985775331225b4418e716d3f3230e1bea",
      "source_sha256": "345b10aa0778f96e6903ab66792ee80f2b50d6d99d6e338b90b71eded1b5fa06",
      "translation": "虽然是件值得庆祝的事，不过这也是多亏我们打倒了希昂·雷格拉尔和哨兵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6cdd3448d79a7b4cab3799cba6d93b4e521e2162dd738198ef4bfb2b06584191",
      "source_sha256": "c0fb99e7b44fbe3be4c2b251c03fd6f30fa6bdf463bd89844ca677d77917eda9",
      "translation": "只是峡谷里还有北部军的残党，似乎抵抗得很激烈。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8f771f4878421ed24baf88bec7e17f2025bc0f63b3e65f8975cbaf92647e64aa",
      "source_sha256": "0147d2c47c3ff4108819080b1bf8ceed9db2f1d73075e1bbad5c567fb4f8057c",
      "translation": "他们要是肯投降就好了。看来还是免不了一战吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c2be7fb3454faae6384d92572b6797213ee18723295e41312b04aef386ec54fe",
      "source_sha256": "234cacfc04f34e7a7f79d86bac80665fef7e1eba5d964a0dbae0d42846f2d628",
      "translation": "率领那些残党的是一名北部贵族，听说很有本事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4267609e6777f6494ae620d255a342ab358cbe365cc86af702071b4232e8058e",
      "source_sha256": "7e8fc39fe62f019281a37eb9f33853a7f0fb15f2b404189824d3e727aa1618c1",
      "translation": "有那种身份还肯亲自上战场。真想让总司令部那些老爷们也学学。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ffcf61858e31bd5bc4e5ab7267c4a3678cc59466fc3f3bba1af94cf9490935eb",
      "source_sha256": "ae1e7ec2dba846e32cb010380642184c91d8b80a6464b142f2eded62c4dabb8f",
      "translation": "总之，我们先去峡谷看看情况吧。"
    },
    {
      "id": "coalesced:76955201ac02492429906056f91e7b14e837a968e0bc3a92f74706cc36ab4013",
      "source_sha256": "a5ab072af79fdd781ab87f22929a2d9038da080bd42a42a87b6292bf05b52b4e",
      "translation": "啊，那这就是我的第一次任务了。总觉得有点紧张呢。第一次约会，又是第一次任务～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3b711726c6ec4113ba6c03dc7f3aaf70eb3874445ae447bd59498411c7eca5e",
      "source_sha256": "193947f967315b7a9044c791d5cee59fc19333cab2221d4555c310123a2269df",
      "translation": "约会？"
    },
    {
      "id": "coalesced:2407018d169ef0879825215c911f62e53017880a601510cb9d6fe8d4e3558882",
      "source_sha256": "8e3518f40c7efb9b45799b85f59435177ba6454289b1b99b82da6b566847e47b",
      "translation": "对呀。阿尔戈哥哥特意带我逛了阿巴泽特呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0575dade26853aabbc7cd64abc24cb644da6e6243dbf332e45e0c3592c1f9d3",
      "source_sha256": "2bf35bdae431243fc26da6d01e5933b417110a77bc9e5e65b52944677b509778",
      "translation": "明明是你硬把他拉走的吧。"
    },
    {
      "id": "coalesced:58cbe1dd6269ac04457994437875a1696024a15a29fa343fa67f15ac8ea61b59",
      "source_sha256": "531472ec5b8744c1d341cbbdee51c09bea437ee357d3240c8c0cc65867eab3a1",
      "translation": "你少插嘴。"
    },
    {
      "id": "coalesced:f6fd01b5754e49d70f4067d44c0359449cd7e61048a32a80f3f24011b8b7edf4",
      "source_sha256": "3808fe0b64ab1504e0d3d8f1a1a251486c05407c87729016b1162e4302a6ecd1",
      "translation": "啊，你还来劲了。真想打一架是不是？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:45e8c42881cebb80d6fc05cc537b65868ee69caea6088c15bbb19168144ff801",
      "source_sha256": "2b39d7acd51afb56426fe201e559c9d109a8dfc506aea924acfe43ca262ee68d",
      "translation": "唉，这回轮到我劝塞蕾丝汀和克罗塞尔别吵了吗……"
    },
    {
      "id": "coalesced:61e27144ca9626de17543f0590171bb015666599876fa1bc7d4a3ea3b4538f3e",
      "source_sha256": "289169bc0c566454496ced2ef0fe656f167e1ffd861eb8db86471fe56a4f2d49",
      "translation": "唔……"
    },
    {
      "id": "coalesced:f756c65f589efefc201bd9c082471bb5c46277769e1cdb1da1757275b6362843",
      "source_sha256": "051b99f1beb4fcb9cf715d98d4bc9aec5006bed60b62751f7e7d6b483f14ba53",
      "translation": "怎么了，朱特？"
    },
    {
      "id": "coalesced:c384770bf1969bb647d48e1797d77fbee8fcdb404989b85cd50e54a7b36ca76d",
      "source_sha256": "294c5ed94343416a95f2ad709e3e8a67f5faa32273355970fadcfac1bc73a995",
      "translation": "啊，没有，没有……没什么。"
    },
    {
      "id": "coalesced:45a274d7012cae3d13c0bce2237d8d635a003a99a610334d118603d17db0b4b6",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:4e1171f40aebbfeb35ade5d097f8f8404ffd542c203b0cb78824da0cc53f6d86",
      "source_sha256": "4a814e7fba6a9c075be883a3ef4bc6726f16ace83ef2fc9eb169a2d84363b71f",
      "translation": "那就准备好之后，出发去老狐峡谷吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b697343fb24f8224a3b26ecb7aa5d343892114cb915017424bc2d9eb28c7755e",
      "source_sha256": "153d8b8fe551da58ef893864a09800606845beb33be92207dc9b1253a682ce3a",
      "translation": "又来了，南部军？你们最好做好觉悟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5ba33e4fba672318a619b0cbdee1c5c1b482875b936bf5f1c4c52894c0f909e",
      "source_sha256": "0577ac906f171c973197cf1f399afe756364907d9da1718346c4797215b0e743",
      "translation": "别再进行这种毫无意义的战斗了吧？"
    },
    {
      "id": "coalesced:c7db1168b68b8f04f274c44c1a39ef4a7403a39bdc0ee598d2ee97075c10206c",
      "source_sha256": "c4fdecd558595f7260fdf9e990500c6f29e2ed9a1fbbec4458f9de65813809f7",
      "translation": "反正不会有援军来救你们。现在投降，我还可以接纳你们。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7677bad6aa8c383b9fc119647a799e09ca39fdc41ffe89c710b5d9ae7df9c552",
      "source_sha256": "aee4c687b2bc9fb118de603652dc9af47a8cb820c4aa97992bb9f602036d1e3a",
      "translation": "哈，终于连公主都亲自来了？"
    },
    {
      "id": "coalesced:6633fdd9063af2964673ed49a830eac3fc0aaf1e65898325290b7aedd2a30019",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:afb26b7d8ee4c5793ec712b3492be561e6464e5741d78c1574aa7c68ac0b307d",
      "source_sha256": "a5bb2bf56452f81021d2ca5208cdf943102995ddf6727b61f88c5428f5b31b7c",
      "translation": "要不是你反抗修恩扎伊特大人，根本就不会有这场战争。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d5184a13f357aa10cb4e126a2b479ff936674fa705b9888fb30efa165287d7d",
      "source_sha256": "96568cb5e825a5356eaa6ea9be8d03851930855ecf753ee3aabf083bdc5386c3",
      "translation": "全都是你的错！"
    },
    {
      "id": "coalesced:7bc9d796d22794ee8b0567fffc11d9d4633d552bad125aaa9db8a6bbd912c494",
      "source_sha256": "e683c83a9aac39257cce4242ee88761b859a6a0e263ec4d287cf6f4397ee9450",
      "translation": "别推卸责任。先打过来的明明是你们！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:669844f12927165eebd4930176030b84e18a898c1cdecfea2e80871b85b46cbc",
      "source_sha256": "520458ae3308b5ec88e406173c08173b0e75ab16a35c0c3f36a59fbc9f18cd5a",
      "translation": "朱特，我没事。"
    },
    {
      "id": "coalesced:8e7b6837e0e3ccb09e887c6b8341cde2601cda5651091e35666e39a5ce49b08d",
      "source_sha256": "0d18fb27e0ff57c710b43763f1aa653b83aa0f5cd4737bc0c33931f9e0bf03e5",
      "translation": "照你这么说，修恩扎伊特用哨兵屠杀无辜之人，也是对的吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:201f11bce159e9b54d1abebc10bbfee27cce3da24b7332898ff77220b4f414fd",
      "source_sha256": "d080dbcc539140238b000ba1b4e17e458f766eea50b92a50dbb361480c35606e",
      "translation": "那他杀害我的母亲……先女王陛下，又该怎么解释？难道那也是正当的行为？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bb020268a6959284595422e8d5eb8ddfae18b1ab1d22ff0c09d3295ca56f0229",
      "source_sha256": "1c31fba2516ca991b8d7953000b933346d2ccc8a31677647d679ac387924d271",
      "translation": "啧，拿起武器吧。没必要废话！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bec6d5392cd8dd82aca88a02f6b9ca0bf96d552bd56877df9d487bb1e2ab33d1",
      "source_sha256": "895636dcf6e25ed22a43fab6cfb4a8137ea625659fba8c857ce055e882baedc3",
      "translation": "到头来还是诉诸武力，果然是北部军的作风。"
    },
    {
      "id": "coalesced:60952fd62f0ebac611f2d06b6ad9c024158ad7bb549142ce7e9fa83577be359b",
      "source_sha256": "63ceb48a675ff8c1a1d933190636027727636959a01c64ff371fb0e7087747d8",
      "translation": "来看看吧～这里有很多稀有的卡蒙德哦～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ebd8b9175a4a4982372f5a32d04ce1a367f1a1e51cf8b75c6b6dee87974f2d72",
      "source_sha256": "751bbebcc8b63cbd9e3c68194f22fd0a6719780c69aa04cd28b2d0caf6c6ecea",
      "translation": "谢谢惠顾～欢迎再来。"
    },
    {
      "id": "coalesced:2a6996ad03d439a3fdb70275a445a4f9f20a2290169759dc2716a00fcba0b8aa",
      "source_sha256": "30adb40a720d66c11ed0d3584cd604647859a82ad9690122e13b050024ba3205",
      "translation": "来看看吧～各种货物应有尽有。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a758c017d7edf7396243ac1a36c8fd5a3d72221195a3da86bd2873ee11e00e16",
      "source_sha256": "97cfb5e7eb71b4031c63fc50c438e741f4ffbf492ea9a8b35e5af1792ecde46c",
      "translation": "这里是阿巴泽特。我们这里的大型公会联盟可是很有名的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3b48305b2be8b23f317880d537cef1df922359e5f41e33dff7425af5017256c4",
      "source_sha256": "27c2f7c5f1aea15ad872ca350fa19f2b838f77d0d42a34c8b7c772d45559900c",
      "translation": "我实在没法原谅拉提族。杀害我丈夫的仇人……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:35ac93e2d58965a8cca1e91253b85af138ded64ff8200c8bbcd7b3261dd35359",
      "source_sha256": "c0966d4fd07d5229b076825713a97dafad18397c8d501429d7634f35f5e5f8e0",
      "translation": "你知道卡尔塔大战吗？那是一千年前，人类与名为卡尔塔的种族交战的战役。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bbad6c86b4f9c9c70bf6596d854635d6a1d608da210e1d191c98e0ebbe756dc0",
      "source_sha256": "7a488ef445cd848836b8ef95f73b609cf853a5a7ec8ab30521676e018a1803fe",
      "translation": "当时，卡尔塔和人类也打得非常惨烈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59a51cad357d0a6da6b1e6469bb1de7e0731c7dc357a588ddbe01e56120ecf8b",
      "source_sha256": "95e675e3b8447230ac5d94ab8efff416abaae7dc6bf73ed33d0af16970c367af",
      "translation": "最后，为了打败卡尔塔，连名为守护者的怪物都投入了战场。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec4faa88d783028fa134fc6340adadeb4e9984bf4fb5e1fd994e1bc28246b50f",
      "source_sha256": "7320cc813c50ecdbfa97e2a2e995e7397179e56205b0f9e666614a0bea5bc55f",
      "translation": "看到这次投入战争的哨兵，我就想，当年的卡尔塔大战是不是也是这番光景。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be60f8b56bf6b78134fbdcc81d4328d82df60cc9d89242dcbf46ba1cd2c2e46c",
      "source_sha256": "f4ca1fa459839815fdf02fed713dbdc36b556f2f2fc39de9ca9efa8360d466c6",
      "translation": "说到底，全都是因为修恩扎伊特那家伙杀害了女王陛下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08f79215e9ef545a4fa1aa2bda30fe247586f42d01696f8273495905cb529d05",
      "source_sha256": "b38dac9cbd216dd526edc7e04797230b288c98a5658bc14854da9a706d00a578",
      "translation": "他原本是位贤明的宰相，怎么会一夜之间性情大变呢……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:caf94778542648a4784dde57b7b7305cd9f1b5f5b815ca1ae396581a9e551ae6",
      "source_sha256": "e92e186db25308d8d88500e5555a7259e17e0059655169380b7090133deae52a",
      "translation": "盗贼少了许多是好事，可现在港口却用不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:901db8cb755e8f7c960b30b6667bddc27b020dc529e452ecc222704eebd68f4a",
      "source_sha256": "e1806c32d6136e539d40d743b5381316a89469cadf4e07f2f9a5d51449eb2cd7",
      "translation": "哪儿都去不了，也就没法做生意。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2322fbd44f099bbea1176383de0450ef5aee4ea882b3ce7d5526633448a2862",
      "source_sha256": "10d95944e4661a4def9c9cfb15e11328f8fb901f5673bb1b73c38bccceab932c",
      "translation": "来看看货物吧～"
    },
    {
      "id": "coalesced:5eb597ee48ab82f384ecc6e1196876658ba443d06b3319ba6c3770d4dc6578ef",
      "source_sha256": "58b8396eb86456c1d2f3d247be700b711eafe4edd0360bc30b21facd9f93ae9a",
      "translation": "你见过什么可疑的人吗？"
    },
    {
      "id": "coalesced:939bff6209f1d78bd4f968f2ece6b2b88f1d1f1f780ddc1e34748324cb75aa56",
      "source_sha256": "a1f8c40ad4c0a9e443a20f541f1f679dfbc46d09b8cfc2f5363ca89ffa60ca97",
      "translation": "不过，也不会有人在脸上写着“我很可疑”就是了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d460b34b8f01e8e8c05dc5be9657aa8282d39e01e98721eb6969630be4f1b883",
      "source_sha256": "73bd7e667a7337f11681f2ec0efcfc14effae99b37ec40369ef495b7b33163a5",
      "translation": "上次战斗中灾祸种降临的时候……我突然用不了连环术，真是慌了神。灾祸种到底是什么呢？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:835eb9cc901c48cd64cb08f63941d1d8a183e4b0bb2030fa33309075d80cbaec",
      "source_sha256": "5f4471db26d4507f478481bc2cf8f4a56ad2cf3d2508005fb280a0e858d9caad",
      "translation": "商店街离家太远，每次都累得够呛……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:873f2e79e76d5959267217963f34fef77a9a987dc610f84ecd41e4db0d6595b3",
      "source_sha256": "a8d721891fda520b34f2f5d8476b9d54cadfbcd2abe97e3f4700b5a8a915dd9e",
      "translation": "虽然夺回了老狐峡谷，但听说北部军残党的抵抗还很激烈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff29a054d61738336accbaeea2708e73866823d78c29917e5a68dc833429e8aa",
      "source_sha256": "880b926b08de637d972ed625a33b1db52a72c9b727c7c54c6e27a5ec08674dcc",
      "translation": "杜南丘陵、鲁哈尔特……还有贝尔福特……前面的路还长着呢。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:649e9d70b2f2deb7fa707fae0489664119562e04ae2cb03ce21f3feec6c7b20f",
      "source_sha256": "502126237322d94ee85e1ff9f22252c3f2f53376142a1532dd2feaa8ef423a34",
      "translation": "听说KAN也会影响植物的生长。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcc8c0e42cf5975a59157e85ef883ac85294448bd414a5b410c1056c02503a3a",
      "source_sha256": "442f7b7982247503ca63011bb768e07874ff0efc2d3bf236c5fdb9c2a7a7dd33",
      "translation": "所以只要种下种子，就会马上发芽、结果。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb68da64ef8e4bad8f10c7abd039c5fd017e4172a83793fc74ca018b678793a6",
      "source_sha256": "ad2ebb90a58c2219800c36c6b99b9f42e032aac456a9678f7cfc0d994d76b6ac",
      "translation": "听说以前要花很长时间去做一种叫“耕作”的事。和那时候相比，现在可方便多了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41b6c679fd0b00a630bbbe6b6113dc0da155b4a5218028bcd64974b4765cfa6f",
      "source_sha256": "439eddf964b6e1e70cf34612a03ceb1ac82c6e1e807b6f4a06fd2cd818177eed",
      "translation": "没看见我正和恋人待在一起吗？真没眼力见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ffaffe7ed3441feb17ed50ded89a3447daeda6320785884ca24cdfad844507b",
      "source_sha256": "f91ef9f883587fa623e9af5e23bf3e288f675c87e4e6cb22554e21e2e1ad2d0c",
      "translation": "你肯定没恋人吧？"
    },
    {
      "id": "coalesced:3f1d8364c24942b2ec1fdff26b5f1f11c2337c1350ba37dc473455d7b7811076",
      "source_sha256": "717f6e1d89fdd373bf20202781c6ec78b4caed8a1b2c99bcb6c63852eac0416e",
      "translation": "我男朋友很帅吧？嘿嘿。"
    },
    {
      "id": "coalesced:09405dee7f81016a0e141c6f2aa030cac7e3959e0f1e31bf3b311c743c56e2f0",
      "source_sha256": "47b3644d951068cb4aa9bbea52de233a25e81070506c11a405b2b12719e97e9f",
      "translation": "小桌子、小门，还有小床。最让人受不了的，是餐馆里少得离谱的饭菜！！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7bb544ab7283836b564a33daa6e66cd17cb38810c8d08921e604a2800662e4c",
      "source_sha256": "0c3af27eb873d04037b2b27885e5e7d54edae7b988642962c543affcac1b6f12",
      "translation": "人类的城镇，对我们特雷瓦族来说，处处都不方便。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e018c1c09fc7bb763194b38458b018b9707f6a4a5bc05df70037d35c3410f4de",
      "source_sha256": "886c98ff190856d45893222f0cdd966cfb6b3d3c26dca5fd39f6c9ceba427f09",
      "translation": "虽说他们已经尽量照顾我们了。"
    },
    {
      "id": "coalesced:59983a5b817baa68c744e447eeefea0a96d7839a250f27b0ce21c47dbca42077",
      "source_sha256": "beabab228f27a668c87be5cf58a9c1ec64203b3e45f9ad352a5d73557796874d",
      "translation": "我家那小子加入了南部军，也不知道过得好不好……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1027ec83e1c6b45dc18156386d3d2a67e04a28b16b8d66220b0e8eb1e2810de4",
      "source_sha256": "0813ba5031840d1949838683b1c87f7fa3e43d8847d28f9e18091ed84443efc4",
      "translation": "下面报告当前情况。"
    },
    {
      "id": "coalesced:c4670a724a33f4b6b0679d660cc43688696d7f461039420f5ee3c717ab814bd0",
      "source_sha256": "fa6c7c126a7b5a55dbdb079f2893cb2a2c84fbb37fdd81f5a1ec1d5ac35eb5d8",
      "translation": "在北部军设置的路障后方发动攻击的敌人，与死亡弩炮配合起来，十分难以对付。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e962d36444cae0a4bc31f0172af948a84cde8eb2fa4a63ef7108c73a6922da6f",
      "source_sha256": "8437a2549a36c00848bf12978dabb9540498c4095249340cfd7fd76e27e94dbd",
      "translation": "所以，我们一边破坏敌人的路障，一边确保进军路线，途中在北边发现了一条小路。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91d20aa50bc1adff14795acc8c4e61e832c98a05bf7479d1ff32e49db56d41e4",
      "source_sha256": "1ce5c45152420cf67c30fbb77f300252861cf793b57763019868ec3e254728e9",
      "translation": "不过，那里被障碍物堵住，目前还没能打通。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e22f7c770015214eb7f112c063e66c0bb2cda6d1aebea946d6618b542259159",
      "source_sha256": "4c64970879c783b055f9d98bd01c04b8b6e86d8f283dd8adfd055dc4ed8fbf39",
      "translation": "我们向猫猫们提起威力强大的炸弹，他们说已经交给反哨兵部队了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48b146560e029ea639491375c5c6a321c39f701b0b48666f40363ecace830c5b",
      "source_sha256": "c3d929441ec3d005b0a072fbdb241b3f6daaac60b03561fcb87d61ede60d936a",
      "translation": "用那枚炸弹应该就能炸开。我来带路。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84d9b929cac0e18471714d8a010c9756dd2b4a6d06e13c13699b3e7bbf7bb3df",
      "source_sha256": "10ff37130d80a9420b05f38979808f8b078448232d7c05f84dadb0549192fe0c",
      "translation": "准备好了吗？"
    },
    {
      "id": "coalesced:bd4d38d4a6aff711b6eb50a145ae6142e1d7bfdb8c56bd5aa0634c238f7839b6",
      "source_sha256": "10ff37130d80a9420b05f38979808f8b078448232d7c05f84dadb0549192fe0c",
      "translation": "准备好了吗？"
    },
    {
      "id": "coalesced:18b27f03c53440bf7d2a0a9b962f042cc675cad311c1cc5de9feea176e58889b",
      "source_sha256": "13b17e17268d2cb862a0f20ea05bc7a4ad2121ae9b3711e4073a62476cdd1a1b",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 出发\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 暂时待命"
    },
    {
      "id": "coalesced:0119400a675baef0860b910c38e214938e1c4f8dc84f0864c233c3aeb279f34e",
      "source_sha256": "360b788f4f391dbe5d8c8000a838d2fc862f2786b1c529c1ce1ecd20788b52aa",
      "translation": "那就出发吧。途中可能会遇到北部军，请做好战斗准备。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:126af76e5dea1e6409854a1cdf2db8e337f6acb3d1607f7cb51863d31aae1883",
      "source_sha256": "88ff4627924f037071d385fabcf22821ace4acc5ac414af89c6379c601e58960",
      "translation": "准备好了就请告诉我。"
    },
    {
      "id": "coalesced:12f7db6952556491c2d3f5faa9919ed352d34df9698b6871f255342f4428f10d",
      "source_sha256": "9a7bb9986fc5e719bb53e592edf1f7aeab92cae1b728ef2127ebb15261086d28",
      "translation": "就是这里。"
    },
    {
      "id": "coalesced:075618dd8e7de72a2bff679e1416e60c5e27886847daa8a267a3f7dbe48df365",
      "source_sha256": "de1059b83d3d2b0fcd33c4289073a8e79bf4821c021a6fe35056c06f0ec7fbc7",
      "translation": "在这处障碍物前使用猫猫们给的炸弹，应该就能将它炸毁。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2a50320f9a64c07c98c56922d357a168c6a224c68a67b2749c00505a10b9ca1",
      "source_sha256": "1d47d62a70c6921b41479f9577233de0479b6a116a4d43bb8f828a36f5ad3c60",
      "translation": "请在移动模式下按[RT]，从场景动作列表中选择炸弹并使用。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8a15c891c6a30dbb5ccf77d1175d407600f77c0dcc8cf65241a8effb149acf9f",
      "source_sha256": "befdb46a4b38f7ca7bcb8c050e0b2fd6d82d4275ce5337e0d3bc12951218c251",
      "translation": "这样就能绕到北部军那些家伙的背后了。"
    },
    {
      "id": "coalesced:886ffa8ce4af4ea955b21042fbadbfa4b044ab76ad2a6bdbc812fee1df766178",
      "source_sha256": "e68080af416ad703166131a6e75ab587bf0de5617aa55adb2de3448a49365f45",
      "translation": "我这就回本阵报告这件事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58ffde485392c83e849f20e7a451f0afe3fdf9dc0fb9884fb418dcab160d444c",
      "source_sha256": "8bb251a2b355629616e601939207dd32a2483ac42f364abd00325636b6886c10",
      "translation": "祝各位武运昌隆！"
    },
    {
      "id": "coalesced:b8010b24b0328577c70f983359891d4c6d257ea7490f7723e2523645992a882e",
      "source_sha256": "4ddacb38ffba81322ee05076086189fb06c72459de5f5b94b3eb1129b557db33",
      "translation": "破坏障碍物"
    },
    {
      "id": "coalesced:33e47e23f4886ee283b78d0ed991b8d8224595fb95e42f44c24c99e62f208580",
      "source_sha256": "60e4a8f5d04b9fa28d4bedd992ec2c760a00f9f7b36e4cac25b4693ea41336d0",
      "translation": "跟随南部军士兵前往障碍物所在处，\\n使用猫猫给的[猫猫炸弹]\\n破坏障碍物"
    },
    {
      "id": "coalesced:85a5f8ed4127025b51124b203aa5b9c41b1789eb69444240d6f19f3a2cfe8e57",
      "source_sha256": "8f4ec095efbdfb0e777c4806710701e235d032362350a46e7c1c5938a0867497",
      "translation": "QUEST : 障碍物破坏完成"
    },
    {
      "id": "coalesced:8b08978ad1428859f69fc5e7bae899549115388972cddafb4039719dbbe57e06",
      "source_sha256": "0813ba5031840d1949838683b1c87f7fa3e43d8847d28f9e18091ed84443efc4",
      "translation": "下面报告当前情况。"
    },
    {
      "id": "coalesced:9a97571794286bc75eadc1f8f389ed4961bbdff118cef561f7e6e2d22f72b31e",
      "source_sha256": "5b03cb35fe7b204ba6f50cb4ee20706cf015ac6ed2b7c85dfc3beba927518dfc",
      "translation": "前方有三条路，敌人用路障封住了所有道路，并从远处发动攻击。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:716d90ee0f80d368b619e69646c219e6cb4c33af0643d4ceef9f78fcf0773b12",
      "source_sha256": "b659c83967e62d3da2bac860fd629f401b0ea80df23201796a26aaa1c2a4fda6",
      "translation": "想要打通道路，就必须破坏敌人的路障。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13fcc153fba9f1de1ba2c816fd71cb08244374a62c2ad1fd96975cfc1fcb2341",
      "source_sha256": "ca25589df0d7dc4a897ee3e93b66458b4207548ede317d7c6fbe9a883528ebc5",
      "translation": "路障可以用强力攻击一举摧毁，也可以用火烧掉，不过敌人的攻击十分猛烈。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:925fb3eb64f1e57cd5a64ea48b045f7f9e078cf8b05fb742b63709a1d4eb6077",
      "source_sha256": "e3cb784d8feface6bd83a30d252b1022a21cda1bb7e3210a3f17507ce57bf21e",
      "translation": "请先拿上这个。应该会派上用场。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38fbdabf555d043171aea664a41f127f24be1842765c3e1b025f26d35236666f",
      "source_sha256": "1b60601463d3ad9d160b6512ceb869992f30271854761246287a5045a1f6f055",
      "translation": "目前的作战计划是，在三条路中的中央和南侧投入少量兵力进行扰乱，同时将主力集中在北侧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b62e19776aaab069d961fa1135f8774d6ac581ee5c788fc741d49be5936741d7",
      "source_sha256": "1e7f0384c31789033851266e14c125bda7da4d54de04994fa8557ab142121d50",
      "translation": "反哨兵部队不在本次作战编制之内，各位可以自由行动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:90b7591837af2b9a44d122f3cd0df78c0ddead558f166916ff120d5033b4026c",
      "source_sha256": "ac2b102799bb9a833504e36c603998809e0d62880c150374fa9e51f93260f5ba",
      "translation": "那我就去传达作战命令了。"
    },
    {
      "id": "coalesced:32ccaa770b629ca5b40547b57e1bfe25a318f31b33835d3e34c94bf7922cb88c",
      "source_sha256": "cfc2b2c5a6341751f15db9f9148da561ba31664d90472402ce3033a0829af82d",
      "translation": "作战开始！佯攻部队，前进！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40e7cbf22aea6975831d1b87342fb20c8a084593273104bc32dbec753d8bdaf5",
      "source_sha256": "9fb4337de2f72fae5be691671f6bf684c4506e7dfac3847b069a990816dcb742",
      "translation": "明白！部队前进！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ffcb906747527a218c7e9f17e07a1d494adcb2b9f46c526a0f5cb85fe3ac89f3",
      "source_sha256": "053aba793960dd4e9656594e3ba786cad2c25854e00196812af372065677126c",
      "translation": "一切为了兰兹海姆！"
    },
    {
      "id": "coalesced:5918fa2fc0fc3df9fdcffd769a28df5af6d7a32c33ffb0d03abcc9f15f272cd3",
      "source_sha256": "272b63b1b1c5860973f17843fb2adcde530a59ee9fad3b7678a2f28a022db531",
      "translation": "时机到了！主力前进！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdf8eee73c1d192da87f4eaff5115a8f28558d16b45486f2dac6e3e579f80ea6",
      "source_sha256": "568e7bbbefa652272386ff2e907f05d3a0480be310dab8cc7b9d56b9d6086e18",
      "translation": "把修恩扎伊特那些肮脏的走狗，全都赶出老狐峡谷！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9388389d701c765b0565934c8400b82d723fbc8007aaaa7941061f442d92417a",
      "source_sha256": "053aba793960dd4e9656594e3ba786cad2c25854e00196812af372065677126c",
      "translation": "一切为了兰兹海姆！"
    }
  ]
}
