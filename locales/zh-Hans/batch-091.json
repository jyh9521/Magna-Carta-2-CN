{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:f937595eb3947a3a5e46f635f457dca087582310f0994a3798232191e7097824",
      "source_sha256": "f0053e5b8c3fa2246799860c7444b28d473ab93d24b8e110692ea42227db8262",
      "translation": "请问，你们有没有见过，我弟弟[琼斯蒂]？"
    },
    {
      "id": "coalesced:eafe161bfa32a5e046e05f5245f8c36a4a3b26be17cc62d680d16ad4abb47724",
      "source_sha256": "dcf5e1af80fa7854f9eefe460f952091f1ce2485a73e62f9ab33a51e308dd1d1",
      "translation": "现在，外面很危险，明明已经叮嘱过他，不要出去了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:055bcb314ca1b15d47d16182ee2cc47a5f20a44c411c5c5fd2337edb3db5c4bd",
      "source_sha256": "c7412418ce926f2aa8588a17c51a12382645cf50d5087b70143c7086a6dbf48c",
      "translation": "看来，又去东边的猫猫营地了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94f4ca9a95802e4f557357a7ba39eab5e048a2f6dc510f865cf391f0d555ea1f",
      "source_sha256": "321d32243ff7fe52cf3d88d49c5b3529c0db10712b67e3c8605fb0c4d8f758da",
      "translation": "能帮忙找找琼斯蒂吗？拜托了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c8794b4e3ed187312cb381b2a0db42061fc7bb04bd65ca83c9abf7333f0d5c6",
      "source_sha256": "5b50e5cc0bed73fae93043f4159d7ea9d341638ff2939e6b8ca2e6108d4bdd2b",
      "translation": "请转告他，快点回来。现在，可不是到处乱跑的时候……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0103c365872ca6485258a4f1f3522bd2d50e211122925bf8ac431bb6eaa37032",
      "source_sha256": "8a2ec81c3db3981544a025a98fad9c51a7409086f342b0323ac3b3e208aad3ed",
      "translation": "那就，拜托各位了。"
    },
    {
      "id": "coalesced:e98626e7a9be9bf583d3a3ade81baf75342bac57799dbf7b243d6503b1d8347b",
      "source_sha256": "cb0430844b0cf5a77330730fff4cf7b68cb2ce9782b53068c2b909f77c2263db",
      "translation": "啊……明明说过那么多次，外面很危险了……"
    },
    {
      "id": "coalesced:2a07b1fbfaf2e246447ba9413e3eb3625a3bb6b8d261b39a2236d9861c555f95",
      "source_sha256": "34b9d3f94fc0274352b7db226e51850af9d3d00f3bdc94d2ca4920dec71ed1ce",
      "translation": "那孩子，应该是去了东边的猫猫营地。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b48cf8c29f88b282dba48941e4d89a60a11d082fa45513dd2580a8c2253fc7cf",
      "source_sha256": "f138e3ff9ca2e5a2d7621ee4be6821cf9d731ff3211447ecc3034c25627ef7bf",
      "translation": "找到琼斯蒂了啊。"
    },
    {
      "id": "coalesced:e7128778f12ec127379a39fa6865d72fa9caa4a5d28ff7d5624794f9c2b5db66",
      "source_sha256": "7943c2b2fa9b1b4009f7ed22b24b19846684f17ba02520336e6609b3eb89941c",
      "translation": "等他回来，我一定得好好训他一顿，让他暂时别再出村了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:56f44ab9fd926cae128b6dbbdf5ed7f9717b07b14516482eded13ad9b7b7b1b5",
      "source_sha256": "82dfc13e17cf2ec2e60e00147acd71fe9b22ff39c3afe95e3062339034ff475c",
      "translation": "QUEST%s: 找到琼斯蒂！"
    },
    {
      "id": "coalesced:426ecdebd58255e274988e1cefd842cb2a8f2e9a8e8cb3f6ddb3ff3b9bd382dd",
      "source_sha256": "1bca01dda11b08449735af47248c2a7040781d5511ca278f9ff59b59902137eb",
      "translation": "找到琼斯蒂"
    },
    {
      "id": "coalesced:1dbf36f0f50d6bffcb5488d7c9553d1bdcb439f38760edd33ea50dd4c7030b16",
      "source_sha256": "d5ad54a7700ec35cfbc61a1aa583e997c58d6e0211da0084bb41b0e9e0ded261",
      "translation": "找到猫猫营地的[琼斯蒂]，\\n转达委托人的话\\n转达后，向委托人报告"
    },
    {
      "id": "coalesced:ffa5423b3e339572fd07df63a8798416c3a7ce35ea92d1b0ac45122d70c040ac",
      "source_sha256": "af0a8e1a8831c2cf31c6a805a11be9c00601a1b1f8384bf5cd4381d38fa9ddb7",
      "translation": "外出的弟弟"
    },
    {
      "id": "coalesced:1c58d963a0c4a1ee7825d018903582f0c9802947973fc52e43cc7e31568b1910",
      "source_sha256": "dff75c711d648ee08674cc1c21eb5fb65c37e05a48f45130674e9d938c4e4806",
      "translation": "是姐姐，派各位来的吗？"
    },
    {
      "id": "coalesced:e69368b3ee172b68421da78869705c3dd140607d603fb1abe50fedaef8ffc891",
      "source_sha256": "7454957dd502a2a118f65009ed80b655989b78f340e9c0f460af84d9134d2fee",
      "translation": "不用想也知道，肯定又是让我快点回去吧？啊……真是的，到底有什么危险嘛。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7ebb9ee61de89900fc22c89f5a2977824166ccaab01f3c7647e002dc1bb0cf5",
      "source_sha256": "6a153ad474ebbc2f8fd2747bcc99a8d04eff20bd244fa0f941bd81ec3c7ffd11",
      "translation": "知道了，我马上就自己回去，别担心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df7a67d88a95c62362a70ab7d2a95eca436d6bd14a0e44bcb55abc6830bc92f7",
      "source_sha256": "9412e5f005a8f305403bc030c08f95508e9e513a6e3c2150ad877fa375f8c7fb",
      "translation": "比起这个，看看这些猫猫，多可爱啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da8cc23d3c1d23173a8108810e30380bc09e921698fb788f1f6a3391deaa6449",
      "source_sha256": "5f959aeacf4e9d6ba2777b2ddf5ad117cb411df33160cd96b736c31b1e64f7db",
      "translation": "嘻嘻呵——来得正好。我正需要帮忙呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2ea408215979af4971387cd90f4400e173b838d248b0a35ee978eb57ffe38a3a",
      "source_sha256": "beed9dbb9bc345d144cd5fe2636150fe3f8c78e51ac4bb1a6bd99ccd059f2346",
      "translation": "我啊，平时会给马雷族，送各种各样的货物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8d040a5c529bb32612d9d0e17e83b70f34e8f250105c93c2bebb1595889ac28",
      "source_sha256": "0b8a557fb8bc9e447ca0b0edce87edbee9ecd5fc352cdec883cf3ec1e7085712",
      "translation": "这次，也接了马雷族的订单，可在送货的路上，遇到了凶恶的北部军。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf5afb17f0d3798708bb79fa3ee7910099911563935882918ca662ae167c47cf",
      "source_sha256": "9933667676a9aa277fcfab6a6bdb359c6ce237d4f4693366e7f5ec59a7df1a4a",
      "translation": "那些家伙，威胁我，把货物全抢走了。您说，这像话吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee87186589fee338fc37a56fa5f4b5b84c23e61eedf341a242f2082984f73506",
      "source_sha256": "b6864a63287226432148329475fd554219176bface02a2629a9d3285849127d0",
      "translation": "请帮我把货物找回来。当然，会拿货物价值的10%，作为酬劳。啊，这是对捡到的东西，才这么说吗？嘻～呵！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14a7fba3964fe32282a7cd427d50608195807c2f5449c2bdbcb97e8293716fd2",
      "source_sha256": "0ae40f62ae504011414134e0ae2a45ad004ace63d08f835a12db552585212c8d",
      "translation": "嘻嘻！真是太感谢了。"
    },
    {
      "id": "coalesced:95cb37a8bf6006d193a8b600685d663e0c78de556b0e906acd77467076afefc8",
      "source_sha256": "22149e791df82c63b5139c6bcc1c50bf9f77ee6c3ad3dc6e2e5f83b7fa372afe",
      "translation": "那些家伙，正在南边扎营。我的货物，应该就在那里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0f0815964dd21bbcad13167389686a423e23f1e0f0f993bf0f6b0dec29460cb",
      "source_sha256": "22056ed9d8d4d4fd2f66b2b2cda43873f352878f9e03a74981e3af16ffe723b3",
      "translation": "我的货物！我的货物，可怎么办啊！！"
    },
    {
      "id": "coalesced:0a8b875c2390303a3569a86551d3408156051770e051ba818ae08c1a5f4cafde",
      "source_sha256": "22149e791df82c63b5139c6bcc1c50bf9f77ee6c3ad3dc6e2e5f83b7fa372afe",
      "translation": "那些家伙，正在南边扎营。我的货物，应该就在那里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e20916ea3ce76c30d2fbee60183f67ae833bf9ce8aede3a15def6c0b170b756",
      "source_sha256": "db592dd3a59e02c9c045197c5b9f533d9d525f11118bbb908d845ef254080659",
      "translation": "没错，没错，就是这些。这些就是我的货物。嘻嘻呵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ac477ee4b12b2bfd046950b25428023227559987c29dad30c4bb0c80f8b5571",
      "source_sha256": "d621a700b4e48b5398290dce730f8aeb9577f149a43a709627eb678d82e0c46f",
      "translation": "真是谢谢您，帮我找回来。接下来，得好好回敬那些家伙了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a6c913ff55e95e0e784ace908c0ecbb3fb6aac49bc298cd670eeaa29628cdb55",
      "source_sha256": "dca8b976e3e835437017814618db3dda8da6179ef87a007bca3020643be4b638",
      "translation": "从南边的[北部军营地]\\n找回流动商人被抢走的货物"
    },
    {
      "id": "coalesced:10828f9155e725c42c8078da9767c4da6071565f8b9f16012a90877c2c1288a5",
      "source_sha256": "c775c8c14bf752953119f33398037b2b37941088b99d2173b0f8e908317490a8",
      "translation": "QUEST%s: 获得被抢走的商品"
    },
    {
      "id": "coalesced:c8e9bced3ca1af83bf7ec408e015928d6970b6c59705bcde459a10a252494a53",
      "source_sha256": "440393e9203b14f6a3c267d7a765f923295c4e9ee41910d7e6d8c49be6042fe3",
      "translation": "被抢走的商品"
    },
    {
      "id": "coalesced:71740bdc76bd2b44ea535eae752dc6e266296ee8d00d88f5c3599339fa8ebc75",
      "source_sha256": "440393e9203b14f6a3c267d7a765f923295c4e9ee41910d7e6d8c49be6042fe3",
      "translation": "被抢走的商品"
    },
    {
      "id": "coalesced:94db622ca77277fe79525ed31bffb5367107b6c3240c8e9dba933be6622fe6f8",
      "source_sha256": "801201a0f35db656354786f340e647ce1a9cf781ef5a1762bfce7750fee7df5d",
      "translation": "我们阿维斯族，给酬劳可是很大方的～"
    },
    {
      "id": "coalesced:53e5ee3050f3aa904aff9bcd491ad599492f64486af6641a0671c874e8230768",
      "source_sha256": "630372e087c3d8f1409fbb21734d8683645b1e148b91a3bf6c9976b527a012f6",
      "translation": "该怎么报复他们呢……"
    },
    {
      "id": "coalesced:5fbba64ef8cf963919799895bb4dfcd5e69ccc6930120073d1acfba78077ac3c",
      "source_sha256": "6e7171add73f8af63eceb2f072db5c8d60366d8b580752e6e51859750a7c8290",
      "translation": "啊，对了，这片湿地，有很多毒蘑菇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c654afc40fd150a3573ef2964f067c9713d90a0716eac5237d70b9afa198bf3",
      "source_sha256": "5ce7a20846d1cd72b49c3b366d68997ac1460a7c9528da628b0fb5274317a26a",
      "translation": "名字叫[奇怪蘑菇]，您见过吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:85bdc807bd64abe8b03d257f8078adcf8bdabcfe7abf7364d773099126b35f06",
      "source_sha256": "3b103286113caf9a67dfa08026c71ba8d84e3060c525ad7aa73b534edae6e15b",
      "translation": "湿地各处，都有奇怪蘑菇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e95367342ef7b835eae8e2291fe213918e06cac47dfcb5ebdd6c9582f348cf3",
      "source_sha256": "05b4aa04d7774ec3f511157677d786df8359651c8982fd10ad22d7b1039a4bb6",
      "translation": "它们带着紫色，仔细找找，就能认出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:24a59ea04e8b6545b3e6683f02ac320219bb690c8355ae2913e5e5605089502e",
      "source_sha256": "1841c8f7c5145e6f8efe41077641f246d0505a580f1b0941e688dff2db3a34a0",
      "translation": "真是意料之外的回答，把我吓～～～了一大跳。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e29cd2dad62e9f8cc2be482deb7680267ece8e5d301d5a833b6a9d4c2625bf0",
      "source_sha256": "3b103286113caf9a67dfa08026c71ba8d84e3060c525ad7aa73b534edae6e15b",
      "translation": "湿地各处，都有奇怪蘑菇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a48201d07d8b2318f563da4fc37680fdc30f495539e1faf7a9d642181179ab2",
      "source_sha256": "05b4aa04d7774ec3f511157677d786df8359651c8982fd10ad22d7b1039a4bb6",
      "translation": "它们带着紫色，仔细找找，就能认出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7f6ec7efd9998df1de8d05a6a1e5f91987de55be851898fd0e182ba2d8c289f9",
      "source_sha256": "4be0e63c812b815e0b8e42f8f0793b0741dc64219db59fdd52fadcc758c5eb43",
      "translation": "嘻嘻呵——好，好，太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e15b5370071e6bb73e47fda1f8f541ecd0c2a57e8b5f7bc6251234583726e5db",
      "source_sha256": "91205abe33ca14b24837aecb134d572c29f66aad139a4e35b7320d49d590461a",
      "translation": "就用这些，报复那些家伙。嘻嘻呵——真让人期待。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2289e310ad976b64b0fdd38799b91592fdb3bc329ddb9dfa1a8bf1ab5cecd55e",
      "source_sha256": "d552eacdb0e104beb1e74778b13214e10517efe0878cb71d136ef0d23a20e250",
      "translation": "在水色湿地各处，采集4个野生的[奇怪蘑菇]\\n交给阿维斯商人"
    },
    {
      "id": "coalesced:58567b2203299f81af0a433bd8acdc07f40ff65ed09ee767d3fe06b486c9607d",
      "source_sha256": "37b5bb41fb17ef9a3de82c83fbb47cd0d17734dac4d8a6308f6f867562828e7b",
      "translation": "QUEST%s: 获得奇怪蘑菇 (%s / %s)"
    },
    {
      "id": "coalesced:504ebfdf02645e1e92084f00ebc3c1bf3ce5839bf2a8e8c31fdf4af2ac70049e",
      "source_sha256": "6bbdcd1e55be514f6d4931cd0e4ddcbf1a7066110022542d5c4a8a358ef32869",
      "translation": "以眼还眼"
    },
    {
      "id": "coalesced:fb8425873e37da1472f994ae166ff7ca7681415df926682c16f5402678648a21",
      "source_sha256": "bb326d09c497b06705569a5bc67b5c6fda54089c33e75013a178c8c551d312e1",
      "translation": "获得奇怪蘑菇"
    },
    {
      "id": "coalesced:98992e90d1bbe739af61578ac48abc3ad917b20430c226adad685f1c45809d7f",
      "source_sha256": "682fb72bb26892c399674a293940a1e49dc770091801e1d942c9c397bb0570de",
      "translation": "就用那些毒蘑菇吧。能帮我采4个来吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cce085a0baf85b24493acd2371791a012f8731990c41c5bdae5ce14e49fb2212",
      "source_sha256": "c84279de5888c94f972930ed792026c91b80fe0ab142ee5779306c719e894ad3",
      "translation": "嘻嘻呵——会有很有趣的事，发生哦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b54cf8beb70bfa9f4dd8fba808763ac328693a5fb4a5bee730f21924f5f94ad",
      "source_sha256": "6c29dd526e71efb5e2870c401067fc148d7303157dfeeb91e011fa34d773ccaa",
      "translation": "请帮我采4个来。"
    },
    {
      "id": "coalesced:f6724c3f48ac6a34b656c07055c7b3fa1548f34c85b51eb35705b4cda7201c8f",
      "source_sha256": "54b498718b6ed1e0a2f1bf3b1deb9a64d48545392282beefe74a4d2eab8bcb0b",
      "translation": "好了，做好了。请带上这个陷阱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87d4f07a83a828b617c153e932808d7d9099655b5eab3806a820983652b642b1",
      "source_sha256": "c740ee7f95acfe1712e2ebc2c0f052ce8284ddc215d7ffb095aae91662691775",
      "translation": "然后，把它放在北部军营地的营房入口。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4d772a1414646fc59899f047be7dd3a023e0e183980334d87e9b84254292d54",
      "source_sha256": "84b3879de0196994da00d3a4e5062def94828614799e1b08551cf2cf7d18c641",
      "translation": "这样，陷阱就会放出气体，好好折腾一下北部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:318632aac5260e245980190311e4c93d535a04860f0ab4d7ec55285ded788bae",
      "source_sha256": "55a6cdb48a16b837b1646ac6108988343540d903a8480b7a8cb28c0fa56245b7",
      "translation": "嘻嘻呵——很有趣吧？"
    },
    {
      "id": "coalesced:016bd22cce3f8ef81889bd0180e33b206572a2d954305852404ce6941d83a699",
      "source_sha256": "c9a0bf5705e6c823f193ee7a4991537ddec55b333aaf43cc0fd52055f9c9cb77",
      "translation": "都到这一步了，您在说什么呢。来，只要再做完这件事就好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc63edbde25d4f6130f307bbddcb9217b4486d50dba337bfd859e8f2ceff0efd",
      "source_sha256": "c105a053cb0a26d2d42aa316fbe3634c79d1e470722e2a3d7460cc6a85946e68",
      "translation": "不是说过，会好好酬谢您吗？"
    },
    {
      "id": "coalesced:c13409a1480578b3da57b46fd12ee4330060c6167ec71066b478f119032d3d51",
      "source_sha256": "f0a0d62a05bb71594f70d0d70c157e143ed50f0a2207af9d953b3a312de87652",
      "translation": "把这个陷阱，放在北部军营地的营房入口。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41538f8120557f20b934972e8780b19b6457152383ff78244856f7e595d9cac3",
      "source_sha256": "56fa1b4f4cad7f02a8d508f611b017412ca8c7b3baac0fe8ffe60c190ed7bb65",
      "translation": "嗯！？外面，好像有什么动静！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a557a70f9dd49e8f15576acfef9283161c45a55c0d8a0170dd0ab142f15ce1a",
      "source_sha256": "94f5bf1ce77219e24dbe697cecd2f70216289005eb467809b1b84837430a839f",
      "translation": "难道是入侵者！？抓住他们——！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ebce2e20b1e8fded23bff806b5daa952ae057eab9c79aee42d1377112ac2a035",
      "source_sha256": "fe2349c215251a7b37651fe8120be904181d1313f08ca00c4dfef323f9247f85",
      "translation": "嘻嘻呵——怎么样？"
    },
    {
      "id": "coalesced:bc128be4ff7656b005fc67ae10aa4861c8d5187c6dba5f711f6d8770a7142212",
      "source_sha256": "f868114f42935673e0db99aa38645f2bbf6a9f95b5f1d0544e5ddb51d7af0a52",
      "translation": "应该相当好看吧，可惜，我没能亲眼看到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a20e0e96ffe4458cb59d89e4a5cce280d096895c558f4ca6093bb15f465dab3",
      "source_sha256": "da5c05ef3e5edccc38b7e2fc60c0184ac5a0c91048f80449a186770f594fa332",
      "translation": "在北部军营地，放置阿维斯商人交给你的\\n[气体陷阱]"
    },
    {
      "id": "coalesced:57a34d56543a0eac95eec1eb5293ef5d6a7717f79dec53939fd7d0e3e805f0ab",
      "source_sha256": "8c83f03688b76bcce8250b374bf69ac520f820ff0f23c75820b6350b5cb6bc4b",
      "translation": "QUEST%s: 陷阱放置完成"
    },
    {
      "id": "coalesced:b15d392e318fb4c90d76a3df1642c5afa4556cd03f992159f272cfcccd1d28a1",
      "source_sha256": "ac7f4800fbbbe840566df5e92ed0c682d96b81d197ea379dc24c643c8bde8b7b",
      "translation": "以牙还牙"
    },
    {
      "id": "coalesced:103aca632bce8a998496aa11470d0e335f8acedbf95e20e13090c8e5d071b634",
      "source_sha256": "cc53b667c64ed2fc0112bf89505b95a75557aeaf66383741ef4657ead8b54b88",
      "translation": "谢谢您，帮我找回货物。能再拜托一件事吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a2c6292ff5514d3fc38d6c8f3347a18d6233b0379338acd2225686560544ecd4",
      "source_sha256": "1ae95fbe0124c8be520e2aeb8859dea3c1f5c97774274ecd896a9cb1c53e556c",
      "translation": "刚才也说过，这些货物，是要送去柯塔马雷的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e102a2de5ccb4954ff92e4985c6d92e24de3c0cab7ce0e00b3b88859782a31a8",
      "source_sha256": "f8c558165f967b2f05ad7393f9afe9be1936f3221eab0475d3e3ede976636362",
      "translation": "可是，现在马车坏了，暂时没法过去。真是遗憾。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a72e7a2a513ec68bb86a285de3b05d115925edb1c3e5632eb87295e00dae5a9b",
      "source_sha256": "69c84d714be1b190c87013c942ae680a4b13ac44616f7aaf4daf9e4de2715976",
      "translation": "所以，想拜托您，把这些货物，送给柯塔马雷的收货人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a837d71fb9d0248bc6e9cc67bb41fc4bf16b47419a6f47f0ee1450337bcd8c4d",
      "source_sha256": "13d56587aac17aed69b531a0d7c5c649956d77406cad7bbd53a77aaca1f5322b",
      "translation": "可以吗？"
    },
    {
      "id": "coalesced:6f8f0bf47ac2b2947182b601a978ff38ea08f71e63e5cbdc104fc7ef04e88c0b",
      "source_sha256": "293bc17327fbba10b437af79ca5a1f69c27d8c25e34f2dfbf920506df07540fd",
      "translation": "做生意，最重要的就是信用。"
    },
    {
      "id": "coalesced:6e451588aaad84b8d25278343ae6678ebd407acaf76ade71d4eef999ed43d4bd",
      "source_sha256": "1bf65b501991d8a0ec6a71cd84d3e3e9a29d81d6287aaba223c6cc4ea981aaab",
      "translation": "您帮我守住了信用，我都不知道，该怎么感谢您了。嘻嘻呵——",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cafafcead9e93774b7b58854b46067c1175f7f772362baea5c50cb308a4c3c2e",
      "source_sha256": "9cf0102c79f4bcfb8a795674a3243292d25493fdfb74b872e4e85a7e2a68f8ac",
      "translation": "柯塔马雷，就在这里的南边。"
    },
    {
      "id": "coalesced:57d98181fa186a83dd166f00c8c2d93164b68db155b03bfee5804d5b83e4168d",
      "source_sha256": "666ede663f8745e8d632182c8952eae75967f19d1953cee20b31f98a15bd6262",
      "translation": "那也没办法了。就算，信用扫地……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3b73c751f7863fee9af99e3d9af6f17efd97a9311259b5be10dfb84006451ec8",
      "source_sha256": "9cf0102c79f4bcfb8a795674a3243292d25493fdfb74b872e4e85a7e2a68f8ac",
      "translation": "柯塔马雷，就在这里的南边。"
    },
    {
      "id": "coalesced:bd054278ed6e0ffe839f6f2ea91397b636d58ad0f7c2eca926bfe235f936f6cf",
      "source_sha256": "a8b0dd8eb9e69a3ef771518198b43ba715eab4376c11db54f533b02f57f2dc4f",
      "translation": "哎呀，终于来了。"
    },
    {
      "id": "coalesced:96cb33566b11aad87e1ec62b44812aabfa3ca3d301ac3beaa5bb84cd402b4deb",
      "source_sha256": "9b61151cbee3262f1c7728fc3da12147e7e2cb788b78f664ce93a946abe281ef",
      "translation": "不过，您不是平时来的那位。怎么会是人类，代替阿维斯……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce65490c379cff9bc6e13e8aca39504bd8748a6254c6f093645f12fbe4fdb8ac",
      "source_sha256": "d4793eb84248a9f654add1f299a48ee49add68f2590b10895110028393c03b7d",
      "translation": "啊，是遭遇了意外啊……哎呀……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87dba12884d1d50548feadadd1b49cb1e217fff77446f153678cd3f541e94e79",
      "source_sha256": "e5afcb00e9d14b323db9391f681549f86fba72c5e9b23979818b22f2b15a4b43",
      "translation": "谢谢您，代他送过来。请替我，向他问好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43502cf60888055c2d5ed9a96b067c9c613dbc0b64331228d9eebffa13b29bf9",
      "source_sha256": "0b223843ddc8fc2130f333f310c73579ca1f4d80000ce1033b25660384dc2cd8",
      "translation": "将阿维斯交给你的货物，\\n送给柯塔马雷的[内斯汀]"
    },
    {
      "id": "coalesced:a1aa84c6eaf1b4c113f0476d6edfdf6aa617dc7fad01d1181984ca4163a34bfa",
      "source_sha256": "289d82194851db7cfc0a25efb26175534bf7642a7a9d845942d3e9bc79cf8c52",
      "translation": "送往柯塔马雷"
    },
    {
      "id": "coalesced:ec410411c0f2faeb74578ac3d78b64c72f0dba44ece09db53f397c15b62261f1",
      "source_sha256": "d5a275a2ad19622c6848647ee74ed1f6fd51d7f647317c2b1c3597357374e346",
      "translation": "阿维斯商人"
    },
    {
      "id": "coalesced:999ecde986ca3feb6391ef195b9f063684750525c8d8e9d3ef1afde63d75504e",
      "source_sha256": "20cb847386fa7e97653a55f09d037409a053f459af65b9a219bf412ccaffb8da",
      "translation": "琼斯蒂"
    },
    {
      "id": "coalesced:275a981aa4cce04c552598c1e1a648cd1fa1c3fd44f6a56c644b970c98f194d9",
      "source_sha256": "bfdb1bf31c6b1fcc1914069b3f1aca8e56d2ddc7a8ccbdac4e9fcabe6f1c107a",
      "translation": "气体陷阱"
    },
    {
      "id": "coalesced:6d82f38bcf74a86494faeba87327ccda8b8186dc5bcd90b255edfe8a95c21335",
      "source_sha256": "2614f16334544fca881f67718d2858c7f44db8a8d9b0867ecb85a5ba71b5ce8f",
      "translation": "会喷出强烈恶臭的阿维斯制陷阱"
    },
    {
      "id": "coalesced:70538e2a7505c351882f0a17f624aa2c683301337a3c73ebceb4379c5b9bbbbb",
      "source_sha256": "36ef1d49214d05823fc2b811c35515086b52ffd51d77f2fd487058b1fdd14a06",
      "translation": "被抢走的商品 "
    },
    {
      "id": "coalesced:4ebe0f5bd4cf102342e2dd8a63f7a56ff61e3634091e2ac650b574df7803a019",
      "source_sha256": "d772889361e40c76e9add013f1762e3f3f5e9bad85547c673884add8a9c1ace1",
      "translation": "阿维斯商人被北部军抢走的货物"
    },
    {
      "id": "coalesced:bc32544b3f1ce46a35ecabb5d05650544ee9b8424fe9c69ddfdff9505de9b66e",
      "source_sha256": "9763dfc8285028ce515a279e952b084aaffa27aee033e14d1ba258ce60473a22",
      "translation": "营地箱子的钥匙 "
    },
    {
      "id": "coalesced:b24393036a2672cb27bafd65e4959ce809b27b0aea571be743280952984bd129",
      "source_sha256": "d7d8c79677252fcbd2f0c3cf22c932e272f8da58f31a92ed1560234a33223cf9",
      "translation": "能打开存放阿维斯商人被抢货物的箱子的钥匙"
    }
  ]
}
