{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:e7eff4658227ef3637ff04ac69bdbda4a6b79cb597f2fff733a96829baa1aae9",
      "source_sha256": "86cd66e5a03e2e93e0d20b53fa0f751a281c7fdd5dd86868e11a99085410d83c",
      "translation": "公主殿下……原来您在这里。"
    },
    {
      "id": "coalesced:f6c7ffa013bb71552f8bc4963c38d55f54169cc2b202601f76502fc12518bf5c",
      "source_sha256": "a6fcb6fc3e9bc36b737a89214bfee6f16fcf9692264afbd34a73395365a9e7c3",
      "translation": "嗯……久违地回到这里，总觉得想起了从前。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fed080c5d3f5f721b6c63fd50ecf4086bb1e9d3ae737cbeb34ee1b86d1bef3d",
      "source_sha256": "a198bbec57a94f68323fab8f0560174f9388800e6e86d919a4c6fed43c2531bb",
      "translation": "那个……真的，非常感谢您。"
    },
    {
      "id": "coalesced:2ec1cd03063a8a60f56a03b7efbbd5a6c77cff9e2c0e2505f760303d3e29675d",
      "source_sha256": "e612f24f0678e3d73013ee6b197ac0eee5ab0958d2c745d5b9809eba91063cef",
      "translation": "不……这是我本来就该做的。"
    },
    {
      "id": "coalesced:32e048d4d08bd21d6f1c65844da591a8aaa217c60d8df01eca32234896875db3",
      "source_sha256": "416d5d8b93b5076f3420a55a8eea439a25a67dd96965a260c1b4461a2a931308",
      "translation": "我一直相信，您总有一天会救回岛屿……您真的遵守了约定。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e99c91c4051caa5b785a158d43d32cfc0fd62d393777cb4790d54d42f9d68ba",
      "source_sha256": "116d3f1ad146057310de0000bfbfd4b755f4b99f87480fa09c10607f9747b7f8",
      "translation": "来得太晚了吧……对不起。"
    },
    {
      "id": "coalesced:2708aba4a40e27f680d1e6bb221bbe2b7f7b2d4a11aab341f4384088262a6c06",
      "source_sha256": "94f2fcfe4962ce3025053dde69797ebd7e24131a8a1b22dacdfa4e53f7ea829c",
      "translation": "没有的事。现在能这样回来，就已经足够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:64b494cc08569ffc0b3ab3c256e093fe411b9cc82272a386ccf5e23bfb7b5f9f",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:6ff3e58684b0362032d7e0097a69571b1ffdc3231911bcd2e90c46f2babcf57d",
      "source_sha256": "eb0fc5a2469d1a7755a26b512a50244e7efbab8d5f0cbc7d0e8927aa861de1ec",
      "translation": "最近，您的脸色似乎不太好。是不是……出了什么事？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16db9ade85421c0327c79fe2b49b3b3657df2732dc1994204d54d3f2855d138e",
      "source_sha256": "d2ca3bf212d96805fb9fc95ad49a8f36d0b3ca58e379495cb4cd01845154fb2c",
      "translation": "其实……我有件事想拜托你。"
    },
    {
      "id": "coalesced:e4fbb1ff77618cdcb090367b458d3681a987c424c6d49ece3f8199aca25a089e",
      "source_sha256": "ed9813edb7dce9b8f77520ab3c7d9e006c840e39056346e498f141189ca1793a",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:98b33fedb6fe6860e1f0fcb2227f08204534fb57241dc8645c32abf7c8b9d78b",
      "source_sha256": "da4140bb9b5052bdc1015758bd5f6ecf3612412ad00f8d512aee4375d9f4932c",
      "translation": "朱特……我希望你从今天起，退出反哨兵部队。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52424b83b20cde4690c9eaf18587514d6c9fa7e57dc02f457e28711e48df4fe1",
      "source_sha256": "e1c0d02c5cc63cac735079a4ab8f7b37947d5623d9be354628f45e170f8454b2",
      "translation": "您这是什么意思？"
    },
    {
      "id": "coalesced:ed443168358653a848f6948168364637174848ce2f3ef936314c273ab25e4688",
      "source_sha256": "53827eb76a70b0d46cb469ef93775fb1cb84e6c2071737dfb52b43337fd972a6",
      "translation": "今后，为了岛屿的安全，我会派遣南部军驻守。所以，你也留下来，为岛屿的防卫和重建出力吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6050dd297e904b793fa4681a4d142dd225bdc68ff765955ea22f2982b97e6047",
      "source_sha256": "75d67ba565bd498a629207385fcf21a5228f956955e0bc0d874923be9538b305",
      "translation": "这里是你的故乡，交给你的话，我就能放心了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a462d249bcbea658f5b39e0cf2c3caca63c525558e8b18caf0659b5d88078ee",
      "source_sha256": "a86438909dedbfb4c8bae98d7d28b748ca9bf8d6f86551f0ee97035cdb73f07b",
      "translation": "您要我……留在风息岛？可是，梅莉莎她……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e56a55d8cd36d391d6f5f96781790be2a8a4454fa7fe835b0dc6d9f705441964",
      "source_sha256": "7f15cdc0ebfcfa0228c59b082fdabb5ac263382e1a76c0923895a4d69a442750",
      "translation": "你能和梅莉莎战斗吗？"
    },
    {
      "id": "coalesced:c91e634d569adc843960ddceae686288195a2f306320dbaf4d9ecc5df659b5a0",
      "source_sha256": "668b2799ff1d55562ac1459fc88a7d8ea056f9d9c1adf6e4763f615eb373099a",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:a2801dba957e95d190875e30a4b6bbd971d2621bfafafa0ab9b0d7faf11e4a1c",
      "source_sha256": "a44e4aae0b9093a22b6f8f0646f7658f46a7e29b3f48deae6330dc8b48ed6404",
      "translation": "只要梅莉莎还是北部军的一员，总有一天，你们必须以命相搏。到时候，你能毫不犹豫地挥剑斩向她吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e9f8bec04f2d15a65b15a0c9bba026e017cd93fc93742012790b6fe5f7bedf0b",
      "source_sha256": "b47e1196b736feb11d70c6284ad7102a61319bfa1356a7f58198c7b49e8c97a0",
      "translation": "所以……"
    },
    {
      "id": "coalesced:15aefa883e6019aca197c2e50d12f3cb435101159c1df978dfb9f10d1d48ef59",
      "source_sha256": "d666e11971b2d7cd87f91d771ce65aceefe3f7c17974f613bcd33701560b89ed",
      "translation": "为了避免这种事，您现在就要我退出吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e794d42596b68f2eb8cd372b7f139da8bdf9af610587c396efaea1dbe3b51b9",
      "source_sha256": "f9746d08863efb5e2ecd4e201d3907c29d4c274aefd2fdb7c5efb203627f1299",
      "translation": "我想，这对你也是最好的选择。我本想尽力帮你，但看来，这已经是我的极限了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83ce7dbf75ef45d2be0922e4148459897df6a63975a503b5cf1a4ab8b6b7aeb6",
      "source_sha256": "ed5f85178792c306d249e8066be9cc422951ab92b898a1a2f5f28038786815a5",
      "translation": "为什么……"
    },
    {
      "id": "coalesced:bbc6cb1fd55f14a457b65fdef28ea6e2a1a235b534daa9d49759698758d7c356",
      "source_sha256": "c4c3f2249c8925ba5ae2adc14c85a4b12f698de248a5aafa936058d73a47d01c",
      "translation": "你那时候问过我吧？是不是自愿嫁给亚历克斯的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4df7c77a15b8e95071bfdc622737aac706453d9ef48c80471e23a76e4c4b567",
      "source_sha256": "9a87b090eabdf32d4005994ecf01e24dce006bdde6154d0c9ec433528408cf5f",
      "translation": "当然不是。只是，我需要拯救兰兹海姆的力量。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e29cb64643066aba7ea7869965eabca2b6990d71ece3a05b1a74b2e28e13a9ed",
      "source_sha256": "0bd5f5902b33875a397fc61fc17e0410d02759585d22a5086b51169711847514",
      "translation": "所以，为了和亚历克斯联手，我答应了嫁给他。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74d56791a5070f223afba4187ce4219d8cf1719eea6ffda1bc5361e870f1097b",
      "source_sha256": "dabe4a9f5b725f5b3c143cb50eeae52f084f075e860f740187a8872824d00ec5",
      "translation": "即使身为公主，我也没有任何力量。实权掌握在总司令部手里，我不过是个傀儡。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c9f1c432797eadd68ba5d6cb6a9b9b9ca5f30d038c5db471d5fae906e22aff6",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:5981a1f3996049001a1795e959517512c3e87f274cf2c38930374a54b679c4fd",
      "source_sha256": "1f7f215bdd5a01290eb33fa362b7035de65453b2d589087989b1e6c0e633bab9",
      "translation": "如果南部军决定讨伐梅莉莎，我就救不了她。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1253c8d633c15eedc8e36a2a15a07c7fe4f7bdaf74b9ff6cf5174da0423e9772",
      "source_sha256": "032291436d6cf13d6f7775e2741ba410d73f2a656a2a8d5697012039dcc75835",
      "translation": "到时候，我一定会命令你杀死梅莉莎。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c76b8b9222ebc5682843f4bc3ad74c8dc23602b9d4d4f4e584742c077e22bf75",
      "source_sha256": "d98f37c410f9855f9088cdde185cba42278051fe2bd341f1423dd5e61595217f",
      "translation": "公主殿下……"
    },
    {
      "id": "coalesced:b3d700d44cc8be5c5080a3bb440ee202a609870fb66019ad39ebe879c3880ff7",
      "source_sha256": "368fdb3571e723150d0ef86e089441295cd826c76384d2b2fd87a9eaeb691f83",
      "translation": "可是，我不想那么做。所以，求你留在岛上吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9726186e90ba65c377a9055611807bc5272dd10353eba20ff1f2a4ddf6b47465",
      "source_sha256": "41e190373e585a63e36906435528d7d398475c04e7f35c90851725d08305ffd0",
      "translation": "这段时间……谢谢你和我们并肩作战。不过，你已经没有继续战斗的理由了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eaad8e7c260289e1f17f8afbf43b15cf675a8dc32c3ff0abf8464eddb56a4cc1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:1f8a0c7b964866fe19725323f6afc8742c57a61cf512781aaca5fd3b3cba8686",
      "source_sha256": "543b5163c61b92ff32213da7761759460085152664682bef2aed36e5883eefe6",
      "translation": "说得太久了……"
    },
    {
      "id": "coalesced:7b26999865a27f0ca7786def282ff5517c4a99ffce5c583fb71893779f0bb070",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:26bc8dfb3bb3d861fa34266609e26cc1f1fd398e66c5fea5c74063602da8544c",
      "source_sha256": "3121d40de67baf779e058431d6e435bcfbaa792d9ee848ebc5b2f5e4d9f56d24",
      "translation": "我们……回去吧。"
    },
    {
      "id": "coalesced:c0aa98c6beb0e2c9adf9cdfb85fd1b71996a417a3d3ecbe8fecc1048684487d7",
      "source_sha256": "42eac6b985a55e90327b1c0390da972d0e9b59961e31d3c074c2d2d15b82044f",
      "translation": "傀儡人偶。听到洁菲这样形容自己，我难过得一句话也说不出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3728964137cde4efc4c39585a012fd0ac462c7cad8d14cd57d5ac26af600db65",
      "source_sha256": "22a3a5d77d8c85168633216883aa8d7732585fbced261a921990d1065892462a",
      "translation": "洁菲究竟有多么辛苦、多么痛苦……我竟然一点也不知道。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d123e8a99b61ebe826f0efc37a83fca4b6b19d0e9bc98820799469d9f98f1704",
      "source_sha256": "026ab0570ea77b06f0b665067b3383c890558428ff30ac2523ac493e8136ad84",
      "translation": "这里虽然简陋，不知公主殿下休息得可好？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0adf97ad27ba279ee3390af6b7d03b0430efa2b9d1c2e0b3e0604fe6df4e0634",
      "source_sha256": "c1dd340e426f4d65db836c2621cc6cfb14c21a7a19203e70e587e7dbbe7d86a4",
      "translation": "很好。我已经很久没能这样安心休息了。"
    },
    {
      "id": "coalesced:fed085370c39b779553cb3ca124d98b57ec4496bd0221afbdd808b2db2cf5670",
      "source_sha256": "623d4d2b704c7855878f18dc8f7d362a6dde5565ffbe7bd33329e2fa02d8a8f3",
      "translation": "咦，朱特，你的脸色怎么这么差？好像一整晚没睡啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6765dba1ef5c754b03622b33b2095b86c24a862b59ae317675df8be9e46f06d3",
      "source_sha256": "924d1ee5593ae2074f125d9c4264df443e710af19da4634a8447ee9f8f1f4001",
      "translation": "啊，大概是太久没回岛上了……有点睡不着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e355facb7f97ab0cc13210a275ef7de020ff413be23ffa6af710b3203b314823",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:6da17ea373d221b40c7913d51e35c3fe3bab1cbbeb8a12837aa1e6a86cdf7aeb",
      "source_sha256": "7ba52566bc818c8864df65ad6e45b1cbc1da84a6bd35f4eb34f10693d6498e3a",
      "translation": "也是，确实很久了。"
    },
    {
      "id": "coalesced:f9533ab7e400da27a42d630b7b5992cd5046e45d692370813cfd47e815800759",
      "source_sha256": "c4f1eb3fe2ba7e3066764daa6dc9b1b130d87b0f2e8f067133f6d6ef7da0cb3f",
      "translation": "你竟然成了这样可靠的战士，重新回到这里……简直像做梦一样。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b289ff2ab2b502c7d9f0a3ff102fe0e45e9d4f477be610ce1d5b9c39348ad9b0",
      "source_sha256": "0a67de240a67286c33066f92c76faef565ef817e5d7c36779d242d39de60cf3f",
      "translation": "爷爷……"
    },
    {
      "id": "coalesced:48503af3ab6dafd746469db834be55a93b7b3c7a5f4a97be5d646bb1fd6d822a",
      "source_sha256": "3e690346750a902859bc2dd46a987e31b7ee65d1757fb417f1e505ac64a27d8d",
      "translation": "总之，几经波折，总算夺回了岛屿。今后，我打算努力重建这里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8306689d3fd494f2b4131c03e06adf6f4672b7c132bebae7be57d6ee3e825c3",
      "source_sha256": "c3f1114b8a3880c25717866ad93ee76ac500df9fcac43ae647fecb2e33a3b46f",
      "translation": "嗯，我也会帮您的。"
    },
    {
      "id": "coalesced:a178a880859065613664d4398bf10218a17df908f1da760cebf3b73abdd57d5c",
      "source_sha256": "c6be17a13d3d5f72d7ea1af0294f8225a3c859595d5b320c7aba1f33da7c0ef3",
      "translation": "你能这么说，我很高兴。其实……我正好有件事想拜托你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e5b08739974af69811362b0b9245b1cad85c3e7f0aeefc576683259419ca871",
      "source_sha256": "ed9813edb7dce9b8f77520ab3c7d9e006c840e39056346e498f141189ca1793a",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:1105402545c5f8201d93a098f368dc01ec59bb240217e3fd632544eb6bd07437",
      "source_sha256": "c9ee9f6358f5a074428ce937c1c27c4af703f3db0a68a425b6ebdc89b91e4190",
      "translation": "交给你做，虽然有些过意不去，但这件事也很难拜托村民们。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4bdc45cda07a9f22eeb1a6fa8b0758266067a0e20c42143cd6589f670523801f",
      "source_sha256": "a5068e93361c6a5670bd77bfed20ada77ac38f0181931ec56ef773ec453266f4",
      "translation": "是什么事呢？"
    },
    {
      "id": "coalesced:d283a80e26000734803eaa2d4d6e216a9abd49d249033f6ab02af27565479682",
      "source_sha256": "6c38c59236c72efa0f6953b6f87fafd008a96542b9e193543be0d6a021117a21",
      "translation": "那个……您还记得风歌洞窟吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8c284f5d1b3ba393ebbb63d02c9058b8e6d08b7ac943e16b5cde8e1169d91db",
      "source_sha256": "712744251d875d65a60d88d38b6bcaaa0e2c6214c188f4acd06d228b6c855483",
      "translation": "记得。就是发现守护者的那个洞窟吧？"
    },
    {
      "id": "coalesced:6e7024b733c0369535ce929a9d34b2295126b03166cbb42bac288e3f7befcd7a",
      "source_sha256": "a773b68da133abb1f98675aa259ce7b6f019bd02f9eb54b961386e77e247c34e",
      "translation": "北部军驻扎在这座岛上的时候，似乎在那个洞窟里做过什么古怪的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e9daca317f54443700fc569ff26262f7e00bf39061666fc27cacec63406ecf95",
      "source_sha256": "a882781c30b28da57f361ccc26872018cb21d94508035f96e322b105a8769a28",
      "translation": "北部军……？"
    },
    {
      "id": "coalesced:bfc9cebef7e957d8805fc72e698ce5fc2f8e09302470995d44a58d7f2eb11bfb",
      "source_sha256": "3663ffd2cdd570cda40a7b06361e1219f23efb18e10ea9ff9c85c6b544210d60",
      "translation": "有好些村民被带进了洞窟，再也没有回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a389541e1ef0006b8fea4854de623486a949dc8d063e64afa2d0f69a8b309c42",
      "source_sha256": "07e4029407f666ffc632afd7c7a088badd049a6e9308d9d9ca59def7d0fc5c72",
      "translation": "没有回来？"
    },
    {
      "id": "coalesced:3466dd34ddf5ae5dacdc75f7bfffbf0d30ece06cb9dfbcc96473292298a6cddf",
      "source_sha256": "24412ac0c8b2373ae7412515dd65974d675d3c6773629031261690fd70985604",
      "translation": "是啊。虽说不知道洞里发生了什么，但如今……恐怕已经不在人世了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41c36e9aa19eab6c61e52cc937f3254608c1dbc700924e145d4bbcdc30357854",
      "source_sha256": "85c48d3017acdd20cfb761a0c960f11e81d9317899a8c362ca08b357c7d03783",
      "translation": "所以，我想至少收回他们的遗物，可大家都害怕进入洞窟后会出事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f310dcde954bd9dccee61ea11cc40214ecb6a56e1a496b0ce85f03d183e291df",
      "source_sha256": "496c2286c4b94750d17c3c105d2c436c8775319fb2555945e93351d82ed804e0",
      "translation": "我明白了。我去吧。"
    },
    {
      "id": "coalesced:f7d33084d78d2894c997dde3d8ccbda125b0b2ccea8f0654562394879a94cf78",
      "source_sha256": "4f31e781bc15ec15cc3d0a5d24c857a3855f4d7509add5b75dc46179d0b5cecf",
      "translation": "对不起啊……"
    },
    {
      "id": "coalesced:2bc79a42c1ee88c8e0bc62fe35ca35045b67c6be91dc4453f85cbd9c7fd30b20",
      "source_sha256": "75cc69bcbf086d5211b05b064cf1a991535cfb661088538c62087327b0526fa4",
      "translation": "没关系，爷爷。我已经和从前不一样了。这点事算不了什么。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1514ae26ce5f3141f8afd5773c0e1fea93382ceba2c13626635df27ff7b7a5a1",
      "source_sha256": "1e0fffc9c53639155ff98061ec562876413702ebb988a5f8cea53d3fbbe4d200",
      "translation": "我也去。"
    },
    {
      "id": "coalesced:4a710f0759460cb1b0939214995c8bafeae4704820a09b5ba82507dd9ef0c29d",
      "source_sha256": "13e7146f03fb4fcb86474b89d533c9919fa83d6739575a755c1017beff4437dd",
      "translation": "啊？那个，公主殿下还是……"
    },
    {
      "id": "coalesced:d80f1bbdac3b2500c4ca7f74dc5d301d68c061038f502dbfee79688c2414e539",
      "source_sha256": "6617a3e4a16094bcc789677c6c8c72f7d4c49c55a27ba9b90682aaabcede1094",
      "translation": "岛屿变成这样，我们军队负有很大责任。虽然谈不上赎罪，但我也想尽一点力。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e68c52c479f84caeb88f1e8f30939ce44a0a9453ba04719242182f2f161109a4",
      "source_sha256": "ff35a2da3b026f6dcccc5c8200ce307ee4b63651f260b46efaa46eec664c1f84",
      "translation": "您能这么说……我真是感激不尽。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:077a4c8fdd1f488be0c3b13a5163d2ec750d277b36bad0f628a0401f9a0e2f67",
      "source_sha256": "dfcde837a811a790ad51e7a671a51016ddfdd5264b193ee935984dfd65f10e4b",
      "translation": "……其实，公主殿下不必亲自去的。"
    },
    {
      "id": "coalesced:ed6088d2a390b147acd4bace7b3f1dabba7c8f31fdb30d198b8849b14f4d2263",
      "source_sha256": "c3f158962c21bb0b1a0abf75cb83be30e78f6aecb71bf191add85050150f510b",
      "translation": "不，让我去吧。"
    },
    {
      "id": "coalesced:a9f16d7b9379721bac8a19109c138914d397de2ec798464febedbb06eb713c09",
      "source_sha256": "e298cab6fbeec8de4c2a9ee4ee7b2c1b5453157c3e415d10257449b6510bd2f0",
      "translation": "……我明白了。"
    },
    {
      "id": "coalesced:7986fe7db395a41282e2163b3d4ca5fe53a65eb6114a9e6a854a64e806fa55bf",
      "source_sha256": "ce0cad86a8c4e75b98c5eb908434558eaeea6d5a121e8f2f90d36d8585888f1b",
      "translation": "露，我有话对你说。"
    },
    {
      "id": "coalesced:8b44fb929553f981805dc640e0063387ebc5bd40bb69b9c2edeca22a33af82f6",
      "source_sha256": "500f3345422c1267dc7a6c8dcc6d9763ce0cbba60d5b29f94646c85ad323d107",
      "translation": "什么事，公主殿下？"
    },
    {
      "id": "coalesced:67a20cd25e99a2e79ef6b71688b53eb15618305fb9e431a07a3ee81754a6f418",
      "source_sha256": "5c6aad9710cc35ce122ae46a5cdd5a94efa72fba869c81d2b8df77b9eeadef14",
      "translation": "既然如此，我也一起去。毕竟，不知道洞里会发生什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:093cd794e9ad7c643fb6a344e31afae50f46504fada044c4b1d8fd4e024b0255",
      "source_sha256": "cc4296fd58342e7afc07629c07628ff7e6f876eafff45e79fd3ff2b2c6e3bc7a",
      "translation": "北部军那帮家伙……竟然抓走无辜的村民，制造哨兵……！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:394ab713bc052d140efa8010804b19aaf96657dca9eca008b9cd6298510a0a67",
      "source_sha256": "8f9644c1e57e52e8999f718d66de0719c41e6775501a3e754e702bee0ff8fbd4",
      "translation": "怎么能做出这种事……！"
    },
    {
      "id": "coalesced:60ce3e2a6a0157b5bdd40a1c4ed3232d5f1d555126abef6dd83bfb098d65b466",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b33483c765a38c93e65186e25b19ebaa28d4ff7d4a8f5989ca7dfc2f57603d35",
      "source_sha256": "e6a3e3ab583159cbfa13e8bff4546804e7b491eee8ad2a8b85e12e81f1590a13",
      "translation": "可恶……竟然做出这么残忍的事……我绝对不会原谅他们！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3229d1ca4bf6fbb7e38673be75c85e866314fb7aa3f819904007941a0f4f532",
      "source_sha256": "cf4f31c40e21a246e733912017b40f1dc2d6566db2947cb711b214e891b594d9",
      "translation": "请冷静。这里似乎还有我们以外的什么东西。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e2cc37095f7b6897f39d9e2c80da0fa489b45b0c79ddeca756e42d03b80da7e",
      "source_sha256": "38511a474975b12954200797eb3c29a84c2187d1a2004cf72c32ae2dd9009a9c",
      "translation": "南部军终于来了！！"
    },
    {
      "id": "coalesced:129a9a8da1f79e243368f1854b5a30cf746f0f615a0a035b5e964a83d61ed5d3",
      "source_sha256": "70e75a7ff49240fb30baaf50f18b203920462395b95b141f244e56021ebcd735",
      "translation": "为了等到这一天，我们一直在海边伺机而动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:caa8235f02d6c48dbff37f3f2fc935b3751343eb90d476ea2ff4ecfdcfa26d94",
      "source_sha256": "f1ad1d98cf8f8a99cde28fc0b0011089ee2f4e4d55f351f45fc18ae811a3005a",
      "translation": "我们也想突袭北部军那帮家伙，可海岸上部署了死亡弩炮，连靠近都很困难。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:340ebb02697c3801cb9c41db2618906b47f84fc8194d3e86292713b81c5a91b4",
      "source_sha256": "58671b5e2822f2e9a51e0537bba1180543c218d4ab128ec5877f8c25b328f4a3",
      "translation": "朱特！你还活着啊！真是太好了，太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7f1e6d5121d758896ebd94383341e2f57fff805410d259b845393bc9e570d560",
      "source_sha256": "7153805800d9bb267424c8277d57c66cc1e2bc0bde2ceca9e1fb40512252a97d",
      "translation": "那场战斗之后，我们逃了出来，一直在等待机会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b48422cad06e28d255c8afa4618ec902992f76a844ad24bea8794bdee331e19",
      "source_sha256": "809e8ce312eed801914c841e9a4caf9ae83b19b8f6940e7774489f5a78d6742b",
      "translation": "可是，守在这里的敌将杰巴萨实在太强了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d6e764fc46a15abda2a671a913c1b3c027a62b452d4cc464e3c67484e6eb6b81",
      "source_sha256": "ab4071ffa1ea73de8a5bd4e1c2e23c93cd21c8352c8dd4eb36489e31fe81da10",
      "translation": "凭我们的力量，根本不是他的对手。"
    },
    {
      "id": "coalesced:b87315cc6c282566a005abfedd64f2aa9ebcdd270ae22dd7e5fec9cb5a1659b6",
      "source_sha256": "5da3e811236317077c7461226e684784e51e4d58e973090ca56c87b70264664e",
      "translation": "要是梅莉莎在，这点北部军，她一定能全部解决掉……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c2b6495e82a323928b82d9edf8545b050aaf5b9c9f0b86598eb7629628c891b6",
      "source_sha256": "25cc37c181d5091856f2b3e360634dcfe098ef0cac1dfe3165cf0bc1ee922465",
      "translation": "村民们的遗物，就拜托你了。"
    },
    {
      "id": "coalesced:3c778930c8fddd2b33478b09aea5b2884b84b38e2886dec6394a0cf979e271a9",
      "source_sha256": "26f3fd23bfd8c0e743007c5ca90a7a218bbae1a7bec24d35344a1d1c1d9b5914",
      "translation": "其他人知道了，会伤心的。悄悄去，悄悄回来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d583d51958152f9905b784326d701a0faa8ca2c665e1abf5673019b7b7685a1e",
      "source_sha256": "a7bd739a9295000bc0209c3aa42d0761702e020ca93955659f9f95b20bfb660b",
      "translation": "必须收回在风歌洞窟中遇难的村民的\\n全部遗物"
    },
    {
      "id": "coalesced:0d4f0deba702c4d4d78becc72fa048eb36031d3ea6c6196e6235b3bf4c4471cf",
      "source_sha256": "d638bc6113a22f18d98852306b46e503766b60c9283ac112f0228fce036712b6",
      "translation": "收集遗物"
    },
    {
      "id": "coalesced:3629702cfbd1934f6a041756b407f0c5ae3349c6ea33863c8dcdbfe9e4d6d4cf",
      "source_sha256": "6e521432f29a00bf7fe1bccb810ceab72af542dd77452cd37378437ea5d9479d",
      "translation": "QUEST%s : 收集遗物 (%s / %s)"
    },
    {
      "id": "coalesced:022b88bb951a093582c6cc6266c86cec6c3b75fa4f0f49316a9082c3b73c3df9",
      "source_sha256": "d638bc6113a22f18d98852306b46e503766b60c9283ac112f0228fce036712b6",
      "translation": "收集遗物"
    },
    {
      "id": "coalesced:5e379b923f84fdc9c43ebc82e4ac975cf15b54ee864d8d5d3bbcdd498e24495d",
      "source_sha256": "5383c747b404050890624aeb5f26fb02a01ef247374be687b148d9a43bc9dce7",
      "translation": "你还没找齐遗物啊。快去收回来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:afe7e237433dd2c596e638535ea0f299765d70c44403458d4ed2ea1cb2ed342a",
      "source_sha256": "ac3dcabc82d0300a77180976a6ebedf6358d2f4f89b2a9369249ac4cd935972d",
      "translation": "公主殿下去瞭望台吹风了。"
    },
    {
      "id": "coalesced:2c14c0e4c63aee7328430b6a0bfe56e17384b5e25fd1ea6f07c320710f1a0244",
      "source_sha256": "91734e48794b52561d7331ae36e4ead3a46b78ab275317f0ee9c2e12541509d8",
      "translation": "塞蕾丝汀、阿尔戈和克罗塞尔似乎去海岸游玩了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b4906b9904bf2c78957d2fa05a18f3495b167d6f1b7018defc3719842fe398a0",
      "source_sha256": "7a3be589d67a9609b92d746d008c999711b7c72a22b88e73fcecc76b8b3cd3cd",
      "translation": "如果想见公主殿下，去瞭望台那边就可以了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce2de63954e627d84634babb1d6339bb707856f4b0ce866bb5d47d41365e9d4d",
      "source_sha256": "a605bbaf3b11fc4beea2a3196e4d450dbba3fb9fc414030db15927c72ff6363b",
      "translation": "你先回去休息吧。"
    },
    {
      "id": "coalesced:a7f4689d0828563254e7761cff59151d43d232420377712a8c5bb3d6f992bb73",
      "source_sha256": "f2866a84b83b6de6754b85ff43350c376e17301d674f3b7b23b902cbd9475350",
      "translation": "哇～大海～是大海。和阿尔戈哥哥在一起，就更开心了～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4c62cc8ca4f20cd95b0b9bc9f1119766552b5a56e941c28b3ae3380790374cd0",
      "source_sha256": "d5d5421de61fbc21b58c5a0abb8970c6c5cd7ff93e787e874fdee40961db4fe7",
      "translation": "嗯……真凉爽。"
    },
    {
      "id": "coalesced:9bdb45039e978e5e7d38bc998a98d82f5c760d4cf8beac3efba7b40b08ac51d2",
      "source_sha256": "96c4683f1a240e610a46e5b002e363dae3bc2fb4c2ebea8af9b9ef30768010e8",
      "translation": "和北部军交战的时候没注意，这海滩还真安静。你这个乡下小子，就是在这种地方长大的啊？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77ed2deeb45aea5beb7c3bac4a7c8e88a2373c41be11d1b8221e298c8894faa2",
      "source_sha256": "117507a7fb15a910d201ad2654d6862de02b9722a3c694d0d7483633cbd34c17",
      "translation": "(既然答应了爷爷的请求，现在就去风歌洞窟吧。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db83c2f30f1f4d75dad96f1c307ddd3590080296981cf12bf978fefadaa7ba2c",
      "source_sha256": "9816dfb3c567ac8b3c7d76255b4e692d417cc8684e0e38247c03538b40fafac4",
      "translation": "(现在必须去风歌洞窟。)"
    },
    {
      "id": "coalesced:4576d676155dead9b4ac3993ab9074da69d1f65609454b7b38536b3090f73e05",
      "source_sha256": "14fa97158e98b6ca56cd1d723a6df0818ca6aa2d8a9527aee197b5580baf3f0e",
      "translation": "(现在没有理由去别的地方。)"
    },
    {
      "id": "coalesced:794d54f136a5bfdcfe23de5828dcdaf8a8e7007ae22a625a026108a5e030111e",
      "source_sha256": "5bb12276d3a684fc23e1be19063338b3a38ede0b87e94a27e88b5f41519b5b18",
      "translation": "(先去见爷爷吧。这里以后再来也行。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43ffcf9fee5b80f5aaaa89188f6f83cfc656d92ee01a7825cbc75c523b57be56",
      "source_sha256": "cd6a1955311f4e62593347dc6151d059f2db3e29c2025cfa4a98f5caa7cd5410",
      "translation": "(该去见村长了。)"
    },
    {
      "id": "coalesced:dc6a805fa2f423285993e7115dc0bfd1fe989cbcb3f18cab344ef7215628b1b2",
      "source_sha256": "fe649bf8dbb3d2a9a0a3d52541bf61b671a516776c71e69b1f9021793517c472",
      "translation": "(现在得去拜见村长。)"
    },
    {
      "id": "coalesced:ec3e85c907d0749bb0795e7ebaa98cb27cebbaee55bb88102af77b46dd6b94da",
      "source_sha256": "331b2a52e2a761febf00c95caf0616182b8f1ef3ed784526b85350e73e3b33d9",
      "translation": "(先去拜见村长吧。)"
    },
    {
      "id": "coalesced:3351fe1b2503bc23033cd1bb6b6d266465d648092ec80853679ec17be76ec566",
      "source_sha256": "2d18cc2a405c1dbcf44b302930d5d5fd9858896b474d04d9b31b13348d2e0a00",
      "translation": "(得去见村长才行。)"
    },
    {
      "id": "coalesced:801dd3fcb3ce221ae70e2ac77eda85b145bca3d7dc7a867913fbf4ffdd976640",
      "source_sha256": "84bd2a9304cb8f406c5d514ac9d4e85294dd0a483f8a474dfe767d954120a312",
      "translation": "(得去找村长才行……)"
    },
    {
      "id": "coalesced:62653957950f830b18f3b31032f874cb10524f5ad41be897dae7a8070c4065ab",
      "source_sha256": "1524176ca0b4c8dda077dbde8fcba95adc4caf92a08189bd56ef22e4e3558ef9",
      "translation": "(独自去风歌洞窟太危险了，以后再去吧。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:97dcbcf1ab1ebdbb444ab7766fd1003f2d8d0a5eea84a74e72d2ad1be76823d5",
      "source_sha256": "3c110c734eb70c14c0134760f70d7fb1b917132eea605c67797ea1f7fa442a55",
      "translation": "(死亡弩炮也已经摧毁了，剩下的就交给南部军和自警队，先去见爷爷吧。)",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19f14ba8387962596a273f2ef253b5074b3202ebebb098cce4ad3a37421b3092",
      "source_sha256": "79e8ec2bc6f32927eb939b89b69b204d04855ff3d31d7e9ca4ba43db9b466a43",
      "translation": "(我们的任务已经完成了。)"
    },
    {
      "id": "coalesced:7da75bfcaeecca73f16b4701556ce4e121a19e208f7a8cd02f03ff4b5734ba6d",
      "source_sha256": "573e2b4bbf8479ebec7d7f4c0f8953560d8c4b2c1c97e886f01d6e685aa8a1b0",
      "translation": "(我担心村民们。)"
    },
    {
      "id": "coalesced:a7b65682ae08057165b7c1bf4d3b5d2cff5731b4167c6ed8869abae628b80cf0",
      "source_sha256": "4bdb5792c1c020b2f57a7465e39e5568bc8c3e5ebc33751127134c6ca9e82609",
      "translation": "(死亡弩炮已经摧毁了，去看看村庄怎么样了吧～)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:671f772996c97451e6c7eb84dfaa682d3c46bcb7d88de539b25dfdd9301350ce",
      "source_sha256": "1e3b4786c2a204419d58bf5a637ff9d6473124824d66e581d531b5d9d4ee3d09",
      "translation": "(现在，海岸交给南部军和守备队就足够了。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dcea786652bf343d26e3dedcb3fa35ab3b28f5a0d1f23231a6590f4b34cb26aa",
      "source_sha256": "317de0a289b3980abdd4d53cb6a4fc844fe8affddf7e255e699768c62970315d",
      "translation": "(现在似乎没必要特意回去。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2abe36bbe8bbb70037bc1c5cf8b0caf84aec7d7c4e928e7d83d0f2601eeadaf6",
      "source_sha256": "7b091f3dc774538d265ff3a43e1e68e470d2b3d9aa2a36bea659c7da507e0ea1",
      "translation": "我们会协助反哨兵部队。一起摧毁攻城兵器吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b2fb794f9f06869f4a73ce732890b506a07a4a6cf84ae62b9bcbc8fd7d71c35",
      "source_sha256": "a9a457e6a909e1f64a59d44fbeee365f1306ab9208877c82f3d7559a2cb1965d",
      "translation": "洁菲说明之后"
    },
    {
      "id": "coalesced:30c70962aa4337cf3cf1194a77fe38a21c2b65fa2271f5a5cbe8ca01a80451d3",
      "source_sha256": "df298e599ec96846e20afd9ed4ea804272b508dbd17938f2224757fd8912690d",
      "translation": "会议结束之后"
    },
    {
      "id": "coalesced:2497f062ecbf6c43eb30a0782c63a70fe671fe3ab66df3561c5dee2f8d364466",
      "source_sha256": "37142a9b3ed93f6361d71b18cdca6634f1b39a5625a69be6b92ce178ed85545d",
      "translation": "村民的遗物 "
    },
    {
      "id": "coalesced:710ab04924361ac1dec316e856d659c185a0730888211f5e3346544210285cb9",
      "source_sha256": "725bd395e8e34c06b9d6845564522424eeed448e3d8caa08af97ad15c58b998a",
