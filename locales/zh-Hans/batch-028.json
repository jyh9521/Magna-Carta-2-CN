{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:5fd5442bba4fdbe0061c052fba0b8099a91b497d8ab73f95f0f9561b6bf951d8",
      "source_sha256": "76331008668bf0f1e139543738525af44d2ecc1742a145d6c7ba9c4b71ee2830",
      "translation": "公主殿下，您没事吧？"
    },
    {
      "id": "coalesced:b77057f5f1d8615bccd01a55d9d5e0314bb3b73f64648005121ad30c372c1c34",
      "source_sha256": "89fc18405c566d8a465ede62136e10f51721ec630e2eabf186f5683e52eb94d8",
      "translation": "嗯……没事。这点伤，用我的连环术也能……咦？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d7131833ef6d3ed386870d5060749b9b353e190f9cdcc66a769031a21049478",
      "source_sha256": "a5f970f628db1af1706193d24eb382467973d2799221a4f3feea94a54b18a187",
      "translation": "公主殿下……？"
    },
    {
      "id": "coalesced:89287d8e621b11e9075bec923a0478e307b2b72259e85901b0906a03ba01d81a",
      "source_sha256": "05fefc5a2ebc0b1395306efcc24da31773259644f148082a3b4b66eb2ef7b603",
      "translation": "身体好像麻痹了。手臂……不太能动。这样恐怕没法施展连环术。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4929e4f75cadcf7a0ab5fe0716ddf00323973126ed256bce56d254e84ca4fa96",
      "source_sha256": "b7444b059ce02458abfa1aad4acd53f759b076f99e021b7d3bd083a09d9846ef",
      "translation": "是因为刚才那次攻击！？"
    },
    {
      "id": "coalesced:0598e6a1527385c74c77dcfc244d502475f4db5ddb33309e59fb4704e1f59e21",
      "source_sha256": "ae7a90ac20856fca668ce49e16608f82760584612c8c497085484c7cc41dab40",
      "translation": "刚才那只哨兵似乎带有毒性。不过，幸好不是剧毒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e8eb376720a2556660b3fe197331e0a90d468d029f0e5d6cbebfc15f6d176ac2",
      "source_sha256": "4fd10a8633a00c2da558701494ae2c54cfafa1fb1516c7287823f18876871b3c",
      "translation": "嗯……解毒剂似乎也不起作用……看来需要塞蕾丝汀帮忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a3eeb3d74d52aa5d59157ebf3bac269363b9a85c9bac3ca4be1f5899da726c1",
      "source_sha256": "6664f7395d90deb5020927d06f842740b11e6172ec1525dc3a619f88a6813251",
      "translation": "我独自回村一趟。这样应该比较快。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b0794906e5f0845514925215e871eb196af79f7e57acfb9793889858b8bf0a4",
      "source_sha256": "cd74ccc1cd3418281ae2220ca47e7f83c0a7538eb69a6ba6c2d741b02ef4418f",
      "translation": "对不起……拜托你了。"
    },
    {
      "id": "coalesced:37e3427d8067300b5e8690a715c07e0a267e725e04bf34a45e8111cf7b525774",
      "source_sha256": "276fed7e9be9e91944f9339b83088eb71122386abebcd97869721a098dcc2234",
      "translation": "好。公主殿下由我慢慢护送回去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e72d294d4dbf8e0e78cdd091af23ad978f6924ed3557544339d79b98184a88c",
      "source_sha256": "1526a38de8de6d9156e33e88abb7ecda1dacbdbb8343cad0d55809f7a08384b6",
      "translation": "好的，公主殿下就拜托您了。"
    },
    {
      "id": "coalesced:ac54d408ad78ae1bf470cac1c1c19cc58631be292237826bf15e4aa1ee926b98",
      "source_sha256": "9bf4f2636cd52a346d37824cfb84ae1153d1dcdbecb259981c2e948c2096d833",
      "translation": "我默默地望着露逐渐远去的身影，"
    },
    {
      "id": "coalesced:b8e9c10331ddcfb4b2000362ecdd6540b85cd11c1fba1f2f9f3281e21a729852",
      "source_sha256": "13c8c44dd3d2563e18a9cd3b3407b16ada27951e9662b7945abd8326635c7911",
      "translation": "想到洁菲险些受伤，不知为何，心中涌起了怒火。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bfb855416cf1962a11d1133ca66eba47b25872be58ba6102cc62d9c0007f0ab5",
      "source_sha256": "001a79daf9deb10c548e63d80e58e5a49bca4ec95f2d1bd31f2e4fa667ae0ccc",
      "translation": "村民们的事……我真的很遗憾……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0e6793468e1c14f542c9c0c04f12b67743f3716abf9d61b6f24d4b86ce024d5",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d1d24f5b5201c5ac72453fe9a164e26cffd7a885e24afec4fa09ed15dd13d708",
      "source_sha256": "8ba87b55796ef348ee2dea28bf6310ba2aab01f42ec7345d9b00c26738de01d9",
      "translation": "那只哨兵……"
    },
    {
      "id": "coalesced:e05794991ca6b8fbf1eb43b7b3838c0e2256995b92872e95bd95ea1f376fcfbd",
      "source_sha256": "1d5015ed7334bb7d754b44d61c2f20a319a1572bf8130f8a04ff545ce2176e0a",
      "translation": "原本也是村民吧……？"
    },
    {
      "id": "coalesced:abca334160b55bf9eec26d20a00263fa5ec07451fe535a3662c8832e5146183f",
      "source_sha256": "33c66909229796eabf0e2724dc75d88316ce6456ca1fc09586b1a26cd369a119",
      "translation": "对不起，朱特……要是我能早一点救回岛屿……村民们就不会牺牲了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b770b88601c06ec9204f522aa4acf209ae94fba74e9d17d24b47075c04af8a3",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:5d256aecfc54481a9420d13a0c13bb35286988622778b0599125d88f55167c21",
      "source_sha256": "c1a812c5667bae0556c9e5dffd8c7c8659d99ae783981be390319e770fcf4bf8",
      "translation": "对了，你的身体没事吧？"
    },
    {
      "id": "coalesced:a4253738a06fb0992d0f176d28ba29d20dda5633836b25a1490bd1c25017ec9b",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f43ff6f4668218985b20a08d2b4413b7f75ee75ef850d72990db813b656efd66",
      "source_sha256": "23fa64409b011e44f80de13c38bf8d242faf96d7a1c6dbf0477625da698042c6",
      "translation": "朱特？"
    },
    {
      "id": "coalesced:63720de4e82da31d8aa073dbd0ea60bdb344fb3e3bd750bbc88da4b701241bc1",
      "source_sha256": "b83151b853411c3fbda958daf8735eaffa8fbe0527f917ff927c07aadd318914",
      "translation": "真是个笨蛋……你这是在干什么？"
    },
    {
      "id": "coalesced:ba22e398b834c39730a26c49f6a9d92f7853a1b66376b71d82f1b7babb7df0f4",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:7c9a00b7404386edcc613ec5e85a5119785d9b6f6b52902b7af47f059d43d9cb",
      "source_sha256": "d131e8e0c311b08ddb0c5e657413f43707c1ca38886767885a96be954687483e",
      "translation": "你为什么每次都这么勉强自己？"
    },
    {
      "id": "coalesced:f9e481bb7ab33d4c801cc8d87a851c02749bdfb342650570dd8613bb7ecd5e7a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:063b48f58f7b0070cd2f86b50f09c91ab24d0a30192d71c62fc8cdb3b1f986a1",
      "source_sha256": "700d899443b8f0c80ef51edd457ea9d8286cd7056b2897925ccaff6d4862a32a",
      "translation": "拜托你，少操心别人，多顾顾自己的事吧。为什么什么责任都要一个人扛？公主又有什么了不起的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a7dfb6da09ce5da7b66c6660c830ce9c7c2e7bea81d3ab96a4afb7fd40810a1",
      "source_sha256": "b370a7a3cea32800cb097b478bc3da0bd10af8db0e351d0211d3ebffc95a60fb",
      "translation": "啊，对、对不起……"
    },
    {
      "id": "coalesced:d5862b30d881a3ba2b8f4b751485122cf09484e27ce5450c2f927ca4a1f47928",
      "source_sha256": "26ce76b328d4a03b69dc6ccce5bba2637c6ab1d2de8ec38a80f15902b388b1bb",
      "translation": "别道歉。该道歉的是我。都是因为我，你才会变成这样。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17f61ef40ad5f9727cd9ec280bdd11e1b7374c36a816937bd2c97cc200192802",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:935c598cd5dfcef8e5a523b7421b5b84bbb572d387f72169c24104916815be7e",
      "source_sha256": "2d516c7edeab39c4ce2afba967cc66f59dc9746075db4c2d8cf091376a6f7808",
      "translation": "你总是只顾着别人……可就算这样，也不见得有人会领情啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3945e31ad9dfb59208c3b3c5ff4310912b46714cd379f69ceb630b805ddfeb9",
      "source_sha256": "d205ac1226b7a0ef05862f9cb9963428c9a5e42e8d33035f88e12e66d8a399e5",
      "translation": "真是……个笨蛋。"
    },
    {
      "id": "coalesced:843557c05b4503c0c52f1c689d27bc2d2dd69e21ae4ed85cfdb74eae1cb4743c",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:8daaf7b101d707a763c044da941f4b01ede43884e3c976ddf2334a242e4698fa",
      "source_sha256": "6f4de349dab5fc622cc0e3b0decb8c0dabf5da4daf2a3b90a82c019153fc0bb2",
      "translation": "呵呵……"
    },
    {
      "id": "coalesced:8457815fa5b703d669c1333d06db1eec290528629f5edc2e8f1ccd2fe1d51b44",
      "source_sha256": "0e05996c61c43dd61da9a0cc6074bb94cab3aef4cd6699349a76744ea90311da",
      "translation": "你笑什么？"
    },
    {
      "id": "coalesced:e1ac2669cb8aec03a1d0532391d8a7ee8842b768c1b323610909698ddb8896b1",
      "source_sha256": "3b556bae5ccb63fcee950587aee3baf192e17d7bc47c95884be7183f18545b27",
      "translation": "呵呵……啊，对不起。我不是想笑的。"
    },
    {
      "id": "coalesced:cfd81d45cc1ac8269dc792c9a34e7e10dbf991dae5953c99c185c613258d9f6b",
      "source_sha256": "ddb17994185a0805fa3b3edf7aae26d973772f869de208e8c2cd94490eed7a43",
      "translation": "除了露，还从来没人这样训过我。而且，你突然不再用敬语，也吓了我一跳。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e83f0faf571708fa387d371f04e302d899c36405e893f59a785a84e275ca6f7",
      "source_sha256": "ac955663ec35ec4962379a8248e92a12a034670c86bdbf36fe8d41052d4a77da",
      "translation": "啊……那、那个……"
    },
    {
      "id": "coalesced:4ed9f59e475473d8b9531b561fc5fa1d105af2357eb8074e0b87058c2de95be2",
      "source_sha256": "d6e788326d55dd973323fef04203d64f8d0305125386074b3c4679cff3dfb7e5",
      "translation": "对不起，公主殿下……"
    },
    {
      "id": "coalesced:64c53333af758ee428dc23510fa4a6505c3c44928bacbce8b5cab0118e610ab0",
      "source_sha256": "ed8f97aa713109483e6cc395204a8a3e187ab9b87398bcc888c34a22aec64051",
      "translation": "别再这样了。不适合你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:694542484abab152f1ba639d804e2c404053725ecf56fad8a6a19e2f7ad98137",
      "source_sha256": "6c1246ba0420d6517461dfd559a00ddbfcbe98e6a119842b9e12029f6b2b7938",
      "translation": "就……随意一点对我吧。如果你真的为我着想。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b339db1149dbbf42b2a76c53bd654c0a834011216d23c808fd5f5272f242595c",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:4646e9b39490bb5d8277ef965af94410aa90c986211dd708a9074b9f930e3cfe",
      "source_sha256": "ba9f340f7b445cd4cc6ebb7c4e3b773f30b1a07fab3102a120abcc58e4da2f92",
      "translation": "阿尔戈和克罗塞尔也都是这样啊。他们都是为了我，才故意这么做的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b0399456ca0d94212e81a9464a99e03f9f75a5edc8d2678ccab9e28fff7e64b",
      "source_sha256": "2ab838238d13ebb3c48608334b76677359b488cb859fd2b324c4442312f13f62",
      "translation": "好让我能稍稍摆脱身为公主的压力……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a41ea0751f0fa8ff15f8aed1b2f3171f7f9bae2000493471f1a1119404307bc",
      "source_sha256": "d1c0d926b740a67e276da112e11ee7bd6fb80722f6173320a1f8359f956238ff",
      "translation": "嗯……该怎么说呢……"
    },
    {
      "id": "coalesced:2f836993225b69ea9439c8fff3a06d6b7b2979bad04ac3edbcfa9463854d8283",
      "source_sha256": "2de4680c443872bebba34ac752bad06db6fb92bf37c6a13d29ec41c74d7d99ae",
      "translation": "是啊……如果可以选择，我也不想生来就是公主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d23f95264930d6cecac3a0e3da8816972f347158c07e41954547ecf76f35fd5",
      "source_sha256": "42562ea94908e40313a1afddcf56c61a3981544ec3efbde88bc5fc8ec84c4dd9",
      "translation": "可是，不能因为讨厌，就视而不见或逃走吧。如果我在这里放弃，就会有很多人死去。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17e767a4b3d0a8884642b6b47064b4f965dd003904c0d91b38f0216abeeb0381",
      "source_sha256": "73ac33b1ae1cf0606371e3a81424e66f53f303c7fed654685f38a1f89a720b7f",
      "translation": "那样的话，我一定会一辈子活在悔恨里。"
    },
    {
      "id": "coalesced:c36f9b6f517b35053db32fd98fea76047aadbf07f5526cb5fa53f003796fa68c",
      "source_sha256": "67c381a792b0539ca56cb93b2da10ed8138ee041460fdfb27a959a7e25d44be5",
      "translation": "所以，请你……多少理解一下我的处境。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8a21d2cfb99dca4c4d7ba7e68d083bc7c75628c0a39fa91683ab6dbea32ec7d",
      "source_sha256": "bf0ee93e3a8172b1447106eb82e9a3b227d5c0f1b0f0c1560e0aa43b415b991c",
      "translation": "而且，你已经帮过我好几次了。我也想至少报答你一次。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6653f49e8a14f86e6eef559f49da5e3c86686f7c69978cf051b52b1997b4cf83",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:5ed2e3a7eeabb473f7ae01f889a40808815028c6fb31e1246688172d1465048e",
      "source_sha256": "c69a01e9789da71d154aab00bc5fcd348d47c1e20834a027c88078962ecdaf00",
      "translation": "那个……你能走吗？"
    },
    {
      "id": "coalesced:65a73340cc25392b75efae5da9d7781e2fd41c5ba2d5be27089608236dcfe2c6",
      "source_sha256": "ea6c5c1a55aa507affbf8e229a3f317a1f2cadf40ea715d74cfb1abbfabefe55",
      "translation": "……还、还有点麻痹……"
    },
    {
      "id": "coalesced:13ce0bce320572a4de950662bd38cd638d5ef51d82d23c8af241bbf4702a0d56",
      "source_sha256": "1b7eb9c27b1b51bc649999def729d07f6b54fcfcf24d1de14eafdb591838428b",
      "translation": "那……那个……洁菲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf8058b3bc61afffd81706b0de021292bfae19607c234d518c95dc5b8536c1fd",
      "source_sha256": "9e383e50edc25d45588acfd6a29404b6bbb5233e1ec9fba7b28d5cde3f84b734",
      "translation": "嗯？"
    },
    {
      "id": "coalesced:63b52b5a122c8e4d9a950e74267fc1d3bc7551e1ca0fc198e100abafd3684eb2",
      "source_sha256": "94abb379ae6759f09ec5d8bbc8930781e391b3f53cf3b023519df1ec63e6e5d0",
      "translation": "我背你。"
    },
    {
      "id": "coalesced:48d42cb8e529709ae130f6d202e5e0400c5c92281ce5bf7857ad2319dbe3048c",
      "source_sha256": "3591e5439b1d2e05500126145688d17338074e45a643a8215e47d2b7bcb9c4c7",
      "translation": "咦？"
    },
    {
      "id": "coalesced:cb84cb7e56366da1f05a850b7adb29a3b79db39fda2c3386803df2eb6669a3ca",
      "source_sha256": "9c3e31ffc6418cfbf26b566e1f1dc844688fb71fe154c35db2408529ff07741b",
      "translation": "你不是说动不了吗？这也是没办法的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dfa75a653b01918995b8719a58c54ef3713d447d1f11dee0111026bc58da8e85",
      "source_sha256": "61d74a32212dbe39bcb005297225bd195e84a2d4d0f6e7e3ff6353830d0ad6ea",
      "translation": "啊……可、可是……"
    },
    {
      "id": "coalesced:2ec2ea87bc22f69d0efde662a7d468793c1637e81a6500b4f64a20fcd519fb70",
      "source_sha256": "8e58e181607aaef65aa62db17c910a48d8480f642e6d4cf88241795dcc877b1d",
      "translation": "现在是顾及面子的时候吗？"
    },
    {
      "id": "coalesced:f8fc0bae3b79af6b8752c6d3dad758f04b16c3394a67e65bbb5618d318defce8",
      "source_sha256": "88679fe8c28329f7f92ed2e4857f59db4fd1ad2f079f231cbae51936dcabe445",
      "translation": "啊……嗯。"
    },
    {
      "id": "coalesced:4891a5a09d80b7f590a3ed53d6bd15bb4fe9242740d11f7c2c083e0e9f52c6d5",
      "source_sha256": "843b1ef64b1d8c439f125f602564ae715a59e3ea7a60cda205ce1179964d3ff2",
      "translation": "当洁菲为了保护我而冲上前时，我才终于明白。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c5c02f0aa6352cd46a86c564ba164edb9e8e40895ee3c3e6d81b6eaae7950cf",
      "source_sha256": "7655cd5cad015ebfcbf43103aee5e21528a1ffa79482c0763236c943c8495040",
      "translation": "原来，我想要保护她……"
    },
    {
      "id": "coalesced:a1c534a73937cbf429223898a2780c66427016d750f8e736dd24749659ba41ce",
      "source_sha256": "7a78e1dd5f8d708328ff9c6c0dbe17b06f40955f67c7e28953776e59cc7bf955",
      "translation": "真漂亮……上次来的时候，还不是这样的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76dab701fb3690bd7fa97f3bacde36cd6e575e58be6308a87da15862ef331287",
      "source_sha256": "54407bef15a8c3761139f13676c3ccd3f03c72b2be2be5d9dd6b5a27724b0d7d",
      "translation": "这是住在洞里的萤火虫，平时不起眼，偶尔却会发光。看来，现在正好赶上了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a58e6e7149941609a13a800f215ebb06c4e185dd8809275344fd041f5f080e84",
      "source_sha256": "d7b246310a5c61093447c8ecd1976f1b2bcd128fbe29b342766b4efecf86a939",
      "translation": "那个……洁菲。"
    },
    {
      "id": "coalesced:312999ca8d4a2cfb6931a9b9692efb8768dc039980d930346110e855bdfc81d1",
      "source_sha256": "9e383e50edc25d45588acfd6a29404b6bbb5233e1ec9fba7b28d5cde3f84b734",
      "translation": "嗯？"
    },
    {
      "id": "coalesced:548e94a7b844e5bcfaff2fcd0ea1dc0afd5c148a26c8593a7d82710df9e45e3f",
      "source_sha256": "f6fe7c8c7bf444060fa4a31e30ddcb6a8a8db4214a17d444e8d32eaadfff9518",
      "translation": "我……还是决定留在南部军。"
    },
    {
      "id": "coalesced:10c51e28cda1c5cb1dcb80eb18b4451b38341dd56d35e829be288466addb56a7",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:05c2ffe9e3a661b2f280833b165b7d15abfd4809024f55717ee4aa3318843876",
      "source_sha256": "524d0feabf6d73cb9c5e884f426049cc110d4b0bad47a474b658287a9decb79a",
      "translation": "朱特……为什么？"
    },
    {
      "id": "coalesced:0b1e755f555205ee912d3263dda13576a42c7b6a400fd735dcbfb072040a8505",
      "source_sha256": "f1fcf42784d26739aba12d4a7b2ad2f64cc72bd9a986ffbb0a294d0a7effa3b3",
      "translation": "看到村民们惨死的样子，我才明白，绝对不能放任北部军不管。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a953d50e712ae51c86d24486bfd2d96363d796e4a213551228bfa146a4ae4af5",
      "source_sha256": "245c6822c6db88ed7534174c55c26a11a637a79e217e27fdefc3d3ce8e613d4d",
      "translation": "所以……无论如何，我都想试着说服梅莉莎。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59d54b3973671f96341c3f5d0ec372574988c32dd02e74d3b5bbf7c54cc8fc71",
      "source_sha256": "1740780fb2e300ff71555d76c3dfa46a26551dfe70159475de27c075e1ee0a25",
      "translation": "恐怕没你说得那么容易。"
    },
    {
      "id": "coalesced:48a8f943faabe36abedf3bc09b420126e964ad1c90294c4cd6935bfb4595a786",
      "source_sha256": "ac0aafec655ac2c9287dc5749bdbab3959b7aacff5d9aef815d58e4919978057",
      "translation": "嗯……但我还是要试试。"
    },
    {
      "id": "coalesced:b351c63fa87bdeea2f68df47d373ac551a2d661032dc066b5531bc1d67ac1b56",
      "source_sha256": "d67b62f13d66c6f46954d2067e66def5cbe2251e435c3b6d606e0fb9a8ab59f2",
      "translation": "以后，你也许会受到更深的伤害。有必要特意冒这种风险吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:943a7d522ca4f7d6183ef42ecf5ad66b968c20e6cbfecb71b0a0ae8bec5fed0e",
      "source_sha256": "08cc79a5909c18983e3c7d00b25e89d35ba8cddde794bde4a5e9d5f863bf1c7f",
      "translation": "我当然也会做好最坏的打算。毕竟，我可能真的会和梅莉莎战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:868b76f638dffe38da8d6e60b8a54fcccf0a08a5177d9c4886de05969ab9520c",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:376a781eb175d19ca157be3935aa5948fce6beda22055cf27c4936e3073b9db1",
      "source_sha256": "ac1ad27bc7a89e6a22d18f6ca6e1e86b7b3cd6a5bbf133fceabb56b2ce9b3889",
      "translation": "说起来，刚才你保护了我，我都还没来得及道谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5efd79a9ce423b87420c354835ae084b13d3caeb31bb44b18cf9200a7518867b",
      "source_sha256": "344ffec519610499c1007a315b790de632f2a5a064ddd205552e411820670f38",
      "translation": "没什么。结果，还因为那样给你添了麻烦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dfc278732f7d03caacb9a35949fe50de97e482cbdff166d0972ead856c169526",
      "source_sha256": "ff130caaac425b1ed5976a03f06bcc971e0222bc172ac7d256c7208a47ad82d2",
      "translation": "今后……"
    },
    {
      "id": "coalesced:1cc6e44a4c1042439f276beccc6fae64781d35cdde41d62a8279b5e82e7e5fbd",
      "source_sha256": "e3e9899457c677c4e158fa46a838648f0eae928097e0e36221a263ac28127448",
      "translation": "我绝对……不会再让你遇到这种事。"
    },
    {
      "id": "coalesced:3a24d425a93f486f1077c1a956db7fef0572392af5f554d3c349cc81b30a22aa",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:df7985cebc7ba66edbdb4c7d2c244f6db619c781dc6281bcb79831e048d283a5",
      "source_sha256": "306c70d3fef61f1486ec98d96857f4f3ea59c1dda670a6af3d9d482e0abe9e8b",
      "translation": "我明白你身为公主的处境，也知道你不能逃避。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:592fced18119726e81ba8b9713945a99376e08f8673c1bb8072b882bfdc94514",
      "source_sha256": "b73e10099cd0b1c5397c665a5ee7dd591eeede9d88b218b467abb6687d756268",
      "translation": "可是，我……希望洁菲能多为自己着想，好好地活着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da49f981f47ee0c5e4eeb591c5822e40f38ae2bc130e6c4cc2a204e485693283",
      "source_sha256": "d22de55974e061ca345f2835fd3d3b18c2043a9d47696a045f3bc61a6c1103e6",
      "translation": "我也……有为自己着想啊。"
    },
    {
      "id": "coalesced:aabf62300ddc7ad530418bbeb1c21536cef4a50a0432a8f5f12a8aa861910de3",
      "source_sha256": "51bc532f46526cba239336930f9745a6b270ad9e51488240534718031fd04fff",
      "translation": "骗人……你总是只想着别人。……你也可以稍微依靠我一点。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df902237b0f7455a5cc4afc9be53395a44fe6763bdfb48a5bcc6e7f3afa67fd0",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:50f6d42fac3bbbe7591512b4f6e48779ce0122ff6125e69361722dc28c4db7ac",
      "source_sha256": "3e656f3781ee2981d0fecbf4f0dd6bd2a4beff0b43202c2e03a485daef2ee35d",
      "translation": "是啊……直到战争结束，你回到原本的位置为止……我都会和你并肩作战。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7728fdc98938978eeafe106e975dda6222b13d3ebbafeab0f8236579f56b0a35",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:4508e069f42aafc6a7a295007678956de50466c192cdc2c645b82efeb99d9d62",
      "source_sha256": "4ee28ef6c3696170eee46cd302ff40aa944159c407db986d866757f2e273f13c",
      "translation": "没关系。只要说服了梅莉莎……你就和她一起回岛上去吧。你的战斗，到那里就结束了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:280722a0101e1144991b377c3ee485b7dcd707957dac83cc1de22c0b7e8d0b15",
      "source_sha256": "c3b1551858711d09af414951600d914242995a26694253c40c1a5b6c65ff2240",
      "translation": "没必要非待在不知何时会丧命的战场上。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3119e068afc204bd7c240695e3041cabcc5273c21fac10563badd3e53e0e0bb",
      "source_sha256": "86c9220c6b0cfa571a6ecb59b308aef4bd7b05ea31d601d101d29dc8023bd8db",
      "translation": "你在说什么？我不会死的。我们部队的目标，不就是谁也不准死吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4cd1efb0eaac8fbb05c6107752cea187cb3efbdd02ff8622f657797a5a3938e0",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d7d4078faae1f816dd8869eb9e394fcb9764467999252a18e9c28e196bd77acc",
      "source_sha256": "9beb22c6cd2645e2cea6dbaef5abeec6dea5a87a6924f81c08aac0f871efbcf1",
      "translation": "唉……你真是个笨蛋。"
    },
    {
      "id": "coalesced:4a7383d6ca948bbd78dd81c81de8ac50774cd3ad274b941a3d499aba19542220",
      "source_sha256": "c4fdffea9e6ef47571e70986d74e0b6bb630fbf0dfc974fbbc289e386666583a",
      "translation": "什么笨蛋。我可是认真考虑过的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:efd53216ec506c45178020c63fe6d1ce52cbf1e3213c255e3e5cb9c6df42e768",
      "source_sha256": "13d5148103eeb4f2466140fb8589bd04336c178fe35c81bb54953434d18d918c",
      "translation": "所以才说你笨。明明认真想过，最后得出的答案却只有这个……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e248925c7fe4786f0b6eb316d326a9f9e10aab2dd38674d60f4d695c42115e5",
      "source_sha256": "6f4de349dab5fc622cc0e3b0decb8c0dabf5da4daf2a3b90a82c019153fc0bb2",
      "translation": "呵呵……"
    },
    {
      "id": "coalesced:3a7412301c9a1e5659e54e60260b7659761165d715bafab73cf31a6916aa9e11",
      "source_sha256": "d55881966676d7e8de83269259fe1ed6142e53036d1c91851b56b0311dfa20db",
      "translation": "那一天，美丽的萤火虫，至今仍鲜明地浮现在眼前。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0db57839ad4c854e2afd2922f1a3b0717f10dc560939a5dfa943bbe5bab8b392",
      "source_sha256": "11fe3b85f81d9a7be6ab922a885799ad095a9b13a43ac74d7b5fd864230ba583",
      "translation": "洁菲像个天真无邪的少女般开怀笑着，她的笑声至今仍在我耳边回响。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84b2421861e4f34a697dbeb5d053dbf70101c90dcc61cf823853cf29acb651fd",
      "source_sha256": "9d29ab9c66ba8a90bdf0f11a8442ebb375a28e5dead395e1c553e72eb741575b",
      "translation": "姐姐，你没事吧？"
    },
    {
      "id": "coalesced:f51b1b2ad92997dd2c4c11f89ab38521ebdedf19899a5548db44bdf520547057",
      "source_sha256": "723f5b7fdf2150761b9fb78a10abe093e0d33631ac0358883be7f1112530743c",
      "translation": "啊，这种毒，用我们马雷族的解毒剂就能治好！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7fac64b72276aeb1568f0cbb911e472f0b8198148ad8904b9cfca1a68624aa75",
      "source_sha256": "811e778e31b41fb78775cc582087020ea4eb33620e58acc707d205dbd48b1e06",
      "translation": "我这就帮你治疗！"
    },
    {
      "id": "coalesced:9ff4422be4408a21c55eb6d8d70b7c51856f97ba4bf99c11ab79d9e75e734c89",
      "source_sha256": "09f5f55e355c2ac3e3cf92a6f2c9f4739b9a4a7d028c8212aaa4ff8d9cdf0070",
      "translation": "……谢谢你，塞蕾丝汀。啊，麻痹好像缓解了一些。虽然还是使不上什么力气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78b3f08ad40f725d85f46e3e55580405e2c638097d3b36110459267ce963eb77",
      "source_sha256": "590a8c8389a5a743eaf53c20b08769e23d042729b3bf1919b44944c3185fceaf",
      "translation": "听说突然出现了哨兵，真把我吓了一跳。到底发生了什么？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:484ad7b18a2c9dfc041d8ccfb4c732c98b97a0dd41c3cca43ae289744c4c6809",
      "source_sha256": "eed865aba6370dafdc0d9e3466f95793a92794be1bb175d175ba753884aed2e6",
      "translation": "那个……看来北部军抓走了岛民，在洞里制造哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc4c69adbde16490d56ca5a6f6fe16368125cd1cd5f3413a831bed71bdbc5f87",
      "source_sha256": "67da644133d99e23bd71e701f644a807333b95fbeb761bf2aede0074797d2cb8",
      "translation": "什么？啊，那帮该死的家伙。"
    },
    {
      "id": "coalesced:fbcfe38215e5d60f0b9983404536699f399d005858318624784c55a038e916ad",
      "source_sha256": "8a129d609cac54f0098cd30116656cbb8a8e2debe2686f9da6484b7f45659cab",
      "translation": "竟然连毫无抵抗能力的平民都这样对待……"
    },
    {
      "id": "coalesced:240b03083e8f5d997c5dfe5316867600a910553e9e3dc03b31e6db886b015af6",
      "source_sha256": "8d847d0a2b1e1d372c1594d13012a5b143778c523da4c4da8714fbd2797f8bc2",
      "translation": "必须查出，究竟是谁主使了这种残忍的事。"
    },
    {
      "id": "coalesced:744f1a9e6f66ae3e5a467c3d09b5c7f88aed82a43f27e82c0f8b3b4fbd88713c",
      "source_sha256": "ed0ddbbd050818b41cdeba99a75e455680e7384f4f65ecf26161da4c91c2af6e",
