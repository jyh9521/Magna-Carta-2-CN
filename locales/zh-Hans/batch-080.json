{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:d013ce105e6c27f873cf26d2e2aeba0c18cc43a63012200df50725803da3079a",
      "source_sha256": "7d97f7e807f52273ed318f30f66972b6813b220af951c07c6c9992d898d9d50b",
      "translation": "什、什么！？"
    },
    {
      "id": "coalesced:6c04b4ec48a3a063022da18ecd6c4c79893b20868e1914023993d158448d888e",
      "source_sha256": "73b352246f2b3f8ed9550ee03ec64eac17dd03aaa48683cde859d51165930292",
      "translation": "那家伙……得赶快救他！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22980ad2adbb430395388cb490d8a4c438004ab3196b42e9dec671f8d6098cd7",
      "source_sha256": "2edbb3905ca459336cda245758ace2610b6317c12b377ce4b1f3252962cb4543",
      "translation": "真会给人添麻烦。"
    },
    {
      "id": "coalesced:c1d138e683c5282f3b732d51ba929e3b3387e441c74206836fac837a0936f130",
      "source_sha256": "8f6e07ef5676f6da6d1394819f21a799de6d4ecbf04b9121a6f0f2b8fe338ab7",
      "translation": "没事吧？"
    },
    {
      "id": "coalesced:4a78f47a3aa1a212f1e1183b61a6d3221a2b59bb0b3684dacfa08e9bf066f52b",
      "source_sha256": "a789c74e88c15c521cb3b072cc7673479f1f6459c1e61c7674a8466d77772c97",
      "translation": "呃……够了。要杀就杀！赶紧杀了我，不就好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9529359c38db21b47395f8b69fe5ccd3287bed6ea6da1b767fcdf1ed5669038a",
      "source_sha256": "3c5f08cfc440c9df1e9c9aeef9a05796de1d6e9924d163ff1d5cbd592337d371",
      "translation": "以前，艾尔加受修恩扎伊特操纵。可现在，他已经不再是艾尔加了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:afdfd7e95317cbffc2a212b269bde4df1c145b447706838cd833ba648cb3d201",
      "source_sha256": "ca1507e14fb772392aebaff807684e420a44b2c6e22edcbca7f84befd5faae2b",
      "translation": "朱特看到有人陷入危机，就没法坐视不管。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80753ebbe2ff2aecae0c2c13aea598ae6dd5e8ec5ad188ccf0612c06bf713c5a",
      "source_sha256": "0056f8650a3c7cb7c2df2530a694fae88d1e61bcb40b8cfdccf9dfd3aa2e8810",
      "translation": "他会冒着危险，伸出援手……他就是这样的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cca2f44252057cd46e69df381e0d3e52d10f5443053d2c462248234f5ad29e07",
      "source_sha256": "b0eafa30570d9fb227abea8bec74065643239f3fdab14b9ee61f7334078cd30a",
      "translation": "哼……"
    },
    {
      "id": "coalesced:d0a98d0c5f30a55e320e1ea650d5c9b2bbfd839726428ac59bef913e266f765f",
      "source_sha256": "e8d5dd8bec1e45fed81293cd61634b31a3f3a57ffc2b058b0ff5b4e8abe8b008",
      "translation": "所以呢？现在打算把我怎么样？装好人也没用。你是我父母的仇人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:86f6762c000f8c20b6e2517419c35c38f0f39792291a08b47c38acbf49042ffe",
      "source_sha256": "0026485aa030b197e42d8a0d78eabe968b50b979e8bd27f61f42cbb754ffdfcd",
      "translation": "等时机到了，我想弥补自己犯下的罪。能不能等到那个时候？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b37ea9af09972dab394d0d6bbd7f73043c19071a6a045cd595f042d386463e3c",
      "source_sha256": "698f93ca75f515b9aebe0e5d439ecb29968acd773849b0f67680d0e1a0a137df",
      "translation": "现在，我还有必须做的事。在完成之前，绝对不能死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a703c771b82ada605d8490d248c85317ebb0550773abb5f8b977c7c335cad6e9",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:9a35f1fd7f2faee559f8f049a1f25d74d2a8e26d6eca5619c09f1c46182d268e",
      "source_sha256": "fd6aa226da3862bbd14637056966af47407d7f6342caa21fc59efd2e0a5b74c5",
      "translation": "哈，少装模作样了。你只不过是，舍不得自己的命罢了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:980356be23150b68b65f03f9d0a03a39b1248f84c76aeb6b48598bb5cffe6a6e",
      "source_sha256": "286207ff316a87c8eb2469985f5b73b15e1dca2bbf9c8e26f94f1af6d85229d0",
      "translation": "好，那就下次再见。到时候，我再决定，要不要杀了你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8e060d8f83dc1890ef03e0625930f0f538ecb186bce8ad73e86145a1f1776d4",
      "source_sha256": "60c6013160be23ab23ea0984cd6e7013855fbf9ccd35a25c422d89f33e02ca8f",
      "translation": "嗯……随你的意思吧。"
    },
    {
      "id": "coalesced:e97a94a6e4fb234d6bfe9d46513ab0f74f5b9f420d0ead35debd3d21f156e8dc",
      "source_sha256": "e1b91e84c47061157b61e6bfa7cc42ab9935a9b7887efd33598e360cc168aa86",
      "translation": "总有一天，他会理解朱特的。"
    },
    {
      "id": "coalesced:a3448ddb1102a92b091ff7f326d5793c5baea6472287481ec4e5aa1932c276e0",
      "source_sha256": "3d6e9bd7737d9b2ad2ba0200b00d7bfd49d0692121d7cfb457aef08c3fa6e501",
      "translation": "但愿如此……"
    },
    {
      "id": "coalesced:43ee7d966a118c0d07017d5baabe54746a9b9bc7f4a4eaf0c70a102fd95977ae",
      "source_sha256": "61ffc9010e56d1305e95ed9da5c026a8f17383b728a99466e107821de239e83b",
      "translation": "你还记得，这里是什么地方吧？这里曾是一座，铁匠们聚居的宁静村庄。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d2eab6d7e7a8091c9e7b589a4c62edc662b7e55c756edee4e0f9770b9c7139b9",
      "source_sha256": "2b6b679ab9acea606e3ca42ba7b7dcde16fdc136cf95bc30244459a7b9a06206",
      "translation": "可是，北部军的屠杀，把这里变成了废墟。而那支北部军里……就有你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:11431744c3f0e9b9bbaa93eba9ffaeb2bfad7931f7d7f0c9886daee052abc6d8",
      "source_sha256": "b72165a67fc83e178209bc8315864cf9a6a35f3d89557a58dbb77d9e7227cd08",
      "translation": "我记得。"
    },
    {
      "id": "coalesced:c6f706c5591669ec53fc52c6fdc87b78b66c2222a8b196e02f896376297a82ce",
      "source_sha256": "b0641747d3e7af33e267d5bdb9878f89813c5b12c904cff0103e8ee28302cf40",
      "translation": "我父亲，是村里有名的铁匠。我生在富裕的家庭，身在福中不知福，是个反抗父母、任性妄为的儿子。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce6e01dfcc07a87063c1f82f579ff852cbd7b4351e8fc9d28a843a9e2e9fdb5b",
      "source_sha256": "3f4042f76da4919d8bb79981e6e25f37d6bcf9da9c111822f38ddede2b0fe3e0",
      "translation": "大家都说我是个混账小子，躲着我……所以，我反而闹得更凶。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:107c12d99403b4cd335a96af792b7847c65c71f4c7513d940d68e1d2febae927",
      "source_sha256": "8da3d512deefffb3f9c66eb11f5f77e7e7839d5768aaa753ebda84405278c78a",
      "translation": "说实话，我也曾觉得，这种村庄，就算消失了也无所谓。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08bb77e097b00400b64cf917567b3bb8258f4d4e321fe76765b05b3100f4b462",
      "source_sha256": "196e6ab399b00ca16e45b0b303cd466c599c9827d02e39c5b47b88adf3af4863",
      "translation": "就在那个时候，你带着北部军出现了。"
    },
    {
      "id": "coalesced:45feaccc08c688c1c031a17dc3de7d32f94296d02fa01a3c3af1e59dbc9de7ac",
      "source_sha256": "69cbdee6cb6569a8514b0b9a3e52b0a808d00c7d2c53f7875a866a3137a4dde1",
      "translation": "太可怕了……你若无其事地挥剑杀人。那简直，就是地狱般的景象。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:11f5d715433a1846f75dfaf3606efc354890682df056622541312c2ff0b10fa0",
      "source_sha256": "95e73768a1247a0a1511bbe9e52a185b1bf1daa5b0b89c0b85e081a1afe160f8",
      "translation": "可我却什么都没能做。父母遇害时，我也只能躲起来，瑟瑟发抖。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94a2da21a6950f7b0ce65d00de3f677db2491bc274bc52e40a4e1523b133be3e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:dd4745d01dde9a0c2775142a37c07cd8b44df3c8d3e31c568bc77925597d1a63",
      "source_sha256": "30eb55a89ec216018142815e06b5c516d274582fb8a30b12122988daa0ea03a9",
      "translation": "一切结束后，眼前那惨烈的景象，让我受到了冲击。也直到那时……我才明白。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:05aa183fd7b471d1133472109a519bee1790d1ebcc2a4fa4a8e84df46be81df2",
      "source_sha256": "259ba775ab1b6b6265daaaeef31623460d7b2583ff9887aed0bbf9f8549164f1",
      "translation": "其实……我很喜欢这个村庄……直到那么晚，才终于……明白过来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ac8bebdeb7f796545886495d2767ffc825a0ce8f7ea0e4ef3db8def6820b411",
      "source_sha256": "4489cba032d5fda00f27d039810c900f5850aa1e531357791fd295ec09efdef0",
      "translation": "对不起……"
    },
    {
      "id": "coalesced:227c6922a998490cf1380a2c37ceac10fd93377406b0fbb6963eab4cded248fa",
      "source_sha256": "6b609bb5898a580701bca90c5a9f98d6cab2ebbedaac69f8b42001156f9c0b9c",
      "translation": "你上次说过吧？还有必须做的事。你也打算报仇吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0eb8950aedd15bc17e221d0c7e5693e2f006718d90ab064d857881f061ed2779",
      "source_sha256": "f06a5b3e77708b0762427fe266fca545e60c59e6773aa18371bbc95a4f453023",
      "translation": "我有想要守护的东西……"
    },
    {
      "id": "coalesced:deef4eebc28a18cea64ba998a7397cb1d749ef78dffa1c099dd57aa73898c588",
      "source_sha256": "3a6dce3e82c7a41e953114cda48084f6d1bb5569f586a65aea7a010bbbbd3d71",
      "translation": "所以，我必须打倒那个家伙……打倒修恩扎伊特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6dfac3532a6d38d800a6dcf8bcef3a40d3b7e4b782d48cad431837d393bf9ba0",
      "source_sha256": "e3830b2df81ce6409160d97ca60499f025c0783e0925bb99c6d6cbee092b0e3b",
      "translation": "呵……你倒是比我强啊。"
    },
    {
      "id": "coalesced:adbf6a0f884f0888a7d734c97073940827b13adff15c0acdfd1588e44952a050",
      "source_sha256": "8e64f4d5c60d61cd4e1110ca6fef283388a93db9f560a79663dc017c358fb9c4",
      "translation": "拿着这个吧。还是交到懂得用它的人手里，才比较好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0686c1885e447d2b491ed5192c1558d1e54beaefaf303fbbe2ffa5182533da8b",
      "source_sha256": "cc3f2eed078b43541bb709425d2c7aa1743c1d1f7b35434c7d908310536614dc",
      "translation": "这是……？"
    },
    {
      "id": "coalesced:846d41dd1d6742629be7566f95e68eabbbc8beed1563366c22c3d0209362e511",
      "source_sha256": "76e5531e09bb59963e4e0ffc28700affa842d39eb0c83fc141b67c8d2dfc0bdb",
      "translation": "是我们家族，世代相传的宝剑。多亏藏了起来，才勉强没被抢走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d124ddb32f4d1bd415ae77a5adc8c29ce99097b4b321f6d517ba8cdd23b2fdd2",
      "source_sha256": "c1dc40b48895f9ea30082cf2e9fcdb892312c96cd397219db15530dbac8ce9a3",
      "translation": "这样的东西，交给我，真的可以吗？"
    },
    {
      "id": "coalesced:a7038eb95f37202ed41a66171d85544ccb9a69ea3956a25896eab25f7c93f0c7",
      "source_sha256": "536bf7e075ae5d4a75379255a19941c70f43a59cd75850c00aa2bd01340f4e6a",
      "translation": "无所谓……因为，我已经不想杀你了。"
    },
    {
      "id": "coalesced:1ad372cd9cc11ebb3720a3552f66901f9fac0b58ebba904a20f41bdb1c979008",
      "source_sha256": "81ed13ec092122ddd754b8897cb44749df262b94f96fe168643409f598e6cd70",
      "translation": "谢谢……"
    },
    {
      "id": "coalesced:1ebdfe2c15851d85469786c506cbf6767392b61ce8ce450f81f85ee9a6a11c44",
      "source_sha256": "b0eafa30570d9fb227abea8bec74065643239f3fdab14b9ee61f7334078cd30a",
      "translation": "哼……"
    },
    {
      "id": "coalesced:77f3a047bec89322a9234ad4d256e388ced2222dcf8aa01bcabe377156cd43f8",
      "source_sha256": "8e5496665456f6e918221124ef7a6f3a47f983f8346ea6fd1930cfdd1b8ba0f2",
      "translation": "幻影之刃"
    },
    {
      "id": "coalesced:252b0e6763839dd05befa130bde78cf971adb16e44c9ce640d0799eeb30877ff",
      "source_sha256": "9235f7338acd1543c77a1315784ea2131fd0a0f8a050087a425429a4e7934790",
      "translation": "据说是雷恩波尔特的名匠打造的最强双手剑\\n攻击+240"
    },
    {
      "id": "coalesced:f242a9c43a2f05bb5701ef6876fb0258f99d582fd34701df274ef8662b9d04ef",
      "source_sha256": "8ab27f19d4696cfb221e405d62ae69d94cff4676f638de26f8f9e484bece317c",
      "translation": "双手剑\\n攻击+240"
    },
    {
      "id": "coalesced:46084cf6474af095cf5df7e65a4ef91d5ae9eff1088f7c3610ce60773c29103e",
      "source_sha256": "8fba8fa18daa11c406c21f32428ae6a0ba311b3d3d1b4fdd8324be38cd56ad27",
      "translation": "盗贼"
    }
  ]
}
