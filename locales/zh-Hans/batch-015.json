{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:2c3ab12561f5b9233ae0a0886f5e39226efd89d5792921ad69678fb169735e6f",
      "source_sha256": "88ef75ab1dd5f4297a4eb830c246ad74a434488dd54e15e86ffbe5a2d40a8a88",
      "translation": "又欠了各位一份人情，我由衷感谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ccb67bcd075b6549114f12fd48ae9fe950f5037c30528e4b9acea86c8fe1936c",
      "source_sha256": "b879e88db2e914b991cfc06b4e43912da4cef22dd2582f94bd5d261a087ebb0d",
      "translation": "不，这本来就是我们应该做的。"
    },
    {
      "id": "coalesced:e36d7e3a43c62cff271fac6405135d95184233a505de2a17e328de5a880805b0",
      "source_sha256": "733e09266cd2fedfa0bf171d5e80c04f77826e67ad4442a24f2a6d7d30948618",
      "translation": "我们马雷族，也应该想办法报答各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5fce16a3ab3e775d534018f8dd9e9ad2671444c1863523b1088f4c6c014f177e",
      "source_sha256": "e488f8668a223e00845a20f390f2fd01485f094d8b6765fc3aa5f916e3354382",
      "translation": "现在才说愿意结盟，会不会太迟了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a787e3a1b596ca56567b88da7bdb96263c5c6d9be46a3d49668ed30b298f42f6",
      "source_sha256": "d5f5c90b6eaecc5be85af78943abf5a32706a219c36e7a3d9369233be018fcd8",
      "translation": "怎么会，真的非常感谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68382d2b235997e1fa459976846196f7fb1b37e9ec7d90b77784348ea2e8cf63",
      "source_sha256": "166ed5c393d8b67decf3f988e4ab95cb089ccd5e8c258a954a41d725db1087ea",
      "translation": "眼下，光是守住村子就已经很吃力。不过，我们会尽可能帮助各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d80ee00b11947196d72cc309356c63ab6cf72dd3aa68e5a12036b164092e46d2",
      "source_sha256": "723ee5922184bda103df360940ac8ec382142ff679c112c181bf316bde5b540b",
      "translation": "今后，就请多多关照了。"
    },
    {
      "id": "coalesced:871eed61875941088920c2919873fe8f596ebc39a0aa46a12637b4297ed6cffc",
      "source_sha256": "8890744098cf4c9827b0cc2b97df1de1597753feea27f0beb7595f13fe1c16af",
      "translation": "能让塞蕾丝汀成为各位的同伴吗？她是柯塔马雷优秀的战士，一定能帮上忙。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8631ec5cfbc754db21ad08393132f8544f782f438912a75060fbfb0368b6ac31",
      "source_sha256": "04b42225be0a508ea44d55c48386262054ad40d59f50e4e5dbf4bda46965aa90",
      "translation": "请多关照！其实，我昨天缠着族长，好不容易才得到许可。因为想和阿尔戈哥哥一起走嘛～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:833811751a1fe610ea238fc82603f483a1db1508613afa56f5b5d9a6d9c495a1",
      "source_sha256": "3a719e92192c67f94ceadff12c20c86543fe51fce06d542b504e134a10f498cd",
      "translation": "上了战场，就得赌上性命。你真的没问题吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d39915f5716713f8111d0d6d9465edb66b83264326f871699fd561459ed2856d",
      "source_sha256": "dc57fbe486e070b410223fe8f3f9b79cce4a7ada7f16604a24a9b40056a18d62",
      "translation": "那当然，我可是马雷族的战士！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:295e54b3b9948d27f748c046ef8c533c1ffe3c6c8c807accba24c9c157a016a2",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:1cd6000795afb662a3c12c59427b11ed4a1de3a65c9c66b7c172fdef6d26035f",
      "source_sha256": "6c40f10c6f628e01063f75ecb2384854c722cba94c93f971f18e7a62c96c3e7b",
      "translation": "太好了呢，阿尔戈哥哥。"
    },
    {
      "id": "coalesced:bcb076f150ae3be77ba935c43f20c9d8c888b47b8889906f727a13594a86ab6a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:43b96767d837ab42781051f50a28dbe9cab22f20b26712f4fbc3dbb6d0f2bd9a",
      "source_sha256": "43550801a0bfc5218292ad060896919d0798edffb3549a0cf9d4efbc2863b790",
      "translation": "塞蕾丝汀。"
    },
    {
      "id": "coalesced:36193861b35699d593e73e186b04b3db29c2c45ed347a5ab62444cae7ea50c58",
      "source_sha256": "e270aeb347f2165574c3a5c5bf11d038bcd3acd5abfdb5ae8a1b52d91cb842f0",
      "translation": "？？"
    },
    {
      "id": "coalesced:8cd7ab5aa7ec22f9cc0d28a3c3deade568e41da7dfdffc392497642d9523bf96",
      "source_sha256": "6f702d1552cdfb6e00822cc2b0846a5ed7d3c0f2a6898de6e0f6ae37a7d6de61",
      "translation": "正好，现在似乎是告诉你的好时机。"
    },
    {
      "id": "coalesced:bf772c52bcec5d7e331c363e528675c19d21a75eff96a54fabf893bc1ab939c2",
      "source_sha256": "744f0cab25cd37db18b877eb3dba9f8d5f5f83972b82be27324b4a65447b8d08",
      "translation": "告诉我什么……？"
    },
    {
      "id": "coalesced:95a6d465fa782948a5c534ba2585985cb07919ddb1e148a6be486ab4afac88a1",
      "source_sha256": "bd36ecb7301bbef332a99875cdfb3150184c609a9834e4fcaac8a799a6a19c01",
      "translation": "你知道，自己的父亲是人类吧？"
    },
    {
      "id": "coalesced:53790eb39fabdf748b0725c730734674bfd5932dbe58e41093d44b2f7e7ce71c",
      "source_sha256": "754546fcd1e65d84471bbac3508d1f27f214cf20c1bfe97040a737acaab721e5",
      "translation": "嗯，以前听说……他已经去世了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73a15a1e7ae6f36d148b8d4a4d86a44ae10202b403ba9a9e53e4f6fc075168bf",
      "source_sha256": "3f40a7024b85e223c91fb28290850c524b7c76445b6d7400756083b243d3bf2b",
      "translation": "其实，他是下落不明。如今，谁也不知道他是死是活。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a5a99e7b169293d082ff3d276a910ad3a24330f0f3cd87ad948ff8e78b0e3a18",
      "source_sha256": "d009fc4b5680989d839610c5397ca54ff49121dc484c367748bc3eb027f363db",
      "translation": "下落不明？"
    },
    {
      "id": "coalesced:4a2942dd0f227868f0c50b8c8f6123ea964f7558a7a522eea1f6068ac3fec9fd",
      "source_sha256": "9e2d2dd25b40637ab0b4eb426a7a766b5832153e08dbcd355ee4c78ae6b58dc1",
      "translation": "15年前，你父亲身受重伤，倒在湿地里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a81cd05dbbda1798298793203778ba2f28db4ac9ccf8415f771f0d50176fcc9",
      "source_sha256": "6b5e7bd13c89e9016666d0e2719f445eb7b6e61c4f9620306e9cc51623db3a9b",
      "translation": "把他带回村子，悉心照料的，就是你的母亲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9da2c027d04ab439ef3c7edc49a3770098dbb5e1d30ab20af1d9d17d4512706f",
      "source_sha256": "9da12a01b45af0972725c823269736c3e07e1402d98121c3585a5be9fcc192ac",
      "translation": "两人因此结缘，成为伴侣。可是，你母亲在生下你时，离开了人世。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06b0be700ef72c6606fe33306ca7c7a2a3cd2389fc6ac1cfc4f5b51673a363a5",
      "source_sha256": "a0b5b4d31f5b8de8f1a69a0aeee6def706df14170368926ed016827a41197af5",
      "translation": "所以，对你父亲而言，继续留在柯塔马雷，似乎太痛苦了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d2af1831df61f51f65698aa179de9510a1785ac19192cdbcfe4d314be0a58f1d",
      "source_sha256": "d5e925c1b441995e20b8bfe301306f6c6d56d0727553b3243408abf8bf5a362d",
      "translation": "最后，他把还在襁褓中的你，托付给我，独自离去……从那以后，再也没有回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c37deb0f25a3c643c80258d610ad89e3ae25d59842b4c8f82927751dc1e64e85",
      "source_sha256": "75aec8681be45911f1e3f2fa0d41a7cfad11ab07e357b2cbb89357ae20fb4c88",
      "translation": "他是佣兵，就算在这样的乱世，也说不定还活在某处……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e4fbba56bbd94b44270f892ffa0081d94425b731d8d122f29f3c2e3bd078a19",
      "source_sha256": "09422267ec0923edc8722cface618f5e3c690d2f7ea6299b8ef10675d3832ceb",
      "translation": "爸爸……可能还活着？"
    },
    {
      "id": "coalesced:c6df01c209ef1160e94bd98127724927e75e50adaa14a0879310cacb8a50f4ce",
      "source_sha256": "20d3504533304d897549764ab08acc814da3d7933a569ea930eecbb462f8c79d",
      "translation": "你父亲名叫“拜泽恩”。听说，他生来就是孤儿，一直四处流浪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7ff4683e79e65916cc81f09fe9edebeef8edf8bc3b79988e9fee474f52c7c3e",
      "source_sha256": "d37d087fa30d672ae9edd16d950d70aac04dac6b7992f9466b9fe485cb661e6b",
      "translation": "拜泽恩……莫非是“银白的拜泽恩”？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4311285a2ed1496013a1b0b7f12b179ecadde8ba702645c8192b0867480634a1",
      "source_sha256": "68c362c074ef29721e5753556f0f6a98dd497252f237ba662afe3192a4e299b1",
      "translation": "你认识我爸爸？"
    },
    {
      "id": "coalesced:bf9efc058678161f3ead8e90c6257cb2b5ace1ad317932a68532dd02caae7b10",
      "source_sha256": "5e6dfe6fefc588b3308f09dcf1b58d9add9bb2ee7c14aafa8931d928d2b0a4cc",
      "translation": "我听过传闻，据说是位很有实力的佣兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de232eafb272967ef3bcef026b87d40eeb2b5eaeff7d96102a1dbe17b7fd476b",
      "source_sha256": "a816cfb4a52435774c27858ff4d73deb362bda21b4f106b5543d3efeb13e77d4",
      "translation": "不确定是不是同一个人。不过，银白的拜泽恩，似乎是因为发色，才得到那个外号。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4d0f5978974323858ad5e836617d8649030f91676606ec6c1b47c713f3c0a4b4",
      "source_sha256": "d050b4acb2d3ade92382cff80f5f73b3ec7d185857fb0993c6209ae0c6a56c27",
      "translation": "我认识的拜泽恩，也是一头银发。"
    },
    {
      "id": "coalesced:e67f11b1a8ad4a34a147df6f6924ed73f7f281999b15e50b53b7e4250830e3af",
      "source_sha256": "d562e163a83b65c15fe9ad6e01dd3a9a4680257832c492a42893050540f03402",
      "translation": "说不定……真的是爸爸。"
    },
    {
      "id": "coalesced:a3a29c46f1c64c8417f6215b1eb37864159d73d3a0152960a585cac4700d3b3b",
      "source_sha256": "11468803e9cc89bb3bf3bb9c78db0e1d9c1aa9427b725dba43d2524553a366cf",
      "translation": "你从小就对外面的世界充满好奇，我早就想过，总有一天，你会离开这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f18dd7d7f2aabcc5093d6f90a66773dc3e926157e2010e180121da1f6cb0a2e5",
      "source_sha256": "f6b6fb7913719d7d8c458ca146c0b14efa3458d00a887218430cfb50b46ff46e",
      "translation": "原本打算等到那个时候，再告诉你。没想到，这一天来得这么快。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:012d41d3fdc4cc50ecb6272bf134ec5699ad7e3a3229afb25051697c405c1e22",
      "source_sha256": "c9be31bf497a575db9823b0ff28dc07c62bcab454dd515b0e63ca5a00145dff5",
      "translation": "是否寻找父亲，是你的自由。但身为女儿，还是有必要知道他的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:35d2bc8fa5565cde9a1044780f64975419f0129b3411f442f70f0470ff9eaf07",
      "source_sha256": "bec576cd134c4dfb764f7b97acc56bc962737f0693e06ca5f53332db0f3c7a67",
      "translation": "嗯……谢谢您，族长。"
    },
    {
      "id": "coalesced:a28d2833ef23456fe7e5e25936c8036d5119f0b52b02975e95a882ccf764b186",
      "source_sha256": "31079bb463a134d6f964ce45f5d481f53cedf1184028483f596ad4f69e222bf6",
      "translation": "另外，还有一件事。这个消息，应该能帮助各位南部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:836fa56f46334fbc4401f2492a065d4ef931197166e5c3757cfca1f0da2a98ac",
      "source_sha256": "2fc9af98f23e8a6b5631c38e82111c67857dcad9abb44c5287d9b222fa93eeaf",
      "translation": "你们上次去过的海底洞窟，其实和阿巴泽特那边相通。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bde6a8b35c8460f196612d36f5e0ea4be943ae0eb3fd46dcb8a204e1722b915",
      "source_sha256": "e90774397330b356f02b6151396edc31d5a7be718de0c4a01f9a2248aa98da3f",
      "translation": "什么？"
    },
    {
      "id": "coalesced:a5d898ee96d100d016088b89aa9aa82a951d6164aae8457123580daa3005182f",
      "source_sha256": "315cc9cb8ccf62c5f9a4d3e7f0c8862571ba25c458fd0585f28a1fd10e92c3ad",
      "translation": "我家后面，不是有条通往海底洞窟的路吗？"
    },
    {
      "id": "coalesced:38382518e68325fad58621d4cd652065db2472e959c2ced9994cf27a2d96430f",
      "source_sha256": "d337526a996784b40e31d91290f857d6b5abf32e87f040321ebf67eb4570fc07",
      "translation": "其中一条岔路，就和杜南平原相连。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aaba643d7995fd6172481129f38ce004f31c4c64cab76486d3b79ed87637cd4e",
      "source_sha256": "37bbe83f43102d1a3c410ad80c26609227d2ceea8f347ffb91e5532e9c221989",
      "translation": "嗯，是条隐秘的道路啊。与杜南平原相连的杜南丘陵上，有北部军要塞。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e65840a4674f7d022b47e0bc4857c354868dc3c8e2e183e82dd6eec770f78dee",
      "source_sha256": "13495b0970d3b59ffa66c97454c299386f65170b30b2a8dcbed7c18430ea70d3",
      "translation": "那从阿巴泽特，经过海底洞窟来到柯塔马雷的话……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0fc5cbb356b781ee4ed4a3db9fb27287932c562c17ab96797f6af624a72cf7d8",
      "source_sha256": "3bf4ad01a0e4e22c239f55ed4260e12b19eec0e67347d8e23c500e4ff54eb600",
      "translation": "或许就能避开北部军的耳目，突袭杜南丘陵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:617a7ef8c1b6246f3c8fcfb4f9c2ef9350a3c130b569b6987d8cf3091c521674",
      "source_sha256": "359381d928133a7c56325dd98cf03fc6f111af76bf1602c9ca18b628f126795d",
      "translation": "没错，我能为各位提供的帮助，似乎也只有这些了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2b1c6f5cfbd5c23c0013111b021e20a6b6e7dd5a4c3070d9e81abc0de91ddae",
      "source_sha256": "09e68aec211d91a5a1d7a69cfe2ce9de7a8cf324cd975967e8003051f7cd550c",
      "translation": "不，您已经帮了大忙。我们一定会把北部军逐出杜南丘陵，让柯塔马雷重获和平。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c10e2a718ea883736449e4fa75894275e6e1675a4c2e2ee77be951e3d5830aa7",
      "source_sha256": "6084f622d89226769f2c00914fc0ef5291aa49d8365a4c512881015cdfd4bd13",
      "translation": "谢谢，海底洞窟的路，就由塞蕾丝汀来带吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02e188f4b408ef2d9ee8dc9f0746ba5a3c1051e86c2fcdb8e225e5a2d2a3e7e1",
      "source_sha256": "dd47f17330f743678fcc5fd637f74fff33af903566e8bde92962abe5d86fe1f7",
      "translation": "交给我！"
    },
    {
      "id": "coalesced:a309ac448ceee8079dc3387a7aea843c021080b31e451cde531dc9d54193aab4",
      "source_sha256": "e614a69cf594294e7a7a32f236eefccda74a34822279bcbb06acf9cbc8cfb3a6",
      "translation": "好了，向海底洞窟出发～～～！……不过，在那之前，还有点事要做。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eaebaf4164b3542194b9791e9fa64bec0d44ddb0821cbba0c341b35ad6234a45",
      "source_sha256": "4ae3af9e9608d41b2604d4478b0067dc46fa1869117b96602cf2568d8bb5b8be",
      "translation": "又要制作爱情魔药？"
    },
    {
      "id": "coalesced:faf6a17f389a7553bb172b5dd65e7b0b7599cb733f2def64e603b583e663599e",
      "source_sha256": "8b929eae8c9fa47cb913149581fcfe83ad0e3d4ed8ceb3141a4c2ee53e5b3feb",
      "translation": "嗯，怎么？朱特也想喝吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3351bdb0130f3661184c984f02158d764eb61593a108554747d9ffd3249c1d78",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:ff07584c5d2bfd10d898a5b6cbc675c4dd5f873de7a61016e868c9dd9e971d8d",
      "source_sha256": "83492e7225a83ed45544a2115cb11fda233d2db16696e47560d9d128c524c691",
      "translation": "其实，从海底洞窟通往阿巴泽特的路，被一道大门挡住了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5d041bb3303b854e3118eee7d0b6b7f12a087ac6288cd479d651645cc99d12f0",
      "source_sha256": "0327d08ae0b592b21edcceb28834d8510d14a1768b5eaf41525a11cfbc6529cc",
      "translation": "所以，要打开那道门，需要装有特殊香气的香水瓶。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:055fc63a99cbf3cef1a5b1ef839196ec218a5ff1bca536b2377b69c8c5c67877",
      "source_sha256": "fd7b0d2da76a76ea02c72a4e18e7490fc8a851a07f870761de786b99af42eeac",
      "translation": "为什么？"
    },
    {
      "id": "coalesced:deb10cad6c077fa05f3ef134083c7f85c3be0a1f09b9139ef9cd4fb68baedca5",
      "source_sha256": "64c99a51aeca7d06aca46c3cee489879aeea8b319a8a487901dcd919b12accd8",
      "translation": "那道门由我们祖先的灵魂封印。想开门，就得焚香，唤醒祖先。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcba00715175c91031b07518459926a735cadd2e4a48d1939e29d03e48c0be64",
      "source_sha256": "78710060fd8bd72c9e2237a678d81b00447e49086fcdcfecd1bbf669ef1dcb60",
      "translation": "必须在祭坛上放置各种香，步骤有些复杂。要是放错了，祖先就不会醒来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b185a95f6e4118ac6ad33c5e3c32f52ddef9fe640a5283ddf28f70eac5eb840",
      "source_sha256": "c5c3341daf2a7e916672777016b24772b64622ce6e7a157ce852c7fff55888f6",
      "translation": "这次可以相信你吧？"
    },
    {
      "id": "coalesced:350104c463b6dd597e005ef661d28583ee02f5a3f4a9e574d69afac6360f0db1",
      "source_sha256": "dc026283f62a58c3b8797c9e1df031534cc4844eb96a235122d630c68df0b05e",
      "translation": "你以前是被骗了多少次呀，干吗这样～"
    },
    {
      "id": "coalesced:824e5e8c890f9c3e517e4c244171169ef5ad9861f852836f278ed0037fc140cb",
      "source_sha256": "f3a299aed213d70d42b1e47ecde132e290a799e1946db11b42ce7ecf9c6f4213",
      "translation": "明明才骗过我们，倒还挺能说。"
    },
    {
      "id": "coalesced:9c9519e0f621a88759c17849251bfe481941d791d6f38fdb6f23cb806664c1a3",
      "source_sha256": "38326262adafc6fee50bee02041bc95110f6886888f47fd1e5d4b6ae7c2778d8",
      "translation": "那就去找材料吧。"
    },
    {
      "id": "coalesced:31124d12ccd5e24e2e47acd66e499a62f3c0931a0e7818d5b4ae983dfc2ede0c",
      "source_sha256": "c134c2e6debb2f68eed2bc588af246a4baa09a9977e8dc7cd20b2e9869c814dd",
      "translation": "对了，能请朱特哥哥和洁菲姐姐，另外帮我做件事吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0bc1b05f3554a23074a187c452a3783e4a2b4b9ab392a63c4ba55bd7a6b68d96",
      "source_sha256": "77fda0e3995729a300bc4cbaebc5c19b8f3021c7899fd490d4be4428bc57245f",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:13a81681299c0cbe2f7a1b79814f48c94f8bb0095625f140af833a009fc03b0b",
      "source_sha256": "6bad1c1f4e61a214e943df33ec6c802779cc1e4639866f688aa3bdac799e063c",
      "translation": "你们知道，柯塔马雷总有股好闻的香气吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9ff136e762e6aba1740cf690e7c69ac2eac792e7681820f0e958faaaf829ab4",
      "source_sha256": "9ac5d3af58698c896508bb1b7dff7e6de9e5a956f605647a176ab717aca7eea1",
      "translation": "那是因为，村里各处都放着香。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0cb273a0929234cfb7d76632f883ca08131d59d96c2f2713113fdbdd2d50fc59",
      "source_sha256": "8ab65b9ec95c9dfb98506c274d2570d9ba8a41de056a7ba595f4f3aece9bb091",
      "translation": "平常点的，主要是能帮助恢复精力的香。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5982250607c9b4fa4e7531d3d11a6d2fbc0dc214142352317b7cd038fc72a02",
      "source_sha256": "3e8ee5bdd2bf3c82c3f94ae791f8370485b31732a4e5fa72da2b778150885d9b",
      "translation": "这本来是我的工作，可我加入南部军后，就没法再做了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b90b120ac9ee40c80372b4ff5a124909f7e8d49a55dfccc72ebfb9c96628ccf",
      "source_sha256": "9033f7c0c2c262471dc00fff784bd3fb6a90fad9c962d6706dbec36884c34847",
      "translation": "所以，最后一次，想请你们代替我，去把香点上。"
    },
    {
      "id": "coalesced:5e589acc567638f8f1bec643d0571e00ebffd1ecbee2c5f8493425090a594e2f",
      "source_sha256": "0f399dfad2ce23e84665dacc3290d4bc84fc3baac7529d722cad3eef7adcafe1",
      "translation": "我会和阿尔戈哥哥他们，一起去找材料。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8abb3830cd479d0ecb0f10458ae1fbd909ad9d45bf00b15e029d2ced59ab5e2b",
      "source_sha256": "298f1beaeed4f542b4df046cd3578e73600c580244859df4e70bb87cffd7a013",
      "translation": "我不能留下吗？"
    },
    {
      "id": "coalesced:7a4ee855c7e7249659bb3fe87b9daae04e9f78748440cc4d125b5b1748a7276d",
      "source_sha256": "5162523ff0bbc297518cf35b2925585a16f068d84074f9c6c20fbd643b27785b",
      "translation": "不行，你想长高的话，就得多运动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8301e9aa4e426279946bc26246897302c88372009faeef0587082ee79df40a3f",
      "source_sha256": "0eb8da45c9bfdfc2fd16f6543fcb0c7eff7a0e361b056855ca5a092226b3e420",
      "translation": "这家伙，真是……唉，我大人有大量，忍了，忍了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40a93aa42352d329c26fe406418ffff4f7ecc41ef142066ee148cb515a205f8a",
      "source_sha256": "009877f4b1478a4c3ffdf0036eaf3965bf12e7952e27ac69ceaac278ba89bcd7",
      "translation": "好了，快走吧！"
    },
    {
      "id": "coalesced:e1e7f792c68428999dad38bbfc968cddd97abf9db2b306f59b8e97214e0188d6",
      "source_sha256": "1ebd0daefd5d5acc0229e9e35701e9f2bdc29193f4d7dc0fe94e45f3b1c1025e",
      "translation": "北部军攻过来了，指挥作战的那个人，是个极其危险的对手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0ef9a7c6a2361da43405f32fd6de3d592623203d2843f683c9e23a75c3f1c0d",
      "source_sha256": "fdc9aa2d04be0d931178bfd9c061d12f6ce4f216c70d93045fb568ac0f5e2a69",
      "translation": "马雷族本身的战斗能力，并不出色。感谢各位愿意帮忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ebd4aa46371208a9eafb1fd0a48a194cb846a30c744ddefbc8aeb39c85d5901",
      "source_sha256": "d01b86c9d2127522b0a3c439b83e4b848b344de19f1ff0e6078ca988801021b9",
      "translation": "马雷族守备队，正在村外迎战北部军。各位，请务必平安归来！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:46cb9ab424a6ed6a19d5ac5acf96b2031688366ef24b499a08f11d2323c0bc9c",
      "source_sha256": "c3237df9a4f539a83d1b5525950762337652395cdebb52f50822a27b2281732c",
      "translation": "可恶的北部军！峡谷那边虽然挡住了，其他道路却没来得及封锁！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9aebe1faf7b1e5650a5c183e5577c3b212c0193d65bcac94d60597d4b7206988",
      "source_sha256": "2d469909f9059eca75b88541b4dac59e855d5861aa437033c846f52013a5dfc1",
      "translation": "你们愿意帮助我们吗？谢谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:828ffcb446e2efc62d9722dc2e3081e0425deafcc0985ea0bfe6efcee87050ec",
      "source_sha256": "db9bd3a39ef6db64b25f974625b4470e5421b88ccc190cc82b917aeb2a538f7b",
      "translation": "听说，他们已经近在眼前了……怎么办……好害怕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43b4b200fd1b2952693a02a48b992bad9fb7babb7cea467e0146952abc1b761e",
      "source_sha256": "5ea585576647a6d038f67bd6cce874a46d9f4e786e1b697b5ad2c3d3c892d19e",
      "translation": "如果村子落入北部军手里，下一个，就轮到阿巴泽特了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1381e92a85590adb944f3bbed0df7dce08cb166fe3712cb4f7747b1dc69a4e25",
      "source_sha256": "6773c11cbb8a953ec5a06947516cf63048f0513a9ff4ac594295c8601e17eae9",
      "translation": "因为是突袭，没能准备多少香。就靠你们了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:023b23a4d947be02a316274baa908a3cd02099301571bba378d262260a6e24a4",
      "source_sha256": "92d3e38a7d14d0091486124f8e9a8a8bab214192ccedeafc59817bf21316f8a0",
      "translation": "马雷族的未来，竟然要交到人类手里，虽然有些不甘心……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:912b2034bd7fcb0bfd2881a52bbb028732621f0afafa53626dcf0b1fa68ac88f",
      "source_sha256": "83b07e965d77ba1b7d7f20c5dbf9f2768eb69afb14188d2bb93added3ec9ded6",
      "translation": "该用哪种香？冷静，冷静！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b0e5b7daefec4cef830e1c777f573eecc5990bf6cea46188a19f780132762272",
      "source_sha256": "7674c08e32a0544010dbf33061a77a74545ea702f2640d6e1aefdba0a78a25ad",
      "translation": "得使用能造成异常状态的香！"
    },
    {
      "id": "coalesced:8c4ab5736c34b224d6632022650d10a2bef179a667b8d4878f0953bbe7059194",
      "source_sha256": "919afc32030210dda3aa01d481aaf99553795f86de848937698dde90d77f1ba3",
      "translation": "不会再任由北部军摆布了，马雷族也要战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8591b5befb94ba3ff0ccf5642850b14e42b26e5e4518e2754e244692d3f8860a",
      "source_sha256": "19af52e253c7c22f30b823d6c516638901508a8200da33e5069e61796f809aaa",
      "translation": "哥哥……怎么办……"
    },
    {
      "id": "coalesced:b4143a9ab1b8c1dc72df9a6196f5e42231d0b03bd36ff19d4f21675f289f5744",
      "source_sha256": "791464ee5b13b4cecaf4d44d497d5f7a3d85212821369c56a40118bc1f0cd7e1",
      "translation": "好害怕……"
    },
    {
      "id": "coalesced:abd2dbd032f3c4287f410b195c657b86c8cb9d875cd51a69699ae4338ec95b13",
      "source_sha256": "7b2c1f11ec8d8974736a55e2c96f0afaeea13f8f63de1348c58be6fb219b9539",
      "translation": "听说，你们愿意救我们。果然是善良的人类。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d06a2587ac4257b8716d25ed2fd7713316f073e1484b742f1ffdc42efaee56e1",
      "source_sha256": "97c4730c1cbda4dc3c5658dd02e12eebcf603ebed227bcb086a4f6b899b602a7",
      "translation": "听说，你们要帮忙？我对南部军改观了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:af2bee7593e6c9fc83eddd1c3d4dcf42318ec4f2294cbfe83b82174f10913474",
      "source_sha256": "d8b581dbbe9705da6a5472d986039a4684eb4c138f0586bdfa7a0bb9566e01b1",
      "translation": "我也会一直保护妹妹，直到最后！"
    },
    {
      "id": "coalesced:5c479d9644684b88dc34b9e753d22493f7fe8cd75fbb067f4f1c4ed8c76e0644",
      "source_sha256": "9e0fdcc83fddffa7da8dcf795263a45c0ece79e5f0e774414571860b5ad7551b",
      "translation": "这里位于进攻阿巴泽特的路线上，北部军绝不会轻易放弃。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2c18d1823e8acdf90ec154fb973791d5f4d16ce6de3aadb740db081aad257b0",
      "source_sha256": "ebcfdad337d84ea2e4ba2e9a32c7156c447be6060548fc0cf6bf9113879f3f4b",
      "translation": "或许，各位来到这里，也是某种缘分吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:61f18194036794d8c5ff519fb0e7e9429e9486da228fcf47e886f46812d49fdf",
      "source_sha256": "073312982ec3a3eafecfa4b1d441c70fb93c5dfb2dc324d275a958fd4f6b4d95",
      "translation": "北部军，竟然攻进了柯塔马雷！"
    },
    {
      "id": "coalesced:519113b03a0139f0af5a8c65780ac5ea42b74999910a2498d83f112e14e4758f",
      "source_sha256": "488acf3e5f98fe1caf33458c984658642168b048faeeda617c48db4fab76e0bf",
      "translation": "可恶……我们不会一直任人类欺凌！"
    },
    {
      "id": "coalesced:de5210195ec18c4854bf028dae32e9ccd02a7e3486b0fa91d3910cefc802a4ba",
      "source_sha256": "f8af037fd38b9f29238a2a4be5343b5defe142ec9c302d397495ab73ffbabca6",
      "translation": "嘻呵～嘻嘻呵～怎么办呀～离村前，记得检查装备哦～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5da79e46a1c90665128bda24df98c7eef24f6adb90e77d9c4e8bc343d18101bc",
      "source_sha256": "4d2c7642b49062a2398e666829f240dface741176fb5109531f563a1167f741a",
      "translation": "出大事了～～嘻嘻呵～！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08c8d0dfbe45d20a4668ffe0139d19dd521f857f2dcabb639937b0d93fbb8958",
      "source_sha256": "4e253b475fe22c6e5493177d73575de094258b63045dbc877d62c2e0944f80a7",
      "translation": "拜托了！"
    },
    {
      "id": "coalesced:fe1bae04f44b884c9162d7da93e46cdb6903a0b5edb53a47199e6eb61be0d363",
      "source_sha256": "5f735d4099580e7c2451e31f1eb20a1e6c48932caff0c7301daa1a467976c145",
      "translation": "我们会死守村子！！"
    },
    {
      "id": "coalesced:c2ee1a12436a29db5498fa165e262a08e9107e66b5c29fb66523d715db684280",
      "source_sha256": "b67dd4737c99511b8610ed887a68d0e11d1a8c0a4711fd022f5e4648e6ba79d6",
      "translation": "越是危急，越需要休息。要休息一下吗？"
    },
    {
      "id": "coalesced:221f156cef47aaf3090d1a5de810968d058dc160723a719e33e391ae59a5441b",
      "source_sha256": "685a809d2dbb7518ac1f51bace694236d3be0feb6827f8f0b8e7e7eec79a0a76",
      "translation": "都是那些黑猫猫害的，每一天都麻烦得要命，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f643f2891206a5bd1fabf8cab9b2e10b38419ef27d2e2ad09db0d4a4b6edf2ca",
      "source_sha256": "64cffa2be3b6e7e67fb6fa9e928c92735088fc423044aaec945bd81ff57133ae",
      "translation": "请帮忙消灭6只那些讨厌的黑猫猫，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f769f9de5cb6c96c52f71e33bc00d9c0854718e33b53ec8c4ce7966d62d29b18",
      "source_sha256": "2c97d0cceb3413019033b698db8d0ebb0dd449c0b07191376acdc45fd4f25f55",
      "translation": "因为那些家伙，我都快消化不良了，喵。"
    },
    {
      "id": "coalesced:f31e1422aee56aa6353ce7f891156a303a7c7f1e017d4654ce1e23f3aead602f",
      "source_sha256": "fe203bbffaacbdfd5e7f10ed0555419b6e2148a5fa8c69361d988b0c62991037",
      "translation": "怎么样，喵？"
    },
    {
      "id": "coalesced:c9e760c9352cc85d2d04d0cad398ac6850b91e27615a000a008cbcc8c18b72a5",
      "source_sha256": "90f86cdf16cd4cadd19e9b7fcbe09dd628523241a0c55a83b490a344bf68a001",
      "translation": "拜托了，喵。只要消灭6只就行，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4fb60faf39607949141f9c98ea4c645edf11a63410f70b9ff2dba48d765110a1",
      "source_sha256": "3026559ecc864eb081cad04b74793bb58f3e94f4b79ffbbaaf9f5ddee53e1555",
      "translation": "我们也会帮忙，喵。不会让你吃亏的，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7374349ad511a1950a3fb6af32aad96d0d9e941640be01cd82738df2f14c6279",
      "source_sha256": "911f0af1c5d6136445851cb3900a2520d25e0db8cb5d666a14f0da153f63ade6",
      "translation": "请帮忙消灭6只黑猫猫，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:097b49c140ea42d2b4c2c8a0d55855ef28399f49a389afb6035b15c2608bd4b5",
      "source_sha256": "e62a483dbcb71d0eb6823efec18f87d523b77a72463f7d16610c872e505e5a6e",
      "translation": "你们帮了大忙，喵。"
    },
    {
      "id": "coalesced:ee36b7b57a06015926ee19f9ecd3259bcabe874344c2f8798980a6bfe38abaef",
      "source_sha256": "00d8c8a4d438997dd96d1e8940838630e3c00fa7cedadf0f1bce1a4873db23fc",
      "translation": "我们猫猫受了帮助，就一定会报恩，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cadc8ad6bc40b916b54ed4ad474f6d2cd3696d4f74f31d80224394596a417dd2",
      "source_sha256": "37044fb77a7fde450e6c514c2aab02b6df975c88e78ba9b6eae88670eea45692",
      "translation": "这是谢礼，喵。"
    },
    {
      "id": "coalesced:a515ab0d28105f9cac7cc4a72f1d870f7d57923f0999338ca2b4f139cf863d41",
      "source_sha256": "a4f2805cf156f76edf4f22ecfd6f52ecb2ca5553f18002ae3aecb921851800b2",
      "translation": "喵喵喵～"
    },
    {
      "id": "coalesced:296cde712a15501ea1714bc716f8de521cf0122c66548395d0c8dbc84225e1eb",
      "source_sha256": "7aa790fba7082f7b8a4656b39623c834c7193b305f94267231fc063caee131fa",
      "translation": "永远的对立"
    },
    {
      "id": "coalesced:3a4e31da9d1bbdb30b124d0c5976e18b6d1e8de5acfd5c2a3fc05be238f6368c",
      "source_sha256": "ee6a8ded09a880160376ba55d82fdfe54aa87f10ae8ba384c207958dce26efa3",
      "translation": "消灭6只与猫猫为敌的黑猫猫"
    },
    {
      "id": "coalesced:1bd6ab4f867c02399191ac8739faef52a4e0e641faa4f8335e520d0b245afcb9",
      "source_sha256": "3399d9ddee403dc370b6f36e8cc765150ade2c4e6158d4829b7f7d246b157de2",
