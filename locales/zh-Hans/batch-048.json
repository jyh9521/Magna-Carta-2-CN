{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:b91bf7893cf8c3df2eba36f3e1f716bec18f6a76e30aeabd4d028f3d59fb24ab",
      "source_sha256": "ae60e265048a014c0c4ba8c8cd41adc4c08e3b2d3596b51d2193884c7036ece7",
      "translation": "前往中央研究室所需的动力装置，现在已经全部启动了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:100e890de58ff71505d5a51cefa348abb8ecfce9af5488989d5ec2b2c9eb099f",
      "source_sha256": "2556afad2464802664ee23963994f2641d20497f0cf6a421dff34a42cb2a4e45",
      "translation": "谢谢你，尼克斯。"
    },
    {
      "id": "coalesced:1b4a33b5f57a5b86dc5fe5ed0d12d42ed32e5ea7aa19378c3540adb45c6cc049",
      "source_sha256": "baaa0fcf61a7559f856c4046d821dc09346120b569c52b1c31ac4f517cd9291f",
      "translation": "不客气。能像这样帮上忙，我很庆幸。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:719cfd3939461fe45e73576d9f8ec1d27a06e8e790a68a124ae74cf2506a10f8",
      "source_sha256": "21ca8db375bed4a668bc8f6286bd20fe11d166b395095210538658ebc22aa85c",
      "translation": "尼克斯，你现在就离开研究所吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6caed6f91b6fe464decfbb907da7ba1325cd1009d8a518b9dd60edf188568d3",
      "source_sha256": "43455dda899878e7bdc9a6486ea5847a9ffcfd8de4880bbb1ac40d40974f5169",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:263519ce08864f536fd8c297a0752b97bccee416d2a4fd90cb769bb4e53d0199",
      "source_sha256": "37d7352363b9d2fbd53c356325fa22326397da0415ea4410659cca5b79210f88",
      "translation": "你帮我们的已经够多了。"
    },
    {
      "id": "coalesced:d80b368199b2e4fc73fcb1635e7ca009ea4a2e5302ef6b62e8a78119732680ee",
      "source_sha256": "0c1d6e1a08992e420afac38c8fa2e9902831b5b41a9ffedcc0ab785d07675900",
      "translation": "所以，一定要活下来。我还有很多事想问你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce656ce167e7a9cbc35ccc8fb4d22c4e4a33fba5268503ab46d10aa235429f51",
      "source_sha256": "5596944b2ce2be6b52532868c6262aa2adf076f2304b8af880405e67af77166e",
      "translation": "那好吧。我会先销毁哨兵的资料，再逃离这里。各位也一定要平安无事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc9d38f9ce15c6f8d728877a32f2e765a2c846daa6722054ebc83da03d433e23",
      "source_sha256": "6ddc4a9fa98fd9e69746826543e122e0917f00b377c51f3eac4c6fa1397ced24",
      "translation": "这里就是最深处了？"
    },
    {
      "id": "coalesced:8efa6a227f6aa58f9bb8ceedb818f173a0f4aaa706a82b3b9cf031faa3352297",
      "source_sha256": "3fc4db739f022f4141fd18b20213cc0630d53f3401d526aceaca5263c13b1627",
      "translation": "嗯。洁菲应该就在这里。"
    },
    {
      "id": "coalesced:e3fe26a75be56bba046779ce6296bb616d22036814e5e4831a62a45a9aa89c59",
      "source_sha256": "3e97bba1813ddaa83b672276b0d2f9e45fc56b231c48f12b3143f8db652e1823",
      "translation": "敌人应该在里面等着我们。大家小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a4bb6f4a8f1951f9835bd32c537c8887fc8faae8a766018ccde1047d7d822bc",
      "source_sha256": "74ab1214f3b0a9ec9ea9bc815533f9c8cf820f6ae6df5e9c3b99f8c467915790",
      "translation": "洁菲……"
    },
    {
      "id": "coalesced:8a9b190eeb0a233196541ab53e5f1e0490bec226e8a503640c446320b0f950d8",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:558888465a5f1c2515bdd2e8ee98dfc42bfc9361073757fd75016056257e6dbb",
      "source_sha256": "15671b7b96decfc3ef70104c7f7c7be3852bd6805e31ace71bdb9f102009fc91",
      "translation": "公主，你没事吧？"
    },
    {
      "id": "coalesced:414c6dd5abe941a6b5f70dea9e50a1c272fb8d964d5a8f3b155f36a64381f5c5",
      "source_sha256": "f768c6984ecb9c0c1712c111b30eddc4d05b43a054c7424a5e64bf941ddb88bd",
      "translation": "你们为什么要来这里……"
    },
    {
      "id": "coalesced:b4fe0403b81bbeb5cb7a71dcea09dddd280af5781ee2d3b37862b74fb0362e17",
      "source_sha256": "764e8ea8e929333d15f7ab768fa66f7f27b31ffe4d6704a0713c333f27ebb41b",
      "translation": "当然是来救公主你的。"
    },
    {
      "id": "coalesced:efb804dc647aae401c9bf46ac8189707d3b83b68783fcdfe07abd6674141dd9d",
      "source_sha256": "4b88c008bd6a9a0cf21b645f9817872c52840985550d71471c6a3e78d851e260",
      "translation": "回去吧。"
    },
    {
      "id": "coalesced:dadad26118ee3eb640418e265169bd6339c216736742856b82860103f1e3596d",
      "source_sha256": "0e83dd9bd87c0f37e2759ab8f6a345631ecb026d432f1c50bff856edde480183",
      "translation": "公主，您在说什么？"
    },
    {
      "id": "coalesced:1c9712e2e8454c282a7f3346c8553e8271f95f3857ef5b4fae25b3e12b58162b",
      "source_sha256": "7b4da08ac0198c6227af2686c4eadba71de749f411b2445a1e995b8efdc22c01",
      "translation": "反哨兵部队从今天起解散。战争已经结束了……都回去吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fbf7e09e2389ec77d6f71d802465b9f08b30927bd5bf106651bdd26bb746bddf",
      "source_sha256": "2a30e03780c402a98bdd1271b0bcb58937d8abbd66167585e1a60f3b37b8cf0b",
      "translation": "洁菲？"
    },
    {
      "id": "coalesced:8b06ac5376f85e828c6172066229bfb93a134b204daa00ed768842bd5fa2db2b",
      "source_sha256": "f4af105aa132020ebec67c2e4941015ef6c7cec7a43a780b0f21e9e11d37d70d",
      "translation": "终于回到家了，感觉如何，一号？"
    },
    {
      "id": "coalesced:c70265c0db5dc56e42e959dca42545d59cbb00b0a535d25c89748bf61247c630",
      "source_sha256": "c7fea6e94eb6ff620b2c78ab01a6ab7d945f2cfed5bc5d41c874563ec01f0eee",
      "translation": "别开玩笑了……这里才不是我的家！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ff6e8a02c1e110ad6f22c17d9a1785364a1acff42235c4163a1cf034303e3d3",
      "source_sha256": "2943f12eeaf39f7de1b09e264b1eaee38fe7c9f03ee29958216e8947db73dd0b",
      "translation": "呵呵，真令人失望。这是你对创造自己的主人该说的话吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f81be8dccede2001475e3e50788d06bdb9966e1be4ab07b9f09a9da79fe7dd17",
      "source_sha256": "b073442fac7807a58ef320e7028b1a89712cfa530137d4565bec125fea733515",
      "translation": "你把我当工具利用，还妄图夺取王位，居然有脸说这种话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e3b798a7f1084a14376b77f034706be2a827915441737b70144fa2399c5f6ff5",
      "source_sha256": "16d80c5b62fcbeca64a079fc6b536afd18e97a827af8b73aed91e40b0c5bad6a",
      "translation": "王位？我对那种东西毫无兴趣。"
    },
    {
      "id": "coalesced:063dbbb951ff0c49a9eb7137080db2c1ce6cc1212b7d33512aaaef052a914ddd",
      "source_sha256": "62d10590730295ebaaca08a138fd65094a1a231940b1edd9934d40618a7b6067",
      "translation": "那你为什么要绑架洁菲？说洁菲是玛格纳卡尔塔，又是什么意思？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bc85ab68433a5013b7c742e5a18b1f6398ffb0e229607677f7bc6874d7dc90da",
      "source_sha256": "5b6841a571b32194ddaee90e79e82e1ad3dfa3e428f36a038de7d73377e2da40",
      "translation": "就是字面上的意思。我们的公主，是能阻止灾祸种的救世主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:812f5d34d60976a4901a609e168d60b46adb342ab8db992f322c21ea1f79faf2",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:c446a009326f23836d0dd3296ce7b9ecd2eb33dfb91d84916c6662895d30cbd4",
      "source_sha256": "26f55e248face1b4ddc0b725c0e7204c37110315cb6c5804ddd841e2ed8349a4",
      "translation": "这场战争……是为了让她蜕变成更强大的玛格纳卡尔塔而设下的试炼。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7662de269c8d014f9101bcc8494cd05f7f1c2fbb29500f2e6806b60d2f29cb44",
      "source_sha256": "cc8567d48fd42e89414bb54d8089af052696e18bc14bb9366011c6e91176c8b7",
      "translation": "你在胡说什么！开什么玩笑？你发动战争，就只是为了这个！？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76dedf5aae14157a0f57ddd40a39ab81a615087b1d95ef908ac925770f63b6e7",
      "source_sha256": "3334213169d960abc63ef95f96f12b06f8d4fb99d86aa0b1f5afe79dbf95463d",
      "translation": "够了。不管你的目的是什么，我都没兴趣。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3339a389f3803ba93b4e5e3bf823b6dcbf3417bae9aa40092731c490a8dc2736",
      "source_sha256": "0a931d6e33e7251dc668204870e95c947c03cc654d64e909301205df5aecd267",
      "translation": "我要带洁菲走。"
    },
    {
      "id": "coalesced:771afb6c2dd2cc00361e3cb9533ac7d6f22abda09db301964bc622931d4bd877",
      "source_sha256": "dc06d201846d461653bdb86e521024751021c2d0900d11c8d68cd451c82a8878",
      "translation": "呵呵呵，不必着急。你的对手不是我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4f54c7f88f39dd345de1bc58110d763d71e0dfbd8831e8e6747efd8eaef30e5",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:3b1335d3895fd97ca3977e4cc8a70e71c0933bbd1931c2487d2b267e0622cc72",
      "source_sha256": "7598d996d6694c3ba84de0eed499f6d3aec749dd2b49d919a2b947aa8393878a",
      "translation": "我等你很久了，一号。也该一决胜负了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba8b85eef51ce664fa4a6f3841d89e2768e528194b984f17f70b809546684951",
      "source_sha256": "7361201d84d84ff759832497469dfa97d8130e2b475d69e22b3155ee95e72b1e",
      "translation": "艾尔加……"
    },
    {
      "id": "coalesced:9682f2746cfb09f58a00ca6963e7d396dde5ae11ca4bb6fdba23146982eb21f6",
      "source_sha256": "4195ace5cf09e9571c5ff378feeb1860c470452529a7472cb675832ba5e886bb",
      "translation": "我已经不是艾尔加了。我叫朱特。对艾尔加这个名字，我已经没有任何留恋。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19a1db869cc7c71a9f038e1bcac86c32f76a4e22f249a9bc83a9a00e8874964d",
      "source_sha256": "3ec0d8d777561c420613d46d3789f6f780779eea116f95bfa2bb38f1a7dff8d4",
      "translation": "是吗？那你就去死吧。同一张脸，只需要一张就够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47f22eb21c96deee9a7881ec050ee76ba8c3572918634416edb6dcfae7b5052f",
      "source_sha256": "4b52478b7d0935f3aa23ec89c5a3f632cd2732f348cba405b5f36594391e58a5",
      "translation": "艾尔加，把这些家伙全都解决掉。别让他们再来碍事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7e5ead478b8ecfb2844dee936612b26035a14ebd003390d56c6c59f3d5af608",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "遵命。"
    },
    {
      "id": "coalesced:4eef849e1a676ff2932a0255eea0f9b53cb2389fbcde052ee3e6bf64946efa08",
      "source_sha256": "bdf94022ab30464a3dabf5220c7d7a70e3cd9b492911b63843b491d9ff44635d",
      "translation": "呵呵呵……果然，你才更像真正的艾尔加。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:32a9b7d5fdf2306746dfa73f2cbe536ee3134cee5eec1c113de1414a0493e1bb",
      "source_sha256": "7b65a8023da23831fcfe7c6550544b2d85501ac33709729f05b3b3f9e0cd4eb8",
      "translation": "站住！你想逃吗？"
    },
    {
      "id": "coalesced:00f20afe46ddd0314ed862d5d3ec99e8e9cf53a6b2bb91439cb3b48a9dc968bd",
      "source_sha256": "504aec1de48b8948edfdfc9a394c2c058b5c310f853711b76dd6b81730beace8",
      "translation": "逃？呵呵，真可笑。我只是要去办一件重要的事。和公主一起。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73193e9bc80cc57ca9b6e965537d66685c1d9bd852a9bb1611f24036f85cff71",
      "source_sha256": "5e8975286fe7b4f57abb6bf8233289493b7f60a6739d94e3a816f6c11269ce1c",
      "translation": "洁菲！！"
    },
    {
      "id": "coalesced:76e07ac19ff3e0a452a8838efcff9374a1c49eae7f153eb73814c52231c2ae3e",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:8817e1dac1f1b75bce4aad929979270cb5a6d866d357bb64178f37e428a0e07d",
      "source_sha256": "7c029ab92693b0bace3d4b401fd520568c0660bbe3def1b40cdc08967e242cde",
      "translation": "洁菲，你到底为什么会和修恩扎伊特……！"
    },
    {
      "id": "coalesced:e2cd8582650a14008283e431792eafb5a3c450f11e4d78e42d39a38c6c6ded69",
      "source_sha256": "3fbc1ecf4c18b8eef2e58e188674d718177c45d1dc7c27c356d6610b57144f54",
      "translation": "你的对手在这里！"
    },
    {
      "id": "coalesced:81ffce5802225c3d39138199dc2e65c2610a7ab706d89df62dfe077377016426",
      "source_sha256": "90707e2706794ad2c7b5f0f8c2eb24ab205e272c7984b0ef060d66a71db73a48",
      "translation": "只要你消失……我就是一号。"
    },
    {
      "id": "coalesced:1582f76d4867ee8b5710053583e0ba8b9a14257c9435f63b401a1311b83ec734",
      "source_sha256": "c7ddbe4c3a51e5a003f522944731444d2608cd17fc9b4bcc9708c3bff9cb9495",
      "translation": "一号对你就那么重要吗……？"
    },
    {
      "id": "coalesced:18e02ec822f982a562b71c1c6b1be7608ced728a7a7400ffbbadc95ccaeae34c",
      "source_sha256": "d1cd33fc2f423560b8c5306f5dc555d59cadbfb8564440f3ac8533d5db46fdbc",
      "translation": "你为什么要追随修恩扎伊特？那家伙只把我们当成工具。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f807c56fc0a058ca474fc2ea930df9e826453dba01feb4139a9c7abd7d63e0a",
      "source_sha256": "eba61274bdc287983e26ed8073028399094b27d8955dd505eee82b6cfed1977a",
      "translation": "……对我而言……他就像父亲一样。"
    },
    {
      "id": "coalesced:9cd2a16a3f324fec93b0e58deae2afc7e06040e58bda1af062c99919e58ad089",
      "source_sha256": "d21222c3ef44787040cf42308ba68b97ba70b50c165abf5f20823adb433f66f7",
      "translation": "要是没有你……我就是一号了……"
    },
    {
      "id": "coalesced:b01cc14da0598b372f91a750be31baf6dd8fa919d18c314c8b56409b2b59de7d",
      "source_sha256": "1dfa9cd3e10c41e1a010be2a11f60af60a65cbbb9265c147ec166e6362ead895",
      "translation": "我已经不是艾尔加了。"
    },
    {
      "id": "coalesced:39b7a03f7bcad35cfa269883a65e066d196fa7185519d162a26011422a08cce8",
      "source_sha256": "901f9b13cc4ef7d3c8e3e66c01146f7e3dfd7d01c9c4e839eb3dae3ad9eb02dd",
      "translation": "呵……反正，你也救不了那个女人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:946a1f891255ab9d81e7753816b0e7340f86eafa20df8c12ae669fa5c428939a",
      "source_sha256": "92d197e915219bf018dd746ae3451574d394e1ab54a2e9d29ecd2ec23dd7b601",
      "translation": "不……我一定会救出洁菲！"
    },
    {
      "id": "coalesced:81a92e63d779f6259dadbb70a895f8576cbf73643ce22d8a9424d9b1b50361da",
      "source_sha256": "902e91c40a881ab48e64e3d203f6dd9e08a6e4b6ffd2e4efd95149a731a06c50",
      "translation": "呵呵……那就用你自己的眼睛……亲自……确认吧……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c2961510063a4276944079abdec8c50c76e88466cb47020ffefdf8f1fe477dd",
      "source_sha256": "75774cad342ee5df7b565e2e2cc83f6f2c99653da827f92870c97b7699e9b6ea",
      "translation": "谢谢你们救了我！我相信各位的实力，才来拜托你们。求求你们，救救我的妻子！！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c6e7ed3c70ffe6c3394ab70b695f4a27fb5bfd1ba4e20ac3863e1cfc6e6c8a2",
      "source_sha256": "0b9495dec3743f3165f923a3cc86d99715a9b232f040bff439e7e5127d54ecbc",
      "translation": "其实，我是南部军的情报员，负责传递贝尔福特的动向。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7ea3fcd6a5b5f3dc9b65a58e824cda38628a33ba58b994aca12f3233c12d975",
      "source_sha256": "d94b3247bdeeab6cdb6e9ff4bf96dbb2e2774e89986a8704e7f9a6f2bc77c8f3",
      "translation": "可就在几天前，不知他们是怎么查到的，我的身份暴露了，被抓到了这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c0b104f5361422352f83d66facaf9e8d59a1b44c32d51f097163fe427fb117d",
      "source_sha256": "7bebad657479eef46eedd0775ac0f7fbd5eb73d1853a5506b2cb7535f75822d2",
      "translation": "据我所知，这间研究所会利用人类和怪物进行活体实验。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e15e3e67a06bbefb59567fc5297cad9aea608e574230c1865d8db6a45d36e95",
      "source_sha256": "b54d9fddd05b72edb02569f7930563d2ccd02ce334529a1caaf816bd770d07b7",
      "translation": "我被关进来以后，北部军不断把这间屋子里的人带走，可没有一个人回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:180d652fca02d36b924f1978598b59236cd77084d7675fda113c0b805e91c4bb",
      "source_sha256": "472ab2ebbd7a9354eda390cc70a3e1494d55ad25838840bf675fff75ffb10d64",
      "translation": "我和妻子一直尽量躲在房间的角落，可就在刚才，她还是被带走了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:865b39a6bda1e3bcab0ba3fe62e6214363181565c211da668a731c219412860e",
      "source_sha256": "472107ea9e3784b889317e19062106d9392d293e857c40438cfed42cf0fe8fff",
      "translation": "每次有人被带走时，我好几次听见北部军的军官吩咐部下启动[制动装置]。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ef28f2a7e8b2b18d0f5c8cb83d8cfbfc0c922d098d1213d8f2f713ed916fe38f",
      "source_sha256": "9beb8c65b328d1d5caba76a15e7c3edb4c200f4e35b098d1d488ec53d4b3604b",
      "translation": "只要关闭制动装置，也许就能救出我的妻子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddc3e4f0685022695c25a14641f7444a1ae75fd7ec0fe531368299838ed7d35b",
      "source_sha256": "295c23a7a073db482c596b24a7caefc00ba80c7cbdfb3736526c3cb52c9f7937",
      "translation": "北部军把我妻子带走的时候，我听见他们说[今天2小时就够了吧]。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e2eb1539dd13328627044f9d4b9707737361eae0adc5bcf712c7e3c1011bf8f",
      "source_sha256": "31573d1b86c077646ef75347ea5e7d57ecaed0acb78c13eac6bb0d98605ccd22",
      "translation": "现在差不多已经过了2小时，求求你们，快一点。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c814eb9937c0b8a62b78365fd0899a3131f0c6aacc903405b7608abb376b5932",
      "source_sha256": "c3ef3b0614eaf28e7196462b9f5245044b582fe516bfd601752be849c03f7408",
      "translation": "我一直被关在这里，不知道具体的位置，但一定就在这附近。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ec532275aec4e71c47425844413d4151a0c2eb9fe412bbdf70ead92aad76073",
      "source_sha256": "1c8bf3de920ffd12acfad3d7a2c2660cbfd76af0f798fd879fc5dc9363c14d85",
      "translation": "我去找妻子被带进了哪个房间。请各位去关闭制动装置。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1885dcf729b3243691ed69d50eccf5969297d0037886f6a96b0fc9f72ca6cc46",
      "source_sha256": "c847d2910387e5e1aa414972b525155e374528baf06aa3b3b4b0bc82eb1ca1cf",
      "translation": "我一直在为南部军效力，你们却要拒绝我的请求吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3963bd920a31c06502fb6def4b6d3caaddfd9922ddb78dbdec15f7e34a196b71",
      "source_sha256": "58f2191dd5eb405ed0f6882c49e8f15a0876becac28f97fe6c54c9d32075a3ea",
      "translation": "没时间了。请快一点！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:37ef91750b3efb15e99da7f69f1e198f4d0f8e26732733983ca17359c2d5d2c9",
      "source_sha256": "a0ee4bd0619a5e901371b8f85f208c65c8111e3529c23ab6495b112dc8e24e9d",
      "translation": "没时间了。制动装置也许就在第1研究室。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a5debca8c8b92aa548b5e3127985fc4c1fd5ca633f35a06ec5dc6f45b499934",
      "source_sha256": "cc971f91e1c1fd8b6bc61f08b0f5de069c29055996c8d28a0bb0424aaa388c19",
      "translation": "多亏各位，我的妻子得救了。等她醒来，我就带她逃出去。各位也请小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea986494188718370d8532eb33d531d0db3d471f1bf0699e4ef521a1384a7c4e",
      "source_sha256": "ec54728eeafe37cb0fcbc3eaade1de28d882ad7c1ed5b3995e0752cd71f1946a",
      "translation": "这是我偷偷带在身上的东西，应该能帮上忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6bd487b9a817c18b9026fee0fcc670d4108fb2feb82baba54f1bf6216843419e",
      "source_sha256": "44cd06a5228130617c11c42edfc22cba5feb6296816ff488a897616d37bdc3e2",
      "translation": "我的妻子……呜呜……"
    },
    {
      "id": "coalesced:955ae7827099b55f42112bd5a0e51c49ffeb441451efcc577240621edc7a4aad",
      "source_sha256": "3a7fba4c725a38ea09a7e5fc9e1fcddc1b055456eee72887d1ea2dedf27dbc08",
      "translation": "这场战争夺走了我的故乡，如今连我唯一的亲人——妻子，也被夺走了……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e0502ed17d57ea67a0991451d26c250ca871bbf606dc829a7ad0c5a0e835279c",
      "source_sha256": "06dec07370840b5610b5256080955a9fe314ff5e6f98e097af7a75fd93e12830",
      "translation": "为了救出被带去进行活体实验的巴尔福之妻，\\n必须关闭[制动装置]。\\n\\n制动装置就在距离当前位置不远的地方。\\n限制时间为3分钟，超时即为失败。"
    },
    {
      "id": "coalesced:0f520ef1bacf80d419a363da45d23019aeb5d18d689d90753bb7d40ecd3b6024",
      "source_sha256": "323c14678a411e3a7364de929ba1b3ee167e29e4f23b97635d8068c83ee045c2",
      "translation": "紧急救援"
    },
    {
      "id": "coalesced:b5f28e73ae0974a317ed3787cfa74b023d95ac41058c1c1fbce543605f006045",
      "source_sha256": "798dc721d897bc3d62a43767337ddf34777632e85676a4cb23f10b0b9c07d7cf",
      "translation": "QUEST%s：关闭制动装置"
    },
    {
      "id": "coalesced:a82e29d6243fe46344b6755161ca09612aae437df21f44650271415ba3cd59ae",
      "source_sha256": "9e5f3ffceb381e40e6416b6176d5bcac841c000ad8a3cb6c5f49a5036cd7a8ad",
      "translation": "听说要停战了，是真的吗？据说南部军的首领来了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ed074d1eb5d095d93dd104efc36b662931810dcce4b05ad8c79f073df0585c9",
      "source_sha256": "f3eefcd7de6d28bf15118216421740a2d657ae8a290a662a59637705aa0f6f9d",
      "translation": "听说亚历克斯大人是为了停战才来的，是真的吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c66e19059c4c6ab7a0fbc527d629e17b15f2385e761850022760e2b33c6d54f",
      "source_sha256": "89db01f974249a78c339085f7b1b116d6ad18675c9d6f017139d36d04d76fd13",
      "translation": "战争得赶快结束才行。再这样下去，贝尔福特就真的完了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c823016442e94da9fcc54310423daa9c1573d3d60f5312975853a15e8de87177",
      "source_sha256": "8be04a8db59ce5a627e1e8f83744c54ef738c7bd4ef0f8806ded529259f834b9",
      "translation": "战争很快就会结束吧。"
    },
    {
      "id": "coalesced:7030a215f8dc7871413add7655a73df6ca989beca1df5cbbd8fc5b4b70b02861",
      "source_sha256": "fe2ca8cffd2ba1dca3ae5ed3c1ab8e057922e54d3ef5ececd2cc8058cd1992d0",
      "translation": "灾祸种要是一直下个不停，就再也没法生活了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1627d255d315488baecca9e2ce1bfa8c89539800b76aa2eae0715153d0d9246b",
      "source_sha256": "05314efeeb2a6af8e65998c42a5998374887ac841947fd40dc4fde82e5f6a88d",
      "translation": "战争结束以后，灾祸种也会停止吧？再这样下去，真的活不下去了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9166f595ca4178c5a253276ac7cee1999762c12a58452ad833307aa66635c07",
      "source_sha256": "ceab65bb3fa7c61e3963f499026302b8d68ff6ef8ca05ada80cffed27a92e766",
      "translation": "只要战争结束，一切都会好起来吧。灾祸种实在让人受够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9909e17aa7d811d6da4490061773d6f8835535f538ce3bee6b4b4dd5d66b5cb6",
      "source_sha256": "eebd62d1727fd5089ad8fd110f7ef3cddf35e4215e1eade6bbd75ee27cc324bb",
      "translation": "亚历克斯大人来了，公主却没来吗？"
    },
    {
      "id": "coalesced:b11cd1281e363d1f093788f21bae183ead9a2235902081d82fe7a6090d38e7cb",
      "source_sha256": "dd245afd84db6bd4a0cd0c1453476e19df8e6a3cde36a4ea581866f6d74071b7",
      "translation": "应该很快就会来了吧。"
    },
    {
      "id": "coalesced:4bdbf64c06b56e6146a2627b92b1f14c8836ab496a155a3d45dd7e5248787e9e",
      "source_sha256": "45c6ab1e5f8d23e88cb5dcaca0d927183c2cdfc5a1385cbd30e3aa1324e7ce6e",
      "translation": "真想亲眼见一见美丽的公主。"
    },
    {
      "id": "coalesced:599c43ece296fd215ddad3a2f090d6bcece89e37d8cc25c5af0f45ef07fb66f7",
      "source_sha256": "5d0738f737b589ac467e2a0cc83ae6bd17c48582f0e3d3740605be8705577530",
      "translation": "请一定要把公主平安带回来。我先出去，等各位回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55e9a35c3d79bea3402805d17359a03984071bdb54872f5b0f7c034b1397204e",
      "source_sha256": "0be8a10310e481bc2ee6f3f6cdf261702fc237d78f20f937712c5d31013d4952",
      "translation": "巴尔福"
    }
  ]
}
