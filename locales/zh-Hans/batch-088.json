{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:ab4d924f83351e94ef067cbd51565705a033d8b2b58196f0123c0e21792d49cd",
      "source_sha256": "3af38e8cba2b5f5591c3383735dd58e16e133db34b8ee4510ada4e9794ec45d4",
      "translation": "啊，朱特，来得正好。"
    },
    {
      "id": "coalesced:c37dd4a70da462e313d14e285288b5fee6c44c910f928d96d8cef95d2e630055",
      "source_sha256": "b8827c028d030edbe22d9cf6dc78862652f170b0101827afc9406d7645afc5c3",
      "translation": "得给去森林里干活的人，送些便当，可是找不到人帮忙……嘿嘿。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b45d7a9578fdb57ac06174438d2fd699bb534136622dfc8a37301e7d3e514b3",
      "source_sha256": "9d6adbbccc27db0514bc66b6264f7a416d685e0a871feb9edee05b00c27c6d34",
      "translation": "幸好，朱特你来了。"
    },
    {
      "id": "coalesced:c9dddfaccaa531ea3803f862af1cbc4144daffb5872469e49b57a5cbe87eee8c",
      "source_sha256": "b2a030bd93cefbad41f6da2348420a64212e6a01ce4eb8ba5a1c1bff25f3cd92",
      "translation": "不好意思，能把这份便当，送给在青灵森林工作的[哈曼]先生吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8870082079145ae3c9c87c8c60024f6588e92800a1c767eb28798a3558d40bde",
      "source_sha256": "f6e24add1870debca4a740314e15660fecbe484fed580e256059fbe12074efba",
      "translation": "大家现在，应该都饿了。"
    },
    {
      "id": "coalesced:f01bce9b8bcf0ecf2445cd6e3a5fc33962cbed48c703f020492d13095bf0c0dd",
      "source_sha256": "0de0a26bda21f2a0eba268d8f6c3e8ba250f776fea4f37b089f20b8d6ac4a886",
      "translation": "他们应该都在森林入口附近。从东边的升降梯过去，比较方便吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1eb85d10dbc3f2509554e23f32b1cf58dc296528dc31a7ef6227c54feb984dc",
      "source_sha256": "5ddbe72547a85d87c0c01a4bd43041ecc831055e63fae4400959e106bed95877",
      "translation": "朱特！真是太让我失望了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9652d6e320c31d3fba84d40d401abdd5651f6b8e4b9d100683d02be3caf319a6",
      "source_sha256": "0de0a26bda21f2a0eba268d8f6c3e8ba250f776fea4f37b089f20b8d6ac4a886",
      "translation": "他们应该都在森林入口附近。从东边的升降梯过去，比较方便吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13da3c5ccd855dcc12544ed9451a8041abc9369eaaa50bc1e064618f815ba0ef",
      "source_sha256": "c45dba299d4ead678b34443f5186e42b40c9ca45c8deafe5a925165eb36416ce",
      "translation": "啊，终于来了。我都快饿死了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c74c9e1b5de9025ba7de476614b26efbf353045a2a5977582b6b14e080f3049",
      "source_sha256": "d2e06ab479a3baf0cd9f534e74d099450645f982a30f4513d328c0af1ffae832",
      "translation": "先不管干活了，得先吃饭。"
    },
    {
      "id": "coalesced:ec7398603e69db39b74b10aa0ebb2710f92e3c836584271f2bb452b74e685557",
      "source_sha256": "91f3c67a76293d772d48fdadf3408e0d42c1afa0c37d908e8c299678973875c1",
      "translation": "请将莉安娜的便当\\n送给正在青灵森林工作的[哈曼]"
    },
    {
      "id": "coalesced:45c95083393b70b7eb0c33f9bbbad62f2eaef2a1440b55dde49ffd85ceaeaeff",
      "source_sha256": "554e51236275b9f26ab77644a778c16c66f1201465a208454efcdec89b0d0b62",
      "translation": "QUEST%s: 获得莉安娜的便当"
    },
    {
      "id": "coalesced:42cc6eee6f0ffabd9f6e3f2ac52713e4e87a93eb291775012af8de91da320677",
      "source_sha256": "5ebcb0b3e8e79661ef6675cc83cd4ce9108cd24dc8d7eb252e4a1ed397bfabd4",
      "translation": "送便当"
    },
    {
      "id": "coalesced:9c9ef9a241c316fa7133d5df35dadabb213b4a4a6e3a26049450d0597f524da9",
      "source_sha256": "2577ad3e8ac35ab8d7df0d1f5fc7344cdc062dee01f04c335ea90a44d7c5fc7f",
      "translation": "朱特，不好了！再耽搁治疗，大叔就危险了！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ed7ba0f95ff87e3d3d87c15e6d0d03f2ed8bf7581d433191ec4f3de3873f37b",
      "source_sha256": "7e19e8b19c3ad4963ca5cc165f6c8393ae58cd8830a62a71b53bd7c9d657c402",
      "translation": "啊……要是有利安达尔果实，应该就能想想办法……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b036411df1c0520dea21b8a9edfbbf6ceabb317bfc4dfbe5962c096743844701",
      "source_sha256": "bd66b1dd5894c7e24dcaedc442344e9f364c9da0c02a2b092a393071550a6700",
      "translation": "可是，利安达尔果实附近，栖息着玛玛蠕虫，实在太危险了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3c275d2432454bbea855ab5bd04415c6fbf4e3979374b4d57499f6a159f4609e",
      "source_sha256": "1547345d9d39bee1737bc9a68120fe551eb414be76eef632a2cd0e8b2e9d27b7",
      "translation": "我知道，这个请求很勉强，可你能去青灵森林，帮忙找些[利安达尔果实]吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:984d6657722a156442b42d174b5c4637e7888a62ae1e6b733980e57e937c695e",
      "source_sha256": "7f8646bbc15ea0ee44b3b5aba632acfdbc897cfed6c1fe42e2ce0add65f2b19f",
      "translation": "玛玛蠕虫太凶猛了，单凭我的力量，实在……"
    },
    {
      "id": "coalesced:61ce11f7e1217175973d5cf182e8790b41ffe62de9901e38e03b468f4eac3aa0",
      "source_sha256": "1ce4e6c642ae1fad531ae87445cadc7ef7088b6d9b79fb9433dbc23fcac018cc",
      "translation": "再放着大叔不管，就危险了。求求你了，朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddcbee5be127f8737db147754e8de06bfeb61c77ee0179f1689f43724a0e0ec1",
      "source_sha256": "b0b8bd9fbd8ad027e649665cf80d6871814d771ddbbb355a2554b5fc6179af15",
      "translation": "不好意思，请快一点，朱特。时间不多了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c6833343bc8f1ba09c6c41bf69a64c32f921b7ef191d48dd8fa4d44ae953996",
      "source_sha256": "c7d0eeebe3d2ad2b59c6ab9fa5afcc31e3b2d7a42c8d0d5e2f17b8db95bcf262",
      "translation": "啊……再这样下去，大叔就……朱特！求求你了！我只能拜托你了！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d239ffc6839d20830b0e03ff06ed0c0087c7b557709a62a4266759b8bfbacac6",
      "source_sha256": "5552e7465c0afa22679584a0bc790652f0aa186f572960ad6435269c84c49e2f",
      "translation": "去青灵森林，找些利安达尔果实来吧。得快一点，再晚，大叔就危险了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4c15c01621d841643939afded2064e89ac6ace9688b58167d23da2a735c566f",
      "source_sha256": "2e72c0751fad01359564c9fc2798ad0d69045fb6279873e17182059139447158",
      "translation": "朱……朱特……呜呜……大叔……大叔已经……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80d4abb30f55bb7c0f23a72e5713f3c3274dc59d91666d85abfe38b145cc3bb3",
      "source_sha256": "eada419aceed2451ab8b77ceab0a7ccbd94b302b9088f06e0422f65be8d9892a",
      "translation": "呜呜……呜……"
    },
    {
      "id": "coalesced:76a29e5e3b6eb289783a2b9d938cc6df442e67976b1df0f78324549c18f18054",
      "source_sha256": "2717a6095b1cf588de7a17acbab44ed0d58c822a7b48bca6a209c040fb1b23a2",
      "translation": "为了调配治疗药，需要[利安达尔果实]。\\n青灵森林里的玛玛蠕虫，角十分危险，\\n带回果实时，请务必小心。"
    },
    {
      "id": "coalesced:657a396b678fccb5cc0291b3adb70ab9fe8088857e81c8266e4839ea9c6b7429",
      "source_sha256": "dd30e61f9efadf4aeea60ff4a7ab327ca32d73fde3c954a2af634b5d24beec46",
      "translation": "QUEST%s: 获得利安达尔果实 (%s / %s)"
    },
    {
      "id": "coalesced:609be88c187e7016b95d19b3215aa982db7860bbb5d46954940ff48123bca9b0",
      "source_sha256": "bcc5644d53fc84697178e210d1e48adf8ab214f223bc0071448ebf3bc5c56cd7",
      "translation": "利安达尔果实"
    },
    {
      "id": "coalesced:d30518a2a72da5104134fb819a8c591efcaed1bc843fb13d17579dd4c824931b",
      "source_sha256": "db37b7575cc10859c78c2a27deeebc63a509d42629fdb1496c6f7a1a1bb659c9",
      "translation": "呃……我……要是，我能再快一点……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:540dc8f6741f29bf81a3e35590ae9e41fbeab0cc2d84791e991d7086592108f8",
      "source_sha256": "5cc9eeadcf6ea6379b17362168ef41a68483af1c1369dfba00e629963700fda4",
      "translation": "爸爸……爸爸！！睁开眼睛啊，爸爸！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66391595744e5651f2a20c83b2b4a8965bde3adb7a3be83571d160f46822c528",
      "source_sha256": "9d7b2c9e9aa633aba759dd295c2b8ebecf7ad5f9b8c0c173c9740e2483b051cf",
      "translation": "呜……呜呜……"
    },
    {
      "id": "coalesced:815da9d7a8446f42da944fc578c00cf83359f11a3cce54eb25090dad05394723",
      "source_sha256": "edf2c525be58f0e7543567d3edeab3b825a66ba72aa87e93c857d8296c27c2ea",
      "translation": "哇啊啊啊！"
    },
    {
      "id": "coalesced:817353d5834abc765593b0b1d87fc0a8f4b742b87780f8eb48bdf5b34a1b7e8f",
      "source_sha256": "bcc5644d53fc84697178e210d1e48adf8ab214f223bc0071448ebf3bc5c56cd7",
      "translation": "利安达尔果实"
    },
    {
      "id": "coalesced:ffd52f90c904679cf0dfaf1c91ab86e7fe2118df4789a4b1802d494cbbce89c2",
      "source_sha256": "00843939c1c518b9f10c60434b62041edfb74e9a27ee0e8debc738bdb1dbd6f9",
      "translation": "呃……我……我要是，能再快一点……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:61389d321ad4473e0580d5df2b0aa97783eff9f2a0b3021143bcc520fa2562c8",
      "source_sha256": "747b2dfa0923f6c17c570d4eb90352b3a1a1c32b0a4b6293fef3c09c52543927",
      "translation": "莉安娜"
    },
    {
      "id": "coalesced:8cf3e37e47d94c6419b43535d81a7cfc8677afb0f81e36f7790983706f3c35f2",
      "source_sha256": "60abf27ebc4419655a92d788170ec2fa48ab1517b57a252e2b7834cc3d9dc05a",
      "translation": "哈曼"
    },
    {
      "id": "coalesced:a4f14fc5d32570023d974270d9ac0eb5e4f48096e13d52c9b5ad487e18b34fe3",
      "source_sha256": "0881206830f3d745cfaa5c6253190419f355a1e534d357927429206fc571e073",
      "translation": "便当 "
    },
    {
      "id": "coalesced:952aaab326201de98d45c13a9bc61f0269e3e6412bd5bc0caa91724f4ec39700",
      "source_sha256": "c703402ebac9e142ae6e3ca04531eeddf30965e9adab024b4288d8c0143e7594",
      "translation": "莉安娜亲手做的便当"
    },
    {
      "id": "coalesced:c4e4052e56378bade6e305df1b3ddce05b1761bccebae8bdecb844bf834756b0",
      "source_sha256": "461b9fe9a967af13e4fe2081abd5c5368d69e7412c5435391c7c7b42bcb12893",
