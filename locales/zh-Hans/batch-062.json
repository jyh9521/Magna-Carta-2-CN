{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:9236911412b38917745861c8f5d478eb0da43498ff00d5009e68894a4254d8bc",
      "source_sha256": "1faa75d7873ee69f9f4694a6cbd5e2b24f4c1cf8e63015c0b65da8a0987b00e7",
      "translation": "现在，马雷族的连环术师们，正在水色湿地东西两侧的路口，全力筑起冰壁。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c2a1c560520c12f0be822a0dce9680dacf6ca8bbbf8a06f26cf78fe0cba35de6",
      "source_sha256": "b71862c387a8ea7b1cec1c2c04597ec290aefc3f04fc50f515d8315517ed0711",
      "translation": "可北部军突然袭来，我们来不及把冰壁完全筑好。所以，现在还没有完成。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5744eda5e4816e8a8cd411b83ae20f78032b91bb02bd1b8c27bd8c7fb9c0d611",
      "source_sha256": "fbbe549297c7036ea20a33c0bf8b1a7665b14bb5585d1f34ac03c028841b53ca",
      "translation": "请你们掩护各处冰壁旁的马雷族连环术师，别让他们遭到联合军攻击。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dd61d0079181bc8bd5b48d4789364198eb65291d68eba29ef8230911206329bf",
      "source_sha256": "62b3398edebc9094679eff27f869694e6d04235c2780d3d9d91a4f92c3b3201e",
      "translation": "等东西两侧的冰壁全部完成，就能暂时挡住联合军的进攻了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:70ae5a22304c0ab761c8cec3c64893cb40ee5380b46c064fba731c1b5757bf7f",
      "source_sha256": "8aa0f120077f75fe0d8315975c22a3084b5de6403515fa19451754981bd41352",
      "translation": "请用这份麻痹香。"
    },
    {
      "id": "coalesced:fc1af23e7afd8ced251c3aeb1832eefd95d3b4448d5f59f6acde07ea8ad89300",
      "source_sha256": "05bdd783e3798d99bfbfbd7df9c6d741d389048251e4e5420e9600f5e1568319",
      "translation": "啊……用了这种香，我们也会动不了吧……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4d0373e8f55b77a5975a30c660b472cf418884b3a968259526e0a0e908313ed",
      "source_sha256": "b38ccfdf3102f2dbed2db468f0066faf7879e5d5bb11cdf0dc9b89393ae2e3cd",
      "translation": "不会的。我会给你们消除麻痹香效果的药。服下后再去战斗，就没事了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:926b8a5c626595eb2f41c243d34c7160040248b9e1a52f17f6b044c98d8c6305",
      "source_sha256": "e951aae21fa2384a611eed2a1d42748cae6cf497908e3b499a14eab036f868d5",
      "translation": "谢谢您。"
    },
    {
      "id": "coalesced:53130921da79f75dd0c0d95236bb379b0b424b5c5d4ac0ef176668fd15d71a60",
      "source_sha256": "825f2714aa6d80502092d4a625ea58b8970cb1a4c2497cc7175237256ebcca6f",
      "translation": "虽说要报答恩情，结果却还是得拜托你们。真抱歉。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de6eca807756cb44ff6fc669cabc3925ebb1492c0d1395577cf7588fcc43d87c",
      "source_sha256": "00fe58778cee0cad35d90813db238eabcca4f4858abdf8fd6c35d2945976c073",
      "translation": "不。这也是我们的战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ffc87f029ef96188c10bc0fd78daa5825e94460e503cc3e6b0922473893e1b8",
      "source_sha256": "18a0fddc4fd29263483a2be66e195f41bd51a59a28b9907ecc2386110617550a",
      "translation": "那就……拜托了。"
    },
    {
      "id": "coalesced:145bb27acbec3bf534de1ed01412627cc1a6e7454f6f14509801025ad75fd354",
      "source_sha256": "564b7c8aadeb5d535ef394087937220edefd1dbdf74cd7703055225839b85934",
      "translation": "大家，准备出击吧。"
    },
    {
      "id": "coalesced:0af5e13aed1392e8ca5f0ec42b7c420f8191fb0328fc59b7b2d062c54f0c9cf2",
      "source_sha256": "07e9349b9bb28b5ab17f808a1e52d8c7db4f2e0a6e61f364b551093c3fb94aa4",
      "translation": "是你把梅莉莎……"
    },
    {
      "id": "coalesced:f06ab5192681c0b2f89340ffad40c8bc62ce88484e59b1e95408b6710999dc66",
      "source_sha256": "5355ba63f7ce9ec2319df53841d5e25f8165ca55a4b35f2594e57582280ed70f",
      "translation": "没错……可那又怎么样？不过是叛徒付出了代价而已。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e1b6e52f2fa5bec1527c860bce7b3e5ebab589f1f77c10d27f86a5bfcecdf160",
      "source_sha256": "2db06d51b0add306fc712a47f58840c6e494a2e1ed73ad7d1e177f4e69cfdca0",
      "translation": "这世上，可没有免费的东西。"
    },
    {
      "id": "coalesced:31d961558dc8170711ca945d12324b24269e835defa613b986533357ace7729f",
      "source_sha256": "2c1943e93095ddc278cd2bdfd5fbe0c8188ec95f1c2f78d177ba318bb142b796",
      "translation": "你们该不会从一开始，就以为只靠玛格纳卡尔塔一个人，就能守护世界吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17bffde7931eeb644869e77fe52fa983e258e97a0c5c4a09d4de24c3f22b6053",
      "source_sha256": "2a683122515bddb9cec128b2e6ddb9f642b9f897df70389b85b73e52e287915d",
      "translation": "守护世界？这算什么守护世界！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f7442bd9248ec17c92e407ccf131e034810982e32daa68caa150d7d9db2f1dca",
      "source_sha256": "8a7841751ddee1f45d1636af8577955584cbed17f36670bae6fe30b7520d7aa9",
      "translation": "你们不过是想造一座玩具庭园罢了！"
    },
    {
      "id": "coalesced:ccee86cbb8c0bcc3072121f82baf195a1bb95d814849861881d9e31708cd7555",
      "source_sha256": "c54f7b8b4f98c483f34afc797498126ce6288f66baa3915ad64f4ccf32846652",
      "translation": "你会这么说，只是因为你不知道，拉·斯特拉达消失后，人们会过上什么样的生活。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b0d36f439510ca219a7bd9e82b5c3ee23677792ecbb9b53ad8fe3b803d962d28",
      "source_sha256": "16cef78b5bbfcd901e768e6cb35ccb0ff5f3b76c167a09f4da56f6b75faddfa9",
      "translation": "就算为了这个世界，必须牺牲全人类，对我而言，修恩扎伊特大人也是唯一的正义。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e0f3b4a63fb6a7ffab9852d4c821f60956f929cec6d8f94ec7cf631a06d9c8e",
      "source_sha256": "66aad3df05d498950b018a52c91f1064c8b208fe14ec2eee0c6cac0202e24e3d",
      "translation": "开什么玩笑……"
    },
    {
      "id": "coalesced:9d029bdf4ad60ded1293441b00a37559c5fcc59ffb1e8dd5c8fe2be308a3bbae",
      "source_sha256": "7ea43e1f60853a7b4c12b4c0972611d9467687f673be2c0e3a81e1bc8e42c8a0",
      "translation": "我要让你为利用梅莉莎，付出代价。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41a754fb8cc264ab0c727912044327c0c007ac4a62f6ca16d032364a81593173",
      "source_sha256": "ddaa4f03e1e988d50b6ac6434c7e0ae7cc4004300e53291697f6dbde29082807",
      "translation": "不过是被制造出来的工具，竟敢背叛那位大人……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a7ad0ad2d1ceae72026bf67d54a5a50e1b992ee50cd22dae4c77f09536f5dd76",
      "source_sha256": "19c643b42fa3aeefe531b2cd0aa116146c73ff6645214e4dedb39fc29266c514",
      "translation": "把我们制造出来，只顾着利用，等没用了就抛弃的，不正是你们吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c4014fc18e98466b2b452f0640580235e3f08cc66ed79683c3a74893a1bcb6d",
      "source_sha256": "d670d1c8bd326dbb8d702d68f5d2e243274652ba6e7e49f379d2b7ee6f300b5f",
      "translation": "公主殿下，如果您还有良心，就请现在跟我走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e007fe04344e8628c93f422bb059b5882a5c1fd7a445001a419a330e2e08cb4d",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:169afcc34be8c6747e13f9774a1b862409b62840982f6c372a5c07d093c44d2c",
      "source_sha256": "5fd00ccb07aebaa1b7da7d3787b83a25a73c60b6275afdff6ed0b99c12fc6896",
      "translation": "洁菲。"
    },
    {
      "id": "coalesced:b32718c3f779370c698844bbf8bda1b0cd0b77a7b94d88a810489dd91fd4b58b",
      "source_sha256": "725a012e0785142d26526829fac4759a15eec1d73ccefd465e973c67820592db",
      "translation": "我拒绝。"
    },
    {
      "id": "coalesced:824674d75501e4701fa175432ffbc2e1defc0372fd717e5fd65a6e1988453852",
      "source_sha256": "bda8dc3c09b9e3f0cda169269e800d09d7647543770c33269bed0a4a587e9358",
      "translation": "因为，修恩扎伊特并不是想拯救世界。"
    },
    {
      "id": "coalesced:6f49bbeb44ca62ca3ecef178eee13569fd30c3bffcb55b920b14de250a674bf9",
      "source_sha256": "53761b3b5a03c0f44549e4b9e2801e57233896b4bee7647a012646d9f4ba012e",
      "translation": "真让人失望。您当真打算，与整个世界为敌吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:769fbf389c00c6e16aeb8142f58e1091d5f91da82dce0218661f1078718128c8",
      "source_sha256": "1ea532b1c6c222444f17893d509ae5c73c69b57028c1b76189d2e6e6b8b1f4d1",
      "translation": "对我们来说，你们才是世界的敌人。"
    },
    {
      "id": "coalesced:e2db0e2ce41680c96131e763d5134cf177c5bc76de53d7737591385547ef285e",
      "source_sha256": "947dbc451fadc6c00c1d7e5a2e04b6dcc9ef99b57bdb09e7a6df4f9dbf85fd0a",
      "translation": "是吗？好，我明白了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f51e797e29fb92c0c73801a3a2b439cc34f92021f7b80d21e0a563c385cceb1",
      "source_sha256": "ce3080ddcf99f08fd2ebd610ca9e9140bcdd400887db909304ea327175999032",
      "translation": "不过，请记住。就算阻止了我，也不代表一切就此结束。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3d0238caf0f74471c6f68dccb7e86053c1fe76454d354ee391cfe7166ad2fbe",
      "source_sha256": "9290db8667e0e1697a122ac94527568a1a2654efa84e6b89d4c8c45214bf7f23",
      "translation": "因为今后，想要阻拦你们的人，将数不胜数。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:90ef18dc5bdf51cc47e77a10d221eb4b0ea96996eba19b64d008f3bccb6da1a5",
      "source_sha256": "f5db594662c3d5a734a6ad17bba2f39efd77640f03904345fd649886956b9d86",
      "translation": "那么……下次再会。如果你们能活到那时候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2139fa255053bb6bb5276ce1924442b36e9610be1aa42e4a3ef496bf4027895a",
      "source_sha256": "d5dcf2f8b1cf1b7f87ed818fbd3bd1a43fde99bfe5ca1101e9e9b10e05af2891",
      "translation": "总算结束了……"
    },
    {
      "id": "coalesced:4a983d85c31eee26d5657d62f9a31f85cd9908d8e3c4f844cc9115f268d2ecb1",
      "source_sha256": "688e0b1ceb7eb064eec5c57e4200e530bca0c10e40bd32a86c833228b5495e64",
      "translation": "回柯塔马雷吧。"
    },
    {
      "id": "coalesced:ff6e4b963df97a68c9d6d37cdbcc313ad710b1ae866db15e475b2ccdc0ae7695",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:e28843afa39e180537745709cc2c151c42d4ff97d09ee05dd82f45e83e69998d",
      "source_sha256": "ec0be367ddb2903a9a8ea8bc6af3d9e8adf05dc0dc9852aef3b4c2c1ee96c386",
      "translation": "大家都平安回来了～～！我紧张得，根本没心思干活啊～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee4d85aa937a1234e92fab2b6e374eef13e3a8f67eca0dcf6218ffd67feceae9",
      "source_sha256": "81efbcfe915dd6116349cbaddb91be00e62b7bb8f2cf22178325a8b161c3ec17",
      "translation": "什么？你一直在偷懒？"
    },
    {
      "id": "coalesced:df844b4370b6db66e21bd1a8dabf5d20cded4ffb24e1576a5facac3c7ca3ed32",
      "source_sha256": "ba5d30e2cfe5c2ee2114f25065ffe72baa5bd4fec2b90f8a2e59f614aa16eb00",
      "translation": "咿，没、没有！我是在祈祷，祈祷各位一定要平安归来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f393f2099d13a16b78efc8f1827ac68a9f21e643c01b4f70b90e0529211fd62",
      "source_sha256": "2eeaf73068089e6d72deadedc4d1a37acb57a5f0c6e9960c31a55cac296cf8c6",
      "translation": "各位，辛苦了。"
    },
    {
      "id": "coalesced:725ef7e6ffe33e6ce4bf8ed979b2a8da58f06146ea699e021c8cc58c748bfe4b",
      "source_sha256": "a23fff00e5f3236041d9da92ddc697023156afe359b18ee18c434b6f8277fab7",
      "translation": "柯塔马雷能平安无事，真是太好了。"
    },
    {
      "id": "coalesced:401c54a55d12ef12912ca1e20d3b16f648d77e8d09ce4debc8012793fbd494a8",
      "source_sha256": "abe133cd382450df562e9b403f64fa488ac60fff2fc94cd6875a80b271036a24",
      "translation": "全都多亏了你们。"
    },
    {
      "id": "coalesced:c9eaf3a5b42185d1f90f2a2fc978d9485f68360806faf051d998b9cf26a5196e",
      "source_sha256": "49dd0ecf0fde5ae4ec219e6e569794b642e8fa4e49fcdeef6c1dc6438ac72a2d",
      "translation": "不过，如今……希望各位能离开这里。"
    },
    {
      "id": "coalesced:033fdb1c238d459d0db25cf50423aef607cfb514e8ad89aaf4db314dc5011fc9",
      "source_sha256": "21f530438bfdb1abcf04ebb35c3134ecab2e44cb64af5d96c4a4b4b47acb75e1",
      "translation": "族长！您这是什么意思？"
    },
    {
      "id": "coalesced:c9c6f6a74853984329fb6633cdd867029f7ac604e0c2165225f56bfb78f8607c",
      "source_sha256": "726a9602abff84bb76e118dd142d89dd7b9cc278d28c1c7d6e87b3ec7cf0f342",
      "translation": "只要你们还在这里，下次军队还是会再攻来。当然，我也想继续保护公主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f5c49a4e6d66f0649bc60d06cbc4001401625b61d8cf873dfea6dae92b825655",
      "source_sha256": "d82473768480f07dacb1bd14aada24edc516595e6010e9cc3ae973a59f0d7111",
      "translation": "可是，身为族长，我有义务守护这个村子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a4667240b7e50c4a1842af431d5528971df35a3ca5cfbda6aa7eb1ce05e1fdc",
      "source_sha256": "740d54f94ce3a7cfd8d0456c40874edd39e9580182d2a124168a88c7991c0b40",
      "translation": "比起与你的友谊，我不得不优先考虑马雷族的安危。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77f63d7418d01b1687ed3356fbb85cfa412a358898bd5fca920256c16d8e3a6d",
      "source_sha256": "38d5ef5745dcbf12c81b234f05b84002ee09ff55a1e42782f99c397a2b871c33",
      "translation": "不知道下次会来多少大军。我担心，到那时候，柯塔马雷还能不能平安无事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a35f6cd7ffc324582bd1ea74103555bb6513befdf2ec759bee613740929d30d6",
      "source_sha256": "3c1d4a4f80f7d151d73dd5e4790adf467dce9ec59f69a6907ee9b54f9371c358",
      "translation": "就算您不说，我也打算离开了。这段时间，谢谢您接纳了我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d7882a8379a97c328cf364e8a96c26710a54d265d1cdca2eea56b5742f8022f",
      "source_sha256": "00cdabd22ac1ec956566965479abfe535133cfa3b861ececf2ba67483f8bba2e",
      "translation": "真的很抱歉。"
    },
    {
      "id": "coalesced:9a44683ecdc666e5da3809bfcc5015abb65277ef69a1794fff76029fc2a23866",
      "source_sha256": "0dfce77b6346faaa55676f5f36c5e00edffbef2c30314c9bb80e7751e75c1312",
      "translation": "那能让我们留到伊格顿造好装置吗？应该不会太久。拜托了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9bc7053815e09627d1972cf6fd549bdc8ac4e0d2a6fab0eca4606cd55ae219e",
      "source_sha256": "4f95da394f800e299af836da5facf0ff5df5b499c8a266b61408fad95b7c3fb1",
      "translation": "当然。这大概就是我们能做的，最后一点照顾了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4bbd152b1a5915c6a3552897b262358331353679a7ec889d16c356aebf22763",
      "source_sha256": "35640463217803b43a7b50c4ee80c263852939f244e045a751dc874643882a26",
      "translation": "谢谢您。"
    },
    {
      "id": "coalesced:c582ee9c148ab05446040732a9555f154b8a9a5d20a81290931ab233fba83c06",
      "source_sha256": "23a9c9318d797367c28d6d9bcbd6900ec2246c2c9cc0aa153f8e454d2e8c8788",
      "translation": "你……把花放在这里了啊。谢谢。"
    },
    {
      "id": "coalesced:7ebfccf3bdf1c64df92c4dda6cc0e25e56b5acdf0392ed025a9e386ce6c29b98",
      "source_sha256": "96f561b8b601ebf513c7157f37714e314ca870d3b9b04f285d7ccda50d0954f8",
      "translation": "对不起，朱特。"
    },
    {
      "id": "coalesced:2b9085d7eb27fec3427042664829a5dfcc2d64369348ac2f88a8fdfcad2f1d63",
      "source_sha256": "cc31a332a73c458a2d61c32eb2ffc3c0487027982134361b94ec33e87782e223",
      "translation": "为什么要道歉？"
    },
    {
      "id": "coalesced:b6a7c3a83c441272bbbb40a33f4aaa7564594b61c24f67068d0f1747780ea9fe",
      "source_sha256": "e362222eb8cf0fa73117d39cb7f009d63a5e2f17499610dfbc3843c2953919c9",
      "translation": "果然……都是我的错。要是当时，我在岛上挡住了北部军……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa87749f318fb79b9832459335a9cc9f7913abadae673f54948d006c5eea6ee1",
      "source_sha256": "d2c923192ea641eaffa6908f73bbbaf7130158071af1778ad98bc4a5b1f09180",
      "translation": "不是的。"
    },
    {
      "id": "coalesced:e30847bc6765dcd1715dab14393fc92f4894bfcc70c2e77e7d6a521d1c3a9f14",
      "source_sha256": "f5469c2ced66d23ab845cea2eb682b11369a7776f909e6aa98d6c5ad8fbffc4d",
      "translation": "梅莉莎加入北部军，是因为她自己的信念。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:228dacc7262fc02b50e0a67f71a9126df154c94c5d1409fb7263017de61a5f06",
      "source_sha256": "96626595a6a2ffe5f90eab1279b6b22a03c9edea58c0159380a902922d50de29",
      "translation": "虽然，那个信念最后背叛了她……"
    },
    {
      "id": "coalesced:5a4c84c4ea722f5ee2e9418153ff902e7ea7ad5f5f4bcd902067b9474905fd36",
      "source_sha256": "fb56ef5e0fc05bd69c2e7f41b7d07c90f774042223b8f547976670940efd93f9",
      "translation": "可她并没有就此消沉，还是来把真相告诉了我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b159e50d1cb67bd6be604db703a6300449240c15a4d63e7952603bcd47a5c0b8",
      "source_sha256": "ee9bec670f87bd6be402e56d128f100215ae4898076e9a38bfc88c36a846ba5e",
      "translation": "她直到最后一刻，都尽全力活着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aeaa30a0f978e8aa1d19e9b2ef8fff0999ab3ba604f5155e99cac0585dab4aec",
      "source_sha256": "05e0c46106598291591a694c6ffb653e595b8c6c8249e1bc5c8b8d491cd12946",
      "translation": "就这样送别她，真的很痛苦……可是。"
    },
    {
      "id": "coalesced:6585dc3b1622662f3e76abbe0e06b43b9e083ed00141f5bfa8ea69bd17190d80",
      "source_sha256": "278ee606d8403b233b086bc1aa64d17f30a710b6135a358eba664576cb58bd1c",
      "translation": "她一定会看着我们。看着我们让拉·斯特拉达沉寂。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ee557a792cc6dd9dd63f0bed9328fb9619797b02684f273f80e68afe8570cf4",
      "source_sha256": "614dd1a5ff59ea44ba15cfdcd7b02a8994cc054e1a24efc24d6e5e5754ead894",
      "translation": "看着我们……真正守护这个世界。"
    },
    {
      "id": "coalesced:f1cee99cbe68fc29175c11cbcd4836913b3673e2b36987d78028135fd4d23a34",
      "source_sha256": "81deeb08229d9b4efe9479dd55e8d38801bcde43aef1608df32b1cffd2dab9b7",
      "translation": "……多亏了梅莉莎，我也终于下定了战斗的决心。我不会让她白白死去。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b052f2ef011bf855a15f675aec46f24607eda94ff497162ff238425c312971c",
      "source_sha256": "b7d2d1882571e8d96fafdd9838e0e002884557d19f68679edc05d6129c40faea",
      "translation": "如今，我绝不会再犹豫。"
    },
    {
      "id": "coalesced:477d2fcd96ee78fb67baa1ae3985082c9415d3b1c244c8d61a9d487ed9dca412",
      "source_sha256": "10822195877f1a2891bd86e4c8cb579a84a45d6da60429b68dac66f036897776",
      "translation": "嗯。这将会是，为了兰兹海姆而战的最后一战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06b78f90779bd2e5cde89a6f3db744e271a3185144d610ec0a4d0aae8eae0b9d",
      "source_sha256": "d3bd6ae4e82503501f13d6d59f54ca39c6e6890eb85e346bbb3afe66cf7e557f",
      "translation": "大家一定要平安，活着回来。"
    },
    {
      "id": "coalesced:dc4f185f062c8ff294981c1d0fd904758f06660a943859ef11e1f8f1288d941b",
      "source_sha256": "f31b11e71010be91a6551a922487776f883d1ee94387261047ddbb19ce68e0ff",
      "translation": "梅莉莎的死，让我们痛苦不已。但即使如此，我们也不能停下脚步。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c58d3a448db4f0827b0f9894cd94a1bee6e71ba31b760d03763d14ce228a1823",
      "source_sha256": "f4aacbcd09fcf0c45a76a4206c0174601eff79c82fcbfac654921eae15040268",
      "translation": "必须继续向前。哪怕只是为了，不再让悲剧重演。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bde274061d6c39dc032e01b16198ad4d1a2dcf1ebc1f49ae3f95d7a99e3af761",
      "source_sha256": "d3f9bfb7fe66ed9846370c1c017e72ebcf47d94320c0d53ee5bf7b9aaf85e721",
      "translation": "就在我们准备出发，前往拉·斯特拉达的这段时间里，兰兹海姆发生了许多事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9da50de8bfbe7b20ecc2ffa871145e8d4d043f2b4b018010b2b8316f5729d43",
      "source_sha256": "a13cd969e2e75b4557b173844eee2f40f81067bbb79cbc3f9ef08afccb7fb517",
      "translation": "只有魔女洁菲死去，世界才能得救。这样的传闻四处蔓延，所有人都盼着她的死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b5557ed573469f96acec6bff914becd1aa8621533a6b0c462d3a903145a6063",
      "source_sha256": "494207b681b67d2a060ac4122d0090fd94c150ffde20446f5530fb9c67e80f60",
      "translation": "而且，为了抓住我们，南部军和北部军联手，组成了“兰兹海姆联合军”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d45148a9e73c800234a3780d391584b16076a823ac794ad2fa74abbb14f9ba61",
      "source_sha256": "1b0a4ee36e1b303b8ece459d1caf1d6120ea322724366f8f2321457bac6ce3cb",
      "translation": "我们……真的成了世界的敌人。"
    },
    {
      "id": "coalesced:41b6c5a6f29421956fa3de49912d69c3b0e30236b7ab0712d318d348fc5af9f6",
      "source_sha256": "8766943690f8ef3eace8452e6d32f0f233e9d5f8b40c913c56556c5b1a0ad33e",
      "translation": "我很抱歉。"
    },
    {
      "id": "coalesced:8274b09052275391ec4efce540f600e5865cba9900858982400b2ffd208b0e91",
      "source_sha256": "186a88a6721384be93139b8771f6ee9636c9d3e2ea95f4d8391e812ce6b8aef5",
      "translation": "但希望你们能理解，我们也是迫不得已。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7147613beee4eb6453bbc2fcd3b570422df8d321c68c13984bdd95e393c49cd5",
      "source_sha256": "0ed3efa72396a46365f9c2720a924244c99d5dbb745f446c2681f19f85870aa2",
      "translation": "你们朋友的事……真的令人遗憾。我不知道，该说些什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c13952cbb5ced9177525fe7791f586f0f02eed599427f2f01e90a9954e1cd969",
      "source_sha256": "b5cd741ad6ac8cfff6b050e6dd9ba11a995e9ae02296349527cce0f687d6e7c8",
      "translation": "不过，柯塔马雷随时欢迎各位。想来的时候，就回来吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3900a392ea232e114d04b5ff9876fd887ddc13a18252c4aadfe6c4b6a570438f",
      "source_sha256": "a46f6ec0de8d79dd7126c2c91b53f33157234c9b180d6cfaf78cc42126838999",
      "translation": "我只是在守护这里。你们，也有自己想守护的东西吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7b9c6485bc55b73e1b6e8155fca5ea6ceab7b323fe3216278c5a7065879c4ba",
      "source_sha256": "d82a4f06bb10689e7e73f7cf12a68f3a3e50cf94e8f76c8e37e2c2c529b86bca",
      "translation": "虽然事情变成了这样，但我们绝不是讨厌各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3bfc0171cdde3355e611729137336e46d03a5143131063cf341ca36f11fd07b4",
      "source_sha256": "b8f945777dbcdc86402da46aeab828af0df25a9d5ed929d6d001c6712e898b25",
      "translation": "听说，就算因死亡而分离，只要彼此有缘，经过轮回流转，还是能再次相遇。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf3fdda0b8bdb774d24d0e406d73ab5543c5a12b6841dff6e48c534e6c99a8a3",
      "source_sha256": "ae60d5576515ef97a0a61a1d1edd066c9c493a5c57450759afbddda406989734",
      "translation": "该怎么说呢……据说，缘分就像一条相连的带子，始终连在一起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c0bc90dae5ed176551a79a64589f787e511a5656416423c5a36a7ad6e4e477e",
      "source_sha256": "1dc0bc3c43792eef4370e323a968a09eeb3caa244eae3667cd011ee61dd40fcb",
      "translation": "所以，和死去的她，总有一天，也一定能再次相见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e133893bb53fd1a4b6641ce678187867f016ac4390c0df60060b582a642ef654",
      "source_sha256": "5adada73e80a6ee2bce34d9ce6268b0d5dcaffcfecd2771bccf0845886337300",
      "translation": "嗯……无论去哪里，都要保重。虽然不知道，你们的旅程会走向何方……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:acb3be38ae49b4bda66e927e51283c8e8cd9704dd69060e0fd53789432ada895",
      "source_sha256": "ee5d90e336e68ee6c03300f9461a662c2bb79f2077e60a69f2654234bc0ec909",
      "translation": "既然族长已经作出决定，我们也只能服从。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88971fdcddd6841c11bc8c68b1ea71e744c6293d1878a0e7c51b3f578db0c29b",
      "source_sha256": "4ff0003dae0112761573b867e8a43c78dd7a8e7876f58dbe21c5ea45c7b323fc",
      "translation": "别放在心上。等战争结束，再回来玩吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ed70db3ecd42d9bdc6053970bf92d10a48c05dc383cd0aca5c32a47aa8fd801",
      "source_sha256": "913cc36e6eebb0bd23f9176edcd87e2692ffab10cc4b9c4b406ee1249e2c9772",
      "translation": "我们还会再见吧？"
    },
    {
      "id": "coalesced:d1eb8328da40441a3df6e1c4dfbecefdc16caf3c655c4004027597c9c29543f9",
      "source_sha256": "b81d99123a60de08a1d00038639993d5cd29697d87cd15f496f2dab46e8fb207",
      "translation": "在那之前，请务必保重身体。希望各位，一定能实现自己的心愿！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:736b4e17b377d61544e82e251b63982f7111705144c2bf931ef7b9040863943c",
      "source_sha256": "5192c8c68396ffed242153bcb940331822eff7af650dae670b83341cb725e4d7",
      "translation": "相处了这么久，已经很舍不得了……各位，一路顺风。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:819fdeeb00f60f1625a32a1759651f7753f4000ae696d668389fc53ae1e09d6a",
      "source_sha256": "ecf92c1397079bc588f4cd7ea46c2175c26b06d81d56d678a7557a255291edff",
      "translation": "喂，你们几个！"
    },
    {
      "id": "coalesced:2edc74f0f69366dafde7acfe9764d96209bfd1abddbaed9185237e695758a76f",
      "source_sha256": "55158b3d00c8c759edfee7ffd625a9ba8e736295b5316e84e03370943487305c",
      "translation": "就像我保护妹妹一样，你们也要守护公主殿下，直到最后！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e07dc8b50df47577e954fbfac1bbf6a7d6c4fbf3319f74d8c25ff9107149fa5",
      "source_sha256": "6ee762a1adc759cdb1ba9e26642a425d3fb9593b898a045553d4393550ba611f",
      "translation": "怎么样，能做到吗？"
    },
    {
      "id": "coalesced:a46e7ec7cfc6a30bffef8bc049e7082f8276d4070a29890c8d3096e4449fc4ff",
      "source_sha256": "695167dbf9626c38941d51e163f90f4286fcd128d6249d6a992195398be73ee3",
      "translation": "等战争结束，就回来吧。"
    },
    {
      "id": "coalesced:e85949a9904fb4b36f0dd1318cd000273d18ae77aaf86bb034f6ad3995bb32f7",
      "source_sha256": "0a8c925bccc9f9e2b2facb63013acb50920ab1d58298c4e15dfdf56c1fdf7afc",
      "translation": "这是最后的决战了吧？？一定要检查好装备。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c50ca298d5398134dccbec27258d3c8f85b8d9644803c5450e77e2eda0cac4bb",
      "source_sha256": "c4735e82a5640f0ecbbba8c235f159ef9c91ce9974a6f1c94cdb287e06be1fd8",
      "translation": "请务必平安归来……"
    },
    {
      "id": "coalesced:eb40a5df28061d56e38c99f83e535f595ed818d6a6633116dd6af45c2607fed9",
      "source_sha256": "1650f30c0087ee97d9321142f8c2b6690e3bb0854690da49d5838a98082bff41",
      "translation": "等你们的战争结束，随时都欢迎再来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96ad7977f5bd4e9c8790ba0e980bbbb15a04aace7b11194073bdb839fbff4cef",
      "source_sha256": "730cc830c9992c97df6cc870fea53061abb343cf3163975b5c7aff05fb4501c3",
      "translation": "愿你们平安无事。"
    },
    {
      "id": "coalesced:9ca33028b4604573acf5923bb3187b3f24f69e6a6f09e6adfbb5a62d560f09b8",
      "source_sha256": "922e3998636588f73fa46afd4d96c8988bcdcbef284d8c368c013d3f82171ffe",
      "translation": "各位～加油啊～我会为你们加油，直到嗓子喊哑～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d75341f70911c8ecd1795d5f2eab350db43efcbaae1a88bcdafa8e25895fe92",
      "source_sha256": "476518406d45d8a93b804a54bfb76c9dc8a5234746cba060123c711d68e814b6",
      "translation": "勇敢的战士梅莉莎，长眠于此……"
    },
    {
      "id": "coalesced:f4b5f9dcfa3688a7b29e26b1a89ca5ac4e073205839dfa902032ac4725b5e804",
      "source_sha256": "b27d8e0725e3ac08d3fd08a9e29216bf231a4624e2becb54e8af8023f0ca5fbe",
      "translation": "（不能带着重要的材料，\\n就这样去战斗。）"
    },
    {
      "id": "coalesced:dc08333e708348b3ef54e3e2997278b2a5b9849280916c4bb8b6bcec0f6672be",
      "source_sha256": "e6e9e41d68090e1df8d38c159b601ce28d98961a94454c0cea5a8814033e1256",
      "translation": "（先把材料交给伊格顿保管，\\n应该更稳妥。）"
    },
    {
      "id": "coalesced:d2101685289af61f9a90ec9d45af336b449b7665df91bce0926a23c4f4b4bf9d",
      "source_sha256": "ec3e6b00f733f876637e252d3c0a578419ac378729021a9484e605a0913dfe98",
      "translation": "（传送装置的材料，\\n先交给伊格顿会更稳妥。）"
    },
    {
      "id": "coalesced:8d43cd8ffd13443fe1c1a85662bfef228640ca74c61346003d7d69a22e1f9f74",
      "source_sha256": "c9d14f04bb74b3199dfd679742157f20cbc0db183003ba729dc09c0858826334",
      "translation": "（传送装置的材料不好找，\\n先交给伊格顿再走吧。）"
    },
    {
      "id": "coalesced:8212de38dadf70ab73980bcccdcbea53f6e9bc56c8de80311f7f5dbe753bbd9c",
      "source_sha256": "6acf4726daa56cc0228d7e83332c3077cd39ccde36bc8586bd5fbcef8cfc8127",
      "translation": "（传送装置的材料，\\n还是放在安全的地方比较好。）"
    },
    {
      "id": "coalesced:a214cae63f119269d99c11e1ff8267ba205be9055577bd361ca84c5f4bea6459",
      "source_sha256": "f15d79b9da2536f3298f4f45b219ee44e39abce24e5d9aa32834eeb6b1d8b944",
      "translation": "（先把传送装置的材料\\n交给伊格顿，才更稳妥。）"
    }
  ]
