{
  "schema_version": 1,
  "resource": "MC2Game/Movies/csm09-40.txt",
  "input_sha256": "e5fb6c7b0eda21773d7936f26f73fceb6adeadbe0d64636360ddd9e984b705fc",
  "kind": "timed-subtitle-text",
  "entries": [
    {
      "start": 6460,
      "end": 10184,
      "source_sha256": "f7329b321a36442b23deaa59c014ecf585c097389c6a52fa086757a2f7d2cf41",
      "translation": "真令人惊讶。<br>你打倒艾尔加了吗？"
    },
    {
      "start": 12504,
      "end": 16588,
      "source_sha256": "42f92a67d7b9a9572ce7e1679c6dc5ff03ffe165ec8d88be11a69880d3d2b833",
      "translation": "站住！<br>我不会让你再靠近一步。"
    },
    {
      "start": 23956,
      "end": 27162,
      "source_sha256": "7af89e03d2abbab813e357270b5807f0cd37e6b0d8bb4be3294e170293d855ed",
      "translation": "愚蠢。你想违抗主人的命令吗？"
    },
    {
      "start": 27495,
      "end": 31473,
      "source_sha256": "ae899b8b541918bb338ac94c7160b6e82c053855fafeef9cf0504bc53548cd7c",
      "translation": "我……我从来就没有你这样的主人！"
    },
    {
      "start": 32489,
      "end": 35995,
      "source_sha256": "60a5f5ed945c4d6323f6ee31fc3ad5fda70235634dcef6738a8cb271a2475963",
      "translation": "别过来……别过来，朱特！"
    },
    {
      "start": 40298,
      "end": 46402,
      "source_sha256": "48d51bbc4cd9256406ac3cee0d92f486137f9bee1eeac5f0263d256e781b7ec6",
      "translation": "唔……"
    },
    {
      "start": 46723,
      "end": 47766,
      "source_sha256": "1fc5de1e8e252da179f01c9c27c1249c1a1436776611ece0330b7923d1a8442f",
      "translation": "朱特！"
    },
    {
      "start": 54708,
      "end": 58636,
      "source_sha256": "a0326cdb6f3df9e3a40c2da61533b2589141dc72bbbbbde8035aa945c3158148",
      "translation": "你这家伙，真的打算让这个世界灭亡吗？"
    },
    {
      "start": 59429,
      "end": 63468,
      "source_sha256": "995950f2f31b93cb076b2da89a2351df157ad1d16286ce51c719237078670dc9",
      "translation": "你以为我会相信那种荒唐的演说吗！"
    },
    {
      "start": 63657,
      "end": 70194,
      "source_sha256": "3a9a542c8cdff4be43a25d8f7e7a974f2d53f93b55af292474f5349f44e0ef4f",
      "translation": "公主是玛格纳卡尔塔，这是事实。<br>唯有她做出牺牲，这个世界才能维系下去。"
    },
    {
      "start": 70194,
      "end": 74421,
      "source_sha256": "fc137a9087d66860b7451ac9810c40f50563edead533864762150eef38077b50",
      "translation": "你既然那么想拯救世界，<br>为什么不自己去牺牲！"
    },
    {
      "start": 76546,
      "end": 83296,
      "source_sha256": "f1afae892120c8504a5dc016409877290195219407ee69e13a1145b8bba43e04",
      "translation": "反正，你也只能挣扎到这里了。<br>行刑！必须阻止灾难！"
    },
    {
      "start": 84059,
      "end": 89461,
      "source_sha256": "dbc2fc27e0944e5927c7c3df09b553de184c504ed63c2db6a7b3f2a9fa268ff7",
      "translation": "玛格纳卡尔塔！<br>为了这个世界，献出你的灵魂吧！"
    },
    {
      "start": 108056,
      "end": 111616,
      "source_sha256": "22dd3e3d6352ce5679d834840d08b6c2bb038311189444c9558f524baffffe0a",
      "translation": "那家伙……<br>怎么能做到这种地步……"
    },
    {
      "start": 112740,
      "end": 115534,
      "source_sha256": "b38286cbbc219f71b8282b58dd068e2ff106f440f2712ba73c30db7f0a55cf86",
      "translation": "到了最后，仍在做毫无意义的挣扎。"
    },
    {
      "start": 134095,
      "end": 138851,
      "source_sha256": "252bb0798aa00eb904f9643be83d1f5201cf4c7055ea6196fd9d845282e4dc95",
      "translation": "为什么……到底为什么要救我！<br>你不是想杀了我吗？"
    },
    {
      "start": 139650,
      "end": 145863,
      "source_sha256": "cac869fff8da627647c3eb42ae3a775483262f3f54a4249e2898251d88ad906b",
      "translation": "对不起……真的很对不起。<br>可是，无论你说什么，我都……"
    },
    {
      "start": 145863,
      "end": 150357,
      "source_sha256": "0f2a8c5824712b72505c8c35e31f80467f07f1d54d8a1325ef92164db36106db",
      "translation": "别再管我了！<br>你为什么要到这里来。"
    },
    {
      "start": 151044,
      "end": 156990,
      "source_sha256": "de7fc02fbb4b573d26d2c4ecdab5973b161c41c5c0372d004a5c4bd1de5e2e6b",
      "translation": "这还用问吗？因为你是同伴……<br>不，对我而言，你比同伴更重要……"
    },
    {
      "start": 157651,
      "end": 165402,
      "source_sha256": "80ea94525dffbf09e28868b8b60fa062d3565aa8dc77b8db5f8db44311a6aec2",
      "translation": "你不能救我。修恩扎伊特说得没错。<br>我……是玛格纳卡尔塔。"
    },
    {
      "start": 166165,
      "end": 170726,
      "source_sha256": "e05df5c8ff91b1af358b8040118edfd1b078a7cdb94855ac454c3d66763c39f8",
      "translation": "我体内有卡蒙德……<br>能拯救世界的卡蒙德。"
    },
    {
      "start": 171820,
      "end": 172614,
      "source_sha256": "123b53a15306f286d7c6ea929de79709a49c67f9ba450b37069f33242b9dbb5a",
      "translation": "走吧。"
    },
    {
      "start": 172614,
      "end": 173393,
      "source_sha256": "1fc5de1e8e252da179f01c9c27c1249c1a1436776611ece0330b7923d1a8442f",
      "translation": "朱特！"
    },
    {
      "start": 173481,
      "end": 177549,
      "source_sha256": "d6c3dad4ed055ee62fefb7b1bbf3db7496294d4f829cee9af62b9589ab8215aa",
      "translation": "我绝不接受这样的结局。<br>我会找到别的办法。"
    },
    {
      "start": 178024,
      "end": 180187,
      "source_sha256": "96871525d6da1d7004347ca8792754adaa9103f1ad94ceaf328d23fc22265263",
      "translation": "就算你不愿意，<br>我也要强行带你走。"
    }
  ]
}
