    },
    {
      "id": "coalesced:2c69d55fda06020795e4859edadd8bb2a5bafd1f58f217526263c617fce3af3b",
      "source_sha256": "ef6b74388e067292f53923c3b962ffd6e775505d94a834fd46e907729bf30f2a",
      "translation": "香气之源"
    },
    {
      "id": "coalesced:7f61babeaab20b44da2a6778ada1980c9dd3f71e4f4d5380e9ab56e9b5ef9fe4",
      "source_sha256": "938e6f669742ad2d95e782369682c0ded24e08a3fdbbd3298df37e57acdb0bec",
      "translation": "通过马雷族香气仪式所需的香气"
    },
    {
      "id": "coalesced:765ffcc2514aae4d41f781501c5dc644f27fa3f1fd64fe8a6f4e63b73d7cae7d",
      "source_sha256": "ef6b74388e067292f53923c3b962ffd6e775505d94a834fd46e907729bf30f2a",
