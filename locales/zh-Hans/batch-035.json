{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:43e46301609111d4f95fe55f80c5ce32e88ef5bf01bbc9e9980c6dd3c7a4ebf5",
      "source_sha256": "f7d8849900bc59d196cc8019489593d6745ef99c9c689855b8aa0964df87fa91",
      "translation": "机械零件，还是很难弄到啊。"
    },
    {
      "id": "coalesced:9e23aa1fec86acdd96fe920001f1c7b12054b787fc2fd1ea8efc71c10dbe092d",
      "source_sha256": "4f83a1a1332d5d682a16fd9369f762cfdaff705a8a68b81d1c3ced0c124c0a06",
      "translation": "说起来，有个叫伊格顿的阿维斯，特别擅长摆弄机械零件。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:033d06b5031b4e4806f074a2eb57233fcb9fc4082aad56e9bf82b15731b4c937",
      "source_sha256": "263e5920e010e34b91f62ad05d8e3f7aa3fdab8abbddc2f0395c806038a29f87",
      "translation": "去贝尔福特之前，要先经过鲁哈尔特盆地吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c785bae20f9f834ef3617e234f1a95caf7ed4a7887bc233e1c1257eb44c0f096",
      "source_sha256": "90b2d31e034020ed326ab5c0e55d7b8fb28ab156bffee64f7a964769906303f4",
      "translation": "我一次都没去过。那里大概是什么样的地方？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bd593450e2c127187a239a45a8a96052a1bf9b594ee3672916732ef728d225b",
      "source_sha256": "3fa98d7e44b8ca20d5120b8cdae1fc8fda4f001be7355acdcc2f018e2259c5e6",
      "translation": "我也一次都没去过，不太清楚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:60e917290e4e33b4d89adce4054b790b669709d34348df8b91d75f5ce8e25ffa",
      "source_sha256": "540c4e9c69ed7e829c63d1d435c1c0f152a7f44f0f66dcbb48d5003232149d60",
      "translation": "不会有危险吧？"
    },
    {
      "id": "coalesced:1ab36c20255d991aaa3a9647ba2618c07764e43c281f6dd3ac5a4a7da0332503",
      "source_sha256": "205c141b53b2eedd995a68e38be0564ee3c852eb7497ee8d440689858be19b71",
      "translation": "前方是总司令部。"
    },
    {
      "id": "coalesced:5805edc91ba8c64026f4fc86df34b50cdf23a75546c153ae9f9db63addd60598",
      "source_sha256": "772942b177e9c3e38820b03e5d3e892e0392494837c2baf3fed2200d2f0d02a9",
      "translation": "未经许可，禁止出入。"
    },
    {
      "id": "coalesced:3c2bcfaa50b24d3504c774bc6118a6c410109de8eb93f56d48020fe8774aca39",
      "source_sha256": "87eb9d774a8e273b54464efa9e3e7abc2a786f2dd5ee939ef64604307b6f10aa",
      "translation": "这里是南部军总司令部。"
    },
    {
      "id": "coalesced:94343006c42031c2e1edc0b0152a40745a19986b4369ee8cf0a37962a9245bdf",
      "source_sha256": "f5a4612520e11b78c8fb7ed5928351767bc77b92c94af48909ef495de56a41bf",
      "translation": "这里是南部军高层聚集的地方。"
    },
    {
      "id": "coalesced:d664b2017e6700c5a18d831afb8198c5ca0263c1755d5ca21878f8eb8283e5b5",
      "source_sha256": "f5a0dafcf49e3d4d67d3676444b6482572b50e86bd37d3406d8b30d02901fd01",
      "translation": "连环术师若被灾祸种击中，就无法发挥力量。多加小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f42eb84a065d0b30ebedf7083fa602b0caef954f1e7fd198880e152c56882e3",
      "source_sha256": "ea7954c7d3299903997cff079ae74c88cfca77fbc02f29ec2b10c02315b67cde",
      "translation": "使用力量KAN的人，或许没有华丽的技能，但不会受到灾祸种的影响。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48cf3fd4cabc304f423069e8943af5a9ea52a448097d05395a1a8f16bf99dded",
      "source_sha256": "ed2487c09f7e225fd826f86160170514b605e12b7b1a712439a52a1f31c4dc37",
      "translation": "下次休假，我想去一趟柯塔马雷……听说那里很美？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f4b1cec71735206f83d35704064389faefc6bd9b69b31f20087920a319d3855",
      "source_sha256": "a66cce6750b32651746944570dd9a6bc4ca4091d7e6fd631fbcec5a3196bed0d",
      "translation": "出击杜南丘陵的那些家伙，有点不对劲。问他们发生了什么，也都不肯开口。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80ba1061424ae10f1717e31112be5441e92a6f8caddab0796ae5609bf8ad4a3b",
      "source_sha256": "9da5ce3504671dc597954c1aa6a7746b9308b736a886e4eec98b0c80276834e6",
      "translation": "集中精神！否则，下一场战斗死的就会是你！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e8063068042b78287a99bffa06d2445c5f7acb863daacc8b3734f532ac0c6e8",
      "source_sha256": "e41c536a85518abc2435c12a73c615b9a8485f1f8e1be0a1e7979bd0cbbef9db",
      "translation": "就凭这种松懈的心态，你以为自己能在下次作战中活下来吗！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ac8e832bad85444d199aac0bb0f42c9a6078f47847931d8c7d4f8a4beb41f00",
      "source_sha256": "7b24961a867c8673adb1f640b4fa7df83d3b3c821c03a6dcdba6e29154de561d",
      "translation": "手腕再用点力！"
    },
    {
      "id": "coalesced:fc483baee349c726f301931db035bfbe61337ad456df2b13cc8446906bf037f8",
      "source_sha256": "ffdb694db43fe2b21a438730677699daaf1f65025075631676dbf45c0a57a9ae",
      "translation": "再用力些，劈下去！"
    },
    {
      "id": "coalesced:2b03dee376e1c3141de20f26846f3d3730ff09a0ce076cb5d35e51da740c555e",
      "source_sha256": "1f299dd8e4c0798701f3b589d42cdd42aaaffe3a834de8474dc4bed896f3812c",
      "translation": "这间是会议室。"
    },
    {
      "id": "coalesced:d0fa78da0b44af51667d77fdf6a746dadf712529fbbb95a2c725c827618dbe17",
      "source_sha256": "34a4153b92b08c2eee094166d61bcb8955e22d57dd18180efee85ac1d9cabcdd",
      "translation": "高层主要在这间屋里制定作战计划。"
    },
    {
      "id": "coalesced:da15a484895647bbcaca69f2c140415f34d689e65aab5bacd34e0849d6a7ee53",
      "source_sha256": "8c3c0725cd933e05101f98d09abe46008b05fd1a3e0d73db609ee1567fd67eb6",
      "translation": "我深信，反哨兵部队在鲁哈尔特也一定会大显身手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:adde4f87707cb1da1956fa79302bf9784964535b7f42630ab8efd22d1301906b",
      "source_sha256": "3b71565721411fa6b5529fce2f9198281e149c262f58e1a545ec7cba9044c6e1",
      "translation": "为了向鲁哈尔特地区推进，先遣队已经前往黑刃要塞。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e8821a23a5b626cc2fc34a2e515503b25bd653a96841f86cc571cd9724a4a63",
      "source_sha256": "993502c4c39addd8ff0e0ba54066867ce5b1f52e2685acf4ee03d072f28ff72d",
      "translation": "所以，现在这里比较冷清。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f981082b93612faf5dcb2ab9b362935b532b05f0d99825f175adb87fa14200d",
      "source_sha256": "65e5272c9e51326361ba2b0b9caf5dcd3123f91c396a9d8e0918210da46a17a9",
      "translation": "过了鲁哈尔特就是贝尔福特，看来上头正忙着制定作战计划。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df3a1b41ffe230e6dd6c7651c165461868335c44218f327a3c3db9254c344530",
      "source_sha256": "eadcfcb84aff6d22343f99afbe321d1f729b9d6d9d0c22bc1bfaf3bb5d3c9efa",
      "translation": "我们只要服从命令就行，有什么难的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed5abf80d48b3d4e26502ed49c4897ad73959ff846dc26f3d38ca8ab0ba1f975",
      "source_sha256": "103a72a1f5e866926ae9fd425ac0772eee06c29004d9f3bc05c5836fc0eed78a",
      "translation": "北部军还有艾尔加、克蕾尔、修亚伦这些可怕的家伙。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:37662ef7f72af1ebd0a2846b51c706da4f6c814e1001585d14f07936af753510",
      "source_sha256": "b9fb87c6ea4c6e2831df9be1abf90a8ff6dd2c617d0ea64e6bda17e691413d80",
      "translation": "到现在，已经有不少部队转移到黑刃要塞了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a00e0a9b31e773611aa721aa2d9bc6a15f0d703a11d346adcdfe3bfd3bcc05df",
      "source_sha256": "585e6612d48a99cec5194703edf6e63987adab39332e02b63709e9d9e3c71bb0",
      "translation": "很快，主力部队也该转移了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d896a1ae9d3dbb5da2be7eed38b20b09d272d9208689bac13e925d6d06fa8af7",
      "source_sha256": "568fb2a19571aa81b72bc9615ef88b6689adf0c8b3eadb8ed5af5e6f0878bc99",
      "translation": "转移的先遣队里，有不少人先向这尊斯特拉斯大人的雕像祈愿，才动身离开。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f1e370453f5ab8a544a859360f42860ba10e439c4d5cefd3b12555a57213f78b",
      "source_sha256": "a578b05511294f1749015e8a4a4e72a1e35d39e46b099be35b813a245186d688",
      "translation": "祈愿的内容，无非就是“请让我活下来”之类的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4564361dd1140cc3638de3333784196181642e777bead0afe5d161ea23def513",
      "source_sha256": "c998adadd0887b7d14a60f5e20d251223f342144607a5dc766b2abef6c7de008",
      "translation": "把全部兵力集中在一处，极容易落入敌人的陷阱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f19fccfbbf1c8a064074272c6de43b467dac5ba87324a237d3b4661780251c37",
      "source_sha256": "7a6979d2b4ee3a3cddb9e760dc4946cb3d84a78d7a40382607dff39550017ea9",
      "translation": "正是。鲁哈尔特战场虽是盆地，却有很多地形类似峡谷的地方。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:974ce6936d08fd0b3db77cc604790783510518a984567f3f9535d4c798bd89ea",
      "source_sha256": "052bced2091de03bd78f9d3fa42334f6a589fc14459ad68c1a296c51853a3edd",
      "translation": "敌人要是趁机推下石堆，恐怕就难逃全军覆没的命运。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94d39b0196f7b5425788a0f5609fbee89eb57fbf267ef285afcdf3a118d9242b",
      "source_sha256": "31d6b21c525631473ff13d1d8db31982a8d067b2a4bb46cecc5a6813302f4433",
      "translation": "可是，道路几乎是一条直线。分散兵力的话，被各个击破的风险很高。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cee9e5a067515960919a01c83da84b9c3faf7d1ea65cd8b66ccbdc2c284e3223",
      "source_sha256": "a1bed8b2b191615d654a80a2cca75472da5e6bcff7dd745155f8d2a5cdeb2f5a",
      "translation": "总会有办法的。办法……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:33995ab58e66462d8328521c8c8ce9d11d53577ddd0387a02c4dc1f614545561",
      "source_sha256": "42e2f9faed963f6a4649150c37d17e7776d8bc69784859b4899958055826950d",
      "translation": "听说，公主利用鲁哈尔特之战前的空档，夺回了风息岛。真是了不起！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:32c92a80b10f8045b8e95c85348707692cef1f9ae08085a606ac1b4dbcf51587",
      "source_sha256": "1db85c5d037e291c790d98970ee4c069bcaa1e7f4511845fe2ce7652bca1efdb",
      "translation": "先遣队里，也有公会联盟的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff3655827425b26a8e6e1d309597c35f4081dd45ac90ca5e0cd2d3b5b5f8ce4f",
      "source_sha256": "feb2789284758ce2f58ed606b59d04d769c5b16e2fd0ec4f01f2f70b8d7e1c22",
      "translation": "他们是打算等战争获胜后，捞取大量利益吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f87df1ad7ed414cf62a705731bbfda7942adc35d1d392c86529daa0112843171",
      "source_sha256": "08b229ee49ede4251be08419e3f74b262797c4b4664a2f7990bf0de7048fcd9a",
      "translation": "这次，要是能一路打到贝尔福特，难民们也就能回故乡了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fad861621da5f931aaa2dd8adbf058cb91ec5f478543ab4a2de10db8dde34246",
      "source_sha256": "edeb8b9736c790125c6032226dc1a4df066a30acfaf2cd20b63fef66532c190e",
      "translation": "修复虽然需要时间，但所有人都只盼着战争快点结束吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7939af8759ce65dd21db3c5040bb1fdc0e5933c3b27547a533d6e8e7815c24d",
      "source_sha256": "ae2822c767af379f398578ee3cb11d0259ebf1ff1140d08692e2f8ed7d4526c0",
      "translation": "先遣队准备好了，就会通过库布发来联络吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4dfabb7266fbc25e420db896ffc397acadb703bf11c9dfa7a6104887388a03b",
      "source_sha256": "72adf953a675315998bd4c295735dcc9cea94388ef634ff65ae3867b6ac42c0a",
      "translation": "我们只要悠闲地等到那时候就行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7592d49d74102261962605341a978252ae2a2822e49b74e60ba3364485a80b2c",
      "source_sha256": "a4486c27e69a5f370106e21796fac79e84fc6e5823fd33018d87e1f9ed5e86f1",
      "translation": "里面是亚历克斯大人的房间，请注意，不要喧哗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:42f002cd1f4ce841229b6665f009597c7cf217e317502bfb277273270d2a5a36",
      "source_sha256": "142cbaae24d44a33b5487434b5ff55295b0dc7669c0a46d2b97d99e156fdedd6",
      "translation": "猫猫的武器，是晒干的鱼喵。你知道吗喵？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e0f78cdf9ba4ba960f7ee4cf9db379c66877e97a0e5abe8ce092c988327a2fe7",
      "source_sha256": "92e8911947f882307660742d424f418fba5f5aeb2bffdab1a82d71b6a76f0b43",
      "translation": "还以为已经恢复通航，结果又停航了喵。到底发生什么事了喵？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f42c5223e929dce9b4c94ad5ac8d7e45040e54fd2107568029dd784e74ce0609",
      "source_sha256": "805978fe3265f83b37e8eb594ac3a8eb0dbfc3de705f4fbd74727cfb67282be3",
      "translation": "猫猫能用尾巴感知风的流动喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3107212a987f61485c5d27d7fa4cf8e4df60064cfead2d627a6468ed3507ce92",
      "source_sha256": "ae4a9e4ae3061c0f212630b498559105ca96e4ccf72520d26b253973d2afe12d",
      "translation": "好困喵。我想去泡温泉喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12402f40b0a04d1d492af880d175c480381de6e51d3eb8acfb4990a106470cc4",
      "source_sha256": "4e7d4f398d974a414e7ed12b70cbc3199133630303cd6547a4ce8457224721d9",
      "translation": "你见过其他地区的同族了吗喵？大家都是善良的猫猫喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e245ef00db5674076d1e956275f4ab152620e30a4a466193c0cb823b8a0d06a",
      "source_sha256": "de3a8a5e263ef6f9663ee3c6016c122678b5f834415c126ed8ead241599dd58a",
      "translation": "猫猫是爱干净的生物，为了随时能洗澡，都住在水边喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81f59fadc8ca0d164e067a3a58b07b3aaf57022cc5b691d57fb7b281e3bc773b",
      "source_sha256": "091d19996a61a438dbb3f3cb27177b029ee170a9837e0ad7ff6403e119f27bb1",
      "translation": "族长为什么成了独眼，可有很～深的缘由喵。那个缘由就是……！秘密喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d91b448e0b5896cd2f995a38e31d7b12a0f539521a278c6c2e2a06bc724cb5f7",
      "source_sha256": "cad94e03cd7dd81bbb86c2660971cfe0b4c3ebe0105ef141f1d36c1a2cb0e943",
      "translation": "欢迎光临喵。多买点东西回去喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b4f5a317c21dd6c1238a6e76e5b296b610dc02d441e0a9b350c0c7cca1adb7ee",
      "source_sha256": "03901f7a68d59a2df61ba2020d6a2710b88d448518892c2e687d942a79c03d85",
      "translation": "再来哦喵。"
    },
    {
      "id": "coalesced:6c4446ed25a500b2746e5cd028964311e3e4acdae0c98f931c4dbab8300aba3c",
      "source_sha256": "620f9684737e049ef755b6e92f306f005e0de33ed3508a4bc29f10eeff2ce075",
      "translation": "这里是南部关卡。"
    },
    {
      "id": "coalesced:397841e069120de5a935004faccc8f8515652f823958999bd794f9456135146f",
      "source_sha256": "2371bab44a61b4f8425612b48a89c19bbbce324107375237fe1e93deb98d6475",
      "translation": "穿过这道门，就能前往[寂静荒野]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ad53157247f93b2fa7c46031879e271c0c176c156f568c6c622247352309367",
      "source_sha256": "2f1ed50ef8a44e24d77e9a0a51c96ff7003902037f58878c76b71fcf52c49d8f",
      "translation": "请小心凶猛的野兽和拉提族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a790716ca58331f4624b2c5c7b348b61efb45795c7221620d7e3289f3ef0606d",
      "source_sha256": "6223ff73531e909292442e8ec69fa3240f064e3fab93d60b6bc058ee97a69f8f",
      "translation": "北部军还有艾尔加、克蕾尔、修亚伦这些可怕的家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ae212703e96b5222dc86f2f70ca7bf14f92a2fef62967e97ad366d666c142d0",
      "source_sha256": "7498aa6d1ca092c49c85f040c3dd879ef9364745aafee187ab0eac916c417e51",
      "translation": "马上就到贝尔福特了，他们一定会拼死反扑……"
    },
    {
      "id": "coalesced:0be58adf6755e045726dd1a0b9e961853fafdc75514c226ee0a87aff8c9d12e8",
      "source_sha256": "a3edbc3cbd3d026177e405e0f19604f42216c4b11722d6cbf469a3acbbfc9583",
      "translation": "能见到最近城里热议的反哨兵部队，真是荣幸。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84d035e73c2aed0d33254028e3bc38561ec7505c764b2f9e7f82c87fa591ef84",
      "source_sha256": "1e129e035ed5074128fca96bc5ef02ffaf7726c1f8c67a0f889153480524d4fb",
      "translation": "能请各位签个名吗？嘻嘻哟——",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f5b427f7a11dfd72386b294f4f759e3b59666b4515d46ac1a3219aca74b2fd2",
      "source_sha256": "5878ee37c2d88f1d4603132d9847c0971d6882b310d90a302eb5168570c433d8",
      "translation": "我们虽已占领老狐峡谷，但仍需小心栖息在这里的怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80c7fa0faf9ca3a63079b0848b2da3fe0d3837fad88ea075c965fa50f27bb103",
      "source_sha256": "356ad3b397804375ff591338adfacd9d70381e875be0859fb3c32db9fd8375aa",
      "translation": "自从消灭了全部残兵，就连北部军的影子都看不到了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e27f5361e4b4d92e1aa5a5e58c54becaa12873814796522c394f32496a0c280c",
      "source_sha256": "ef83000f733456525ee0c3cdf47d60b51f8c37e3fc507a5b2745a1cc30565b78",
      "translation": "听说，战争也快接近尾声了。毕竟，我听说南部军连贝尔福特南部也已经占领了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e711231cde850af9e04f8cd0d60c0d60525e4c96864e68aee3d6cd18c5eb57e",
      "source_sha256": "c0247b9a4aa3661a36e699e278535f5736df46c9e29e35f313a78f3834a703dc",
      "translation": "再加把劲吧。"
    },
    {
      "id": "coalesced:242fd875cce987d7f806867b572dc72026db1bc5c53801ac65bf7634b6f3af49",
      "source_sha256": "7801aea2bb2cbe34933816809cf14a8868570379631abf267781a1207f8760b5",
      "translation": "守卫峡谷，心里踏实，倒也不错。虽然这里的怪物挺强。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e42009278ac326816b8d5291bc95b139db2112b7669f3a4f9de6a154af1e17de",
      "source_sha256": "9ec2e903d2c6c36c72de609866f90490b36a53020c43e23a37c7baf36b250915",
      "translation": "不过，总比最前线好吧。"
    },
    {
      "id": "coalesced:5b4edb7a830e0cf8104e2ae5dc80c1fb8f6b95e4151f0a91a27fdfe7e94f22a6",
      "source_sha256": "45fecf212187ba8526391cac4de6ef8d0b137fb63f9b76fa17e7b287de87e5e8",
      "translation": "连杜南丘陵都占领了，我们是不是也差不多可以撤离这里了？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54b40e316f25951bbf11b2ca77b787c5f49db49bace6e19f7564c7b1efc8216f",
      "source_sha256": "93bee8c7e7a3b769c127c5c0781aa02995e0d32d10759d1b9f38b67e6b373987",
      "translation": "海因格尔先生的妻子怀上孩子了。"
    },
    {
      "id": "coalesced:4289dd3399779f7db2af7286ad92f8fd10069d77716b0321bc643ce40f412b3f",
      "source_sha256": "f9995d5fd585b9edf8db23bd2e8a9f57e0e3d625e27b32f565f399f1299f635d",
      "translation": "一定会生个可爱的宝宝吧？"
    },
    {
      "id": "coalesced:ddfb156391ab561be18d12b18ad7aa7792369726c84823481ad6af77cfa5b0e1",
      "source_sha256": "12f2e81c8436e98bd563343aeda2471fa8c57c3083e329ec75d40c34cea52503",
      "translation": "海因格尔竟然很快就要当爸爸了，真让人难以相信啊。"
    },
    {
      "id": "coalesced:43e92bff2546d5df5b147f571d21f39fddb5270f529da6f84c621ff323c4d9a6",
      "source_sha256": "6d737d328dbe75af4a3b4a42df0f5fa52370762564c81dce15f625cfdec70b64",
      "translation": "就是啊。这下，海因格尔也该变得稳重些了吧？"
    },
    {
      "id": "coalesced:2b45f6fdeb23226dacd52ab2f0d437b4e16151bd191941d518b97c2bc45bcd9e",
      "source_sha256": "291e0594144583b2033ec5495282d0b88018bcbba8e7857863bf5ccc58cf6c27",
      "translation": "竟然在这种时候怀上孩子……"
    },
    {
      "id": "coalesced:b45d78d5a523320a4bdd998e2c74d0d4197c3a317dd66daf45e0356f45597e21",
      "source_sha256": "fcff3d2724a9c4ba9eb777eae88e3d9b1ace0d33b24185cfe4f4de29eae19c8f",
      "translation": "看来，坏事过后，真的也会有好事啊。"
    },
    {
      "id": "coalesced:716f7a05720b73805988f15a3c6b33a330ba9d1f7622fd69cf7062efbea7dd22",
      "source_sha256": "7451359e919c94d1ce87eb7964eed7bcd01438a0f5039128440e8992872c679d",
      "translation": "岛上已经很久没有孩子降生了。"
    },
    {
      "id": "coalesced:ec21fc9048df4f61af4f5467d6c3f0df55bd89b79fe17a008ad1472a3eec9a13",
      "source_sha256": "7e5624db90cf4bd8c1e0c8aa6eea2709edc89658568f74928c5b12ebb0dd6fbd",
      "translation": "这种感觉，真奇妙。"
    },
    {
      "id": "coalesced:afd73447a2f5972ab68aa6bfad85ee1502d7fd34ba30cbc19f9a1134b07e8be8",
      "source_sha256": "e4fda91e3ac1f114c9b92f2057752d98162cb51bc81aac2af16eb993001f6550",
      "translation": "就好像……这个孩子，是替那些牺牲于北部军之手的人们，来到这里的。"
    },
    {
      "id": "coalesced:111ea7368170a6e13a217c11652eddce28c4325aae875e10713c4e07414a75e2",
      "source_sha256": "8e0fd3d5ad1d7f31f03890c38c70bb3805bc157aed0dfe910700ebf484092076",
      "translation": "我一定……一定会好好把孩子养大。"
    },
    {
      "id": "coalesced:d44b7a4cbbe134268c9916e062ff03ce2bbdb56c59b8b45de471695fab5a75f4",
      "source_sha256": "6e067c89b39959a7c82cdc09acc85d3de3c1ca92cc48d512bb9a963710319763",
      "translation": "哈哈……不知怎么，有点不好意思。"
    },
    {
      "id": "coalesced:4c8d033406c07becc1db940a59d53619616a2dd716564f89f243a59df4c7be64",
      "source_sha256": "fc643813fe7fdc3855d02b670f15008b0738e17daac8ae8d32ba61101a1dfea8",
      "translation": "我也要当爸爸了啊……"
    },
    {
      "id": "coalesced:02e4c22e9240f6ad50080460b71593ad63e5de4f4677ba967bdf7d0fa5597d44",
      "source_sha256": "2ac16f983e899a30cc54fabc5d3d6c2a31b57b28b1c776d7f32557bcb20301f0",
      "translation": "一想到肚子里有个孩子，心情就有些奇妙。"
    },
    {
      "id": "coalesced:bfa7009ddd3a9405d61ee6a1e0a30da0b250a5158bfd381462e95c326870ae8d",
      "source_sha256": "bf8d7bca69528ef2bfda2881a706237adb467504d364b7afc47c41760dc1958a",
      "translation": "这孩子，可千万别像爸爸啊。呵呵。"
    },
    {
      "id": "coalesced:e0512c9afa2ee8d9cef672e6e390178ee7c909d97ab5294d2c5abce8236b9758",
      "source_sha256": "185fbf63393aaf2b9c9dc92812164c17ceb03e2e54a482b6b2d16a20c216dc72",
      "translation": "海因格尔的妻子怀上孩子，真是太好了。"
    },
    {
      "id": "coalesced:d8a974e56809a532b7581cf0639b69b59801f784c7aadfbf9dbe7a77d45cff4d",
      "source_sha256": "b46e81a6067aee7a0a3e09a845defccbb6c5caac70bf69b63e9666806f515bb9",
      "translation": "多亏这件事，村民们也更能从痛苦的回忆中走出来了。"
    },
    {
      "id": "coalesced:c115987c070058be8638fd95c552d879f1246228b6936f19a20fa1ef691bda35",
      "source_sha256": "f39aeddffe36704742b6dfa2e846842c8e53eb69b19b943282c8b0f059a94a8f",
      "translation": "我想，这或许也是上天的安排吧。"
    },
    {
      "id": "coalesced:dde9abce29048815a4301af87cf1d439d8d7a8d77de1e0d5484ae16c51a583b7",
      "source_sha256": "72d1149ec17c77d27f80dc827a29b8463b8bbac01f794efa54a06e4b517bd33b",
      "translation": "梅莉莎姐姐要是在，也一定会高兴的……"
    },
    {
      "id": "coalesced:45f1d2058e2e2abcd4f615ff2e6be3964129bf014dadd77724a5adfbbfc6755d",
      "source_sha256": "55f400dfbd116ff27b6db0d33ceeba6220e20d880b27d8c7bf960b0fafad7d4c",
      "translation": "好想见姐姐啊……不知道她现在在哪里？"
    },
    {
      "id": "coalesced:7d964412898be89b6226330b54756f650728abc735bae9cc0f749f5af65572e0",
      "source_sha256": "87847ddb53fdc425dc92bdde420ae80cb0856a2019ad19322b45e1ba47c5ef2b",
      "translation": "就算是为了即将出生的孩子，也绝不能让那样的事再次发生，"
    },
    {
      "id": "coalesced:6959de6e2204a9008e2885ecd7c6fb68dd2d6645b9f6914cd133d4d0412d2ff5",
      "source_sha256": "d2d12f2739860beabecab013541386e7bf849df478d0ec32a5583742b97c2412",
      "translation": "我会竭尽全力，守护这座岛。"
    },
    {
      "id": "coalesced:3cd2676b6e2e1a3d1987888b64db51df2cbb35202e4c1f465098efd0c89c5812",
      "source_sha256": "ce5a9ad11bfc7f8c4f528f89da9d0fd815c6aad7bf0c0b02f4a53dad4dfd7465",
      "translation": "说到海因格尔的孩子啊，"
    },
    {
      "id": "coalesced:886c0816f40cf4812a1056122b33f1e3bf042fa8f04c1326f8a3b829951ab2f4",
      "source_sha256": "8ed4d0038441019e3a03a1b38b529eb1e208772b7a3415ff2e6d73d46344895c",
      "translation": "妈妈那边倒没问题，可爸爸那边就让人担心了……"
    },
    {
      "id": "coalesced:27af2d4ff48cbccc3df695c117f0da3f9e563ec33d9103fff6f61e826b2985cf",
      "source_sha256": "921286a6ddbe49f824d4f9ec4fb5eee34984c606be7ea32554fe788a4fdd9296",
      "translation": "希望能生个像妈妈的孩子啊。"
    },
    {
      "id": "coalesced:841d9bae9f9c7937251a4d9d96dc3f82bce25e65f9443111c2e6d8aa96ed8e81",
      "source_sha256": "7ece67e2166a5e60359a9bfabbbaabfc2bda38d9c40d17ea3810267a8d7df310",
      "translation": "需要什么东西吗？"
    },
    {
      "id": "coalesced:159ef8eccb9b9c36f697f80de41dc51f41d4279570a1de06a8d7872798291715",
      "source_sha256": "91403388bef2173f95cc8612b4adff8dc6db5f0f3ad2b31717f94ab46ad919ca",
      "translation": "南部军的各位，加油！"
    },
    {
      "id": "coalesced:220490ac359d315fdefc4f6cb60a0fa426d44d0a6b45e4fa81c385d9b1eb688f",
      "source_sha256": "c76618cd2109ba1180dd305c45baa52a1cc48e40205926701a89a8fc76a85ebe",
      "translation": "也请别忘了，我们公会联盟一直在为胜利提供支援。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea736e5a3fb6962a922d7d27f1af179b3430817a3251c40d4f7f8a4b65b68dc3",
      "source_sha256": "e94b38bb09471b45a1ebe039bee273f328c16092e31f1e269dbbb09ba120ee6a",
      "translation": "下一次作战很快就要开始了。"
    },
    {
      "id": "coalesced:290a6bd405dfc5fdf826e06a757183a856c15af1d2ba47735b0ea8593be48f1a",
      "source_sha256": "12f0c706d10ef93a7502550a4e6cc6cab86d41524293db98813eedb84f0dc781",
      "translation": "请做好充分准备。"
    },
    {
      "id": "coalesced:908192456c2e7157e2465bc837463a3d074a10c68e08270e629f6fa4ffdae9c6",
      "source_sha256": "7dd1ebf73533af5d6ca5f31f9d5fdd91c8b02b23776e9c99aa56bb909b93cab0",
      "translation": "好，接下来就是鲁哈尔特！"
    },
    {
      "id": "coalesced:557ef49f6d33934c6ae4fb81de522ab95e90e99b448e514f698d7ff16517f750",
      "source_sha256": "7a3cf9fd88f5e27257504cfa43898471146dbfc68df26d2a25fd93c2952ee2bb",
      "translation": "等着吧，修恩扎伊特！你们这群叛逆之徒！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0717c585126addedae3cc78c57c5fdcd4bf7288a4522d49c81c7565e0b96fb5",
      "source_sha256": "2e1a28ccaca83ad7e8f7a4e4c1cea627b916b5297c35a8652237c50a5dd8c876",
      "translation": "据说，150年前，鲁哈尔特也曾发生过战争。当时，鲁哈尔特还是一座相当繁华的城市，",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:989d42d195dc8e29e8409988a9c27693f06f93220fcf5bff46a789d414de479e",
      "source_sha256": "7de4445cee34118c922f785328c07c46880bc2cc821a226a77dd11ca85695aae",
      "translation": "战争却夺走了许多人的生命，幸存者也分头逃往了北方和南方。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7843774ff0f671fd5c45614a14acdec4c8616e46f0a8f0e48aa130d083777c67",
      "source_sha256": "deb6c78e812b5cd275b2982e9f811e7acdaef8c55584372bc8c9810257906c28",
      "translation": "不过，有件事很奇怪。听说，那时候也有怪物兵器。只是，没有留下确切的记录。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b19a600a497525cd3e36f346bf2423b97c02d9da76ffeb08d35a92a0d7cfecbb",
      "source_sha256": "a170054399228c50a429033951387c6728dec23d69ce05db59fddc2e4db16d88",
      "translation": "这次，敌军本营近在眼前，对方的应对，恐怕也不会那么简单。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:049a15086db3b077ebffb9eb2f41ad669352d71d6c86be566ed0bbb20186ed75",
      "source_sha256": "f3be47fa2807f5b8789977cf618eb44ad3a2ef25d849e99b0539f54361aad76a",
      "translation": "往北走，有两条岔路，分别通往水色湿地和鲁哈尔特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee8ae882f74cf0e4f88925bcf48ddc251fd426356abcf17f87097ea637d2c65b",
      "source_sha256": "fdabd8282d3db31ca2f3059185da2638c42b420f3c6a670b402249b66068ba42",
      "translation": "听说鲁哈尔特盆地的北部军很强。如果没有信心，先在水色湿地锻炼一下，也不错。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9067a4af6d0ebb564f9e3bb705ae7704285e914c9f2c53592fb62adeb40b6ee0",
      "source_sha256": "2276b3d5ee0b0915b2cb780e168e499344b1816f697cab03caa7649d81430ae6",
      "translation": "这种时候，最让人紧张了。"
    },
    {
      "id": "coalesced:04d730db8974f69d2418c99218cf0f48d0c218b73272398b6938abe3b560aa25",
      "source_sha256": "0e5f539ec22b46e513bab56e8f267b2e23cdb563174c2784257f83ae7c8366aa",
      "translation": "不管经历多少次，这一刻的紧张感，都不会消失。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54bd7f708acf99edf5556e5178a87d1f63a046e9276f8d985ba23d51a256e648",
      "source_sha256": "343335f519f6eb9d1a87fe1444f317282ffc2a0afa990b7b145123673c1b4424",
      "translation": "我一直在等这一刻！"
    },
    {
      "id": "coalesced:723144cb129d725296fe6b01e2a087e3fb0c1a7ca6ecea7fd1096d578d455d4c",
      "source_sha256": "a2898970bef0c8a1aa9721195eac246aeb1e1a913d63fe4c2fbc8c7d0343864f",
      "translation": "青月特雷瓦绝不会输！"
    },
    {
      "id": "coalesced:d0b7cf3201dbd8eaa6cec84e148e44973618b5209696c7eaf1171dd889fa2364",
      "source_sha256": "f6f5f9e4d27bdb2bfdf8dbcdf18f0eb90975255b743b155353b5546303178c98",
      "translation": "我有点事要想，请让我独自待一会儿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2025b2d241f47a24e367620bcc96420cf8cdf240b42118041f1e6a60337b2102",
      "source_sha256": "8e028b39bee7cb257d50e2189d4b0fb0c6f9d104b3b927fa904ce6c6bd6a85e5",
      "translation": "各位要休息一下吗？"
    },
    {
      "id": "coalesced:98c51c52eb65d97cb5ff2685dfde8a546e83cc189a6e8b91eb77408edd391027",
      "source_sha256": "81e815d44d08c3fd4c480814daad429e298840966be9910e81b206fb64bc4bc8",
      "translation": "那么，请好好休息。"
    },
    {
      "id": "coalesced:8d76a26a15b668ffb6175473a8c385231420e7259b5c1bf99285320d8308e9c1",
      "source_sha256": "4f118e8c929dc001027ad4585217965d0a46bde60d1a2649d9368b3a171aec5d",
      "translation": "有需要的话，请来找我。"
    },
    {
      "id": "coalesced:2c5702b0b6c4204ab11c0cb2fd888ea1ce28616636df9b1e10bb1369b7a4dcda",
      "source_sha256": "98628dbf7b00185d17b895714ee372aa4a85bd02877426c09d2295d6e358dfc1",
      "translation": "应该就在这一带……究竟在哪里啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2eabf034af9304ed046d867fac6cf3f53516b064421f7329cfec77c39067fad7",
      "source_sha256": "829b51d19582d497da9699e8224f78830f7c0c22f5021732409b89268b222c5c",
      "translation": "啊，真是谢谢你们帮我找到东西。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7f212e4f3f37095d838ed3186f005d7b7250e6f0d8e654b581b7cb885231f16",
      "source_sha256": "e2c460ce3ab7b1a8f71bc018236047cc58da23482ac0155cb35fbef49e3fca0d",
      "translation": "不过，我一回来，就被塞了一大堆活。哎哟哟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3dae25706c76209064c4305da8ed0a493e70ab8191738d633303a3c68c34220b",
      "source_sha256": "0c511a2f7b7225fd347a1f1638573a19845375ffc5fb9927bce5d7acab2badb9",
      "translation": "我再也不想遇到那种怪物了。只要想起当时的情景，至今还会浑身发冷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63cbd7ac88d36c1b43c875bbaa4af4bbaa0d4e16c464776014a0e8225592aef7",
      "source_sha256": "675c6cfb305452ee82fb2b65cada06404ffcdc5f1df42dcce617e82d3a897f98",
      "translation": "拉诺阿拉湖为什么会出现那种怪物？难道是变异吗？？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed12734508abda5eee71a7f7497a503f7003af24a6c482a13f67d52a50515db5",
      "source_sha256": "b9b2539ffc801a7daf14f5343090267b5e4c9418730c458b3a154dedb7323aa5",
      "translation": "要买东西，请到这边来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:574f6bac95a28e00fb3d00d6b6d7b7cc3741b8cc9c27a2333015c7d7b5d08776",
      "source_sha256": "aa9eaf23027fdecedf14d51108bc793418785ea0e80b791d7022dcc29c167aed",
      "translation": "以前，这里也有很多人来往，",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4fdaf62b828bda2215ddac03b776118ee03ae64111e587a8b39bcb4041e31867",
      "source_sha256": "94dc1d5c942cdf7f1338fd2b51fca5edfaa6c1f925f98e241fd31bfddd7380fa",
      "translation": "可现在，也许是因为战争，已经很难见到人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a47ec29b3aeed8078f91f01c08539260e651d622e02ce246ad09af8c0ccf5900",
      "source_sha256": "4a8f89a68993121b39850cefc89cff7ebbf4ae8da104982839b663a8e966fceb",
      "translation": "杜南平原东边，曾有一座叫[雷恩波尔特]的村庄。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f8960f7efe1e67accd76c7b31d2948df96505335bd22dfee63fe2fdbb924217",
      "source_sha256": "9d3df044301615c8fc5aaa8f3f15d6061e6a08935a5a16a6cf1c780760208abb",
      "translation": "那是个有名的铁匠居住的宁静村庄。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3c03c01b6f643f1864293287b7dfadeef95a66f82d048a30763eecb8d15a0320",
      "source_sha256": "03a44b1a3d1a8b0da2805a8f4a0e84435309c4fe7658a10a84d5beccc625b70d",
      "translation": "直到北部军觊觎那位铁匠的剑，闯进村庄之前，都是如此。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a0ca452e7506e0d22b943765dbd8ca0350b172ae56cddfa38dee9871ceef6ee",
      "source_sha256": "8e1613087a51d1e929dd6ce8d43290751fe6970e35c9466a2c29f46a39037435",
      "translation": "最后，铁匠拒绝把剑交给北部军，村庄也沦为了废墟。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e53c2ea089db84f0c6261a2fcdb5b08fe676beb7dafcd64609bf31021f50c7a",
      "source_sha256": "00775c4fb1800c6546901fc5698e67faa2f99d88f0a73f454e80e3ebd41dd461",
      "translation": "如今，谁也不知道那把剑在哪里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc5ad9874aee3aa7aa6b8a97e4b5df73b073b4cfceada6562f42c99ac31190a4",
      "source_sha256": "77c179921a0f0bcbe97a964b854162df891b5047d6b5b18ee1612d6b47f5ce04",
      "translation": "你们先走吧。我也很快就回去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a083682d23e7b4c909f9a176e83dda0e4cf1a46ced4ee9c072c7ae991549be5",
      "source_sha256": "78878c1be1ba13bc8729093ae7c7a958dba48bf68f4a1b68946b6842d375b4a5",
      "translation": "出售旅人的必需品。来看看吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b3b0aabff8f26a8ba6426e010ca7869b0a7e9536bd801eafc781a5859fad1a34",
      "source_sha256": "e98d7a8529cc0343184a1b3fd1d01e20865dbac928a961fc7b968682f000875c",
      "translation": "这段时间，真对不起。"
    },
    {
      "id": "coalesced:2a3de0cf1c2bc780d0c46b2de85e44477b65290f9b6d4e833ca1ce0569c597d1",
      "source_sha256": "0acf3b04d4a89fcc8d5a14cda35292ce874f45e83a82ca2a09e5675015063fa7",
      "translation": "我已经没什么能为你做的了。"
    },
    {
      "id": "coalesced:0b237383bd1a074ef3bc05049d83179e5397d34e00bf6d254a67cb951a2e7c1a",
      "source_sha256": "bcf475dede0f8d1e8c23829465590ac92c5ff9c6c48e4c1a9cced8a929f78453",
      "translation": "从现在起，要由你自己判断、自己行动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5723ea3e742d1fb2a339f81b88b98cfc8eb8a8ac87f5a79e58e6540e27f1a132",
      "source_sha256": "563ceeaa58cbe371e4ca24804822b4b983781a3eb82d6ae9cdb0eb70dee86da8",
      "translation": "海因格尔"
    },
    {
      "id": "coalesced:b5937bf02a6fcecf079f101659e1700a0f00841f96280b05103125ed028609f5",
      "source_sha256": "b83699b4a258ffe41bab77fe4b79c5e95e367c941b7333133b84e77da3dff992",
      "translation": "拉诺阿拉湖"
    },
    {
      "id": "coalesced:86befcd0b2a0bfef46e6ec4ca8018956331a716e5863ab651ff7be8d31c6f47e",
      "source_sha256": "02b6c3a6c1f937f33f939520c1be22bee7a3590787c784b6451fecc16f1c189f",
      "translation": "雷恩波尔特废墟"
    }
  ]
}
