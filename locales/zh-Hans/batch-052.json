{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:c9240b42e411211a9c0f312e339f66331ad24d564b792fa72ebfb951301ce4c0",
      "source_sha256": "b05ec78bda5a4f2fe524f3daa347184e99e53d45294cb15e0f5664052bf0609d",
      "translation": "这是怎么回事？"
    },
    {
      "id": "coalesced:fe4f876fdf7a43280d1fdf8d992f808b4973822a35fedf1e43ff657d0938c57d",
      "source_sha256": "b5052375e4d960b201d109cc90e5a4ed91b12de19b606cc6b591a2c63230f363",
      "translation": "说来话长，族长。总之，朱特哥哥的情况很危险，得赶快先为他治疗。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02dc3d310e2ea4c94824adb8c6adda05bad974d7d29a36a38601073de2b43ada",
      "source_sha256": "8343e6f4af71923c12e09ec0570aca88d42f1e6025511170dde967e03d77238c",
      "translation": "艾尔加……不，朱特！怎么会伤成这样？到底发生了什么……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:036a9d883201a0e21f04a27e451376ce6b4b97f2cedf03623cb7e33a2e1a3c20",
      "source_sha256": "db96af0cbf563c3deb63fac50e2f0c2f4433f1f1aa7ffe3540783455808f896a",
      "translation": "咦？大叔，你已经来我们村子了啊？"
    },
    {
      "id": "coalesced:fe38040a1e9175734e44b6a3f0c058714031e8d2af1c4ef53d2c6481b08b2a29",
      "source_sha256": "9ffc28bda68505849dff64ea0a286795d8b7489fea545516abfcb5ddda6da495",
      "translation": "你平安无事啊。"
    },
    {
      "id": "coalesced:d514fb5b60e16a4be1d39ebba48e0fbffa6e66e8b4f5ceb26a18cdf78bb80d92",
      "source_sha256": "4be0c1a6cfe39c7eb107673fca9c7d95912a90ed0eb871a265c018abc5efce16",
      "translation": "是的，多亏各位，我才平安来到了柯塔马雷。不过，朱特这是怎么了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e57565ac59105acc84cb4a1c4b0d511dac683346e3e266d938ed09993047b2bc",
      "source_sha256": "2e0e4f601cecdfc7f08a1500dbc945ea71dcbfeba82dac2fee824372acd349a6",
      "translation": "难道这伤……是因为违抗了修恩扎伊特的命令？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1a7c3e66eee04b2606bd787daaa2673ed2b96dc874de0de3c8fb33dc0f39c75",
      "source_sha256": "419a5a4dcf6967458c33c92d1393ade5dfa70f354d9f89529c5f2766e1ee0020",
      "translation": "你怎么会知道？"
    },
    {
      "id": "coalesced:a52d6254a973cc578d3aea22987a58c4e62459461385397d0785007f752c2a94",
      "source_sha256": "7eae05c17230aa8a684ce677db6569897c7899451f51800200a99511b2bdd112",
      "translation": "因为违抗主人的命令……就会被灼伤。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f35df0c46102f47142cb8a20f9c39422aca6da3412a75b1ff5142100a9dcf0ea",
      "source_sha256": "fa1f94d47c40e0aab5132fc27ac431f357a3a91aee9f9a0d7461330f2b1f66ce",
      "translation": "先让我看看他的情况吧。"
    },
    {
      "id": "coalesced:37315d43eccb512ed9ece050a0a6d79e27977c714afe9a1fe67f6526a0b68bec",
      "source_sha256": "a6fa0b9353ff66a300efd8a70dd3890c8d593a2bbed67d3de0a52cad10fd6026",
      "translation": "为了强迫自己创造的哨兵服从，主人会用痛苦来支配哨兵。他采用了最省事的办法。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7b63886e5ce8d399e4572db8274855064785203ae48bb77530468067c92e671",
      "source_sha256": "772c07a584ae19afcc27c2ce95c9f7197c619a1619d0ff3be6a40cf60189e450",
      "translation": "当然，智力低下的哨兵根本不懂得反抗，所以一开始就没有必要让它们感受痛苦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ca953235b25da63a79e426d354b02606df2b3540f88cae7c8d02fc284bd8b61",
      "source_sha256": "ead2014888637c9b85fb184126ea7c7a8c836ae14a935038e063ec2e32f9b82d",
      "translation": "可是，拥有智慧的哨兵不同。他们能够独立思考，也拥有自由意志。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b045ccf84c8a5c3afc9c38fe58ca3fda898bcc76491dcab4d42c5b256a6b7b1",
      "source_sha256": "5c89c2ebdd036e8923e89428b1825eaacdfb28413c813b91467399c520b55b72",
      "translation": "不过，无论哪种哨兵，只要体内的卡蒙德被破坏，生命活动就会停止，这一点都一样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e762530e6a28c62f76cf860466253eb4318b05aadcd013927728571d2743860",
      "source_sha256": "561e9e633df104875704335b1f2027e5e42b9e160bb52eb8f0aeb830214055d2",
      "translation": "喂，别说那些难懂的话了。所以，这家伙到底怎么样了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b3ee1f42bdd2920c201982d62b4ae96a4d36a81e09ca10b4e07b26122f7c4bc2",
      "source_sha256": "8291d51fb02df30df06b3be72133a3fa0a057238034dfde435c68856ed702eb9",
      "translation": "现在，朱特的卡蒙德已经濒临破碎。能撑到现在，简直就是奇迹。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6629130dcb7b820b7eea99450b9b58dace6143430085e54b0c1572879bff7189",
      "source_sha256": "99aa5b2ca3cdeb9a731166b80921fa09f876751e4dd1a7c07efe80d31cd721ab",
      "translation": "那……那是什么意思？"
    },
    {
      "id": "coalesced:c4d1b3623f7879143ef5594d97efa8df4b48aba9669c7dd555b56c18d7e5e15f",
      "source_sha256": "933f669103a43e647a8bbd3aa28f67e498fd0024906d8ef03b6e51d3eb7fc0f5",
      "translation": "朱特……再这样下去，很快就会永远闭上眼睛。"
    },
    {
      "id": "coalesced:67953195d7a6fd8386b24de757971369852727ea9259341ead2a447d86244171",
      "source_sha256": "5ccb6bd70ceac34790d3e18ab220783c03a9cb57e5149a02c9a81b7d47b13997",
      "translation": "真的？"
    },
    {
      "id": "coalesced:daf20eae66f0d2ad6daba6b09e7487aa9f08d452756a5c267030bcda05654dee",
      "source_sha256": "3930d2c3daf5271ab35f7a9d76020590f268c7b6460173ab2ca6592679b76590",
      "translation": "就像人类的心脏毁坏后无法存活，哨兵的卡蒙德毁坏后，也无法活下去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0dd7f57f6c25b8913584fb8026961e264c8e75d90159ce29aad55b348640595",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:12329e0ac317bac734f317028d81bd3e0ac8f0062a084b351e001d03b9f12db0",
      "source_sha256": "d8b3789555b0e4888508d180f7d32d7a477223d99ffb62902f7bfd69ec2d2647",
      "translation": "朱特……怎么会……"
    },
    {
      "id": "coalesced:726cc0b8a04de2a9b28b58c56c66c6f2eb64a184b3f10ff09d112158eeaf85fd",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主……"
    },
    {
      "id": "coalesced:2ba1006c1cf7aeb508e860b597d3a7bdc551569bae9478613a2b57e2dc40810a",
      "source_sha256": "5727fa6b381a9ca77711281d5acfd400682934ce1f2be33fa3f1e075a21c0a90",
      "translation": "就没有办法救朱特吗？"
    },
    {
      "id": "coalesced:fb5b673cc9125a4a01bf2ef901ed1cd72ad36af8d3add1d447965377560b2f9d",
      "source_sha256": "ed9de86b6f9831dfe0730c45235f66c4b1e87b4e149ee5b07b38019da68b757e",
      "translation": "这个，如果是身为玛格纳卡尔塔的公主，或许有可能……但很危险。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:637ddcccca41daca65280355bc37e53ae0577e6b1dd9d289c19fec45d854167a",
      "source_sha256": "e50154073712a5e4a9c7d11c9f3c5839eb8401950470fe73af6cae04f8a04e31",
      "translation": "我该怎么做？"
    },
    {
      "id": "coalesced:bbdf395e95c53fff84e4b30d3c416e03d4ef7baeb0dde72f730b7f1412c085d3",
      "source_sha256": "8ffe417e536a769e9a5bd2b735f109a6290932c8aabb1c99c7c6ca585363ead0",
      "translation": "再次缔结……血之契约。"
    },
    {
      "id": "coalesced:50d8a27f6d60e6d55131c779bc3d612294bdf59ab451d6455a81e30ac2724436",
      "source_sha256": "0ab880f96f7c13912badd08ed0f7e74e19683c5bf895bd6cc26ea5749840c869",
      "translation": "把朱特体内破碎的卡蒙德换成另一颗卡蒙德，再重新缔结契约，应该就可以了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:33bf2ec05419d5b516486f622af547009a69163d36fe24405c4b32bfa67c1c04",
      "source_sha256": "c3aa28fdd2cb51169741850e1d1e1add42dcfb34156ed17bd91fa19e54739e67",
      "translation": "不过，那样一来，公主就必须成为朱特新的主人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bbbf2b0a36d6735e44b7d9f7cb7d8afe013ab177be88205131f198c4ce7518f5",
      "source_sha256": "d55f0262bf740b5f76b0cdd6a038067ffd05e3ca88115623d0a188a1d61fd0ab",
      "translation": "像修恩扎伊特那样吗？"
    },
    {
      "id": "coalesced:e40e27355e01ec18e902e50df411d866155c65729e1395c2ee0060f78a4f581a",
      "source_sha256": "2d30bc339670e234002c2f6f67abed9188cc6afe69003e226f052a7cf8557f18",
      "translation": "是的。朱特原本是如同人偶一般的存在。通过血之契约，主人将自己的一部分生命分给他，他才得以活着。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:36d0840ff24a119375a08a6688f4e16936bee487bee4ab5993b326078260f16d",
      "source_sha256": "24f605f50d66a852a7eb53e24ce5d763eadc6f1b0473f82093ddb158822132c0",
      "translation": "也就是说，朱特是依靠连环术才能存活的生命。"
    },
    {
      "id": "coalesced:591ea4217bb2288c209a9cc061c343f9291d97bfcac171b40a123fa191401a88",
      "source_sha256": "5bf88c97608f845465bceeecd70802c8899e7a14268aa614ca8e39343221dbd6",
      "translation": "如今，朱特因为违抗主人的命令，卡蒙德遭到了损坏。血之契约留下的刻印，也正在逐渐消失。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:127c5c4c00cc78ea42345569a44a7155f4da99380df9d25c19c1885cd167be6d",
      "source_sha256": "65b875b64264c4890ed1372f9dd95ee5c7605f033a49da233ac6657542eb8f60",
      "translation": "这样下去，他与主人的联系就会断开，生命活动也会停止。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6e4abc0d0d82c8ee32a57bc4b46601c5ffd0216f31be05c5b7e8dbdfd43d851",
      "source_sha256": "8a5401bd400a33e28631609268a53caafa73d3f5e29a264d0a24195a231338aa",
      "translation": "因此，要救活朱特，理论上只要由新的主人，为他留下新的刻印就可以了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96d0333bcf06c900a3e14e77eb1fb527a076869277a723f12ea8bffc493186f1",
      "source_sha256": "2a25bd6d84f356a6aa53ba736ce76f9a11df22ad74ca68fb9eb0c29cefde9d31",
      "translation": "然而，更换主人这件事，至今从来没有人尝试过。会发生什么，谁也不知道……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:89ff6ca5c02b5822f5bdd7bc803f41ee875c0b2330a443285f8e9d5e142d36df",
      "source_sha256": "c58370a95bc51f275cec447a6c82691ee2d87021a50ff364c7fe95897d7467c5",
      "translation": "要是贸然行事……公主和朱特，可能都会永远无法醒来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:709983ec42151f4da80d5122cb4c3323eb72cae4239f7e27e23c041d9e23a966",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:ce01ea2628648f51ad72da76539048f6a6b95732d412483dfeb22d51519ad1dd",
      "source_sha256": "d40206d35a00e80498de4475436fa55bb3a5a96ba30f78c3db4e7506959f4502",
      "translation": "而且，听说公主……对艾尔加怀有怨恨。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28355e208aecf0150ff67c50c6202dfbe8e51d3750190eba26d553b2f711ebbe",
      "source_sha256": "82c9c58b5b3d06480c472fb069c59a13b1b9171a80aeaed7dd41b2531ba59d6d",
      "translation": "您应该知道，朱特就是艾尔加。这样也没关系吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b64af175073f722058697abe2936e949c6e2010e3c3abfbae755bc41d8585e84",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:28fbd60938009166cf6d1c3ed3433a50f48843979f05812d5fcf6fa88697bdd1",
      "source_sha256": "8445741d7d6a831276e8794b874cebee94940ba0e963d4f109bf72f437426789",
      "translation": "是的。"
    },
    {
      "id": "coalesced:cc9968d50a69e9565f0dd0cf6b08edb7645512772a6dec82e30dc8664fef2833",
      "source_sha256": "d6c2f2d9e2b57da2df8773188c2a494822cd57ce599959e2e37931a72a3882bc",
      "translation": "因为我想救的，不是艾尔加，而是朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad7ce6118767d01750e318ee895cef2f4cb99e4c69755dcf96c3187096993028",
      "source_sha256": "28436d3d67b6fa14880f47cff058e164e49919b09323429f869839a591f7961b",
      "translation": "公主……这很危险，您真的要这么做吗？"
    },
    {
      "id": "coalesced:2a13cdad0347a9faca34105534010d9d56f5463c8587ab66352caf97b2ce4cac",
      "source_sha256": "78c212c1cdaf6683df3b0b65ceff411a8d5a76f7bd06d1395f212cd8131e2b6b",
      "translation": "我不能就这样眼睁睁看着朱特死去。"
    },
    {
      "id": "coalesced:685f5af1c91e040ddde661abdd54792eab74b5c418d7663b73e53cee507c07de",
      "source_sha256": "f1e0a5b93118260557e015e6c4dd78eaff7bdaa41b75accc7974c768aceea6f5",
      "translation": "好。那么，得赶快找到一颗新的卡蒙德，替换朱特体内的那一颗。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01221044bf971b33f59ce4659d134b2339351579bf3be7f6d97bbaf57bde3ea1",
      "source_sha256": "4e9eb51aab842be89eccdfcadefe492f4e10bc0a387b6f929d934d1911803eb2",
      "translation": "与各位熟悉的普通卡蒙德不同，我们需要性能格外强大的卡蒙德。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d489e91dfdb37ed30b849eafadc5d2bb6130f9827e32b44244100338c6d1a2ee",
      "source_sha256": "1f09843ecb1c73c649b25a16c2cb76fb3d20dfe7e609cdadaa71fae55f1f6fe4",
      "translation": "那种特殊的卡蒙德，到底要去哪里找？"
    },
    {
      "id": "coalesced:2914e6c8b6c514d2f48625c035c8526be2dda90dca028e4bdd578f9b60b74f20",
      "source_sha256": "85468394e2497eba840f2a16731693180493e1ae26ff2f3258d45873a379c391",
      "translation": "这个……我也说不准具体在哪里，但越是强大怪物体内的卡蒙德，就越理想。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c33f0c74fe177cc06e37f4fb2861c883a6c885fc7440fd68eeb06db7ffd552f",
      "source_sha256": "e73625a07e1264fca540b98c205afe43bc6d36ecfade85fb99c4f38f4c3de31e",
      "translation": "强大的怪物……"
    },
    {
      "id": "coalesced:ca1a5e0fd0b1de08a6840e4200cafd55f2b862c26d1dc5dbce96013861764275",
      "source_sha256": "73dbe010ed5da9b4216f7cad7bc0202c694d9037eaf0d806964b50df2beaa6b6",
      "translation": "啊，说不定……"
    },
    {
      "id": "coalesced:41689fb3e32c8d2f9e8a13ffe9c67c4f7ddf1123d93fcc1dc64a8b12b21f3bcd",
      "source_sha256": "d31791a4aa7ea5820495041360da360040cb4ed6815acce12d1afb021edf1157",
      "translation": "你想到什么了？"
    },
    {
      "id": "coalesced:27000a3f00c79757794cfd4aae6177072463a850eefac3d706db533dd7bef24d",
      "source_sha256": "6e0d4f0512703e44caa9caee8e39553e0c5383d1bc614ef6d630413110203f29",
      "translation": "听说，每年这个时候，海底洞窟里都会出现一只巨大的怪物！"
    },
    {
      "id": "coalesced:d65d872ea246f93047d205cae295d47cc4334ec6258f2cb21715a2c1bc211a21",
      "source_sha256": "f0cb8b670ff791460ad7900452210757359cc06ee35970d95b1c44f9e687bb72",
      "translation": "怪物？"
    },
    {
      "id": "coalesced:c326fd887a1e8eba4760bd94db21c768ba94d9cf45946cbe67dbce92030418ae",
      "source_sha256": "d731099cf66ef7ddc7f53d4beca7476f03f625d3540bbce02af58ac14ae3ec21",
      "translation": "嗯。所以族长说过，不准进入洞窟。听说，连其他怪物都会害怕得逃走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8d3cdf0552a2fd545bd04f6a58d13eed02515b9a8cad2a87b1ceb4878c54bce",
      "source_sha256": "172b87301db95473d798cfbadc98d0e98937f893788a499a2a3509df98bebb31",
      "translation": "要是那家伙真有那么强，说不定就能拿到合用的卡蒙德吧？怎么样？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e5c1dae5b933f4cfc21721d697409732ba777943c35f77f5ca359c6afc5226b",
      "source_sha256": "a249b23ca3f630a7966add3ee7d65c5d082c484348056d35f92132a28308e83f",
      "translation": "没时间了，先去确认一下吧。"
    },
    {
      "id": "coalesced:f25bca731e77888b5031a65177782a395503bae83a63b544ac67b370c3ae9eea",
      "source_sha256": "5ac0dccd895d858696321c809859c6c8e9d747be526caae1099e31249537e141",
      "translation": "好。请各位抓紧时间。"
    },
    {
      "id": "coalesced:8f4f2150a3aed32a86178c3b24249fcdfdd8d3a95bea1983fed0c2e33dbe0974",
      "source_sha256": "9bab4fbcfcb6a8bba286a81039ebc99cbe283e85817814ff3db99c97d7720a9a",
      "translation": "找到卡蒙德以后，请到柯塔马雷入口来。我会带着朱特，在那里等各位。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3e63268c987b0daf22dd0fd0bf8c4d65be5227f4c3aba9e813f560bbec93517",
      "source_sha256": "b0eeff28a47228787c9b0ad198eeccc55b8229ec75a076e9bbc3049a68064c1c",
      "translation": "在我家不就好了吗？朱特哥哥可是伤员。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19afc3d5ca93c34bbbb4169619f410a8f8a8a1d4cf96d62b7dad7f4d8cc99686",
      "source_sha256": "f4b841fcdcccc203aeb029f85c0ed99ef2650bedbaf57b92473ef54b1012fa3a",
      "translation": "那是因为，这次的血之契约很危险。"
    },
    {
      "id": "coalesced:9963963b44b9d46cfc63a069708a1c61a9b8d0504281d83f9196231b49cb1cd4",
      "source_sha256": "525a35b89f4303e47e25c6b780025fd1cc6c55aa7a7ab435acf6243cc5fc0729",
      "translation": "为了缔结新的契约，公主必须接触朱特的精神，并与其同步。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf387e920097d93b13adc79c0e35586daa63e16c610c54c0da571c8edbab29cd",
      "source_sha256": "9467e8acb2d4c4e1997a7f233b5dee39465ac2803524b5389c1fbb830a5c228c",
      "translation": "然后在其中切断他与修恩扎伊特长久以来的联系，留下新的刻印。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54d5031eca7902bce8c5c4df61d291893978c3844215d4aa4aec5ff4d6e60d19",
      "source_sha256": "3ca3b02fecc2771feab09a8a31d4e2b7b8fc2e79c6e99e797887a8bf3a59de99",
      "translation": "可是，一旦接触朱特的精神，潜藏在其中的黑暗就有可能涌出，影响周围。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce083944ddf935d21ddb50dc20010b50a3294b1b58384126d33dfaa620d29d5c",
      "source_sha256": "da1fed772856d1accd1950223229ae4c2b822929d05653fee9ea7bea0ae5c34f",
      "translation": "啊……那是什么意思？"
    },
    {
      "id": "coalesced:8a13b9629b2c82e35bce1e521130e3252220fd1737fa8c6506f3bf1011e03eac",
      "source_sha256": "0f4fb89afd14c78c24c47189cc2741c76cfd87078945d13a11eb62f560c25287",
      "translation": "因为是强行接触他的精神，潜藏在朱特心中的恐惧和不安，可能会被极度放大，在我们眼前化为实体。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98a10ccc33e442aef62f08befeeee446122ee5471356939ae8f23cb8f7321381",
      "source_sha256": "9b36dcba99e7b0a3f7681c177de038e045af810ceff3749060333aa850029f49",
      "translation": "真难以置信。化为实体是什么意思？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da3e7928ea55146cdcad5a355c6e3beacba9d00db08812bd6a8cf9661810c294",
      "source_sha256": "40d2dcd2646b48e362b693a832871f71f916ec399e91704b8aee57ae9af76037",
      "translation": "也就是说，类似怪物的存在，可能会出现在我们眼前。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da4b2d9e7c179dadb400b69d5545ab6b73d930c93438efbf618d2f01eb9e515e",
      "source_sha256": "f03904fc23fb6ab3c6d8b84b777ca0413641e2a1dbd8530e58732c6aa9c1d85d",
      "translation": "所以，要是在村子里进行，就会伤害到马雷族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:321087d0a7d94337123654d44e647395ea1c1f00edf3b9a1da3c19ce9b14e6af",
      "source_sha256": "aafbcf5dad732eb6a3343838d4da53e88dca0ba4d50d91f90364a6898e1cdea4",
      "translation": "啊，原来是这样……"
    },
    {
      "id": "coalesced:36c39759f9ee9f3695d2baf9fce7ce73786cb40fc3a9b204d8f7c3350bf2f61f",
      "source_sha256": "c4bbce0ce59bd0d78f9ceeb133c3c499fa35487e000a2b169bd395e22a95b0b1",
      "translation": "公主，您做好觉悟了吗？"
    },
    {
      "id": "coalesced:c0e85f7e478704834378aad6c185eb4790b4532a04ef2adb79c34c010a991745",
      "source_sha256": "aff35e3403bb8e8674840adb791507d192173e7bb49f64d3e593ded5130c59d5",
      "translation": "嗯，当然。我们先去找卡蒙德，之后在柯塔马雷入口见吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e29c12d584992086ed46db1f72a8d0670133cf6cb4f283405175c0d4168ce94",
      "source_sha256": "802639f0c5bbacf3fda876b2ada8bc11ccd8b2dfb4573df9d91d703a95163b4e",
      "translation": "马雷族里，没有一个傻瓜会认为，只要公主死了，世界就会得救。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aac040a67e5f00c5319d896efe2f5db26455ae60dbd80dc3fc4a5844d3e79137",
      "source_sha256": "43e108fa6917dc8c5e37700cac4ab4644100f1f54e61df7cdb35fb5368f33ae9",
      "translation": "人类似乎都很喜欢随波逐流，任由周围的意见摆布。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17109f514157e12916ce4d7c257298130aa1f7ded358b76e227518b3912b1611",
      "source_sha256": "895bb3ee472140636706dc2313279907f81f35c3f266babb1a110506862ee402",
      "translation": "明明只要相信自己的信念和判断就好……"
    },
    {
      "id": "coalesced:c7cdef85a5d3d1dbbe4df717c0c763cb331fa0938e2e1dfec9a2827944f5519e",
      "source_sha256": "bddf15cfab5d2c6a4c0a169f04f58bdc9f78456bea01655f1b218088e851e27b",
      "translation": "我们只守护这里。你们得靠自己保护自己。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:728d504c4cb4ae35d8213aefc1ee0bc141bfb7f8a082bcddaabbbe6f1e6bd48f",
      "source_sha256": "b53bbcb1040e8bcae017f62ec3c2b29687b4718f3a3bbb195d7ea29090f98957",
      "translation": "你们对我们有恩。我想，现在是报恩的时候了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8e37a1271d1501322ad7bfc1b5095cf1b46ead6ed63dc38accb189b7eb03d7b",
      "source_sha256": "f09e0d5a25ff27788468f9ade2303e0ba473b31763ae01c4cd51f31b89216438",
      "translation": "好久不见。事情我都听说了。你们能平安逃出来，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:371b709ff2a74c2ab299dd1dd6e1da9ac0916f8a6fc4ce4f8432899433e44e97",
      "source_sha256": "afacfec52d7726f9f803095ca5dbd2e4de66cbee6c76f8d2295a13f98b5ccab8",
      "translation": "还以为有一阵子没见到你们，没想到又出现了。这次又来要求什么？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72c90cc7b5a34e74e80a29e293eec0dc63f8cca21414c13986ddb31f4b1f244e",
      "source_sha256": "e228c9670dea8155fc974bc918ebc134868d4e1c66efb5fc6dc0262d0b0e734d",
      "translation": "人类果然是自私的生物。"
    },
    {
      "id": "coalesced:a816caa44f1375069a0c02d11b4086edee8fcdf60b8d9142de62cbbbbb3639d5",
      "source_sha256": "9ed4f64c4ce0e03b7e46e1d7d5fda616b401ad1fad1c1e2d4fdd5d0dc4694265",
      "translation": "无论事情变成怎样，我都相信族长。所以，欢迎你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8af746a740c1aa51e08d1ff7c33cab6da2d7e4a49fb418187810e7af67d28f05",
      "source_sha256": "471b793c1901a8bfbd8dce18d76708006a6b25c9fd09c07a0897af30d7a40d4f",
      "translation": "请安心在这里住下吧。"
    },
    {
      "id": "coalesced:1c5b450a687652355021940444123768d3c24776b668ee527ff8a8b99892c205",
      "source_sha256": "98403889840a83b3b49e8f57b6f8e42e12831f5764ed142978df8dd1db623118",
      "translation": "不用太担心村子的事。不会因为各位来了，就出什么大事的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe571b94134e1412958ea3c79208e25233ffb287ba6c91aa5a8719a342dc9f78",
      "source_sha256": "682cc00e53172a6c63103a9a8987292820109fb5983e23e9797e27be69f1d6bb",
      "translation": "如果真的有危险，村里的连环术师会出手，筑起冰墙来保护村子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9fbc47d52dd445b5e3f8dd3bf07d1032ce1c122273b6752bdfe8ef078067fc36",
      "source_sha256": "0a841ade84d8afc3dc76ee3b62ed4142705a3d3953f7fc2f38310c5559b59769",
      "translation": "有冰墙在，北部军也不敢贸然闯进来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcde7819c2ffb0f576093b41aad162b1a823012a409a1504736883f55d733e07",
      "source_sha256": "03ff64b0ca4d008bb826dff604c12bb040073f55e7953e6c65818cec3c641dd1",
      "translation": "不过，这样下去，南部军也会成为我们的敌人……还是有点担心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8aa553db6cba11ecbf4ec9cee12593dbdd0846c9152095fcaa7709d36169baf",
      "source_sha256": "bc8c06ef36c507a37c56fae01ac412022e1e3f6ecafd6166fdc55c6588d56b40",
      "translation": "你好。又来了啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:11b5c5887f502c73e40282dd33ff7ccaf2b3e715766f5ee34bde80c59072447b",
      "source_sha256": "b55fe66eee252d479cbef3655eab12cb82c605469faf3b65f0c12d791217ebf9",
      "translation": "没事，没事。不管发生什么，我都会保护妹妹。哈哈哈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:46e408dad18616e4771181311ce0164ac8a6204c7d3ed18637fb3fce7b1d8d55",
      "source_sha256": "fd3d718164fce4bc33f633ad24d03fda91f2b4b9247a92a932d572cc2f110f58",
      "translation": "我已经是大人了。才不会无缘无故一看见人类就扑上去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9180e9556e3c585527f1f08d5b57e80147bc8c55ea2e03c1ce10b3d54e1a87e1",
      "source_sha256": "c7753ca23e2e017000da1b35013e1abb339886f2cd771b6c8f761b55282201c0",
      "translation": "有关公主的传闻很不妙，您没事吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2034213dc682b609331cce0aa42116eef0beb60b494ea9b77bbb9f75aa4386ce",
      "source_sha256": "22191b2f1802d304f0d691bcc1411c1fbe3ef746a4e94549b02b8c4b5045e8c2",
      "translation": "各位平安无事啊。"
    },
    {
      "id": "coalesced:b964bdce5d2bb827e36672a1cc0ebeb68797f9f57468a2a459cf8c5b475a41f7",
      "source_sha256": "67abdced5a054f10c7a93fb0aa4f566d3787bc7a92dedbd496035600dc8d6e6a",
      "translation": "我一直很担心各位。"
    },
    {
      "id": "coalesced:bfad32da47e9f6471dbeee5b0f5365728ef5a8b0eb8b6b627201d161c84cf826",
      "source_sha256": "45e535c68950fe94767c658ddcee5781b2a6fc702a21f5d1d02af4b1d2705fd4",
      "translation": "我相信族长。我会相信并遵从族长的决定。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:557ada496618f63de82d7c8412cd40057caa0c4031ca2b36fc1eefca3283ee67",
      "source_sha256": "e1b71e212b3cefe2be6982367b061a2b03fbf1532247d77ba59894ef88bdc44c",
      "translation": "有没有什么地方可以去？村子里太无聊了嘛～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2b4cc2f5e803a98d6c1192b522e74f6750c1266ada52890faa7565995e9d3b6",
      "source_sha256": "d38aab9b96ad60a0baac3a747a8ccf284acbdb3d25e5723ec89b5f7a2a47acfa",
      "translation": "累了的话，随时可以在这里休息。"
    },
    {
      "id": "coalesced:cb38424404405a64cb699b65a361ef1de94e3e70ea4ed99bd1a22b68b7733148",
      "source_sha256": "4da42a7c78736e8d7d343c4890140a0cdc84aa7f059a02d27e89de3b3b52659f",
      "translation": "啊，你们说那只怪物？"
    },
    {
      "id": "coalesced:518da6219ad55a776e7b9ab93d0422bcbb039a5eccf1305cda965481a94dc82e",
      "source_sha256": "50b56b5a573c2105fc07450ce8a79aefc70d4ff95f85c060033232f4ac9bdc6c",
      "translation": "那只怪物叫[佐帕]。每年这个时候，它都会出现在海底洞窟，是只巨大的怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:152a19f278fcd83e5e3511598baa33679e159f3c40c8dd466a71f826774a6d8d",
      "source_sha256": "cc52b73c5266dfa7e9b7177d8862e3d17724deb3aa3c9bbb1cae2db7a36c5996",
      "translation": "今年几天前，我也收到了佐帕出现的报告。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5cdc251834dc57b9a9ba266617d26649c2993e2b61f848ac993237756888d85f",
      "source_sha256": "3defb8aeb313c923e15f613287a8a0bb26e35618832de3f12f8882daa768b3d7",
      "translation": "根据我们马雷族的记录，早在几百年前，它就已经会出现在海底洞窟了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:828d4528b3279cc028ed980721d94ace88aef42dca9d99e11f95a787adeeb71b",
      "source_sha256": "f7a4c2353b483baf944556a5f9323f3371831c113fc2ed81a26fa7d66011bb0e",
      "translation": "佐帕非常可怕。只要它一出现，周围的怪物都会躲起来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48bd6582e1a891a2cb08504dfbf015e53dc9d630f56b96d2dbc4410df317e9f0",
      "source_sha256": "ad219b3ac0f54e1b4a745e8b40ac403153d4b44dffc7ac58819b7eb8f0aa0d07",
      "translation": "不过，它平时都在沉睡，所以不会造成太大的问题。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3e25d3f7889d166671739c34523c15a25a7f9bc9757b6cb439b8e8ebe0898c5",
      "source_sha256": "9ddc77041e51ed734bc2fb8e919c834ca2d0d3fe1870ef8686ec00a3a1051f1f",
      "translation": "为了救活朱特，必须找到拥有强大卡蒙德的怪物。\\n向凯汀打听每年都会出现在海底洞窟的怪物。"
    },
    {
      "id": "coalesced:5980d61e9a9326470122d5fe5ad65425ab7ec865348e230a2ead6aff3659c074",
      "source_sha256": "2cb5fc6c7918f38cf07a38b710b563b12d04791e5f8cd7941c0af7995f514b50",
      "translation": "怪物的真面目"
    },
    {
      "id": "coalesced:4c173ed80cb009b158da942ba401bc25907a99a25a4c5c3e9dfec0f4b84ce02b",
      "source_sha256": "70b0daaca4a23703eab23df96b719a7b355a5754573159e5abd28f85bcef2ba2",
      "translation": "如果需要强大的卡蒙德，佐帕或许是个合适的目标。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5a3e71492f5262b43bdb3bfa5c2f501d28c966d41812a0abd0cd962560a540a",
      "source_sha256": "fac93df65aa7bc109a04baab56a5833bc41757738359f301e10adf1056b84ae7",
      "translation": "换作平时，我一定会劝你们别去。但眼下这种情况，已经别无选择了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7717506804169e26717b751867cf11c08feeadb977c819f012d60a762fbefe76",
      "source_sha256": "7079be938ef78a8639ceb0b27786e071449446dd82330e10b256832ab02f2677",
      "translation": "祖先留下的记录里，有关于佐帕的记载。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92b23d5dbcd4fc46df402fa8415b13879420074d3e1fcf7084429bad1466b75f",
      "source_sha256": "7c4d95346c0634f80e498b416a52514d453390df997a1152ac98050de96c25bb",
      "translation": "记载说，如果强行惊醒沉睡中的佐帕，它会发挥出平时数倍的力量。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e9f912e550f3bf141a8d888bc2609b7c487d7495ada9eb4dd48e55f5eaed53c",
      "source_sha256": "85bce75b3f397d91fe28a79cdbdaa513af3fe53069038ffa6e8f5a0d17668fcd",
      "translation": "要与佐帕战斗，就得先让它醒来，再开始交战，不能鲁莽地直接攻击。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec74dc911e6f3d1db38cc7fe69d7bb9804cf845c9b263f9a40823b84b4fe99ed",
      "source_sha256": "470248793f9d95af23d1f54858ce84627c386c7911ef9c82b9a4f23625689198",
      "translation": "使用我们马雷族的香——[觉醒之香]，应该就能唤醒佐帕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e9154b25f1b755372bbb156eadbc6dbf8fe34bb6f9475a8c2bab95944d69972",
      "source_sha256": "6e725ca163ed194fe82e241df40df11dc8f97ad3b90a199df5d75bc485ba48bc",
      "translation": "去找[斯维汀]说一声，领取觉醒之香再走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:208ad31d8ae24d7bf580c705e0afe546d3768d76ceebb9cb9841712a8c18b2c4",
      "source_sha256": "adf13f43c77f3944d7570bc08b2b9870ac41e19c1bec24991ea940c03c83308b",
      "translation": "向斯维汀领取觉醒之香，再前往海底洞窟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6cec2b131364341efa1dcc61b0dad84b8c4ca1d97bc7808d69267f619c747d2",
      "source_sha256": "1a11e5431cc66eec2149b671d792c0bb49cd9af82f50b71cb40036348cda86e5",
      "translation": "为了得到救活朱特所需的卡蒙德，\\n必须击败出现在海底洞窟的[佐帕]。\\n要击败佐帕，需要使用[觉醒之香]。\\n觉醒之香可以向斯维汀领取。"
    },
    {
      "id": "coalesced:2b2932e334312d65cbd1812f19dcfc1b8956055de8fb6599800f4be488416465",
      "source_sha256": "77a726f2a422e7b4a09a9cbc9847ad3c2d736d42599cfbcd153bbdf2e17336d9",
      "translation": "觉醒之香"
    },
    {
      "id": "coalesced:6b89700f4a94851da9b9aef93e561d3336c19c91dc50e9f3428f553caafe5c9e",
      "source_sha256": "a939ce3f7ee8fca0a30c33be30b0a959adb2f606052dbf3fd3ff53ad072d2773",
      "translation": "觉醒之香 "
    },
    {
      "id": "coalesced:4d8274b5e7ce8a9c75094cb1c7dcd910146ac3427256cd99cb4f5a16772f62c5",
      "source_sha256": "e8412ae8f55b0d984c54596a81d43cb0c8b9d289141b1788996f61f92af511fe",
      "translation": "强烈得能让睡意一扫而空的香气"
    }
  ]
}
