{
  "schema_version": 1,
  "kind": "timed-subtitle-text",
  "resource": "MC2Game/Movies/csm_prologue.txt",
  "input_sha256": "67d51e3d797e4a391aa6281055add39cdde5bedca3ceb30bb570faac67ffe099",
  "entries": [
    {
      "start": 3906,
      "end": 7680,
      "source_sha256": "9aaba07f8d29001ba51e3c95231a602951c91f4355f1fdf5fbefdd576a0406e2",
      "translation": "兰兹海姆历1149年1月……"
    },
    {
      "start": 14588,
      "end": 16110,
      "source_sha256": "5195fe438e9503394bfe9c4e78200a6ce1226b110b41be01dc6d850e13bd732a",
      "translation": "发、发生什么事了，阁下！"
    },
    {
      "start": 46228,
      "end": 48859,
      "source_sha256": "e16a6c499d5c1e58675f010287b1e426528f44a503cbc8505d76d7cb189a6df5",
      "translation": "向陛下——转！"
    },
    {
      "start": 51254,
      "end": 53425,
      "source_sha256": "58d2f16b92e9d672db8365b98d29d77e3a4ee508c9e05c769dcfe4408fc1969e",
      "translation": "向陛下敬礼！"
    },
    {
      "start": 64104,
      "end": 72462,
      "source_sha256": "589721d70cfad3af35b84eb73cd6a37d4e75ff2b09b38d2070a3c6fac0ec4edb",
      "translation": "兰兹海姆王国的宰相修恩扎伊特发动叛乱……<br>弑杀了我的母亲伊芙琳女王，篡夺了王位。"
    },
    {
      "start": 77158,
      "end": 78935,
      "source_sha256": "2b3a926815cb80f72e988b9d7e82c90fa13c08d86274447656a7d46596dd0f95",
      "translation": "公主殿下，请快一点。"
    },
    {
      "start": 95576,
      "end": 101411,
      "source_sha256": "608f9d300fe3cf910bd307deac634996c4e4615756730cb3182be3bec7b1ad7c",
      "translation": "当时年仅十五岁的我……曾被幽禁在王城一段时间，<br>后来奇迹般地逃了出去，"
    },
    {
      "start": 101843,
      "end": 107464,
      "source_sha256": "77a7f15a1e8fa31ffe78de9924df9a2d782680ee9651d7def26173ff390afc58",
      "translation": "并与举旗反抗修恩扎伊特的<br>阿巴泽特领主亚历克斯伯爵联手。"
    },
    {
      "start": 110015,
      "end": 112259,
      "source_sha256": "f05ef3ef5da6736cfac21ef4b1a7931cd29f415b2d050fe5a1ded73766c98368",
      "translation": "那之后一年……"
    },
    {
      "start": 126726,
      "end": 131461,
      "source_sha256": "377b1ff85295f1e01310a7b3df38404bf70f074cfe447511c476aa4e8c858188",
      "translation": "由修恩扎伊特统率的<br>兰兹海姆正规军——“北部军”，以及——"
    },
    {
      "start": 132118,
      "end": 137531,
      "source_sha256": "3dcbe90516f9160a402b233a7461ab387bb4606e95385fd4e76de18aa9061207",
      "translation": "由我、亚历克斯伯爵和周边各城领主<br>共同组建的“南部军”，展开了激战。"
    },
    {
      "start": 140612,
      "end": 145891,
      "source_sha256": "8ffedd0d6bb7b89609ced43f853397dac520e4814a6381f8ccd3b1edb9aa40e5",
      "translation": "这就是后来被称为“兰兹海姆内战”的<br>漫长战争的开端。"
    },
    {
      "start": 160483,
      "end": 161040,
      "source_sha256": "d397b35eb12c659485d3aa1361a85de46b326f88e409905a7d804d587201e31b",
      "translation": "露！！"
    },
    {
      "start": 180854,
      "end": 181533,
      "source_sha256": "4dec9bcfd493bcac51d8ab82c1d8561dc2e5ace0e6699e72306b3203ad613d5f",
      "translation": "住手！"
    },
    {
      "start": 184820,
      "end": 186673,
      "source_sha256": "ded7a82d1ac8f7c100864e58329a63f98a0a207655376e5f1323d5d6c0d2c9f0",
      "translation": "不得杀她。"
    },
    {
      "start": 192668,
      "end": 194574,
      "source_sha256": "a37340a24f610a9551bbfbb7d717c8285316543fae441d599ba47bca421c7bfc",
      "translation": "公、公主殿下……"
    },
    {
      "start": 218402,
      "end": 221847,
      "source_sha256": "225ab91329a5a155fd3d0139f71a5d178e34cb98ae1626902f92bb2379ce125d",
      "translation": "如今，两年过去了，"
    },
    {
      "start": 222281,
      "end": 228770,
      "source_sha256": "09634d9e751fb873bc99ce05d0075a82859f422adf9ce608d10ab247ac3ab8a7",
      "translation": "内战仍未结束，<br>无辜之人的牺牲却一再上演。"
    }
  ]
}
