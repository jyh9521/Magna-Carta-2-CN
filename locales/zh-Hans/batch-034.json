{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:4e7ee54088608f148c50558fb86faf8ce89a068f59d2ea9e87d4336e650f41fd",
      "source_sha256": "a6d9b8c46829d470e62db0736fc51d1ea6b98de022cf1b22662fd26aa58a1119",
      "translation": "(必须追上正在撤退的北部军。)"
    },
    {
      "id": "coalesced:b030565961093c052acafd5749ceb198551cb7732f4b627117c22b7263bb5c96",
      "source_sha256": "267b6568e86d374d338106b4d6a460da64c1aaa4debc74d007caf1f3181c15fa",
      "translation": "(看来没有再回去的余裕了。)"
    },
    {
      "id": "coalesced:ae1b00b2771d56308b0ce7e2ed3f8a7dfbe010c66a28fb91023579cabfad807e",
      "source_sha256": "c41d9e22ae035baf7aac9d9673737278fd58c91774de2251fa0197686cdc7e22",
      "translation": "(现在回去，就追不上北部军了。)"
    },
    {
      "id": "coalesced:51de5d55d30035d9bc6bfc6383c8b9ff75d186c3c771dc791a35bdc42279c4d2",
      "source_sha256": "f5a2c0fb87a23ccdd6f420e5b04ca939509be06f66c17fe636efb0aa1138ff0c",
      "translation": "(现在应该先追击北部军。)"
    },
    {
      "id": "coalesced:00b88d99c84faec3f44e1de354bd7b4e7338e2703cb17cef64d345ce607b4be2",
      "source_sha256": "19def9a4b60edd72bec1acf8e1f2c937469cf1df7173f0bf861e9e9ed0bb2824",
      "translation": "(回去的话，就会给北部军逃跑的机会。)"
    },
    {
      "id": "coalesced:0dc0d4a43956581aa37781479fbcd9b66a755cddd31c57a0906f6c5a405213bd",
      "source_sha256": "1b435af54554e78e2d4886149f3a2a3a91c1de370574be01ba20023860531999",
      "translation": "(得赶快追上北部军，把他们打倒。)"
    },
    {
      "id": "coalesced:6abd67d5578aa3293ec126398dd77eef7b0c064e6f333d8e26aad459c6fba97a",
      "source_sha256": "f3362e38656209f8d872aa709ceb7ba4262d78ffa69409cbdd6e0d3ffdbe1441",
      "translation": "(这边是通往柯塔马雷的路。)"
    },
    {
      "id": "coalesced:1074b0e64b50a040410ab8ba145fc572a82059727f046b8dbcba8ee0c022bcf7",
      "source_sha256": "f29eaa296e1e2cb6dd1a526eba2b540da5c8c46bec8e3020c83f1d3ad502069e",
      "translation": "(必须前往鲁哈尔特盆地。)"
    },
    {
      "id": "coalesced:1c6369bda694e7c55800e57d8286444a8312dff84af86ef0ae78cbb79e5b3cf4",
      "source_sha256": "d257082d64d15e13722d6be314df9187f9bb0d7274e012225659b371ee3eae99",
      "translation": "(现在没必要往这边走。)"
    },
    {
      "id": "coalesced:ffe7d58de0023e515c6be93407500e89d1a73dc9cdff1de08a83c2b31d971cb6",
      "source_sha256": "329d0ac0daffdd3e8f470f1e5406186ed81f0b0efa543b8442bca210918de53c",
      "translation": "(柯塔马雷以后再去也行。)"
    },
    {
      "id": "coalesced:32dfdb475884777f961c5ac5a199efcb71104ee8e395755d833f0376992e718e",
      "source_sha256": "083b91f0d2d427c3f5c74fd33cddd00880e855b758fae80f3cdcb936ed8a1546",
      "translation": "(应该先去鲁哈尔特盆地。)"
    },
    {
      "id": "coalesced:1267624c4e607647d0a4b2be3d241aed180cabcbbeff9c906c3b2792d03ce481",
      "source_sha256": "28b1cd1eb652be9778cd676e6492f536020e6621766afd3c28cfd8cfd2548a24",
      "translation": "(趁北部军逃走之前，赶往鲁哈尔特盆地吧。)"
    },
    {
      "id": "coalesced:d52c9028280a4ddfd450cc4e53ceaf02de6684a607d597d54b1ee66670e59c37",
      "source_sha256": "feacdd7bd82ae63cfd17bf39015cb3bb2b8f20f715d87ff43c83a357a1e03d60",
      "translation": "公主殿下，我们一直在等您。接下来，我将报告鲁哈尔特盆地的现况。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:99ce944c1df12bed77fa6b8bf22d4c323122dd96a942d5e6bdef0a61ccebc92d",
      "source_sha256": "c5a0f8ae5e8234232965b254cef9de9c4e8af36f5f9015551a9fb3a6913dfa3b",
      "translation": "这里出售补给品"
    },
    {
      "id": "coalesced:6f72a1cd8e2ea2a465439553ed914e5c92faf7a70344973e10c2700ed64209fe",
      "source_sha256": "2f4b00240d7ed2c6ea1d6863327d461d1c2596eb674ed0a4857934453ac05f5a",
      "translation": "(鲁哈尔特之战前，还有很多事情要准备。)"
    },
    {
      "id": "coalesced:6606ba7cfe6bbd557724b386dde6cd64488b6aeb97ce349557abc6828d9e58bd",
      "source_sha256": "c241256d4cc8205974c85ad471b7bbd66367d0649add2f2f713f015516fd4f55",
      "translation": "(光是准备鲁哈尔特之战，就已经够忙了。)"
    },
    {
      "id": "coalesced:c22ffd2d175834cf06a4a0944333078789706d409e9699b58689c17905829df9",
      "source_sha256": "a1e8bbefdd47ea2e92f47fa7d0d1a2dd40e39f7194ab67a7cdf66469f1718423",
      "translation": "(海底洞窟，以后再去吧。)"
    },
    {
      "id": "coalesced:3324561d6bc933fd8aeb6984b1b60652555894fffacf1124f6699d63e1a87cf2",
      "source_sha256": "6f5310449ac5ca735050eecd12841f8eb477e8ff0319acb886a2d9423939fc0e",
      "translation": "(现在不是悠闲的时候。)"
    },
    {
      "id": "coalesced:1f7f6bae58399c58b7a0d3daf8ee212990d301ccc58894bbdb3fa242acb3154c",
      "source_sha256": "ebf5b2f0b54a8d601c61a1bafd2de8f547dbb59ddc20148b3ca90a26cc90fb50",
      "translation": "(海底洞窟下次再去吧。现在忙着准备鲁哈尔特之战呢～)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9682a4e00ba0057ffac6a6653c101f7da055ac1296e02999ae5b2bdfd04b619",
      "source_sha256": "d570428649de3685f026a0f5d2e7353221056576a09e92f2ef4eabc7e1b6d496",
      "translation": "(海底洞窟不去也没关系吧。现在可是准备战斗的时候啊。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2b51078f268bc93bc3b0927c3cd3794e221e49783d4350672ae7c61c2b4fe9c",
      "source_sha256": "c19e52809bf77d9a6ff0dce41f7f1f7b5354a1e0ae11f1d70ee0c23d4986f169",
      "translation": "(难得举行庆典，看完再走吧。)"
    },
    {
      "id": "coalesced:6a1f6a93402b9d6ce47e4b1206e7e853ce553f7b184ff24438dd94bd85af7009",
      "source_sha256": "aeb462e8eef8c8083a35ec9a18a2136f9ec2dd7f00899275fcaa4e845e092862",
      "translation": "(我对马雷族的成人礼庆典很感兴趣。)"
    },
    {
      "id": "coalesced:c57e4f9b02c62c473755c83e4d64be9deeac06dee59b01934c99a81326c235fc",
      "source_sha256": "4aeeff3caea2724a327c7de54ab741247f2b68f4aa70607ca138f1ae10c918e1",
      "translation": "(祝贺塞蕾丝汀成年吧。)"
    },
    {
      "id": "coalesced:aeae2bae457999a399e7fafa02f7b23814494ea74bc5c40a6d24b24416d01133",
      "source_sha256": "8f2e3e17e36121005d34c63d07ea97734ead8c6fd9d4c9bbbf66a6f81fa9065b",
      "translation": "(嗯～如果可以的话，真想看完庆典再走。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2108f279a7b8030ba7d217d8a000a696f0d9c37c6bc45e196fbb120bd473730a",
      "source_sha256": "0085a63d6779b31bffd494561c8a5fb5f56ba357ebacca190e01c51c3402f570",
      "translation": "(虽然那家伙挺麻烦的，可既然要举行成人礼庆典，也总得去看看。)",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f545730c17502e8f9561f4b3ed2209ea8a9d2f117453bd44f4f7a47366886c49",
      "source_sha256": "16c757494689d52dfdff8ca29ed26632ccdabc7375af8857d19170230cf2c52e",
      "translation": "(时间虽然不宽裕，但看场庆典的时间，总该还是有的吧。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2aa9463710aeff77af183cef10c2c7af4fc8687363fdd29a9629fae52a7b6f19",
      "source_sha256": "7ae486ea68706fc258fd8047755fc587bf2ef177986e631e00abb27cbf4936b2",
      "translation": "朱特学会了天风一击闪"
    },
    {
      "id": "coalesced:4e774c7023f62141cce06014c34125d744f0042b7775e40bbe43038c6e3f34b5",
      "source_sha256": "92635f94eaab86ac45c0a254ba778076bee41ee76fd200ded48850180c4f72d4",
      "translation": "洁菲学会了天风一击闪"
    },
    {
      "id": "coalesced:05e9b80022a268d73a8d045583d33dec82f2253d4092c8cc5ee6d0c4c7d4ec66",
      "source_sha256": "067e93280a5df8c513372f019f8ab0eac650794a27e58de988ef7a6ed9825a6a",
      "translation": "黑刃要塞已被南部军完全控制。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f964670025c0aadf9429b34cb87ff40d2bd937635a868676947c0f3277f4999a",
      "source_sha256": "e28d8304152bcecbcb2f585b91e5ef4c25c1d16586b0bc7985bb2f8cb6fa7355",
      "translation": "黑刃要塞将成为击败北部军的重要据点。"
    },
    {
      "id": "coalesced:d174d7aa8622ebd3d3124d1fc47cda9ce26663b0e26d74b37c4b106de3de6b45",
      "source_sha256": "2c38f7e02f11fa15700b028535ef0a668026d885de149c0566abc743587658ff",
      "translation": "楼下的研究设施，让人看清了北部军那帮家伙有多残忍。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b14f81650e389baaf927fa9b65aa0f33472529c1b263c637dc82bb3670b4fcdf",
      "source_sha256": "dce8d301939fd5822c7c3f5c48d8b8ad51dc2365462abfc250f33fec0a7964ce",
      "translation": "竟然做出这种事。北部军那帮家伙，绝不可原谅。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:565dea701fbaba28a3f5de6b5b107aa2f28a46abd6a60c45e16884033d431e8d",
      "source_sha256": "611551c34c670fc68216eb30ce4017ef87493539d2a3053c137a9c8ed46c009a",
      "translation": "竟然连特雷瓦也遭到这种对待，真可怕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f6bfd3495c3c872492aa62677822e0c7d11a16de8f8e11c455fdaf1f9238c7c",
      "source_sha256": "fff6d25876a753e1714a62853c3543d9385527536d988b2ad6dc8ae66c411f26",
      "translation": "竟在杜南丘陵地下设了这样的研究所。真是一群天理难容的家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7219da4ccfaa86d1a7f38f4734ec1f39da6ed19efbb9599d44638533f7b7fcc",
      "source_sha256": "0077d9fd3925f42fff7755b7e67fe8424ec367206126dd110ed402189f28f922",
      "translation": "幸好，上次战斗中，壁垒没有被摧毁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e65f69f69e37a371eaa2b2de3cf33bd735f6b737f5b76f859a7da74ce4b9ccd",
      "source_sha256": "176810ee7e3eb0f0a158e3ca026dd97a883383d3e28f411049995852285c5466",
      "translation": "从贝尔福特涌来的难民，越来越多了。那边到底是什么情况……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da80694be1f6c813f8fcad03d776f6d9e7f5657777fe1c4f71ef61908b28be97",
      "source_sha256": "e5b3e566b2c642bda3a6a9266ff1ad2b52604b12c11c4ee9f9ef7c347a37d312",
      "translation": "只要再占领贝尔福特，这些难民也都会回到自己的住处吧。"
    },
    {
      "id": "coalesced:45f2cb92e5e66989765405bf87b9b1497de6115e597bdf5a920422efd176010b",
      "source_sha256": "c2c3bb148b7a979bb62c8bd88ce8b57e39de4be8e0b0e4691c4581cb099e059b",
      "translation": "蕾洁菲尔妲公主，真的很了不起。"
    },
    {
      "id": "coalesced:bac2b0f8f3c3b83b1d3ae8d3288fec43e03ed1012320935ef0ab613a33f5f0bc",
      "source_sha256": "8a851ca7776239b4dc6a0992a6637ef68de5140442fb44891237de65ee4f3f3b",
      "translation": "她亲自率军作战，带领大家走向胜利，不是吗？"
    },
    {
      "id": "coalesced:0be1f37a5fc46e702500fdc7157d2b5c38cf199bf34fe2f75acf5cc65e2a38be",
      "source_sha256": "4344c20a6ee0986be19662d94dd127171c4cc658b7b84aa5b150016dc7f5dd2d",
      "translation": "这可不是谁都能做到的。"
    },
    {
      "id": "coalesced:188694fcc6eb55065d3e56ab47aca08f6e8dbfb7cccfb6ade72ad08746ecc5f0",
      "source_sha256": "416196d146df97f820d152bce719d03152815e1b688c341d034a3b65c4f8e719",
      "translation": "听说反哨兵部队，接连击败了哨兵。"
    },
    {
      "id": "coalesced:ec07a825069b5254ef3aea878cccc9bc36acd98a5366e8bfe17534c9809b19ce",
      "source_sha256": "d7d7fe77727b6ae21bdcb863d37950820206471f9a8e126947c397fdbc05f222",
      "translation": "据说，他们可是胜利的功臣。"
    },
    {
      "id": "coalesced:4763092a4922bb06b573fd311a88c3c7b16de4cc540456ad9fbc881ec4da39c7",
      "source_sha256": "fedc0a870ff13d7e6e27e7fc078d49e2a32746bc208ab4bd8ac8b2a66e82e600",
      "translation": "我也想加入反哨兵部队！就没什么办法吗……？"
    },
    {
      "id": "coalesced:33b24fea2ba1d8b3cf263446491c8fb2f1e1eeb3330126c50e99205602f79c1a",
      "source_sha256": "1f4599aabd2bd99e3058f0ac649ffca42ccfb64c0ae7fcdef54a91b0d8d31145",
      "translation": "赏点钱吧。哪怕一文钱，也请帮帮忙。"
    },
    {
      "id": "coalesced:455392848a1e25eacda45797e043c6ef695315e13ab4ad60e84ffa6682a1c43c",
      "source_sha256": "e0b8f47d061660d700d4ce81f34f3770407417aff0566149c923ccf9db0f5e78",
      "translation": "老爷，求求您帮帮我吧。"
    },
    {
      "id": "coalesced:4083d4a75dd423e9feb0a94c433084cf4a89806c0ef8792891f35cf7a384939a",
      "source_sha256": "0571241c2f6503b8a478e32db7732f4e4126d036cc87d9b2cf7069b838f10851",
      "translation": "这里简直变成贫民窟了。"
    },
    {
      "id": "coalesced:a9faaa68f7e52bf0101d71d667cf3ca5fdb048ea0b5f4d922f3b3b8f8226d96c",
      "source_sha256": "b2959b5df0bc1233e1394be04f7041c8820cf8d23d79a7af310336c66a938436",
      "translation": "不管怎么打扫，都干净不了啊。"
    },
    {
      "id": "coalesced:ed944365c9c55d86bcc63e107aa239a88b21cb5f1a80d554cece0650ee5f82b4",
      "source_sha256": "0bddb6c21ffb1ac0784eaf5997090d0aec78008896c2daa89654e13cf9b9bd06",
      "translation": "真怨恨这个世界……"
    },
    {
      "id": "coalesced:5dcc4167bfb6652448956f5108549bfb44f6728e2d826699d14b8c3c348c868e",
      "source_sha256": "82165c502e3cd985c348369e8cce8413a58a870a2e6b90bd7a096e5d9e217232",
      "translation": "这个肮脏、腐朽透顶的世界……"
    },
    {
      "id": "coalesced:f3f99b82991b2ee205c58c9830d0b1d7d98bbdd766a61aca2c1948767197420a",
      "source_sha256": "3fffd59976830e4b47374f0822699a19e81bb6f02b958dbd5d3b9ec680cb2d15",
      "translation": "真奇怪……难民好像在一点点减少。难道是回贝尔福特去了？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4deb14c870bee3282738d33b4edbf78ece839c356e29c21213d9befedbef7598",
      "source_sha256": "4f5d3e10dade086ea8b0db5ec1228587e55419e8469ac432ebcc4e34399a1e2d",
      "translation": "来看看吧～这里有各种各样的商品。"
    },
    {
      "id": "coalesced:52848782f0961a52d00f8bc358c5acf93348b3925f3c8ac8b5d145d247db8371",
      "source_sha256": "f7fc2b7513dd9569fefd4f61e2f12457135e5d7f6be670384b5018d6ae2dc443",
      "translation": "总有一天，得把修恩扎伊特手下那帮黑角特雷瓦灭族才行……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73db0a6cd2643d2ba5c3c5d3e27e2b6ad6612c9a38b1b88a1be9283698c039e1",
      "source_sha256": "582eb82b8e254afab33095ce5596099c76cc8c7f9a43b191e5059a2ca73eb35e",
      "translation": "可惜，一直没有这样的机会。"
    },
    {
      "id": "coalesced:4569c3b78102f70852b7e64e5a847781fc0768eec2ef52e0686826ca89d1854c",
      "source_sha256": "7995e6911a3a0c8af4b5ab837012cbd16cf6673661e3c2ea9fb1b4b907777200",
      "translation": "欢迎，想要些什么吗？"
    },
    {
      "id": "coalesced:365185f8e881673ec5921f53b155e75e0e4b720f0ca98d109b85fc47d0cd0de2",
      "source_sha256": "f3d396bdf2180d3c25d493dbd2c4f800101dde0184093b3709aeaaf9029a0de8",
      "translation": "嘘！请安静一点。施耐德大人要是发起火来，可不知道会怎么样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c1ccf1c608c0f94dae6a8940c531575512c0970c727612ef79ac36b193b972a",
      "source_sha256": "8a22f2aff61a7326d7825e58e6e2e263e2ee8cfcb0567c5746342d673d9948ba",
      "translation": "我被施耐德大人训了一顿。让我安静地干活……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09fb6ae63707e61bcac512a58806e702b0416afaaf690d1616180c6baae58dae",
      "source_sha256": "e5bc11b09adc48cfd3be501f9aca27995a2cca7f16ef85a386301f07a109ec06",
      "translation": "看来，这阵子得安分一点了。"
    },
    {
      "id": "coalesced:f7ba25d927ec390fa227b10e9051dc95e96bd5db55f5113d769013ae1c3ed795",
      "source_sha256": "b81dd4cdef09d7619989ee1fc8f5bc4f017cf2d7eec2ac9a46f1a08a275187a7",
      "translation": "总算安静些了。真是的，现在的年轻人啊……啧啧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0daf6ec445cab076459523e9265cfc0d627805a7e239e6f1850cf6ddaedf0836",
      "source_sha256": "63ceb48a675ff8c1a1d933190636027727636959a01c64ff371fb0e7087747d8",
      "translation": "来看看吧～这里有许多珍贵的卡蒙德哦～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be2ca3a2556b650c6732c179e00821c10192bb5dc3e8e7c73f28449d262805d1",
      "source_sha256": "751bbebcc8b63cbd9e3c68194f22fd0a6719780c69aa04cd28b2d0caf6c6ecea",
      "translation": "谢谢惠顾～欢迎再来。"
    },
    {
      "id": "coalesced:5e567881533d196d809f77eb45289ca1505c8e7ebd5f936228bb05b59d841f97",
      "source_sha256": "b7b4d625fdd33b8bf836f3456989d6798879ed7f8f8fe7160394f83fc00a54a7",
      "translation": "这里是公会联盟。"
    },
    {
      "id": "coalesced:0d91e8afbf82e0c05a742806c7086ab7779da6054940fc56e91073501b9ecbec",
      "source_sha256": "6555984db743a25c9f1417a9916152417b22969faf063d9bb353b0a1d075466a",
      "translation": "最近南部军连战连胜，阿巴泽特公会联盟的资金周转，好像也顺畅起来了～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a386a6130cbcf9434189f2e9cc769e2e9ce27316bad4c08bbf679edcb88ce6d",
      "source_sha256": "7ae4f359be92597b8cdb42fe4037535806174d262d558091f6c79846e3710637",
      "translation": "这回，可是从杜南丘陵搜罗来的。"
    },
    {
      "id": "coalesced:5e8d3b95de156f421d3a5b3a802939bceb0d540078cf0d7c1224d9fa48016446",
      "source_sha256": "9a6f05aca97ff010227e46200e4f05507383ba3937c976e595978dec5fb8388e",
      "translation": "哎呀～想赚钱，果然得消息灵通才行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:79a895818aa126c78d0477d0851ec9f94cf7a1c43caa3633aa24ae848d94d937",
      "source_sha256": "040fc2d78e6049cd1c2780ee682834a71ee648d2bb96e91f21a5f05e7dcae311",
      "translation": "看来，战斗并不适合我。"
    },
    {
      "id": "coalesced:6d52d08cad020f50798fabed69f905f7d0236549d4d87a2587e76124ad969952",
      "source_sha256": "14ddb7757b563227122f7db0a55239e4957252ccc659ddbbe6e657c7b7389925",
      "translation": "我只是来把武器卖掉的。"
    },
    {
      "id": "coalesced:5ade46aff2d2dc06af7ac128b9ea85ba16ed96a6b3411d215aaa09c65a7dcea4",
      "source_sha256": "d925ee2c30b94fd8895fd0015a375ee141fa98432c70f67b88ef55f7c32447c7",
      "translation": "我买了新的胸针。是不是很漂亮？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b9df96160db00b76d041761dd92b64395d5c26674dcbe9f6307e7eb84d40c14",
      "source_sha256": "167e4a75a388398377d03cfd2e1775429b283e8629818d12ae7e386713b7d4c1",
      "translation": "这次加工的饰品，我也不喜欢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d09720af6ad00ff79919139c3e1f14d07e2b45699203169475bb7fac533e8400",
      "source_sha256": "e624b01e4cfc200deea1d54a90f21cf50d50db861857c8da18a3a8a80e5153f6",
      "translation": "唉……"
    },
    {
      "id": "coalesced:c9507aef0e9aab60fc492e622e76c4a480e19519b638c7d7434b9aba0ad13196",
      "source_sha256": "1abdea47a91b2084022965d5801bf6c7c5a30b37a58acfae264142abf7382e19",
      "translation": "看着晴朗的天空，就觉得连苍天也在祝福成年的族人。你不这么认为吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c03d9ab96d471a1729fc398cac726ff82452833766cd769206819bcb489f9a56",
      "source_sha256": "b7caf386591d910abd4f60c1e3dee6e7b3c89d8dd4c6bb6edc1beccb6e862c30",
      "translation": "今年参加成人礼的，只有塞蕾丝汀吗？她竟然已经成年了……我简直像是在为自己的事高兴。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db92aaa102347fd66164298de25ea8f057a7c4e19b470cc4a473a95e741b5412",
      "source_sha256": "98f85c37d0758833b3f1959cf0299285678deb09b986b04525ac39553882116d",
      "translation": "柯塔马雷附近降下的灾祸种很多，似乎是因为这里曾是一千年前卡尔塔大战的中心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8ad07c43394174bc4d77dd4cd9fd29625f700448e946fe1f4b390f6f7e99844",
      "source_sha256": "a8a9ea5e0ea934731112843bab607b998b477ff4fc3b7c0f97fb2e6ea1f4727c",
      "translation": "马雷族早已疲于应付这场持续多年的灾祸种之战。希望公主能早日结束战争。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8473bc6705ccb2b3ee91dc1357513673df659ef5036c5496fe0394e4ded333c4",
      "source_sha256": "4afd01230aa19721d5721a951536e1ba0e88899096643c80338e6be0c42f97ae",
      "translation": "成人礼啊……已经是很久以前的事，都有些记不清了。别问我的年龄哦。呵呵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ccfefc43959d3440902709691196c8f7ab77eaaeb1c5ae964bcc907f5893804",
      "source_sha256": "a4cdd233744dfd4e4dd4405a0f7ae97160fb7faecc45f41f1c509af6ed235f67",
      "translation": "每次成人礼，都要主持仪式，确实有点累。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52ad710585b9a8e1da255aa0987666b2684d584e94b6900fc19ea3ff86c764e2",
      "source_sha256": "18b6347c5c541bdd15bd73e1384a084b1ed26155b6ebba90c1701c46777ced62",
      "translation": "不过，又有一位马雷成年，总归是件好事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f01bbfd5ba9d0e5a0b85a094f4d2b6f3afbd8d47c2a204d1d27450ce66314c4",
      "source_sha256": "437b7ce4b9af7463a91fc43eb4299359e087a99de4bb547352eb0a21a50c62dd",
      "translation": "别和我说话，人类。我至今仍信不过人类。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f24fb5cfcac6968112a7af373968cdf8c9f5874ab52ff12e65fad303a669b5b2",
      "source_sha256": "355b003c2c9a1709f5715b395c1f73117aa4a795bb031b01113c78dadd39b8c2",
      "translation": "我们马雷虽然寿命短暂，却也因此努力为后代留下更多东西。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c167ee5c366989d064bcf57470ed9419a35441d410d54ab83205316cf91c287",
      "source_sha256": "106caac05493721ad724820ca6bf0cd94b0513d0a0441cec42df622a25e6a64d",
      "translation": "你们或许不知道，我们留有相当丰富的历史记录。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddfeba2a1809a5b9df5217f1a14814b0b978a226de188447e6c448a8c4146b44",
      "source_sha256": "0507aa38d7fc056092347ad0d7fd3abb8962a790c2ee6d138b2cd5e91498e4fa",
      "translation": "你问那些记录在哪里？这是秘密，呵呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:799721f34874ce0aca17264d7a975da1ebf8f65cfdc28a63770268dee645cdb1",
      "source_sha256": "525f49a07062c98cf84fe417f3d1050529c49e0b9114948ef728af3cd2e3a04b",
      "translation": "我负责主持焚香仪式。"
    },
    {
      "id": "coalesced:91fdae82bdbdb4fbb3495a61fbfa036a1021f150367509627ea7a20042724c64",
      "source_sha256": "3d5516cec16e2d58af8c7c38c5fe8f82e210ece5d6ac736bb98af9274d1e68ad",
      "translation": "做了好几年，已经习惯了，有时甚至会忘记，自己正在主持焚香仪式。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ffcfee7ad528944c3fbfcff9963395dd3e6d5c42f96bec9046080f17c764859",
      "source_sha256": "48a6273062593b2519d6fcb8aefa577273f86faccfaa68fc010f8eac7976ca92",
      "translation": "我还记得，几年前有一次，我只是呆呆地看着参加成人礼的马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc5fc02636f42771b9507525656f4a7d6b104db1bd74e9db60605db483e25291",
      "source_sha256": "4d90785dfe488eca5a2c5b6370f8c50d66f75d1426084290cd2dcac49962595d",
      "translation": "啊～我什么时候才能成年啊。"
    },
    {
      "id": "coalesced:85859b9d5a33d77a6467f289988e245c3430fc004c2c76f2ebb883fc3d784746",
      "source_sha256": "60a1a331e2373d6d34be86c86f7f51daa5eb64df041b5fb1fefa52856a6d1225",
      "translation": "真羡慕塞蕾丝汀姐姐。"
    },
    {
      "id": "coalesced:4497a0b3286316370de22335b71053e3f22afadd41d944e5d2937902b4efdc57",
      "source_sha256": "38e0146bd96200d57015686e44993adb8b63e1f20ca69b6203b09bc6d9cbe60c",
      "translation": "不管成不成年，妹妹都由我来保护！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e0a789fc11785ed8516dbee81a77496b9f2121f4ab6e40d4dbfaa34e54764ea",
      "source_sha256": "c42284e95e1a078fe86b5b8dcf6fbb520d9befd813ac7e65f399e8af48101e7d",
      "translation": "再过3年，我也能参加成人礼了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cfde37ba5d12559a07c8091eb395e0cf6498fc7a12d06781f0ae333c5d16e431",
      "source_sha256": "1cd612753ec49249ef849e061ecb7c660278accd7e0f932a82da9e813e6c36a3",
      "translation": "要是我已经成年，人类这种家伙，一下就能全打倒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d05fa1453147c3dd0cce97883c8bda3f765ecfe4db48fe53ae102295983eaf3f",
      "source_sha256": "d3b2bfe0f5abe44bb999733be2f5ef016fe39e135638be557cd78ca41cf42729",
      "translation": "当然，也包括你们。感谢我还没成年吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f050aa5869242b17ec907e29795bc60046988e7353e1b3f7c2056ed283976d2",
      "source_sha256": "e42a5c55eb098f9b69222f5806715acf73f7b294462d9ba1c00c221417655c8b",
      "translation": "我想吃新鲜的肉。感觉都快得抑郁症了。送我回故乡吧～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6e0fdeb6a4bff314c8cd4069533a12d6fa7d83cfaa25780a5b20d4919d54c34a",
      "source_sha256": "f58e77d8cb5c70534ca21369c56318f9bdc5bd5b3b9cacbbbc9d2b21ffa0d7ad",
      "translation": "柯塔马雷那边这么热闹，看来今年的庆典日也快到了喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3b9c7e1d0d9f1a6c1b2b3653bcc47b156b419b08a1be0e041e187aff8d7c0faa",
      "source_sha256": "e0c952e3cc5efdd69597b7ed0c162d6b014f40dd5c8c62d0f4ad68307d34f16d",
      "translation": "谢谢你们赶走北部军喵。多亏你们，今天也能平平安安地过日子喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4618f800ce5e7c382acbe29d3cc3a9d7d6107b9089c192b6f0d2f899e2430f0a",
      "source_sha256": "47a0e56a7d21be58ea76a785db90f754ebefdf7681f74c57694b7156c6b83c3a",
      "translation": "这次，我想去柯塔马雷玩玩喵。"
    },
    {
      "id": "coalesced:990cb8ac65c859baa092eecf8d4cbdede93310dc27db5c25a33f3ad360a54369",
      "source_sha256": "a56801ec86f1dc61540361cded4b593109bae90deb58b670baafb677ba2d0dad",
      "translation": "阿巴泽特那边的猫猫们，还好吗喵？"
    },
    {
      "id": "coalesced:f061ccdeec002eb6a3701ed697cbc9c06752ac6dfdb03a8f5ec8d1e9b6f06c7b",
      "source_sha256": "7105d7c15329598611faa23cf92b85e9e10d3b72768c69d43396a793f42a7158",
      "translation": "好久不见。现在，似乎看不到北部军将要入侵的迹象了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c28793abd6c1b32492863c9a8308605e1a470b1de76ebadb6c471654212f99e",
      "source_sha256": "594b31bf77c3774cb3a27ecdf5508c9214baa859217bc16b9ee5b7b71347c433",
      "translation": "你们也尽情享受庆典吧。"
    },
    {
      "id": "coalesced:e9d2968716c338ef5fd89102781535e004f2789e68624ef76c781b017333927e",
      "source_sha256": "d6fae8112d3557a333a020fae1829fad233c7722f742358fba976e0f00af675f",
      "translation": "请尽情享受庆典。马雷族的庆典，可不是轻易就能见到的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ac6b73e6c5166ad37778b0700d492a74988489065d5ac8873e35ea89b54a9591",
      "source_sha256": "d2b473448e47084ab60dd3c41125cb6d717dd8dc0e291b8c5d47ea4defe17a5e",
      "translation": "就算是庆典，也不能疏于警戒。别管我，你们好好玩吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f66365533976164406c1478332e2cee7ef73e47a222755b10df98c960b464cdb",
      "source_sha256": "c082e32a70f5941640b402e71c220d1f8d70ce80b0dc8f40b0222e1e7a12bb83",
      "translation": "只有这一天，大家都会抛开所有烦恼，尽情享受庆典。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c9728e7b7a451f2aa2ec2f976076666a2d367656f343c36e8cbb96153874ca4",
      "source_sha256": "1362fd84542101f935a2e952e4b67ddbf98503dcbd655f492d7e1e263546e4dc",
      "translation": "不过，基洛蒂好像并不是这样……"
    },
    {
      "id": "coalesced:fc96a404cc01e4f351b54e4e003b59d8f106bab10a6f2e1fb4b66b0106a3b709",
      "source_sha256": "86b5fbfc384250d47cb1106c143ddcb0ddb786e8a9bf2128ee80ae642bb23a47",
      "translation": "我想，塞蕾丝汀一定会成为出色的马雷。她在南部军，也表现得很好吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e88a41f66f804ad32c71d72d7e55e787cb76ce55d789b40c3b5d4b17ffc7d810",
      "source_sha256": "79a42be669618bd2bc9eee4734c9875b36b387c094471ab1e21c1c7bdaf56864",
      "translation": "她在柯塔马雷时，就是位出色的战士。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0abc78a27f85630b1db4ee49ee045e17c6eaea088cb5cfff1ad60a54cda507d9",
      "source_sha256": "85260ed47b94d9db1a3ac67fc490a4bf1a979c5f3753967e0d85647bf195144d",
      "translation": "哼，人类竟然出现在我们的成人礼上……"
    },
    {
      "id": "coalesced:ee022cb3c741b126e8d9366bbecfe6d3ef8526b34d7de72054d14a71a356788a",
      "source_sha256": "ad65a3f4a62423c985fc3e3466e7a9a1fa7a28e2f459307c8b93383974084f32",
      "translation": "算了，今天是个开心的日子，就不计较了。"
    },
    {
      "id": "coalesced:6c1bac362b2537207a48d2864bc28bd0d7e5b193c38ff0ab6a3f53472a4355d6",
      "source_sha256": "1595a07c34e24617e99f509535863f6c82eefea016c5d2ce4e94561102dce570",
      "translation": "塞莉娅若是能看到，不知该有多高兴……"
    },
    {
      "id": "coalesced:0fcdd68b8dd876b05ca7b695acf3a6c365232c989167ca54466a4b0e521088d6",
      "source_sha256": "2ed867ebeddd56afaa8e5b2dac9f0e2fefbc35827b4cdd775e4ee3a491971dab",
      "translation": "她一定正在天上，看着塞蕾丝汀吧。"
    },
    {
      "id": "coalesced:eff880b5eccf159ec97fe17751ba30f34bbfdc94920fe65ff82123f07a1a6ec0",
      "source_sha256": "03a73878ca988b85d6d0d0792a6621a166a7a82de754faaafe1d140995278d3f",
      "translation": "马雷族成人礼上绚烂的烟火，可是让人难忘的景象。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e44b8fba39d0fb9a38bef4792dc1ec0bedbe029cb43ea946a6a738fe0f90d680",
      "source_sha256": "dac9592e393c9bd020a25097534f180bf249c8a19ab35aa35569f01caa8f0163",
      "translation": "只有主角塞蕾丝汀，才能亲自宣布开始。塞蕾丝汀在哪里？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:70af923df5777169cc3de5e9ec33ab8375113b355e6e3249514a45872b52edd6",
      "source_sha256": "4269a5d4d4e15b6ab1578b9cc5259cacfc4d8dca356cd4410adcaf50a4cf7e4a",
      "translation": "你一给信号，我就放烟火。"
    },
    {
      "id": "coalesced:ff278426a34ed993ed0dd3acfbded99d7d62bddadf670056d535896e83a09b4d",
      "source_sha256": "18707dfeedcaa8e3b93d9b7d9ebf626ed843ade4dac24f64d29ad0e5b6cebcc4",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 开始！\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 还没准备好"
    },
    {
      "id": "coalesced:33b5f3e838ecfb692a0fa69587dcf16a7487c9585c52c92c4955f9b52163c386",
      "source_sha256": "6850e9bef073f572f6f58a2e4bede2f92c30cf278eaa4175b9a2276caa7ba605",
      "translation": "好！那就开始了！"
    },
    {
      "id": "coalesced:bdaee397320546cdac1682cb8e01739dac312da71faac4febd008f394f278981",
      "source_sha256": "843b4958c7e5bc375f60c095bcda75dd12a3884f111cc4d26ceecf949df1f466",
      "translation": "你在紧张吗？准备好了，随时告诉我。 ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:af5b8ee743fba06f6dd4b017cb0f769df20134de8d210646fbf60d85528d6564",
      "source_sha256": "1bdbd4a2f6d9f9215adc8a9f0ba65c0210bf04445424a072337861ad93e8b62f",
      "translation": "恭喜你成年了，塞蕾丝汀！"
    },
    {
      "id": "coalesced:87816b50f611804cd67c7e13e601125043729bcc2a08c7ad4a8dd17444c56911",
      "source_sha256": "4d90785dfe488eca5a2c5b6370f8c50d66f75d1426084290cd2dcac49962595d",
      "translation": "啊～我什么时候才能成年啊。"
    },
    {
      "id": "coalesced:c618de9a379f22636d714999c67d3750426c6e72765e54cccd22af6faae9bb80",
      "source_sha256": "60a1a331e2373d6d34be86c86f7f51daa5eb64df041b5fb1fefa52856a6d1225",
      "translation": "真羡慕塞蕾丝汀姐姐。"
    },
    {
      "id": "coalesced:1eb2f9339c90e449313660bc8cb66ef1fac0f4e3187459b75cf280c2aa152449",
      "source_sha256": "053c7e119fb5a0d30ceef6938277a698ffbe02a74a70512b5f381768fe710938",
      "translation": "别趁庆典接近我妹妹！妹妹由我来保护！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e2fa6a80cafead5c92a43665e7ab9a697972a54cd56fbb134fe3a53c7723dfe",
      "source_sha256": "feac703fc8e45bfa24c67c8d3a2e15327de5eb21c2f6ca53d0a0b21966d6f56f",
      "translation": "我也要快点参加成人礼，让大家为我举办这样的庆典。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf526e10cd083669a2f56e33d54a5957ef45484ba81552e2586b65ec349e45a9",
      "source_sha256": "eaf99350dc964fb790d56725f2c552ef133dad4bb6b2599ecd112f58cb85a055",
      "translation": "庆典用品，也请交给我们阿维斯商人吧。嘻嘻哟！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1663ebb3f7795e412769059a0e95c967bc82e2e16c7945f165a4dc9f1349b53e",
      "source_sha256": "6188d6282bc8d61385fe13cf5af2a629b00502d7f740bf0f2f848d1d613d4c72",
      "translation": "欢迎，塞蕾丝汀。庆典该由你来宣布开始！ ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80b2b08ff4ad83d019337bdc369cd93f7cb933350b7d9e2c9efba5141614e302",
      "source_sha256": "a1786c6df0985dd630714050006ad80b84983092df70dc5c652fdc80c726de6c",
      "translation": "塞蕾丝汀，恭喜你成年了。累了的话，就在这里休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69ce097a8251e7b52f42b1aaf08e5a3879229edbed8eadddd77d61e1dddc91a6",
      "source_sha256": "c2f3357a6f2bf40decb60bee981aa2ca110cc82dddf6093ce70d3c06f8a01499",
      "translation": "必须在贝尔福特寻找银白的拜泽恩的线索"
    },
    {
      "id": "coalesced:c0ea6736606b176efbea5172ebf0870201620f4e85212749669895ae80121263",
      "source_sha256": "17731560ff85dc3bd7df022bf9b2e58cdaaa30a3f674a0f27887d7257c067374",
      "translation": "拜泽恩的下落"
    },
    {
      "id": "coalesced:5924ce3315ca0dc8147332b0bdd0cc8e84c84fb4035094fada8cb2da78fd0f4f",
      "source_sha256": "a4512945f9572e5e0d285721354576e674727922a75a8e4d2203845bc4fab735",
      "translation": "拜泽恩……真是个久违的名字。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab64af0b75f1ff8c64d38d3f81ee4680b5ca7542c26cdf09856084f6beac86f9",
      "source_sha256": "7480a0888eee0d4d157c171f5947a667861bd97b72299cb88303599cbd3d79bc",
      "translation": "天风一击闪"
    },
    {
      "id": "coalesced:d9e863914c4225fb0bef12b0a32135283886c75757ce5b67b3d366fd9d0122d1",
      "source_sha256": "288a59c5d63e5302f8bc174ae38fe1cedfc4b82d77494babd58a86e38e6a3865",
      "translation": "基洛蒂"
    }
  ]
}
