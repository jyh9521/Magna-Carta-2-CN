{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:240c037eb5a7c3825fa6a6112b88c3ed2ff5f654247d4d98741a30e39c6c722f",
      "source_sha256": "318ee3f3417926ec408b1ded8fa93b30a483fdf77319459ef675bb5110bd1ef8",
      "translation": "辛苦了。我来向公主传话：上午总司令部要召开会议。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ab181375a22811d0b658cc39462880c10d4ddbaba4f2bc3723d1b8d890d178d",
      "source_sha256": "c7ffdccfa1cee40ea90cd9109f63682f5302dfb3b439107461ee6f21ebae36c6",
      "translation": "知道了，我准备好就过去。"
    },
    {
      "id": "coalesced:3b9ca05795067c119d6a9cbf6b537e0d51e6b32f674da5493816782f686ed9af",
      "source_sha256": "ab341f774f0587969e05aaefe69eca7405cabb2a0c4c7504a596bf05e3ad2d8c",
      "translation": "是，公主。"
    },
    {
      "id": "coalesced:e0a25d0b9b6ae45a2627b792b27e7b2a9d323f44953212879890aa89ad243c4d",
      "source_sha256": "1d1fd1b3216eef95e1133a8f3be5f1985c3b761e340b2fb8efca1187a1a98bf7",
      "translation": "诸位想必都知道，公主此次对守护者进行了调查。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e61ab4dd63c309525c3791fbfae7a4da5bc2ff11b1dc3e3eb3d2e7fad9b02e12",
      "source_sha256": "75a56d38176ee1ba912b2d77bf81c5de9946ea67a0e71303d67df2eb94dce035",
      "translation": "那个人是谁？"
    },
    {
      "id": "coalesced:8fca04fe1aa982863bfda8e94dfff38010d8d9894531a56bd3f46c3c2d26ecd9",
      "source_sha256": "f73747b183c15a6de988ed760180932940d724b1d4a896286b110332a9ee3ea1",
      "translation": "劳德，一个顽固的老头。"
    },
    {
      "id": "coalesced:1309ece1911f0f19e1169c1caee965f2a5e81417979d21c587c1f0d4331bea33",
      "source_sha256": "7518e7153243b378bc2d64ee675305104d8a40efa478ca10aaff4512d6f3e646",
      "translation": "虽然没能找到制造哨兵的方法，但这次调查让我们发现了它们的弱点。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3891e205ee25a999eda3c3945de902a3ae8ee1e7f72f2ad9564591eb61a3d6d2",
      "source_sha256": "bf3d403fb699dc883114994aabb79423c8fa74a828ed3ea1c70bfab0b18e0e4d",
      "translation": "目前已经查明，哨兵和守护者体内都藏有卡蒙德。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:258144d3068e797959b26f4682f825042a209969c451cfd295b06631d86c0af3",
      "source_sha256": "41a50145748b18404bba782d29dbce87ee338c619fda313030833ac2e4f327b9",
      "translation": "据说，卡蒙德对它们而言，就相当于心脏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc22f7683260455ade98e89dea81a4a9222e93e3dc3189c8e556382a0d82690c",
      "source_sha256": "d1f9feded1930af9e1a1abc4ef8f902e98a978fa023de6d326e377c0871df86f",
      "translation": "因此，只要卡蒙德遭到破坏，哨兵的生命维持活动就会停止，能力迅速衰退，最终死亡。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c299f2785c2f14979dd8e00babbb7ffac3cbe691f68a354cdb617bf9cff35a1",
      "source_sha256": "c4829987c78bcc232ba3812081740954b0fb38dbf111ecad4fec52bfe0ebd63d",
      "translation": "一直以来，我军在与哨兵交战时都陷于苦战。今后应该能更有效地作战了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c773e5cafc3822eddfe82197d31407b12c5eec73c738e111b2f40bf7cf196589",
      "source_sha256": "d2c0bc7ad109f1e66bb10e375058ef1bd2b57d56d765779a042c44a75d1167f9",
      "translation": "这一切，全都多亏了公主。"
    },
    {
      "id": "coalesced:0fb825cbe032ee6d7214e65ab067ce4ecfde843379e4ebfa3c16f26fe60adc27",
      "source_sha256": "cd09c1c74c23bba88f5cba358e74d346f01725fb515617986918bf1f0b9408c9",
      "translation": "苦战连连，难得听到一个好消息。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5859aaf5adfffbee977dbfb9b935b671e722f50631ca10d0080050dc0c7b614",
      "source_sha256": "6c4020cf14fe37dddf0f26f73cf37f0afbc1bff51e6b7166c95f0cbe5b071974",
      "translation": "不过，就算知道了哨兵的弱点，又能有多大改变呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2164785cebc799f236a21f3fcdd50f6e09bb9696ad921553bd4380e9129ba589",
      "source_sha256": "7bd65f03102586f06c63fd38d5ace829be540c1c6b585a382f596468412dce71",
      "translation": "北部军也知道卡蒙德是哨兵的弱点，必然会尽可能采取保护措施。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea676f6a6223f1a9091614a8edda4ca1658ff65f82bb26713d92daa0a1a90029",
      "source_sha256": "fc810ea7067bb8905b0cee6108e08fb97a390dd12c4eaf596428edb403bb707e",
      "translation": "但我认为，知道弱点再战斗，和一无所知地战斗，区别很大。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69fec18606d0526f106a8d3205dd55d90f84d35efabdf2ff6c7d0a501b11325f",
      "source_sha256": "3f6e304fd74b3b1f9aa52ef65d5f2ea5475b2fd2b1ab6f50ca241bd90bf232ec",
      "translation": "公主说得没错。"
    },
    {
      "id": "coalesced:ab180d8eacb0089ca03d173391501fa2156ea215e4aefdae694a3d9906cd5e2a",
      "source_sha256": "8ee4fef753a41ce438cfc91530a7953f578c16b39829b9ec50e91b0fd95e3cfe",
      "translation": "然而，应公主提议组建的反哨兵部队，至今真正打倒哨兵的次数，屈指可数。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be0ad8b9e8b2e8afcab57522a115ab8a9caa2c3bc3f3defc6102c505ac18dbf3",
      "source_sha256": "ca4c4170dd117a904c19314041ce508ae46de455144c8186ed6fb8e259dea8f3",
      "translation": "这些日子，我们屡屡被哨兵压制，连战连败。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:436912b950683e208dea365e1dd0d3d098e8853eba40d7c5e21ac46d4d1aa354",
      "source_sha256": "70b90f8522b2368fbc235ab4aed96a5f906bf572f7967d940ae41594746053d5",
      "translation": "曾经在数量上占优的我军，如今兵力也已减至近半。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78e55614ddf2c8150370c214ac21ffbfd705fd89a09643ba87e9848799cd22e6",
      "source_sha256": "b4f15a234ca675e53317b0331b5d12fe34d5f1ae472866146ac488135899c453",
      "translation": "依我看，不如趁此机会，研发能直接攻击哨兵体内卡蒙德的兵器，岂不更好？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8b449dbfd7513f61e8179d863f031a021c7520cd20819251b563a16178e69e4",
      "source_sha256": "a758ef3e3c54b6f532b845d3068ed22eb811868cfa4045275faff3381e826489",
      "translation": "人类在哨兵面前，本能地就会感到恐惧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c4ffc8c9d4f93448a0343e04a3c904a6dfc42955440a8eb7fd8d725912f98165",
      "source_sha256": "8bd42d023dff9c7e2c0ffcfc19a39ab47d7342195e3ca0e31dd7d03013440813",
      "translation": "我们与哨兵的战斗，一直充满艰辛。"
    },
    {
      "id": "coalesced:e6a08adf98cdd0f1d2fa7d3d8a11f4e91f0f7e05f0ef5439d78ec583c225c2a6",
      "source_sha256": "46552ee33b449bde16ca91a5274ecd6751f770c4dc5d0fc6d392a585b9bae840",
      "translation": "但经历了这些磨难，反哨兵部队已经比过去强大得多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ef1f30b756730c7cd4a40f4d68aada2b1f51154a4d2591dd8c8c9558aba5f986",
      "source_sha256": "2dffce89275836944e0e92c1986e8fe03cca00fadb378d4d7f300b4302b0de8c",
      "translation": "如今连弱点都已知晓，这不正是检验部队实力的机会吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:959547165bc9d93fca0980d30c07755e31f8063ec34b609d33ccc8574978624a",
      "source_sha256": "df78a8f846289e62bf9f0877b39d96f39187c8f03ca037ac1ce5fb1d4704e423",
      "translation": "可此前的损失，实在太大了。"
    },
    {
      "id": "coalesced:d69c0a0a7a2a1697fde04d6ea1b9eaba3525be41c0060618e1f11f8edb10948c",
      "source_sha256": "986ee190598cfc5a55a00fbfee7a8048838f97c88f82fff615483064cd6159a3",
      "translation": "恕我冒昧，坦白说，这支部队不就是凭公主一人的固执，才维持下来的吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec090ba248ac6a6913141d1269505d4f81ee0fb6056b88824fbfb0e75b9908b8",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:017662d226840cf3fd855e670007c0e2471607a520a303e0c426566599b5f0af",
      "source_sha256": "9d8089dffe358332ec726a022e1a8ec0db6b4fd6c96942bbf02419d4829f51fc",
      "translation": "喂！你知不知道，自己是在谁面前放肆？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d103afd08b574f9a5e9115a75de2426297ed5811de2a0b9f1627a1fe126d1426",
      "source_sha256": "4d1ad7a4b3d53f400d3907c8407d054cc28aeaa38bd7464b37bdff288bf62335",
      "translation": "克罗塞尔，别插嘴。"
    },
    {
      "id": "coalesced:9928db9555d70c3339876b0311d3e72a4a911a3ea2de3001cc7f3bbad29dfcd0",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:9cc492839d3905807c828ca74e3cb239423e9f5aa3d54070e4f12295245e1712",
      "source_sha256": "c53be8d6764341849109ca00d0fbb376937fbd742a2467dbb8efdcfa732bfada",
      "translation": "这番话，我不能容忍。你怎敢对公主如此无礼？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb71ac8d03d83699439109526a7fbe6eea2353fc25466971e324cd88b1f59353",
      "source_sha256": "1a1f46fc20c6071fb01d1e8b367238d83213419b0f71f6871021ff3ce2b862cf",
      "translation": "不，请继续说。"
    },
    {
      "id": "coalesced:d9e287d17708928d97e77f7b3271d95be43c25795604f924d6e9722160c2e2b9",
      "source_sha256": "15caf2aef58b7c9ea6433c44d60a65522dfdb2662d188c0b0898e2de7a175c0f",
      "translation": "那我就冒昧直言了。"
    },
    {
      "id": "coalesced:86fc2c577bf53333ca456f99e1a11b782347fdac84a86416c7c30d0c647a4f52",
      "source_sha256": "6cabdac29610414c1b9e0779edc89845c62fc3f295400b9e7183d3e4607a79ee",
      "translation": "我认为，反哨兵部队已经没有继续存在的价值。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:263f7b74a081df8b07ad4bd811487b3b98891aa06b3a1689216d8327ed36670f",
      "source_sha256": "35ca0ab45c03f89952792706e59a001335f673d2bce1cbf90c5d054a89ec2be5",
      "translation": "我更想提议，研发专门对付哨兵的兵器。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78029cd2f5090d05c82be0fa231fa4333e125918163c70e428549c3a7a7180f3",
      "source_sha256": "4d055dc18f7a143da9aa4fd7f4264bba541aa120900f0666b99387ff30ed5488",
      "translation": "说实话，如果当初没有组建反哨兵部队，而是及早着手研发兵器，眼下的战局或许早已不同。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb366a6cfda7010ede649999055add2438adfd148370f43f5c1350b3be3719b4",
      "source_sha256": "8c855d63c7ae49163a90560043343434ebad7f8b01eca05a52a15853b730250c",
      "translation": "可是，研发兵器需要相当多的时间和资金。您打算从哪里筹措？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2412518019dae99b288b2a893559a7397f9eca08bc483a1094543f2bd146a9db",
      "source_sha256": "72bdec9130fda826aa074110a36722e567ae7192d713c5c4cde13a803b48ce77",
      "translation": "……公主难道没有亲眼看见，那么多士兵因您的固执而丧命吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:906c4e81ed7d27c176ef2d7ef507eeec51e8f4875430296b3c1b347764bb37d0",
      "source_sha256": "668a7d9d94590c77e51ee153973ecffab6bc3544660d8e5807687dd6f2d5ad43",
      "translation": "难道比起他们的性命，您更舍不得金钱和时间？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a2bcc6aaf0c30ccf92b3bb616eda664ed4358bb114716fed88ac28b507372570",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:e9aac77646c91c400ddca0fd9d8890f1676f4312f7c35339514c40aa68e4dee3",
      "source_sha256": "2971551992746a982292f495a32f34c9b3165bf249add6f8678b8df83f3f8b2c",
      "translation": "我已经忍你很久了！"
    },
    {
      "id": "coalesced:9354fd9f7aa646c72a75590e83d2ac377299418d2db4021687b030c376e5e04d",
      "source_sha256": "9789d1fcce221a2faf228728a0639730c1869849b5f4efb32ebb40e63389ed9c",
      "translation": "你说得也太过分了吧！？"
    },
    {
      "id": "coalesced:e7a63dc8bb5f838ad22ef99b8fa1fb5f250cc57825d5f4d4fa2bc35781762758",
      "source_sha256": "103b349f109158745ead39b971f346dcf13862e02af9898ecce81eb248a01c71",
      "translation": "朱特……！"
    },
    {
      "id": "coalesced:72d467365b2b9f7b1570a83d05f8a29ac8f7150451b6d92b39dff44f193db586",
      "source_sha256": "3702ab6eb592c8418b32213ff4f8af8822be23f948e38592b414a37ee2ea4bb9",
      "translation": "放肆，你究竟是谁？"
    },
    {
      "id": "coalesced:739e31e80098a01973774bb5dc4c4a99602f1c8d42278f748e80ebc035891cd0",
      "source_sha256": "c6e79f74a494587568472a1c0d8250e75472f36a714cabe431bac2cebf890b6f",
      "translation": "他是朱特，新近加入反哨兵部队。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c4e0d591fa2685c1a963984ed423f1d83ef90f1b19a061502d73ce71f3990c58",
      "source_sha256": "f882bda3d34d55335b84dff6ddd6fd2db8902bd4b5c16815dcdd848824c6824d",
      "translation": "就是那个据说打倒了守护者的青年？"
    },
    {
      "id": "coalesced:b48367046a20c023ef2e44b09a7ab9b137234415a9875b0fe5d19778e7b436a0",
      "source_sha256": "bb2c97aa495504ef2ce064d56d96cced79a876cbe0d49444dc8b4eb0dba843db",
      "translation": "守护者？我听说风息岛的那只，本来就已经奄奄一息了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e869d4f5513f77c4c34440c7beed4823ac0ae1af5e88f9ff10fb3b05256d0e5",
      "source_sha256": "0add1cdde3a3cbe72d7fb5a6f0bf7246e5dce86334d5d2ad59747b999a3464e0",
      "translation": "就因为打倒了那样一只怪物，你们便把来历不明的人招进军队？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1323f21da09b3e27b4a4872472be0937495fd5d2491655669627734a5c562ddc",
      "source_sha256": "29f7dba73bee3011337ccd79746db3694cdfbc9d1940db0384d6d5e0e43870e6",
      "translation": "该不会是北部军的间谍吧？"
    },
    {
      "id": "coalesced:01bbd325ea940d0cc40a5a0337fc94103910816583a54657c01d8990bd88bd3f",
      "source_sha256": "1656dfceea2a8f50aa39245a539afb457cf25be6b76924687ec59032e04fc75a",
      "translation": "你见过守护者吗？"
    },
    {
      "id": "coalesced:b79b3bfed8b74adacd423a6e3fbbea1e38b3f5f97754ada0c8c5df3a64ea91e1",
      "source_sha256": "80f3ef16286d6155e87e5d2bde4479fcfdec056f4854b29256fa6323e1fdb5c0",
      "translation": "什么都不懂，就别在那里自以为是地胡说八道！你又不上战场！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7948c61e3c2de50e37531ccd4f457123a10a11190ea46c01338d6712aa33672d",
      "source_sha256": "e91dd42b6c08a1318ad69aa1d5482828acc3bf2d56f7cd70b119384a32aca580",
      "translation": "看来，打倒了守护者，让你得意忘形了。那对付哨兵，想必也易如反掌吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d396cd6923b32c572c9cad39963448645c10e008e1e78652c94c06484973deb9",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:57a60f5f2929c54b0373b24d6aafb47b3e8f78877090ea2c33295e70d8a46f57",
      "source_sha256": "d66ea18fbb88088c356d6193815cb03f4d0e00abc91d6caf10e9434dbf02f2af",
      "translation": "怎么了？果然还是害怕哨兵吗？"
    },
    {
      "id": "coalesced:5322b3c0ea8611bf087b30d40f930593496b204b7ba15cd1fe71a77922b9b407",
      "source_sha256": "46f40bf9e867f89fd8b1f48d72b15b693fd610cad2646f123d0d847d72f9a084",
      "translation": "够了，朱特他……"
    },
    {
      "id": "coalesced:c392b0cb351c8d2c6fb5f3929d5918c47a6442b71a851d677b0ff15d4288748f",
      "source_sha256": "46221906b356d0934e467db412df92e1fdfb8205250dd502ff245a81bbda4f93",
      "translation": "好，我知道了！不就是哨兵吗，打倒它就行了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2539fe23e198a34dd7592c21e88a7c5243d30101a3e42ed462ac37117c1da907",
      "source_sha256": "ed59753deabc2dae7ca15dd4b08ea82aff523e016a4b0edf856ca25070f38265",
      "translation": "朱特！！"
    },
    {
      "id": "coalesced:d364863e4ead20fea4501446ee222a07749e03cff9aa45647592c63e383490a3",
      "source_sha256": "d21fa9d7822e78e44fd32205e1cf32a41ff69aafd4c47c7c76058e7deece273a",
      "translation": "哈，好。如果你能在这次战斗中打倒哨兵，我就认错道歉。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be39d42c9984c257c16bdcb5c3d2a7797868586965603a25c1e8b6eca41169c4",
      "source_sha256": "5642b9ba1556f9f9b0346d4969b9797258d6c80fbad8febaa53201f232b68687",
      "translation": "好了，好了，各位都冷静些。现在不是争论这些的时候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa99ef4a0470a027b0ba854d92d8d5d7970626976b4235a9b365af587836d7a6",
      "source_sha256": "26f5b8c6fec2c9bd45c0b7eaa7e3f7553c1953183180525c5c240b582a43418a",
      "translation": "此次老狐峡谷之战，比以往任何时候都更加重要。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d12c002591ca1552789fc2a0f826aa33d2c3f6296b5cbdfe8ab60cc2b036d0d7",
      "source_sha256": "cfa0161d83fd3912a2e00265e2cba513d9c5173ebcd815ae039e6402b883508f",
      "translation": "诸位都知道，我军已经被逼到了绝境。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0edec8b232cadd32dd8d8e929253f108173b55591558b2714c562bb79e2e1ced",
      "source_sha256": "9a4399fa695bee6bb92184a2786f9cdebde4716bcae33e266de375e7d6529d6b",
      "translation": "希望各位都抱着背水一战的决心，投入此次战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c002103dabf0f28524201755cfa405f5a75d9dc99f9ed3ce4b6dffd0755c219e",
      "source_sha256": "22e128b02d85828fd5abacac30c2bb720b322843209af180989b843317a47b1e",
      "translation": "这一次，我们必须越过恸哭之门，打倒希昂·雷格拉尔。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a7ed939c814b79390d3e0544c2645af70168ed57c94e65b0d815dbb592339a6",
      "source_sha256": "cffdb4a092e6d504744eb027874d224ddbe0705ea1edccb4950ad37fde259a35",
      "translation": "朱特，你刚才的话有些过了。"
    },
    {
      "id": "coalesced:e2a9559722ec35ceca9e45e57b0fdd4684f46afe7e4e0a952247f30875cfbcb4",
      "source_sha256": "861014f2cd714658c7eaa52fe70781b545ae31ff184c5b65b950a8a22395f8a5",
      "translation": "难道那些家伙说的就全对吗？"
    },
    {
      "id": "coalesced:589731357611995d454477bf48bfeb9ab62cd5c84bcbf7b4548345c90eca5597",
      "source_sha256": "1496ff52ff5827297510d12703a180173fa8016a84429f34fa5f59e1b2b48a46",
      "translation": "让你加入南部军的人是洁菲。你这么莽撞行事，把她置于何地？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f51af27cac5bb93edefb4cc61ea99fcc344c5a9e3b936918be491def5823eb7",
      "source_sha256": "8ea4babd3f08d193188f92c136b85a9cbf976441e299c21ad07f85121ae9548d",
      "translation": "这……"
    },
    {
      "id": "coalesced:8c4480b4e51eea8806f3ef2681a7e0016028541ccbd73efb106385e30d38fe5f",
      "source_sha256": "46ea68985edd709bd18bcdfa717e8dc30b895d2bb839cc2cb82ab9204042d91d",
      "translation": "怎么了？我倒觉得挺痛快～"
    },
    {
      "id": "coalesced:b5fe8ae27f1ed0b2a98cb8fc1f71c076f351c64e4b51ee6de0bcf70494cccd0b",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:c5683ae519e1e65a9bbd4dcbf05ae5acba3492ec5133e303538b77401777decf",
      "source_sha256": "15674f5bf28ff7513be8d1a3a6c43b3c45f5cffed55cf174fb29bc3363385acb",
      "translation": "乡巴佬，你还挺有两下子。虽然只有一点点……不过，我对你改观了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7f37b2eadc7aa63d82396944c93acc2e15eb1d4a3385aec936fd1c4cb1fefa4e",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:2819feffb3ee76acfccd8216124718208ebaee555598d51e0f57df6ecf740972",
      "source_sha256": "e95232b68fc67841b9c333b6047c511d60a3cf1183282032f0114288cfeaeef6",
      "translation": "我早就看总司令部那些家伙不顺眼了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3829b4a50f83f0a5a29fa40a73502d37edbdd1cf3dc39f3d18e7e7fef0aa389",
      "source_sha256": "db538719e74cb0ce9d763e112286406cd819f7c073e95f206d28777430168809",
      "translation": "不上战场的家伙，话倒是特别多。"
    },
    {
      "id": "coalesced:b5d6c27961c754ed126677839b5b287ba8c3bef2baab024653fab63fa4bf8e02",
      "source_sha256": "285634f7121e38fc1438279c8017bee2c910262add5d53c0e4531d159ab5851a",
      "translation": "克罗塞尔！"
    },
    {
      "id": "coalesced:b209a45cb361522fe173da6f439046b56ff8508b61ea67299cb8796173d3c69b",
      "source_sha256": "80e360bca89cd5ec9a39412c4ae6cc05deacd9fa76b22c7c02550dde6fe8be78",
      "translation": "不过，公主难道就不生气吗？那些家伙一次又一次地看不起我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f14a2839290ba07cfda50df5aea4ebe49ba5c43b5648c51223cb6f62a87ae7ed",
      "source_sha256": "da2122da5229ed812955e34543744cb88249fd44be43369f611cc0bf7ae855c1",
      "translation": "即便如此，也有能说和不能说的话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d1ce8f8e65054096f7ee2748cd595e3aea708d8242de964855459f2131dfd694",
      "source_sha256": "36ecbc49e2cc8f7fe104c1dc23e3e69702ee0583756a77c01497138d32bbe0f4",
      "translation": "……我知道。"
    },
    {
      "id": "coalesced:9b0adf86e5ed13966bdc446b073f6eb8fd84791390c5c1705535729c20f9571d",
      "source_sha256": "42a455e68a381393591ffd96e256439fd33393d459b88d3618f6cfe64914461c",
      "translation": "朱特，你也一样。你应该清楚，自己刚才在总司令部面前有多失礼吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66684045da169a637d0973299132091c1b41e5dbe1706758bf7fafed50d8cc57",
      "source_sha256": "ac2660c8f203c3bb8c5a774de209abd6726900e338814be18611e33873fcd510",
      "translation": "这里是阿巴泽特，不是风息岛。"
    },
    {
      "id": "coalesced:1baadbb1fbcc4c1404785f73fa12363d709f5effb75aa5483ee28e892ee2f55d",
      "source_sha256": "605bf23d1608a4e80279915213c81fc48a2e44d2714888baa003f9357ee9e017",
      "translation": "可明明是那些家伙先……"
    },
    {
      "id": "coalesced:398cf08c7d8e0850e8dff2701d01b986fcad5ec4a76db52a604ea2305c67e67d",
      "source_sha256": "932c329324c6f3f8f0b01deb43b6f3114f13d5b044716b57164cbef7e01e9133",
      "translation": "你现在是要顶撞身为上司的我吗？"
    },
    {
      "id": "coalesced:f3817bacdf4adeddb63ff4a79ec211b02e9969fdf526f139e293602d8a9ba255",
      "source_sha256": "b6e0378fe3be8b877e8acbfc9016c2ffe413648aa920350975c65c8a438ffff9",
      "translation": "……对、对不起，公主。"
    },
    {
      "id": "coalesced:8a4cb3f358e9961f868e34e7dfc46d2755e129c2293e4add99670417fa4a4c62",
      "source_sha256": "4b2cf276092e0750f5c26069279951d568bc21fbdaa76b8f0cc830447849b6f7",
      "translation": "不过，你替我说出了想说的话……谢谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44dfaf25f75e1308197cbf1429ffd0e600859fd13a52906b3ab0caeb135eb341",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主……"
    },
    {
      "id": "coalesced:23589b4701a7d1dfe4073eb72de51b29ecf7bf2938e3e3c8e4a62bef7cb32001",
      "source_sha256": "a3a92fc5d749c8addb897934b66f7ae88bba2801ac7b033c29944eb4fb6edb93",
      "translation": "总司令部是什么想法，大家都清楚了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7c98fe6fbba2feba291129870e84df021a9b75a61aed50333bb486d0de06bc7",
      "source_sha256": "f912617a55ee2bb25898c46fee109051cfd504ddc6149e9a1b4e6c09931a5d01",
      "translation": "这次战斗，我们必须切实证明反哨兵部队的价值。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:495365c1d943eda34f321d4ef629c3affcb073b690876d5462654c8a78873db3",
      "source_sha256": "767d5c49467ca6da6e6963a2fd709ab073c59530d575a8d49550e5917c063a8e",
      "translation": "如果就这样转去研发反哨兵兵器，会耗费大量金钱、时间和人力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c835d550bcc06af1c174a5eb3d72eb678e4bf5ca54a1c4c2e629467ecffea076",
      "source_sha256": "b69f4a3c4fea264a56bf42bad571d219e2d812b5552b2b01a560b6ad32f5e91e",
      "translation": "战争已经让大家苦不堪言，不能再让那些把希望寄托在我们身上的人，背负更重的负担。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a8fcd62303622698ae540ead2418fde83932a82686896f2de34669f382641d8",
      "source_sha256": "44b0c51c0a35416a24253d12bbd93f428c6df1db0f24b3337dcdc4753c89d9e2",
      "translation": "既然是你第一个放出豪言，应该已经做好战斗的准备了吧，朱特？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7f495975b4779ec1c5aa09bbbfab8bb02cfc89d890372a558181dc1b4ebe5e8",
      "source_sha256": "0db6d402f83f9efbed07bc771099a2df0a4d71393d5a47316add77559896862a",
      "translation": "那当然。"
    },
    {
      "id": "coalesced:e88276cc9191bb43230ad988f30625697ec5e54f7206b17da661c7bde487d283",
      "source_sha256": "0ca53de3fc51fdc867b9ef13d24da58fc51d01e70d5975fbac247bfbda148ab3",
      "translation": "好，大家一起加油。"
    },
    {
      "id": "coalesced:11e9f34d0437d02f79aa85611373b2efdf10558f7c48d7e2beff224558c82da8",
      "source_sha256": "a733bbc7aeddeb6da1e3f90db2b3db872f8e9e45d8463d8051c6c391ab8bfde5",
      "translation": "这次老狐峡谷之战，我们一定要赢。各位务必做好充分准备。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01d9ac496beea54be07eed0a58906960dd894356b036be9089f384939f0ad661",
      "source_sha256": "b3f2eee988b1a0621a6cd912e703f7f82ffc289a5bb458027cc21ee8ed6a7cf9",
      "translation": "这一次，一定要越过恸哭之门。"
    },
    {
      "id": "coalesced:e8bfb4bd8a9f9d030b586179f093a181dfcc1db723e08600192f54a366c63716",
      "source_sha256": "7b2dba180e3410bc0ba7f0365361b01532cfb0ec3a786bbadbac5475bd68e9b8",
      "translation": "还要为凯托报仇。"
    },
    {
      "id": "coalesced:a95f511139ebda229a85e4a93b7828a7642b15693e99ff9114d3b3c36fdd25f1",
      "source_sha256": "638b125b3c0bd51471b82580b4ed71155494a6f621725535ca313e68ff00a67f",
      "translation": "没错。尤其是朱特，这几乎就是你的第一场战役，别太勉强自己。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb89de57298a4ad4de4430ea477d63478233ff4e893a68a29cbe13caef1084aa",
      "source_sha256": "746cdf0eee4857d2329161d26366fbbda021b9a43abafed24e68f7496b354db7",
      "translation": "我……在找到艾尔加之前，绝对不会死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e08547e8acafa5db801e30e4b8f28cb9f15e2022bbe0c60cb0697bc4739ffb8b",
      "source_sha256": "d66e239708ff68bcdf92fd0e40f698a3eb043da3e7b872bcd22b1dc18f59e59d",
      "translation": "对，就是这份决心。记住，我们部队的目标，就是谁都不许死。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:367abbf3f68fe509bf0cef56c91fa8228df3765cd1f07d5c03643eb011cbe0d4",
      "source_sha256": "fe7d55ea85e1fdb1e2d8d70009ee49d51ff26d33aa26730dda23b2d620339cba",
      "translation": "这一次，就让总司令部认可我们吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bfda234be2173766ca21e65652126460e975ec34060b1e314faf8a8149f22239",
      "source_sha256": "ab341f774f0587969e05aaefe69eca7405cabb2a0c4c7504a596bf05e3ad2d8c",
      "translation": "是，公主。"
    },
    {
      "id": "coalesced:f850d894f13980605cc5fefb4065dcea02d7818b46d7e6dce8a7d49526d7195c",
      "source_sha256": "0e425772f1d1a779e756a074704ec186cb70f3dd2c5d49e70eab76f4911016b2",
      "translation": "洁菲很坚强。即使心怀痛苦与悲伤，她也总是面带微笑。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:342c067ee4a744bd2944cda26be896e520395949430e7e5de4684a0f018cf1a2",
      "source_sha256": "22e87f7a64399ad6538f0d664b8ea0a2b304afdf754f8bcdf3864f0df028aa75",
      "translation": "我一直都希望，自己能成为像她一样的人。"
    },
    {
      "id": "coalesced:0b7e60450c9e751497333f9a9a39374c1bafc1fc769149e6bea67f997662fc78",
      "source_sha256": "240fba7d2a6e3538aa832dc74f394026190835009f467eaa1ea7c7318647f5ec",
      "translation": "真的只有三个吗？我怎么觉得，自己见过的远不止这些……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d549f0bf858f22204c8773d7850b4cac7f4752b94b5cd653d933f252b7982a77",
      "source_sha256": "62af672ce56869a95c7f77645256e4fc9cdded0a1594689ff4fa7cfd0c9e4d29",
      "translation": "应该是错觉吧？呵呵。"
    },
    {
      "id": "coalesced:4f5aab08c814195555155cbb72dd71028bb61f19d4dc1e2940fc0499472387cb",
      "source_sha256": "f13211a373ae940e7c5d189afb2d2a16e1e4bcfcb622ee764432ddd10d2675af",
      "translation": "或许不该说这种话……"
    },
    {
      "id": "coalesced:8970b7e120abc42757e8e88ea13e22ef92a8ce9c0144430594ecebe9af56dae3",
      "source_sha256": "14f30b62a075a75a76edd8612b74950996667c53b3a69a25789b9c4569a533d2",
      "translation": "但我有时甚至会想，这场战争要是早点输掉就好了。"
    },
    {
      "id": "coalesced:6382b7d6872a4d2e05d37b62487a038b22e3948f1dcefa831bde7462c090836b",
      "source_sha256": "8737096a8b8bd5725d73d298eeba23f1b74c5e40535dd48e03a87404520897ae",
      "translation": "人类真可怕，为什么总想着互相残杀呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ed48dd408651deae25b342071c8fafc0e472ddc962ebab868c17267f3a5ceb5",
      "source_sha256": "56831f49ddb3543a631057eb5114877ff2f082082f48162913c0dc8f7a49c9b7",
      "translation": "我们阿维斯也有族长，但为了当上族长而杀死族长，这实在难以想象。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f3d082460c799a8b7b521884632828f0194960d83f2e8e3976f142eff26340a",
      "source_sha256": "f4658b6ce214aaddc1619397df49b21c1196a9c3a66828d22598f850055465cb",
      "translation": "中央广场，都快变成难民营了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1f4d165de0ed7b91f70a7993a9e2de339e0105280b67d189936dbd942187b5c",
      "source_sha256": "6a806f5f40aa0a0fc70e027273a1b61eeb5765ad22bc762ad1935f8858f4e8c2",
      "translation": "我才刚来阿巴泽特不久，看什么都觉得新奇。"
    },
    {
      "id": "coalesced:10f324515318a162c6a4f8a9a670b7569056d2ed68a3ff070d078e2fedd3b0fb",
      "source_sha256": "ca562b10f3dc8df2c775c26ae67071aea754670ca1082c398b2f5c96eb717eb9",
      "translation": "从高处望下去，整座城尽收眼底，真不错。嘻嘻呵～"
    },
    {
      "id": "coalesced:a1a99aeffe8d1da1c8e2e6f19a062a938b675b9a5dd1acf0ae75f8c93ba39276",
      "source_sha256": "ed6cdb4d68630d03c99c472f8d4773d390c6924f5a3189c4c401a238618caa6d",
      "translation": "好久不见，这些日子过得还好吗？"
    },
    {
      "id": "coalesced:a819f1f57fc22a46aebd91fb63daea557069e30ab44834a37cfefc7caa33494e",
      "source_sha256": "6d9455899656a3be4467e071ec6203a0e55c6a0d3d9797733059c08f878b2bd2",
      "translation": "这兵荒马乱的，咱们都还活着，还能再见，真让人高兴。"
    },
    {
      "id": "coalesced:5dc9a9b3c01957bd575a3e0d1cb55a700d1a6e1aad0a632942f1b4bf04e3e980",
      "source_sha256": "b940849ad21f1bec563144a7a1bfdc6564bb51b1c7a6084ba44334bb0b55f9dc",
      "translation": "是啊，一阵子没见，你的头发都掉光了。"
    },
    {
      "id": "coalesced:10524dac632cfb7473c771ab4510f9ca0a60bcdd9922bc0b5e5db4d90fa8e2f2",
      "source_sha256": "a12cdcbb7e44dda8e76056918808806b6d37888795f4dc4f75493e077974dbf0",
      "translation": "哈哈，老伙计，你不也一样嘛。"
    },
    {
      "id": "coalesced:4c0409e0dd2b3bd4f435608754e2fb6666a0d6272d717b4ec638b6e265624eb1",
      "source_sha256": "c7c8a03b979a2ea5c69a322e90680dbde70a6b42e3e0ac9df491ae42ee37bf6a",
      "translation": "是吗？呵呵呵呵。"
    },
    {
      "id": "coalesced:cf1a0c605fb80fe99a082e1d512664576180e3f0dee191b68b4de3e18cd31062",
      "source_sha256": "2f634ed5d48e7afeb9eb7dba43d4b62f7fe807e2c765704eb0a3e67ae9959d9d",
      "translation": "大叔，你能不能别走？就留在这里，和我一起生活，不行吗？"
    },
    {
      "id": "coalesced:6e593484accb3bf0e0e0db70fd4bc6f3b8b5226fec064030a5e806f7dd7365dd",
      "source_sha256": "a730f7326ba532d42071b1020cbd8b293725bc11db716b7a899262bf13135d25",
      "translation": "可以的话，我也想这样。可是，我还有必须去做的事。"
    },
    {
      "id": "coalesced:e85d7419ddf6d873e72b8e367a45e96d2a95246e30a208af4950f27d009a62fb",
      "source_sha256": "c01266d56ef8e29d3c6732ece4eba79fafa9448c7c264d9dd476040063026553",
      "translation": "大叔……别走，大叔。"
    },
    {
      "id": "coalesced:51757f555e98c204583965fd5bb84fbb553eb5a63258b2eea5a438baf5b1848d",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:7bc615e0785ed5df9e8d1cf9684321922bd6871434d0e4ed7691ee538c6f7407",
      "source_sha256": "f55c317d89ce7b38f778093e3f2998750839d80a6c297ffe52dbeb83517c6120",
      "translation": "南部军到底在干什么？还要让我们这样提心吊胆地活多久啊！"
    },
    {
      "id": "coalesced:f3aad43dc410526ac12af90c148609d6a686ef3f5cfbb946127de3ada27dd12f",
      "source_sha256": "63ceb48a675ff8c1a1d933190636027727636959a01c64ff371fb0e7087747d8",
      "translation": "进来看看吧～这里有许多珍贵的卡蒙德哦～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab610dd5b27e441f25967e8eb07cd6138fdf8bf177579547c684bb4a62718788",
      "source_sha256": "2059cc7488f9bd920413725bcca5bdc02a1be9dd77429fa473df876747a7796d",
      "translation": "每次都多谢照顾，喵。钱已经收到了，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:26fb48f79a78734b300d15de8921d0a6d48bd4e3ce10263256c87f89bf7f46c5",
      "source_sha256": "6c4e17acf199cb0ef471514da9028333b743f46144c14bb59801ee47d4f6b602",
      "translation": "炸弹就在这里，喵。这次要用在什么作战里呢，喵？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d5b9155014feabfa671f0855a1c263e6adb3f51a00cb6d35d1dcddae8f844bb",
      "source_sha256": "5572bedf5610aca2c401c36cacd8b37290377a96fc0bbf19842558fcec0144ad",
      "translation": "哦，这就是这次要用的炸弹啊。"
    },
    {
      "id": "coalesced:c3fcdae9565a3d9e802a3e5ff42c4b4531efdcd7cfde58225c72835fb18d82d1",
      "source_sha256": "b8f16ca1ffda3ffd0ce101982441f8d127a1f83331a6ccee67f36c0de94a2e66",
      "translation": "真得感谢那些猫猫。南部军人手不足，运进港口的军需品，全靠它们代为保管。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a945be39e2a1bdfed06f56ce89acf86bd7478ab9dfd745731901a2b09004e308",
      "source_sha256": "e2ef9843bb9a4960f2b30af00ddf062426767d85186bfd513ff9099b8cf05bfe",
      "translation": "港口离这里可不近，辛苦各位了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ad9d46f17aff4f7c3e0ec03e234674ce3c6653eabb330874410706a5ff09db6",
      "source_sha256": "a0f7fb6081f904b17d042c18f5217b4421c5ed3661b21351ef2cf35db728db74",
      "translation": "运送炸弹"
    },
    {
      "id": "coalesced:1be35b963e5d7bb38c4373a9b9934ca55fd0b04513a95b575132550fd13b827a",
      "source_sha256": "31dbf390272cbb0b3f78ab2dd308849e02dac1226d0b35a5084d92f810e1ee6b",
      "translation": "前往阿巴泽特港口的猫猫族村庄，领取南部军的炸弹"
    },
    {
      "id": "coalesced:e84294b36db34d101054f23c00c7efa908e1dc26cf1199a9f5a53e156329f16b",
      "source_sha256": "01349827526bbe086f1a6785e59f69c7540f1e7ab2c244e4db5b6420d0ec837f",
      "translation": "QUEST:获得炸弹包"
    },
    {
      "id": "coalesced:09984e55d24344cb7d2d86c112d2db3759d2d8b480e857694eed3bf6a64a567d",
      "source_sha256": "3c4620796844923d0352979fca78452f5abbbbdb69f127865a5cb70cbd2879e1",
      "translation": "反哨兵部队"
    }
  ]
}
