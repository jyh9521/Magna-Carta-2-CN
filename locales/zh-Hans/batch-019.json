{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:b11ac4ebd416c13dde1e15847ba436f185109b9af3465c56f8029ac788c1977a",
      "source_sha256": "9b332e5771e7e30a496a70e1a96baf64f83035e790c99d2a2fa251277e7aa64a",
      "translation": "从这里开始，就是杜南丘陵了。"
    },
    {
      "id": "coalesced:752b679f62bf0efc08960950b577723048db8b14798db6a7a6e7470728809600",
      "source_sha256": "6842691a569d4fd4dcd464d41dcc723af758f6a869d2febda3b1fac87ab70cc6",
      "translation": "各处哨所的攻略方法，我会在各位抵达之前，通过库布发给你们。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c0f6cc664d60f0d6beaaff8c2ae9b80afc690a23e1831ce243cbeebaa0f1c5a",
      "source_sha256": "16ac1004e3b06c0504490ac4eea8d302439f2a91bc375556bf5a198ea2052695",
      "translation": "目前，已有侦察兵伪装成北部军，潜入敌方收集情报。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f669de33ab7cf5ffd5302c31b96174043b30ef644bb2e2edba4a8516f32a8c6",
      "source_sha256": "16e9d2f28bf47ec10d50c5a1d7657f61a19b1947ac9fd6788683bc409bb4d61b",
      "translation": "祝各位武运昌隆。"
    },
    {
      "id": "coalesced:2990b62aac7e5942fa7e90efec7dbeb606687056999f031278eed9ea4df15126",
      "source_sha256": "e724701ce73455fe24a58d594a120daa1fbd776405e53393f66862e2f277b7d8",
      "translation": "谢谢你，劳德。"
    },
    {
      "id": "coalesced:a057cdb8e4fb89219103d0ce1c8544c8db4bbe8e96a9f5527d252c7241597b61",
      "source_sha256": "ba579ec84913afbeb1c68a2ade65d15d1a9c75c7d36e583fd4141cbbf8324d5b",
      "translation": "呼，总算突破第一道关卡了。"
    },
    {
      "id": "coalesced:9ac92f10e531398c5877d0bd3ee05b1db1cd15ef71d456350d469e0f5b319416",
      "source_sha256": "df1be7c5f4e90513f2924f7de5feeaaf70049b01510bc085e2a9189976018315",
      "translation": "是啊。不过那些箭射个不停，真够难缠的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ece7cd4485db28f2c2dff8c4b99347f310e630ff19e268378bfce31969a8a63",
      "source_sha256": "bda7be686be3503fed4f118b5ef411ac5e3c032c65379a750079b89046589f12",
      "translation": "所以说，那些射箭的家伙就是麻烦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5d7ca45819126d1daa8ef9518dd475a669927d4f04eea2f5d4be9c8656b8ce27",
      "source_sha256": "fe4783644b1ab8f5c81bc908a2b0d80d78991ced3902d0578659173fb14b1f29",
      "translation": "你这话是故意说给我听的吧？"
    },
    {
      "id": "coalesced:08f77d75794e11df51086f7737e613d1b8dcf0112c3a19e6612e22b8b1ddca91",
      "source_sha256": "32485d9f190078b96913dd3f25e8183e52381abad19dccd4f4e1a3acd50d8510",
      "translation": "谁说是了？"
    },
    {
      "id": "coalesced:c56173fc1d770a8c5e9f2b21a2457fd8dbd8c57b185747532acdc9b90c7aabcd",
      "source_sha256": "e0a4c5c78d725ae0a2bbb1373069aea0d36a207f0c5a5e9b965919e834cea1a4",
      "translation": "哼，你给我等着。"
    },
    {
      "id": "coalesced:5465bfba1bacf76618bf1f85ec8cd0b936dc833e9e04b315edaee7f8943a2b66",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b65ef051b30ef2227a71f2b115c2586183fb50021a346ae12b06864cd77ecba4",
      "source_sha256": "9902a29c8eb0b56f8310435f7f1fd146a355ef83904d023c4ab0ba2ae890117b",
      "translation": "那就前往下一处哨所吧。"
    },
    {
      "id": "coalesced:3b3d09d3f6d2f39ce2b6ed2621c35372d01e335ef7df7ada6b3b9c33fc70f3e2",
      "source_sha256": "66011ddf87b19bc005cb407b56d00aeaf34befbe590c68db442519c35b4ea725",
      "translation": "终于到黑刃要塞了吗。"
    },
    {
      "id": "coalesced:6c7e70226f317ce81fc738cf8862ff76161511ad3b5214c0a9504bea50681f70",
      "source_sha256": "0bd771641df1426bddc27f980765c096e76dba8f9d28b0d93b585e80760de2ac",
      "translation": "你真的……变强了。没想到，你竟然会有这么大的变化。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a30a628b35576a833437976bd88aabfc8eb85fd2a0611dca2f0d099d756b3a9",
      "source_sha256": "1f8392e82759fcbdee0de0bc9fb08c45cd1fc5f46e3568dafd3ee439c71a9106",
      "translation": "梅莉莎……你为什么会加入北部军？"
    },
    {
      "id": "coalesced:66e006cdffd346d31232adb84d34c7dce36752826b79a8278a9113e26c6a30a1",
      "source_sha256": "449d9a2dfee69a41ab740fd0be8df171dec45846b0958b9795456caffe68bc5a",
      "translation": "难道你忘了，那些家伙对我们做过什么吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cccb5ab342b99081db576a48e0dc6539ff3403104d835c07a7a8fdf0ab66a8a0",
      "source_sha256": "3168487fcf9f60669987ea9bede32787e10d58fb29648f80046368bc5216deeb",
      "translation": "我为什么会加入北部军……你应该比谁都清楚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9d2b0ed650236093d6c9d703b4ab2e7f418caf838bbbedad92e4bc89761b55a",
      "source_sha256": "bad38390230da063afc7fe59fa90039cfb84aba4d24861ad7cadc6f72813b7b9",
      "translation": "那……那是什么意思？"
    },
    {
      "id": "coalesced:9925618af5fc51f771da12ce97fe7ef1b4fe27ca7ae8298adca9bd9d84367001",
      "source_sha256": "0e245d8f303f1e4d7b150fbf5513b662a2f9d8baf3da4d216140050a0c7e2ff0",
      "translation": "你真的……什么都不知道吗？"
    },
    {
      "id": "coalesced:3caefbc56c26530289d1f3dfaa1164e2ee36f1eb63efd56e5917d08f9d066db0",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:9a74c540e9888836fdc293bc196018b4ba5accb48e3b119c36e32b0ab8d386dc",
      "source_sha256": "c409b962f83cf540a14ffaecb88527ebebe18dc4d9ae442bcee57070416d1b68",
      "translation": "反正……总有一天，一切都会真相大白。"
    },
    {
      "id": "coalesced:3cfd6f41d903777738a8dffef6393ee90f67437e1ae3adc5e181cd6d10877d95",
      "source_sha256": "14e3cb0bc5be57ddffd86dfad3a1ff5d377d452904bfb2cb722fd0edd3e14a42",
      "translation": "你在说什么……？"
    },
    {
      "id": "coalesced:51166fc648ff5202c7a49ac62eb70269ef48d9615218abb66f295912fe569406",
      "source_sha256": "3370dc86f72f2333284f58401546156ae37d144b1df91d2d4e1896943bee7121",
      "translation": "朱特……正义在北部军这一边。"
    },
    {
      "id": "coalesced:ad231ab8f8f3bae876e1c70f98aba2960602a16873783e2a73466e302a20efd0",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:ebff2c622934b3079944740cce8ba312a20908c795adc4d871d5515c8ac02f88",
      "source_sha256": "559e34a6be0e8a3fb5fddb945e2e6bfe7370a24f114c981f79cb74d918f8f78d",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:486d5eac54e5a8b51421e63e661efe2d456b8d22039d8906401e0eae1f21982e",
      "source_sha256": "64fac12e2646739352aa6f683c63335c8e1742670402e08f7e0496843d734c63",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:855e4eb78ffedba7a8f53c21ae42fd0aa1462c2768d2a6f6ff17652a2b8d1a5a",
      "source_sha256": "8f6e07ef5676f6da6d1394819f21a799de6d4ecbf04b9121a6f0f2b8fe338ab7",
      "translation": "你还好吗？"
    },
    {
      "id": "coalesced:7026d0b53510301c6ce02e6fcd6362c93d7c1768f885173ede7e3821942ee397",
      "source_sha256": "09bdf2da14c54bb17aceabdd8a41afed2beb23c3b1af4597638882cab479dc20",
      "translation": "脑子……还有点发懵。"
    },
    {
      "id": "coalesced:855155600ead5b9806ced574634cac7c1b1235d1c8f96d8070f454444eba5760",
      "source_sha256": "457eaf8efebdc5a0c77102587a223727109a408a3c6ed3e266938f4fe315d1ed",
      "translation": "梅莉莎还活着……真是太好了……可是……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:542a3b0248682286868f089df5db2b44e5d28cc79cd23efbe41353d792eef706",
      "source_sha256": "245098feaeb9e51007a261da0d2da33f9cd1cdbec00cd6d472620919b483ad3b",
      "translation": "那个叫梅莉莎的姐姐，是朱特哥哥的朋友吧？她为什么……会加入北部军呢？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dec5f8d6cb040a92fca5575051d1b76c6216b665fa71d872e895984fe5011499",
      "source_sha256": "20f79e3b9e01a35421359713e9b6c9da6fe44833aeccfe50bdea4a27070edb62",
      "translation": "真让人想不通。北部军毁了她的故乡，她自己也差点丧命。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69c20e5c412a92ab2cd39e0940c24546e0767d0af1bbc989a6970202b0909d0e",
      "source_sha256": "5bc65489e576a82b99f94acb1c3376d35a67b87e2752725d388d09b2c8e16239",
      "translation": "梅莉莎一定有什么苦衷。……我想这么相信。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b282d5134db323854f59acba3449184800cffd473a81e1afa23c3c98d8bd3101",
      "source_sha256": "853563553e682968932bbd08f03e50b266f690e0e91b19d1836d8721667c84c3",
      "translation": "……是啊。"
    },
    {
      "id": "coalesced:fb951fe6ab8f6bb886a8a983ae4f4d93e7020bf7de4125a14c60c6d14f6ec9be",
      "source_sha256": "67e4eb2ebb57a4534257a309206fb625b2ab5ebdb642ce8942b2255a016b4bac",
      "translation": "走吧……接下来，要调查要塞内部吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:622ace2ac8368c2980764954f1925670dd08561fac606f4a57ef565c546ef270",
      "source_sha256": "0b1f9477eca289eb8fb40274ffe21e36e0d4fc994aaa92cf186efe7129c1c39d",
      "translation": "……嗯。不过，不知道里面还留着什么，得小心些。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d2f04fabc451838c25c3986b8b95f74a19857dea52ccd0ef82b169e47652cb3b",
      "source_sha256": "ad4da09732c1674dc9cdfac311025568f5af7c310582d575a1339503b53aa7cf",
      "translation": "里面……应该不会有艾尔加吧？"
    },
    {
      "id": "coalesced:d86ee769da34c449401fdcc55d68ee2205fc06a817beba267e0f9c061cef0fbd",
      "source_sha256": "c23d67991555c4cb57222b9ccf8a407e9768b47d58aff6eff9eb33cb380d250a",
      "translation": "不，现在也没有和那家伙战斗的理由了吧……"
    },
    {
      "id": "coalesced:eb688fe1320cae4e5cb8a7be695aa1d3b33a1c9d1db1c85289ad19e70fe43738",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:761fe0136469ca44818496308960dda6406e10284ff24ff04c2fe248a7111436",
      "source_sha256": "6fff73192b00c30e80e817ef0ba0095f4298f8bf9b1482456710d34aa27fbb00",
      "translation": "梅莉莎以敌人的身份，出现在我面前。"
    },
    {
      "id": "coalesced:31340fd9fad0bf1d4fe3c26e9e104f743bbb6a4db85d59dc284b4421639dd09b",
      "source_sha256": "62a85495fc207508ef5244e622fb66728789f2fa8f3c10f920fc273422ffebff",
      "translation": "没想到，我们竟然会以这种方式重逢……"
    },
    {
      "id": "coalesced:b5ef40e1f1a40abdaa58ce2380f65e37a762b2e7eb389753608da1abf54e6807",
      "source_sha256": "3c641873df070b204418d33fb491f1021747937327904c7d0cddd071d226890e",
      "translation": "我至今仍不敢相信，自己看到的……真的是梅莉莎。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73b7e5098e64c8a668af2dca68ca80abf428e3ad11c9149e939f2f8101bbbf0f",
      "source_sha256": "cc3f2eed078b43541bb709425d2c7aa1743c1d1f7b35434c7d908310536614dc",
      "translation": "这是……？"
    },
    {
      "id": "coalesced:e57ac1e27f8682bef243c2fca3a7cd257aa0d71886cbeef9de487507e2a97aa3",
      "source_sha256": "bb5d25ce1bff01704621e5ced7d46048cf05b9092271c103d764e202e58e568e",
      "translation": "呕……这是什么？"
    },
    {
      "id": "coalesced:e56a47b2b8ce6a6e2465476d204144d72195612f4b138c6cd6e1d57702711c43",
      "source_sha256": "af0732f12839deb304cb95958a1c8c72455dc7897f4f850f81f625520c98968a",
      "translation": "怎么能做出这种事……"
    },
    {
      "id": "coalesced:2aa87635be1031835c8b36575cc6e65b8502a39d43e775722d6b10a98db5bde0",
      "source_sha256": "e0c000dfc58dfaff6becad2158008279f33fef564e9b1c54aa3990ae22463dc1",
      "translation": "这是什么……难道，他们竟然在用人制造哨兵？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb03fc0150bec53536e6c1ee2b2dff179db7c8b37760eec1b87795f3498290ae",
      "source_sha256": "53c0412a802d512601d831b199537bbc09d590a0c61b4d7ce9ae0f92a8b16941",
      "translation": "……怎么可能。"
    },
    {
      "id": "coalesced:b8dbb9d30e26eddbd0fe7d6388a710b448c7c22cd5b199aee937f657d9db7f31",
      "source_sha256": "7e7ca92557b6488cf0e36930e803a775232ce7b9a59f9bd7e7154b4c7d3868d6",
      "translation": "……马伦，艾菲斯……"
    },
    {
      "id": "coalesced:cd19f62977ea58a35c1111f5af5f1c8010a7c95c56204f615edff7092ca09573",
      "source_sha256": "696abc2f988df87f6f426937e3f60493962e40ca3a7a1e6aee74abb9ed9404fe",
      "translation": "你们怎么会……！"
    },
    {
      "id": "coalesced:fe421e7f5c2aabd8401b4e6f2a6e57d0e3ab69ed3dd0285193a502ee7d6a29ed",
      "source_sha256": "3548f75f8257ddb869764b6032c456b8f9cf111fa5cc376e670469757fe82dc7",
      "translation": "哥、哥哥……"
    },
    {
      "id": "coalesced:5546835227a02f36219d1d8ea6d81bc3258a8dce2bada5ef367bbcbd6afd821d",
      "source_sha256": "a965849978f9139473afe3424323ca53b090849e0e8abbaef9c0f84f01887987",
      "translation": "北部军那些混蛋……一直以来，都是用这种肮脏的手段制造哨兵的吗！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bee8faf9ee5e08b2f963d12510b79cce26b9f2d0cc39532c28f4d1a700f86189",
      "source_sha256": "dccc6f174add8b760f9623d1448e5d5bd0232101e5814cc5f1659dd6639b4909",
      "translation": "……太残忍了。为了制造兵器，竟然连这种事都做得出来……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:919c43905960a747b8b632fd89af7c899a6c4fa6500cefeeb0aace62958b4312",
      "source_sha256": "92651f38e4360c3fe41b1120e767138ff5e1d8d9cb7fc81e71074279ad54d909",
      "translation": "修恩扎伊特！我绝不会原谅你！！"
    },
    {
      "id": "coalesced:45c4ae4aa38ba48541b9c906a96a3da1e7941a3cf04764a5d16064d6876b09be",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b774894904fa5d38bf2f8a5b6db18c21622d45947288426b7011a478ce55426d",
      "source_sha256": "dbae839bba48b94e935b1e8659e2a10803c28b45123eaf55c77e4fadf6d3a319",
      "translation": "梅莉莎……你、你为什么会站到这些家伙那边？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db43d1235bf6aef2e0cfac8fe455e2a47fe06963c12a07409e0d7c558e837d03",
      "source_sha256": "c0a4a93b08617acf45e48d59423021ac178d5746868bbba6ceb639ec57bfe127",
      "translation": "你还好吗……？"
    },
    {
      "id": "coalesced:273b4c922a13d599b0e45a8d8f2eb54bd471b04ddecf8f70c0f82c02e99d29b2",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:28243f0426038b86d77c28064b3f12c50323703496e07b37b2a34d38a714b79f",
      "source_sha256": "bacbf2323db0f4e180f3327f7d6fd28b86fd4caac821ebdf8c0d8f2eb90e1880",
      "translation": "哥哥是为了救特雷瓦族的朋友们，才加入南部军的吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3afa44860fb1dbcb8ca378dd1fea5cff5c34737a0ac87d8d40cf5f659adf6c8",
      "source_sha256": "ee6fdd713c686ee35b655777a05c40d9832fa01ac60d52599ce4ade65b952c73",
      "translation": "嗯。马伦和艾菲斯，都是青月特雷瓦族的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2a9ad600a4c09aaa118bc7b92c7e6b37fc0f96dad67772547d673234142d856",
      "source_sha256": "bdd1a0b5c789dd33c40640d30b5fd3e625a8606959b062f266f3e78cfec902fb",
      "translation": "一个人都没能救下，只有我自己活了下来。我没有资格当族长。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38e7ec0ff03dae3d992825fab53f652c7bf8da66ee75090b8c744f288b8907d1",
      "source_sha256": "b9c217a2ef313fe4ec4c7ab0a00596558485cc69a66805dfd24cec331c92b78f",
      "translation": "我听说，黑角特雷瓦族与修恩扎伊特联手，灭亡了青月特雷瓦族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:421be3ae90cff8eb056e385ecc80f669c6fab76b8a0d48110738009b2a96cbeb",
      "source_sha256": "65b3583ff02984d67ce5a9ef0559c9060b4a36712ee5505c9740446d95867ebc",
      "translation": "可那又不是哥哥的错。"
    },
    {
      "id": "coalesced:bd5cc21add1cfa995e22aa45bd6bd776265f5f9d67b4b8eceacb5bc944ccf60c",
      "source_sha256": "64acf6f44265240dbfda40f34928c7a1fb36be5b5accf513c9c222deb363cb65",
      "translation": "和我的错也没什么区别。要是我当时行事再果断些，就不会发生这种事了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ccae402ab00fa2dac6107a43d34588329cadd90c1debf47fcb87c6897f055541",
      "source_sha256": "3fad0e71a6c286983ef38d82989e14d37f2f54585916d3fa9dd0fa01168bb842",
      "translation": "哥哥……"
    },
    {
      "id": "coalesced:f5ed17593f42d3d0a01deaddee0898caecc8c003c52d996808c02e021838765d",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:978dafd5c123a26789c3b3e2405825f28c16109c0aa0af0123927d4d6e70ecff",
      "source_sha256": "70203ae7bc3be3d517affb4bcefafdf25d5ad75be69177fade6da4d45d576c63",
      "translation": "对不起……这种时候，我不知道该说些什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c29c77b2a0dcb8963f5523302cd00bc837da777c7aed9e91ae4ad9422a4111d1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:37a486164b1fc28047f488ff56c0cd66692973bb5af4e83d666abfb710a092c5",
      "source_sha256": "f05b0fc97b4c6e12db0512c54ceff67634712eefd0bb3460223b23d01bef36a5",
      "translation": "可是，哥哥是个很好的特雷瓦族人。我第一眼就看出来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4eb135ab5bbcf4950bcd7cf300ebebd1535782ddf07c929de27e18b3db15b12f",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:ca583e33341b178bb49cce989307171887e01249f7d079437d9380dd67be55e9",
      "source_sha256": "f7920412b7afbeeeb50539fd915150dc5c06efd0862dd8e5608a73db227c412a",
      "translation": "你不相信吗？我说的是真的啦～"
    },
    {
      "id": "coalesced:f7cb5df775525e769c49abb964fe82db514b9d718d3d580d0d5e1d50d3c3d733",
      "source_sha256": "0edf3bd283e8d93cb0f8e9214a75c8b001ac9fc3f7a9b3e8a4fe14dda073ee38",
      "translation": "马雷族的寿命，比其他种族短嘛。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5c4752538355213218646e6298781dbef462ebd90a241c8ac5924c51f1d600b4",
      "source_sha256": "8919208d928f6c4c3ce5cb47acc1d036c502dddf4963cc63baa7913d4e246c37",
      "translation": "也许正因为这样，我们一下就能认出命中注定的那个人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e09c1ac220ebbbfa17dc003f8fca2da17b9c16c0fdcf9ac0d0b03df655bb3a5",
      "source_sha256": "a48a03b369472bfa75d94d97795d230aedf0eed9ad51e71118fd628b77d4a31f",
      "translation": "留给我的时间也不长了。所以，我想在剩下的日子里，和喜欢的人幸福地生活。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12188ba5cf7a357b661f1aac5a65accbee8771d7873bab5bfcb654051eac8ef8",
      "source_sha256": "e1da6fdcbb6a31e91c4f9c61f98b70650a8319d3778104a3e09430ab8e864e3b",
      "translation": "所以，能这么早就遇见阿尔戈哥哥，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a66d8892ccadb3cde5ea1bf94184a54258513fa0fca3d0a1adf8b230f6bbf085",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:09a7eeb6e85823428caaac4712f2bb90350652537c7f21156bd96f79f7836c08",
      "source_sha256": "065628bdabe3a88b966f32ad3a4e2ef645294d0708f98dcdac0808cca673ac42",
      "translation": "……对不起，好像一直在说我自己的事。心情不好的时候，果然还是一个人待着比较好吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7cc29c47363694efd4188fb4190c80390ac1bceaac60eaeed5fc38b5388d41de",
      "source_sha256": "6083b27e092fc9b338a3bdda302c18ed0b9a1c1f0a9c008865b113d68401489b",
      "translation": "那我先走开吧。"
    },
    {
      "id": "coalesced:362be89c7f4ad4556d88a24f2c7982e2645b8da2ce15040f6d30d6a1043ab325",
      "source_sha256": "1f6ca388afa505455c4fe446c1901d812546523b0880656a79e0a7e203e61ff5",
      "translation": "不，没关系。"
    },
    {
      "id": "coalesced:079f175fe633682d6066642b83f6da935e1a3639cfff134147d5473692875e53",
      "source_sha256": "3591e5439b1d2e05500126145688d17338074e45a643a8215e47d2b7bcb9c4c7",
      "translation": "咦？"
    },
    {
      "id": "coalesced:9bfda33f382a7557c62db7dc5b402eb41d41e51453ac3a4388900eeeea47f41c",
      "source_sha256": "d46855d3319e86534141f6f5d1b122ddcfff580cd6320b1a29a7e20f4d474e48",
      "translation": "现在，还是有人陪在身边比较好。"
    },
    {
      "id": "coalesced:04d0ae8166febf89ab662f8f39a3846725181ef11758fbdaf05cda4bdedc78dc",
      "source_sha256": "10bb121c6bf91cb23d8eb2824d5694f5176845503681a24cbf2fea9533b4b940",
      "translation": "啊……"
    },
    {
      "id": "coalesced:e7e54102fe5d07dde8f4a72f56f456f699e237496f9198a346152c0bb0152855",
      "source_sha256": "256904f3ddd637bf3d23080dae2be0df4ca29ba70e08873549d7d204f82b48bf",
      "translation": "那我就安静地待在旁边。"
    },
    {
      "id": "coalesced:d0a0a202ba9480c48f895a2d59465faaf796ddad4a2f709ec2179595100d0d9a",
      "source_sha256": "1c897f4a612a544dd4706f935f04df0255b732065d053d59895d997679ecd506",
      "translation": "不，没关系。说什么都好，继续陪我聊聊吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ec556796c80a88a3b57496b4b3edd0711237b140f30b84593f1d8b1c3add85a",
      "source_sha256": "92df90459aaf782fab931ecb074ac53d106451bd39e6c8147bebeef9dbd76731",
      "translation": "嗯！"
    },
    {
      "id": "coalesced:7f01d49cf06056a07830bda76e700bbbfe5438f22a8d234e5435df83976b4bad",
      "source_sha256": "9324f106c9665698ea21cc10df9f567ec4715cddc14b995e7c8cd667f56c8ead",
      "translation": "原本最大的卡蒙德采掘场，是寂静荒野的德普廷矿山。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66f23d7b6531e2a09cf6bd472f2e131c501de10540e530b2dd6b9d3713aaccd0",
      "source_sha256": "2dd06c19e6852ecd28317ff715bb1f024cedf9c63d6458404b26e70c425b742f",
      "translation": "要是没被拉提族夺走就好了……现在这个采掘场的产量不高，真让人担心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a080a4658b3d43b25abc2707c0548f514a0b25f3aa9de233e7511ba00b03b422",
      "source_sha256": "cd6f8dd9da7d04c7a335a7b50d24d642e2a31534e227cb17b17cded6b78f894e",
      "translation": "干过就知道，采矿也不是件容易的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0462c46f7100394235465fda335236759bd414c6efbf2a5e7df421f971b44f8b",
      "source_sha256": "8960dd5eb3f1b272cddf2f7705c234300f4cd75cd4759da52efc3e4891aeef84",
      "translation": "累得想辞职的时候，可不止一两次。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de8d71e8936a2caadbe216295c930a9cd15904f31047656e3998f0af091db6d4",
      "source_sha256": "f82304b269ee9483c9f3da57895ffcdcb69a4085ee2551b681e2df3c5a82d8fe",
      "translation": "有一次，我真的甩手不干，离开了这里……可最后还是回来了。毕竟总得糊口啊，唉。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9574b0b21e64e6921ba69068bfc5bf22aebf47c8fceac77dff15fcca06a9d5c9",
      "source_sha256": "94cd39a9172b98be854c769f04fa55b2433fe35e5df1a6d1ab775637fd654daf",
      "translation": "啊……我是刚来采掘场的新人。今后请多关照。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bc66b8146bbdf7042f547977e60583464ea549453a6faac9020f4d6ee3a45ccf",
      "source_sha256": "e8ce0d86030e80e7017c05c7f4c31a5ecd710f57b70ab94a291c0317110c860c",
      "translation": "我要努力学习，练出能钻透天空的采矿本领，成为兰兹海姆最厉害的矿工！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b1df3a6fdf81156faf3eab14a108e8c80faed078f84e4355d2285f481088f54",
      "source_sha256": "06193e8fc321ee84890becbbb099405a2a026f2c688c3dd5b61ab16dcd178427",
      "translation": "我正在享受清静，又有不速之客来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4e4e2e727ad479492f39af91291be4376deebf4d33975ecb8559277cad31ae0",
      "source_sha256": "64bb41ea0a6042b2834dc6c074b3e2613ca739d854c6462d727aceda4ab74038",
      "translation": "看来得找个新地方了。"
    },
    {
      "id": "coalesced:33086132c91ac1cc181c859814536597995bd0c33983564328e271796c7e3c63",
      "source_sha256": "bcca1db386042b92f970bb7f41138f43e4176f9ecc5dd6b392cd09fefb9b262b",
      "translation": "欢迎喵～很高兴见到你喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bbebe420ae39d5be1316946cb2d47177f83a151a6ef04a6ce71929d82e3aece6",
      "source_sha256": "96821dfb35e6b0540f53e4e66cb113d10dc5e0592e1f8a0e04bb3df8b7e123cc",
      "translation": "那些家伙真是烦死了喵。真想住在没有黑猫猫的世界里喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:433515232800584aac44bcb82ec7dd2e5769bb9fcd9ecbdaedc86def53d702b1",
      "source_sha256": "c6ba893a41673b614f6efe05056ac93479ea5de117691ed05de027e74d94a816",
      "translation": "好久不见喵。"
    },
    {
      "id": "coalesced:289293f35e6e027daa45e945d7272db71b3654a1bdb2cc2673847e3e15f03e1f",
      "source_sha256": "819a19e54c3e6cf0451e27524e598cede7b9bf85ce2b938358467ac375c20e46",
      "translation": "最近听说南部军打得不错，真是太好了喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c14f14bbe2e87f5a7a237d3e3145f46077243ed6fa77fb2cac1245b7d1395f87",
      "source_sha256": "85509ed4904fc485bbe25d1189fa5845f2bc35f9dd6f15c2129146f857ba7a4a",
      "translation": "习惯之后，这活儿也还干得下去。"
    },
    {
      "id": "coalesced:4763ced50880b7dc097767b6079e0907c8457df46265ec469466c79e925cacaf",
      "source_sha256": "2a3fcfe04df273805536b477e92aa73b2e19ef7da8dd2aa386fb7e8126aa6337",
      "translation": "看来天无绝人之路啊，哈哈。"
    },
    {
      "id": "coalesced:15457406af14a0055ed1ab37d7fe4286d947987bccad3d228478db30407362be",
      "source_sha256": "5e6204bf574e1da48a9b4bf0dd7437fdb08afa1a29c33d9e819bb7634587554d",
      "translation": "一定要把黑猫猫赶走喵！"
    },
    {
      "id": "coalesced:56e22117f7230c7036ca6128b89bd96eed8221c3256b6b745e4fa72c745cff89",
      "source_sha256": "36398f779e7a0d20178abea9042742f597d63a92fe9f9095caae0d9a0973a9b4",
      "translation": "猫猫的村子不只这里有，兰兹海姆各地都有喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca989883d6d72983cea5d2e390274e5852f641a9161d24c00e6f168633906ffa",
      "source_sha256": "0979fabfda373945ec00a038c93792926e29f4386a20ddfebe59d1fe84044b92",
      "translation": "黑猫猫是我们的死对头喵。他们总想越过边界喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4411f086c5d4a4669c4aacae95f5ad277327881b76812fdb3031e3b242ecb467",
      "source_sha256": "372847c476baf94910d1f76f386b189d70ea61ec336e2c50c6bde76b83761af9",
      "translation": "黑猫猫那些家伙……"
    },
    {
      "id": "coalesced:7b4ff2f1cae8c798754364ad7f83410dcb2563976aa22d1876eaeb846b2adf38",
      "source_sha256": "cad94e03cd7dd81bbb86c2660971cfe0b4c3ebe0105ef141f1d36c1a2cb0e943",
      "translation": "欢迎喵。多买点回去喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48522771af88c4779810d755aac0aa436310ddfa13eef6f49bbde9226c268332",
      "source_sha256": "60a4ac1b7cc46b6ebbd3320ac4dc1a829e2d94cb5b6191df97495f80ae625435",
      "translation": "下次再来喵。"
    },
    {
      "id": "coalesced:7c17daf026c4b21066aae264931ac8ef4ce117f5deb2ae898f56383b8f41ed1b",
      "source_sha256": "4c5d7bcd978424acd0c1c3b27bf209086c93af9cc4ea8bd815734130c86a56f1",
      "translation": "很抱歉。目前奉南部军总司令部之命，所有船只均已停航。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5dc83da4082422eb6a3b1874fa5072a2b37748cce3980e852ec09498d76abc1",
      "source_sha256": "baa5315184cacd52d32c9e32a2b87a8334e1dcde8d4ac72fa705fac9a64b5ace",
      "translation": "还在停航啊……到底什么时候才恢复？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:337804dc4aa756a389c20c40e366080128270bb755d3ffddbb17e50f83d9218f",
      "source_sha256": "fb41992bf91324c7d93a99d2af31b4307ee454a7d32e3ebe3b863e3f190fc4df",
      "translation": "就是说啊。唉～还要等到什么时候，真是麻烦了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f05fd4b5ce715bb185e9c1f3b142795c70266d1b0390fc46f7dfb980b5cbcf54",
      "source_sha256": "dabd3109bc83cccf2e5f49e34cc4884084b3422e152e7114f99a2729052a488e",
      "translation": "我听说，风息岛被北部军占领了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19f61be028fff9faf5770c7485cb315b3b3e30df4d1fc325364a43f5a09846cf",
      "source_sha256": "2a2cc47d3a437d2dfc86eee88c1f6cf566edd72bbdd1972b3cca6e75368cdcf3",
      "translation": "我在那里的妻子和女儿，不知道怎么样了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c648287f9720a799c0b51e3090d55eb57a2e0525993a5cc4141d18aaf9c958fa",
      "source_sha256": "359feb928aa087eb74c9c3cc3a555ed5a94bc661bb38b3a8cea52d523a319f2d",
      "translation": "会不会是又在执行什么作战计划？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ff7f4e83c78a1162995cf5c214ca22c3d2f058374b89de3b92d693480d6bda2",
      "source_sha256": "52a95bbb0c340e9aca5ac8a4ce0e2eb98ca983df04e6fd1e5dfcf1aa3381cf5b",
      "translation": "当然，是不是真的，我也不知道。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02d1e02f3fc440d3dfed4b6dc6984195489f0494ed75ce4e60caf44dc3c08cff",
      "source_sha256": "ac64b5878f51f6afc7a3600949bbc99dc0248a19f52f8251c4a8e1ebc12a92a9",
      "translation": "都不知道已经等了几天的船了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a1c75eb6957bd5c418f5b48228e5425dba48dc12db9d7f6c37c3e6d99538a99c",
      "source_sha256": "512e0f54e912a52b9ed576701bb6f1df05ca30bde97ba735d75bdab19f7b8b62",
      "translation": "生意实在不怎么样。要不要换个地方看看呢……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d2a7f87c1a394a1fa037516ca780e0d26e762fa3e6b6280d0b9fcbdcf98da3b0",
      "source_sha256": "12af31e13d77b8619fa78826538d047a50c3ea59443f54ad17cedd3520af511f",
      "translation": "阿巴泽特的生物学家"
    },
    {
      "id": "coalesced:9383637e6035f18e88b011119fe9722bcc936454fe419421d9c1522c58ea8dfd",
      "source_sha256": "22b86a862400ebe3e77553e6a5223e12b26a9ed6dbd7aca76926681474c39cc4",
      "translation": "请前往阿巴泽特入口附近，拜访生物学家，了解应对拉提族入侵的方法"
    },
    {
      "id": "coalesced:6f33b2d9ee02a7941bc83e1107cd1026719353f5b447f1620472b32f3639c3a9",
      "source_sha256": "2e19c31881e4f10dbd91e34e750c40fce1825b516120952fb3775b9e66971772",
      "translation": "多亏各位，我们才能击退拉提族。"
    },
    {
      "id": "coalesced:fd42d8423ebe1287a5d53951d161dd9538ba96f8949937eb5bfdd736bac28c71",
      "source_sha256": "0c0ec858383c24858ed1997a5792e41de3299b44efe562169e25b50eb4bd479b",
      "translation": "如果继续放任拉提族不管，今后可能会成为更大的威胁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a127222b50963877513da488d6a59130f66e7a9c9f6f7fedaecf5ec646261779",
      "source_sha256": "0b57d5240837e50966f61546b4048728f3aa322c2043613c82a986505d1571c8",
      "translation": "听说住在阿巴泽特的生物学家，正在研究拉提族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d481b31f719075d22b70ae59910751c1bd2b97f987453388249484b45a658079",
      "source_sha256": "0dd870996f66ac76c6ad1b1fba50ed1526c77bbe7f9517a9b7faba10f454e222",
      "translation": "请去见见他，讨论一下应对拉提族的方法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b54b0799966c3d0fa8146a30dac6ec4cb6016e5f0a1566ba1fba44cda13ce974",
      "source_sha256": "ab1345d9bd633a1f3de42df35ef4f8ba8f3bdb5bb9c6c0010e3931c646567543",
      "translation": "那就拜托各位了。现在必须尽快想出对付拉提族的办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96ce92d403931e557e941374bf1ec3e50b3d007e65b7bbca74cecfd9c041ec75",
      "source_sha256": "0d07975d45c1bd832727021fdec9645920a7c0036b5d36c901c6c1e0d796ec85",
      "translation": "要是继续拖延，将来一定会酿成大祸。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7175c2971bd8cf16876741a760e380e642db05fa63f50c21a4c20ed9f81f33d",
      "source_sha256": "588067c86856d1bd08a267686afc572d1bf506972d228e0e0b8a82628b7b9b53",
      "translation": "生物学家就住在阿巴泽特入口附近，去那里找他就行了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b53b94f52bd5bebc69b8c3883aae9914edcb8920f9a6540b0530f063949ae8fa",
      "source_sha256": "6c47ccaaa1e41640ed53745178d8628b03b918cc0775567e1e1ed1a49b0d8d7f",
      "translation": "你们想了解拉提族？"
    },
    {
      "id": "coalesced:3096058771c9e2e0d9feff3ab00af0f514af65bebf7a7c28c5958bdf1526edfc",
      "source_sha256": "cdba9daf7700094e21608820adb4f22b3858bb64c5e85ad8d0d1b4a40988934b",
      "translation": "递送古文书"
    },
    {
      "id": "coalesced:6ae62d2982b9f0dea68878928d31242fe892f871b89b1229bb9b2854f113bd86",
      "source_sha256": "2fd8cd8596eabb10c19adebb99205b10094e9bb72ed24df20d7ce877cfefca17",
      "translation": "请将从阿尔斯处得到的[古文书]，\\n交给阿巴泽特的生物学家"
    },
    {
      "id": "coalesced:c47b841c756d1793bf2483763c3e9a9035ce20a60a2681610c5b39daaef4c232",
      "source_sha256": "f5a597f26d43710cac4701d3877d2aca35ab54c748e91f9adc65977235637588",
      "translation": "是父亲让你们来的？"
    },
    {
      "id": "coalesced:8ea992167c3ce5f4fc10c7db0aa18d332337449fc21238c2c6116d58d79f2886",
      "source_sha256": "96bad1c3d330a040ef39235187d9195240319c0a436e71837311bdf082cb4d5d",
      "translation": "他说，古文书应该在你这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:26ab2d10ede23be8493bb3d14920bb666e4cc45c744b23f5199cbc42fb21cce8",
      "source_sha256": "90200cdafda993feb499e75bbb0d6c4a42f75c59f2c87f930b5fb6cbbffab09e",
      "translation": "啊，你们说的是那份文书吧。就在我身上。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d50f3ccc5b5fe04ca98030482abe421f4b3df217997a27fe5632fa00c187e778",
      "source_sha256": "dc49fd8933695e6f63b0027eb89e573c8ad6a96015d1d4fe4850a1c5cb7a0742",
      "translation": "特地来到这里，看来是很重要的事吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e6bd44414d6f7086bc57da81ba77d7f2beaa22eb43aa0a21a34ca5f65ea58def",
      "source_sha256": "e0d95df307e1e2ef41180d9fddc66c6153a6437e2e0fb724b8cf73cc2cdda040",
      "translation": "都特地找到这里来了，难道不是很重要的事吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5957cf11d157335fd7f164420400e75c43a1912e1c512a250c776dab8729e7f2",
      "source_sha256": "b8a50581e814c89ab4346c0c641ec967705199553162c44a9cd05261269714f7",
      "translation": "请替我告诉父亲，我一切都好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d64bf2df30ccf2be9fa2c81dd81552fe34c070dae0eee714f6f555c983e4b66a",
      "source_sha256": "d974e1e16c99958231e83fe56e7e72ee857519a1642f73a24be70b40db788033",
      "translation": "讨伐科洛瑟斯"
    },
    {
      "id": "coalesced:7e1b49f4676037ddfdd92cea99faf2fa2fbf6d672efd827075a52d56dae859fa",
      "source_sha256": "21192f953bbf00253e68ee41464fdcf8253bb4e53251a4adc3ca8b6bcd84b0f9",
      "translation": "[科洛瑟斯]挡住了要塞的入口道路\\n请击败科洛瑟斯，进入黑刃要塞"
    },
    {
      "id": "coalesced:f145ea81ca1cad317449529b07f614ff96407a2fd4fb2a292807a7780d93236e",
      "source_sha256": "f8e2bb6ed4e52f081f41761ade31fa6f8df1c5a1c40619aa918a3db234921b94",
      "translation": "既然已经攻下第2哨所，黑刃要塞就近在眼前了。不过，目前通往要塞的桥，被科洛瑟斯挡住了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6a1798a854ba8b05635e8e77c55e8ef543a43cd337f68746905f106f2734df6",
      "source_sha256": "78807a2273f77b413f9606ff48e52e49aee6c537e17d4477427365412575d1d2",
      "translation": "普通士兵根本没办法对付它，恐怕得请反哨兵部队击败科洛瑟斯。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7879947c45bc45b17d5ab6b044818f350135c7935ade8e513c6bf2bdb4db889d",
      "source_sha256": "ad66e7d4e3745e0b996b5cb1b0dcc36096f3d87c7fb8d35a0286ea098e2797b8",
      "translation": "拜托各位了。"
    },
    {
      "id": "coalesced:bb8a8fed611c8d8dbeaa8e6e289c2c9e285fe6d9f8fd515776a4904ab006f640",
      "source_sha256": "5ef2d3cf71ff8ae99ddc4994819b28700372099ac271d3d7e096b8390ff681b2",
      "translation": "再拖延下去，可能会造成极其惨重的损失。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6e4e27fb2a9227310b0566a3a59dc525da6f539c35214eb8d970844ed5887f34",
      "source_sha256": "2e211053acbf11c8bcfad3246d022cba7b463de151a5a24b3303c99ec7778638",
      "translation": "请尽快击败科洛瑟斯。"
    },
    {
      "id": "coalesced:bd2058c212ab51e237e660620ccfe7a5771ecba39d395437a077263361077cbf",
      "source_sha256": "b7b3b3b3eabfa3b5c1aeb96a74a92301cbd4e69cd13c115619a2195e470cbe36",
      "translation": "这项任务有特别奖励，击败科洛瑟斯后，请来找我一趟。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b48b92ad07a98620c0debc5f2f5e39ddcf0cac44d26194be171c1ccfc36a9e15",
      "source_sha256": "1f6c668d12c4ff36684b64683afa6f200e5caa691901d1e6e10e1b6d35cc588b",
      "translation": "现在，就只剩下黑刃要塞了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eda3ce95e6e839bf8bd52a3879d0d7ca5b5b773eac984beb802b214c1b737d46",
      "source_sha256": "1465bf8f9064316bc1a89b62cc73436eb5faa22d71df8311f9d10cde0b7e952b",
      "translation": "QUEST%s : 击败科洛瑟斯"
    },
    {
      "id": "coalesced:41d1410fd7f181ea5366977d4103120b48861ae77e96ee63860238285a564ec8",
      "source_sha256": "d974e1e16c99958231e83fe56e7e72ee857519a1642f73a24be70b40db788033",
      "translation": "击败科洛瑟斯"
    },
    {
      "id": "coalesced:7d4a118589067515166cfcfa39740e01054676e6c57aebf6222dd5562ad2a954",
      "source_sha256": "92f27c8b7f3fa0c619c3ab7448c1de1e6e01c3a518729302b9259e67a1d612f4",
      "translation": "生物学家"
    },
    {
      "id": "coalesced:6029ff9de9b1b89482c2660bbe75e4477b0a9dc6aed4d924a3803895edcbb35b",
      "source_sha256": "7ec1940ed9294d7154fce46a0d6e28645afaa2aebd8247b3449199199c54a568",
      "translation": "古文书"
    },
    {
      "id": "coalesced:31c3d6ada197a771b7bed9eeda5817ec216a74797f2d05fe69312cdd26d5c165",
      "source_sha256": "f024e6717cd5499dcc6a27ddd38f26943ecf59d4a362e064698e07a1ef548d5d",
      "translation": "记载着用于拉提族的药剂配方的古文书"
    },
    {
      "id": "coalesced:27b8b7a72de121f4a93037b5cdb85f3a5240e57a317888b43e4c39c3fedcfec0",
      "source_sha256": "25f1f1af132241a35992e0a5d00496ae16486ab6d0456b447e65e0d468c39511",
      "translation": "风息岛"
    }
  ]
}
