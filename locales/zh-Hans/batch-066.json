{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:4d8da15659852357621c10b72d693ad0b33c91427b068c8f9194d2d34d6b4623",
      "source_sha256": "0c5cb9bc7059c0d4cf15d52a03811bc32c4572c20997b82629ad43311e8e52df",
      "translation": "终于到了。请稍等一下，我马上就装好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bcb019956efb0531801441bc089de4b64d734dc8addd2a9c093cb45804fc58b",
      "source_sha256": "9bb381ce88c984a05736b827692c21d25c95158a9d43d72315001ebb4747dedd",
      "translation": "让各位久等了！终于准备好送大家上拉·斯特拉达了～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9922a89050859e335c342bfbd2cb5e7dbb5b66dda54d8fb67d7988df57a4b49",
      "source_sha256": "05662348c4a10f609dfa2db6d311db0b34d1741a8ea1c0f4fe443a27bad2a30a",
      "translation": "啊啊，真像做梦一样。我从没想过，竟然会有这么一天。能遇见各位，看来真是命运的安排啊～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d08dfbb62ee341dc541d8a0167d226a247c0295ea099f217057666f03dfa7aa",
      "source_sha256": "50d59cbec76758272bc3f4c6cb50349b76da2a72197931c005bf6f86707a3613",
      "translation": "就靠这个？真的能去拉·斯特拉达？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a38c8025c1c2f3e5619d0aa96838905b700e33da1c49be75fcc0a627b600698",
      "source_sha256": "2d282d06b3436b1fe512d63176af985b79440da443772810d6c8301dbfb69799",
      "translation": "当然了。这可是我连睡觉和打理羽毛的时间，都挤出来才造好的杰作啊～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f3cb9f79cb2c3f8f49ea6efa92bed8f0efb9f0d38195e043097255e5d81f6d5",
      "source_sha256": "458de848cfd2c93f760209ddac1fdf9a611e9a8a6ca2f2ba1e1d7368aba77d7d",
      "translation": "看起来，完全不像能把我们送上天啊……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4c5c182b7c821a7a4972281196a1a9e698b126212e6818f957a7b377e297793d",
      "source_sha256": "61ebb484353f954e5cf9d7a46fa22a593c9f6104c6f5a47ce07c73f52aa16802",
      "translation": "该不会……一不小心，就摔下去吧？"
    },
    {
      "id": "coalesced:6528932e979bef696b5f9e2a79000ce339c7ddbc590e76c8d97a39d9795d777f",
      "source_sha256": "31169014279c65ca169fd339e7fd4bdee825f34f1c64bf3ad317734b4b6e2a76",
      "translation": "啊，我才不要～～"
    },
    {
      "id": "coalesced:ebcdf4480a618fe316a0249ff5bb77dacb8ac8c14e4cfde4150fc4e10bba5f7d",
      "source_sha256": "f1ceca7ced30d489e487f06c21dc3599b177238bdc60ffea0ab1a179c31bb884",
      "translation": "我还没嫁给阿尔戈哥哥呢，才不想死……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:900b7f74faa1c752fc5b551fffada43a556f6ee8c2d2e8499cf7073cec9b98f1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f8d299a56e4aff4bb1992e6bae3cc17a2ea5e5663923a52a8be2da2fd96d1bf5",
      "source_sha256": "4b4bc3ca43d524d33103c53dd960d270cdc91695cc1fa0209e7e0ab5d52c17ff",
      "translation": "别担心啦。总不至于死掉吧？"
    },
    {
      "id": "coalesced:1311258fc25be5862b7a2626a44a6036afd152498b9d3cbad0b5684b22a4c84a",
      "source_sha256": "a276940b77d5ff2fcee074b1ff190590e15808aebd33e0393ef77cd34ef0f18e",
      "translation": "伊格顿，可以相信你吧？"
    },
    {
      "id": "coalesced:9d305ab24e7ebee4a28b603fb5ebe9d47e775014313f00b42ebdadb36c373c2d",
      "source_sha256": "219012c08954dfda8343241ab4b1243e515c25d5ba8bb12ea07da881218dfa84",
      "translation": "当然～我可以赌上自己的尾羽发誓。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52b5312d7064f39b0032da38bdde8c7432a24cb0212a7d68cb9a81a5b740d91e",
      "source_sha256": "f643b9881994e2f50198fcfc14dca0dd12809e9f5ebb9621a1904df2ced2bc40",
      "translation": "尾羽……不是每次换毛，都会掉吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:86e172435e6c6802a849a6a5041861a1aca91ed50a4f8a218a2d83344b3cc67c",
      "source_sha256": "d4d0c192f90e7c91c7da23f4d8edb116f1c387215a52cd38ce160de6e37141a9",
      "translation": "哈哈哈哈……这么说来，还真是。"
    },
    {
      "id": "coalesced:a775701ee27c75f6b8fa8ea78952f53b332e07fe37d85e42773fc3e6a95ea6d2",
      "source_sha256": "e1e58bafe0466b434e1f7a8733817bf4d94713865ae10f972d6bf064e94cd05e",
      "translation": "先相信他吧。伊格顿可是倾尽全力造出来的，一定会顺利的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5bc3357f7d60a19092d2bd6120a9260443b9e48fbbaa2f2773150283fac685d7",
      "source_sha256": "8246fc6fa22cd6474f67ce7420df3a0348a04f142323ece58b88a737169cf318",
      "translation": "果然，只有公主殿下懂我！我伊格顿，一定会加把劲，把各位风风光光地送上拉·斯特拉达！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:99dddf40a2d6069573a4ed38fde24cfaf2ab4eba45f8bef8704064d9d6bae5a8",
      "source_sha256": "20dca125e10c86c39dad5302424a98e0d1bcc4ac34c5e8b2372610967f59d054",
      "translation": "好。那就期待你的表现了。"
    },
    {
      "id": "coalesced:4b4e9dc84fad773e8612e54c45eadb28d31c8e0f315cb0cc94da2dc52400deae",
      "source_sha256": "7f63cdc872a489bae1eeaddad9e0984aeafbbe7cf9e9b20462f3493a1d3f5a35",
      "translation": "那么，各位一路顺风。"
    },
    {
      "id": "coalesced:fcbaa3dc22122179a124b3a2c1cba1d72b42c35625fec8d23e968de3b6bb89a9",
      "source_sha256": "dae79a8f24672827facb86a2ea5dae34899c01394e6d966781ad5549ff4a07a1",
      "translation": "咦？伊格顿不一起去吗？你不是说，愿望就是从拉·斯特拉达俯瞰地面吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1593da96038f4a0d20b77a05d6fb1f926ddc5f9436c5fb8d15f564b646f43167",
      "source_sha256": "ced974ccf6166a8a3ccf99a08075b4ce45bb964ae760a607bd3147fe12dcddcd",
      "translation": "这个嘛，其实我也特别想去。可是，只有我能操纵这台装置。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5bdf0b797f4034b44a2acabea21d0ecaeee033a579b3308c3c0ee3958ed637a2",
      "source_sha256": "5bebec3c8c91e30cd6248ab0619f1a48f9e3777521522ac7784bc44e4951f91c",
      "translation": "而且，也不知道联合军什么时候又会攻过来。"
    },
    {
      "id": "coalesced:6b11120ed40f5cc74b08b96bdce416621aa7515a79fec7a7585577c29f39fe72",
      "source_sha256": "6fad6898379c00c8a375f92a6b93102726cbc47c099e5feea7c44cabce0c0821",
      "translation": "在各位平安回来之前，我会一直守在这里的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba4ddf8dd2a25cac4235ceaa4a73cbd3a1e648617f378953b005fdfd57a45d54",
      "source_sha256": "f995b706c380ca9874fd5a1eb142d63d79aedb936b9672693f193141c22b4c76",
      "translation": "我还带了好多地雷、炸弹之类的东西呢。所以，不用担心我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6bf712acbd5bb749ebb2f1acc91615c900db3091b8a7bcfcbe8200279333b3dc",
      "source_sha256": "af13ad1a82ea418da8008ba5f2b2c98f51c4644450a0ff459647824d1680d19e",
      "translation": "伊格顿……"
    },
    {
      "id": "coalesced:13db6495367c7c2b38716eb1bfa9579444594eadcf75634ac52c816028cb372c",
      "source_sha256": "42fb3f2c218c5ee244141c2171e1a335c3ae7e00c6d87f7a6967576e2ece80dd",
      "translation": "没关系。各位能代替我去拉·斯特拉达，我就心满意足了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93686da30b12196a03be29571e6812001382558cdf4c5a8622725f3341580fb1",
      "source_sha256": "d419236aacdd485ca6557b2d544a8c22d3cd6476d932fd0f9ea4cac26f6c3153",
      "translation": "那我们走了。你一定……要平安无事。我们一定会回来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a98f034d91d2d1b7f4ed021d4b2000ee0aa32e3fb2b400597d6ff1ae41e855b2",
      "source_sha256": "f42cf0f023349e8b2fee7853a3d1e97a8e59251b0d2c6f837545fedd69207aab",
      "translation": "嗯，一路顺风！"
    },
    {
      "id": "coalesced:93993c5a6da412e285e9ae284772b75dc8c4c683840c7cdf1489cee359c556b7",
      "source_sha256": "4b43e48a7f80e800d564b9b47ddc7c38557dec94491eaa0ff49abe0c175b8502",
      "translation": "这里……就是拉·斯特拉达啊。真是个奇特的地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a28606465efd35efc1dd8b8f6b0eaec18537482280b6fd0b83fe218896fedbf5",
      "source_sha256": "c1804edb3e275e4d5622fdc90bcceb94085d8e95e645411f73de16194941fdb8",
      "translation": "小心点，塞蕾丝汀。还不知道，里面会有什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff2eea02b4fb27b04a7c6c7517db51f391e0500fa000c8b620830352c90b52f0",
      "source_sha256": "27f1e533cee6b2e65720dc78c2bc6e3efae0bb7082e95df26c74ace8ec1288ee",
      "translation": "哎呀，哥哥，你是在担心我吗？真让人害羞。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c88cdaf67e377234363124d050867f7c2fd2d2c5fabb72448493a76fc01d16b0",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:7baca8870bc1a932e0d7557a68096f265feb96e83d80d0390e7b68e3bb1ca078",
      "source_sha256": "765284af5c9d8e379661af52bf8a445b2f559aae719fda9f6fce70ef5e89fe94",
      "translation": "真看不下去了……"
    },
    {
      "id": "coalesced:1011c30e607c2da102fcf4fac59ce83d910306aebf990fc41d71612b8b2cc960",
      "source_sha256": "3c7d76a6cae2eb4c226c39bb550e5aaa6591f7b0503cc61f949724b01fdb5869",
      "translation": "没想到，竟然会有亲自踏上拉·斯特拉达的一天。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ccabd3c7db1bcadf443d2d1e4a9d4ef996188a51bc531bb7762d2194cee32f16",
      "source_sha256": "9e9e4ae8d858a949a1da83cbf3f06740a7115d31f09cd356d9d6c9a091429515",
      "translation": "我也从未想过。"
    },
    {
      "id": "coalesced:341567fb2e17ba2117c9658d37e059cf028474df00f215a6da94e974292a1d1d",
      "source_sha256": "d934dbe9e439dae1581edcd7af86528c2be18b2d462b8b91a51b0df2858074dc",
      "translation": "里面一定有家伙，在等着我们。就好好给他来个见面礼吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7a1d48650cbcde2b3baf86298ddd19b26dcff02520fcde26b12ec464bb2849b",
      "source_sha256": "5b1897452191e4e88302c4e8c0f5892db94e9d6627ffc243e791620feb3b22bc",
      "translation": "我已经改造好了，让各位随时都能\\n使用传送装置～"
    },
    {
      "id": "coalesced:5fc5a7144612ba2929585517fd51d45939a15572d602c1c7d682a19d4ea24ffd",
      "source_sha256": "961c976eea7cc41ba24de550879c160147eeb892f27a50ef945c4d08ffa209be",
      "translation": "我会守在这里，\\n各位就放心去吧。 "
    },
    {
      "id": "coalesced:d3a5c3c550c1ee4e725b2b3a91f27a4000ee7d2e63edd47076c08443420e43c7",
      "source_sha256": "a7a19d12ac4fb4bd660e2908bb90507a7f44e780874aa4cd33dbcfe557fb8a15",
      "translation": "不用担心我～加油！"
    },
    {
      "id": "coalesced:d46c1ba718cdb8a357b48024c6ba74f1adf9ee78cd75a5a71f30cff5a1ddc703",
      "source_sha256": "07b494c490e76f5d0a53e5a45c1c292ec4cfb9833f9f89c44755aa392fccc587",
      "translation": "各位准备好\\n登上拉·斯特拉达了吗？"
    },
    {
      "id": "coalesced:8e3bef87812e6b2806c62b5cc2afa1bf416fae10cf650665937720d8fdbb3025",
      "source_sha256": "485c6c3455eb7e98a5e6acd3191e46df5f7e03d917245ef4263f56bc3d95cc57",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 出发\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 还需要准备"
    },
    {
      "id": "coalesced:35e6f2a2c0e31ec427b474c82e8fb19f489fcd1eec6cee7ff876713a8c058655",
      "source_sha256": "29ec2ad158af647e3778bad69fee10289f3cbeaa40d5fd4b47fb4c02cd139a04",
      "translation": "上去之前，有件事要告诉各位。"
    },
    {
      "id": "coalesced:972582cbc2ade4bb47150aae02bbdfa2b0f5a894841d2b9183bea0aaa0d23952",
      "source_sha256": "830074bc60eea5c7c7aeb7f0b2417cc5658cc7a4293b0a17d831fa5ab0380297",
      "translation": "有了传送装置，即使登上拉·斯特拉达，\\n各位应该也能\\n再回到地面。"
    },
    {
      "id": "coalesced:46e4b38315309507280ceabda315076d21c84791dc513951656d135c5895ac21",
      "source_sha256": "5ecc911ef195d942c8104ec7c13e1ea2f364ff73f66133c77ca8b4150e179f1f",
      "translation": "那么，我要启动传送装置了。"
    },
    {
      "id": "coalesced:e036561e9dce47c0cf7b63589d3e0013e26697c3a57a648d23cb0c65a86f8f05",
      "source_sha256": "5fec968f2c2e378af1dbef98735e9f00794db48b7a6eb1199e35dc047a86fef3",
      "translation": "我会在这里等候，\\n准备好后再过来吧。"
    }
  ]
}
