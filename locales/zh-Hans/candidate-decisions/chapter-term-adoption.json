      "section": "CSMB12_131",
      "key": "voc_csmb_12131_14",
      "source": "자, 가자.",
      "source_sha256": "e577140e31a8e164e822ad8fcc8e605bc708b166e1e2f0b8797f95767ccbb820"
    },
    {
      "disc": 1,
      "locale": "int",
