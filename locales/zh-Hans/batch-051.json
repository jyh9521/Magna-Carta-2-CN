{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:ae6398fc3ba224a31b9de3eb98833e92561d7ac40c98054eaf4dc5a17fee7acf",
      "source_sha256": "cdb7dbad4e31dd86223251cc50b614a07084b4d293c8a272c1eed9ee69181eaf",
      "translation": "修恩扎伊特……你的鬼话到此为止了。"
    },
    {
      "id": "coalesced:9d0bd3dcf627f66a0621a03fd9a4b82242e188cd236247ecf93ba6f34b6c0c28",
      "source_sha256": "806c9c82ce43f2a8a212159fc021b445492975035a6d9e158a2d819b89f64b53",
      "translation": "绝不能原谅！"
    },
    {
      "id": "coalesced:d8aa221e6e76131cebab32cfb7b2395fedbeea0192d0ccc91d856a687d73a198",
      "source_sha256": "71b3b983284899533b8d1500779b17860eea94867232b966c3bdd0fb94a12b39",
      "translation": "明明是他们自己在策划阴谋，居然还这么恬不知耻！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dde623fd92219a9298e48bf9eea894428d9bb0e05643fcea6b1244122b22b6ab",
      "source_sha256": "2a0b13a0eadae024261186a64ef2d0f2a6c511d0131947d08e7c1f0901b99cd1",
      "translation": "我快气疯了。现在就去，对吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48a7c37a82e19570fe011e4f040c91b1e3dda29d1b0630f2d28aea49f657367d",
      "source_sha256": "d9bceb99de90fca70a5ff5bd98e72f32c02058731122d97d251bc77cce651c5a",
      "translation": "当然。这一次，我一定会救出洁菲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f79886e5e636f595f6ad17078b1bb3e70eb47291887ccb8712a00e032f1e6af",
      "source_sha256": "fa59edd344f8350f433a2075645afc2af143c7a0f136ea43255aa39d5712ed1c",
      "translation": "嗯。走吧。"
    },
    {
      "id": "coalesced:20c856fb34f4421637ffa56b11b1115e43351da41a4acbed340a59798c7df460",
      "source_sha256": "eb95c7b1f03c43234af0f5e9ed937828c741fd63ffd388c1eb6bd61197b43f55",
      "translation": "你……这次没问题吧？"
    },
    {
      "id": "coalesced:bcf5729dcc4e7e9c49dbe3020813241c65dd587246708df344f82aa2a7b2ab85",
      "source_sha256": "251778adc1ba9c88d8e138b6dd8954468f384f36192b7a866646d79848c84842",
      "translation": "我绝不会再受他支配。"
    },
    {
      "id": "coalesced:146c49689a9cb4d3e07587fedc99e9a749bd71ac8eb1bdb4eef4270090917f20",
      "source_sha256": "65e0bc35c1fcda46db292f4856a8aeefa6515171cb8408bb65e58b41de97701d",
      "translation": "那么，走吧。北部军就由我们来挡住。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f395ce76aac287fc9f0c747cfefea999492ae53a032b47bfb968d84a117f7c52",
      "source_sha256": "c8cb07639bdcb66c27e78b7b0be3bbea40b06f2f6c42cf1901de438c60f673b3",
      "translation": "要救出公主，也只能相信你那股强得不像话的力量了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c93a3eb7bb2a9d227369d31942465b65c04dd64de4baefbfbd62033eeb2da663",
      "source_sha256": "20a4f3e14f2053dfdaec1794f334a5409f589e5876a8c0a8c36bf5bb7e18f9f1",
      "translation": "交给我吧。"
    },
    {
      "id": "coalesced:2e7d4f175b87ecfbd9c817916201a734817aac448cf9c204350bf27fbf28bebd",
      "source_sha256": "5db6448831bb50f2cdf0cdca4c14cdfb1c338c6aa40d8e7627885232353ab373",
      "translation": "怎、怎么回事？你们要攻击我们吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7b03f3b1f591dfb6c47ace87b159820664648cdcb31fca4f17a70ef0f88f102",
      "source_sha256": "265018b068f4b2a6a5db0d0f506478e17e0db3bb32bf3a10deb76ee861e41cb1",
      "translation": "我们不是来伤害各位的。我们是来救公主的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad3aa459fcf8ce5e4dbabbd866928191373dfebd1f36e707ef9c4cffb4e7150f",
      "source_sha256": "21c10a9bcfe3534c672f44714957fd6b1e82fd660e6e9ed63a1b641472cf0bda",
      "translation": "公主？这么说，你们是来救那个肮脏的魔女？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:147287e11a21b4d9ce6af21d4147960085f3cd859359e4aa4a671768c1f4249f",
      "source_sha256": "47d7befbfc488eb8c691e17560ce04ec418255db759390e348886b3acbb93bb5",
      "translation": "呵……终究还是追来了。"
    },
    {
      "id": "coalesced:0543852126582481e867a0a22a36c38e9d324b1dbbaeb5b8165c9f4158aa4bc2",
      "source_sha256": "ecd6df6d2418629b79650d4be612ab53f6febd7e7dd599b921fde2a19560a81d",
      "translation": "让民众避难吧。不能把无辜的人卷进来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a7d1436856dc6a3d75a154b0a36ef367fa27ac92fea7af243b4bc567b3a509d",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "遵命。"
    },
    {
      "id": "coalesced:5aec81258ba8e5442924fb99da1c7f509071ffef063de0a20da0247869d4fbc5",
      "source_sha256": "2288eeff6713dfd85ccef0a4dedc71eae7771b3e3e394026f6eef064fd3f9c49",
      "translation": "这些人是魔女的追随者。请各位避开。联军会保护你们。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2847202205793face45452849d0318613d544ebc02e56813b252eab595a25cb6",
      "source_sha256": "98d72e445748078ab1681d1cc343ce8d8a6c589118447fd5afa0d14b315a32c4",
      "translation": "来，大家都退后！军队会保护我们的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f84425e6d7f385ba825e7e10e9d222c405da5531cfd57143f3a5f50194ba64a7",
      "source_sha256": "d7ca89e94bd51143d73e5a81c556f76883afc140bcc2368751e6d864b5b653da",
      "translation": "居然来救魔女，你们疯了吗？一群该遭天谴的家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06a1ddc6e320b9204369d37fe6872b34dcf6f9525df19085baef95ba33eeafa7",
      "source_sha256": "e299f096e6ef14b2b8c4dc9fbdbaaeec58c38e92bb8f2aeb9f42c110b7f1be7b",
      "translation": "亚历克斯那个混蛋……"
    },
    {
      "id": "coalesced:97d6683f164f629e998d225f0b0b6f7b9508b515788815b637f7bdc540ff0cf4",
      "source_sha256": "f046f054c15e3fb12de0ea9431a2dd6576b048f50deca589cd27ec7fcb794e51",
      "translation": "居然为这种鲁莽的战斗拼命……就算救出公主，也改变不了什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ef695bfafcc26dc19f4809ba2d011fad02e027f66f89065884b1a4078793735e",
      "source_sha256": "0017cf58aa43dff59233550552b25a5459f546928228de09514a3813eb996bab",
      "translation": "看来，只能对那些人动手了。"
    },
    {
      "id": "coalesced:9c22297299c156994ef05955c729f0bbdc81b6fd8d4f2fdceab42ddf6c6134b2",
      "source_sha256": "818f88276836b1014f7ba002a9fc307ebf62cbfb43ffe96de1391650d74241d6",
      "translation": "没错。祸根还是及早铲除为妙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8656cb1787fbc784da991a8731015f20a8baf8e170b48fef16ac06eab9a40d10",
      "source_sha256": "942d7c1b33f40c03ae16635b1ef83eb556bb3619197b57391f0663568bb3f473",
      "translation": "攻击他们！他们是邪恶魔女的走狗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df74c881ddab0e0e9fd0d1df385fe7fec5c1a9926e45cc84e1eec144c3efcca3",
      "source_sha256": "48d51bbc4cd9256406ac3cee0d92f486137f9bee1eeac5f0263d256e781b7ec6",
      "translation": "唔……"
    },
    {
      "id": "coalesced:f84d15faa1bed55c6e066e08b811c5ab770be641d52bac6543f17a118ec0f567",
      "source_sha256": "3d1701ae41d34b133ed6b9153217106cce024385a8886e1a0259377a7266048a",
      "translation": "朱特，你没事吧？"
    },
    {
      "id": "coalesced:53c810562e140b47e76103c63a3b1e5c66ff8ed0255c042d373c5ec34358d605",
      "source_sha256": "77e01cf969956c7a6095a910e15670ba65b2f9bed7e83b886db18bde1b894442",
      "translation": "嗯……快走吧。"
    },
    {
      "id": "coalesced:771f2d66a4a697efa2c05c1ffbdb6b0388bc2920c9413b8ac4254d96fb7ac2d8",
      "source_sha256": "42af463264380e93b48f29d73cb29bb275a85fc394f99ae7044b7d28d4751bbb",
      "translation": "可恶……该往哪里去？现在连南部军也是我们的敌人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f882406db0eb093179002055341aa4063cd8e80e8eeeddee691f3fa284051cb",
      "source_sha256": "04bb0f9a91841ba065d4411d73ca7b37ce76726901314b9097b79f195d0b5559",
      "translation": "看来，已经没有地方可逃了。"
    },
    {
      "id": "coalesced:49788ebdb62eae164a3653899b330d6dba05cae41392ebc8685ec77d6ca22c30",
      "source_sha256": "d6351281c6d8f2b0b032c39b5f0660462286653a5103ba856eec7f45a6e5eb73",
      "translation": "那就去我们的村子吧！"
    },
    {
      "id": "coalesced:4a340d5b0513eee7945b48b3676e075d60d0aa357e1d7659bc42f125e6155ee5",
      "source_sha256": "76bab0e1ac6cb8de3f1721a5eb829952ecb4b1a493a16ef2f176844bb32bfd5d",
      "translation": "去柯塔马雷吗？"
    },
    {
      "id": "coalesced:faf5369cd8931a78f33c18d46e2a297cfb26be59eded103d70fabb44e9818e36",
      "source_sha256": "6ce83ac6ea56709b08531051d4fddd0204a0cde2cee823eb210ec5522cab7e51",
      "translation": "那里不是人类的领地。族长一定会接纳洁菲姐姐的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55f4068cde002d25c347022258e78c01bc2e61292caf32e8003869e24372a7aa",
      "source_sha256": "622fc6e18cbb60ddda67a6e82a939029e1e72d77181792faffba28084da30e32",
      "translation": "目前看来，那里最安全。毕竟，现在已经没有任何人类值得信任了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8b810b41d44092396108df6e0a05a70dc0747bfc0f2eb9d85781dda76e415a4",
      "source_sha256": "369aef7c70e321521eff726efb60b3757dc274da232d6319e20e9b0195f20a1b",
      "translation": "不能让大家都因为我而遭到追捕。只要我一个人留在这里……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c1054b27bf6333edf1505aeb3e1c191331c8c4c5409c1ad737d73e4743311e7",
      "source_sha256": "96e5d821949b2ad47907e1ff69568a08521f9838fe2fb5491d71a2bfb33dde17",
      "translation": "说什么呢，公主。都到这时候了，还说这种见外的话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bb105c97ccf109ad55563f98401b6e1ae935c08d927ccce2e33f072d1c52b010",
      "source_sha256": "fb99a1fac2162cd96295aef78b732a91d08a7a9d7df07e1554030f2b852397db",
      "translation": "无论公主去哪里，我都会陪在您身边。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d85098cdb56035b0079667839f1462ea7467f537e4deffad0df865a7bff647c1",
      "source_sha256": "d17707e6a5d493d1fdd48d87fcdedd540800b6ae01f4dda497b330ecec9cc686",
      "translation": "啊，大家……"
    },
    {
      "id": "coalesced:339fce41d5e6105061c64e097eadc838c196dd1bc9f56ee21cbcf4e21d6aac5f",
      "source_sha256": "095872eedabbb7f09f2cb103f4be2969541f9d22a948560378814c9f6d79ffa1",
      "translation": "好。去柯塔马雷吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d389fef43ad9e81e7c1867e07e281a5affddcfcf6a9a63b5ef786138f6f937a2",
      "source_sha256": "4cfd21e321f8f8415f2bbe19e50b723c750ba63f9314bc033d0fdcb4df20a26d",
      "translation": "哈……哈……哈……"
    },
    {
      "id": "coalesced:fb6726397e4d3812f917fb4d7463693dcfa329ad6a84e388f5652c742f4ff5a6",
      "source_sha256": "3d1701ae41d34b133ed6b9153217106cce024385a8886e1a0259377a7266048a",
      "translation": "朱特，你没事吧？"
    },
    {
      "id": "coalesced:f1e235dc8e4f1401804cb0f823df473c599a416a192ff48acfd845617e4cce9d",
      "source_sha256": "6a113578ec6a9d984ae7400dab76906e708c643dfe4b207027bdf9b916bf24cd",
      "translation": "没事。我还能战斗……"
    },
    {
      "id": "coalesced:6e479d1d79232cae916d82c5b39ab1fc475d49d39da2e7c6b436f8b50a7e1077",
      "source_sha256": "8e7d21963f3c7f9ef8c861ff6a1e06c19883383bf55f34a3e60c4532e62c62ba",
      "translation": "对不起，都是因为我……"
    },
    {
      "id": "coalesced:426979dd92f069037973eb9d88dee51fec7f6c5577e3189093209b14416a7d9f",
      "source_sha256": "384e2933f8651a6a66b10672c1fa5c3dbe68249cfe31921b9b7cf55d6c523ebb",
      "translation": "……别担心。这点伤，还死不了。"
    },
    {
      "id": "coalesced:eaceeb54673b1cee72d6374a79ce18354d5564a9935e4eba0790e3955e673f5f",
      "source_sha256": "3fcdc0dfa9b4120d11d3e2e95187f5582a1772f76e3dbda39569ff4582c5017f",
      "translation": "看那边。"
    },
    {
      "id": "coalesced:e0e8cbc67c875459ff1d1869bc7d93831a9f27f5721f226ebf85370ecdc46631",
      "source_sha256": "e3190c698f5eba7ddeb70390fc8377e6cc3ca64732b9d77dcc6559a9dbfbfbf7",
      "translation": "别西卜的完全体吗……不过，只要打倒那家伙，就能去柯塔马雷了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:abd96685f28b2516c5371eb0f073c4af86bacac7eee3793d2f7974e118939a89",
      "source_sha256": "27bdaf69b16a418fed53d40204fe75221a9059029e8ae6ee063783214245f56b",
      "translation": "嗯。快点，没时间了。"
    },
    {
      "id": "coalesced:f1c1820705561ce441dd1980d3fe8de2991e9ead066aa7c6adc6777ff0b36669",
      "source_sha256": "48b2985abd36f3bcf7437ccc1b7743287b75c17cd18f80dea90d23caa6238a75",
      "translation": "喂，朱特，你可别死啊。为了救你，我们吃了这么多苦，我可是要好好讨回来的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13d18baf62e701361e3f7c56c7e5752ec68897599035e173cb8bc0c965c436fc",
      "source_sha256": "4df412ee0b7181c7f38f41b98b5fae65405d3d2b21ffd00810e50c710065db6f",
      "translation": "我倒没打算报答你……"
    },
    {
      "id": "coalesced:38911c3c245d54c98c28b3bb29f250c1fc45e2ec6f06e762de0431247b5b297b",
      "source_sha256": "3cd73a4bd9c77045561400ea27b841f2a30491be6a0736d4c48fd3f52613f73f",
      "translation": "说笑就留到以后吧。现在得先打倒别西卜。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91a078315445c74364c8ef0b6f407293d6f43ae055c256418fd3827aeaee3f28",
      "source_sha256": "87beb077f204b81d98ad8ec6628d7cfdf128721db5b45d9635e69132cdaf3662",
      "translation": "知道了。大家，上吧！"
    },
    {
      "id": "coalesced:71356058e0f69a460254f7a81339521b1e6f9c6b65b997d255aa6f49d5419c27",
      "source_sha256": "07a2afeb04ac0d5b7ba2e832e880352906432011c3f40e80ff2f6fcd285fee8b",
      "translation": "好，这下就能逃出贝尔福特了！"
    },
    {
      "id": "coalesced:e58da01902899583282984ccab98ef6e28ea88a3191007a4207ba9c2be089baa",
      "source_sha256": "48d51bbc4cd9256406ac3cee0d92f486137f9bee1eeac5f0263d256e781b7ec6",
      "translation": "唔……"
    },
    {
      "id": "coalesced:c8efe5382d765643358e30268083397cc111a4c6da77e96103e76b9866cc5608",
      "source_sha256": "d9414b5330e3bc4ed32df8b889750067931b9a16d4e9f607a6779cb4e748c5f6",
      "translation": "喂，振作点。"
    },
    {
      "id": "coalesced:ecf9b7e90b6e5caf623be5ac6a5a7efe6d21077258ca307228cc961486917e09",
      "source_sha256": "1fc5de1e8e252da179f01c9c27c1249c1a1436776611ece0330b7923d1a8442f",
      "translation": "朱特！"
    },
    {
      "id": "coalesced:ef27c7e755e2669d867351b0e8faa9071c509b2bef771060f5df761dfc0b67b6",
      "source_sha256": "00f4c23b620c19a40a02000601bc0a238944df57a6dd6a15a8cced1ed4ca6922",
      "translation": "呃，嗯……对不起……快走吧。"
    },
    {
      "id": "coalesced:db36f28166980d390ac14caab57dfe0b7f5a247ede2d41d8855ef22eb658ff4f",
      "source_sha256": "0d8522faf6d3d271ab1958051c4e5d779394806ecb40688c2100df7b2db543ac",
      "translation": "嗯。再坚持一下……马上就到了。"
    },
    {
      "id": "coalesced:534eca4b2322f14bab223ec3ff40caa55e19ba187247f3ac01a981bf0313754b",
      "source_sha256": "f4d1e706b85b1628ad24e9b083c80ad785a4c85be6a3d3b3984f3566e5d64cd5",
      "translation": "那一天，我们成了世界的敌人。"
    },
    {
      "id": "coalesced:202a938760a1fdb1dc7980549bc808f0526581df73668c7d0049cdf20de9ff99",
      "source_sha256": "f2be03e984ef8c30e7ae97280ffb7352bc4e91b2f30ea45722ed9f260ec5c0dd",
      "translation": "虽然早有觉悟，可这沉重得难以承受的真相，仍压在每个人的肩头。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d5c5a7c8ac18edfb9a6446218235edbb6cfbc5e6b1cc868557dd166dbae7eb85",
      "source_sha256": "b7d3985491cb26a80a4ecf62a9670b04086a188b7f31e8a61887c744abb02941",
      "translation": "从今往后，我们该怎么办才好？"
    },
    {
      "id": "coalesced:5b127a45976dccf48bd7ba7d97884e74fa8dc91beec314de19e0e6774d930091",
      "source_sha256": "28491b52c98b00ccd527a1c6708b7e49540a34a96a0b0b6ab76549b1b9b9d988",
      "translation": "这、这是……"
    },
    {
      "id": "coalesced:f63bd332926a31a08c32066bb0d3e352891b6f704a0e5dacc945adadf464c47d",
      "source_sha256": "e6c01fa928a7bdd726677f74b5400692db2af4246ac44b558ac59092fdfafe03",
      "translation": "怎么会……我一直被骗了。"
    },
    {
      "id": "coalesced:7e65a9e19a488329da5481fddacf68e0da1949e54336b2d2a72f160c1d0fc95f",
      "source_sha256": "d7eb234d124ee61458dfc7f0446fd24bd80b4fc15f560dea99346e0bf55a8ebe",
      "translation": "不能再这样待下去了。"
    },
    {
      "id": "coalesced:210c120c12b42bfab5533819524c890b3170132dd6ec0b593991ebe8a4bcbbdf",
      "source_sha256": "8115872fb0072d388d4db36b6232e90665618f0a48e64e158d9c43d4e97817cb",
      "translation": "你打算去哪里？"
    },
    {
      "id": "coalesced:67f84524cbe4ec295ee55854cbcbcaddf14a6c30f8cb801e8d93fb7b1926a95d",
      "source_sha256": "5a398c1035cff391bce91decfd92dfc9548df901b82067cb21eb6e612918a755",
      "translation": "克蕾尔！"
    },
    {
      "id": "coalesced:23a197428179fc64b0807b6dd7f76945672f207ec66e5c320927e45b3ada1ce6",
      "source_sha256": "d3759ab58a8f6d961f40303c81bbfc1985c346c7d878dd667bbead9ceeeab7b6",
      "translation": "果然，你打算背叛我们。"
    },
    {
      "id": "coalesced:5c369e890d4d60492dd2d14f6028979f46e900c429bfc4f810ec92b96f36f13b",
      "source_sha256": "26985ed2a4811261b5ea07036e4599c5c682e488a3fa75282f5286f66adfc9f9",
      "translation": "背叛？真正背叛的人是谁！明明是你骗了我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0eaef81d15cdbb633d220f84eab5165a01964b66fe2430b04378d3ea69d06273",
      "source_sha256": "65331985c80ea0abf3fe02360914ae04ea4668255e40e31ec4e5f3ffa3f8ddc4",
      "translation": "为什么要指责我们？难道兰兹海姆灭亡，你也无所谓？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b70fb5e6d571e8cd60e036bead5778e3ea3158567912a2a6e36e7bedbfd3062",
      "source_sha256": "e63aad10eaad018d7881d7fd8defaf420920c7775565de0ad5de9ea467940bf5",
      "translation": "灭亡……？你是认真的吗？"
    },
    {
      "id": "coalesced:40064384612726e88f0458b2cff1481897b6c7975dc1f873e57e80c02bc4bf1a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:77e414c4c15b9854216bb1074d1a1316ef3156090692cb1058e3a198303f31e5",
      "source_sha256": "48057fe02107b80059f44fb58be553c8e25f1f78928a3d66b0e75c4246987cfe",
      "translation": "我再也不想待在这里了。"
    },
    {
      "id": "coalesced:0771e5aaef875c0a5347140260d76c07b4edef507a8630650e7325008824586c",
      "source_sha256": "93a627665ae25cefbcd9a2f63ec028bbaf43667fba28aef4a5a0cd0009d0d55c",
      "translation": "立刻让开。要是想拦我，就得赌上性命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4d8e5bc505013aa7e91481a3c712e9e27198d07067d8a3f7e53a90f15a682413",
      "source_sha256": "e1d369b852d2e4b949f3a65959874e5dfc853fba8daa976231d87985fc32b1f4",
      "translation": "离开这里是你的自由，不过，之后会怎样，我可不敢保证。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1aec2c7d010903c4669ef5224089325f7b947a539ce0b51ba2362d4f467d354e",
      "source_sha256": "2b95a182f379ccb70ec6b0dad94d8f0ffb91988798028aedae9f4b3682ce1c05",
      "translation": "你是在威胁我吗？"
    },
    {
      "id": "coalesced:d15303df0fd7ba8dff7e019df085130001ac2e86fcafd265c42639df34d8d31d",
      "source_sha256": "dafc4d9afc74c1c1ab45f0bd738c73ba90c50c0e52eaff85e5e6665a0445b924",
      "translation": "不，我不会挽留想走的人。"
    },
    {
      "id": "coalesced:7695e8a6691af0f8c40fcd1b0868f6b6eef654b5ddde0cefe475a41dd9f1e828",
      "source_sha256": "e52e86275036889faa2882eecde6c3d7c7532ef4e0fd997286af0f9218527d04",
      "translation": "不过，梅莉莎……以前，你差点就被艾尔加杀死了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3462ca1cbd9a325a2dcd2a3594fac6283f463e456a4767bc061af3bffa344d0e",
      "source_sha256": "ff2e64be0aa804794a00a2bcaba08fc7f82665cb9375186513e8b72cfc5e78f4",
      "translation": "对于自己竟然能安然活下来这件事……你就从来没怀疑过吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:256abbdb83a932cb44b9ee2e5e8d5c6d0a1732da6ef3231f974638ace79e053c",
      "source_sha256": "6c48e6ed643bc66fc9ce27d10ae5f398a246fda407d762a98df356c7ace16355",
      "translation": "那……是什么意思？"
    },
    {
      "id": "coalesced:7f9248de9f425ed037d0ba11ce05ef001d32fad18c77d9ca4e8d781948f3bb5b",
      "source_sha256": "6bbf0c6dd1a61731da2938c3574bf5697cfc8a9ed89907f165612535ad55be05",
      "translation": "谁知道呢。没有的话，就算了。"
    },
    {
      "id": "coalesced:ddd0f4a48e83a10cfa041f382ea054eaed43446498fac10549cbba6fb6b0d455",
      "source_sha256": "3eef8fd5abcc1a93e05e0a9ec3cf6437a5b6f37a75ec1e352fedafe9cee799d7",
      "translation": "离开这里，你就会知道了。到时候，你会后悔的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a361a9ce113bb7843b539d4f48b55ccb8ef54dc7f2e376f04a18b3860472681",
      "source_sha256": "f2e1695f6252c180c378cd4df409b506c4fac9a884c8b1f96488ab3a91948152",
      "translation": "无所谓。我再也不会被你的话摆布了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f39cb3e13330f2d1128039b52f7f33aaabac31c3474d31fc7992176869a55521",
      "source_sha256": "6a6e199334540606706fbe3e25aa96d8d7c37068d04e60f9f44e2ab2e9cf311a",
      "translation": "呼……看来，终究还是没能驯服你啊。"
    },
    {
      "id": "coalesced:27b04e433b3672742c7e8bb562a3baa6af7507c0d88a287e363b92183c068efb",
      "source_sha256": "1582d1ef4e5cf9805c263bd339e2150d286e7fcecc91649adc0edf4bb816d81f",
      "translation": "不过，作为代价……你会付出惨痛的代价。"
    },
    {
      "id": "coalesced:573861459d13a4d0426f13bd1b85a07825c59bc674c5724ad2128beba8a20698",
      "source_sha256": "7310724ca3a2987aab29134387cd220d2c71b2de5a592c77bcac6340d3162131",
      "translation": "为什么在那里就那样放走了公主？如果您真想阻止，应该办得到吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:199872d46c0511e98153f7d37445a3ce8c17b6d6bb1c0677a3f611baf9c652b3",
      "source_sha256": "4bddae8f0fdba7cb3ac8716f3f23fad488e12aeaf2356ec65985b1b173a294c1",
      "translation": "要是继续打下去，连平民都会被卷进来。到时候，指责最终就会落到我们头上。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:64b3333726f4f2ad157740f080ae3ed74b64444cf5154d7e3e761b45a75f9a3f",
      "source_sha256": "4389a964dae4c155b517a288c7a83e42bb2d28888cb707d7850b8d10c578a661",
      "translation": "比起即将降临的灾难，人们更在意眼前的损失……愚昧之人就是如此。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:355623d6734dd42cb29dc459fdb207526e2fa244be4442dace9b1118f0407691",
      "source_sha256": "f81df875a2c918fd2effb8847f28730e8945272d6b973ac2d1fee444d8955487",
      "translation": "呵，您是会在意那种事的人吗？"
    },
    {
      "id": "coalesced:9106f5087f3fc4caa24cc2c1398aa373a5407163c967207188307d180f48f7a8",
      "source_sha256": "c8582a187788d3f85fb442c986cc841014c7323dbec53d6e66e409b00122529b",
      "translation": "您特意把离开贝尔福特的难民全都召集回来，一开始就有原因吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3fea45d3a4293be4395518b59442637bdfde287afbd6456de0242df1d96b6ed",
      "source_sha256": "840e52aa1c8991b703a05e433eaddf0a66ef1dc7b4e1d30feeb8e82dcdf73a3e",
      "translation": "只要公主牺牲，灾祸种就会停止。您是想把这件事，牢牢刻进那天到场的人们心里吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e17ee9cf4cdb504b094d43c5b242accdf73ed42f817ad4f595fc70ec277403e",
      "source_sha256": "d84c5b4f297af9ff11584e64bf44e2d6a585abd7341970f014c4ac5e43962ad4",
      "translation": "也是……如果没有人来妨碍，确实会上演足以名垂青史的一幕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:53d016bb9bd671f03a8f768ed7e0e364118ed5e8a410dc4dd84fa561de2e7e8b",
      "source_sha256": "f72d63d009c3c297a6fbdb315cda03a61e1af04c9905b4af31dc72e47bd23059",
      "translation": "接下来，您打算怎么办？"
    },
    {
      "id": "coalesced:b1c15d46dba9f2e1fd8db4d9e8601e4f16349a13cd9b566a998b9856fde47a0f",
      "source_sha256": "c680627753634f594691603063f20788db2b2f5b85f82b037015ce2248d7d97e",
      "translation": "随他们去吧……世界已经抛弃了公主。所有人都会逼她牺牲。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a16e96ccfd4ca20fe03acb45d62fe8b65e07509d4444ef16b56d68194f1c988",
      "source_sha256": "7155642d364cbb36d06689ed897d98cd01b4c1d597f42b048d8a608a005a910e",
      "translation": "人类一旦事关自己的性命，就会变得卑躬屈膝，令人作呕。只要自己能活下去，其他一切都无所谓。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:061a9669c2351ee0e1cd49cd11a7364f0df6481553723cdaef5640c5e3a05684",
      "source_sha256": "0706ec070d57100efc89a128203fd903ab5f23900029da6a6bc247b6201d67f3",
      "translation": "这样一来，您既把公主变成了世界的敌人，又让民众站到了自己这边。公主确实已经被逼上绝路了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b581838c168c67e3c9aa46ab07ab389b967ca314df4b985425224cb2361bd008",
      "source_sha256": "6113d340b9fb122b4e6463fe9a7a748569d71dd620ff5d63f984cf380013bf80",
      "translation": "呵呵呵……现在，轮到蕾洁菲尔妲做出决定了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ddc5e339866edbcfbb94b241ca956d2d907c4ca28f0cb2768c55c6223eb5083",
      "source_sha256": "c2fe73d48d2faa207b68787af7bbe416815e1a2f51329a8980664f65ab5cbab4",
      "translation": "究竟是背弃世界，还是守护世界……她一定很苦恼吧。我很期待，她会如何抉择。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f48d697c769dab2a834b223e890cb1e089973f7f7794312207aa32d92194cf7",
      "source_sha256": "850498dd2cf47aea7f8561126a6a50dec9fff9972e677af88f8947be9f696af3",
      "translation": "说起来……贝尔福特突然降下大量灾祸种，真的只是自然灾害吗？总觉得像是有人故意为之。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf2d11791223eb3f853b7d0136328c22f044e6bab09855efc820b7e63e55b3f2",
      "source_sha256": "84e0819af663f2b60cc694a15c43136450e1c7cd7dbf1b63f96909cc1c8179e8",
      "translation": "而且，贝尔福特的难民比想象中少得多。要是所有人都平安逃走，现在阿巴泽特应该早已人满为患了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54cd5ccc64a7305427e14f2c427ba0dcd84e4107d9cbbe9bfdc2e59cc31b6bad",
      "source_sha256": "c26f0b92940ab1d4e5b240a3a7991b5efb7ed89ea4671eea5005a5d33fe500bc",
      "translation": "超过半数的贝尔福特难民，到底消失到哪里去了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa4e6dcd8c5f1fa381802ddbbb5c442f4b74e7ee16c118b22599207b30c67d4f",
      "source_sha256": "6ae41d8706f1993fb7f2d87b159e3aea31c69b24f86f0311db3650103f0088e4",
      "translation": "呵……谁知道呢，你想怎么想就怎么想吧。"
    },
    {
      "id": "coalesced:d81e0382c3d1397cd37257e390105259804c22eb782f8c219c3bd169e17d6768",
      "source_sha256": "bc25eb430a0a595aa91f63f0836baaeab260b38de8b68eeaebeee6b3c50999bc",
      "translation": "（去柯塔马雷，休养一下吧。）"
    },
    {
      "id": "coalesced:dd29668caa78d8903a0f2de9635288188a4a1a3d82fe9d8e16086216338a2682",
      "source_sha256": "f7843bde2f47d667cc13ee7bd87c9b7cb063f5b81d755c79b8abdc7b0ea993c7",
      "translation": "（不能在这里浪费时间。去柯塔马雷吧。）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:465f3116130836ee8ecf1b14872216fb68dd3b831d627aef36063406d16eec9f",
      "source_sha256": "6ed808410123dddd971973b479db461c03d70a9bba8ae09e88621e51c36927ae",
      "translation": "（朱特有危险。去柯塔马雷吧。）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48f5a7454f28312fda70150a69b5c7f0c181520f8468001fb52963970046be97",
      "source_sha256": "50b81d994c9440603e9d238227dc47d05d6841f92ed94bb5cff18f3ae6212c28",
      "translation": "（得去柯塔马雷，为朱特哥哥治疗。）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09749a0e41723c6711e53fa21aa4f9786e0881d6971418d62c72875876f5d65b",
      "source_sha256": "f3bba7709d3706f335b6af87f391194c5a69854b4f99944d12985e718727a1a0",
      "translation": "（现在还是去柯塔马雷比较好。）"
    },
