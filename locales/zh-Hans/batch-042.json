{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:834f5dabb6af85b62aa855fdeb58d54f21e9b8e9163526a01137532e5627305d",
      "source_sha256": "1b9f732650575b1fd8f85cb696d7074ea39eb9cc23a7348dcf066d72069e48c9",
      "translation": "是灾祸种啊……"
    },
    {
      "id": "coalesced:cceeca9608e724aff9a683ce0881570e21509ab54303475a9d3d77f32b45c0b6",
      "source_sha256": "fc68e7bd69d1b4feef2ef706c0ab0a97533fcbe742747f5c1355f1d15cefe657",
      "translation": "大家应该都累了，最好稍微休息一下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb27de48b77ec8f2e55e5fe0a969c5c79624ddfad350f0f21507e963ac6b3d1c",
      "source_sha256": "f9106efb0bb2f84f78e3f0a3231c69741c78408f06afdc1d906d4cb497455dc9",
      "translation": "可是现在没时间了啊。必须赶快去贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4a0ccd2028e00e567cbf54129d4a8551f17d88dc6d160dfa2878cff1aa99281a",
      "source_sha256": "d6ccaf1d2b362bbf4570059a65400f8231ff7b0f3b3d02bd61055558bf2a1385",
      "translation": "要救洁菲，就得拼上性命战斗。必须先充分恢复体力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d74537ef4c0dcf8062a52935cdc24c69ffb5a3157487a5c1161a66dd4ca53fe",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:3a9d34e9a8005d04ef57b6ac9518688ac33117522ebbcaba6f08758f2ba095f1",
      "source_sha256": "20a002afb276d909eb3265ae18679fb2499098c0403e0ded95ad75103adb73dd",
      "translation": "最近，贝尔福特似乎不断有灾祸种降下。战斗时必须小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab7a839df8cff6cbf62c3e9d29199036bc41225288b67de698ddbedceda675e0",
      "source_sha256": "0cfab5cbe7caac82596f968ffe28c8e86947d0127ffc6ff12033772df1074d4e",
      "translation": "是吗？"
    },
    {
      "id": "coalesced:662baaf4ad3d326f101e684daa0d0c9d85583636a00c2e73292ce080b7da478d",
      "source_sha256": "47c79b7de025657b58d062bb3eaff22fc2084eaa8b98751abf30267a9c914d21",
      "translation": "很多人为了躲避灾祸种，已经离开贝尔福特。如今的贝尔福特，甚至很难再称作城市。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc0f38cc2e982aa51b31ca080c7b18c1c12c2b1b8875df582b3604469005bd5e",
      "source_sha256": "eea49e4a27658a9042e46d7df63645339cefc9b540c87f7815a0c607306c9add",
      "translation": "据说越往贝尔福特北边走，灾祸种越严重，几乎没有平民留下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a924a02972c625667274f406e83e13d79ad7c8b5d269034ee295bc34c1c443cc",
      "source_sha256": "1621040bbd9ea70dc43a7d3bf07c7e42f247332c25845c873f648d868cb33c1e",
      "translation": "因为灾祸种，就连越过鲁哈尔特向前推进的南部军，如今也被困在了贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5204d06733921dd0f469489e4692e56adc7b3d6bee833b16f2fbd220579b30bf",
      "source_sha256": "15107bd4dbb214a256ff40226e277874c771e9f81718e6b8606d7d3ddf11ca74",
      "translation": "要是没人，行动起来倒更方便。"
    },
    {
      "id": "coalesced:66b38594b47cc30adfbf4c5a1529747f88b8c7862afaf2b36a7c3b39f661c136",
      "source_sha256": "c05c0850e7128579bb3791a2531842e0c1a6e554c429cb3afaab451437e809c6",
      "translation": "贝尔福特啊……"
    },
    {
      "id": "coalesced:147e3befc050f91bfe4041d57122d59b72dfd8c00373a55b0909c183a81e85eb",
      "source_sha256": "2f13acde787f8d1fcede2d35364953b8f09229bcab5ed050e396bcf99768ffe5",
      "translation": "哥哥，现在好些了吗？"
    },
    {
      "id": "coalesced:4d169754f8e68dc2582d7a5d152aa83b714eab5fc6492a267cb2aabb23d1e5ae",
      "source_sha256": "7fa2a66d0b6675c63e42116b37697d98adc964e04f56e0bb0219bf39bad17b5e",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:6d0771d334f123b99ff17891b7d89e27e66c7cd0b9570a54b2385fcec7bd7de2",
      "source_sha256": "3516e37dfe17d49af7926a442a3c9e915f3752657bc12b4d9d086162ca21099e",
      "translation": "一定能救出洁菲姐姐的。"
    },
    {
      "id": "coalesced:06481189a2c75bebf11597044e7820356d770d8f1533812dd6d4b71d953607ca",
      "source_sha256": "a2995ecfa8c1ef54f89880d2ac58078acb809d7d539cfe7156b925bdb96c614a",
      "translation": "一定要救出来……不过……我不知道洁菲会不会高兴见到我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d944e1c241009ad7296cb9e46ab048861628884eff40b7cd14196fd2d5530a68",
      "source_sha256": "0d070a79393b8e907da2971173042d2f8d4501e243d9546dd00fdab753b71901",
      "translation": "哥哥……"
    },
    {
      "id": "coalesced:4faeb1d3687fcd37866175091904fafff1795ca3a8f2ba519a7175d90810e17d",
      "source_sha256": "facf5d385f2957731f36fc5f6b3e280e29e2d650d8fdc2ea087e2d89f6de44cc",
      "translation": "这点心理准备，你早该做好了吧。"
    },
    {
      "id": "coalesced:02454c09277b8ecd88b22f772578bebcc6629cccfbd4cb7c8239a66f895bdf4a",
      "source_sha256": "da62f9d94cc21307e1ad0e5e700a2e7d5728189c84482df5acb0586fe120c211",
      "translation": "嗯……就算洁菲不肯原谅我，也没关系。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73a3173448d5e65c22ec6ac5da9c2069d0369a47a0822fb5b4c968cae39a1c70",
      "source_sha256": "a25ec303382aca2b1d26a6dd470dd9e65ec21bf97add86a261e1ece24dfa75a3",
      "translation": "可恶……为什么偏偏是你？为什么你会是艾尔加啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67ed2d47313f61fdcdac69a296622a4ef169081b25778155535a163fb25f473a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:597e0758564e662bc68d34db7db11e8788b37e5bf295dc8f031f38a76e61c5b2",
      "source_sha256": "3d1b213207fb5fad87b37ef74b981491d5739a7431b8be398f4bfeaf10b6f821",
      "translation": "你看起来没什么精神。"
    },
    {
      "id": "coalesced:9b811d405294e75ffcda2f2140b7350803d96aa8cef598304f9c5bef1195e7c3",
      "source_sha256": "de2dae89a6042a25fed57fc4faf692247511688a451461d68147b37f0ea01de5",
      "translation": "嗯。不知道为什么，有点……不安。"
    },
    {
      "id": "coalesced:d8bd2ecd54c9f7eed39645729847055a24375d165cf452f531852e4103d3f93c",
      "source_sha256": "4ed3e586b98e1142ec90cbac894081b449f051b24839e4e14b61405f58eb2b8f",
      "translation": "别担心，洁菲一定会平安的。"
    },
    {
      "id": "coalesced:2dfad850bbd7f4ecec38b9a5ae867b7587f335a8368a211e06e2c8b1375d7b28",
      "source_sha256": "a848fed13a8b1e730eed6ebb4652271eff9fffc68378e72102d2f305a974dccc",
      "translation": "嗯。一定会吧？"
    },
    {
      "id": "coalesced:f67554ec803109cc596da5821c87a53039cac0c87abdebecf8a4835c9629df94",
      "source_sha256": "ca191c4210e795df3a25549055e670a1ff34d8523d97f36c06aa6a31c6e60f54",
      "translation": "突然发生了太多事……总觉得脑子里乱糟糟的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c456711429133dcd99ce3d3a69eccc17206af08d7152a32bb754a9d04f79503b",
      "source_sha256": "d684ddb2f3dfab74e47952ee202dd71fa0a84b5b61b0ab20e492d67ed77b537b",
      "translation": "甚至……还和朱特哥哥打了起来……"
    },
    {
      "id": "coalesced:ad8800a440b35901a505b7b41fe5d202531e12b7e8c252f278af175497a376d9",
      "source_sha256": "15fe058ad9fa6ce15258b4c454cc14535c25f6d2133f2f4901fbebff0eeb5e79",
      "translation": "现在是战争时期。无论和谁交战，都不奇怪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b45711405623d9ee63bfbaecbb9b5b4635c89d624ae80b2fe1be637c5042f73",
      "source_sha256": "0502c191878e34b5d4395e8321b0b6b99631b71f0ff4243b2582efa2918d1708",
      "translation": "为什么……人们总要争斗呢？"
    },
    {
      "id": "coalesced:514c5a93d736a4fd444cf2ab767a18bb7e14da1d50838276361436174dc4f012",
      "source_sha256": "74ee66e0745f245e8de43fd936e6a7990c85ec9e92e7f81a274e2039f36f9c28",
      "translation": "大概是因为，彼此无法共存的正义发生了冲突吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0fee81c41e9a35c3ad168f7dd5c1ee93962a64efef4cf57d5d0fb82cab449919",
      "source_sha256": "6ad8f01587e7d8a87f8b490a85d6a972a6a34491d8053da5f65b365ad806c8e0",
      "translation": "阿尔戈哥哥说的话……太深奥了，我听不懂。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9b6d062f7d71d1751e0f24e2d8e66cef82eaff6d605d331ee2808d8ab386d583",
      "source_sha256": "7e44e5b23f2c5ff76cd93bb04b18d9f34d7c77bbb38e26adba7f43ce43919a9f",
      "translation": "可是，我唯独不想和阿尔戈哥哥成为敌人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b07c52f45d5703b461197464dc4873d393f3b07fea1de89b00302d20eb45aa81",
      "source_sha256": "d4ebe3704c35f176d8b384c04ab8723aa7a1cbbe4d11b8497703dfe4c2eba08d",
      "translation": "我们一直并肩战斗，也一起度过了那么多时光……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df2990b2b8ef4fbda7ec9b9cf178c599a8b94d9e0f715d2d8c7b4184d915ae63",
      "source_sha256": "16d1179590f8358e919620fa7bc97b216460fd3cdf4a338b9959e495559fc10f",
      "translation": "我再也不想和同伴成为敌人了。"
    },
    {
      "id": "coalesced:2573894225729112de1801eca859e7b9b21ce66efadd469f7e7a81c9585598ec",
      "source_sha256": "3f1779c2f2c7be6bf597365f0142bae803df4430703c132c4d09bff56c2e875c",
      "translation": "放心吧。我们不会成为敌人的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c572266ef9d0fa52185a0938829d9422ea4080935b885d973dd9568255b2369",
      "source_sha256": "6c34b2f71ec2c60ed569faabc85e0019fc0b6a2c1475950e6ae46329af3d6a36",
      "translation": "嗯。希望以后……哪怕战争结束了，也能一直像这样在一起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7219da2f0db7fb0bc6eb02d3e611ef6a3caa0c8b6ac63b4855223be82395778e",
      "source_sha256": "1c6be563ba8608a66030970e59b9d9a10c3f868317ac994d055c3c7981a241fe",
      "translation": "好。很快就要出发了，先休息一下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4d4194a0d875dfa8c9a4a550d8a0cae73c80f5ed12a723125417fec4b07e093d",
      "source_sha256": "684b91f9f49e922d9665c76b76c8ab2d8e24976547b8fa33254f31ba3d9b25d0",
      "translation": "嗯，哥哥。"
    },
    {
      "id": "coalesced:3454931613403e36ea9799d343738e9e633b77b81cbead2a8de0894665acd391",
      "source_sha256": "b37e9a09d7148b8f7eb43b042cf5cc4f665b6f85fe07917edae4c765df9b3d2d",
      "translation": "好想快点见到洁菲姐姐。"
    },
    {
      "id": "coalesced:a425d41141567e3ac7b15ec2c52397b26038a574b1f09e271df170a38fef9f61",
      "source_sha256": "6c976f22e51a9faa7566bd9e5ac97b3a348cb2febc5106aad3759ee7d70e047c",
      "translation": "虽然谁也没有说出口，但大家都深深感受到了洁菲不在身边的空缺。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb5682068b889f8af18f5fa9be12d1eecfd9bd2dc1227cb3eb4ff9d1f1d7a61e",
      "source_sha256": "3d19891ff1aacce30b6792d1643ff0857ce0ddd962fd813c20d70c75a136d676",
      "translation": "我望着纷飞的灾祸种，回想起与洁菲共度的时光。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76635bcbf60c2e0ec783d74ca15a136f4ea8cfd1915b68c0ddbbd0f6339f41cf",
      "source_sha256": "9021e9cf9230c9fa7ef6edddfd1ef302e8c681845ba2d85902ddd823873f6d26",
      "translation": "直到现在，我才明白她对我意味着什么。为什么直到现在才意识到呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f28af0bef0207b3a7fa186f36eb722dc3d6b9e0623de53f32e40b744b6d5803e",
      "source_sha256": "80698eb9752095858b2ad51bedb694593886b2692bf0552e684b043ed768b3da",
      "translation": "明明已经无法挽回了。"
    },
    {
      "id": "coalesced:1adce249058ca5f97115be5e4aa2658acc3e38bf7eb4d8e8122fa9b367ef7afd",
      "source_sha256": "732402762691a4211e28349288ba7e2a881b16ee89be3991dfd0c981b5f4364b",
      "translation": "洁菲……如果还能再见到你，我该以怎样的表情面对你呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f74e848c82cc35d3319321261e35db6a99ff4b5c81163c0dcd1c73e9b8088aad",
      "source_sha256": "9c2f50dd2e0fe33094b8b5d5b76c6088fdef41e226df84a0be5355c147f8253c",
      "translation": "贝尔福特有几位隶属南部军的情报员。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ef93e9fbee86c35de7bb3df1158fe5b12c4ecc418ce2ea0d62b69b2f20b8657",
      "source_sha256": "5750d854d1aead5afb5bcaedc973915655580c7dd544c7359efc7aa0011ccd2d",
      "translation": "我潜入北部军设施、获取机密情报时，也多次得到他们的帮助。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c4ce52c4520838d50e46f53cf8faa629b963f70c699005bea8e16780bd3b11da",
      "source_sha256": "7f9ebe0e7230a98f71530e643e26656caa6e99fcc2ce58c4404bc3eb73e0bb3e",
      "translation": "和他们谈谈，应该能打听到公主殿下的下落。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f908df94472d5bd1ea098820291a9e93a15a460aee31f355ed6baa118de64f1",
      "source_sha256": "a408d312d8afceabb7a0d03e1bee5e096af43248878eed5cad7ccd7845d9c92a",
      "translation": "没那个必要。洁菲一定被带到了贝尔福特王城地下的“哨兵研究所”。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f03996942bc835bec990ec464defba0909b5ac8866a0c5264177833373f28a8",
      "source_sha256": "09ba1c8bfe3b325808b12c04bc6d47af892a74f25d32a8fbf8bfce458eb9523a",
      "translation": "你凭什么这么肯定？"
    },
    {
      "id": "coalesced:7b4b553c903292c67ab84a62ce6722fd220d5bbb9a1cf7b897003abbac1ef490",
      "source_sha256": "86edffba2a2c181e4adc45b4457c32e9e4a5fb3358aa39fb97d1d563103b6de5",
      "translation": "你也曾潜入过那里，应该能猜到吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22dc687d7be16e29afb21b4f5d988a704c451c9e7c93a53e933ac20c6f96f768",
      "source_sha256": "3366dbe4690a44ae0986cbb7480eedea8af16846094440880430006b28bd8d8d",
      "translation": "那里是修恩扎伊特的大本营，很适合避人耳目，暗中策划些什么。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3c5bf6d1b0613b9ad47b3323a47b0f4f69d1e316f58778505be1b00bc7de71e",
      "source_sha256": "e82e204eba5ecf92b382cadbdd2f9d6f87abdaeeb1f10560c9f3d566f6fe2933",
      "translation": "该不会是陷阱吧？"
    },
    {
      "id": "coalesced:0c499516fc936d1d49548923a18df5d12dfb3676aaccf1f227fe8b36b67072c1",
      "source_sha256": "162ac35d8552b3e8da5bf4fba6b9a05449b324a727e0f5476dedde49b88a915e",
      "translation": "要是那么怀疑我，现在就刺过来好了。我已经说过了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5bdc724ec80b0fb36451d9b37bd29ef534ace8e8cded279fe17c2afb24647c72",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:8566742eb83fab4089abb638799aef0b55355e627da9f8c9aa8a585b21b41a5a",
      "source_sha256": "65b3e236c8f86317fc62f2814c0ed63371f005d6678d6860485b90a81d9369d7",
      "translation": "如果你们不去，那我就一个人去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1081fe62c30e28c760457f9ebf6dd109cfc6e8edc297aef91281f4163b7b793c",
      "source_sha256": "3357e0c8bfbaf5f0392b19cc554a1459b3b1d5347cf482e8b07d03995da26691",
      "translation": "我明白了。那么，先去南部军营地吧。就算要去，也必须做好充分准备。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cde7ce9bcf0802d648b50a7b57382bb264b752863eea57516bd02e2041f7a336",
      "source_sha256": "2720db99e9bba41d8cc2925a9359166247770e407155921893a4b4c28a1322de",
      "translation": "去找情报员库克斯先生，应该能得到一些有用的情报。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48fbb4c3974ceba599722c395ef06b058e806e614d9a9c443bbca5c21b90c461",
      "source_sha256": "6c4373c003fc7bc4fe5a7ef4863d8b70536a0b095ed9e6d0ed34cbba2eeb9866",
      "translation": "好。谢谢。"
    },
    {
      "id": "coalesced:28dd726c61ebc317e0e66861b580426ee477902b43f65a1d2ddbbf88b77cd89f",
      "source_sha256": "d2b6b8d0f19d97ab70e66115286ae51c32abafdb6ba9a0d0fbc5f123334d8b42",
      "translation": "现在只想着救出公主殿下吧。"
    },
    {
      "id": "coalesced:de539082c36b4c91848e1a3c11854798f4b2c39c768e881f2345742d4e363d9e",
      "source_sha256": "e3e831c60b9ddc539dea4c0829a368c14193618c7bc7369a5d564089311fb489",
      "translation": "竟然到了这种地步……简直是一座死城。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:834c7468694963ec6b4f8eb5f8594c574462e20ea55a99fee25f97abdace4fb9",
      "source_sha256": "dffbf75f369fe42ec55549010568e5172a631412a4a8ac84035b8c40db6d5b83",
      "translation": "看来大家都为了躲避灾祸种逃走了。以前应该很热闹吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:261776e4b141fa182a855eb4a9adf00091cb558234edc96782e6264e6c70990c",
      "source_sha256": "38010dc5fdf0ab2ea9aba3698ea9bf42ea33e768bb6d28d8969f4c29a79e376c",
      "translation": "这下明白阿巴泽特难民增多的原因了。"
    },
    {
      "id": "coalesced:73d8ed6c581c8566cb33c42af091940fa5f691126ddd8407b11e73db246ab64e",
      "source_sha256": "df147134b20f2658ba2be8572875b8a3a2f3dabaf809edf45737a1368ab35fc4",
      "translation": "这里受到灾祸种影响，没法使用连环术。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6430410a96af8490b2bcb9b25f040e719ba71ba7ff4e85c5635dee18f394d9cb",
      "source_sha256": "7d9958710056fae74cec202d7f3c6599374fb30325bb517f503ce133eaf3d9e8",
      "translation": "所以，最好由朱特和阿尔戈代替克罗塞尔与塞蕾丝汀，站到前线。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4556f46202f7f491c109dca9112825497d1e8ccc96ad15434fea8aec02908f8b",
      "source_sha256": "8a3de1b6f5f28a0c276adf6f0c1f35a105619d50cf5eb96e9f9281b78d60781f",
      "translation": "知道了。交给我吧。"
    },
    {
      "id": "coalesced:8066ab32ff255dd13d9ff7e46eefe267c25bdd4fc4363df431008b9441ff4442",
      "source_sha256": "8779615e35945fc2ea8b89d177cc65bf7ead53741f2b01160053ed199d10524a",
      "translation": "嗯？有什么事吗？"
    },
    {
      "id": "coalesced:abc8cbf7b7126ef180cf56fbe0a2b0c7271700526033406966670cf6656cf640",
      "source_sha256": "45e399a0e5fb28961179b0eb2b110330ee64f524ef7a30836f1bf90772dcb953",
      "translation": "咦……那边那位小姐是……"
    },
    {
      "id": "coalesced:ebab3eab238b5029ef02a6c585a95108f48fa85f5330ec6f2a8f3c0d7a9bae89",
      "source_sha256": "b025baab43eb95452ba523c581b81447b7873116c697f2a483bc10e78403eb84",
      "translation": "露！这不是露吗！你没事，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab5a75b446398cee9314e8be2967d9f3af7c0a0b60fb94bc3cac56c1e4bf3de3",
      "source_sha256": "8656dddb8f81f1ae77d4def9499fd5d3ade3f7ada5b6b96f820ca2dd6a11fa0d",
      "translation": "我们做的事，总是伴随着危险，我一直很担心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a7ebac26cc999901807f2611b8bab5c86568947aa0874f1178e5305430481e5f",
      "source_sha256": "81cb656d660d3db9717b57c6000e331a7af8e789d65335cd72f7b897b973bb08",
      "translation": "不过……"
    },
    {
      "id": "coalesced:762c1d11f4745214c708ee49a9334a2d77fe7ee15c45f8325bd10c7b72afd1f0",
      "source_sha256": "cc7c01f79778e950f711aba5a4f090f10eff276fdb0b7538a48cf37f4ea8d98f",
      "translation": "看来你们是有事找我，可眼下情况不太妙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a581d02d0a2e1537538996dfbc3d2772eebbaac7f59e75b14d392f16d66dbad",
      "source_sha256": "8b94a8af4eb8a8ef567ee78c52680c0fa919dfeabce56b4664f79ff0db143ab7",
      "translation": "一直给我送情报的[泽罗哈]，前些时候突然失去了联络。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27f7a8932adadda771f24052199c90bcb4bef3cb7f5829aa2b1bd402bc9edc65",
      "source_sha256": "eafd58792c75120ac0c696d228e195c9cb1221b1c270eb365d25e4eb0b500b38",
      "translation": "恐怕是被北部军发现后抓住了，或者仍在遭到追捕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01bc69008b372d6e5ca82c1d974d97b34423728b6644bdf8503352f45a95d3f0",
      "source_sha256": "174e37c9c6f530f15be4c71398de01ca5325ab67b7dc980a9da7227dda238cbe",
      "translation": "凭我的能力，完全不知道泽罗哈在哪里，不过有办法找到他。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1771dbf7f387eddefd004236ba42ea70a47ec268148eb033a518c12ee3d7cf89",
      "source_sha256": "c0ee3fcc3b8f0c9bef8ac686d6a35ebd21dadb25dbf6f50cf727741c94b4859d",
      "translation": "打倒北部军，查看他们持有的库布里的内容。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:848604db040ea88877681a78fc893ea89059fc544d2607753482fa5481e4b9aa",
      "source_sha256": "668440d44cde88a561e0915b07ff3d9a91bb6285603600bbf0a400feac4ffac8",
      "translation": "里面应该会有情报，告诉我们泽罗哈是否被抓，或者目前身在何处。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:492c2c5db9a20604245379c72fa403cdccec7607c239db6afeb458482ca9eca7",
      "source_sha256": "094a6a3173ce2fa806fdf5fe0828847b796e25a054214ef39b33d9f9035fd2a0",
      "translation": "如果泽罗哈还没被抓，就必须赶在北部军之前找到他。请抓紧时间。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47e02a8a664f0fe6cf65d5e46982902fb7dee694f75e87abf22f1ee7689df14f",
      "source_sha256": "70643ac1ddf7bffcd349a238ac3c311b3d5bb242d5e65aea4da2e24f188e981c",
      "translation": "不知道哪名北部军手里会有库布。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d2105374ce90fc145cecc2e35b215bfd9c5ecd7c235db4afe2192654117e635a",
      "source_sha256": "ec3bbf0f5c08fd250fdfc930b424791dec5708efb9af7e7ab13b36e43ca73ecb",
      "translation": "总之，先打倒他们，再找找看吧。"
    },
    {
      "id": "coalesced:f50327f3e754d836069feb7a1ba9c9153e0b17a881315c8eb362eaeda37042de",
      "source_sha256": "61ac05f94f9695d3b5bde49b0bb9c2a2ede038dba407c27558c55c34d1ae7f21",
      "translation": "如果泽罗哈被北部军带走，局势就会更加不利。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7b5f4912cfc1363606154fc11688dcddb92ba49a445fe793ffa1e7a53d8d300",
      "source_sha256": "c07b51cf278f4a81e12fbb64f788d1a07e0ee87657c27bdc6617a43e509ae207",
      "translation": "你们明白吧？"
    },
    {
      "id": "coalesced:29ee7dbfb2f0a4795b4c01417d2666b9437aeebcb7d08504d494f34d0ae1b02b",
      "source_sha256": "010207e2441640561d9b643d1353657c2a52b6416fa9f641de9ca16057b0907c",
      "translation": "打倒北部军，通过库布中的情报寻找泽罗哈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44097c5424afe0be06f454199db77f257ea12b2fe9a1d706701226231064ed0b",
      "source_sha256": "fc4fadedd530210863bed96b5e9d71ed033e65c1364803a0e32ee67fc2c52c73",
      "translation": "发现了北部军的库布"
    },
    {
      "id": "coalesced:36e0d016008e6fc1df05b48ef53bb27f67c728cd1f36050c7872d52e5fd7dcba",
      "source_sha256": "7ab44f23b08b1fb213c2fdb03896f0bb029026b15fc2c5dde07006fec9b5a0c5",
      "translation": "打倒北部军，通过他们持有的库布，\\n寻找情报员[泽罗哈]。"
    },
    {
      "id": "coalesced:c4e522c4343e62e509aa237289b857ae29320a6d23b495f76a87d90ecea8b20b",
      "source_sha256": "f0a4a7df73d148c2541c183239ed6cae3a4d6d7955d66694ae9eac7c598888f6",
      "translation": "追踪泽罗哈"
    },
    {
      "id": "coalesced:2a01baff1da7169f72ba82ccce5b0c2d9821e603e12520a2c7ff04295d401c72",
      "source_sha256": "51e53b9e18c59326a949fa367061becb26b655fe04b79644ae50ebce3c7b9428",
      "translation": "真是个难以生活的世道啊……"
    },
    {
      "id": "coalesced:8ad00c3dfac64ec2050375f68903a0b9c0a5fc7f02929dce87f9277134a53acb",
      "source_sha256": "2ea359249a8ac77d518e87c67ad2d5732572d30aa20906f7060f1ce4fc6130ad",
      "translation": "现在只能替南部军跑跑腿，一天天地熬下去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66eab7a23a5e46444cbdad2d7270bb552051adbfe1fec0241a8445457df7eb0d",
      "source_sha256": "9dbf0a2276cfdcaf7809b526572df2dd2b4e4d2271e61e7b2fecdf23262ead89",
      "translation": "世道变成这样，人们似乎也越来越提不起干劲了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:480776ffa13c6d7ee44aefcd04fca348f24be0cb8f225d13d9892a3cf9f3318e",
      "source_sha256": "9ae2c767bce90243651de7b6f7d63d584b5e9334793fea73b100a48ebfd4ceb2",
      "translation": "这种状况到底还要持续多久呢？战祸、寒冷、饥饿，再加上灾祸种……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01bdf342340a04bcb283680ce04b09ebc3093396bfc0226b4bc86a0cae29c919",
      "source_sha256": "439a62b6a6ffe90c82be66c037f17610a0b8e870347c58be20fff00b0e8572c4",
      "translation": "我靠着替南部军干活，勉强维持生计。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69de71b37f91e0b0f7f924b005f5f6cf667f932c037e8aee8873b5ff7d460a97",
      "source_sha256": "95070751a1dd028a69095f00c6e41049226ee93186386e11765a8dd7fbedc491",
      "translation": "可我不止一次想过，自己究竟为什么还活着。真希望战争快点结束……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ce3e515c56e86a8c3e5dc290ffc1974fbffaf966a4046bf46e8d3d3b0ba1199",
      "source_sha256": "61176fbcdaa238c15a1e6287ac1967121f840da2d74355b4ff59e9ff4ee92803",
      "translation": "那个，叔叔……"
    },
    {
      "id": "coalesced:da4da7a0651913963fb41a519ecb64bfc7d7793a60567da693a542f8d5f30d3f",
      "source_sha256": "d172111430fc453f6d6e336d53e1bc70c4d088f529199e60fed62dcdb87df76e",
      "translation": "能给我一点吃的吗？家被毁了，爸爸妈妈也不见了，我没有东西吃。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31162d4f1fe68f49afbe7cf63d0311b011146a29dbac97c35cba8fb3ed427155",
      "source_sha256": "1e4fd8075484114dd62340e5f153e8df8837495e8cf756ecd041b919743b57f1",
      "translation": "好饿啊……"
    },
    {
      "id": "coalesced:79afbc68e814585734afc6c9310e23751002ddf9a8e0517b77a8dd58baeafac3",
      "source_sha256": "f87c8504c9ca5d2dbf1358466ca2dc114e540d66be217070ee8ff05650146957",
      "translation": "你们是南部军的士兵吧？也让我加入南部军吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db257d4987ebff9611ed90bd93c2551c9ecca479b49395cf64bca049ab2c0bd2",
      "source_sha256": "a26f43ad9df1c922954f74fe5f58e8743373d1d04d3c17e51667c68a6b09fd57",
      "translation": "我一定要向杀害父母的那些家伙报仇！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7dfeb707c180bf760a6a2aa299f7511c0e32d61c98a31cd4f621c101f8db1343",
      "source_sha256": "9176a8bdecc2f9108f52807ba3a339e91bfe58c6e87bf74d50786d38c0dafdb0",
      "translation": "你们也是来打仗的吗？"
    },
    {
      "id": "coalesced:1b0f6ae573a48d68e371eafe9c25d1f3c26373a60234e225f87d5fbee1deacae",
      "source_sha256": "2b7ba75d91923d2a65ece16d5ba83f976177c0e1443b1d1e814c659cc6c10cc7",
      "translation": "因为你们，受害的总是我们这样的人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2272c7ebe72a1341483013455c244212b1964189428f90c9a485ad33cff227e7",
      "source_sha256": "b33f3fa5afd60499e972d1a95be3c8b3b911d3a56c82ef335d576762820a2563",
      "translation": "难道只因为有战斗的力量……就可以这样践踏别人的故乡吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c553196a64f082c62398f84cef44f135bbdf24bfcae121800fbfb8c168468c88",
      "source_sha256": "9391d4ef8de19d0e83687ca1a80f81a3c3c0f1dfdf80f8ad5e0c22a52115ce8d",
      "translation": "有没有兴趣投资我？其实，我以前可是贝尔福特的大贵族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f86aa8caa6801cd318187a90b37448e36155756250365aee6e9bf7fc7f6e4b67",
      "source_sha256": "f7e122c8793a72414a29d0302ba66f863995c46c7bcef9ab03f13fa251578eeb",
      "translation": "现在给我钱，等战争结束，我就给你3倍！不，4倍的回报。怎么样？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b01c8b5c54a580ad3b0680ec5cc5adf85681f7f487402466b207d3508110be0e",
      "source_sha256": "76c60f53a43e268a4be6411e3f0e218b3ddef9e7b9ff7c1ffaa26955e7178f11",
      "translation": "我丈夫死在这里。哪怕生活再艰难，我也不能离开。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:42e6f23558cd9fa847ea26ab9263311faede8e3e736bc4f6e16962b2c9679169",
      "source_sha256": "d9b6d6626c3da2fb388c067b914bcf434da634d8521f9077613c83a6eb05000c",
      "translation": "这一切都怪修恩扎伊特。就是因为那个人发动叛乱……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20c69a0217afd678c5bd378d8f0555e299ba3988a6880e87fde7ebfe1068a5b3",
      "source_sha256": "1f09c4c66f885c66a843ef4ab61a91acdc3a8ccaadb935aa2377f4f34b0f3e35",
      "translation": "我们才会吃这些苦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a16ead38a1d1cb60d3c6ab0ff888146eb45a09b6e2acb5bc9edf523c8b7f639",
      "source_sha256": "b720d1772756d138e7f97fac648fdb843fe1c95b2a665d4571bfc235ec129768",
      "translation": "我现在很忙，晚点再说。怎么突然忙成这样？听说要办什么活动，还是什么的……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87904173219ff0fece76d9463aab9e48a3e6b3db212df1a83c334983edc3975b",
      "source_sha256": "e826659f1a591dd088df1f52df5e593cfd71de498aa78487fd30547d5508d0a9",
      "translation": "真叫人憋屈。敌人的大本营就在眼前，却只能眼睁睁地看着……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dcfe64391a2e2b5e197d116cbc88d24570a5ddd55e6c6c115f0941e7359e7458",
      "source_sha256": "e4f0241cf27c13b0686675fe89fdd45b169104133908d395fb69e657e145784c",
      "translation": "到底为什么，一直没有进攻那里的命令！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14665ce2c755e89fe42765e46acdb71bf4b67ba9c23b5da69488ec2047bde17b",
      "source_sha256": "798d3b2568f1162156580c736676540f9a6bb20950f713c214ff4b7953016c1d",
      "translation": "最近流传着一个奇怪的传闻，说修恩扎伊特与亚历克斯大人接触过。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:142450426c2b203cda7f3a4a241648836ebf3c2177249e01d5742406e4cd9cab",
      "source_sha256": "73ba101a5e4ab6449a9bfa93ab51e0c38d94c175b1a2bea66b5b8b4be0cbd3df",
      "translation": "的确，战争开始之前，那两个人就彼此熟识。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:130e66bfec3df4252d11833999aa612ccb6b8136d795d1bf57c60cdfe5e7e53e",
      "source_sha256": "3f5d82185cc26d86995c12e70e0058007ac5679793b160e7df3bea75ff71e08d",
      "translation": "这种对峙，已经持续2个月了。"
    },
    {
      "id": "coalesced:576df49ce73f60323a0228c300ac2b9fe9e8dd84e8bea3045c53544c37334bac",
      "source_sha256": "97b1c56535cd313dccac1048e9f983af10850dda4bf38dc8c592fb922fcd055f",
      "translation": "真奇怪。为什么不打仗，却一直白白消耗军粮？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88da6a64053b090e83cf7eca23b7162f599936af786e2fc36fc7c54021ede307",
      "source_sha256": "3f766da3e419de97098cb6ad85d82ce167d011cacb5ec197cae390c8c6c2536d",
      "translation": "这里就是贝尔福特。以前是兰兹海姆的首都，如今却成了这副模样。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:274e71b7888c11e3cada6280a25ec810b6322c38f66695a9fdeba5f36158ca0c",
      "source_sha256": "e4ed39380db98eefa744427b3c081b0693b150f98a3359ea3b3d97cf6bc44c2b",
      "translation": "虽然现在似乎暂时停止了战斗，但敌军仍盘踞在市区。请时刻保持警惕。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b402656d654ea15861ea18da348873fbf87969c99aa2c2722ec9077f18e2da8",
      "source_sha256": "9c780a30cbc4e73d06b9612bc38828b232909309652281aec908ef40c3529bdc",
      "translation": "北边被北部军占着，星光平原又到处都是怪物……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b94f99da9307316dd2ac239bfc7dccdf395e08e4692ad58837188d3d536fb6f",
      "source_sha256": "34f2e2a347c7c5ce1255385c68cbbf24793ff73d03d2c5db0f0a08d70a7aaee5",
      "translation": "这样居然也撑下来了。就算战争结束，贝尔福特的重建恐怕也得花上很长时间。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe86beddc70a0d5c915ec200af66fdd5f5d930c85b7801ee45d5e1cbe1ea30db",
      "source_sha256": "3f40eb9817cbd2d6e104b7622dc557f4a28afc39046ad1e0bfeda2f4fe768164",
      "translation": "听说过反哨兵部队的事。你们能来这里，实在让人安心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe3232de07fc124dcdd7e55734c0058ac02d2c799d078e15b76396519fdab821",
      "source_sha256": "4bfbb4e5b2fc286f1946b3da2e5a09278457354974c955b4e95c63ea74a2237c",
      "translation": "沿这条路一直走，就能到被毁成废墟的市区。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7b987d782c6911a9e5fa937a10f26a1ca863135a571a4af0b27d6c132adc6230",
      "source_sha256": "ca056ff4dac201e4e0f7089e67c533b80375a8561ea969473da856d26d40a17d",
      "translation": "穿过市区，就能抵达北部军的大本营——贝尔福特王城。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7610121b338e4b633e70635e57ff6c1293ff1da732f23998c090ae8ab2616fc",
      "source_sha256": "3beabb8cc562d4cfb0aeafa289d9dabbd077318d51f1877b07d4b5997b619d39",
      "translation": "要往北走的话，务必小心。"
    },
    {
      "id": "coalesced:165dd3cc8b17d126601d3effaa886335b694c7d5990e2d4c2283de249e81d92a",
      "source_sha256": "64800afb53f71bbc9db435201b0ca5a661d3a0d37ef479217716aac96ec432d4",
      "translation": "那里有各种怪物和北部军，层层盘踞着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e4001f141386019bccaca683e6896992e8be97289618907388e22e804875b73",
      "source_sha256": "78b543528d6849c087212bf9e18b51f36cc27e6de6e7a810e51a9c159bba89d9",
      "translation": "我这里卖些东西。欢迎看看～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb9d0cf7eb23c9c49061ac85403f81b427ab6943fd7333fb3c85bd00a61cefc5",
      "source_sha256": "579d31aae7863bde90f021cd0c0a4d7d394ccfd2fcb94cfd2a93930bca91788c",
      "translation": "请卖些东西给我吧～"
    },
    {
      "id": "coalesced:8196ab3f58d9380bf21c77814eb998f6057dfe9586a0c6530cd571df278ecbe5",
      "source_sha256": "fce204bd6b8428ac8778d45645f95480103e39ffde338cdf256dedaf08ecf5e8",
      "translation": "(泽罗哈有危险，不能就这样走。)"
    },
    {
      "id": "coalesced:5f1e1e1f3cc46812b0e8dccb945e1792e3d3c3011ed8d654209ca91ca376faa5",
      "source_sha256": "b47f072ac751ca6f47b1b8f1281fab04fb777741d1e7abb884bf4dc329bac5d7",
      "translation": "(必须赶快救出泽罗哈。)"
    },
    {
      "id": "coalesced:f049258e9e240dea9e5e4efc1accb1c10538fb2d1b58df4d68589b7a1c510d1d",
      "source_sha256": "fe5685ae24dbc1db1af20906835360a2cd489bd754f8911231ab9cdc835ce59c",
      "translation": "(不能让泽罗哈栽在北部军手里。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bcfd4761e3453b309d2dc43db1ff04698ccc44c26f5ba0f8d217fa0955fe4ee3",
      "source_sha256": "b66ec5363d65e37741da24fcfb6b3adbea8521639df28b5b253ccac6649e1336",
      "translation": "(必须救出泽罗哈～)"
    },
    {
      "id": "coalesced:74af49fe0a05cec6f8e074ea4227c161453caa7ef9a6520560bfa12c97abc7bb",
      "source_sha256": "af699261530a5390d21c3d48a20a3fb0f56ff43d5769b58d35538e3fa3be05c3",
      "translation": "(现在必须救出泽罗哈。)"
    },
    {
      "id": "coalesced:34aa0b4078c92d974fc947c3db2c934f892e91a071ce758d9fc6b0c9296bb7ee",
      "source_sha256": "1e6be227cc84e16ae46ca74e6c41265c4f08c823c1d1985f1dce79af0d46580d",
      "translation": "泽罗哈"
    },
    {
      "id": "coalesced:ff8cc06aff92c74a657d0f8e12c2032af74fb57f94fba917f1b87e779673861c",
      "source_sha256": "a740a7413051b05e783c03d8d81e625dc919b853402c8d5374e19a9d7ef785dc",
      "translation": "库克斯"
    },
    {
      "id": "coalesced:c2cd35af1da7008ed5c83e14b8cc15990f08a5e0ba369ee3bf64fbfa850041f4",
      "source_sha256": "3ddf8d923e8d28a3eee12eff0507ed24a2c49b8b781c1422a729ba9d6f25580d",
      "translation": "哨兵研究所"
    }
  ]
}
