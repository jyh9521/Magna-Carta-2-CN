{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:206053b2cc066ba2d6a05dae241051d90f4df39ab7511ac17b740f4a02913f4a",
      "source_sha256": "744d239b0534612ba9018265d3a9a6604f7bc973bebf81e4fd452fbbf82956d1",
      "translation": "露！你平安无事，真是太好了！"
    },
    {
      "id": "coalesced:95d44540410cf4400f72aaf767c9c72f20edf96c6ce6b911a5fc6ef06f7a60aa",
      "source_sha256": "8a5676bd33757204b0b1b1bce1f3ec9f880ec2dcc080d31fa99e4ba30d5cd120",
      "translation": "请退后。就算是你，只要对公主出手，我也绝不会原谅。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a902acffbd5cf399b59b3f52f49932ffcabf4fd66c530124d6c8e508226e4423",
      "source_sha256": "07569440c6953e46ed3f26967c7dbd54add38281bf230376e3b7e00094d89d92",
      "translation": "公、公主？……露，你把公主……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:018b1b461f67448532c889e3156773a6c30f19bf03aef46d857bbaf92f0bc352",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:197e0588a4f9db9b14cb903701abb6583ef9a7ef02544db85f129e1c2c2cc7d3",
      "source_sha256": "3f615e94c0537f48aeef713600697d01b399cee18f217927165bd908b062a893",
      "translation": "那这边很危险。我告诉你们另一条路。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77b63400b173544bc486b2ee76d8625d405fcdc0e4b0d50e308721a8578653e5",
      "source_sha256": "3371c1e39cc846440f45ea714be9e5fe931c2dc14f3f1ca8cc301896e9c80baa",
      "translation": "追兵很快就会赶来，得尽快避开他们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:747fc58eabb534dbe6bd32e582f4dd7c51b7558ff0ff54256d3847613d240312",
      "source_sha256": "895c6599da4d2b9854fdb16dfb1f9cdc5d64d0551e4f5b2b583c5d56e3902636",
      "translation": "你要我们相信你？"
    },
    {
      "id": "coalesced:162872f2e83214b654fdbc5d798292246010a4e58351e1661d206b0d37b00df8",
      "source_sha256": "d737c05fea56a272fe9c32bb2e1464ce0bc5ab6307b88a72aac458aab68cc1a8",
      "translation": "啊，是的，当然。我希望露能平安逃出去。当然，也包括大家。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de6ca40b449fe603ecd3879c3a9a8bac2766e39bf899598ff057aacb5af7fb9e",
      "source_sha256": "378ff60083bf6678aa2d89f619e99e04b59d8684754a1f6c0279ed7226ecb70b",
      "translation": "虽然看起来不像是在说谎……但我也没法，就这样相信你的话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:32056398784e98ec16adcd4310779429ffb7d7131fe3955c6a7b112287fa43cc",
      "source_sha256": "88f9ebed6dcb3616420b34160a24499fce09929f655fd9bbd7036692ffdfac48",
      "translation": "有可疑的人！立刻抓住他们！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f07d54c6f7342fa8626d79118bf673d46a44d672263c893750ec6a78634e0f0a",
      "source_sha256": "bfea0b329665d8fd7f30b416479a6f116b8121d4f2896069d5bd56c10f5c84e7",
      "translation": "嗯，得赶快离开这里了。"
    },
    {
      "id": "coalesced:076c1849fac8d8724a510dade62d818a7b0ba0be31e7c74ac45cd6001846dc31",
      "source_sha256": "64f5c01f0dce359980eb704af5b27578635fb53cf56387f44c238d86c8cb8bc6",
      "translation": "大家快走！我来争取时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a1ce63d1bd8fc1846b861d762834005baa5b1e93485dc9add9b92fdee1df136f",
      "source_sha256": "6b95eaf84a4dd9e633fe61630b70026daa914d17f9486e293a8ae1cf4d298fb3",
      "translation": "请别勉强。要是有危险，你也得立刻逃走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:64ce64f3ba3223edf7da52b7528e7fa50ca4d7e07bd7ed1ade03aef8afeae49f",
      "source_sha256": "853fe24454e25192f360dd47c648a16940df016b25e89861d900fec95b0e97f7",
      "translation": "露……你是在担心我吗？我们的相遇是命运，所以，一定还会再见的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:931b1c4fc4c2b4a3407fcf9de4e7416286ec4bcf4ff13a79774a305ba2bc90fb",
      "source_sha256": "0ffda15d774c37b982264925b069a6d7256aa69dddf93a5aa3b75c73fd3d2143",
      "translation": "这种时候，竟然还有闲心，说这么让人脸红的话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc0208dbb5efdf56399c1d3df54e9fa8c23f5c0ccd888b10f9eb8d8b9a88651d",
      "source_sha256": "7e2f1e2ab55eef9439e34976ce4084cfda171698c21f69130a0baa09848c375c",
      "translation": "赶快走吧。"
    },
    {
      "id": "coalesced:0013d9ea7ef4bb36b086fa2e2ed8f640178f71a00d8e3795df1c690c85ca6d63",
      "source_sha256": "3daee34933f7b79ee94b857ff9a4c0ea032d0b36a4083da53cbc1ec663a3776b",
      "translation": "逃到这里，应该就够了。"
    },
    {
      "id": "coalesced:780c2f67fcdfac6de1091b100a1e7eee3419ef33cf30c2c50d82e39202be5db9",
      "source_sha256": "4d320cd20fb18fabf1a5832989ed5ad44fbfc4f5cee8c04c7d5cf840933cbb90",
      "translation": "玛拉基亚哥哥，会没事吧……？他可是想保护我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:907f094cb98b105b4ae3b08c96214d00d6f27ebb3eb9dd864d45c923574387d3",
      "source_sha256": "d89a87cd73045ec7641b302b4f4942a3a412b5d48a294c098854939c096d9e13",
      "translation": "那家伙，现在应该也属于联合军吧……希望以后，不会因为违抗命令受罚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:618cacef90ff30cbbded848a5c1232a7267f4ea7c3d8c858bd7f8cf27d9b5f6e",
      "source_sha256": "8e7904bfbebd8196d3d742807f0a57c0df1ee346d5420896e08107bb1fd0558d",
      "translation": "以后有机会，我会问问泽罗哈。他是情报员，应该会知道些什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:579d77d4b92f1e48b899e6b1f2247f973af0c995c925d228f649ae59ce8dafb2",
      "source_sha256": "fb2f4fbfce4f192d43d0e368b45d922c2f3741950c92c42913ff7b046714e65c",
      "translation": "嗯，库布好像还能用，应该能联系上泽罗哈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7da8996acf9478e2ebbf8fa66aed49d15440fa4d51f633ccaa73306e21f79b38",
      "source_sha256": "b7d5a9db221dfa64855f52b42678db9df8f69b6a2aee83d2afa2b1e656252bdb",
      "translation": "露！你平安无事！看吧，我就说，我们还会再见的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb052bc423b4eef3c63fa58c94adb46772029791774d42b410299d07adc2b552",
      "source_sha256": "74cd7b1bf7a4fcf1e3aff4ccb2d812e60fa8d8cc3e1a7c41af7b3d6b7b98a8ca",
      "translation": "这种情况下，你竟然还能说这么悠闲的话？"
    },
    {
      "id": "coalesced:2149c1e198657c899cf4748db1408aa530dd06acbdbbed6b9c071d97a76e7b71",
      "source_sha256": "dfc6e3b95e69ecec3262ee2522e32fdb3dddf40f79bfa293d2747e8b6a2c045e",
      "translation": "你快逃到安全的地方去吧。"
    },
    {
      "id": "coalesced:e03593f12c7673737232afeaef2763453e475185fc4c7a62f1b6916f8684a6d6",
      "source_sha256": "9ebce87766cfce8bd65534e774760c46d38a32739ade4e74b228bc4a86aff4b3",
      "translation": "啊，不过，在那之前，我有件重要的事要说。"
    },
    {
      "id": "coalesced:2bc1c0e22d30374fe783d51ea6fd5132a199260adc1a4f09774aebb3a5f1777c",
      "source_sha256": "92d66670f67019558d3bb9d3fe26ad854e6b5e5272f465ec912026decb02e6e6",
      "translation": "玛拉基亚说的，就是这个吗！"
    },
    {
      "id": "coalesced:efd00ca47143c931132fb450d6a160756c65c4d638b9ae82ea80bb03b28d46fe",
      "source_sha256": "5d70b593646ed2b5e28da3224b2d74fca630b628808f05e9023f9dbf18ad3a5a",
      "translation": "确实能感受到，强大的雷电之力。虽然有些困难，还是试着把它融入武器吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:25368f5a831c3831e269748c52ed7c44391768eccdc2529806d295e7dc756183",
      "source_sha256": "fcd4f5098d471176d35de42b4894871646f65d19bbd36169fe38610206d6b034",
      "translation": "唔……呃啊……"
    },
    {
      "id": "coalesced:3bbc974190a4106159a58f8bf5814be7ca389c78d68f3a3654284e8f8716fb38",
      "source_sha256": "ee2740b40e88f5d1b9bb250bb56af89093f6bfe7e04f6a33d215ec46054841a0",
      "translation": "看来，这比想象中更花时间。"
    },
    {
      "id": "coalesced:5edf70a1577985b8a1af446a775c68cdd267a37a21783876871836b2eee8509d",
      "source_sha256": "849d244417fcf00ff98d0e10b99707f942c37c3915fb886fb130d88d09e1614b",
      "translation": "唔……唔呃啊。"
    },
    {
      "id": "coalesced:b41126b95bf323e8675261ae6e3d55dbbd921c0cd4b7f54d1375e50bd7c91400",
      "source_sha256": "d3c34f6ef3f0a34546ac055993020169b671f02077351b07d29add7e44f78507",
      "translation": "呜呃！"
    },
    {
      "id": "coalesced:3b53a0084f1f72d4d0b17acabf92602d662d75bb092542c98b6c1b279f981578",
      "source_sha256": "6cc7c024fff4c0331f8b9103e8f07d4de646162b0c747b68a311b353cfc3f60b",
      "translation": "呼……呼……"
    },
    {
      "id": "coalesced:1864a308350d1f0dffb9e9c7b51f1bce21a2b3c7d253fe2a7e01e4f7e62f72ff",
      "source_sha256": "7b17e7ce384b0a36fb289bd2f1eac1ad49bc12862ba1952d15776e38b3b0c0e7",
      "translation": "总算是成功了，不过，究竟能不能运用这股力量……还是未知数。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa7458b1f77ec96f79ba50d5396b0d623e8538993640a7652daf99c2b582c3ce",
      "source_sha256": "db7e8a31e2bb1382da54ffb95fae96f3b1af15cfad94f7e1981bf83b1bed1110",
      "translation": "这就是雷属性的最强武器啊。"
    },
    {
      "id": "coalesced:b91bd01dcbe727e540ef0b842de129647fad999389e2edb072d09c8c04c1a4df",
      "source_sha256": "b9618ef7004ef8dea6186d93924861b5bb0b6deb92298622aa03a17f777d0139",
      "translation": "的确，会对今后的战斗，大有帮助。"
    },
    {
      "id": "coalesced:6dbfe5a0cd01397555804917e860f57d7932389c709dbe422871db24ee30740e",
      "source_sha256": "bb8e1bd0012636bb21e6db31aefd3a8e5477f17df54a08faa82d3e37e52b41f7",
      "translation": "请营救被转移到[鲁哈尔特高原]的玛拉基亚"
    },
    {
      "id": "coalesced:6f4fa3461f3559beabc48443e87d8fa7c010d460e7ba6ba42233a8bffe120674",
      "source_sha256": "112ec8b9ec473754f9d31fbe61114358f42d8074a654d8a87c8305120bd500c8",
      "translation": "营救玛拉基亚"
    },
    {
      "id": "coalesced:1e8e7d36e2c6803836473fc352837d09be7b4ca53d3bbc24a611644e25cd53c4",
      "source_sha256": "a567d613fabf4236abb3e4299211c9bb8f787f2ac663e5e64182b577b3ad72ff",
      "translation": "还有敌人留在这里。请先解决那些敌人！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:91c2a2f0c5fe6528dbf60001ad471dc3debdc961d9a4a20b70dc2e4dde16e56f",
      "source_sha256": "605a04d8f446a7aa3faac1abff3493424189331fd79cf9b3e0b934d1355292f4",
      "translation": "上次被抓到贝尔福特的时候，我偶然听到了，北部军的谈话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da08d7600f9c2b404aae5c655bf04abbad8c9fc9b621563f0be5dc4f84eff3be",
      "source_sha256": "f0742f1b04da8ba6e9d78e5ede3ffc721c2933a590da91f40a4a9b067aeb1eb7",
      "translation": "他们从雷电怪物身上，提取了某种，可以说是核心的成分，",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a8c60aae9bffd28a9b7ca1f8bd68edf4622c0170d92c6e00d834b3c0d450449",
      "source_sha256": "fa228ad47bf16850634ec87768e678ff1bc71b2081e9d1ec4273d939bf1c8d4a",
      "translation": "可他们说，那股雷电之力太强，根本没法控制。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f552e0f9d3770783c454977d425ca0d26666b78a7f9cb5b3d3e178996881d3f9",
      "source_sha256": "453bc81e6b303f52aa5cf4243c7a1190b1e2e5c838723f6a1cb4a4968f8608e9",
      "translation": "不过，露是雷之连环术师，应该能控制它吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a32665e7da4240f32867a955997ec958416f9d4fc75071e06ee52b3cd7b8ab6",
      "source_sha256": "b6c2a0a947589e2979776381ac8ba6aa7a03799c1f1f30962da1adda294d3b44",
      "translation": "听说，那个核心就在贝尔福特王城地下。"
    },
    {
      "id": "coalesced:209f5d4cd755bd8ee36741631add2816f0f7d18195391b0c20a70290097ffdb9",
      "source_sha256": "a217d2dc81b4c9fc621e662771117b5dc94b2d0e992f85ecb558ab86e7d62c04",
      "translation": "这就是通往那里的钥匙。觉得可能对露有帮助，我就偷偷留了下来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:58fbc4a943b763c010fb8c099e53303360fb79fdf32755499d3f7a5b7e002959",
      "source_sha256": "cef987fc6acd68f61e5f350dd8943f7881d6c6925ffd1e4d75ccf80cac539cae",
      "translation": "如果露不愿意，那也没办法。"
    },
    {
      "id": "coalesced:d14bedc3445012aeac46cf690079a64cce428c9873ea4db2e1de50f1795b10e9",
      "source_sha256": "5e33a77cc3a6f8ca8d88bd5ce6b9c9444e40cf71565a37d82a4d67104bab9f3c",
      "translation": "贝尔福特王城是敌人的地盘，一定要小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:569439554646124c038b6b0a949049097a0d096a07b3bb6353f42ac7350a2ca7",
      "source_sha256": "a9bb0519e15870adcbceda33530be8303c721718e6e10d2b602d6148c77aff4e",
      "translation": "请在贝尔福特研究所的房间中寻找[雷之核心]"
    },
    {
      "id": "coalesced:9cdda82a5d66d3bd4ee127746c9317b57855df57d0abb96fc8fe8b8a6b15ce67",
      "source_sha256": "5bcb3473cc053f023242299ce5b86574f71c064d5739a5d5966e18546505b15f",
      "translation": "雷之核心"
    },
    {
      "id": "coalesced:9d289d3f2bac137c98642be6d44eddc41bc8cd8f4fcc2b4f88da627fa487ba80",
      "source_sha256": "be62d9717055364dc6db0bc2d650bad63acb76ea9bc0468e8c2fbee0141ee9c1",
      "translation": "嘻嘿嘿嘿。好，好。再拿这股雷电之力，做些实验吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d2af612802a7a5d94afc0b2a364321b3ad7fed017cad51ec7a3debdc2ab33c8",
      "source_sha256": "1e6150833897be24cc1eaeb85eb6e38db8622f67d6c90208a1a0568a64a2831d",
      "translation": "要是再注入更多人类的血液，会怎么样呢？嘻嘿嘿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0aecd90d7513e2fc98d7b2c9f34f6fe0d269b8c3067a266747f8d3e5ce9ac832",
      "source_sha256": "7965c47cb02de066310e253e9c11bf5e72a58f96eff6031a1e47177b7be4a9da",
      "translation": "嗯？你们是什么人？"
    },
    {
