{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:c215c420dc24d6193c96acdb2b14932e8e588a9d0a485e75351ede695a482dd5",
      "source_sha256": "92829b52424b6b7c06e354daf9db7e4692d3dced509f335e8ce52f124ed275e8",
      "translation": "塞蕾丝汀！"
    },
    {
      "id": "coalesced:f6514cf6b37d3dd05728551d7a5a9de00caad4814780506c718148a0683a5527",
      "source_sha256": "e85c463d0affc8b7bb16a99284666e51e70e78a97cf44612a12d549f1a2c8066",
      "translation": "干吗那样瞪着我？脸都快被你盯出个洞了。"
    },
    {
      "id": "coalesced:759758144b2db350459ead66697c1593ae0cd4ee65cecc1bfd478228387dadf5",
      "source_sha256": "8bbc228d18a4f518e899c4675c76782bd2bc58995eacb70fe33fe272700548d1",
      "translation": "你知道自己干了什么吗？竟然带着俘虏离开村子，你到底有没有脑子？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf350487e140442d8b82996f98081e7c19348d9d7815f3602e8172c54560ff96",
      "source_sha256": "dbd13f90cd9fd0f8d13255c076758c4b5816f271e427c2731710829eb7969332",
      "translation": "别太责备塞蕾丝汀。"
    },
    {
      "id": "coalesced:6eebadfc6595eb4ff07b428b689902e95c446c76ab334f1622993cd6a79a3001",
      "source_sha256": "2c91d4e51f5a671fd3f1cd8355077f986658e9707bdd789e455fe48812cb3207",
      "translation": "啊，尼尔提大人！……您平安无事！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdefce4c51310a1592f7b614391c26e79ad6c21865b3d9e4af46295471356ddd",
      "source_sha256": "3bd6a9401adeb49f66283169b25b3ee17c1f225edffc5cf1a36ee5584be62478",
      "translation": "塞蕾丝汀带着这些南部军朋友，救出了我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:15757a7e8a5f64e220da604346a8ab032e76525e538275e33d8661b51e0ed318",
      "source_sha256": "eaca1340af0df9e28fcc5eef25ebb0bb52b85e02bd4877ad7820f140cef9f568",
      "translation": "如果没有他们，我们现在恐怕还被关着。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b053d527425c089bf00e33398a27436ca740055ea444086b2267e198858457d",
      "source_sha256": "f47440a96feb21d66ba8724a2d7bb2f436ba6ee576c0f37dd086cca53d1e1f17",
      "translation": "原来如此……"
    },
    {
      "id": "coalesced:23896a3b5b0667daae99c002d901002382ad5fb5ee87bc22834917f4677c4dba",
      "source_sha256": "86ae3a7077b42cd9b7dc9319e4b6f7dbb6152b773953fde1ba3d42bc9d065e06",
      "translation": "嘿嘿，我做得不错吧？"
    },
    {
      "id": "coalesced:15ef7eddd3d79034bd38228f88f7ac82d4e62a95287cf1136222119815a28834",
      "source_sha256": "73e59541b1d40baac845ef40c7a2a0b83b910151b16f3088a0babddb24b0a787",
      "translation": "哎哟……干吗打我？太过分了！"
    },
    {
      "id": "coalesced:181b36e5caa2cf9a6e81e9f322a76cd8055bc1c483426bb855e9fe2545200ac3",
      "source_sha256": "6db92819e56f02f2b6cb6efe1a1bd912453e96848b7db4af72e46cb4fa2c8236",
      "translation": "居然未经许可，就擅自做出这种事。这周之内，不做完100份香，有你好看。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b3e40be56a32f7a5e02149f53c3750b6b0c21464e388f2ce10ea3510d66354bc",
      "source_sha256": "399b76f51ce029334ee0d3e93b822beb33d92f6724205f37fd2c53abf3898860",
      "translation": "为什么！太没道理了，明明是靠我才救出尼尔提哥哥的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f62ff09ab7dd37d76abfc1b6afb00168cbdcbf30aff4122cb7cef6e8116c994b",
      "source_sha256": "5c9bab0b38a21807fc19ecae12e3e9af20770123e6aa14e22084ccce0292f880",
      "translation": "别抱怨，难道你想做200份？"
    },
    {
      "id": "coalesced:512b9066382c66f79647e52b14edbe95cddd0aff63d775183b5147c3a468a537",
      "source_sha256": "e9a6d4d906d26309051211d0b0015cae3bd5029b77a31938ffe3726db8174e63",
      "translation": "哼，真过分。"
    },
    {
      "id": "coalesced:8063e80d419ff4703f5f0a13147ce8078db49ff34aaf5c3b29536931a273c2be",
      "source_sha256": "d14fd32d55da954b8aa04d607729d47a3128b245380bf646a3651d5876663cb1",
      "translation": "尼尔提大人，请快跟我来，族长一定会高兴的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da5da97177b3502b6a79fdbbb8b45a353b6395676c194333417c1bc5b9b343b7",
      "source_sha256": "5e3d3babc5243fd4c38064e729eaf699b1edfc2955d86476835c81b07832cec2",
      "translation": "南部军的各位也辛苦了，一起去见族长吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4bd4528d8c78839de45dff45572520b9930241219bb2e6d4336eb72ad32f7dbf",
      "source_sha256": "c8a62cdef6d61c9e1d05bc31acdb4b97d5af61661046526d5cf5a3794990df47",
      "translation": "欢迎回来。"
    },
    {
      "id": "coalesced:69c0ae3ba562db30e9b24a836988e6e0f47cc37a28401bd7b85994aa03807ace",
      "source_sha256": "6092d6bce568ab0cabc843ea1df8269ccae6a91ecf3849bf5945c19d3175db73",
      "translation": "公主，您已经获释了。"
    },
    {
      "id": "coalesced:38518966606d9bc0216e6941a3447082901dbc51ce31860f305cab3c78912773",
      "source_sha256": "3ee966637432292388ef9cd3a60e3bac296965580e5a628755bd365225566824",
      "translation": "嗯，我一直相信，大家一定能办到。"
    },
    {
      "id": "coalesced:a21330ff2db6884a70886056f9f246c63f89f56780e3f26af4b01aa00a982e95",
      "source_sha256": "6ce369bfc76cb54d2bc7fc1ea7757ee9afd5f3db887d744b790cb8df355a9291",
      "translation": "母亲，我回来了。"
    },
    {
      "id": "coalesced:b2031d3837f87624bac2565f2bc86aff79caba628a33d149b487c8c80ec2decc",
      "source_sha256": "83dc6bb95805f77b9dbb597ac332b9327e8803ac51f2e17b64268b6fcc65ad78",
      "translation": "啊，这段时间，辛苦你了，尼尔提。"
    },
    {
      "id": "coalesced:cb9be806487b6a1656328f3515d92ad44aa2f4de47bd05525286ed4d3b1dc6ec",
      "source_sha256": "6cd9eddb805438a6091be3cb58c68a74abc0199eb0740e8a8e8c7fccc2da7604",
      "translation": "母亲……？"
    },
    {
      "id": "coalesced:0940883fa3a262d78c3555c37ca5368386bc9c62ed25793f6685aeb15df26fdf",
      "source_sha256": "58756ea08613f959a62c034c858f6237933682d834e7595750511c133162b69e",
      "translation": "尼尔提是我的儿子。"
    },
    {
      "id": "coalesced:a5c5742dca80ed0af5518c86cabc22209a127f42a8e919dd676117903ff69028",
      "source_sha256": "583ab3629bee7ca6293521f191cf6df61a9944feaf5a66afe8364e1617ac8214",
      "translation": "身为俘虏，竟然擅自离村，这一点不可原谅。不过，还是感谢你们救了马雷族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:33920ea0d4058ae5742a15ded87ddb6420ed2d4e6de748e48e950f88d1561dee",
      "source_sha256": "4d1e8c85799a7306721b77f162f3d3ee58ccd2247504b849ee2d1620f6076c3a",
      "translation": "希望这件事，多少能消除您对南部军的误解。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84fe4b46755433f5e5cdba910dc20fcba265a47c0e1fa32619445c330de0664b",
      "source_sha256": "b1a0cc39565d247607dc09499618d4d7f05705913b8a78ee9d929fd1705bac3b",
      "translation": "误会了你们，我向各位道歉。但我依然不认为，战争是正确的选择。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e96bb2ad310a630d9ce21a95a42c90bf944f8b0add218928505a65b61641d62d",
      "source_sha256": "6d03a260133b7ee76a6ccd3e71b4464e83f8b5fe5762ae7addd5f97d95727860",
      "translation": "不过，对于各位伸出援手，我由衷感谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba3497966b894bfe3730aedbeb1f6ef6c6e669035ea7778eaf061a74a266187e",
      "source_sha256": "2eaeec04c7bff9d377c40d1f35b8147881dfd1b48d37eca875acff4cbf2f4f10",
      "translation": "族长……"
    },
    {
      "id": "coalesced:866b9e93227c748ed22a984fde35b6fd9cece6574736fbfa247bdc2ec0a6ece8",
      "source_sha256": "c992f2bd309608610eb39be8247b0022444a2208ff47f1b22f937aee909d340a",
      "translation": "之前招待不周，我向各位致歉。今天就在这里，好好休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:62e8140e5cdcb94466b3cf7a7b61fa5b79bf40fc82aad383aff27f7cea9536aa",
      "source_sha256": "a31aa27144ba32fb13bcb8151c5e89a426ba34a635664fc330059b4b0e45de48",
      "translation": "去我家吧，今天可以在那里休息。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17136f2eb672c714ece07486042cb33c78208ffb593b626c345c3be65d726997",
      "source_sha256": "dde2529659d81b89e36561b5eeaf436320a7dd896191e8b991448a41cc4fb73a",
      "translation": "你该不会，又点了什么奇怪的香吧？"
    },
    {
      "id": "coalesced:c53a1629d38aba372cc1bab4105d2807599bde532904da373246ffbec7b57c14",
      "source_sha256": "65e3372ac091f4fbc3c9649de39762a16a3cb70ea8e3e3687cbfd35fd6f1554b",
      "translation": "哎呀，怎么这样？我难得想给你们做点好药呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e1d260dcf625a0b41d2874a0055a3c7a09037eb61ffbfdbbeca4b8f678e5f0e1",
      "source_sha256": "2d4d46320f4c250020eedbdd9b6d9042ce280d67fbb1601e15e61a4bd80bf954",
      "translation": "药？"
    },
    {
      "id": "coalesced:b97b4cd047fb58a4d7d5ac176caf6a3f7060754b233778f0c5e5c7777da7980f",
      "source_sha256": "716b69065dfce368d7fe8726dde4ec5d1485a9626b520839ae03f2a33c403d9f",
      "translation": "我们马雷族很了解药草呀。我们制作的药里，有一种对身体特别好的药。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0dc06d4467e05069cd62f6d78a2153397b21e3073b49a3223a1284ba423eb4d",
      "source_sha256": "bfae4ebd2bbb6da81db3cb9580f7e7bb4766647b5cf675cd82c6e9412a3c2ee3",
      "translation": "你们是南部军，经常要去打仗吧。我本来想做出来，当礼物送给你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09d705882d1b3cce747119d8a89aea4d4d87fb30519495b23a413cce05a94ffe",
      "source_sha256": "6d4f16b490949d6945d638eccc82fb2d10254c0353d02a6e22b4faf72e34ab1c",
      "translation": "哦，是吗？那倒不错。"
    },
    {
      "id": "coalesced:7326c5a3546048e94ee2051dfd8ded1148d92d6c9c99ca795f3344f9aaa71f21",
      "source_sha256": "99003ac594d2a78fbb19aa1be56fab2c8931c97e6e112a1e778e4d3c242c7c7b",
      "translation": "我看，你不如吃点药，治治那什么都会忘光的脑袋。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7108413915df627a2eec9d1597436c27e2c31214fbdaf52a22796f4c0a3e280",
      "source_sha256": "cb472e944eb4dac64647f8b43ce96fa80287aa5cb308ebea7d24eecf43beee5d",
      "translation": "那你岂不是需要长高的药？"
    },
    {
      "id": "coalesced:4d1c0e535b2b3193c0d9acde2b0fc19ccb5f643bab76bd54114fd8e9f3e29b62",
      "source_sha256": "3a2c28d3e2218083589727bad718afb0650b81bad85ac65bfab96c29212b0f8a",
      "translation": "哟，还敢顶嘴！"
    },
    {
      "id": "coalesced:22a05a3ea0a2ece09f1eeeddb4fcd318bbc5ea41bd2121f714d5e30300d25898",
      "source_sha256": "25ea01353e18f116026e03720aeeaf3a0cb4658405b5359a83a1e9aabdd5c959",
      "translation": "好了，你们两个都住嘴，就不嫌烦吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a07796e4a5e9f233e2ee3275c91856b64757f101b3378d165dba636c1010585a",
      "source_sha256": "ecae47c847dc1dc3b0563810dc3b278aaf07263a14c719e8f3d200ed6191e789",
      "translation": "马雷族的药，确实很有效。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19ac590a95b1396f59d17b76a1faa27e69ebdc1e3df535352c5c1ca624176ca9",
      "source_sha256": "1314148a037a17715df198ce995f2666ce98b2ac4bfa7e8cec0a680c4857f368",
      "translation": "那当然！除了治愈连环术以外，最好用的就是我们马雷族的药了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20ccae754291fe7b1362d9280de3a26b990a47059dd56352d107fd4e1993bdbb",
      "source_sha256": "2913f3080968ebc62e4125e08971b90d0a720e2de73a3e42e14d42944bae5c87",
      "translation": "不过，制作那种药，需要一些材料，能帮我收集一下吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f4d9c172aa8f08c002cfb0f7b6486ae54f7456f3c8e27619974f053b0c6cf2b",
      "source_sha256": "95b3044e227f6e580fd02004bde5136e456ae13f8993d47827ab7be21e33444c",
      "translation": "什么？还得去收集材料？"
    },
    {
      "id": "coalesced:6d079188abf1c52d73ce19eb67bdf4ae228ed70099837dc5fcb2e21dd3702795",
      "source_sha256": "24d708913449a11e05618fb201b56fcaa6c2276a8da8e441aaaf240bdc003d52",
      "translation": "那我还是不吃了。"
    },
    {
      "id": "coalesced:242b5ba6dbd7f4dbc811b8eae7b19c98615c3fd7aada1d9f06a1855cf7fb61ef",
      "source_sha256": "297b2c60d362d01167a80482fa58bc294c0116587b93c8a50d4c6818f14835c0",
      "translation": "哎呀，哥哥～只要收集一点就行了，真的对身体很好嘛。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7f71b0d7d63a5e6bed38a02d8c0a82669b4e70c85f10b12e0346c4f0eb767589",
      "source_sha256": "f78f78642dac6695ae69562d7e74b62923f2c8c22a85650b10bd3a1763fda9b6",
      "translation": "这可是很特别的药呢！"
    },
    {
      "id": "coalesced:b5c4f4763383065dbd19cf965abf5533bfac425da5d01a3475709f0440bff574",
      "source_sha256": "460ce587f7470d16ea6fd137358205bd8fe2bacbae858006bdd3a2c29145c987",
      "translation": "刚从海底洞窟回来，累得要命。我现在只想休息。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:abb1211858c4e889e242fda73ecfde302cfd62791b2b18f65234f1a99b3fd84d",
      "source_sha256": "d3747da868c3c9d8c514823b3d9cf972af52166c204441587d67be4630c3b435",
      "translation": "大家真过分，明明人家是特地要做给你们的……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2758ceee5a69341d6afe87ed5fda78043c0485a2f433e63db60dfbd1a6a1d705",
      "source_sha256": "4bb6d0572f0aa9240f58e875131650f18a4836a4acd03352be6f48fa2ed96a7c",
      "translation": "大家别这样，一起去收集材料吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d299abd6090fdff278b71d715c989820151a70ef2375cdc8b7110436afdc893",
      "source_sha256": "4afdecc374af0ea852aa82a0e86ff1b829f54f4a4920b622c607e0de2e356cbf",
      "translation": "收集到材料，以后也可以请她为南部军制作药物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c466b6e844f362d0da3e1bc9f7550cfe005bc13fce83f47e940f5c6d107e11c",
      "source_sha256": "4abfe39df1ca8b805fdbeacc02e5925d3772ef31371bda0f98c6ef17ad95473d",
      "translation": "呃，这个有点……"
    },
    {
      "id": "coalesced:28ba8a5907f618dc1fadcdb80660771c3f32fc73843ed840db3d314b9d0ccae2",
      "source_sha256": "fd7b0d2da76a76ea02c72a4e18e7490fc8a851a07f870761de786b99af42eeac",
      "translation": "为什么？"
    },
    {
      "id": "coalesced:7a088bee6c47c3d0e00e5e967cc6932f56e9d67d9052832a146f1998949d8d0c",
      "source_sha256": "40afd1f4c1844c197311141140c2bce77ec13956e72e09058ebbf28ea65ea948",
      "translation": "啊，没什么，姐姐。那我们去收集材料吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f08b9b74dd76036d877b31b9038fe398d3eec5a24390ce33f5cf939a8c7ebed",
      "source_sha256": "88d54a3d3383fa6b3fffc19b74cf14169e85d72c200ba76a04757e5a68a909be",
      "translation": "嗯……？"
    },
    {
      "id": "coalesced:759f32eeea04cd9c0eccf0904a85914804496e41208140343eef0d46c60651a5",
      "source_sha256": "1b521a0b80ed20b70c74a789ee0220d4b9f40bdc4cbb7aed6655638238e5f24d",
      "translation": "好了，那现在就来制药吧？"
    },
    {
      "id": "coalesced:f8a9cf42c2afcf8571081ba1d09c26fcfa01745c09c3a4d8de9fb8c8f5ebfc64",
      "source_sha256": "855d3625de5c02ab07c37940ae58e3fc5a37e0019f5acd0ad285683faeb85e07",
      "translation": "好了，完成！"
    },
    {
      "id": "coalesced:d5ac0c44826839c4972c0cda8dd0199aa5dea1f6a4be01ee0711e01ae926a64f",
      "source_sha256": "3b3ab0ad5343e9f25405ea4a99ab859913bc325b51722d286ba800e3015a25d7",
      "translation": "第一份药，当然先给我的阿尔戈哥哥！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:18c9d53d42789f5fdd2cc1e5c561214f630cf0a8afb2539b7acca11941a79129",
      "source_sha256": "8b21fbe6e4a229c7ec254798adb2ddb071d05bdd384de72917a29cc0386eeeb2",
      "translation": "什么？刚才求我们帮忙收集材料的时候，可不是这样。"
    },
    {
      "id": "coalesced:9457f4a11386f381547e78e22960c84ff0bb04892cd420530adc0f100ce90e68",
      "source_sha256": "874a4a867cb8de6dc024d5fd4d8833f516b8df857ba20dec48685bbaa68122d4",
      "translation": "哥哥的那份，待会儿再做不就好了。"
    },
    {
      "id": "coalesced:e5a90feb378a995c90e2a310860f1878b62d84d5fccfe0277e578c075275e816",
      "source_sha256": "e6518d9eeadd8870d1d96fca50b11a11f73498b5feb5d7aa53866b681cd4c2b6",
      "translation": "哈，你……变脸还真快。"
    },
    {
      "id": "coalesced:3f1d3e59d3e747a8968d35cdb77cfc009d3bcb41f4ea0217ae9fe0df55ca513c",
      "source_sha256": "6bb424351f09598080573557d4823e0e18888478f844243e1deefaf2808a5278",
      "translation": "让朱特先用吧。"
    },
    {
      "id": "coalesced:5370c0c11204fd6da86bf2233f6defe54aa97a963e3c8768482631a36a7d1ee0",
      "source_sha256": "d5edacbad13625ba12ca150d214bbc5bb046eca7972c8bb2dfb2c279768432f2",
      "translation": "哥哥，难道你要辜负人家的一片心意？"
    },
    {
      "id": "coalesced:b3bd7be590c0c8c8133da5894d7131b4de815f4fd82083894f6633f98d13abe1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:fb5344dbb846642898a9ff86389b8a1c8c82f8257b42d416f7733ed3aa30835d",
      "source_sha256": "97c37623ffa2e984a734264e8564cf7c06f21da4bd722bc9a3e2c3eab441c750",
      "translation": "哥哥！！怎么样？怎么样？"
    },
    {
      "id": "coalesced:369b48962eb1e3c031734d04b4cb3a293bb142badaebac583e37f47fab1299b0",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:bab47f173b92a7e8ba3d16b5f5ba827e767d723eaa5d562c311c86415f6c6cc9",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d128df8ed058f88bb8552f5ac95188138f49cd914010d61bf90abe02e5744457",
      "source_sha256": "1768acc7ffb29ee93cefa49dcde87c870ee4a6ee1b701d0990c8b2dd829a75c5",
      "translation": "该不会是什么奇怪的药吧？"
    },
    {
      "id": "coalesced:3dac30b519372323e334523077d157944253e6edb926a09e6f0c3ae525d4cf98",
      "source_sha256": "d5902c84384859a2597d43f25e64d92aabce81ce174a727e19abc95e1e9aae1e",
      "translation": "身体似乎没有什么特别的变化。"
    },
    {
      "id": "coalesced:043126b392e856b9ecf0fce8a861b34167bfcad48d0c10870c02c4fc2886efea",
      "source_sha256": "4023f7d3b4f8aec5568e4c926d856b318b2729cb46355debd45ea7d68fb8e960",
      "translation": "咦，怎么会！！我做的爱情魔药，为什么……啊！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ed246bd294499299a00801028fe960f0fae108aa1ccf2ba8f97971530b21c38",
      "source_sha256": "84b174e3691cbd1ed83ba7fedd6c30848ca42f10eda46cc320a696e3763d3a4f",
      "translation": "爱……爱情魔药？"
    },
    {
      "id": "coalesced:539f844b9c57112d79f8f807c968270c63637d016ac7267d5294bb642bc67360",
      "source_sha256": "2a656648b592e2479ff7459852feda1b4ef6cce0cd45dbb655055b70a9d2b700",
      "translation": "啊，啊哈哈，那个……啊，就是……"
    },
    {
      "id": "coalesced:382c79a3a23bb606206f98b0d38e6b69ce347edd6d77acec5a66a1cf5956e5b1",
      "source_sha256": "9050fe2a64f3f400539b3155e3f81bf479731e77a1e277c8c47a79e597663f3a",
      "translation": "你是为了制作爱情魔药，才使唤我们的？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:033df39f40cee8a5589478a39b19464587b8883fae6534abdd2e21b07a7170d7",
      "source_sha256": "59e33140a824d5daddb1c86638b965386d58dc799d93860c3996be3cbc36e39a",
      "translation": "因为阿尔戈哥哥太冷淡了嘛。可是，为什么会没有效果呢？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c417e3aa634e7854f3d7544f9af73d2cf382bdaf84f1057f94139d3f5c53ae4a",
      "source_sha256": "4be706989fe1c8914595204e6febce703229cc7a3a9d4167d0260825237dc71e",
      "translation": "或许对特雷瓦不起作用吧。"
    },
    {
      "id": "coalesced:19f30cc27d83e2b10d7c94b13469c1beaff009f7213d1c7dfa133664d9f0953c",
      "source_sha256": "3f58235eba0d88a02f5c017a26365053b330d2d83063ab2a2d555334e3919706",
      "translation": "幸好，不然差点就要看到不堪入目的场面了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:609eaa92160961d93a9854c3298562179e4970a05029ef29a1f0297a211f299a",
      "source_sha256": "4856ef16c614642b17708f665d0fec18af069149ee6a212790eea3c1fc66146f",
      "translation": "可恶，等着瞧。下次我一定会做出有效的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fef37649e2c625d3b175ef0ba8427cdf37a5f78e2777ad9cb2c4afecc4156ef0",
      "source_sha256": "5afeb8ef2015c7d2c39ba0f5cad423c9268542d6549074d3f08b6beb7f6ca433",
      "translation": "还做什么做，先为使唤我们付出代价吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4c57fcb15752b81377a6a1e341d838f550b3183bcf48a19c98057fe2410137f",
      "source_sha256": "692bb178c0303ad319f43e1547418235853b8cf83b2ce3cbc164acfd7cf59bdd",
      "translation": "哎呀，朱特哥哥又没喝，就算了嘛。饶我一次～呀～！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:094be76248ea1838831402c30fa4d2a6a95b6bc06d30777fde966a3c080da4f8",
      "source_sha256": "a738c834e81a06619601e7df923dc4d651042ea2d53db83621a2748778e6685e",
      "translation": "……该休息了。"
    },
    {
      "id": "coalesced:6f97a112af4ff562d6a7e98323383fd424ccbf229139aeeaec3e627f1e048cb3",
      "source_sha256": "87941396da582f6b4365c5759586975809eca55dc094b88e64d303670280a89b",
      "translation": "大家快起来，出大事了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3990621580c2eafa6ae0c51506e4a0314c9e184ea429fc7990a074cad0f8c607",
      "source_sha256": "7f033c4fae70d6f88941d925162c16604010b6bde34e26bc7ac93b43ec2e86b7",
      "translation": "……又怎么了？"
    },
    {
      "id": "coalesced:0bc5e26d78acf2fc2112859b1bfcb885f0f2757774eedb18911e3f39eff2ac09",
      "source_sha256": "9c71670e5466eae381251489b8d0e557eac05877fc44395f29e67aa0b5489745",
      "translation": "听说，北部军攻进湿地了！"
    },
    {
      "id": "coalesced:40896426cb6da88bf59184d4ec2c8e1fa28d8eb8a5d270c93283d8fac096095d",
      "source_sha256": "d253be5848eca7c8d7b8d09f73a1cd7a343d3a432df7decb05674d242f66f244",
      "translation": "什么？现在？"
    },
    {
      "id": "coalesced:d8f7f2c80a6827e4e85fde68c5a5d63a7c48020790852a5778149483229434a8",
      "source_sha256": "67e002e047523cc6d51b6437241c7df60e2a7d4749cb389b71617f4a06713997",
      "translation": "情况怎么样？"
    },
    {
      "id": "coalesced:802f42e8137113262ed0c41185d67cbf7b9d8888897ec43474aae17a0ef91276",
      "source_sha256": "9c03cff45ce67abc3fe18738f8ea8eeb8ad85612782e585cf1ef113a05be8536",
      "translation": "马雷族正在阻挡北部军，可人数处于劣势。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e3c34f6a6eabaafb822905731c040cd3648c4099b4bc6bf441c637a97c2a9a56",
      "source_sha256": "1d70b678740a95f77089c427f51eb6bf0f49adbc901e1a3cdca0554293eadd75",
      "translation": "要是用麻痹香，应该还能应付，但我们准备得不够多……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f320b37cd60a181fcb21c24b3cbdb3dcd912050da88a8a99cb36d3c4c89ea563",
      "source_sha256": "f6ed0ecbc9faf3507641b4b87710e7ad13453e7d3ac5154661a46d36f15af86a",
      "translation": "大家抓紧，必须去帮助马雷族。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec8f6334db0f5680f7ba8ea7f09ade497985e0e869b87e6967fe499140657ef6",
      "source_sha256": "4c35bcba47d1e3f67167aaea099488a2c5864112a8e2133a922daa56d0e2aa1d",
      "translation": "你们……愿意帮我们？"
    },
    {
      "id": "coalesced:d3bce76434eb7188572abb9305d8493e22e205c0f3e806ccfa14107886a41f18",
      "source_sha256": "61f2767599087443d288e9c3d8e85834a459ad66cea2a970b66a85cccb5c1be5",
      "translation": "当然，我们要守住柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f336f2554e1c603816f7cab3bf0e3e81ae73d094239801c92529f871d515c9e1",
      "source_sha256": "9d3ce45c98d9ddac07daa22f752ead87defe76c92fcb79bb6a3bb1832c9367fa",
      "translation": "谢谢！我也会努力战斗的。"
    },
    {
      "id": "coalesced:3d16a2c92018df68848b6ce9e5c49a81f7929f536437297d8f4b5a3734660872",
      "source_sha256": "a23e79d848837397d8db258a81d51a8e9f589799fd003b193b0922ce0942e145",
      "translation": "你？你会战斗吗？"
    },
    {
      "id": "coalesced:5f0dea7e77429210339d5a31b327e97f8368a4ea30248413b17d8f49c2fa1cfe",
      "source_sha256": "f5a3d00c4a7939445a867fac69d9e23e0e1bc1175ae6b198f9bd33a5971c814c",
      "translation": "别小看我。别看我这样，也是马雷部队的一员，专精治愈术。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09f22457a8a5e69f573d18aac1307bb6751dd8378408b1f57759a5bb4cd3e9c3",
      "source_sha256": "8336e5b62ea98730ff65ad1b20edc5ecac76d19e2adddd389f8fcfbe6838d694",
      "translation": "来得正好，我们这边，只有我会用治愈术。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:207a6914bcfdeae119d5c77b54ffbc85e3c8d1e2b4537d724dd65ec2c33d8390",
      "source_sha256": "1b2768ba7afbcf6bed5c265b0dfbbfc92cede6652aa90f6dade1e914df978d76",
      "translation": "交给我吧！"
    },
    {
      "id": "coalesced:2b32f2e4e9a238906bc40519001ab3a6698a44557d7e32e45405f33b83d7667f",
      "source_sha256": "6355ec26c67d991e36712f35ca390bb799c270588f2fb2cb367157f233f9b570",
      "translation": "报告当前情况！"
    },
    {
      "id": "coalesced:323049f7d61a97a53a596769fd33b06d5fce185a5595e0dacf096f3d37b3e573",
      "source_sha256": "e56a622b661b1ff79a574b9e15fe59c0302781a9779e36b2ad244a5ffa3b4dc5",
      "translation": "敌军在路障后方扎营，正利用连环术和攻城兵器，持续发动攻击。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e8809f1e7e366a68cff4b91f5785eb961fb3a270d8a6d3bdaf5aabc78b518f4",
      "source_sha256": "77bfaca817155a3d5d0a389d403f690c6f3463e1c71d535e14bf1af2f9df2968",
      "translation": "要突破到敌阵，必须破坏路障！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72022305e541311c16616b51d78036529cf0647cf2601edbbe77f9243a74e334",
      "source_sha256": "6ea3d4953b013b9540e1d30dd1c2d90cac96c54ccaf2eafb41ec9d8482b7b4e7",
      "translation": "攻略方法有两种，用火焚烧，或施加强力冲击，都能将其破坏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8cdf9e53b308d70e1ed978a1c1cc9f59ce257cbf3a3c1793b35fa28f7ddbe98",
      "source_sha256": "2c999d31f7f7b3d663ef5633c1af0e337fa7a81b704485cdf3a7666c84186cd7",
      "translation": "不过，目前我军已经没有余力了。"
    },
    {
      "id": "coalesced:32074788c9aeb09c013d91ded79db6ab899d2624964f9a69f65b0fc73e12bbb5",
      "source_sha256": "1ac2dbd173ba2a082708f31b01be66846bfeb0b51185c24231fe725bbdb33e3f",
      "translation": "请使用这个，对烧毁路障会有帮助。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5739bb20b2cf5da4e496cd0f24615e60f51be64675632241a73991fc552e0514",
      "source_sha256": "e90f6716c0aa5e6d34f7c808828ecdf43f9f90ea77cfd566159b034c81106911",
      "translation": "我是骄傲的猫猫族族长，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:624e688e24a7d935ab02a980dadc963256aae33431bfba38479fec4352b25ce7",
      "source_sha256": "aee963cb05eafa83f909960d4e8ee156d098d1ed179323c3b74748d53c20cc27",
      "translation": "那些碍眼的黑猫猫……真希望一个不剩，全都消失，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78b1e2c6021c82095c72edb1271c555902897a489f52c049194c313d34b06021",
      "source_sha256": "71d79de116feef847ff70174a2207c369d75562026f006e39d1d4d93f0341056",
      "translation": "这下麻烦了……得把皮剥下来才行……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3377c6bb9c491a95b9026cf7bd3a2bd19e50de3d55cb4f7aedeab215634d3c71",
      "source_sha256": "b975908474eadb90038e132dfe64ee8d5e61bf6a527040cef5cd3d8cd377428a",
      "translation": "我们一定要夺回老狐峡谷。"
    },
    {
      "id": "coalesced:77fd7993ed84d072121882eeb267d8e8c80cf715b1bc33ec7a0c2a41dbc8b5d1",
      "source_sha256": "e678e6148f9363adbb43b7d0b1128b584d7c3db29863cd5b07dfa13b94937012",
      "translation": "请务必平安归来！"
    },
    {
      "id": "coalesced:65f38ce05ff6e7f5eb1c25fca2cca0a4bef3f03003988d6499c06485d68ad49f",
      "source_sha256": "1cef8f5c017d66eb8d9952d9cc3669c9f8f2369b818020970f8fd91e80abd49c",
      "translation": "后面那道结界，无论怎么尝试，都没能突破。究竟是什么结界？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9aeb544fdb6060367fd587328aceb5f5bec79743fb296b6128e782c32b7821ca",
      "source_sha256": "d1a1c3d0336f9ef2c802232ae7e407d6b59c37aae2350a44452d1afd220557f6",
      "translation": "这根晶柱，已经由南部军占领。"
    },
    {
      "id": "coalesced:6ae73c810b7b62f0dfc6a279002996753e9473a9f577e2c5159dfc3c5213d7e9",
      "source_sha256": "4d843313750744901642a7b29b107633537d7507ea6a6bc5a90a1c0608819315",
      "translation": "请追击北部军的敌将，我们很快就会跟上！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a52986d4553dad5def53514adee6f07edd7bb0a961c239ea783807f3d9f2929",
      "source_sha256": "6b3287352869461ff98919617dddb88a8597b3bc23106b549b199e909e482413",
      "translation": "我不信任人类。"
    },
    {
      "id": "coalesced:1cd8a856922341dcbefea54170c35f75a26cbd121e1e8af6443ee7de2fb843a9",
      "source_sha256": "febb8567f1dc36b73024dd2a2a86322b624c44e187b8bbeb88886fdb41f110e2",
      "translation": "敢有一点可疑的举动，我绝不饶恕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3ee4052ddc0efc0e5de908f1cd6bc7354024ce8f096038d0042013b62388f612",
      "source_sha256": "a320105029e4983f5f953436bc3c455e5f15574daf1205e62c0b38115089d3fc",
      "translation": "人类受了帮助，却连感谢都不懂。当然，也不是所有人类都这样……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a503e2427755e33fca32439d07250cfee55240c624c308ea05e1f7a256fa24a3",
      "source_sha256": "b6b953a8177953b971187297c4b1c0950ee1abc0bdf7abbadb6313857923a385",
      "translation": "可每次看到那样的人，对人类的失望，就又多了一分。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7afaabf50c07bf2c14f161e5cf2dfdd509a28dab078cc406001cebcae177c2d3",
      "source_sha256": "72ebf0ac338d9438cfdecb7398965e246130f849e7d6fca4f5ab2ea1458a3b9b",
      "translation": "马雷族讨厌战争。一千年前的那场战争，让许多马雷族人失去了生命。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bea2c3e685e57ad72a3a6f428af559cad1e830ccd6c9fe009b485074a1a6e42b",
      "source_sha256": "b07c722a995da83f59d5bf7b452046183be00a811889a529028f990be7bff282",
      "translation": "马雷族原本并不是人口稀少的种族。"
    },
    {
      "id": "coalesced:2b16bdae00eec7d2a3a927cdccf11ccb2cf05325fa14337b6c70910532cc2f43",
      "source_sha256": "ce34a5438368de9475bde7c4f7179ebfa2d70f2978171ab07da36eaf902c9388",
      "translation": "别跟我说话，我不想和人类交谈。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9918df8f86f902547a13dc23ff7c4fc344298c76231963d5a52abca54b3e7393",
      "source_sha256": "8dc511d33aa73f624500ae05ae936db1266ccbef51f094e0addbddf3f02ec7b2",
      "translation": "你们打算厚着脸皮，在这里待到什么时候？"
    },
    {
      "id": "coalesced:719bbee16284d7f86dfbc8672ffb92b891eab99d8e51ce52885a59508baf50d4",
      "source_sha256": "22c9108854a0f821ab49ffbfb32e1666734658a1750d5cdb5a90093369d2dd3c",
      "translation": "人类来这里干什么？敢做可疑的事，我绝不原谅。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f9ba603059e736b4414fb8841241e56b6ebe88396aacc7c1b8737e052d2b9c0",
      "source_sha256": "97ca45847721609edbb3d3d7dfd3acecd18d7cc0a735b69d7ff4cbc8f3cdb9b4",
      "translation": "呀啊！"
    },
    {
      "id": "coalesced:071460a98c0d19d61d859ac9d929587d174e3d9938eecb67ef592247f381c71d",
      "source_sha256": "ed62b4119a20b975253b2d0db8936779082e9a0436b765a1b2687464cd1c08ed",
      "translation": "你想干什么！别碰我妹妹！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:541496667d1c14a7c2a8d3251e86e6542eace9eed370a136fce35c49b1d9a898",
      "source_sha256": "0d070a79393b8e907da2971173042d2f8d4501e243d9546dd00fdab753b71901",
      "translation": "哥哥……"
    },
    {
      "id": "coalesced:1748e5dfd75a04361f47b13a67c01add6e811244c9ff184511f21ed41d337897",
      "source_sha256": "23e15a91671ae3c83643fc7095000238c2f848f8d89cfde96e10cfedad6af216",
      "translation": "敢对我妹妹动手，我绝不饶你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff19d48787389c2c187af6222f59243d970681e3f9a972a15dcfecc824b1e981",
      "source_sha256": "225e2cf107ed86c68d4fc7540fac406e2e6915286e92de1c1264b7d739264b66",
      "translation": "虽然偶尔也有好人……但战争开始后，人类似乎都变得自私了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3622ea3d70def1c31d0582426dd62745e61955ae87ac26d65b329c1d4fd8b893",
      "source_sha256": "71105a817e0a807efd088cc43ae8b689d3d8f0d5d9872ac12b57edd227ad84e7",
      "translation": "干什么，为什么来这里？在村外欺负我们还不够，又追进村里来了吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:36f7faeaeb8cd6857ce7d8e25ab743b1c98b06485d7e7233cbebea15e867f357",
      "source_sha256": "c591a0f2d6b2eadc442c4b080f66f6d66f3e155e5ff4100e32f6651f30c70471",
      "translation": "要是还想从我们身上敲诈什么，我绝不容忍。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4e783e8ecdbe19ca728443ab2c5b2c0fcfd5eea56b5ada38cc60935889779b9",
      "source_sha256": "554cd9b7668b37a497883709a7feeb4b0a929b0e39ab6d8d512a34349a05146b",
      "translation": "阿维斯在柯塔马雷，也会做生意哦～"
    },
    {
      "id": "coalesced:dbb3c249c6110f69f0c34125bfede38640fa5d8dab535c7c4da475a9bc013d41",
      "source_sha256": "608d6554a0cf89fffa81c9c7b0011e7a6659f03c6c4e2ae2602e5a7e750463b8",
      "translation": "说起来，最近好像没看见行商呢～"
    },
    {
      "id": "coalesced:f5800c50a8322aa05366d81092a082c9e869ec7308932973b29f1f477d8ecc3a",
      "source_sha256": "5fafd4e65017d642ecb7dafecfb3d01282f384541109753180b21700668cb98d",
      "translation": "不知道是不是出了什么事……真让人担心～嘻嘻呵～！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8271857e914d10e818c8dc6d54b9e979ffdaf6517165180017d0531035cbf0e1",
      "source_sha256": "d9aaae393fbc4a2b96d3f3a837a1cd88e8aa156069f0349861d22d525689c6b4",
      "translation": "从这里起，就是马雷族的土地。"
    },
    {
      "id": "coalesced:01bb385c4d3cef4bae078ff3e4dc749d6b9713f66e98e66bef79b9b1be5e7677",
      "source_sha256": "5afa6687a98e2c89cc9b2f9939ded32c39636f22d33516bf69b23be6c0d6cf17",
      "translation": "我们是守卫柯塔马雷的防卫兵。"
    },
    {
      "id": "coalesced:5d95e9ff1e40985cde9dd155b49026c28e7aaa30b4292d900ad861cffa10f227",
      "source_sha256": "106bc475a0460119aaeb9f26b256960b10102fe0108d06aef8b72809d9d31f42",
      "translation": "欢迎下次再来～"
    },
    {
      "id": "coalesced:95d24228c21665dff92918ee404bc4e507e9a214303ae61c4a15e789dc8a8995",
      "source_sha256": "37ab7d549edebcf8c241afa1e2c9fb467efeb98ce237652267739581729248d5",
      "translation": "真是太感谢你们的帮助了！"
    },
    {
      "id": "coalesced:e01de61e321fa5df3737187d18deb163dfbea9a6559a5a8cbb2e741ad9ae8c5a",
      "source_sha256": "76f4389a298b3595342dbf37516816978a134fc85f15d98d68a76b495ba5070c",
      "translation": "这里是商店，欢迎光临！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e40294fa93f11f5232d6ae5150aca840b609cdfc9f42a10c8ec7f5078e6aedd3",
      "source_sha256": "82786d10440d208f75a5ac1c9d5e1430547f96069876d7cfde906b26d1226aee",
      "translation": "我听塞蕾丝汀说了，你们要去洞窟？我会瞒着族长，帮你们一把。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2a741ac6927537fd7c9b3ae39ed3a1a9e02a3c006ad263f65d4fb4260619c07",
      "source_sha256": "687c6e2466eb4e2e4da52f8047431a2be2c0f9688ebc652637b0342d3ae1888c",
      "translation": "藤蔓就是那边那个，用力踢或击打，就能破坏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03456934047c5bce748a0d9732dfb832c83b01ba7ec3d380f5b59b7432e56381",
      "source_sha256": "5beaf6feb8b0d9a647fb2f6e624743691f37c778b1dfd2fb041b1fbbfa933183",
      "translation": "嗯，这是应塞蕾丝汀的请求，才特别帮你们的。一定要救出人质。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17bd36f41248ff044d1aca44cebbee77d32a1e8a7e23f25b98602fca292165ba",
      "source_sha256": "19fd152e50ebb40d2ffdf64de3d35fefa36f19e4eab5b010df5b1d68b61b123f",
      "translation": "自从加入南部军，我就没能好好关心父亲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:403ccaa50a031dd4ecb26848cfc95052de5e640852d2b4910541c22f36328a4c",
      "source_sha256": "ae0efd100dd0792f1d7a986b4c9055b4ad328a6b7b573bfea4d89da3d2cb6b0d",
      "translation": "所以，也不知道父亲一直那么担心我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc41699068b586eb8998fd05f18e61948ea98f99dd477c8c5362472f7f425920",
      "source_sha256": "2935bed079071c409f82712d2c5f8dfe9b7e4297d0eb8b6ffbe5d5fa6290cd1d",
      "translation": "虽然很想立刻去见父亲，但现在实在抽不开身。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f36fb0c5b89714c3f489ae9de6026b73d9e3bf697769119af4aff79f958b5395",
      "source_sha256": "9a57472a2ff331d1a19c0b4547ade7dd8ce8edba7ba434b6bddb099ec9ad537d",
      "translation": "所以，想拜托各位，把这封信交给住在阿巴泽特的父亲。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4943a15c3ddabb0ebf2993776082a06a17f73e0542f25913bf0a49e253dc1d94",
      "source_sha256": "01e5251483d2071bba389aeb3001829524b03b2b20e977b3206f3775081bbd6a",
      "translation": "拜托了，等时机合适，我也会马上回去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a7979a6fd9ec2762fdefaf8b4058a76c857cd8e25fe3cf99bd27831b29459d92",
      "source_sha256": "ec51efe9c1424ce969c04c81872e5d7c0e657fc6829211005c2e124f407edd70",
      "translation": "嗯，那也没办法。无论如何，还是感谢各位救了我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:380d81ac929c2ab51e2443bec0ecdecf4e2727b215d9e1cfdc7179260358a7a8",
      "source_sha256": "177ba23d6bb626dc25b5c063f76906ce1c99afaec7b672c9912eb8d7b0d448dd",
      "translation": "那么，我就先去与部队会合了。真的非常感谢各位相救。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e959c7eaec4f92aef75437e2a6aab748bc42964666579746fca71abb214f704a",
      "source_sha256": "ec2f0c3812043336e645ef42f3f3ad31a446d254af298fea56ad27408062f8cf",
      "translation": "胡安……胡安，你们救了那孩子？还带来了信……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:701df384fbc1953391a868d2097abda991cfb143e6366b54372d67edf393c438",
      "source_sha256": "4273bf1110c9314f3482ef1dc40f7ac00d3454ab5326d9fe701a71ada0eda532",
      "translation": "这……真是太让人高兴了……"
    },
    {
      "id": "coalesced:23242521201bd13f66dad24c8ddb59de6622b909a382026ae16fdabe80d78b8a",
      "source_sha256": "a0c5c876becaf5bed26b6acc95d4a2a847a4452cda173494a8d27d65adf4b125",
      "translation": "啊啊，看来老天，也并非那么无情……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab7e4d58a92f310d8abef9bb230b94cbd978b8c9cceb85e6684655f8eb280d24",
      "source_sha256": "c32e49527a2087de6167fb624ca52fe394d89e223362f688dac62ed473e34860",
      "translation": "真的谢谢各位。我还以为，就要这样，再也见不到儿子的面了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8a8b0648ef17a05961dc5fc723ab1c97558e653da8974a94d267b55e497d1fc",
      "source_sha256": "6da09bdce07491b5dd1b00055949e5304ccc8721f2454cfd72fa1079d8c65336",
      "translation": "受胡安所托，去见住在阿巴泽特的胡安父亲\\n将[胡安的信]交给他"
    },
    {
      "id": "coalesced:29b22daa60cf1301f9f3ac40b4c04ff2023d40d2587c367fb2a59d5733212500",
      "source_sha256": "92754713de404feca25904d0676650c6ce38a25c2ea5407519f1329bc116076a",
      "translation": "胡安的请求"
    },
    {
      "id": "coalesced:e554ae6972d08f3f156bf73e64aaef6f7934def8f5cc1140d06924b7c54a7bfa",
      "source_sha256": "6a988702ba707ac1a6643c4fdcd3a6172904722c1285c3991811f58c7fa3768b",
      "translation": "胡安的信"
    },
    {
      "id": "coalesced:80716e42afc42b0e89111112ba273d6bc96156a28c5a6b710e17507ddf169c62",
      "source_sha256": "60a5a11bd1d3d60d1ebdcc02c615452221c69900426919c9fa224f6871505b82",
      "translation": "爱情魔药"
    }
  ]
}
