  "input_sha256": "28ec26786f3cb1e82cd66983a14c6aa4bb0538fffe5b2f1cbf9d0948bf7d4c8a",
  "entries": [
    {
      "start": 9508,
      "end": 10533,
      "source_sha256": "84250fe15c971f7389eb3b42efac5c577e24a6f951d99f1e2904dbc2a9d8c62e",
      "translation": "那家伙是！"
    },
    {
      "start": 10755,
      "end": 11789,
      "source_sha256": "cd6d87ce8afbdc70ad7095b4839245de01eb531a01e90767f444e63d552eb41a",
      "translation": "修恩扎伊特……！"
    },
    {
      "start": 13107,
      "end": 16420,
      "source_sha256": "2a9770ba2c60d6504f84add4d0304c03dd08a4b5639645eea76d7b7eb84d21ed",
      "translation": "冷静点，洁菲。<br>现在，必须忍耐。"
    },
    {
      "start": 18851,
      "end": 19592,
      "source_sha256": "f7a10bcea5ca1ece64260871419f8d2e3b5cb10361e648f4dab43e783ed3b7f4",
      "translation": "哼……"
    },
    {
      "start": 20970,
      "end": 26701,
      "source_sha256": "58075b41ffdebbe819e64d4ecd61a668cc42d983f564862592b5cf00f90d3385",
      "translation": "公主亲自来迎接，真是荣幸。<br>我也该回个礼吧？"
    },
    {
      "start": 29369,
      "end": 31102,
      "source_sha256": "422e75a675c39c2f8701d902530613d1dcc3543c3313c23c6d9a98f6eb4f3f3d",
      "translation": "梅、梅莉莎！？"
    },
    {
      "start": 33951,
      "end": 36266,
      "source_sha256": "191434ed22275780f1cdcd1871d598e4596f520a97b6df649690fe4376b474bd",
      "translation": "后面就拜托你了。"
    },
    {
      "start": 38003,
      "end": 40917,
      "source_sha256": "812cc700ea525afa54c2875011fd3a5d51e35af7010ca42a8d456d545782c5f7",
      "translation": "你……为什么会在南部军？"
    },
    {
      "start": 41194,
      "end": 49169,
      "source_sha256": "7b26e7e17a2b8b69d49678516f40fb4fecb124c3a89d2ff0b9a80e83adb26494",
      "translation": "我、我……以为你已经死了……<br>所、所以，才想替你报仇……"
    },
    {
      "start": 50186,
      "end": 54527,
      "source_sha256": "ac5cd4036b68c1c3c5f661b9c2cfd042f4679a8e43682cef332da3651429402f",
      "translation": "可我就这样，活在这里。<br>你已经不必再为他们战斗了。"
    },
    {
      "start": 55299,
      "end": 57034,
      "source_sha256": "25db3893e563c3a7d010b9883c4860fa5c514fe9ccca89fa0629abc9a9f9d5b8",
      "translation": "你这话，是什么意思！？"
    },
    {
      "start": 57390,
      "end": 59332,
      "source_sha256": "46d8b836438459d968d94f8150491817619ab03ad6b62af14cdff8fe788110c8",
      "translation": "到这边来，朱特。"
    },
    {
      "start": 67925,
      "end": 73603,
      "source_sha256": "ec5ce23177551899d7eba103497c1e07424f939ba68167c9d4685f2733207af1",
      "translation": "如果你不愿意到这边来，<br>我们……就是敌人。"
    }
  ]
}
