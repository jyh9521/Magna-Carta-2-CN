{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:ce360755fedc9ee047ca0b31bfe9cd0fb327b5e28dbdbd693294514571641578",
      "source_sha256": "e6c5a3e609c0d6a3404a1b12746ac849e1c8442659589dbba2829962b13f7a0f",
      "translation": "采集火焰草！"
    },
    {
      "id": "coalesced:72299f99c6ab325ddab4ea865122f23b4354461351e73dbe2f6c77881bdd8890",
      "source_sha256": "26557794858af9f2822d379ab6cbea106b096a8c7a7a6984e89b0390d8dc0a45",
      "translation": "下次，恐怕会有大批北部军攻过来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b95d1440702429f6653450dac06ade92278e83e8f0be50bcec47780c7dcf6842",
      "source_sha256": "4511787149685d912939c94f08160ec10db3f9ece733d3d1f5436a7011e0eed3",
      "translation": "要是不提前准备，光凭这里的人，是绝对赢不了的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de0036c7f98db6a4923f1fdb96856d4fa4134dfdd8a2ce8bc24ebf703977b7fd",
      "source_sha256": "78fe32dab3c1531bc8d1cccd6c48c44b9dedbc7f2f7473cfb80c7b62ef93bed3",
      "translation": "所以，我打算制作燃烧瓶。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c78a3cb35d0727460eb1884ad75818fe352c6e432c098677f9984db616754963",
      "source_sha256": "a233efb0fca66f9fd13ec3083a689567c525b0d60f9afae417a2b5ea1ba953a5",
      "translation": "万一防壁倒塌，敌人冲进来，就能投出去攻击他们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8f8faa84c76085f43a271e7b9e4d52b9b1d21f63c37bcfcea806614be9f03d9",
      "source_sha256": "c65cb30dc3c4f05977e93fbfb787a810b3bde8483a39d953357ff7ea2bba7de9",
      "translation": "不过，制作燃烧瓶需要材料。现在，材料已经没多少了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2b4a2e6c6975493a28843813b5461454725277c62080be3dfbe57360b267250",
      "source_sha256": "36516e02bf4d3f986b9d10ec7ba4184384aff50ad91f27c1713d449eab4f25c5",
      "translation": "所以，你能去找些材料来吗？是一种叫[火焰草]的红色草，应该就在这片海岸附近。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4079dc0aaed22a9352c536b32ead2203ca46be66c264f7442aecae9da51c85e2",
      "source_sha256": "21e8c5bc8f611a788ef6b834ad74b132606b009b2c94f8700a55f0451c272d10",
      "translation": "采草的时候，要小心。动作太急，或者太慢，都采不到完好的火焰草。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b29b6d5bf62f5c2ae4590c3e7b9dee086fa976023fbbc69f0e7c3f6bb653bfa",
      "source_sha256": "e32cdfb972904ba232fba34b330e6d39d67732ff3b61271309efbb2f4c4759a8",
      "translation": "得用适当的力道，才能采到。小心些，帮我找4株就好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8fde80556ab451cbeae9bd62d49b410b768b36efd616f63083d156589356a956",
      "source_sha256": "2045e8770f7b58e041ab8501c34571160703468641fdc96387cf6fc6eacdf014",
      "translation": "好，事情很急，别偷懒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47ea63f04c28772f287b3c60d5af0764ec497aa150dd0fd03d226e1589357f2c",
      "source_sha256": "fab19220efb0b63d8a71766b0ef81364d806654b56490d6b7541a3ca6977feb8",
      "translation": "说一遍，你就听话嘛。"
    },
    {
      "id": "coalesced:8d8aeba3f9751e54d60e9e998aa1e09f3d796742a61fcfda6e2bb9b6fa8e838f",
      "source_sha256": "6dd93ca0f866831f95d32dbce60d4fcf3ef235a841c7c822a17ca79f4b5a465d",
      "translation": "快去找4株火焰草来。得抓紧时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:697502327b767d8a8b8ca58f135d7f410f9782ffc028002c63c7dcb01791692c",
      "source_sha256": "a8f6b990a93c0b81a8463f435f7a6a3a9da22587c903f142f3d64bc25ce6afab",
      "translation": "火焰草带来了吗？ "
    },
    {
      "id": "coalesced:f7a94ff694bb83c630c4d3e79d727e8af253e680df8594b6da96416d68472fbf",
      "source_sha256": "12f49692e0dba52c51fa5991c99b7a4a610ae055735dad0ac372913fe1746eb6",
      "translation": "等北部军攻过来，这些应该能派上大用场。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca93b061b9beae0c47dfa297bb4be21fe9aa24e3ff0b1bd8f96c71ecc04f22ae",
      "source_sha256": "219a116d146105d44e418fb2437fd55a1efbc485f7cdf1eb0e8c744c86d9c4bc",
      "translation": "到时候，这件事就交给你。既然拿不了剑，做这个比较合适吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2287f2e3dc59d732ab91a065304f2b0cb18e91cb08fb4e78c746119e0d218aff",
      "source_sha256": "5a6ddbb1bbc33d39ec8d28c9df04769dfbad87af56c4493f494594cecc520ab2",
      "translation": "当然，最好是别有那么一天……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de1c8b4425da844a07eb68a54e8b614bde46f4ba590e42988341cdebc5eda621",
      "source_sha256": "9a122c1b935d05ccbbf9a31429ce54ae6dc89a10f2097667d50611cb8735210d",
      "translation": "采集4株[火焰草]，交给梅莉莎\\n海岸各处，都能找到火焰草"
    },
    {
      "id": "coalesced:c1665df4bd23d033e1053245acb35a6d97c4daf818cfeec88f3a4222559427f2",
      "source_sha256": "386cfe44caa51d5f09f7af87cc4500cb589d0df1487c95d036eb21763dd61c6c",
      "translation": "QUEST%s: 获得火焰草 %s / %s"
    },
    {
      "id": "coalesced:f573aa3407cf859047b4b03322e04f14a44b8812929c28370a12e6b20e822a0d",
      "source_sha256": "f48c531d9a6c69fecbb5a55248ed80119aa5a63892b63ad4a78888f2886a5126",
      "translation": "QUEST: %s 开始"
    },
    {
      "id": "coalesced:cffdb3456a7d0bea178575d225ce2ff51ff49261b5010aaff950d55786c3b96d",
      "source_sha256": "11304b5710393e3b6d888d7091f1549fe2c84ff32f7018f1bda905e4d802870f",
      "translation": "QUEST: %s 完成"
    },
    {
      "id": "coalesced:6c0313fc857f030f42209f91165332e18296690ff3c7e8610e541f848c8e8bc1",
      "source_sha256": "8f1f8f8583cca7b96a9f635176d8f1ac18b745877e32e1f25d5adeee1b6b2082",
      "translation": "获得火焰草"
    },
    {
      "id": "coalesced:8c0e86ef9aac86b2605d627614653a253021c98c16ca3f4502d87effd69bf5d2",
      "source_sha256": "92f473bc82d13181f48773aa2037da68f40847761940bf388692be79b4b15794",
      "translation": "送工具"
    },
    {
      "id": "coalesced:dfdd0f30e8e1a0ffc2928413340ab6e2d0e6cf04f428230c56fda7aa76ea6a75",
      "source_sha256": "b2e00b47978bf5adfebbc80895d121410c32f8456827898da676f3ba17441cc3",
      "translation": "刚才，比尔特大叔，托我帮他拿些工具，",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df32020ae2aaebea6249b59c6742c8b2b9b7e78ebda909311cf4ad84fa0be88c",
      "source_sha256": "c734b0f2f82adfa662cd820332b4ff8efc0e656d3e0d11e46294c1b5661a4116",
      "translation": "可我实在抽不出时间。"
    },
    {
      "id": "coalesced:a657a2f2a33bf88a47e22d5dbd66209cd73f365cb4578d1db0094895e8a49418",
      "source_sha256": "0e00f06aafb21d2fd35c609ac5df1f64f85563fcde93773dd885fda7dbc937c1",
      "translation": "我把比尔特大叔给的钥匙，交给你。用它，应该就能打开村长家前面的箱子。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8e62a4e516c14c9c2c3560254b5cea63772d281f23f6b05ddf5aa3ed516edb4",
      "source_sha256": "5091f25b235534fbd3cb054da933218905f25d17b961ea84d5035930e4a8256d",
      "translation": "从里面取出工具，送给海边的比尔特大叔吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6304f2ca465074202bdeaa6a8913547ae5c84d3a2baba2189c3e966a5ce6cab0",
      "source_sha256": "99ea006f5adb8ade93d2d2febd6340f282e21228ea7622032331809c912a8fc3",
      "translation": "拜托了。我实在抽不开身。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:200b408d70eaabbf0cead8b6db7bfa6aed64cf6ab0d2f4d10df87a77a703bcbf",
      "source_sha256": "d9dbfcab7ea57b76dc0c83a94797a28390f2274703e8fc5aa4ed0539289b9c21",
      "translation": "好，拜托你了。谢谢，朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b9eb6aa3ab418d8e9d3e6eab3ea9730e79121d2d59bfd937b14f027bad66d8e",
      "source_sha256": "26bba2c1a28544e3e0cf2e88eed22cfcf9ea27cb9ced930dec3e435974143cee",
      "translation": "你也忙吗？这下麻烦了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aba85cfb0d60456126c95aab3c9b92953e5de1cee643348f3c920871dfefe589",
      "source_sha256": "26d146e32486eaa2c9978aba5c586b55a397a309e8e7bb618bd9d126cce4b09e",
      "translation": "从村长家旁边的箱子里，取出工具，送给海边的比尔特大叔吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d31bc3f175530275b0379e3c2bd53e709e299a62242561721a8a78516df4005",
      "source_sha256": "8f1b5073ee9d849ed093252db657408583b811a663f73cb2649f4651803b1d59",
      "translation": "哦，是朱特啊？我托海因格尔去拿，看来，那小子把事情推给你了。总之，辛苦你送来了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e2d9c96f6e63c85a23295b99d320e030fa7bdd99bf19439edd405e7310db1fa",
      "source_sha256": "77d8c8395a511b8e2887877c0d27e4e396b300b60656362e9497f8a5ff4971cc",
      "translation": "得赶快做好才行。总觉得，有种不好的预感。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bca0f456ae19aab45f07c4dec38e8a100c8b312ec09fb9adeac24394cd5ec6c5",
      "source_sha256": "8971a0f07e6dbe2b8f6b00681f45e5eb6643667b994e2833d5aa447cc9914972",
      "translation": "喂，朱特！过来帮我一下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:768f77c007ebf7a46425bf134c73865e11e1373b2c14c82402df7d83fca2d991",
      "source_sha256": "ae811be16ec393eb0e2afbfb6796ee3045ed110bf4df9ddf1405ff11148c2928",
      "translation": "请将[工具]送给海边的比尔特\\n工具在村长家前的[比尔特的箱子]里 "
    },
    {
      "id": "coalesced:2243a689ebb755e98b6d21b7ee0afd14f1cc451912efc0af08cb34fb7b6e2681",
      "source_sha256": "2c6b5e3760b08d37fa28fbaff94468991e9b87f9816a69d88f2d1aeb9e8dda9f",
      "translation": "QUEST%s: 获得比尔特的钥匙"
    },
    {
      "id": "coalesced:a6fd06499fc780659fe3fdd3d79bc34950e6ec003e8916a29fe91d7023570d34",
      "source_sha256": "58d0ccc92269697f282e3e8f8f42f9a16bdcec419db03b95168de8df4575801f",
      "translation": "QUEST%s: 获得工具 (%s / %s)"
    },
    {
      "id": "coalesced:1d0b0e30a5e54407e01f2d70482ba57a5e1f7e245e4b39bdcd9457ee5baa3883",
      "source_sha256": "bbb19ba054272beb971acee6d54ba31d708aff8f065be9ee67350053bcf97b81",
      "translation": "QUEST%s: 获得陷阱材料 (%s / %s)"
    },
    {
      "id": "coalesced:73d29a87ba113841d2a1b887d1acaa6824af4202c59d944f12e1f6efb8878e8d",
      "source_sha256": "f48c531d9a6c69fecbb5a55248ed80119aa5a63892b63ad4a78888f2886a5126",
      "translation": "QUEST: %s 开始"
    },
    {
      "id": "coalesced:d0632182b0c3988e1f2e063dfc0aecf565ddc410e92808df7caefee97fb10bca",
      "source_sha256": "11304b5710393e3b6d888d7091f1549fe2c84ff32f7018f1bda905e4d802870f",
      "translation": "QUEST: %s 完成"
    },
    {
      "id": "coalesced:6fb0df198c9416131fea4e01456d1d43cc80aac00131e6ba61a6362a522f1780",
      "source_sha256": "4f313a93cfca436db916d447f61cde425feb412feb6372122e5e3bd79882d30b",
      "translation": "工具"
    },
    {
      "id": "coalesced:2a0cf4882440cbcf482c27f752ca7706e740aa755d3ac9ba2f31365f77845b72",
      "source_sha256": "7eb5d1e694f0f08952706cf230f0659a587b8d4086e2103f7b89de17b478fea4",
      "translation": "陷阱材料"
    },
    {
      "id": "coalesced:008b9436120d8e533c0674856dfe4b227482dc29dcc85188c16dd4e7c58fb3c4",
      "source_sha256": "58c6e8e934b4870c893348f3c1cce2dc5c41b7d8a22bc386e6b24e603a7eaccd",
      "translation": "朱特，既然来了，也来帮帮这里的忙吧。"
    },
    {
      "id": "coalesced:f29ab877b5160fe44aed4d863613be1364dd8be06b15612520b27d5b5f8535fa",
      "source_sha256": "5a811511c9c88a28895cad87ee0134e72390050eb5d0d34e6f2e9b1f27ccdfed",
      "translation": "要是北部军攻过来，我们也得出去战斗啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c7012ecc25893ec1c14492eb120f5c703d7e2fbecb8279d5990237413f1e0ba",
      "source_sha256": "e4acddb84698ac82d1a98a1019d0b1d55338f25ea52583edfcedda41b3aaa36b",
      "translation": "所以，需要些结实的武器。要说这个，穿刺蠕虫那坚硬的角，最合适不过了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d86dfbc4b9c8ece2e12dbee008c521f2830ba9249632ac521e6bf0eda2a5b21b",
      "source_sha256": "961fa7c360619794e7c08e7bbebf0319a19e040cac2127f9297d9fa8a64efe68",
      "translation": "所以，我们才出来，狩猎穿刺蠕虫。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b820bac11985e4b1b78107ddfe1370f13e3284f9365c592ee0077874728ef36",
      "source_sha256": "8cd2225a524d813e8e665e707abd381b9814df44fb46633b5254f150bf60e726",
      "translation": "朱特，你既然来了，也去对付穿刺蠕虫，帮忙找5个[坚硬的角]再走吧。真是累死了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03ea599971bf23c2fd455032c996a232a99a94a632a37e4169543a044feac314",
      "source_sha256": "d13008706d403f59e970992e23749d5f7c2d2d4c87e8e5159554c7c15209cb2a",
      "translation": "不愧是我们风息岛的男子汉！"
    },
    {
      "id": "coalesced:00a4fc9df5474b45e1cc6474a25024779983789a72fbfeb8c32815b19fb7f90c",
      "source_sha256": "83d8ec719cf65aa310b6a3187481562620319aa4995f5b71714060f485411835",
      "translation": "哈哈，拜托你了，朱特。青灵森林各处，都有不少穿刺蠕虫。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3cbcbd5e087f0ba7ed7f5dce7c5737e236b16e923259e60f66f6eb63b27a5f73",
      "source_sha256": "fbd05310ed7e926835236791281befb9ac818ed85d5894b63de75040b4fb93d0",
      "translation": "什么！？这也太过分了，朱特。"
    },
    {
      "id": "coalesced:982e571c4401fe030d504826f871571cf7e4bced86a497cfbefe3814c6073519",
      "source_sha256": "ba94b578b435ed8df967d96b0f53c637d8e566a4f20ef88bd26612b0fbec543b",
      "translation": "我是说，有苦一起吃嘛！"
    },
    {
      "id": "coalesced:06370190b98b350e45111d1250716a77b8904dbb255cbc8b29890b65589cf5e5",
      "source_sha256": "83d8ec719cf65aa310b6a3187481562620319aa4995f5b71714060f485411835",
      "translation": "哈哈，拜托你了，朱特。青灵森林各处，都有不少穿刺蠕虫。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a568968ad60d905b553cfc0bf2df0bdd98de6bf8d84d5a2e390a7bbb4f222400",
      "source_sha256": "320603ab990796ce15bd9ee44e6c1c8e9c4e4994aae77b2d3f926a72a870c251",
      "translation": "啊，狩猎和你等级相差很大的家伙时，要格外小心。"
    },
    {
      "id": "coalesced:7d7c126ccf9a7a530819b34ce4ba6605a602220c15b4ef9844182233100b8282",
      "source_sha256": "0736a8091622b3b66e00cc49f7890cd642865e44fc6bd8d4697ac796a1f281bb",
      "translation": "不但很难打中，伤害也会降低，暴击更是别指望了。"
    },
    {
      "id": "coalesced:76fe88f42386b5f8aaa55b862a3c8b809247d0475247c0fb7dd3d7659df66a3a",
      "source_sha256": "efb0c566b20bb2f21da6b1ee9b51dd0f8a055451a3e40cf680fd9c998fecb98d",
      "translation": "能避开的话，还是绕着走比较好。"
    },
    {
      "id": "coalesced:0141c3989df8da3dcb1cd6305274b3271a9b0c8443bfe15894eb7e5fe1257044",
      "source_sha256": "e40ec0f20a0b09f0154561aa9560795f4b2742f4afd0503678fae11f4cd56d13",
      "translation": "谢谢你，朱特。多亏你，我才能休息一下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b79baf51414627b91da2829a6351c4a4b96d2188e3f1956d95667be78a62af5e",
      "source_sha256": "9b933c540c47116c5b5d4b2735d41c621c72cfddfcd1f64bee4dc1d3a3c3f427",
      "translation": "回村以后，帮忙说一声，我们正在努力干活。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e55b30009af4466159ecdf8bab97497245d305d2c66928ae88f88824f6436b26",
