      "source_sha256": "60a08f70aa812d0c3a879ff046ee63259d2a6461b56b94a58c9261cabebdd135",
      "translation": "哎哟，伊格顿要死啦！<br>救命啊——！"
    },
    {
      "start": 4293,
      "end": 7665,
      "source_sha256": "6712689585cf34c878abb5594d8fcc2164b4a5c374d73587dc189ab118c72c46",
      "translation": "登上拉·斯特拉达可是我的梦想，<br>我不能就这样死掉！"
    },
    {
      "start": 8090,
      "end": 11861,
      "source_sha256": "4cfac039dfc763ff60fa50d325a152f5972aa07104f663cfe41b83bf1c16b37b",
      "translation": "哇，好大的一只鸟。<br>而且还会说话。"
    },
    {
      "start": 11871,
      "end": 15791,
      "source_sha256": "49ede778d347643d71699bc2140a136226b373a8fbef35c42beb88aaa599a18f",
      "translation": "啊，难道我的梦想就要这样<br>化为泡影了吗！"
    },
    {
      "start": 16499,
      "end": 17976,
      "source_sha256": "2ca64b96107b18aaa73aa3814b253ad8c9186b2c711694a146f000e32bc6373d",
      "translation": "吵死了……"
    },
    {
      "start": 23712,
      "end": 26737,
      "source_sha256": "c4d920e08a545cd0310e8d24dc5702d723c1842e027eb380422ca0a60674d91c",
      "translation": "哇啊啊啊～～～！"
    },
    {
      "start": 41234,
      "end": 46796,
      "source_sha256": "bc8a1c72297dd8f0a1c36cbd409d0de08352e9ca9c7b51fa0caaa9157df55bd0",
      "translation": "啊，我、我还活着吗？真的还活着吧～<br>啊啊，我还以为自己死定了！"
    }
  ]
