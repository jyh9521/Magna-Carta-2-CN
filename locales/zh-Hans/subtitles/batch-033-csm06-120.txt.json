  "input_sha256": "281f67504fedaa4beab1939579225a8d4b81ef884551a1eb31508505d2e77d6c",
  "entries": [
    {
      "start": 400,
      "end": 5751,
      "source_sha256": "d4bf4b2f68ff98e3054060c8baffaf77aa42a8189bcd3e5924f9214b42cc43b7",
      "translation": "这是命令。除了公主，<br>把你的同伴全部消灭。"
    },
    {
      "start": 7043,
      "end": 8831,
      "source_sha256": "98b5835bf54e306df8a7a23cf481665f0513d85940ffe012887b576d63545b9a",
      "translation": "什、什么……？"
    },
    {
      "start": 17147,
      "end": 18730,
      "source_sha256": "09481226c669832a8112b114997184b0a75c856f3156ab67a1098bc7b2187456",
      "translation": "你疯了吗！？"
    },
    {
      "start": 18998,
      "end": 21892,
      "source_sha256": "a66452f5435fb6f50ed254ce997390e749ad9ec2b1f022d45574efe5877e4425",
      "translation": "身体……不听使唤！"
    },
    {
      "start": 23248,
      "end": 24087,
      "source_sha256": "1fc5de1e8e252da179f01c9c27c1249c1a1436776611ece0330b7923d1a8442f",
      "translation": "朱特！"
    },
    {
      "start": 26649,
      "end": 29016,
      "source_sha256": "1cb414e48b700287a6f6a5a04a76105b66320cd33be7ec6bba6e57e44ce6444e",
      "translation": "可恶！我的身体……！"
    },
    {
      "start": 29194,
      "end": 35786,
      "source_sha256": "82b5bd9511e798229f8ca4615a51bceb9baa4ea5ad8c14711cf8529d3331fd22",
      "translation": "你的任务，应该是解决公主以外的所有人吧。<br>服从主人的命令。"
    },
    {
      "start": 36161,
      "end": 37315,
      "source_sha256": "be7679ceeb299b760f9f68929a379d7bd68760bf957a1e36b066860c89bca0f1",
      "translation": "你在说什么！"
    },
    {
      "start": 39178,
      "end": 41832,
      "source_sha256": "7cc0d0ba0fb973b4fa06624ae6b8905b87fa69abfb8b20591abfa53568280851",
      "translation": "主人……到底是什么啊！"
    },
    {
      "start": 46979,
      "end": 50005,
      "source_sha256": "b9cc5b3aa7953b538933954a9a8bb60956495f317beff2a9dc5c7f3e9a435fd8",
      "translation": "为什么还在装糊涂？"
    },
    {
      "start": 54993,
      "end": 59482,
      "source_sha256": "719828a172c3abbbabfdf270ea24c8771ac88d0eb5279ea699e4ef1b85838d99",
      "translation": "我们是只服从主人命令的存在。<br>你忘了吗？"
    },
    {
      "start": 60073,
      "end": 67030,
      "source_sha256": "774ebfb2675121425abb7316c4846ce7fbc54a37f4ba79cc45d0083524889b2d",
      "translation": "不过，一号，你是个失败品。<br>因为，你差点杀死了公主……"
    },
    {
      "start": 67938,
      "end": 71362,
      "source_sha256": "f5a078c560c81ac059b009f7f867fbed1da23001e8bb57ccd9fc1814679d65fd",
      "translation": "难道……那时候……"
    }
  ]
}
