{
  "schema_version": 1,
  "kind": "timed-subtitle-text",
  "resource": "MC2Game/Movies/csm00-10.txt",
  "input_sha256": "0e7ec25f98a583e2bf7e2809eac7e648378923ddef37c696a52c0f5680a5b18d",
  "entries": [
    {
      "start": 6402,
      "end": 10232,
      "source_sha256": "3d4c02429b123bb6133151822402c033ddc326a8b293e36dd89761441c7546ca",
      "translation": "那时的我，只是个一无所知的毛头小子。"
    },
    {
      "start": 11001,
      "end": 15077,
      "source_sha256": "580e07a5e4c21b69b291733647073b78ff38353b91829463930b60caef9f3b00",
      "translation": "明明失去了记忆，<br>却连自己是谁都不愿追问。"
    },
    {
      "start": 15585,
      "end": 20315,
      "source_sha256": "498eacdb361df3440c3f634c6db92d1711711ef7cf031df895eab160c97ae722",
      "translation": "只顾着在岛上<br>过着悠闲自在的日子。"
    },
    {
      "start": 29350,
      "end": 31178,
      "source_sha256": "e11eec9f36fad9b04735b7813982620e801fabf9cece457296b9e716be69f8f6",
      "translation": "请就这样往上吊。"
    },
    {
      "start": 33038,
      "end": 34856,
      "source_sha256": "917507e7355cd34acdfb7ec0321fe1528ef6691c1a87373373a20b886740fa9d",
      "translation": "好，拉！"
    },
    {
      "start": 40827,
      "end": 42216,
      "source_sha256": "35640463217803b43a7b50c4ee80c263852939f244e045a751dc874643882a26",
      "translation": "谢谢。"
    },
    {
      "start": 48696,
      "end": 49693,
      "source_sha256": "241421b338763ed3956cb5b1c949a7ffbffe08b93bdb5e85bca1d48d3350e335",
      "translation": "真是的……"
    },
    {
      "start": 53206,
      "end": 55198,
      "source_sha256": "a2f6dc42007875a1d4206f6811db12cb3b14d62771bf59029343ea3e41ee87fe",
      "translation": "太过分了吧。还不起来？"
    },
    {
      "start": 55866,
      "end": 60149,
      "source_sha256": "673eddd81050e7bad9a0b9ded91d4bf7319f4f432f5ab905b49b1e7ea4cb4e38",
      "translation": "叫你起来啊！<br>没看见大家都在干活吗？"
    },
    {
      "start": 61070,
      "end": 62033,
      "source_sha256": "3fa9dd90c9df6cec8ea67e8ce7afed5a2dcbe022243150359b25a708dc784c3d",
      "translation": "啊，真是的！"
    },
    {
      "start": 62835,
      "end": 66490,
      "source_sha256": "9648be630e177672d4f3465fd8eb748a087714b7fc8d66a0c5cb69bc3f67ebd3",
      "translation": "我昨天可是干活干到很晚。<br>就不能体谅一下吗？"
    },
    {
      "start": 67469,
      "end": 69332,
      "source_sha256": "80185f22743f383cf8a2f05d3a302534df8b45e5052a3ccae6943c75922760de",
      "translation": "哦，是吗？"
    },
    {
      "start": 70210,
      "end": 71391,
      "source_sha256": "4b8fb0071513a880180f300c4bb07fc9e75e90fb5e915da0fb073a02afb60b28",
      "translation": "这么想休息，那就休息吧。"
    },
    {
      "start": 71391,
      "end": 73042,
      "source_sha256": "438db7ef85d62262483351c28d2c83baa9defd57f52b6bd7c8d1a182344bd1e3",
      "translation": "咦，今天是怎么了？你居然会这么说？"
    },
    {
      "start": 74675,
      "end": 76538,
      "source_sha256": "78655c8f63210caf0efc84148286fa3c2d5d450825af4cdb518cc04850e5e56f",
      "translation": "我会让你永远睡下去。"
    },
    {
      "start": 83730,
      "end": 84931,
      "source_sha256": "c5da897044a380ad309d5b562cfcb00bc4df3d5441ec300f0e8a25a47e1258c0",
      "translation": "喂……喂，等一下……"
    },
    {
      "start": 84931,
      "end": 86548,
      "source_sha256": "ba3ba6a1e68155d7daa80624bb9b3a95dceced3f4725f9c04a798a38f82216f1",
      "translation": "哇啊！"
    },
    {
      "start": 87367,
      "end": 88334,
      "source_sha256": "174dabaa6a28589a8d61578ab077c50759022bf6e36a9bb4add5af43cec6a9ce",
      "translation": "朱特——！"
    },
    {
      "start": 88833,
      "end": 90228,
      "source_sha256": "46056e86b1b52388116a2f505726bd996b4a27ccb458dfaebf9df9888529afcf",
      "translation": "朱特掉下去了！"
    },
    {
      "start": 90596,
      "end": 91777,
      "source_sha256": "0d7f83131f8606ce6b26b07acffbf8cf992c21e1bafe07f6d1e9388056d421f7",
      "translation": "还活着吗？"
    },
    {
      "start": 91785,
      "end": 93533,
      "source_sha256": "5f188bb89885a60881a3542a869520393a2dbb7f1316cc724d027bd068d47eeb",
      "translation": "快把他拉上来！"
    },
    {
      "start": 96715,
      "end": 101752,
      "source_sha256": "6524e146f8f0620f322948084a5f3faf28acee2b2dad4d536534dd0692377881",
      "translation": "也许那时的我，根本就没有勇气<br>去面对“现实”。"
    }
  ]
}
