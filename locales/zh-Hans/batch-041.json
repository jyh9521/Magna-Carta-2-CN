{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:0fcd858eb994e41d2867fb30d86614921556538ba68d98f47bb729918177a710",
      "source_sha256": "20bbf9e35b8f92645bda68082329a88b48d5b3c10895cd1c4f9d74be126f2993",
      "translation": "站住！"
    },
    {
      "id": "coalesced:bf503ddecab1eb462a701bdd1b888791d81f5345326ac0b34cfc5cc18279ff86",
      "source_sha256": "a94833bd4277f93cbeec21565a7712585174c6ae61366332460bbaa843098635",
      "translation": "怎么回事？"
    },
    {
      "id": "coalesced:89992b31e67cda4a91687b81e492ea4cdfbea6438d2a5f3367f6408c762c74eb",
      "source_sha256": "d3a561f5387f6c2a604b05031b2e87c207e86e20011747846cbb1f2f0708c1c2",
      "translation": "叛徒们，给我站住。"
    },
    {
      "id": "coalesced:a6e7edd6efb6cc323fbea7e1e1d56c28503597cb39aa329997b98b837b9b9ca5",
      "source_sha256": "c82421ca52b57fbae917b9bc52ff20414de26f261f13bc289a1c66e1a0f86fad",
      "translation": "叛徒？"
    },
    {
      "id": "coalesced:5c5ff814b702ae8de73dbeea4d6539d0e19a815406f70d01329fede40bbff484",
      "source_sha256": "ab5089edcd8bcd46c693d5d87184d883e9f69474cd5eaed141f955481b85d7dc",
      "translation": "我们已经知道，你们暗中勾结了北部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a718b037404ccfb6e4c9f941ef64415eb9e88000b033cbdba0f2c9448cd1880f",
      "source_sha256": "53795ccf53320c71808afb5f841d5c04adb752fb3fda0e770511fa4a0a1d925a",
      "translation": "竟然还设计让公主殿下遭到绑架，绝不能原谅！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7553a8b6e9e39995244bdf2f66ad79ce5a9f5401a6289ca9919936f7e26ac7f8",
      "source_sha256": "c7a25591c804d14b738abc1a32e11670459c0e093123cf431cf715348f60a1a8",
      "translation": "等一下……洁菲被绑架，是我的错。与同伴们无关。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ecef31c7d1ad5f4d23b85442a73312765fb72ba354501e5a200c03724ce2cb1",
      "source_sha256": "4c6da1e90d6ae8b696f2ab029e8e9fa9ad7fa0543e55dc074b94f187fae5e149",
      "translation": "没错，我也听说你就是艾尔加。这一切都是你策划的吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:990c81b6e27f0215a60f3c295a29b119768dc2b63c2de92cc5ac5a243187410c",
      "source_sha256": "3e648e63c08e0edd849555a091e25512e3ab045142291a4fabb2ad4769db51f9",
      "translation": "你们到底从哪里听来的谣言？我们现在正要去救公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6dfcb852f3ac590e6db9746a88a2dab6e604fb4e2ca70bd39f0ba4e249e45067",
      "source_sha256": "8ea30c934182a951a930af1622be22289017445d9b06743469d847ad034a8308",
      "translation": "可笑。事到如今，抵赖也没有用。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2cf15ae9326f94b189872d7b36837185a0f1489e9aa2b18609936dfc51936c30",
      "source_sha256": "2c8fd4fd4ea8aba37fe09370b3243a2e12f6fbbb4f46201d27ca96467e69ca88",
      "translation": "因为亚历克斯大人已经送来命令书，命令我们逮捕你们这些叛徒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b992c6a42b39c306dac63cf3a5e480015826d25a8d269596faab600c70989ee4",
      "source_sha256": "69e1eb1643e4b79c7f76517b38ae8e5dcb1d3013c127a1c41f5f93775edda864",
      "translation": "亚历克斯？他怎么连这些情报都知道……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9ff756da4a387e99d418774617f0db269b4dc80fb8f26809c61dd3231a96b58",
      "source_sha256": "93008da354d8be96daf718ad579f45c5861acbb27aecdc44d7d7174980a8e394",
      "translation": "为了救公主殿下，亚历克斯大人早已前往阿巴泽特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e58e34e8b13b7d744001ba6ac2eef545ba939effec70129f69c8a11e3805240",
      "source_sha256": "24e6a890b5c71be370be7afdfc9b3e25c392e4d0c8963ef1284c13f006f6e3a5",
      "translation": "不可能。亚历克斯竟然比我们先行动了！？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e96ff7561144ab7dc7a812f801c6bb1edd19242bfe322c4e8cd5f6e7bd609d98",
      "source_sha256": "dab76f1dee354247a52d06123f5d34ce0caa1882afba557d42f49bf7b966fe95",
      "translation": "闭嘴！竟敢随意直呼那位大人的名字！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b0b55df1f2244c26a91a96a54471aa90655331d54318a214013b14b8a5b4bcff",
      "source_sha256": "a413198c603fcafbffb423152120149ddef368d2c83d06f9ab9d12ea51fb2799",
      "translation": "要抓就只抓我。其他人都没有罪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:57de4ffe190796eb88af05111337ed999dc1d9aa324c91872c732dddd827ddc0",
      "source_sha256": "ef474a2cec39fd54047b93f55c87aaf255183f113d570e620d1e67b0a28c2c2e",
      "translation": "你要我凭什么相信你的话？"
    },
    {
      "id": "coalesced:ddc90cc168b85a6c5b902dd84ff1e0924507cb8eab0f0e6ac9b018b365956776",
      "source_sha256": "01f2537c0c486cd8d6c3c0fa2857ff983578e7260c37e3166b371f657529cc1c",
      "translation": "哈，好啊。既然那么想死，就尽管来吧。就凭你们这些半吊子的正规军，也想打得过我们？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:389ef1e910a3a805b87055947440cb4393e583b09b9cb0cf84c18af2bf7e433a",
      "source_sha256": "ae97fe97eaac8cd77768b4ec1fc68bc589aebd0a098622bbd48d7db5067b5672",
      "translation": "所有人，进攻！艾尔加的人头，可是挂着高额悬赏的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6fa70d77222fb8f9d3bbefa37b53529ddaf88a5d8ce87e36b36df8023dc0771",
      "source_sha256": "d6b898bf37eb8049cc9cbe9a2513f442534faebb4f63a0a2d144583ab856bcd7",
      "translation": "到底怎么回事！南部军不是自己人吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f5899aa389622dcd3ed1665757d680c76f948b58661e7b5f6dc3e27773a31141",
      "source_sha256": "c5e8a111d9ab8676eb0f3acdca88e9e3c862e28e4934c879551ed5be471d25a1",
      "translation": "咦，自己人居然也会打起来吗？南部军真可怕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a123ed56794b0b573c38f0b8f192afd6fb5c3599692a8f87855aaa1045f4737",
      "source_sha256": "7bd73701e2b70a15c88395f4c53e36bf4159eee5849d8d18116bf1c7b8ec1cc3",
      "translation": "可、可恶……你们这些叛徒……我绝不会放过你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f19498afc20de1ee17f71cdb06c99e781c564546550bdc5a3dd041549c46ea17",
      "source_sha256": "33ed074b94c5131f40e853463183848cdb85ac9da14f05b75efbf0ec5720fe9c",
      "translation": "停止战斗。"
    },
    {
      "id": "coalesced:5f49e898ef19ec60ce6e042af870493b7ec2dd9b493c124cde5c78a1d2ed9f0e",
      "source_sha256": "5e645a32fc0c810cf1f4198a8efb396d82ff1a299c4c8b852875c65dda9754cb",
      "translation": "司令官大人？"
    },
    {
      "id": "coalesced:2c38031cdf562f4f979c07ead4e85273ea6a0201f5701d8742de46e1679fcdb6",
      "source_sha256": "f4812333e5e599d12c4e9d1fa4c0be8dba0e7463ab5102d238714583df154b3b",
      "translation": "你们到底是奉谁的命令，做出这种事？"
    },
    {
      "id": "coalesced:b5cf2d62edd25a7e486d1752bf3ba15cace7f0829b51145543d211f69acadc01",
      "source_sha256": "1d83a5132cf4fab3f0e5114ef7275cb9e8241f708f0735996b75630f13b9e2d4",
      "translation": "反哨兵部队暗中勾结北部军，绑架了公主殿下，他们是罪犯。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5c334b00747066c33e29264e5b172d7d97ee282a02149f26acbae5a438fe5bd",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:ae2a71cc0d557e2688f57e367a1cad25146eeaeb6672c935cc6c1ce1376cf6f2",
      "source_sha256": "e23d06b7957a51bef061492bf54c1e7d439aa0facecf779355b314ed94fe1440",
      "translation": "怎么会……公主殿下果然被北部军带走了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7592a852877bd7ff5713854be03567848b009b11d3f5104482561eadecd8be15",
      "source_sha256": "d1a6ec7a115055b89defa45a775013e296417a45e393ff7a469957adfbcbcc74",
      "translation": "是的。这一切都是这些人干的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8482d319db229966de098f6a496bbd3bf93c17f072a27a02a6b289068a4011b",
      "source_sha256": "f5aaded70401efe422df009a10a7f914697585fd83cc36140b1d57f8894cfdfa",
      "translation": "那是不可能的。"
    },
    {
      "id": "coalesced:b6ea04ff747a3184c6ccd48e967ba83d2ad4c36aa7f393c9c499f7a21866c84b",
      "source_sha256": "595e7ea9407a7c5aaecf4c8a2aaeeb058e92e8394e537ac262958cbcfeb45f2e",
      "translation": "反哨兵部队不可能做出这种事。我很清楚，他们是如何看待公主殿下的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63b18e9f7d9466c2665d323d15c402cdd3aa5da6dd1cccb20f120cd78e018559",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:b7584b94dc8d2a0dd490e5b72fa1964d15d7e1c7ab801aaf5a83ea9505c705a9",
      "source_sha256": "7e889adfadea41193444b98ba1e81000319f56305738e4e4d5af8ec22af86332",
      "translation": "所有人收起武器，退下。快！"
    },
    {
      "id": "coalesced:4d759379f5073739135e5e2e14c74d24fdae0849ca1c13baf697539f690594dd",
      "source_sha256": "b7a2c3276f5b91bd508aea4bd69a9fc7a0c8fc9ca8e64b5ab7e72ddd70a97d69",
      "translation": "亚历克斯大人已经送来逮捕这些人的命令书，还有什么可说的？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6201e596c6087cd8ce1acdd8bb3d80f93f728df8bb4736749607e48d4d872c22",
      "source_sha256": "02afd6d9e98468a60b4416ce3c73e2e787859a7029e54ab07d9f46a9fe32581f",
      "translation": "……亚历克斯大人一定是误会了什么。"
    },
    {
      "id": "coalesced:57f70cc31ff34bcd29e44cdd6336cd03f58252b3863a364b6940955c3ecdf37e",
      "source_sha256": "d746ff0480f6db9f60bf6a40f8a67006ff8efebf499a95c41ca34fab45d2526e",
      "translation": "之后我会亲自向他说明，你们现在退下。这是命令。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce5ce7346a22d6555dcda6298e5b21dd9cc6ed3be8fc0bc253fee0ba1a0929c9",
      "source_sha256": "415df8fb6255b3cd26dbc23a50dc85b8a752e2aadc3b0ba3c30d5ae6c7a36089",
      "translation": "遵命……"
    },
    {
      "id": "coalesced:2333a29aa30ae218196e989ec85e0c8cd3983df52113fc90b84b4210dd50e72c",
      "source_sha256": "246a7465baf75f1931cdcc81561e9025f0702964341e5d70c25e4b639fbc9ce3",
      "translation": "大家都没事吧？"
    },
    {
      "id": "coalesced:fcb15c24386d426dfad49d1d51f623654a262dc007bf7bf03ae8c860b8b39ad3",
      "source_sha256": "75cfa9514d0a18cc1b71bda7f8dc03ef7e8e5e4dd23e75f31ec3a5bf65c73bbe",
      "translation": "劳德大人，您怎么会……？"
    },
    {
      "id": "coalesced:63aaed14595803d3c8e8758eb9fe9cb1c498ce98eb8245b7f05e808b11a1745e",
      "source_sha256": "f23da083e04d39087490b772d10c9e4ed2f7c46499c18cf4fb21dea5558c13e3",
      "translation": "事情变得越来越复杂了。我有话想向公主殿下禀告，没想到她竟遭到了绑架……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:766a322450e8977088104dcc4292ad63af78af1c70acd68f43f5d4a0c557d64d",
      "source_sha256": "d145fa03293af62a426bff5eff5bba91b9d9fcb315e9a07196698730b33c5848",
      "translation": "劳德大人，您知道些什么吗？"
    },
    {
      "id": "coalesced:6923eec0e76cf139a4d71b0c02b1e550dc50c787aba76feb3dfbd6a818a169de",
      "source_sha256": "a6f7b681d1a99a46858bedf8df1177a60de4f244c59fabed74ce701a0b9e7c37",
      "translation": "唉……连我自己都难以相信亲眼看见的事，不知道该怎么说……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5883d43118d4c091701a7dd52a33cc06cb2fc6d6df42d7b907ac15af4b596f5",
      "source_sha256": "7ef9a037680fe2e30cc23f0d13258db985e79d4791a9cc5386ffe4a16c514fd2",
      "translation": "公主殿下被绑架，恐怕是亚历克斯大人与修恩扎伊特的阴谋。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a6805d1b5f2b572c2ac444851d6a0f4addf38f8da9d58a5b9b4174e0e15d2e2",
      "source_sha256": "97d6a2dd6a8d1ebef78375ae1aa5397735feb52e97fe4eb8c882348254d79cde",
      "translation": "什么……？"
    },
    {
      "id": "coalesced:9ccf71a5f46478fb67647dbc119e95b80fc23f349533eff815ba21ee580f1b7c",
      "source_sha256": "078938e36f9023cf29ac866720fb4dbbeceed7f39b1f1810b5173f9f45c1ecb0",
      "translation": "难以置信。这是真的吗？"
    },
    {
      "id": "coalesced:5ae7560cba3b09f78f60cc6085be7fc164f92c025a83b1ee711508be5c640b7c",
      "source_sha256": "74bbee1477898ec38e297a37d8b8d8215fb78ba37c6eed8fccfe7b0a52381570",
      "translation": "我亲眼看见亚历克斯大人与修恩扎伊特秘密会面。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5eaf454911b65e8d654042e1eda0c1990a808a58a52eeb8cbea024fdf5449b5f",
      "source_sha256": "736971d6f7049ec6f977ba66d4f4a4ff4610662555f0915878518a0b4ddf824b",
      "translation": "在我看来，那两个人……掌握着某个秘密。他们向我们隐瞒着某件极其重要的事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8cb32b8a411cc3c9e69ab02f58a6e4d2a3d0c9cdcd6e0377b7b2f167d1928acb",
      "source_sha256": "b4613db1af5fe0b33e2ae0e6a2f39de116406deeaf34fc6e10902301049e10d9",
      "translation": "难道……他们两个已经联手了！？"
    },
    {
      "id": "coalesced:108eb5dc1b083dd98e021f5538f3573bf185f942260699a223daf81e2c923c45",
      "source_sha256": "7639e79261e717b083ac77102d48a0a1ecdc9f3b7187fd0924a94c58bccdeaa2",
      "translation": "修恩扎伊特向亚历克斯大人许诺了王位。虽然令人难以相信。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5dac03d6b0476c772299655449b0f0e57e30d6966fbdc5d2779b51d59a259679",
      "source_sha256": "a6418a5a676f0b351bbef177d8eecf21a7c50a3e92293072d3f64bd237f06be8",
      "translation": "真是疯了……"
    },
    {
      "id": "coalesced:c930910a25143a439393c80be9c7ff5952d2848ad132e75da883918e52d11477",
      "source_sha256": "c9f5e2aca20eb8dc40616b3bd2c7ab240134f3e05c0ecc34a811459c0c8a78c0",
      "translation": "修恩扎伊特……竟然连亚历克斯也要利用……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff1c1a8a5256c016382cfe10300ee9691c2fd9cd49dbc11f6c1d10331bcd91c0",
      "source_sha256": "caa01824c3ce2da94e3d4f8e1788e6efaec061baef53b1bf35351e4743d8c6c4",
      "translation": "露，你还记得公主殿下打倒艾尔加的那场战斗吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e8a4569a94184b06c9ed8c52e9c6c94de7af6ed13d84ef41e5c8974b98301e8",
      "source_sha256": "780ae440a166a480472810fd2b1aba39eaba4e0aff796a5ad96cf3adbc749876",
      "translation": "是的。我当时就在现场，比任何人都记得清楚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b1573b77ad84469e5e2ec005e0d5607fb5716d051697073df3ba1716a20a9f32",
      "source_sha256": "6ade689fc5f56854c5b113ef0492da78432f36cc5ad4279129b663513108b5ad",
      "translation": "你在那时得到了哨兵的制造方法、弱点等全部情报。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ab4bf99d4e1083a332cb862c2392d51bb7950bfb0abd884b05ad70b488323b2",
      "source_sha256": "98e3798d95c63385f29fd77c2e2e88cf69faf8bbdb281646748acc7d80949214",
      "translation": "如果那些情报当时就到了我们手中，这场战争早就以我们的胜利结束了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2eb96755faf529442eec1cb2b62cd9ede928f1cffcf9f5f86e74bfe7643ca92",
      "source_sha256": "605ac12740ad21f81f16daaccc113d4bc7f76e761f6cd80a035a60b8d2c85335",
      "translation": "然而……你取得哨兵情报后，艾尔加突然开始追杀你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:890581ce02156a1b69b9d8f1c533e55f416fcc06eda4c7cb00a0dd57448a642d",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:3232d9a846834d63565158a637748f3b607bd49c555df0483f9c4ebaf3095606",
      "source_sha256": "cc61c0aeeec6fa64f745a0bcc52ea8726293417eeefb6234df5c50a4f53d1aaa",
      "translation": "可当时没有任何人知道你的行踪。艾尔加却恰好在那时追来，实在可疑。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2fe89d54d9ec287bea5ff66d4ad30b2da0392b7290a01cc0739f9c87922ba4b",
      "source_sha256": "c1d018aa061edf5f41197a49b02ce7ffb0d440ee74b73e8a29f9209433275804",
      "translation": "是的。情报本不可能泄露，我也觉得十分奇怪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:960c4020c517a0fc2a5504aa4ec57ffc6bab49d59c12dcbba613acb7069cb06c",
      "source_sha256": "6817e05dd71f81dcb2fd9b3d5b33096df3fbda6c12752d3529ff23ed64050cf8",
      "translation": "我当时也心存疑问，私下展开了调查。结果，让我开始怀疑亚历克斯大人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ef0a100a5c76f4e38ce950d3c94378ef9906126d577cdcc6b6cc68085dcdd0e",
      "source_sha256": "267cf0ca0690e30f273a57fef870d818e67aa0329e5ba1e37fac993fb03e64e4",
      "translation": "可那两个人为什么直到现在才行动呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c68eaddc12a63691134355b9c87111e5dfd10a0892aa084035cbfef701d55e52",
      "source_sha256": "3d7bc26348ad3b828d0a1e381e7ace1f896177a984e46e7424f4fa7ffb21620c",
      "translation": "其实，这也是我最想知道的事。"
    },
    {
      "id": "coalesced:e12486f7c5adc68a388efe2b59daa9b0191db037da9cf627ed7c5e95a92288c6",
      "source_sha256": "df1a2cf47194982325bd5150db7c359810e29ad2af29ea6cdd629c961b267e04",
      "translation": "总之，先救出公主殿下。之后再查明真相，尽快结束这场毫无意义的战争。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bbab38d1e614b9fcc115f911372630cf5844704f2517dd93d7b7e5d324d574a1",
      "source_sha256": "faae940ddb8909241fa26a92b934d28431b0930e291970baf722c60ce96b4d71",
      "translation": "如果这件事传开，两军都会大为动摇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a6d198582b241806888db10e488fdd739560cd5e0bb98d86d53eca0d9b69631",
      "source_sha256": "da3f9cced0229e4cbef847a9f90820593881cb3dfd2e5cbe5eb6bd79a26746ee",
      "translation": "我们现在就前往贝尔福特，救出洁菲……不，公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7cf5d926f392e0b7cdef7d40131f94a8de039f1945bad83683e237cf15e77940",
      "source_sha256": "a1b22bd4d518097d057edcae63631e1adcd77528d4f8d69a382c31244cc88102",
      "translation": "拜托了。我也会随后赶到，请尽快动身。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8700c79d218b86a06eed550e9108b2d198a9c3af438997d169461ce8f44c8deb",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:99f8b58a04f61fc5137f632874b5dfad1353d66d69994a658dcc5d21ec187670",
      "source_sha256": "cf727b94847990b8a238d1b0c924784f409a55f23ae43768cf6d96465c1e0182",
      "translation": "已清除北部军设置的\\n路障"
    },
    {
      "id": "coalesced:c245ca19a832aa92bee69ff6e5d8ec0841dc4136c04c78f075339ae6b965be2e",
      "source_sha256": "08de7bd723b90bf3cedf0cf9cd2da8d242c023e257cea51e2287c3e133e8f3d2",
      "translation": "现在可以通过近路\\n快速往来了"
    },
    {
      "id": "coalesced:9ed07809ddacb2d9530e2aee98acc0b80c6be83289543edbde17e863871584c8",
      "source_sha256": "9ca32b1177f179705f824e8fad65ac5b9a65936da7d2f8b11efa9ecfb94a825d",
      "translation": "我们接到了劳德大人的联络。"
    },
    {
      "id": "coalesced:9d0c27e2009ab00f1af069cea1708f93e91824eeffef8b148bb28a569e40f51b",
      "source_sha256": "2a54b2989bc921be1dd3825db9396968c8e7247d57e8d738e9f635042a38b146",
      "translation": "反哨兵部队竟然背叛了？那是不可能的。只愿公主殿下平安无事……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d1a981f28b06bde7f0e70e42e6d18ec96a27874c3dac67839412832d2cf9169",
      "source_sha256": "1bd3cbdb1f14392b58ec8e8a641e0c07ae61f233439ca06152aede9f8bc75fe5",
      "translation": "请尽快救出公主殿下。"
    },
    {
      "id": "coalesced:ecce3b93a273ffbe6b72135836e11f6e1aa41fa5a03a8206fe96279e6bcd76d0",
      "source_sha256": "30ea0ed7adceca9493ca016a1041527a27de3ce6a361702879631f8c76dbebc1",
      "translation": "如今能相信的，就只有各位了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6cb4294ba6fa95eb1e397f6af42071e709268b8e1e76c5df8d25333e78aef63b",
      "source_sha256": "067654a74620c625490098f677b29ae13039e20e07ce94c3c76570b9c353ac33",
      "translation": "沿这边一直走，穿过星光平原，就能抵达贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:de68c77e76135ceba35208e4f653895e0b1ef4554726921806de4e4cd31a6278",
      "source_sha256": "f783779abaf0cd3a8d13ea1d4a43c9b7350bb0638d2f0d39117f14ce82c63f4b",
      "translation": "贝尔福特是北部军的大本营，贝尔福特王城也在那里。听说灾祸种在那里造成了很大的损害。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dfaff501c1a605c05ec77511df5f899fed5dce20303159f4cd6b1f878c4dafe6",
      "source_sha256": "3f4b034bb88348e6ca9f7eff8bb86bc864f172bc2d6f37a914c43cde15de4c56",
      "translation": "此行危险重重，请务必小心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d6417c013e4ee885b1181308729fabf528fa93c365e5de230288aa73cd5affb",
      "source_sha256": "540ee1addeec49738882904dce16559f5d5a60127cd4a84d73a43890dbc06400",
      "translation": "如果南部军一同前往，市区内的局势可能会演变成全面交战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09c72de216b378a9bb277f25fb08f699125ad0ccd334063541c9c40549ee6b1b",
      "source_sha256": "52c24dcedaeae3fb2439d7ff5246f6628e6e568136de9569e44e921a81777362",
      "translation": "那样一来，就很难保证市民和公主殿下的安全。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d46ebea50cd2ddd72c56461be492abebcee808e4c92933f50bdb419baedad079",
      "source_sha256": "0d5a959a2eeb33611d8c620827547ee3942725fc51ad3170bb828c596d4f3e2d",
      "translation": "虽然艰难，还是请各位依靠自己的力量，救出公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10b67010ee9a9d49063302ea0477040152ce98ee516ad63c04a812515b9972ea",
      "source_sha256": "575e1937f18d99d0809456c0215ae45ff49197888f7ed6a7ddf2cded4fdb15e0",
      "translation": "公主殿下遭到绑架的消息，似乎还没有广泛传开。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41e6d085e83463f6bc57b27099fcfdc7b828dce60b9215459deeb2fabf935c26",
      "source_sha256": "1e000cb96d659df92c513ba7228ff6665ba4112eb99cc5696ad9df90c2c3f53c",
      "translation": "看来是劳德大人命令士兵们严守口风了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:260b832bc4d385cd423b651b89c7d8d83a9dcf35f0e3358b694968896cbf808c",
      "source_sha256": "69707715594de3b9bdaab271cb8c07683c132cbe82c3a0843a78214a39bb10f7",
      "translation": "如果士兵们知道这个消息，必然会引发动摇。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df4446659733a9cebddf92dce11221b5be36b00e8bb69cbacd9fff8a4ace77f9",
      "source_sha256": "fe4ca87223cef5d2ef4b7f9db7864fa0a87f15b9dc8f689697622df3f6a5e2cf",
      "translation": "呜呜，公主殿下……"
    },
    {
      "id": "coalesced:30ca55f0380c08acfc0fdb8b7ad1ca78193c0a33e6fc0adb2cb2fc34b66332eb",
      "source_sha256": "8cce6da3540b4726bb849581a85026d38264ac8100cef07345e1c7d2b7b145d3",
      "translation": "那位朋友心肠很软……请您谅解。他好像知道了公主殿下被绑架的事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d39e1dd9b7b47e3fdbad32fbdb9c8d31bb418b233fb10f412a6abb11c819d657",
      "source_sha256": "fab04c4a364b3c55e1aaecbd13d3106a93e1dbcd6044bc55bf1e9d5555cfd8e0",
      "translation": "朱特那家伙……居然是艾……艾尔加……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:efb9d74aa288f1ca1aad1e81fb81225c6c5954ec556c60b32ea722432673b70e",
      "source_sha256": "3ebcbe79daf71175b4408ca049159e0552aa3ed008b11e6b12800cb467ad362a",
      "translation": "公、公主殿下……修恩……扎伊特……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63fcfdc737c9ebd62195a1ccd8519e09b680f94f9742652505aeebc8ab40b9b8",
      "source_sha256": "5c4c33285bb9f2c0bd784da3f4538f2084789c84fd80e29a8587351be0457c7e",
      "translation": "唔……咳咳咳。"
    },
    {
      "id": "coalesced:47bb84bd674096d76520d1a1142185190d366da1b672d59f8d6a2f80d535200a",
      "source_sha256": "1a1603b004dde9169b8969a56bb7a80d2f84184c2f223c692d21aed4c9884df1",
      "translation": "务必牢记，眼下最优先的任务，是救出公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:15aa2149c0600d469d2f12dff082a965f2d6a183fe31aeaadce509dbca47e6fc",
      "source_sha256": "c0d833e585f01f969c7c2d76d6eee0b53d6bdda6499167f0327837004d434f17",
      "translation": "(前面是北部军的驻地。再往里走就太危险了。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:36def69e5d02423cd9fd6718ba0686e1c4a29f8dc5fda61dec3af6616ffb1ed7",
      "source_sha256": "5765e2f01ba67b94b3a58143a975fe108b6a7d1230e8e54342e4c39c090ab4d6",
      "translation": "(不能贸然冲进去。)"
    },
    {
      "id": "coalesced:86a49162133a647644c16d75148f99e62fef15d6aa9f484997fe30f94072858f",
      "source_sha256": "ebd23547a596cfaa9a2cbd59df731afba4b33632c7ea7e9cff72bda7341b8d82",
      "translation": "(先救出洁菲姐姐要紧。)"
    },
    {
      "id": "coalesced:cbfdc01d065a9f96a515da78932fb9207b0eb5dc62a14ae96fe2eee4adab7a1d",
      "source_sha256": "dbbd9d9df97a60db3a571b93b9486f121e6e0040c0033c3e0c2eaf0c48e9cf78",
      "translation": "(冲进北部军驻地，实在太鲁莽了。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2bec3ed0ba6367cc84b6f708b250369e05ad4cd87b524fcdedfa111624c9a855",
      "source_sha256": "70e10624b5e1c336285d2732c5711ddd2c3165deb077bc1078b8e59b080682a7",
      "translation": "(现在应该先救公主殿下。)"
    },
    {
      "id": "coalesced:7dd0e1eed546f85a048ead3e4a629385159f1a81570a7efa25f7f890efe1843a",
      "source_sha256": "14fa068288f4770885a6cf3096c58627ee5e5a7db5c705b29a94507e03091751",
      "translation": "星光平原"
    }
  ]
}
