{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:2a613ba8b7a737f0db80e26ba48f631046ea019e1db8ed4beb35149f3b7acbd8",
      "source_sha256": "9de839a7049ac0317db5c87772d1e1d6366514f2c9b988cd588c1fc1e3aeb08a",
      "translation": "不、不好了！北部军正朝这里攻过来！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:651fa19a47b291ed8ff1cbf732b8b078ba4d3ed11c1f05ceb0ade61239973471",
      "source_sha256": "21ab08e01fcaed92fe3ef300bfd583464bd0d61e130a6181470cfc7fcfadb749",
      "translation": "北部军那些家伙来了啊。"
    },
    {
      "id": "coalesced:73e23b62d76e408d3e3a6bc1888a461ab5e3809df439ae492dd8f32dfc351103",
      "source_sha256": "85fd4da539ba624ce00df4049e8a967def4a453529e30e297e1ba1eb7c00dfd1",
      "translation": "恐怕不只有北部军。"
    },
    {
      "id": "coalesced:aede5dcb6c27a6f56e605363041edafbb51a9d2222c43e50f3982b872703b276",
      "source_sha256": "498399c630a7e024d9c9e96cb0d74aa5db34f47e30a92191958438648c706a0e",
      "translation": "如今，南部军大概也混在其中了。"
    },
    {
      "id": "coalesced:449bf0c849ad1b0ed5625418be8390c9f9deb6e3ee1b3ca4b68dd415790fc2c4",
      "source_sha256": "0147461cd5fe402c99d5a3d090bf077f0a653196cdaf1d0361dca71b64411e69",
      "translation": "可即使如此，我们也必须守住柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09378b86a86b7686031fcdb45fb5827826731246fb90b9539e5ef01e0ffcc8de",
      "source_sha256": "123b53a15306f286d7c6ea929de79709a49c67f9ba450b37069f33242b9dbb5a",
      "translation": "走吧。"
    },
    {
      "id": "coalesced:51f79a5e79b4aad1bca27b53f4f5de0ff701de9910c126d61350cdea6236dfd9",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:c9c04785c14ef8995258fc0346dbb8c326920653a2d334326278fab3d939512a",
      "source_sha256": "d7a9da42aca252c6e4d0c9dcae1f26c572ec6734cdc967c8ec3e89070b34febd",
      "translation": "没事。我不会因为这样就倒下。"
    },
    {
      "id": "coalesced:4a12755fe0f4f6b19eb0ff9720aaf86a2a3bca8bf5ac9ecc6d11aaf037f7a91e",
      "source_sha256": "43fc1b9b68a238ac9efbc358735f3adfc678dbded9752c4afbd1a1b79b091f9c",
      "translation": "梅莉莎拜托过我。就算途中有人倒下，也要战斗到最后。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5c8df2c903daa5041cb35038b2e404adc90848c32eca27528a5fa53de71ca0e4",
      "source_sha256": "766145efb8fd6d4bc15426eaf19cdb17fc063c03c22c08cb0e3930a6cc0773ff",
      "translation": "大家，走吧。如今无论走到哪里，恐怕都会有人阻拦我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a353dbeaf29761114df3c697e8afe10f27718ecab7f3c55c4eedb2477357594",
      "source_sha256": "f59bfd77a207e99fe3c6dbc20972ca966a2a5fd89cfa21359362c4234a37b7b7",
      "translation": "但绝对不要放弃。无论面对什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:985a03d1783c3ca99e8dc38fd12bae0be8a085964f56c10a527b2a5551a7529d",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:9148b8548b2435476c6a2ef28dc7ad49f4f447850e1d233f5661e00202ea3d9f",
      "source_sha256": "bd2b1a9a2dc74e75a32776b89d89c53fda3c6565c64c1e4a6dd54e7a21cd016b",
      "translation": "心很痛。"
    },
    {
      "id": "coalesced:467dc69aba0f6a532194aced35b6aaea7d9433cbf35c30c66d2395c853249611",
      "source_sha256": "c881761cc8523d0b269f19f50d85c21c3cb2cc9385ae658774218752cccf267b",
      "translation": "可我们甚至来不及为梅莉莎悲伤，就必须奔赴战场。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8ca710d7cac7bf6eba3c94a462e42ffdbc67daaccd36eb25075b0b5a701303e",
      "source_sha256": "e3a4cca53774f9e901cd511392c455b55eb4fe94e1ba3c2c1ca24cbcb8f59c82",
      "translation": "如今，我们只能战斗下去……"
    },
    {
      "id": "coalesced:d4bf6292a1511dc2c400d55fff2fc40cb05c344672370afc15fdb00c43e2b05f",
      "source_sha256": "acffa1435ef49ea1cf4855d4928a1078bdaf873983bd40737133982be992b56b",
      "translation": "北部军真的攻过来了？"
    },
    {
      "id": "coalesced:aa578d071fde5fd84f270c0999ffb8a19a2258a17cf278f279159d6b7d69be11",
      "source_sha256": "ad6d8fa7397ef896fb7c0cb2e9cdb4fc9239f689d4b501aad95d44f641906711",
      "translation": "不只是北部军，还有南部军。他们自称兰兹海姆联合军。据说，指挥官是个女人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba4c3965e3a638d2aefa7cf8bfaf43befd6f3debe3e9b648c85029d12b1654cf",
      "source_sha256": "c35b3e991a892e954c7b7bb7b28ea817c63b25ff5990ae3e8e40a005185ea164",
      "translation": "是克蕾尔吗……"
    },
    {
      "id": "coalesced:cab69d5dd7114b162d7c055d289abdb3dfd7507f01dbf45fffc073128890bcd9",
      "source_sha256": "05b1eeec8a54d210f4e974e7126f97b330d7171d7061ffd9af9aeabc9cfad4fe",
      "translation": "不过……那个女人说，只要交出公主，就会不战而退。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3cdbf74f0d810f79824228567cc07365ca14ebb847c3a454661862ca9e2c076",
      "source_sha256": "3c4e72f402327e183dc6e16bca7fdbbf591442b6e050e610e42b34e41cba3df6",
      "translation": "什么！？"
    },
    {
      "id": "coalesced:6206d3cc1c000473022b736f26d8ba1adba41e976e9d6f704a83a5446c1ec4e3",
      "source_sha256": "ae1a090632c06bc4184c6a518090a621bd134fda584e662be98ccf40dcca1aa7",
      "translation": "果然还是使这种卑鄙手段。"
    },
    {
      "id": "coalesced:6c2130648ef1ffdc5ab5589cdaeb4c31ffb086e6547d1b3879a8e3babd29238c",
      "source_sha256": "38803c03fb79b81e596a9a46e8cf7e7072282a6b946ecb2369076d5b149ba1ce",
      "translation": "不能把洁菲姐姐交出去！"
    },
    {
      "id": "coalesced:3d23af4ae9d1e03e6b62f0751461c2f34cd42822725a4666e2c99a0cb6cca537",
      "source_sha256": "ad02f78ded32aeafbefd39e666328727ec56e6381cee9c83e1debd48382a62f2",
      "translation": "可是，以我们的兵力，很难对抗北部军，塞蕾丝汀。"
    },
    {
      "id": "coalesced:a8e674e4e19b1c2cae712d916a02ee0ecd6de48b2e494068e32075d129992272",
      "source_sha256": "56e4cb884f18fbb85a2ee16f176982990226f83adf8d0ae31241abec1873b6f6",
      "translation": "那也不行！"
    },
    {
      "id": "coalesced:21c7e58ae033122b9e90eb1376a0a5137465a59b2c58b49c2452aeedd9e71c4e",
      "source_sha256": "ff4f1062e2bf505e57c026bd8e6a275d9e32d215ea2695f7a41efb2cb64b6ddc",
      "translation": "没错。不能把洁菲交出去。"
    },
    {
      "id": "coalesced:353cd6fdcd057fc4bca25a3c7eb3145a5d1b8e80f9a1e44e2089f259b1a0912b",
      "source_sha256": "b9f72493158a9c7f99740e915d4843a50b72de73306a7b2a18f23308de57101e",
      "translation": "我也这么认为。无论如何，我们都会保护公主殿下和柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7479969b9022e9ae4b708fdd13ea69869fa0437ed18270f8a681d9687d40557f",
      "source_sha256": "dfe873a9549ebf4124a186bdb7a2790ef5d30abe97959dca047735e509502ed8",
      "translation": "露……"
    },
    {
      "id": "coalesced:979bece8388d3a9d7d96981a57033ce2d0b2b4635bd0e5f9fe08f434d19b2001",
      "source_sha256": "036b417225dc0055a320f3403e2d05a1f0edc0a2fbc78c11ab9ac31751c27b89",
      "translation": "马雷族，立刻准备战斗。"
    },
    {
      "id": "coalesced:24c166eaa875fedff86503ae99227f36e42c32501909254cfac7ee749e16e5fb",
      "source_sha256": "167479800b54b7557b90741dfa9e305ce5687a306309273199da05e6d0e1bfa3",
      "translation": "族长？"
    },
    {
      "id": "coalesced:a3753852de52eef84a2c44779781effc8903d493741de6668ff48473dbc32c70",
      "source_sha256": "0cc5166c6123cc8a7ff0557285bba0e4bd9bdbd8a56bd47b5d29e8004321bc7c",
      "translation": "我们不是还欠着公主的人情吗。如今，该是偿还的时候了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7661a57010d8ad9abea6dd2e5318387fd03af95a058d38c8d1dfa1210e23947a",
      "source_sha256": "952e80be8ea3e240dc1153be41c6de6171f10ff415b3c54315d85ebc1284ce08",
      "translation": "族长！"
    },
    {
      "id": "coalesced:6635234be6f43826f232ef46628cff8628a200308f0f8a285093862af87422ab",
      "source_sha256": "34dced4342b126b6c6724bb96da00b91a89f1a55d96976da475df9a8f962eb72",
      "translation": "我们也会并肩作战。"
    },
    {
      "id": "coalesced:6df066fe9d831908f141e26b1cac7f1179b1191f3055d66349e2426fbc8148d8",
      "source_sha256": "4fe9822e19cc3e4163f95e899c0981ef0887dc173a6e50deafb16062cda15133",
      "translation": "绝不会让北部军踏进柯塔马雷半步。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b0eddf44f6b757660b4e7876b5f4e1e8dce8f14ff0f121e886b50db294c888cd",
      "source_sha256": "77021e628ca44372c88429b4404929c4ec085b75760426e8ea4440ab865bee52",
      "translation": "大家真是斗志高昂啊。我虽然不会战斗，但会在后方为各位加油，直到嗓子喊哑为止！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e3f431fd28c68bfbb6d92b9ba6424d1a30cca727e5510b1432d896e15895e0be",
      "source_sha256": "cbd649ba3180cb3558431b18d2d2c626c9ec469f14508a1d163f2897a224b877",
      "translation": "说什么傻话。你现在该做的，是赶紧造好前往拉·斯特拉达的装置。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9df144564b98b981ca992bd859cc623a236e0108eb1e17b1eb02265779f2900a",
      "source_sha256": "23e77de68af87591b01a531b2338557c29bda4f87efe1491a2a509a4d91bcedd",
      "translation": "啊，对哦！好的，各位，请务必平安回来。我会努力造好装置的！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:933c28b2ec8266dbb2b1296eb89649dff72da4af577702244e79abfc0c7611c9",
      "source_sha256": "aef4d5278449bddf03e15d9e55579c7485300bb6702cffdc5d958d41ae51e588",
      "translation": "果然攻来了。也请各位助我们一臂之力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d069a022d6d5d8d58f452adc26f2ad4964b6837e183301443ae06494fe70cb69",
      "source_sha256": "e2dcec0a922945b675855acfdc4e9144aaee103652b7f6fe2d0d0cce39cd3969",
      "translation": "请带上这个，战斗时会有帮助的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59421d1170dba33caaa43d1c2f1af565c6696b7cad17e43a766d0f9d0e11e661",
      "source_sha256": "10b7c1e496399511993b2ad88b0c45d2f05310014acab3fc2617a91fac30f8d0",
      "translation": "请务必保重。希望这次，大家也都能平安无事……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8998820033b27a6c0f90333475c8aa14faff0475d823b48ca66afd8cd34944cc",
      "source_sha256": "ba8459babd68f9622c6d6386ca0714c6f9b1a55313dcdc991ad236eefeeff41d",
      "translation": "村里的大部分守卫，都已经去修筑防壁，或是迎战敌人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c22161731ac3dc414156cab7ee34a4028c4e165eda644e3ea1b3cee5c93aff5",
      "source_sha256": "b794d42c3c50a17def2c8ed27a340b6b404541de8b4b68b731f69f2ceeaf3432",
      "translation": "我们也得去帮忙。快走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd159f2857621709653d4fd9165206d24196aac6fbd97eeaf038cc1613808de5",
      "source_sha256": "592e55e3af6d409b1e02b65fa712269b1e84e5015ff280e46a6a8541f6e085a0",
      "translation": "这次也会和那时候一样，平安无事地过去吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b16dda059f44c2966a158d8d1febb1ff5c05e354d2fcf9b478513fa440b6d7dc",
      "source_sha256": "36b32b463c23cbc9ff1c41c8308f959a789a9cafc3c002b6b1edc84c739f186f",
      "translation": "要是我的力量，能再强一点……"
    },
    {
      "id": "coalesced:78b1577aae2aa947626ba5c99e2687ab94af02975c83c54d1928e0dd28cd77d6",
      "source_sha256": "5000d49f5b441d0b7e4104d3dcd9626101ab1cec4a3bcd3078059a03cd9a8ed3",
      "translation": "战斗前，如果还有需要的东西，就先准备好吧～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47c878fecf7ab3bb79dfd0b9230984f5c123970d781bdd05337e97a730ff42e9",
      "source_sha256": "f89127e834df893129380e7a6780973b0f5280dbd52c7aca33b753a3c27a63ed",
      "translation": "该来的，终究还是来了。请务必平安归来……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1375fdf8f8023343d623b029361cb4d6e3d3900d3f0945df8330934738b1bdf2",
      "source_sha256": "acb6f16845ab42de2e8412102a7767f4a88fa49114b4206068ac9e9745419a37",
      "translation": "（不能把洁菲交出去！）"
    },
    {
      "id": "coalesced:66767402879905bd6d18d6b3b98cbe189b48715f97b6d734a0367dccb80e499d",
      "source_sha256": "5438a6d24747244904711a9d264ae537624b6d4ed8e198d85751474d59c17726",
      "translation": "（不能就这样退缩。）"
    },
    {
      "id": "coalesced:acd855ad7a48b01800c298c5abd845772af3be77255cb50a10d4ec1e6e521d98",
      "source_sha256": "25e622a802120bc8f6256e4a1cbea3518e9c9a7e087a3ace2d1c004b8450d082",
      "translation": "（不能因为我，让村子受到伤害。）"
    },
    {
      "id": "coalesced:1833cd4c828aaa87e23d18ef2616266bf293b00770bb27768eb9f8d784b00068",
      "source_sha256": "43e0516fd861c187de162080abee5abfab681f5702b5d6be6931858c288f8a19",
      "translation": "（村子和洁菲姐姐，我一定都会保护好！）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8ce4fac8f52620624a829ec95e0bf1019dd7cc8a80a9f391971d33e79b20b84",
      "source_sha256": "cac8a023d75073651f78b58ca2e592d1d5488e5184e9594186b022052b51f929",
      "translation": "（一定要保护公主殿下。）"
    },
    {
      "id": "coalesced:db05311040d841e90893985625dafc58e4d3b0f60b9cc31be43d201061e218e4",
      "source_sha256": "97981ed357b2825d3df98586a50f03a05eeb4ff62078a8b104e6d3784b7e03cf",
      "translation": "（不能就这样逃走。）"
    }
  ]
}
