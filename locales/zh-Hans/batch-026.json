    },
    {
      "id": "coalesced:689fffc5fd58f3c558e0dad97e9a35bd5c8d5b7e94906d499aa4267023db50cc",
      "source_sha256": "0ae775825f80121eeb98d740afcae986482e1ed13e53171fbe7ff5cc8e1209e0",
      "translation": "击败北部军 (14/15)"
    },
    {
      "id": "coalesced:27781bb35dc8413042d5747b4c0cd0056321f5b5b1ada6ecffcc5da229c78feb",
      "source_sha256": "f7ec4f423bb36c0cd5cebfbebf43999dc918cb584e5bb79cca498a2130d4d1fd",
      "translation": "击败北部军 (15/15)"
    },
    {
      "id": "coalesced:ae1c846c0a7410722268461e38adadeffe74c1fda18622d74fbbae9ae277c406",
      "source_sha256": "b3ef5a207f3558bf97acd769c3c7d3f344d2c1c28b348bf4309309fcb53240c3",
      "translation": "(北部军还剩很多。)"
    },
    {
      "id": "coalesced:bef03408ca92f929907b5194aabd65b069bc976e62bb5ab5a9977e65e8feb57e",
      "source_sha256": "2250e503183f3187a364cf91af1d85024f07c620e7d4639486474d8144cd4a9f",
      "translation": "(必须打倒所有北部军。)"
    },
    {
      "id": "coalesced:adf4b0f41c172238537b2e7a6455447a33f33bbcea09c37121035dc967153523",
      "source_sha256": "b4d53c89e9f54243dd5f838b2c2db4a60be167b0972d49fc5c03b1500ad56f52",
      "translation": "(还不行～得把北部军全都打倒，才会安全啊。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf8950da834133fb4f2a8689790efebfd9f902f2f0d653971257477dcc95856b",
      "source_sha256": "87cfdc7c9dad8669a459e1237f8b383f52601971609f0608821ace0e6cd89f6c",
      "translation": "(我们该做的事，好像还没全做完。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8abcef46e34a2644f5bbbed2dff8a334652e7f8b432443242108b88d8278397",
      "source_sha256": "2585039d495f55716ce0c94394b8d68923b05391b43f22cb32ea4431ddcbbb61",
      "translation": "(现在回村庄，也没有任何意义。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4f7a9587f0cb43ba00d9d4379ec03fa9b24f60f27fff9c2d6a5d350f118e56e",
      "source_sha256": "653f8414981789be196c40190db3edab2cb46be0281aff01a290a8745665ccbe",
      "translation": "(先清理周围的敌人，再回村庄吧。)",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4da87036a710c4d2cc42a93e530e25aba3a32e89b40029d08c8720c9b6437bf6",
      "source_sha256": "7b6fafb561233e847dcd1f746ee416cd4304ecb0110e6f2c15b27b52ad5620aa",
      "translation": "北部军的死亡弩炮得到了强化，风息岛的进攻因此陷入苦战。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3d0992a74a75e7f7cb553d653dc46d0a58d96d63cab30129f81a6b74c8057c2",
      "source_sha256": "50361c8653cbbc1f3cc08a62a53cba0732e481a01625c822cd9f39c1ad7c7886",
      "translation": "据报告，死亡弩炮附近有一台生成屏障的装置。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f1a32dea379b6b1694fc022a8e5a5553ce29579d106adf00e032f893cebba117",
      "source_sha256": "4cb238a447a7df484bd624b637b793c7b74115e060e7655b3f952c542175ec66",
      "translation": "要破坏这台装置，似乎需要很强的物理力量，恐怕得请阿尔戈阁下出力了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f498c4d19de5c1b48b5ac430f0dd64a04ada43522d17b98ac9928b2d153a186",
      "source_sha256": "522c32426a2c6cc4c5f24171728b85cd98b67ea15590d8491672403c23ff0fac",
      "translation": "我们一定会击退北部军。死亡弩炮就拜托各位了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:30f758d918815724601da6fc599c4d0de9aa3d76c3cfde842cf784b35878689a",
      "source_sha256": "2af2d0cff82400e998a01be8a50cc676c2efa1e52633072b88fd0794392ad0cb",
      "translation": "南部军万岁！只要摧毁死亡弩炮，总会有办法打赢的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4af3703f9b0fe517e26016c4ec801b8093a219774f4ceae71405c05f9b533b9",
      "source_sha256": "7c07aa451db7c02283a4db971304f65f1856d6eede031c55d8353e4fdd82ea78",
      "translation": "请摧毁死亡弩炮。"
    },
    {
      "id": "coalesced:5533c904790b5d3bea656b0b3c40263b5aabda3a9b6ece4509816eb4699c23bb",
      "source_sha256": "f8ed9e61234950218f3716ac2d2355440a957429665d1ad84424721a988b3568",
      "translation": "摧毁北部军死亡弩炮 (1/4)"
    },
    {
      "id": "coalesced:d169c6cf505e85a2fee61cf415b8349278d04f938fd801027f2b9c18048d526c",
      "source_sha256": "5a31e4484c40feaad1d1bfcbbf49b115326260b05d9cc2bc2ee2479ffa0c6073",
      "translation": "摧毁北部军死亡弩炮 (2/4)"
    },
    {
      "id": "coalesced:b7e14ab8c9ad3bd6e9cf5e4833d3f0ac4dfe3d0977c1ef36241481c96045bc49",
      "source_sha256": "b92921969bbd32b66af7d0a29a5af3682c84ac44933d2b587dd42c791ca37557",
      "translation": "摧毁北部军死亡弩炮 (3/4)"
    },
    {
      "id": "coalesced:33c84cd2f44bc5421ce166142555562cf9376efa028fa6d96d12cabe05135257",
      "source_sha256": "c2c8e599b60e19df091e5c9624ef221ca8b6429eb1f76b40633abfdffcb4b165",
      "translation": "摧毁北部军死亡弩炮 (4/4)"
    },
    {
