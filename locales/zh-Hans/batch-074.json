{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:a6e3fe4bc9a56c7a3bf15aa10183e3455d65bf8f54245dfd8e03409094637e41",
      "source_sha256": "618a21db4bbfcf297aad40e3aa10482eaac481713a6d03c6cb681d94246c5f18",
      "translation": "咦～有人通过库布给我寄信了？"
    },
    {
      "id": "coalesced:35b258dceac833e7177a99f08bdd6988be991a36943fb1fd9e1f80db21dcc496",
      "source_sha256": "6071fdf031b1a62a071f284b5aff53130836946d5dd75bd170a2ca8e7f7f00af",
      "translation": "哎呀，是族长？有什么事呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b45a6d8e0b631bb65ab6da35a9f4bc9286bb6c9d9362215a313a958a64ba4792",
      "source_sha256": "46c73606b801f1324190a1902548b74a11e5aa4f13c9ea58266e4e7531fc4c5d",
      "translation": "塞蕾丝汀，过得好吗？现在应该也多少适应外面的世界了吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:631ddf0ef1250535fd41cfd24759be3485bd96c81e2388de53e82d8e091bdc83",
      "source_sha256": "7604e722d01e7a0c0aa340b196a5705c069c94ea01513ab89e224c7ef25e0c6f",
      "translation": "是这样的，你的成人礼就要到了，有时间的话，就回村里一趟吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7acc5255446ba5db6d1ae1c754d0c543ae8c5e9cad6696cb3c5ad2fff7efea98",
      "source_sha256": "a5538badda1ece8a86f03c3adda9cb55bb62262c572830efbe245edf1774d937",
      "translation": "啊～成人礼！已经到这个时候了啊。哈哈哈。"
    },
    {
      "id": "coalesced:04595012144d570325d3da1d6664314b68a9f7c86db958a948b05b212d65676b",
      "source_sha256": "883e76c8d700ff3e7773e6bf6ffb0ddc9943f18cc77d5fd373b7cc9483d8f246",
      "translation": "成人礼？塞蕾丝汀的？"
    },
    {
      "id": "coalesced:3a96bd3ff40385f5950b763df3733cdc68effc2fb244b831212da0f0d2227759",
      "source_sha256": "8dac352fd30d198c4d003a1a1f516ced5fd6f66f082e3b1193db6a1a87f7cba2",
      "translation": "马雷族到了年纪，就会举行成人礼，庆祝长大成人！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2f9c73c53da3511d3c4aa34645534cc92c17643465ab1a76251bea0f7a65c9e",
      "source_sha256": "7862f210d16a7fb230263a0dee8f5ef451fba5bea7658687ff4f3eb7bb7b0b24",
      "translation": "而且，只有完成仪式，才能被认可为一名成年人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3b1f993a10a4d79ccfcf8a23ba40af317d872a06f4b1bb932285444d6411b888",
      "source_sha256": "b1a7098e52198ae6a5650d87a88e84c33bc7c2a07861ec8e8e66f1bece390e9c",
      "translation": "也就是说，我现在也要成为大人啦～咳，咳！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d633a66cafb1c510a0295b02cf5867de3d38387a7cfb9ac68a0a27b6e3dacc0",
      "source_sha256": "f4a43d2e00713fb411b6f5ddbcd2be8534bcaec0542384c694525bcb660850ea",
      "translation": "原来马雷族还有这样的习俗。恭喜你，塞蕾丝汀。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14fafc38cb9813eeaf65810256aa61382577a72c5975a309a6dc81c86b9420b5",
      "source_sha256": "4384a02d84f42e41c7f29e164999a4759fbe3497d12535bbc6f239389e8d5a1b",
      "translation": "大人？你到底哪里像了？脑子里明明还是个小孩子吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:060d8fefebed3856990d3f5ff3de126df25009166623a5bd101ebcdc4b24499f",
      "source_sha256": "1ece7111030411feb27349ab22d6e0424517b8af72c05ff126b5d706e2b27fa5",
      "translation": "克罗塞尔！你这家伙，对姐姐真是什么话都敢说啊。仔细看看，我可比你高哦？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a03c218b0c715b636bb2917ecd351e33af092085cf93d1f7a28f8ff364788cc4",
      "source_sha256": "8d92cdbfd109b661af36c067df2677e153e81dc59b47a02ec3638087b1e318fa",
      "translation": "对马雷族来说，成人礼是很重要的仪式。还是去一趟柯塔马雷吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:acafee574b74aa21148c910dd5efd2a3a1811a001636ca7ce8ee453eb811bec9",
      "source_sha256": "7faf24657f80b9d85dac5fd49ac453e9b4a36a3091954bc46afce0eb17bbdc98",
      "translation": "阿尔戈哥哥也想看我的成人礼啊～只要参加完成人礼，我就随时都能结婚啦～嘿嘿嘿。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c2001bdbd7971215d6021dc0b87077496d27fbe5f2ce04e14002ac67de46ded6",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:31eeb57ab3cea30fe7c12b63c59a8599be37531673bb8b50a002cb404880e8f1",
      "source_sha256": "cd2d911a9b300ec4c2f6b6bf53324c99fa455ddc85ec7312401fc1a4840f1677",
      "translation": "恭喜你，塞蕾丝汀。"
    },
    {
      "id": "coalesced:092d4a49a5690126d758a025df25d82b2c99816d7363f485853735a469d5357c",
      "source_sha256": "d387bb65c742e377f2c7d7fee3d965ebaf5b02c7597ade93354df2b96bd766e8",
      "translation": "谢谢你，阿尔戈哥哥。我现在也是大人了，我们快点结婚吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:55cedb1609932086a589e55e04c7a95c21bf65e3c62f84b0c6dfeed3a7565acd",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:2633012d979f76cd2745f74c723eb93931d940567456c618356b5844ca737c62",
      "source_sha256": "be89370e0e3ccb499980783f31883138bbde8c664dd14566e7e69a2d03470829",
      "translation": "虽然心里还是个小孩子，不过，还是恭喜你完成成人礼。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:146ff72319ca6bf19509b975c1dc8ae043ed972d96412a109a51572915675676",
      "source_sha256": "9fe561daf3e22141e5651c69468d3ba933db37d6f87453dc944ea561edf4212a",
      "translation": "恭喜你，塞蕾丝汀。"
    },
    {
      "id": "coalesced:d06fe091e23bf89b58a89372b49e1a4492d2d07de27c3a7803e086537198dd17",
      "source_sha256": "70fab87aa48633b14ac0b45b5a08d9656788d7a01acd9b14b5f465591772ab0a",
      "translation": "真的很谢谢大家。今天是我一生中最幸福的一天！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9754ba593ad4719e712fe5ab7a79f7fc8c56eb1aac0b13ec33d49a9a0e72e4d3",
      "source_sha256": "f74aa9ddf370ad86d383060f428c2be9eb9aa1426567855aea5dd83a1c8a8128",
      "translation": "一生？明明才活了12年。"
    },
    {
      "id": "coalesced:5e9f57ed5c4358870d7cae4c6fc1a565b58bb144531bba49d15553ba3c12529c",
      "source_sha256": "0b73c58460978ae32514803c730a9d3e34a801cd29e8c20e85d9bcf30915bcf3",
      "translation": "你真是的，非要给姐姐的好心情泼冷水吗？今天我心情好，就先放过你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c229b1d35d68244cde8f66954e645e289bb70eaa7bf5aa5e99834580b15cb76",
      "source_sha256": "83265b05bd18c6394c8b422d791abbd5149b48b359e9b528b018feb04d2aecd4",
      "translation": "今天是个好日子，偶尔尽情享受一下也不错。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a68f5c5a605d03398e0e1fff7b7daeec5d1e127b347935fae2c33bf750ee7c3",
      "source_sha256": "2b73d64a4025f843a04d829164d5c00aa0ab876df891a013abffffb9a66c0944",
      "translation": "我们暂时忘却了纷乱的现实，尽情享受庆典。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e3717eae0a0b5dc7430c6110002ca85ad07fa01bd56d56713a87d61b8dd5ea6",
      "source_sha256": "78de8b333fe36edc83664dca9efd41364b0e1a49e06887daaf246aba07812430",
      "translation": "短暂的休息……不过，从明天起，又有战斗在等着我们吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ddb381bf290487e2baa9c45a014ddc2d564bbe650b4a758ae5f79b94f29fe9c",
      "source_sha256": "dccdba57d10e357a7f9d175379785b418fe34f4cf519645ee5c68b9f850a8464",
      "translation": "第二天……"
    },
    {
      "id": "coalesced:d12942fa13cf091751a9fc1b41b349ac18a9c5818d15c8456e037ffd8e33529b",
      "source_sha256": "b2d0dccc39fb316a8d21ce3e7eac4b5dd435da212e096834badcf413ef1f09ee",
      "translation": "仪式信物"
    },
    {
      "id": "coalesced:b14b72d7f9e68bc1d6fd53a228c45dd44b182243092ae6f5c5138c85190a457f",
      "source_sha256": "89bbc7321dcade7eda08753827fd2c462897fa981087e74efabf510ffbc03b8e",
      "translation": "马雷族举行成人礼所需的信物，上面盖有族长的印章"
    }
  ]
}
