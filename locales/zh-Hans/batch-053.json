{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:ae03754a92e11e702873b08520aace569ccee8e6de6fc1736d46f8c63ba03e21",
      "source_sha256": "91f74336e8c3e9a873f59c7e77fb18ffa5be7204f0abd18e72394e30f5fdbf06",
      "translation": "卡蒙德已经找到了，快去柯塔马雷入口吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7f75d9569788aebc2aa2940804e21b87dd027b3323e1188704051514cb6c8b5",
      "source_sha256": "51378702c22c9eaec4296a57dae542cc33b6bea43a9cc311bc58b846205c37c7",
      "translation": "公主。"
    },
    {
      "id": "coalesced:1a79e04bef1be08e86eb497d8cec21734950dfe2d151d10ee582ca17448b85a5",
      "source_sha256": "4c578cafda642132a19b7a76152d2ad5e01cbaf9abdda5ef0525f50f24a4a482",
      "translation": "嗯……？"
    },
    {
      "id": "coalesced:9e60bf524da5ab04ca1866bfdcaea94bead9b859da5e20ae095dcabac40c5f4e",
      "source_sha256": "a7765c4974ed67b4cd258d1c18d86eabd5d7ead3720ce7a44152de4cd236fc8b",
      "translation": "我们一定会救回朱特的。请别太担心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f6b7ab041faa2da16b573dfb55d2d4bf2436ee3f7ff01e8432d2df3e3eeccba",
      "source_sha256": "dfe873a9549ebf4124a186bdb7a2790ef5d30abe97959dca047735e509502ed8",
      "translation": "露……"
    },
    {
      "id": "coalesced:90bc71a0298330ed0b29b81318695920bdbde3e77084cd0c086a4cc4920219e3",
      "source_sha256": "e7e669280aaedc7614c587e27d6ff3273d42248943b206df943467ac684eba7e",
      "translation": "我……其实一直认为，只要公主平安无事，就足够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3441064aae5adc166960ed89a64ae3614fdece2f86c25afc80e73ee0a15755d2",
      "source_sha256": "f08c12557be9213792b67f33d9697ba914eddc18abcf02bd227cb8a41edbf2ef",
      "translation": "可是，事实并不只是这样。"
    },
    {
      "id": "coalesced:720554b788916e54d213b16d59861875e98c493174c87ada4c194b73f492e724",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f65cb7ae83bdcaccca4e533377608f5343ad3bd47e2035706079442343531a86",
      "source_sha256": "bbedd0ca6a36f0705280a86ea3ed60729d759b3913345f9853c0b7f3c1d8233a",
      "translation": "朱特虽然保护了公主，却没能守护公主的心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be0eec8082be474140f9ace6f5596ff6343985074cc11fa6352149a1e8554830",
      "source_sha256": "3682e81c334749a25cf27ac3868132505dad889550103baff9d3a5b95c3c514e",
      "translation": "所以，就由我来守护。"
    },
    {
      "id": "coalesced:dae7c00cc855b5f4a981a6541a7693ba258d91d8dc447bcbdb4727c223bcd015",
      "source_sha256": "bb80025860f5a32e10103ba60fde1b5e7f071220ddcd83317a29b48911994de2",
      "translation": "为了不让您再因朱特而痛苦，我会赌上性命救回他。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fb46ecb73cc93b32b65659b18f3b74555baded7280526b440f329a109c755a29",
      "source_sha256": "dfe873a9549ebf4124a186bdb7a2790ef5d30abe97959dca047735e509502ed8",
      "translation": "露……"
    },
    {
      "id": "coalesced:4e874d696b76416425c4bc67a85faca45db954d54124d7645ee88da9cb79cc9b",
      "source_sha256": "81ed13ec092122ddd754b8897cb44749df262b94f96fe168643409f598e6cd70",
      "translation": "谢谢你……"
    },
    {
      "id": "coalesced:836f665b843b3188bba8f84d4c08afe2e6160f755bd7764106de186c447e96ff",
      "source_sha256": "aeee16b372bf38441e27ab132fae8b19721005b17f3e5b7335197829982a3d81",
      "translation": "走吧，公主。"
    },
    {
      "id": "coalesced:71bdbb8f4246de0941223abca003e20b4a92f4beb04f05a1a1a6c7541138df76",
      "source_sha256": "24f75dbeac3f8b78825ec8b06a38ad04d84dce5726ea83ed173b414738614ddd",
      "translation": "那么，现在开始精神接触。"
    },
    {
      "id": "coalesced:fc9af7adc13e6f8503786bb7ee549ee0998d94289a91bb5a27d20ad04134f491",
      "source_sha256": "6184ef43526477ac8ae4936a979827fb2c20bb49d8e7ffccedce82f9e2eb8f7d",
      "translation": "这比血之契约更加危险。请小心，不要被卷入朱特的精神之中。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:703e94b88e59c40852e94c25289a66971e80913e4e8faa204d76d7a13fe060fc",
      "source_sha256": "17b706dbab0c67bc5a88a5d2a538df63cf532fa958f7a241fdcdf95357794d46",
      "translation": "因为在朱特精神中看到的一切，终究只是幻象。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:39252407ea65d8a8dce0aec49fb4b1104ce1b97da50d226976c983eae8ab6b03",
      "source_sha256": "cd39d9a4643109d3a4b7dbceff2109b2e4f89e9913da3763aad87394f99f93af",
      "translation": "我明白了。"
    },
    {
      "id": "coalesced:7131134fa42a6615a6cd31b72307b0248a8bbcf41de6c37b3b1af1d2f9c733ca",
      "source_sha256": "b32b2cabe0c49a51596172f9774cbecebe714b855056026e0dbf54960c5db497",
      "translation": "我也去。让公主独自前往，太危险了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7fcc08d5e2c05c65d18e837e60070ce9a8125880342046daeab15295a5e61b2",
      "source_sha256": "d5afa12c7bdf83046fb0b556d0ae6bb7d945c8f1db5ce62896ddd67717800e37",
      "translation": "我也去。不知道会发生什么，多一个人总是好的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c782ac20b794e1b6c9e2fca05fd2c28ea688d1da20a89eb150e1e2259e985297",
      "source_sha256": "c76f434d8f9dbfe04b1eea075b20b5c1b97c34f1fb58632daa5805a45b8c8e1b",
      "translation": "啊，阿尔戈哥哥，要带上我啊！"
    },
    {
      "id": "coalesced:ae071b55692d411af33170635e5bbb1821d55265cab526d4deff91660b66471a",
      "source_sha256": "8c21c241441c8a67de69a074503c8f9bc413395ebe7c23100f1942d66e70cb02",
      "translation": "什么啊，到头来还是大家一起去？"
    },
    {
      "id": "coalesced:a2039baf083dacc26358e9f6e1654c90c135a4f559e87febd2e329a2d450325c",
      "source_sha256": "56f0e073e3ec81e08076ced65c56ef4834ed24a846cd8ad5cb89c661f85d792c",
      "translation": "不。这是我自己做出的决定，我要一个人去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81fdfe23ea54e2a0e4fae266a1e96061cd345c9c36898be7b4934e87a63b1dbe",
      "source_sha256": "dc58ad97693c4b2e36a11eb26c4498ff97d9a2a29b427136ef2f10ff6c34b123",
      "translation": "那我绝不会让公主前往。"
    },
    {
      "id": "coalesced:5c336473e9e20ad587184b45415ed7471bd1e1dcae98aeef2ba7becc45d92ac5",
      "source_sha256": "6f9b6629bea8f94ee91daa5924aad201ad9c3a24fb4d4e8acaa4d38318d86d5a",
      "translation": "虽然我也把朱特当成同伴……但对我而言，公主的性命比朱特更重要。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a60a7ee206da12443049df6025325a9a96a4bb2d68d196349f3af89621e3e37",
      "source_sha256": "2aee32292c05c490a8475a0cc38315cf24c12a95987515f8a7cc69ca799500ee",
      "translation": "上次与艾尔加战斗时，因为我的疏忽，险些失去了公主。我不想再经历同样的事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d4b1709c9acde74c266d3002d5077a750b916199f4869d8896144ededcbd17a",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:a8cdca25a9a41af06a36061a4c023cbe19254e0a0e51255af1ea352b55dd287f",
      "source_sha256": "bcc2885a9522eee0f008042dd70f063e941e36aa3cc5a6095abd591682e02c20",
      "translation": "啊，那个……对不起，各位没办法全都去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f492b160536bbc005d9cfec7d98b6d564a2bc6c46b05cc519ff2314b6e5d1a45",
      "source_sha256": "3a50aa8f68c576d4b42b422e5004992af9baaa8f2b180c4255cb6fc803b9e525",
      "translation": "因为必须有人留在这里，对付朱特化为实体的黑暗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ad8bf506aacd4e399d1aa9109f43a1a3a547cfc66811ec3d48b0da831627f57d",
      "source_sha256": "75b7c22c44c1c0554dc7affa626afa1b7826b4373968f6963419c79a2ffe0bbd",
      "translation": "而且，精神接触的连环术需要高度集中精神，我能支持的极限，恐怕也只有2个人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e2686452040f64883391036cf4844180dc6cb7219713cba27320fc04d6e41d8",
      "source_sha256": "c0b723f39c6a8f95ac272a77e0c8db911c39283c39f239666fbb54037ad14a8f",
      "translation": "是吗？这样反而正好。"
    },
    {
      "id": "coalesced:8e8f9859729e2c514503c41de0d110ef1b34ec5e7f49c8b49ca91b8f8f0d2298",
      "source_sha256": "c34dd00b3557bc94b974c626aec391919b8a5b6b0cb2cc2f0dfd8a1a6d63e29c",
      "translation": "那就由我和露接触朱特的精神吧。"
    },
    {
      "id": "coalesced:71744eff3b3c708b18b662ab78a9b7650f37788cdc8afc7a8ed0cec111373b79",
      "source_sha256": "8bdaa165a12cbc38c3ed7b57c6249b6343d28daaa0aca7800821adc05281c904",
      "translation": "是，我会与您同行，公主。"
    },
    {
      "id": "coalesced:88bc57faa9be7430e76d5a3cb44d89516fc30ab8610ca7efb5b17f55aa22c833",
      "source_sha256": "4b34564bbfabba6cb8510f290e8978b564cb804ce98b7bf2ffbfb15d6ad11932",
      "translation": "抱歉，其他人请留在这里，保护尼克斯和朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:803a9d6e57dfae52ed9d9be05a02c8d0b105210e5a04b0fc592304382665207c",
      "source_sha256": "384dcc29cac630686fddaf0bf8cbe5533ecbbba67dc1be7bc1b3c2fb36ff24b6",
      "translation": "没办法。不过，你们一定要平安回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:074d5c25de3d5ac41e250cc65837fe7cb443edc743ea728a863c700759f88c00",
      "source_sha256": "5f9690d11f7389d37e9c86ee3d86d12373d736d4a91f24462f56874f3e421442",
      "translation": "嗯。拜托你了，阿尔戈。"
    },
    {
      "id": "coalesced:78c89fc8374a32e3194c25e048fd0528ae0fff5e151505e905ed940e75171f9d",
      "source_sha256": "31db671c04fe17cdf3cd5524de2720d5907de02d8808ddb4240234fc93f2963e",
      "translation": "好了，那么……现在开始精神接触。"
    },
    {
      "id": "coalesced:af50f7993e5df7ff96cbc9bd54935f3d52186b6d0b95440e31c447927590c7e1",
      "source_sha256": "de1f57a9f73b1441cc7bb014b97f0408ee5ce691bb24df888f5e0a337f46e658",
      "translation": "请小心。接下来，朱特心中的黑暗就会化为实体。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b1112532e37be6ee401099d42c25317faff8eafd33da5b7178513b1cbfc79c7",
      "source_sha256": "4dd068901000e99728226c8c0f4a7fafa0b4b1d09e143fab22bc489462ca0e26",
      "translation": "我会阻止这些化为实体的黑暗攻击朱特和公主一行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5eb04e7c9e1a9bcf7075ba03490bb99cdcc5e71bbf63153127da21384539f61",
      "source_sha256": "3b9354477a1510dc9a8afb8037b4eb4a72bf87f9c55089ad26de912fcc498375",
      "translation": "不过，如果我倒下，精神接触就会前功尽弃。所以，虽然很抱歉，还是请各位一边保护我，一边战斗。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:627a7993573749359d2d23462b46e4ea6d91710899a7dd3ab650f14b1ee61f84",
      "source_sha256": "75cf382272ee894864e5243cb04baae342dbf9073e71736ff88218e74789410c",
      "translation": "明白了。别担心。"
    },
    {
      "id": "coalesced:491122b7a0113aff334f7fd7cc204dabe6388aac5efa65c7d9fd3c4aec22676b",
      "source_sha256": "ef40df2f584c541f6c9fa8967ca19a97d0a09b4868f9f4788087cbe73a3676b3",
      "translation": "那么，拜托各位了。"
    },
    {
      "id": "coalesced:fbfd8e2fb9f79a3fc61a1a5d9113a816a07c5216ebd8efc8aef6c9819b08b5aa",
      "source_sha256": "9ccffadacaf506b2da2b99b46455253b4226544d97a246f20e158d89f719956f",
      "translation": "呼……暂时结束了吗？"
    },
    {
      "id": "coalesced:9824a1b0de191e339d9c0ba512a9bece83fd43d1d52e69ba6969864b45572c87",
      "source_sha256": "9c555b3799a59dc104fd4ed3a6cbfe7733a15f5c8e5854099261248dd441da32",
      "translation": "现在才刚刚开始。公主一行，这时候应该也正在跨越第一道难关吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:776b3e633d0279c485393adab3280ca9193f8caac3730068d60dde8bf902d8b4",
      "source_sha256": "c5dd520f74a46947eee7efe829852e40dd2bb44006d8043f4d4b6ed12d0b0713",
      "translation": "不知道朱特的精神里会发生什么。他们能顺利应付吗……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12425590b38689ee9f407d55abb3bfef2ac8a2fdc1ce704870ced488c6f2cc1f",
      "source_sha256": "2eb38749c33c6f3d8be5a76e39e4d687ee808b909f354f4f88ec34a6ad0424e0",
      "translation": "好昏暗啊。"
    },
    {
      "id": "coalesced:ad38dff309de380e7e930d9461a46f4dda536e129e7acc065ffec6afebf5c849",
      "source_sha256": "d78348d3e040d6e24df45fcaec5a62c8982b0f07a4a2cff29016183b35cbea9e",
      "translation": "这里就是朱特的精神里吗？"
    },
    {
      "id": "coalesced:ce848ccc2ba4e03debb285eb46e0addf8b1b55b3e9c33266fca85458f7444365",
      "source_sha256": "192ba23911d6210a8007162ec71a2325e520a91b634284bdf1f12e70f2cf83f7",
      "translation": "前面有光。往那边走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20ee5b150f938afd1e43a5198fdb4ec198f926003f7ef2c01e4ecb750b6a1f74",
      "source_sha256": "8a4643d4ab4180122005bd36999406613e7b03f06bf3c7ccd003076fdcd8cd07",
      "translation": "你们是谁？从哪里来的？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:09d6ea0609f8b62aae699fd7a7ed978c73795a76cf351fe6c2cc7e77ff3dd708",
      "source_sha256": "1fc5de1e8e252da179f01c9c27c1249c1a1436776611ece0330b7923d1a8442f",
      "translation": "朱特！"
    },
    {
      "id": "coalesced:632c871d9966b863efa20b052fb6759fb64ac6d730f96a223d2fc5f2771490aa",
      "source_sha256": "58e9f73c3ea12be133b0467d120421434fcf35cc08c7f9ecf4e6026308a3d821",
      "translation": "什么？你们认识我？"
    },
    {
      "id": "coalesced:0d7331be5702bc3ab983f620ca1bb7d0f0ade58ffa195f02964dc22894b93bc6",
      "source_sha256": "5b0d45f5abf59801fbac0183134208db7d5972249fb5d8ab0bccac58dedcf475",
      "translation": "你在说什么啊。我们有多担心你，你知道吗？"
    },
    {
      "id": "coalesced:072890d42243d8f0e7f78bb43445a78198013b728b2aaae51d6596a973e2e5bb",
      "source_sha256": "ca260545bae2f5727d21f358c62e5697cb4a54359b2ec7b3c92f772c1c9b1224",
      "translation": "你是谁？为什么要担心我？你认识我？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e28d01fef9288a9f71a745c21842384e3fcd391fb190bfbf179acdc74b1b4907",
      "source_sha256": "acafe38fe70b44972c47776c2ae8ebe25ee11ba6c896f2314c19231f55773f6a",
      "translation": "朱特？难道你……"
    },
    {
      "id": "coalesced:aa759f1fb676489ad9f58a8127cf2082a5a07cfa7593eeb39756882674884d86",
      "source_sha256": "d50d79f3e1447c0b93024616ca4edff45f86c3d8fb87643a4e38c9ee0b3b037c",
      "translation": "看来，他似乎不认识我们。"
    },
    {
      "id": "coalesced:f3261f1cc6eea12d89b1882bb969d40e82ce85094873e9a859b114a8cd68b1e1",
      "source_sha256": "8f956ce8ecb500d80c384089cdb5f07bcd794bffd8a9c872eabce42ef3c6f1b4",
      "translation": "……你不记得了？"
    },
    {
      "id": "coalesced:bd53ae836bc0eb07c862a77dd1a4c4a7fb85a7a771ebe49fc890245baa88dc02",
      "source_sha256": "a7db2134ded089f59eae6d5f10b145aca9cb7705180cc42320e1291dacb4d2ae",
      "translation": "什么不记得？你们到底在说什么？"
    },
    {
      "id": "coalesced:7ef4b85e74129663a42362a19bd2725cd929a94bdbbb2ecda43f6cb2db71b8ab",
      "source_sha256": "7f235141182a843543f3ff0bb79173236afa34d46e46b4a038ba4862cbe255f1",
      "translation": "那么……现在，你还记得些什么？"
    },
    {
      "id": "coalesced:b56521950ca007787c8d9640bd3af56f62d9e5e9a24bc61a681f52083fa1f535",
      "source_sha256": "8c1a19e6cc1a79fc10f55c837dc668dc537c8ea1508336f33d783aace8e0d8e6",
      "translation": "不知道。只记得，不知从什么时候起，我就在这里了。"
    },
    {
      "id": "coalesced:a73001f2183ac918842bf7ba7a239f2af7ef1ebdc77e1e9f415b51d752479da9",
      "source_sha256": "9a7bf47f9528084e72e50619b76352e8569d6e694502efca2466ae21167e959a",
      "translation": "果然……看来他又失去记忆了。"
    },
    {
      "id": "coalesced:484d892ea6363f9fdbe9cc48f36457ae8626e824669ccc307cb47d3ce73b05ac",
      "source_sha256": "1a2e4eb4b133a5e554098c093f81bf8e75259176268f9c3d217b3a0020683b71",
      "translation": "朱特……别担心。我会救你的。"
    },
    {
      "id": "coalesced:7eaacc60cf1098166e4eee1c44ded0252bd6c372141d6c578461ddccaa2e92cd",
      "source_sha256": "a85eccc7cc062f1e42997aa50d288199331d017d0c558b242e502356e614d42a",
      "translation": "你？为什么要救我？"
    },
    {
      "id": "coalesced:b32f24da4324d9f60ba5aa42bf2b3adf4dd4f53e1d290cefb253f41712366289",
      "source_sha256": "1d1552d940036c606637c6d3c3ab1f76609c9988db66c4403ac9de05cea6b668",
      "translation": "朱特，你那是什么态度？公主可是为了你，才主动踏入险境的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cb00a3a6c45b81a71eb704a8f89bd81d7898dc1b4861d18eba96db1972260aed",
      "source_sha256": "e150077f5b37ebe14f234119eec4351cb687d837c9cb18ccc09edeaa2123d276",
      "translation": "没关系。看来，说了也没用。我们还是赶快做该做的事吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:38a294e7b6d616cb699cd9ac6349b6775cedbda2afffc9fa994c21aa91f5d37f",
      "source_sha256": "a76d6088650dd804f4619d2e34f44716ce9984fea9a9df543bf92b56aef649e9",
      "translation": "朱特，如果你也想知道自己是谁，就跟我们一起走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:547456c99e07549bc94d6380b3d7262c6cf90d20bd43eca5d21a2c3dc46da967",
      "source_sha256": "eac328719903fd0739cfd51dbdea03cc20a23246c4760cf2a4587affca19169d",
      "translation": "这里……可以随便走动吗？"
    },
    {
      "id": "coalesced:f974f66ebd022eb98670d80f81539f21ff6689b2a4c9c7e2b396815366c21626",
      "source_sha256": "8a7c4128c464db2678c98f5de526b1295933d6e161eaacfc5c4a4fc079edc658",
      "translation": "少说废话，跟在我们后面就好。"
    },
    {
      "id": "coalesced:bc6d3e22e50a5f4c3c99f599d4944308bd968093afa660317e787f247ad2a443",
      "source_sha256": "eb876f809955375f5eeae7209e69725d4f9ebab0934a74a223937e40cec33310",
      "translation": "为什么瞪着我？我又没做错什么。"
    },
    {
      "id": "coalesced:490ab5c849448600874be579298af29a4162a5e978c365a7a71ae0a4973e57a5",
      "source_sha256": "511254bdfcc69558ebe456a259062629a1052501e7f68507875512350ddd9538",
      "translation": "就算失去记忆，也没想到他竟然变得像个孩子一样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5479433cc06984bf2336c79466fc27bdf35493ee670e85b31e70eb5600dd78ce",
      "source_sha256": "252bca3b8b462a82cc963cc5bceb29898282c03ceb9422685fda83548f19d262",
      "translation": "（必须保护朱特。）"
    },
    {
      "id": "coalesced:fa9c2e0fd0438a4173b30d1ee52d64729ca897d9d8ad7544894dc600536ebb3e",
      "source_sha256": "311f35f5459ec918a2d38264051410fe1865df319d16406340bdc30d7f041c01",
      "translation": "（得保护朱特哥哥。）"
    },
    {
      "id": "coalesced:507fcf3aa3eb354e1e5430f62545799c4e667653b441ad6a335c5d8563b781f9",
      "source_sha256": "fbfdf17758fe66d457709c2b76cfe5259390d615501fbd1debc85c109be1119b",
      "translation": "（在那家伙清醒过来之前，必须保护他。）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e3555a1facb96120de49fc8885c0be60ec7385801554355b8f5415c478136a5",
      "source_sha256": "7dd1b1c873514861149baed51e398b8507fd963506f047727c998e63bbe3fc75",
      "translation": "精神世界入口"
    },
    {
      "id": "coalesced:8f6ad2c5cd67d6d83c583e6c3a8a970ac0c5777e8a46ee97b86cfcdb0822d5c5",
      "source_sha256": "bfa80d1f28899c48da80a7cfac63328e6a14a1ffb12aabe12c02c75db7f27f3f",
      "translation": "啊，你们说[觉醒之香]啊。"
    },
    {
      "id": "coalesced:147a776f78370ec4c5584161a05bbe5a413b9b4d8a8e6ed4e7c153c567ecfe75",
      "source_sha256": "e6f480c3e48b42b6650e14e0d3ae2788bbdb011f71b2d1ecfa239558bf244836",
      "translation": "来，拿好。这就是觉醒之香。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4503fd90b2d5039bedee95b865023fb14cf38a5b4106780c58f02bc9a647585b",
      "source_sha256": "a183f892e9e105599e22888bb8256c4f850edb6b5b3f07bb48af8cd8480f7df0",
      "translation": "这种香必须谨慎使用。要是不小心闻到了，可能好几天都睡不着。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c4f87c8311adab781cb5ef249cd98d8e385595de188cf0c4c14bd14f7af5d3f8",
      "source_sha256": "542ce0b48fabb4fcb25b0081904804addecc8d67deab718c8f48be075d5ed33c",
      "translation": "这种香很危险，请小心使用。"
    },
    {
      "id": "coalesced:ec20d2b312ab50d82e29bfd5aa64a880d4d512d40de48618d817712da6fbadba",
      "source_sha256": "c40dfab5ff3daceec36627705d29ebcc1f8b76c8666752221e10b0fbf954b180",
      "translation": "竟然有这么巨大的卡蒙德。卡蒙德里能感受到极其庞大的KAN。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28771e5ba9f460dbb23b568f0b244397ee974d2a2c7fd50131f977a102f2531c",
      "source_sha256": "ad1062fa329dddc03abf9beffa74f93033f0f1476a351eb8beec97477124a414",
      "translation": "没时间了，请快一点！再这样下去，朱特就危险了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:774a9569d8322ee48b34da8eec25677e94aa6a45c043b428e8c8e76e7fa925af",
      "source_sha256": "e27ffb965fe2825e28471dad7a77b1bc9fb9709121fa504c65a78b6b682e2336",
      "translation": "卡蒙德已经找回来了啊。"
    },
    {
      "id": "coalesced:24367ac4c4b32a168cdebdef2babc112cb85814250ea48d0bd5d769008c38f8b",
      "source_sha256": "5d8f93a0eb9def23bf9eb8722f2af518373f80eeb989d4ebefbfb3eacff82c21",
      "translation": "辛苦各位了。那么，立刻开始治疗吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:23add876735933a7f366fdb05f7c2725972defce5e5cdb053cb3245b6e1cc246",
      "source_sha256": "c90aebd0727b0518830c18a491ff53d0ec0bb54913d4f0e9208b73abd4bcf116",
      "translation": "QUEST%s：获得超越卡蒙德"
    },
    {
      "id": "coalesced:4d3d6246d4e6c0832da6fb231eca281bb1476f795f743e09d36f8838fd84bc5b",
      "source_sha256": "13e4401daae6593067117455243431a88fafc3a9e1567a9b92d05ccca9f7e33e",
      "translation": "获得超越卡蒙德"
    },
    {
      "id": "coalesced:580762938cb96c0954080fb61f9b720b465117aa7ca32020c1ab5282af2e9f96",
      "source_sha256": "da357a716884278c02f75d1c7044161b37043c1a0191712e2a17ca2c9a26d975",
      "translation": "为了得到救活朱特所需的卡蒙德，\\n必须击败出现在海底洞窟的[佐帕]。\\n请先使用[觉醒之香]唤醒佐帕，再将它击败。"
    },
    {
      "id": "coalesced:94135ea672756d1f1d5e39eb6f1e5d1c8a0cc252fc645cbc7cc32c585d4c856f",
      "source_sha256": "91341b3dc4dd2a87c92e9c6b2e60ca79aeb1a972375422f028844c918e7f1b8a",
      "translation": "救救朱特"
    },
    {
      "id": "coalesced:107afcfcc1bccb34a764b36823fccb9d0c626458dbbf305171cfc1505e17a63c",
      "source_sha256": "02667ef452a1d825726f00616729086403658de8174570e6afe824c3d02adbfa",
      "translation": "超越卡蒙德"
    },
    {
      "id": "coalesced:48b2bc2a62c0844e708644d7114082d365c9ef92b41d2103667c3b522ba1fb6d",
      "source_sha256": "7564044bd4b1a2e4a47ad6a845fadb21919ec05780a0d30cfbe07a386e349e88",
      "translation": "据说连死者都能复活的传说中的卡蒙德"
    }
  ]
}
