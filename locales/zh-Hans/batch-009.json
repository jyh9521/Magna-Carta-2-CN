      "translation": "非常感谢各位救出我们公会联盟的重要成员。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f74b2ca4c21b50c4541f1ac380a271708259e3daa15039029508b0f27f8841f8",
