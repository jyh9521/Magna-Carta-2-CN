{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:dc92702c53feeee4be0a7c01351751963dee22f17e9f76e77471f28479961f7f",
      "source_sha256": "4554c18ceb1d0f969681a1bfe41173f75483249fbffd4ab489f763f85ab42aeb",
      "translation": "喂，你想害死我吗？"
    },
    {
      "id": "coalesced:bd94b1aef0fa3938c0bd06012e0a3845a058c718fc5a79245d645d4a7f2bbc7c",
      "source_sha256": "7a4bbe5f4bf1de15b41556b7b9361b9fc4419cbc98030d128b7f520530933858",
      "translation": "自作自受。大家都在忙着备战，\\n你居然还能睡得着？"
    },
    {
      "id": "coalesced:dadcb5aff2a5b19dc17d2ff79bbc1acf5ecf140e0307b7f2be40a9239017ab40",
      "source_sha256": "bd9d64a00a42b9a34ed50fa9e78f34454d55fe28ec9247e91efcceb2cda2bd42",
      "translation": "北部军打过来又怎样？\\n上次不也是你和岛上的守备队把他们打退的吗？"
    },
    {
      "id": "coalesced:d268c8ab9ad5f0b6395c3874aa8babd4a4f3735db01991a4197edb4e9b0e6185",
      "source_sha256": "5c28f26b1e4a1c6a1c9daf4ea34cdb1c1f94c43375b2cf55e3a5adbd8c9d7986",
      "translation": "上次是碰巧南部军赶来，\\n我们才平安无事的。"
    },
    {
      "id": "coalesced:7cb7a510cc55549e7ac8f568a2a68abbfa569b8106b91cc70076fe597c31c337",
      "source_sha256": "83d5a7d72e44cd581cc216288c86e69d4e1871c3e88ec814001ba3aedb8a73f3",
      "translation": "要是北部军铁了心攻过来，\\n这种小岛转眼就会完蛋。"
    },
    {
      "id": "coalesced:bf2a6226905efd75425069ee771bb0b1601722c7627ea331648215aa9b11afc3",
      "source_sha256": "504d49532fbb0a89eb08b007ab184172e6caad89ab62f5e1af4c10d99d791a65",
      "translation": "所以南部军才驻扎在岛上啊。\\n万一出了事，他们会帮忙的吧。"
    },
    {
      "id": "coalesced:6dac2aef73375ba442224b65d8123b632f33d807f841ce025850ef3b10564781",
      "source_sha256": "0cb912e01393fb41c817c4e4ca5ef640b34fda84e98e6cdf29bbf70d27f9772a",
      "translation": "南部军……不是为了帮我们才待在这里的。"
    },
    {
      "id": "coalesced:7e8aad37a3204cee11ad3e02e1bad501a3f11900d4069e57bd1e9a9f7abedf10",
      "source_sha256": "6be85fbeeef11ad3e10822ccc597aa855e8c9b11ce14846033b8c85b645fadcf",
      "translation": "他们恐怕只想着把这座岛上的“守护者”\\n弄到手。"
    },
    {
      "id": "coalesced:7045af65a6387ed882fd09c43b5fda96a7ec5b62ef990f0e929834f8d168c298",
      "source_sha256": "587aabff4fc2b4f8622850a5ec33f975e08e38244655fc97c1b6f27551e61cc2",
      "translation": "大家都在说守护者、守护者，\\n那东西真有那么厉害吗？"
    },
    {
      "id": "coalesced:6458b999fa907c74b8eba4baa8fff04d425df082357f463bc439f80ac5e446d2",
      "source_sha256": "d16981064f2744ce836db25ede125413351aa11559baf9ce69be94c8dd646893",
      "translation": "之前不是跟你说过吗？守护者是千年前\\n英雄斯特拉斯制造的生物兵器。"
    },
    {
      "id": "coalesced:41ee13042c4dc5822bd04a9e3a37a1a8f39c7ada856a38363de318d168771fda",
      "source_sha256": "c5ce5288b961dcd30e73d4c2718d3368c65828a5b6c72e74bcd1e9cd6aa9d8cb",
      "translation": "所以北部军模仿守护者，制造出了怪物兵器“哨兵”。\\n如今那些哨兵正在战场上大肆屠杀南部军。"
    },
    {
      "id": "coalesced:4763fb120aed570bd8e6d6f71859d99a85c7d0dba9dfddc438bd2f3a962ae8c6",
      "source_sha256": "8c2590f5c513f16dbe961ae1987a2a112b51877715c4e751ae4817ff60290709",
      "translation": "南部军对此束手无策，只能任由哨兵蹂躏。"
    },
    {
      "id": "coalesced:91d5a739afc3c50737ea571a7ce7646b9abc936cacf5ddd7c786774d89305d52",
      "source_sha256": "1b3686b37aa23507c482fa5034b489441728a9001178bc32b5e55fa63ea3f0bf",
      "translation": "所以他们才会对守护者如此执着。"
    },
    {
      "id": "coalesced:13af87ef74951856fd581cd290f7a35c574562a8509c998692c975a1d2de0929",
      "source_sha256": "35f696bcd8b70a1f5269c11876b46e67fd603c5b04b0a2ef74bf7a1912a1d894",
      "translation": "为什么？想把守护者带走，让它和哨兵作战？"
    },
    {
      "id": "coalesced:df04cf862af861a22f0bbd2853d13333b4bd6fe464cbd299bc6fb911287fa9df",
      "source_sha256": "a523b7c5fb9e9cbb7e1c60c60b545c6fbcd55a7018870e51ac4994b5419a5865",
      "translation": "不是。比起这个，他们似乎更想研究守护者，\\n弄清制造哨兵的方法。"
    },
    {
      "id": "coalesced:8b55c95e6c616a55b129651cd9f1ea942981ef2797a4f0f716d4019b5783780a",
      "source_sha256": "98db9c196ac6c9ffdcf11bf5b3d28fa164dcc3a9ce18f626de0358c6646590d8",
      "translation": "当然，北部军也不会坐视不管。"
    },
    {
      "id": "coalesced:ba2d442ce2cb05d99c3edcba545075f5969e0ddb55ac51eb857320139d8bfd15",
      "source_sha256": "8050a00809826969ff073113ace3cb80707d52077e42ee93d0787fe1808555c7",
      "translation": "只要守护者还在这座岛上，\\n这里就随时可能变成战场。\\n所以必须时刻留意海面。"
    },
    {
      "id": "coalesced:5dd04ebea1fa3d535e353053ddb4a762548d6bef8be3d358b709c2fbbf966f55",
      "source_sha256": "caae18966a31497423436c1d893394489cc0d31ebd8b4d61bfb8b8d5ffb92132",
      "translation": "所以，你赶紧去瞭望台一趟。\\n看看有没有北部军的船过来。"
    },
    {
      "id": "coalesced:1802a4bd4919c83e2a259c3581d92eb7baa9c5a6b01b619f5c537995153d1a61",
      "source_sha256": "98bc5cd2d9b739b131fdec6ff311bf620588700997610503332b850292b8aa12",
      "translation": "什么嘛～每次都只会使唤我。"
    },
    {
      "id": "coalesced:e53964756f1396a946fb45a57f15e65512bec6628c6a7c1e60d9d315f04a3551",
      "source_sha256": "4785484d44a1c1f20a6c1bdcf9daf3b0fe35fbc6667349328951e248b4d58dc8",
      "translation": "你刚才还躺着睡大觉，有什么资格抱怨？"
    },
    {
      "id": "coalesced:1d9c685b1102586313ff5123d4911abde80b3b0a095fbe09e0cbe9ced92ad7f0",
      "source_sha256": "6cda419c8107606eb293592736d97b0de46ce0304e07b964ab6d6f1a12b51169",
      "translation": "嘁……"
    },
    {
      "id": "coalesced:3c9b9a9f00a064fee0a86fc06154d3361ab40344385e64200a668f0616693a10",
      "source_sha256": "f9833611abf5ba26fc0416617003e033181d227fccd73a343ee16ab5c145a77c",
      "translation": "木剑"
    },
    {
      "id": "coalesced:7231f9da661e9a88db95be8c8e153f28e55958cf8e66127db6b6b242e40d1a42",
      "source_sha256": "bbae34ce9f01fa02778a6435e74be0b4bfd3f32a7008eed0ee9000b0bf76b9b6",
      "translation": "攻击力较低的普通木剑\\n攻击+5"
    },
    {
      "id": "coalesced:331370f4119413ca74b3e00c3be44edf4e0da7f5b7f61996b239c66cc0215d1b",
      "source_sha256": "9a5df01e4f3d001fff2e1bc2a0f9d6134a3df5dc915b997852e5d28006381b4a",
      "translation": "断裂的木剑"
    },
    {
      "id": "coalesced:7def722a114dd11f95c0f33c6f2693613bde46d4f1d9f8a82228ba8238913ba0",
      "source_sha256": "b3f10990e1afde904505b840c7983c22ecbe000f7274b9cbe914ceade596199a",
      "translation": "木剑\\n几乎没有攻击力"
    },
    {
      "id": "coalesced:184e09d3ab6af1cdd4247e3f00ef52cbd0227312408aa8d686647bceffd75d4f",
      "source_sha256": "0c9e802bc2b194e2ee23bdf8099161fbaebc4dfdee16ea83d3e8f10dec54815f",
      "translation": "技能攻击力提高20%"
    },
    {
      "id": "coalesced:9d83c14d4648d6ddfeaa8850f0d45bb7453cf22addcf94c35e8af48555803eb2",
      "source_sha256": "aa6df16e7253efada9e76b16f172bf9affa8bc27764f380c8bf2b75bc3143a9d",
      "translation": "使用技能时的耐力消耗减少15%"
    }
  ]
}
