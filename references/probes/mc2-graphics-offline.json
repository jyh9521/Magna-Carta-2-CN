  "patch_sections": [
    {
      "name": "60 FPS - Korean static candidate",
      "description": "Convert requested two-vblank interval to one. Nominal 60 only with 60 vblank ticks per second; above 60 may cause timing issues. Offline verified, game acceptance pending.",
      "is_enabled": false,
      "write_addresses": [
        2184692324
      ]
    },
    {
      "name": "Dynamic Lighting and Shadows - Korean tiling bypass",
      "description": "Disable the reviewed tiling switch and reset its mode. Mode 0 alone does not disable AA. Mirrors the upstream workaround; visual and stability acceptance pending.",
      "is_enabled": false,
      "write_addresses": [
        2199956784,
        2199956888
      ]
    },
    {
      "name": "Experimental skip post-process-chain proxies",
      "description": "Independent Korean implementation, NOT a proven byte-for-byte relocation of the upstream post-processing patch. Skip per-view chain proxy construction through the existing empty-chain exit; other rendering effects remain unverified.",
      "author": "Independent Korean post-process-chain bypass research",
      "is_enabled": false,
      "write_addresses": [
        2185868228
      ]
    }
  ],
