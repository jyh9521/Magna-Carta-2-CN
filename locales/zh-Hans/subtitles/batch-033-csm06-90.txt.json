      "end": 12161,
      "source_sha256": "f05be138932a721958b315e984b7f664f2c400df03f8d586bcaf2f1132ab386c",
      "translation": "可恶！大家快逃！"
    },
    {
      "start": 18964,
      "end": 19648,
      "source_sha256": "03f1241c3520688b9933fbab291e42919b93eac4d192c732d32327a735b86649",
      "translation": "公主殿下！"
    },
    {
      "start": 26907,
      "end": 30672,
      "source_sha256": "af10c86c5a6ac86894a701ad8ad6029c2abb067052806c9f4877fb3bd4de132d",
      "translation": "朱特！你在那儿吗？<br>朱特！朱特！"
    },
    {
      "start": 30989,
      "end": 35431,
      "source_sha256": "e3e6266844130f95125a52158b0f6a45b96848770bad9d4657a6407cce85a860",
      "translation": "果然……<br>当初就该把你留在岛上……"
    },
    {
      "start": 36077,
      "end": 42780,
      "source_sha256": "f4a3cdd58460537d67395d9f736a55e7a80cbfa48f003b5b9e8f857ae0e8021d",
      "translation": "你那时候不是答应过，<br>要和我一起战斗到最后吗？"
    },
    {
      "start": 43208,
      "end": 51829,
      "source_sha256": "9d9a0df7cce6136726e5c3d5fb6dd213f79e97f196d426237adcced9a256b2d4",
      "translation": "其实，我也想告诉你，<br>你能这样留在我身边，我很开心……"
    },
    {
      "start": 53221,
      "end": 58566,
      "source_sha256": "02402f7c44e5ea7ac71c14aab92dfb35b2c3bf2e3c884eec4288e436b9bd8b4b",
      "translation": "那个……<br>我可不是有意偷听的。"
    },
    {
      "start": 68090,
      "end": 72143,
      "source_sha256": "0c8d3fd5ea70b55185734ea8c618438d000437417dd03d02d8eae159cb6cf290",
      "translation": "以后绝对不准再这样了。明白吗？"
    }
  ]
}
