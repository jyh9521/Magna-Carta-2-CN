{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:0fef1993755e6646cb57d55d6a6893d1602571560cd5aedf7adaf7d925af353a",
      "source_sha256": "111d16404fe48d547298d3096cf839f0812e493117848baad732efcc5b84711f",
      "translation": "泽罗哈，到底发生了什么事？"
    },
    {
      "id": "coalesced:abf36df1104fd3899197e51ffd618d0a7113f9a9417c16ed9296dd8607ee4e15",
      "source_sha256": "f831fd861d1aca135b80892a0243f9c2199d00ebe53b70000cecf3a83dbb38ba",
      "translation": "我的身份被北部军发现了，所以……"
    },
    {
      "id": "coalesced:fd68e34fbaf65bcd00549fbeac8cd809bb1704ec80a623289de89181e86f928a",
      "source_sha256": "72b35ea66b963bdab8c51a1faf4e9764033e259edbce122f16a7446ff0767f87",
      "translation": "不过，你居然顺利逃出来了。"
    },
    {
      "id": "coalesced:abbf32488db16d220b81f35fc885c4bf2f72746e2c8584ee663d8eca41afa518",
      "source_sha256": "cf93a5e11021711a3e9bb7abb33ae87075529897a464eab15d396a433fe7d374",
      "translation": "嗯。只是……库布被抢走了。……真是没脸见你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:734bcc7e60cb350e916bed599d4c5cd253b4d507608138913b966386a0d2dfa0",
      "source_sha256": "d5113396ce0b8b848b4c9d5030b7a12ab782f67b0a1ce292dba72513a7c4758a",
      "translation": "能平安逃出来，已经是不幸中的万幸了。"
    },
    {
      "id": "coalesced:f183218bcb43bc334bc9577c50b2cb9beebf59e111b218087766e12eccd38607",
      "source_sha256": "29d2aedcce2de62e5dc50907a86bf717caadd749d2519f11839bdb0dfe666354",
      "translation": "总之，我的长相已经暴露，现在不能随便在外面走动，所以一直躲在这里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:13026a94e5e6f55f5c2ec10c6108a0458ee953d026e7a392d4a044aff0fb9cb8",
      "source_sha256": "82b99794d51baeb08c8d8d45d7f9b5c1d5ef4e8b4369790d789209ea3e542b39",
      "translation": "你们是为了公主殿下来找我的吧？我已经听说她被绑架的消息了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5703fc357c42019c83b12d0fb9b281bae929b7ab89f1f139e716326b68121632",
      "source_sha256": "b080eb35f720d38fc4bb62245df581f8c1cd34f466550a392d40ee83f7d1312d",
      "translation": "是哨兵研究所吗？"
    },
    {
      "id": "coalesced:2f2b224870a221ebde428539d7b5108c9c30ae6c80447cb37904e8c21deb4fc2",
      "source_sha256": "640fbc9f185e1a5b392103ec226b29de97ff0cbc16870222437957a71880b847",
      "translation": "原来你们已经知道了。"
    },
    {
      "id": "coalesced:432f83ef85ed36a36b1bcca3e0afb49646d8d9f9bd025290151430964ae9cba0",
      "source_sha256": "8c90af6d03010872395c3b2cd4641a9640df0f8f663a3beeced21d696dc2beb2",
      "translation": "可是……我不明白，他们为什么要绑架公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:921332c5af60ab58d92114380ec52eae6846fc419e4d77dcc22ecb747bdab8e8",
      "source_sha256": "d086bc7d5f57fcd62683a5d40e0f798f69c4b26f59e0adaf7e5d407ef72abff0",
      "translation": "最近流传着修恩扎伊特和亚历克斯接触过的消息，那是真的吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:60b342bf9588a2c8d83c76e51d212ab7b6dea7bd3fc8b57d4d3f6d232163c7de",
      "source_sha256": "183fa28a0ec413dc3f45c1ca2482e1cc9105762ba3908d8208cc6a9c03540f28",
      "translation": "是的，我们听劳德大人说过了。"
    },
    {
      "id": "coalesced:13a9ed800be9e13b7c1cc1712963ce54647e6044136bcddc647784e6dc9fa49c",
      "source_sha256": "3cd722414f1e06d6cf1f8f7328cae934906a5e2e200f875b63b0ec0f2b045c88",
      "translation": "荒唐……他们到底在想什么……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e2c1f4407a585786a4f58c2a584d089819d7ea69389150290340ce2a14cc695",
      "source_sha256": "8232324b13ce976687ab551beb137ca15d3f83eb67f6389fd4c22251ca5bae17",
      "translation": "我们要去救公主殿下。首先，想听听研究所的情报。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c7a84eb59d1647a6c78bf6d9ea6909eb918568c94b6cb24f6d0676c0ee9c9e3",
      "source_sha256": "ae543cafc5a46e456bfc5af24c89f01fde97a06993676ea44c634c34da121978",
      "translation": "我上次潜入研究所，已经是很久以前的事了。和当时相比，警备应该加强了吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b87b0ba952eb1d6b97feb480a12a13ca0ebefb7457374c4390af72d305f44083",
      "source_sha256": "bbc984123a14fc0cc20771f6fe5dea4f3ec398e0b53b985a5dc5a643af878bc9",
      "translation": "倒也不尽然。当然，你带走哨兵情报后的那段时间，戒备确实很森严，不过现在兵力不足。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe1b5f12dbcb7a0ed4117e574c6d3187dc5ee7825d3743edeb26c1393a0e376a",
      "source_sha256": "19006b21504dd96bfa2f8a9ece0310ddbd4bb85a51c094c73b40fb9cf51d41ad",
      "translation": "潜入应该不会太难。"
    },
    {
      "id": "coalesced:ac5d21cc303955331a6e82b636aced277a60c46fd4ae634c8d7ac94ed8c03c56",
      "source_sha256": "bbc232edd85f70f3457bc27050b2522d25aed977daa9127525f0076c54ba6b9f",
      "translation": "到贝尔福特市区的西北边，就能看到一堵城墙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:106e746d25437ff32e978860c778647b4a8014bc37431dd50b24a5545066f4de",
      "source_sha256": "3fca1e22a4b1ad950a5764664251d9fc5d0a9e5beb4e56c5911674632c32f210",
      "translation": "城墙上立着好几座石像，其中一座石像下面，藏着我挖的洞。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed76c02b8b5b9d92d8b2f642481e15e41143e00a32fed961e843a02bddecef85",
      "source_sha256": "684f594f0d0192fe2090576cfc812a00bfb5104f799dcb9e45d8572092886df2",
      "translation": "大概是中间那座石像。用漩涡炸弹就能破坏石像，把这些炸弹带上吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:507217d8e39b7a12c20c4b7c6ea4742649fc060e87e45263a6ae6cb582230276",
      "source_sha256": "8c00f4fbfd7571b1c1f04f7a9a9b1cc60a5bbee3fe7933cf25095298b5e5cfcb",
      "translation": "我手里只有3个，不够的话就来找我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6bde1fe398ea1ec8c8722939cc070706718460f1063a184e4f0a26b75fb2f607",
      "source_sha256": "4458c27b7e6dab07956569f3c66ed7aa19c0601db5b773a1f5f40214a07e1ba6",
      "translation": "另外，其他石像下面也藏了些道具，有需要的话，尽管拿去用。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:013bacc778659ec5f3bb23bad9e9ef58c0949b5b173e3e3605f7a63e8f4d5d31",
      "source_sha256": "edf00ed6d97dabc64f26dbee4d822165b0d80243fb725fba2f495ad3deaa15d5",
      "translation": "泽罗哈，你有没有研究所的出入钥匙？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b25d01243ccfe9b77e66593a62550d6c6f84985b1d30e8d6ce24e7f7614ceabd",
      "source_sha256": "b13c49ccf50c6d353c389eb6681afa4024016bd20c0c9442a9d49e843f69dbc2",
      "translation": "当然有。唯独这个，我可是拼命才没让北部军抢走。来，拿去吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17dec29a65619314cdba66356da70c4cba06f899e22bf430e441c3f5d712aee3",
      "source_sha256": "75f1dc1f073af549c35b663d5557962d94399c501edb09bd73d15f6701f13458",
      "translation": "还有一件东西。这个也带上。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d556df1d0956be8289d077346c4703cd50ff93b28f1e763d99104ccbcb180c99",
      "source_sha256": "584b8bbc1996e4239036145e0b2fd21f119a5123b087e94cba5a628beddf8902",
      "translation": "虽然库布被抢走了，不过我顺手偷来了这个。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:168c3b835b2a6cafd58a4234ab91dff47237d44dd9de490f2fd1a927b82545d8",
      "source_sha256": "661f751df6da6a4bc170893b8687aa664c54bf885f50e4cdc3e16473783fa6b0",
      "translation": "这是晶柱控制装置，有了它，任何晶柱都能自由使用。这里没有南部军的晶柱，所以它必不可少。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b12833cc8b478797c38b113324cb0e0170770a9e12ea68cb386ca2b1d6833c8",
      "source_sha256": "6631b2f41752e0a0b8e2f83e967e075d4c21f01f5136b98b5c4c245dc683e7d1",
      "translation": "哦，那可真有用。"
    },
    {
      "id": "coalesced:023c3cc81300caeebf836914203ecc8d1b426d4cb881e470983473ded8117674",
      "source_sha256": "3c2d69ec0c20468288b7c3447296883a3219e066274749681b7d7e21afe412ae",
      "translation": "有了这个，就能自由使用北部军的晶柱了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1ab112fbb7866beb109f0c74148acdc260e4834426676596d1864b8a6146335",
      "source_sha256": "c836e4cf369d36b353797c6c4f93468c40dbc823f026d9634eda4592dfec441d",
      "translation": "谢谢你，泽罗哈。"
    },
    {
      "id": "coalesced:9bf924aa5d03a85268736f4e89eeec909652c5005741ae7642b2669553fafbbb",
      "source_sha256": "0038d70986f24ecdcc86dbb3dd6fe4c4bb349ceacda932261ea181fa058b102c",
      "translation": "这本来就是我的工作嘛。一定要把公主殿下救出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca8bbad9e893a3a53439fbb2374f6908728febfb771ca9bd3b6e2f8078bd9cae",
      "source_sha256": "230cfe76cf61256b17f455755faad9df59f2095d0042e4de7d9fff06a9e7ef02",
      "translation": "嗯，别担心，你就在这里休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f7e1373f698846a6b0eb199d3e1d821f677927e18403c823606ed35c7f41454",
      "source_sha256": "ea2a88429e3ed3c1ee0a18a7a1b65751190789847d1eb0ff6fb49ebbfa2aa499",
      "translation": "抓紧时间。"
    },
    {
      "id": "coalesced:b2ef8e8e20734932a3b6f9e2ba910fdbaa5fba1b671d23c82934bd7444c810bd",
      "source_sha256": "e772c20002ae111fadde1901a3bbf886a8e2368bc93c340de1bf386c8e12fc3c",
      "translation": "这片街区，还是老样子啊……"
    },
    {
      "id": "coalesced:4a79c7fd19993d1dbb4b546bb4fe65206d1ed1b959a1bd840950639fde223958",
      "source_sha256": "93a1fa8ee8a2e169b9f981020cf0484e69d23c3c263a7c5725f7d362c2cd29ff",
      "translation": "说起来，你的故乡就是贝尔福特吧。"
    },
    {
      "id": "coalesced:1a99b7975eab14cb2606b7ff49cc304d5384d13f1617df6ef3f2fe9463e42d71",
      "source_sha256": "694c633f6d5863798fbcaf75365173bd67333117891adaf2b59ebf6049506a1a",
      "translation": "咦……你是这里人？"
    },
    {
      "id": "coalesced:f8fbcb48e416cb2e26c191bb838c99c415d85cbb7ed5dfef893c5040083c6ee3",
      "source_sha256": "d840b803122c8a19c2273b40e705956fa87246250a3418b33c208d24acb20c30",
      "translation": "嗯。这里就是我以前住的街区，虽然现在已经成了废墟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b53410b3455ba2a59ab08e458b33e5887ba342e1d7c5c0a99a54c58ea43886cb",
      "source_sha256": "98f9f144d7de7f3acfe66ba035ac54cd450f45c6c2f94e731340e93a599fac11",
      "translation": "克罗塞尔……那你的家人在哪里？"
    },
    {
      "id": "coalesced:96e142389e7cec1c0aa8565bbce353e30e8176fef0fb299fa049c7d17ce76c3e",
      "source_sha256": "a8da197eb1daebc3b5e6c4f61221a628584939d233cb3fa421447421d3c238fc",
      "translation": "都被卷入战争，死了。只有我运气好，活了下来，多亏了公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3271374bdd951abd9a84960e020492c09322d331d3981d972dfb377599a1e0ed",
      "source_sha256": "c8a8d37c436a2280c7f534e548a9d410c8a3772461f90ca5b35fcb94ce128696",
      "translation": "啊……那……"
    },
    {
      "id": "coalesced:ebd5e421d7b534051c40ad124d0094f8457f3eaef7a294b29889b6b1e052b469",
      "source_sha256": "d088819152e3081e9042d0d2693db73fe8def30c27f96a15c5fbc2eafaf6bce7",
      "translation": "没错。就是多亏了公主殿下，我才加入南部军，想着能报答她的恩情。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc9bd056a667f8350ecb808ad86ecafe857e18b5612e0df8d9bdc21f9c7dddb7",
      "source_sha256": "326c409c28ab60a99ac09cf7323447364cf11aeedbf97c089ee20fab54cbb472",
      "translation": "现在都已经过去了。"
    },
    {
      "id": "coalesced:3c76873b42909c78f794de218355e871d71bbf828af05486297dc1d6a6fdaf76",
      "source_sha256": "29037eb060580afc835b9469040fae3fa07681fb45fa3c0103f945812096fbfc",
      "translation": "……对不起。"
    },
    {
      "id": "coalesced:23a51b3b540eb1b11b706c93b1f0d68c3de2eac820cb9bd19d051fb3835c4d66",
      "source_sha256": "1fef9ec75f9e92ae0e38148a532082e87b100a234f7ec9526eb9df157f707a71",
      "translation": "为什么道歉？"
    },
    {
      "id": "coalesced:c945f86bb7a00da8d6cd5fa6880165487eb0a8ae55610d46845d1c571a798d72",
      "source_sha256": "29937249c700fff37ae3f1450b766e4235f96e46989223ad39ad42be02ebc223",
      "translation": "贝尔福特变成这样，我也有责任。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe70f521c4b94733f9108e81ce2650fe66dad3b658aaedf2806c56895fd0aa6a",
      "source_sha256": "131f4d3dc1f280c47d1b08ac0c21de759d6344bd4a0c946fb96b79649941e9bd",
      "translation": "反正该向我道歉的不是你，而是修恩扎伊特。罪魁祸首是那家伙啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3faac35d0ed2b3c4a48d210d1ee2624ce10742c565b7586b126e31bade0dbcaa",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:387f8a982f199879e3f3c2dfe7172b5810d41b4a393447826397cfbe12047d95",
      "source_sha256": "67b10dd13c6b7fa3abc2914f878feb5aa03c32973d0e25d4a2ae9da4a0546693",
      "translation": "走吧。我们还得去救公主殿下，不是吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cab4bff07f076dc310e1eec28688289e5c62088a9daf8043b2742ac9e2b456d9",
      "source_sha256": "e7fe0f1ce9777ff3bd5900eef5e3ae1c0dd0eee47e60f53a7a3a82d5ea169134",
      "translation": "我听说岛上发生的事了！是真的吗！？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:384f8fc6efce025a9a9339f12a7f29f390906863ff09652615d14c4e46a7cdc1",
      "source_sha256": "5a374db46363c5758450a834a41c0bec44af141185ce71f463053e01b19b9235",
      "translation": "岛上？你在说什么？"
    },
    {
      "id": "coalesced:5d9dac52fc9b75da80699431cd61291f153ee528f011d1a591da4a620a45a78d",
      "source_sha256": "183f1d31bb440b44d96e67391ff50b644fecfbc31dd78f83c65c8f84702880c7",
      "translation": "怎么能……拿无辜的人做哨兵实验？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c4aeaefa6730449eaa97bdf2ee3cd691392769fd59bccc5c23d718995148c09",
      "source_sha256": "b81983b33f454b7477d41d1f1c528cde4f8da91dffbfaf4e57fd6eb7d61a4226",
      "translation": "你不是答应过，只要我加入北部军，就不会再对岛上的人出手吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb168e904143770eaa4aabdffcf76a089c15a1e4c243e055eda5b10ff50b4125",
      "source_sha256": "c314b04615191ec3b066f9d7c46fdb00ed6a1e2d27d1201ee251420023f440de",
      "translation": "啊……如果是说哨兵，那都是艾尔加擅自干的。我完全不知情。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0ce1d23ccdf712a00875ef1e5ee105f1240fc981cf3747ce2074ab3af57b675",
      "source_sha256": "322f5a0196a89f860bbbbc34155ce1a323ffad79e1366daaff042e8827934998",
      "translation": "我……要退出北部军。就算是为了大义……我也再不能容忍那种事了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94ccf13e4bdc91de6717498c1f380861c5917b332567559842da83d8f1680ed4",
      "source_sha256": "07a83d4f90656d7ebfad3999f78fc30f6c9056862c095a90ddeb82815a89faa8",
      "translation": "啊，梅莉莎，冷静点。战争很快就要结束了，不必再流血了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c072a40dc8fbc8b889884856ae0250e91c8eb3aecd3e6bb63a28c993d50c546",
      "source_sha256": "325656d249031df33b3e4e36b0d1b0ecde3319f5dbae93a54f2a22783c5d1e34",
      "translation": "也就是说，你和朱特也不用再战斗了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd813f8184a95c1aea14bb9025a443fbcbf5e4cb9149fcf83efc62563b19bffd",
      "source_sha256": "6a447d737edc8b129ef44c09f72aa38e08b0aaab934df7d2c23a7747db61e650",
      "translation": "什么？这是什么意思？"
    },
    {
      "id": "coalesced:ddb781c74d74b1603aab1bb53f43bf86898dec57a2d703921161b700f1b2290b",
      "source_sha256": "84b92cd057944537d17e27f153c7324ed88a2d1357f311e85c57a696120af4a3",
      "translation": "你很快就能看到了。那场宣告战争终结的盛大庆典。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:97c8e4ff38c2167eab8193743912a0097e7a9fff39100d391486dbc4f7924cfc",
      "source_sha256": "0b41b9c78608e7fb848041cf3a3ed768d5ed479dcedeee316f91ee4a2fa307ad",
      "translation": "唔、呃……"
    },
    {
      "id": "coalesced:3830a6a62b90abecbed213dadfbb1df30343e32d0406359dbda45e654fd3c0a2",
      "source_sha256": "adf4db526c95eb448a0d4fd999595f1bba7de5ea373057bfd93ab31c674d9915",
      "translation": "梅莉莎？"
    },
    {
      "id": "coalesced:e3e536c71ea08e049801a9a0e2951cb84c59184ae0a3fc46544c86de4ae5344e",
      "source_sha256": "cd5b62266a4288844dabee2344824a38a07a6a0f89049bc81570749a3085b4ea",
      "translation": "唔……胸口突然……"
    },
    {
      "id": "coalesced:a15fb9637a48266a4a83f4740d74c74cdc5875ed330f974495f2421e3f2ffcc0",
      "source_sha256": "db536e6676108677cf25beea8d6acfb6b98b24cbe68b7251b4ba95cedde9c62b",
      "translation": "你的脸色很苍白……要不要先休息一下？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:81c09fff6e931d892f3267ebcf5d168f708fba72dbeccb8f468c3147df73caaf",
      "source_sha256": "0b77ee6968e36f6b61497edd4ef46802ede6746efae075302a15f8ce8dc650be",
      "translation": "……看来得这样了。"
    },
    {
      "id": "coalesced:f1aafe6747621a07e010b047ef25daabeecbd3e3fff9f51981acd759be1eeb57",
      "source_sha256": "d5a46b6f85d5eec2f5ee37ea440172300be6d03fb5af3d1d8fdfa5e5f4df3c34",
      "translation": "排斥反应啊……我正觉得你已经没用了。这时机，还真是绝妙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59694474fdc7567729b0c2150d713483f2e2189bfafc3f8425f88c5af53bc913",
      "source_sha256": "f4e723a95be65b4810f43827a9bcbdfa8627630bc653de8df0dc99d792391ff6",
      "translation": "不要丢下我一个人，露～"
    },
    {
      "id": "coalesced:64817dc4ecc7dae9d5321394df44174123bcb24fbdd06e0344a1167c1aa4caef",
      "source_sha256": "952bc024642b6540290749164ed77680593ff78c587ec4eac3a568876fc80547",
      "translation": "后面的事就拜托你了，露。"
    },
    {
      "id": "coalesced:320419bbbe032e15cfb76386db99bcdb9b950a5543ae8c043d8a0e6e57e139fa",
      "source_sha256": "4b4d8a8f40456418ca8b8e067434beea615afc86bc4ea6d1e160b7346333b6a4",
      "translation": "漩涡炸弹用完了吗？"
    },
    {
      "id": "coalesced:aad428edd81c4532599a08262a262789b56038a26f517792f689f2eace3138f2",
      "source_sha256": "edfb6b9861e412d0ba6bd933c897500565def477790a6c414574f7fc2d1630ea",
      "translation": "再给你3个。这次可要好好使用。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5578415cec2cd64ad76aa839448755527db037f08c9a42af948c3d814917173a",
      "source_sha256": "9135ff562d5521e015cf075d35cec2553eec436e279a8a88385b9952a35a0e3e",
      "translation": "塞蕾丝汀学会了暴雪之刃。\\n装备弓后，可以使用连携奥义。"
    },
    {
      "id": "coalesced:5aa8f849038c70afe3b83be6f4a34a06094449fc836e6e35db3746a457afc391",
      "source_sha256": "3acff10e587fe4a5da254e31727b3081581604e745adc57fdf165368c781269e",
      "translation": "阿尔戈学会了暴雪之刃。\\n装备斧后，可以使用连携奥义。"
    },
    {
      "id": "coalesced:0aa435e740ad334fde6d16791cf01033046350f331d043b92fd36fbde3814a48",
      "source_sha256": "bf83a109c7b4e6f038aa4c443e6a1563021623385dd0c641d8f0419431788247",
      "translation": "漩涡炸弹"
    },
    {
      "id": "coalesced:1ddc8993673010008aee2370f5d23e8252bce00fe3b91d798de98a3e3f00cf46",
      "source_sha256": "464f723114b9cfcc632676f20ce8e43fecdb8687b690efdd36cd753e133d0519",
      "translation": "晶柱控制装置"
    },
    {
      "id": "coalesced:b1a3a254aa95e6c3207ccea5f43100f2de69abc3f094bb16c2040b3b5132d97d",
      "source_sha256": "c803f3ffa38f414a0642b7128f82235d76fbbc7145d71f7f98e42b1a21ca5418",
      "translation": "能自由使用北部军晶柱的特殊装置"
    },
    {
      "id": "coalesced:6566878b8f94811d631e6abf892234ff581f0b3cd3e352251449a1e975840a30",
      "source_sha256": "742ca879714cdbe716c5f34a22e8904731bf84093312aff5ec9d688179621087",
      "translation": "哨兵研究所通行卡 "
    },
    {
      "id": "coalesced:a7e71e61fb13362b92c9e35a8c812c76efbac7f2192ce6e93c273af5043ba13d",
      "source_sha256": "6881495003747b7dcdd3741cf761f21a7445514a9d068019ab5c4b69cf005774",
      "translation": "用于出入哨兵研究所的钥匙"
    },
    {
      "id": "coalesced:db5fc8595629174a01a32e48dad0f6f33c0abe4424082019a4b57d556b8d98fb",
      "source_sha256": "7da5d0f7362012f6d240a31b913ebbec9bd4ea15ccfb8cc92c07e12685c882c8",
