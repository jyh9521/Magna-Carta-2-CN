    },
    {
      "id": "coalesced:5fdcdd88b7ed7ac88fa3cabb331d61e0851e7f10f2250fece0101351a378102f",
      "source_sha256": "c508eb40f05b5af761de7df748c432eba9e3cac06a7615917c76ad06b55962d0",
      "translation": "获得青月宝玉"
    },
    {
      "id": "coalesced:3a353d1b1b5750c21e9ac7f9791926c972ce32b2a975a09490df89f266c6da44",
      "source_sha256": "c809af9a1059f0c84cda80b120c49c46b0c1827b15c2ec96e8229840d8093016",
      "translation": "这里是为青月特雷瓦族人，建设新村庄而准备的土地。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:240ab2ea33acefb439ae7a285560bf06ce72ce6ca2f07ca33b9ed4e6346a07fb",
      "source_sha256": "bfaac026f34c56a0209733a4133dea72cfcdd02051242a612445b5a5f10a72f7",
      "translation": "不过，我们正受到北部军的阻挠，是黑角在背后指使他们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:267f69b6cd0bd8db394acb1aed5073af8f6f1ccf777543260c7ec93e87f27fab",
      "source_sha256": "c8a97d8c7b38de008a4255b379e6224180a26f6f53106a866d3d4d2247e8d140",
      "translation": "这座村庄，是青月特雷瓦族人德雷戈，规划建立的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb4383c93e151366037238f12a2e6411450c0e2d8e5e641279e45337d41aa4bd",
      "source_sha256": "4e5bfd97dd90b0e2d426dd079d53fa25cc4cb996cbf94d44548cb38831a01f0e",
      "translation": "要不是黑角那些家伙，与北部军勾结，毁掉了我们的村庄……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2cc3fbeeef703a9b396697aaa5e2987f6cb97adc9ebff7d8eeb4436340b5ddb2",
      "source_sha256": "be6800bba2040af1e56a15d41c073a17c30b084a30c2d9ab3bad98070afacb42",
      "translation": "我们现在，应该还生活在炽热大地的庇佑之下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ad3fe50525f8c5c35b03677f9b680478c5cdc0b8cd52fe9652e7ecb94c15324",
      "source_sha256": "9def46487b377d8d4ae34ae753804bbd2eff31b4afb182ebe573e5574ba7281f",
      "translation": "现在还只是临时住处，但总有一天，散居在兰兹海姆各地的青月特雷瓦族人，都会聚集到这里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c3751e7ae9063ea31e8c3ff17587de623926f715c09a25ec288f3c1ea6d9c23",
      "source_sha256": "a2e694df9c3df131b7042242a03de9ae97ee279da243e9263899d8e7d8371766",
      "translation": "重建村庄最大的阻碍，果然还是黑角那些家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c6152ac36bb63604c1cfb6510c1fe9e60e50756793889623af960bfac71f6aa",
      "source_sha256": "5e755c29cef7ac22b297d10147bedf62b316662d4243745d7b162af15c6154ab",
      "translation": "那些家伙，毁掉了我们的故乡还不够，现在竟然连这里也想染指。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28ac4a5ef6acd521b0737154a857b3e5b3983df22a61b5610f306b0319edbc05",
      "source_sha256": "c546949e593a05982116405576301b21c2565b997faf420f6dc67e951cd69aa5",
      "translation": "可他们有北部军保护，我们实在无计可施。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5c223adddaed765ee7a17d8f5d26d12fe2841e394adffecfa13eb8964c0539a7",
      "source_sha256": "ed03c860d6ec979f060809655dfd73798d2e129e6d6363d219c09b03edf7c2c0",
      "translation": "你听说过阿尔贝多的消息吗？"
    },
    {
      "id": "coalesced:9031f3f12a47387f0342e4a5539381b2625c11f15ff2691420969bc9a7dbde6c",
      "source_sha256": "a601270ae85f6dc6d29c95782305ee663117f4079287e8253ec4ffccc9f5547b",
      "translation": "我劝过他到这个村庄来，可他拒绝了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2dff1d23ab2aa5fb59b1b549f3ccead80675c50ced6ea4d00b5f74d13a5d3cf1",
      "source_sha256": "3f511744edd8c909842ea905ed58f34bdfd7e07ad40e885bc37959796c75616d",
      "translation": "要不是德雷戈在人类当中，赚到了很多钱，根本就办不到。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c3db7fe6b887c209cb3a9d8c8ac72c31091383b1e9c6a925fbcff0f6569a5005",
      "source_sha256": "a9b800ccd6f6e9f92f2aa4d46606a5efe5cfeaf0ad5fdd77f4024f3028dd8020",
      "translation": "现在，我会等到这场战争结束。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d06b369090343eb7a490e49605382a843c4ad5125ebcaba407656708b4196a6",
      "source_sha256": "0037de5d278572f2aec1987553641bbf7389a89ebd0c3f003b65e9e4936cdc21",
      "translation": "等这场战争结束，我会正式求婚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
