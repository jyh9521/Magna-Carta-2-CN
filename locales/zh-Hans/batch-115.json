      "id": "coalesced:711297e1e3bdcaac580924221cee5420fa3b139dfe98c59a6b5b3f4ead780ca1",
      "source_sha256": "d91878f22443cfd3a0efc1566f2d42de8ea0088c9a87229836853bd8efcfee1b",
      "translation": "好了好了……这里接下来交给我，你退下吧。"
    },
    {
      "id": "coalesced:4d9e2c58e6b116dca91015b38474d4cc8437944f9de29646aca5cbfb08e96a0c",
      "source_sha256": "6997368b6facaa258eb8f36de46b56212a75d5d9f906af34b3103d2b7b6f6d55",
      "translation": "退下……后面交给我……"
    },
    {
