{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:e745908487208516e1b66e720b84fc2a345532b30521843f69a376446a39786f",
      "source_sha256": "4799cd19507cb9daffff11e4f02230178c0823d14eb3d123a27b45e86af9af51",
      "translation": "有时候，我也觉得很不可思议。"
    },
    {
      "id": "coalesced:167b476f9cab62ff05f64b5a595c2261f1bb02b51bcc7bad9fd6e5940f1dd327",
      "source_sha256": "cc3b89275b57b710d9562ce7b73ba61b12c4a146cc058639589af64dda255d44",
      "translation": "北部军为什么，会盲目追随修恩扎伊特呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ed2e550150ad246e6efc3dc2b1638a0055015877428dc3c54e996389ffac7527",
      "source_sha256": "0a23b579d4f5b604443f8edf5c20eec697ade0230aac232360abc4bb3882db5b",
      "translation": "甚至不惜沦为残党，拼上性命，继续抵抗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec3254f0cbaacbbbd448d1de93d927b0889939fc720ae42c4e71b6bdf330b55b",
      "source_sha256": "1a057263ffa12191d3be5a01bffd91c8c84f674590e87fef6c8b86250c60d1e0",
      "translation": "这次任务，也辛苦各位了。"
    },
    {
      "id": "coalesced:885398b02742ded357beffa21caba347a1ea809193f4fd0b54342e11d9c3c464",
      "source_sha256": "c5775d1c8d081e6aec0af1c5c7c3c7074b86a058b6c8a5093dc55d890d5e7900",
      "translation": "总觉得，所有事情都是反哨兵部队在做啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c72f4004d23fedf40d6a5fd9ee7322ceb4d4300b3dabf82d858f0d52540e9c9",
      "source_sha256": "15c9062a4fc343ae273a14f3877f6c5d5e4079282d290329dc743755dbc981b1",
      "translation": "杜南丘陵攻城战的准备，好像已经差不多完成了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d0516b2d608bc335e146c7c376ab28546d2d61a2f5f574f6e1eec8306a0e395",
      "source_sha256": "129b8b2ee45b03f8437dfc20abb0b0b5bc45a711916e36cc6e59987eb17beebc",
      "translation": "应该很快就会下达，相关的指示吧。"
    },
    {
      "id": "coalesced:7e4c6c305bcdb15c901f0ee174abee8f8f8f4bf23d95f2d1033168cf2418b9f5",
      "source_sha256": "3e7251c8892326358a622c6b110ccd4145c697255fba41a7216b6e80c02ffe4f",
      "translation": "北部军里，似乎有不少人才。"
    },
    {
      "id": "coalesced:e7afe469b1956f5520de23fabf3db4efb386306769376a7f554af3b7dd4f1ab5",
      "source_sha256": "fbc06dfd5a319c4771b20d6428dd0f3658690e39a7256226af43f0ea2e16ac63",
      "translation": "才好不容易打倒希昂·雷格拉尔，听说，又出现了一个厉害人物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c474009d0abc32cd8ca6b8666788fe28f6e9b2570e8d49340bb352550be6bb94",
      "source_sha256": "802db4e13353ec9c11ce9da4b1bdb17e7d14dcf7d13a32a657cbf69f5dde6c72",
      "translation": "据说，这次负责守卫黑刃要塞……"
    },
    {
      "id": "coalesced:b148f78356ccd26f1906942d3a8dae5999341b9fd3ce4a46d0a583d4aa52dd1f",
      "source_sha256": "9048718f24128cb6162c4506ee720b405d75aadbeb3491d32866b53243fbe979",
      "translation": "听说，杜南丘陵的黑刃要塞，由一位新来的女战士守卫。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80a7642f1aacf3f68f02e632ba33a7af7a2977e52bacabf963b03bdad632ccc5",
      "source_sha256": "a7c08d024522906c158da9736fad4fe494bfa9c013f0e23bbe64e532cc0b5cf1",
      "translation": "消息来源可靠，肯定没错。"
    },
    {
      "id": "coalesced:26811e9b1a604b13c911675f9b5917e0b822622e8114171e978a11ce76a5bc5d",
      "source_sha256": "0cd51588fcc74dc5ec713ed0e81b87f7e262cbef5adbfa18ab15649027627734",
      "translation": "猫猫似乎也分成，好几个族群。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c58d57b94dba408de4cb6d4f17cfd39a11093f2e4c423c6d4c18fda0e7567a89",
      "source_sha256": "27205d94a2c1e5fc132b094d0f962721cf21604c1f9655b8f85af8a2e9e287da",
      "translation": "上次走在路上，突然就遭到它们袭击。看来，也有凶暴的族群啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:259e3aaa777ed8d8fae09bbc011a0583a57491b2d562e1bd7c6d9fe90e218aec",
      "source_sha256": "dd727784d098bfe8ac5e683af2a9bc89858333fb47b2b30d9bf8e5d195aac14c",
      "translation": "曾在老狐峡谷抵抗的泽格隆大人，是我的直属上司。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df11234b8ba67e2b8705d180af97d7371f2f9476d20e498dc106553ab53a1a6b",
      "source_sha256": "ad3cdaca65b7ffd3cc5fd81074a0176218d1325083f01682cc96a63d850d9d45",
      "translation": "虽然不太懂得变通，但他信念坚定，为人正直……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a930b88dcc0601f96b720060e894344e8084703541b0bfe54079a544757f1c13",
      "source_sha256": "7e8226bca8ff542656ce4775b48bc7e3b9109301a3cc9c7e71dcaea2195bff64",
      "translation": "怎么会落到，修恩扎伊特那种家伙手里……"
    },
    {
      "id": "coalesced:eef6f064ee9de05879a0ffc5468e8b9de0ee494d6e237f52c19b0ef23e339654",
      "source_sha256": "278b91e888d2c5a90716cbac81dd8f6c613d0e42a8f3bc75dc1fd473433506af",
      "translation": "最近，拉提族好像变得更凶暴了。"
    },
    {
      "id": "coalesced:15632bc40a9820a474305985daa6e487dcaffda754a5444456df50389c2a54db",
      "source_sha256": "efad7f30d1f44379a9de0db1c17e4795dfd80d22da2fca0677a01078d1218c83",
      "translation": "往来村外的人当中，有不少人说，自己遭到了拉提族袭击。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b81157ba3d3778b06c72affdc72773f867a4f8a3666ae872b09f8d75c3e9257e",
      "source_sha256": "2d86fedfb282854c686fe2f97e455f745f6c31c70d62661087e3b6938a1b208f",
      "translation": "看来，我就不是做生意的命。"
    },
    {
      "id": "coalesced:7e2c076413610db26a1a3b099e7ed7df26bc39f1208f64b7b087ecc083b47033",
      "source_sha256": "34a623c4e27c8427dcb1846d8ce48780c0acf771f5dae8cec0707c15c5f297d6",
      "translation": "狼人那些家伙，才刚消停下来，现在拉提族又猖獗起来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:799a57901424133ff8dccbe89b26aa406a5a5eaacc6cbe566416333044ddef96",
      "source_sha256": "69db206968d290fd4542f7252c834d3869c70b8e34bba826ca96146022b16876",
      "translation": "干脆不做这生意了，真是的。"
    },
    {
      "id": "coalesced:a8d0bc4bc27eb7e7b149a611bdd4d71aa8f3e8be056a8c9b12fb15a5fa4148dc",
      "source_sha256": "e8a08901a17d82740b00de0d32cc501b2c40952f3e89569babc539d208d5e03d",
      "translation": "现在，峡谷里已经没有敌人了吧？"
    },
    {
      "id": "coalesced:2370f7c6d1af3d1e1f6aeff00717d59e2df01b780e0f5df3052c2f7d7e58a20b",
      "source_sha256": "187d234a7ea4c1a4194231af084b12e30d2b318af1127c94a49df1c5339e6613",
      "translation": "不用再担心，北部军会攻到这里来了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eeac77faccc30d876c74df8c759f7cd6147f1132748c5808a499e2869457a88c",
      "source_sha256": "4a8721d17b767f01328b5f4333392e163fe29c9139dfdbff3dc359c8868272ce",
      "translation": "太好了……真是太好了……"
    },
    {
      "id": "coalesced:5524155cbb1c8b3b99378394a83ec1bb0fd34727f5ce95adc2fc98e30f3b184e",
      "source_sha256": "72da1b96ce4a6cb924091740417e7a98dd9fe98948b5db8a97e639857fc6f273",
      "translation": "就因为彼此的理想不同，就非得这样，打得你死我活……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2703542a406c9d68ad41e894d057d6b6bfc1a0ac32649a6f4aaeabd0825d7f12",
      "source_sha256": "50a5e5d0562af86e66eaf99e157b77b0073ae1fb6e73ae4ee59ace1f2db41768",
      "translation": "真是让人难过啊。唉。"
    },
    {
      "id": "coalesced:bb11aa45524836438b4f1179873b5bdabdf42b1f07d828efa479f2810fe66a09",
      "source_sha256": "21060b97676a0e31f84f579c00a7e456f523e9bfdde5c5ef7d88c10ed8ef2d54",
      "translation": "北部军投入战场的哨兵，到底是什么东西？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fcaee153e1905d04741be9550ca454cbed836550ae64434dc0d768c861f0fac4",
      "source_sha256": "c92873343f9e0eb48eea48194d720205c6064247c516273117199d8f50f99e55",
      "translation": "听说，是被制造出来的。看来，北部军连制造那种怪物的技术都有啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:100a26010225a4ad17d6ed61d1a7436523e5a589140d59be1faca3c3ffd371d4",
      "source_sha256": "f2ef0eda8b2194deadcfbe7d0cec6c38be81bc997464cceafb414a3b273d5d7a",
      "translation": "不过，到底是在哪里制造的呢？是不是在哪里，有工厂或研究所？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03c5ead1cb55e02c1ec35100bf9a3ff3962605e47952c5cd0d20ca59f25725f1",
      "source_sha256": "9a8e2d0282e023b11fcff82207a259422f50b9dd0a8b252e46173d45743c4de9",
      "translation": "不过，到底是在哪里制造的呢？有工厂或研究所吗？"
    },
    {
      "id": "coalesced:e4a619b887281f6f225179832ef737eb17f2195299474cf1d5ec67b4b67b48df",
      "source_sha256": "e5a51baf60d362ef64e38278be5cf991b817487c063247d5e209b55f2d8e2da9",
      "translation": "嘻嘻呵——其实，我是阿维斯族的王子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:641e0597f74764540b727aa1d227a44fd8845e647c6b0df628a04c00ea2f2f77",
      "source_sha256": "a210910566de7c45d30e9dd480d601cbf99a5a4e46188548b0be9909d00038dc",
      "translation": "我是来寻找，人类新娘的。"
    },
    {
      "id": "coalesced:9e4e14774eb4726b054dc6426e6255c7751fe93b674ec1c57a6fc14ce3e82bfe",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:55618a6ca1c9c347ab258b62eee09546974b4edfb5a48a2dc7c1f61c81229647",
      "source_sha256": "96f57c2e586683f9dc893732354f9d5f59122a7bdb81a3aec09a10f84b3fa2b9",
      "translation": "你该不会，真的信了吧？"
    },
    {
      "id": "coalesced:85077c6680b2131b1bf0e8395ecbeed574a7f4097fba6067b71c9d323426a881",
      "source_sha256": "de8d8311c99b57916fd1d1cb35dbe783a2026e2408f0b73590a3df28d25366f9",
      "translation": "我心情不好，没什么说话的兴致。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b058ba522daab213941d62a7a971c2819560f14e15f17ed1bce24b08e7ad786f",
      "source_sha256": "294f07cecda3bf083e90dea608484db8a01c536ee23d5f42ebbd0f384740c34a",
      "translation": "看来，果然有伪装成南部军的叛徒。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:56b45a4b1edfd75031c8282bbd07058e95ef12b63ae197c82392ad0fa8f683fc",
      "source_sha256": "d1ae0c8d2dcd42a6c8f904028473adfe703641dcdd162cccfa0e99bc5d3783cf",
      "translation": "得吸取这次的教训，更仔细地留意可疑人物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    }
  ]
}
