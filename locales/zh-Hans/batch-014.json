{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:a4db37b7a0d1ef6c59fc45d5bcd9b029e693e148037d6983775ec0684df22dfd",
      "source_sha256": "e6a1914fac1ecbfe83a4f3965a28e610d99223507d1aea03da417ff394827e1c",
      "translation": "咦，这里有一道冰墙？"
    },
    {
      "id": "coalesced:25713122498d08e8beeac31423668855c79713d4161030fa65c8a72a27a070c1",
      "source_sha256": "f310bb12f7b2d35c2c25358acce9fc80cfbdabb4e303c8f0dc2a65f50aacda71",
      "translation": "为了阻挡北部军，连环术师们匆忙建起来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:298223e0b706a5181262c0d0796e9188718556ccf720c138b6fe7074fa828e40",
      "source_sha256": "f2ce39223c0fa0e11093d78f33a1bc47b8c93ddc9d79743f5c8789cf7f5ffe9b",
      "translation": "老狐峡谷那边，总算挡住了，可杜南丘陵那边，还没来得及全部封住。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fe52f7c59a88c9758ddb73eafeb6f340e38c0d199ea1fe2733a1b4c12406f055",
      "source_sha256": "26e73f93782259685361672d6666d8922ee0db53691d4075def83467f6d66e4a",
      "translation": "那我们只要阻挡从杜南丘陵过来的北部军就行了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67a660c340b2eb0f899e34e852596c941cf78dcb950f90b5b3ef2b730a436d9a",
      "source_sha256": "5150e63344d943caffb8270628c38096e1ae90144f91ab9f8a8eafe7359beb72",
      "translation": "嗯，这次有哥哥们帮忙，北部军又只会从一边攻来，应该能打得轻松些。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7152f0752237f7a4fefa6c4483ae1a9ffe5ca449c57598d35925d30becbec3be",
      "source_sha256": "49c6c79934c38e2a39eb2f43fd4f7b69925fd585fb66ab0026c67496fb375867",
      "translation": "我绝对不会输。"
    },
    {
      "id": "coalesced:60d3beef6222dbb90a23a06223af5d91252fca6648caedf07e4f6c7b87d40f00",
      "source_sha256": "6d9538c2e85778ea15876939f2d73d945d7a8e64234e596d39212b714d3f2b9b",
      "translation": "哈哈，又能活动活动筋骨了。"
    },
    {
      "id": "coalesced:499a3997417df9df26aa2a66845c99c7e19986ac193d4e3c6136d6aaae9b27a2",
      "source_sha256": "a6e21bb079e0c00ae3bc490b534c9d8ab1792a4c34386fdca4e2184b64348586",
      "translation": "等着瞧吧，我会让你们见识，我和阿尔戈哥哥的爱心合击！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a09917bca213128eee37313a6c3c31704354c4484db09596be487289d71b1284",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d6a475d5031357a1c9ef18d98c7a5e6e9f0143f4de9435fb056c10e98b84c706",
      "source_sha256": "1178db2b202b8192bd6405268340dca49effafe041926ed6324200941294c692",
      "translation": "阿尔戈……我很期待哦，爱心合击。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fcf69e689f8713afefb616415d55a7ba19c12e213caf861494d5db9324b6100f",
      "source_sha256": "a2131a43aba9887c0378f88fcc3d288adcf64ba9eef9e11ea930021dd6054ca0",
      "translation": "好久不见，修亚伦。"
    },
    {
      "id": "coalesced:becef8f45a16020f882aab0347153d1d3594ca876f76921dda43af52eab77563",
      "source_sha256": "3a651852801f20fd1930105ed456ac239ce606fcf66e2a40bfd36e4d38591c7c",
      "translation": "公主还是一如既往，亲自踏上战场啊？"
    },
    {
      "id": "coalesced:ddb5f25964665ff163f08b63ddb331c3b362602d435a1e931ecd6732b652943d",
      "source_sha256": "abc3c5ff2f34210b0e739bd4e7fc9afdb09b746d43a45fe9c5d2cd4e5cbf2aca",
      "translation": "听说，上次投入峡谷的哨兵，被彻底打倒了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5355670d26601fc08a18c870e03cdc20bc1257da8c51326d42ec7eecb552a74",
      "source_sha256": "d8de3fa656cbc2e8d5cfb7efa18168ada1edceb856052ded4c085e6d3fbf2abc",
      "translation": "看来，您终于……找到了哨兵的弱点？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e6c9d08f03ba1aaf006e3f0814f7a2e28a3442de81ae0e37d6687a77b527849",
      "source_sha256": "f3188e8cc52000413b5a6c3bf36b6ff7ccc5023ba4cf6227b2b72cf4382e7fd5",
      "translation": "没错，我们不会再像以前那样，任人摆布了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2de4adef1563d17ac2a1c5482f1b16cefd7e05c0fb3a0378dc5fcbf9119e58a9",
      "source_sha256": "37f33c67c06619e6f8cf64e401aff3df2ca053d3c9a3049549f9e8fd3b8acdbc",
      "translation": "所以，作为代价，风息岛才会变成那副模样啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5668f4ddce564d7cbb62c04878e1022f2048df427d27fb2e5c10393b4ea34f8",
      "source_sha256": "529743eeb8a68388c3561085be9c18a4820cc5060faa42b73d58f4adf0af7ca8",
      "translation": "岛上……怎么了？"
    },
    {
      "id": "coalesced:0aeaac5c9b04cb1344837996702287826c09e029befd91b87c6363a4f7b0ae44",
      "source_sha256": "dc7fc40f882148e9e775ae361f49981f6969043ec48804c982b1c3ca3e3a8519",
      "translation": "嘿嘿嘿……谁知道呢。"
    },
    {
      "id": "coalesced:ac2a4dbc59304a5676353050131df4a9c25e2f1a6394e40793d3a0d65b58fc14",
      "source_sha256": "e4f1e4b3e3ff64b33587fe61255c1a05c43b5f0234f44ed412f07a8284053f63",
      "translation": "你敢碰岛上的人试试！"
    },
    {
      "id": "coalesced:29a4e695d635edde5d970b31c151754a81fea078f4ec87016037545014b6b59e",
      "source_sha256": "7bfe19544084d66d8cfbc0c2e87bf4836c525d821b734f0dd3e827e449e3901c",
      "translation": "呵呵呵，连自己的力量都使不好，还只是个毛头小子……"
    },
    {
      "id": "coalesced:b36393734e13cfba9101a91c0d97c86cb246f78d80347dffaf43e702a055c384",
      "source_sha256": "ce9397be8f960f26666777b0ff0d28b32f3dfdf5f668905e55606173b939b0cb",
      "translation": "是不是毛头小子，你就亲自来确认吧！"
    },
    {
      "id": "coalesced:4f5d94180084be522e53198a50c7c05b1ed1222d9d4b8870f2fc47ff95ff0a90",
      "source_sha256": "c5ebadde398e5fa67768627c7790827962dccd03d0eba47893aa4773ae5ddf5d",
      "translation": "好久没有打得这么有趣了，下次也很期待呢。嘿嘿嘿……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d3a84a04980ed8306f39b7e5ec42536b2205d8da3293ac066a36b6e8982d999b",
      "source_sha256": "3712145c5c1d812e803e708fd0dac92ad056d76ce3d37ed7d0ace1ff9c77b311",
      "translation": "好，把剩下的北部军，也一口气扫干净！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b09a31d81af67f9075c766119703dd71963e184abb01e01bb01c6995c4425eee",
      "source_sha256": "c7d8aa671e4f37c9e0b5097ddfb9230ff0932b7d84da840ac7afd9e223506214",
      "translation": "太厉害了，北部军被我们压制住了！"
    },
    {
      "id": "coalesced:bc8a76b80d519ea2c61a221888519397991bc95c0fcf6726d56e6366c4419147",
      "source_sha256": "72bc56410f1ef66fc9cbcc8019b95a585265cfbbdb723e3a2d11c1642d469559",
      "translation": "洁菲一个人冲得太远了，稍有不慎，就会被北部军包围。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2d85b1220453f0e72bcaf591dfd93e73ff3c0692bf59bc5130eed83d64701be",
      "source_sha256": "8151011eee28681aa2bda01ba68aad6c6e3c247ba325154f87be75cca4bcc195",
      "translation": "朱特，过去护卫她。"
    },
    {
      "id": "coalesced:45015a4075acbffb0aff6a018391b47db46cbd52da662d588611be0d18af9857",
      "source_sha256": "8c81dda7551620bafeb5a181dc29e04dc29533b898c298a8a478e7dfc4cf9a51",
      "translation": "嗯，知道了。"
    },
    {
      "id": "coalesced:bc757b0c804563b97722bca01ba1f648b26312177a406a3b218c8bdc27540d40",
      "source_sha256": "0ff4d2e20e4c49d3b44a00e4fdc135a49a0da3a7077e081353b07cd6007c59eb",
      "translation": "啊，看那边！灾祸种……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:140777ffb69f98d6894b13df14aa3e7ecaa79c1766fac81c09186df839b52920",
      "source_sha256": "3c4e72f402327e183dc6e16bca7fdbbf591442b6e050e610e42b34e41cba3df6",
      "translation": "什么！？"
    },
    {
      "id": "coalesced:e397ba07523f59df071aab795a8d0b1f9963efc83237db8ab02e9dcc78744fad",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:54f8bd852a698e150d1ce727b701af7b1152236cde7dc95dcbd75773ff54dfe2",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主……"
    },
    {
      "id": "coalesced:3237cf88aa161312a0b238271629f91507e9e58e44ded081a90a59b8452b76ad",
      "source_sha256": "9c94339ba67944632ce29cf63f2d82f733405527e99392784618308d2beec95c",
      "translation": "你……刚才究竟做了什么！？"
    },
    {
      "id": "coalesced:3e8f4a2d01f63c19318fc99cde1ef4f984df36424373752f279917c7e219dc71",
      "source_sha256": "1d9075fce4a64e96c03c55291cfca8fe77386a56888ec4918850820654e4a3b1",
      "translation": "冷静点，克罗塞尔。"
    },
    {
      "id": "coalesced:538c149d209d817a24c6ddfb4a3ee3bb7a01b11e714e52f6a41a938b80ad58ca",
      "source_sha256": "c382395c40bce54b81274123d47d80bc38d9b86d34acb7d7a60af64922607152",
      "translation": "这叫我怎么冷静？朱特！你刚才想刺伤公主吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a6e906198eb5e6a91cf6a07bc07c229b6b81443d4f702a872e49d4e7aab27f78",
      "source_sha256": "9d47a5a3ea3c21531384aa1a7079276267374b4033ab52729074ef4e138fca1f",
      "translation": "不、不是……我……"
    },
    {
      "id": "coalesced:807a4272cb01e0bbf09480f23fce1a25805398bc88660e64107a4fae3cc7161a",
      "source_sha256": "85fb8bc8ca632d9736e56f12131faac0ddc60bd490b2ab8410a734a93f8c3d9e",
      "translation": "你还清醒吗！？"
    },
    {
      "id": "coalesced:197a36fee400b1e61b4ee0e5431da41c6095822ef7b2becfdf6baf05da7245fe",
      "source_sha256": "ecee9024c045f6b7eefbbfe65a02685dd7babc7cc2c87ba4aa3578713ced5b37",
      "translation": "冷静点，克罗塞尔。朱特是想救我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c25ecc0540ea9d0222071a47f20b67ab8be06c1348499b75120182c0be76172e",
      "source_sha256": "1fd9bf0ece4b2acb3297636130e58b2c4334d6ddd669cde2603163018c108e81",
      "translation": "可连公主都差点出事。这家伙刚才，简直就像变了个人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:214959b1b58aa3430471551d2d508480780e32657fc79415ec15b9d8403cb67d",
      "source_sha256": "64e6fabba237e3038e9ca410441e7c6cac4b92a873abe622d542de3b9d7ae422",
      "translation": "但我不是故意的。"
    },
    {
      "id": "coalesced:625ec02b4755a2afcf5f8145c6269ee0844cbe8536de115df31a05d8c82caab2",
      "source_sha256": "efbf54541f4aff0cb4d4d50315574571eb8739b14877cb98ca0f27f8028fc86a",
      "translation": "别找借口。"
    },
    {
      "id": "coalesced:af5338ebe6c577ae5317006a3e800f04a252afa814e73f7e918b5fb623bf0b90",
      "source_sha256": "117c04580a6c5814c23b0706b0f018f2bc517ccaaea7eb64e6dbd1adee65e011",
      "translation": "这不是借口，听我说。我也不是自愿拥有这种力量的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:248417d6dd45f63bfed079a851e38c3a4df4bc9ab0fa4f37c301aaa956e9bcf9",
      "source_sha256": "e74fe73a85822722868754538485a6509a6fbfc408b7c7e3b28a129be04b7fe5",
      "translation": "别把我……当成怪物……"
    },
    {
      "id": "coalesced:b0d9a80eb318e5ae87adab7a2d2c3b31088beed3fefa9479fb878f9a2fb02769",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f7ef728accc6b70541a6780d981f772a28daf80afac3260e4cb9e16d4c072bcc",
      "source_sha256": "7eeb209bdbc9c8664179a0df0a8ba277ec4f9cbd9e1182f8e8c637e0f4509726",
      "translation": "和艾尔加战斗时，我也没能控制自己的力量。朱特应该也是，因为太专注于和北部军战斗……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cd1a16757f54ce4757943323db2392d62a7a55c6ab747294405429279f00d8df",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b85b07db5e506a611754f45b8ae201f93ab64d16bf3bff8fd6fb8be1cb217e71",
      "source_sha256": "645b01cffa4ed0c13df4eaabded573399ed6c76c0a301bdbea5060ec719f4bc1",
      "translation": "真的很对不起，公主。我……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb97f8e6fbb7e337e6ab6076491bfc95dfb9c1fcf567b789b50d0209f9b9fc51",
      "source_sha256": "2bf9b41e586bf17a7a7b855028a38a944a7477d55a1ba5a9361de491a1128afd",
      "translation": "没关系，是多亏了朱特，我才保住性命。刚才差一点，就真的出事了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8121701fa73ac5249ddcffd3bf998621f3384ecd0ff20889f91134c9f416a47c",
      "source_sha256": "ec50d81f6f66714f67eac0f2dcf17896f4e692b1dd1f66763b59bc8a4d7e3a3a",
      "translation": "没错，要是没有朱特哥哥，姐姐就危险了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4836d5bf8d68962ab9a8964d591e815a611072828b089a11f80e02c62603479b",
      "source_sha256": "712b927f19f3993356b54e0b061689fa30a605ee887ec81a5e8cdda392aa2844",
      "translation": "不过……说实话，刚才的朱特哥哥，确实有些可怕。就像另一个人……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:566bc00b81ffac8236cfe5ddb79a6ccc306e921598a23be12febc5f00516fce5",
      "source_sha256": "c5d549ac6afd8cc29c3db85b78f38740edee12aa5450f27c6de2508dd891337a",
      "translation": "我……"
    },
    {
      "id": "coalesced:bae14ba0d78235b2204ba15981c9892a9ee486b42d82e9815457966f5dcdd8d7",
      "source_sha256": "61836780f449e5a1d92648f6277a0c0b7bca96f18492eb4452def945e02b9af5",
      "translation": "这件事，恐怕不能就这样含糊带过。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4968838a956affe97a8be4c479e4eb77bc7e416f31d59177a9fd49124cc23fb",
      "source_sha256": "2b935c9781b7b4a4a077720a89bc12040444e2454e057c94a28ee4a04eeead95",
      "translation": "朱特，有实力的人，我会认可。你刚才的能力，确实值得肯定。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02da2d79671e92fa3a49d0b02b30f2306e5f73318ab249d576321b61739c9807",
      "source_sha256": "eb8480bb96c9268d54fbf31c9c73be9e4ffc14111f192f67a566d5814ff932e4",
      "translation": "部队里有你这样的人，当然是好事。可你的能力很奇怪。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7a88d94d79c73865060a9a774151d9f0ea59fc4b21efdf10ce91c1a2002f4fd",
      "source_sha256": "7b05596fb5283f1112631246a64aa9bb90bf3d581360421522806149d2bb6b05",
      "translation": "和公主的力量完全不同，老实说，甚至让人不舒服。你究竟是谁？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f73d7c9f20ea9665e953f4cdf7fef3d6156c91759993fa631db89b2a0d467582",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:39e8e33d36bf2e71ba0346df81353ce8c052c4fe1183daa43d6b7cc470defc74",
      "source_sha256": "c33366b12d924c9bde9989f928ef685ecca61702f847589b81eed8adfe02cdcf",
      "translation": "克罗塞尔，这个问题，等朱特恢复记忆后再问，也不迟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8d5718d9ef536f7dd48bc6aa8d4aae1453bf1108cf2b4aafa425deeb5fcde3f8",
      "source_sha256": "da16d255def801ca1216d63c17e74e6dd005390b44bf874d4e7bf95a1e6b0113",
      "translation": "现在，就把朱特当成我们的同伴吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:84cee02a316a6fc900e6ebe2aa77c0aab791df106c220aa1b6898e0b27421687",
      "source_sha256": "ccb39d54b44775acaf49951c6a44d24e306d239d9d728e7bd01daa033ef39d5d",
      "translation": "我也这么认为，朱特早就是我们的同伴了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:827a75effdbb41b4f75a9af82d935aa5fc345db85a812fe324ab474c89ec3bbc",
      "source_sha256": "218ec8a7edbfbee5862b374c9636c636327ea0ce94cf64f92abddc26be77eb99",
      "translation": "……我知道，我也没说这家伙是坏人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dcb7d88ad545b792adc0935268b6b3bc728c1fe4e7b4e04845b1f7c4552d5187",
      "source_sha256": "d278a50bac033da066730c318437f2437aa8ac85d698d6cdc9853e25fe1cf7da",
      "translation": "总之，大家辛苦了。我们平安守住了柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d266359958179e020b8813b2b744f98c5bf5b3dc1b9dab1bccced0e9d6db339d",
      "source_sha256": "e787e0d01e20c198b172b55ddc83713bf8b41743f7df67c6d5bbd83e3412e78b",
      "translation": "嗯，谢谢大家！族长也一定会高兴的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc2897c6adfd572a06f60ebf86b68799ea55854d9d405b3e04e210b67e681b0d",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:57cbace6959017bff2e548289a44382f726cc2146cf6760e43ac6a9497d43d30",
      "source_sha256": "e1b85d5155b85af786128d09f3cd9337997967c4f30dd6d947dedd2b9be419cd",
      "translation": "好好休息，再上路吧。"
    },
    {
      "id": "coalesced:8156bb990faecc5e2ebb0aaf375a280e2d5c566fec3d3640e68fed317522a5ab",
      "source_sha256": "8392c34e51f458fab2943d73a7e7ea6bdef2661c061e0e6751796f44e6894ba0",
      "translation": "柯塔马雷由于地理位置的关系，始终面临遭到入侵的危险。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31503c6db4215c21e6164d543cd5da01285e3ceb9e81ce5b832e0f5ac9516375",
      "source_sha256": "8c987756df378fc3761774942b5e6113462c218ae3f398b7ee3c65e07e967a8d",
      "translation": "这里处于北部军要塞所在的杜南丘陵，与老狐峡谷之间，很适合作为补给基地……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10495a87c9945dc5d37b2fa7dd36d7e8b49c4719d3f93097390ae2b44c790c45",
      "source_sha256": "422361970648d8680dca8e3a24c775c91a9af90ea625c9cdeb523a9795ade6f5",
      "translation": "如果柯塔马雷被北部军占领，他们就会以这里为补给基地，接着进攻阿巴泽特。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b82b5300083db3c5fc10662b8bd64ac474deffdd19e48ecc2ee82bc540c81b1e",
      "source_sha256": "608ddf52854d89825ace1f27027dd1e0577dd77e6c68382fe20d1d9459903bd7",
      "translation": "至今虽然勉强支撑下来了，可如果大军来袭，又会怎么样……真让人担心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:87ce05a29995a31d0432ecf7f089994af7a0d19d7f273e270c6a15f68e9ab703",
      "source_sha256": "e31bd3374494e8b6d7e02ff08db35081deb669d3696487c3cd2ea7083ce17d3a",
      "translation": "感谢各位。如果没有你们，我们现在恐怕还被困在那里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d687a62244659ff8f30c3d926e1d648ed8dba923060a5362c247b1b8f45e1542",
      "source_sha256": "70329771d36b85535c73efa6c7dc4c8a87203ee808e8fe43d1c79e60190bf216",
      "translation": "嗯……感谢你们救出尼尔提。不过，这并不代表我就信任你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a88998ee5c5253d3bb71b01e3eb4a14120cb06f8f9ffa1c103a0ec9cd56c0a79",
      "source_sha256": "214f0c49fda35a14159801dac8d19412999fad486882d56e91c44d2daf702852",
      "translation": "原来，你们是人类当中，为数不多的好人。之前误会了，我向各位道歉。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:33e52a50157e069980117d6fe1c612fb68019a38b6697ae7141b65789f153631",
      "source_sha256": "76a8963a929eb8486fc32c621c1cc3dbaa7bb6392e1f199b1014db6a5e363c42",
      "translation": "听说族长允许各位留下了？呵呵……欢迎。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c1d9ea9877f0c7fb8925b1c20e040f684d7206324b449e7db9cdef83807df7d8",
      "source_sha256": "2d1ae97148a0a307061c56e1e85dba87744f757222b64f4f6ef368edae2231ff",
      "translation": "别跟我说话，人类。不管发生什么，我都不会信任人类。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:659d2cdb7acb3c7bf077a587f012c2d5f29fa54f26312240e16e30f8217cb6d7",
      "source_sha256": "e30762c5855226a9e7dba4757b07b2e151fb18eb8b0711e522027311c90f40cd",
      "translation": "过去的事，就忘了吧。既然族长接受了你们，你们就已经是村里的客人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5dfede352b1a072baeecec8e8889be536296bc4e2dbe16de14ba9c6ed7a45bc8",
      "source_sha256": "5a75678b124bf3ccfd7eb3b92b8784f19e0caae4b0c7cc00ae041a6100049daf",
      "translation": "安心住下再走吧。"
    },
    {
      "id": "coalesced:3dff999d65c829c5457c99d711fa4783c8444442931f1d1d1ab8a8191f1468c8",
      "source_sha256": "2959742d124f6ee2aa06be204569317e9b8e69e36e0d3b94c619f6b7d4b87bf2",
      "translation": "马雷族会使用具有各种能力的香。"
    },
    {
      "id": "coalesced:df7f9236112cffe37fe2fda77160eeaeacdeb916cd5918c76bce69068efaaa0b",
      "source_sha256": "6b48249bf2b61929e39198aff2d6825a6a8453d59b33abd02f2156ed605506cc",
      "translation": "利用香，既能让心情平静，也能在战斗中发挥更强的力量，甚至还能进行治愈。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a5c80e921d94863e268fba7483882727174412c6872b96a6a545a0118c0bc69",
      "source_sha256": "80c76dbceae25698df2f201ee2174d6b97116249d50d40436f7bd5a7c8f80c24",
      "translation": "只要是马雷族，人人都熟悉香的用法。"
    },
    {
      "id": "coalesced:74e829f0ee6641aa62ad72a7dfb7bc7646e6501a3c48104a1eadff1f4f6f3de1",
      "source_sha256": "e1526b9152afccf3df6a43664baad937cca6e86965b35c66ab391b90c92d3591",
      "translation": "我还是第一次见到外来的人。当然，阿维斯商人大叔不算。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:780e6443ec2b2e0cae122c6dab1c0858a9c493a321f13309ada8696f4e8cb3dc",
      "source_sha256": "99e32d8a395c241ab4969c660c64bfb9d72b35ca94ebc582061b5a95c34ac840",
      "translation": "所以，既有些新奇，也有些害怕。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5079f9c0f5f81a8691ef9b5249b64e44d6950529d8b861643f107e50c8d1e93a",
      "source_sha256": "4dd59c770cd30eea26d1938f98ccdc838c58f192a518e116f593da822c0b9993",
      "translation": "不过，你们看起来，好像都是好人呢，呵呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc3d3a42cf846c189b13d089768f316c90d13077407a4d28924fd74a61ce4f02",
      "source_sha256": "593c50458a769998f22a8ac32520698ded6d788b57ae869a08f4799d987ad323",
      "translation": "哼……族长已经允许了……？"
    },
    {
      "id": "coalesced:7eb0a50723e67bd356aa58ca9856bcdc5260b4d8d167e3d49a5e95e845c7dcb6",
      "source_sha256": "a80710bd8d017948d6eab6c794a1efb9362d2300ee7923fa1e4c3bc0aab9897d",
      "translation": "即便如此，要是敢碰我妹妹，我还是不会饶过你们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee2dbba0372140b0af1ec4a22200fda7e21e93041849a5276be343fd0391e564",
      "source_sha256": "3ab27ffe7f3ddec82fba574c9f2fc999eba79555e9ba1bb504ef3e10ce22637b",
      "translation": "人类经常会惊叹，我们马雷族丰富的药草知识。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:778a2588b1479978c1cd5ffff66b443a2f276e7e1e62b3456b1ebd8da31ce6be",
      "source_sha256": "cdd817ae5e044a928b3d0e1b730faaeffcbef42b2c083077771be1336109e1a1",
      "translation": "如今，大多数疾病，医生们都用连环术治疗。但听说在以前，我们的药草才是最好的治疗药物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba72437b795913070c83287e364037b22bdbed39b8f06585931c35d146c86e9b",
      "source_sha256": "8b9f3164255f2b479e0f457cd65c649a203243c79ac83c3a57b32c20eb93de32",
      "translation": "什么！你们还没走？"
    },
    {
      "id": "coalesced:c347ca70219f1775bcba3a753de924d417dd944010018b5884f8ab53cf213d75",
      "source_sha256": "cda11d010ed38d2c8a777e4e542b1a72eff040580bc7952a6e9dd2f789cdc490",
      "translation": "来啊！放马过来，人类！"
    },
    {
      "id": "coalesced:38ef7af7f014d2f1468c6a7350cc87211ca9c6137d60d64a5b0580dcb42cdfc3",
      "source_sha256": "97236a3bccc64271b65edf44515ede1f84b75879f563083d19a63114dc938e79",
      "translation": "这里的饭菜，实在不合口味，每天都只吃草……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e644956fd29e10ec8f1b6c9bda089404953f9af0710148ac6212b29182804084",
      "source_sha256": "30324ffb8356f91c83a8e161daf4e579a92eb79772b4195f219d5730f278b300",
      "translation": "马雷族的祖先，难道是山羊吗？"
    },
    {
      "id": "coalesced:600495542cd432e559ccb1cf6dc48bdbd3a852f3ea47cf2ed0100918ef2a057d",
      "source_sha256": "e5aa958a1a6bf043b772f2387aa0e22471128bcf06ef81dc7e3e5c001da6df9b",
      "translation": "感谢各位相救。如果没有你们，我现在恐怕还被扣作人质。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43c445a6697e324a4c61caa8ea83d8146c1553e63810c9ce57381f9179a35712",
      "source_sha256": "7db51007912ecc1c276d40ce0d492836c61d710a1c90cc79cd5034e9eee9b362",
      "translation": "喂，人类。虽然不知道你们为什么会来这里，但这一带很危险。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ec205c20d3e25b7c1ef61b6235d14235f3d0aa11391b50e8a81c9a669cd45d7",
      "source_sha256": "71a3ce7dc95b92cd990c664af3f44746c6d2f03fef04223d8051f0b3c45dd14d",
      "translation": "快回你们自己的村子去。"
    },
    {
      "id": "coalesced:2cdcf7d9a87d5a6694c79a0fceef99abef0b86ee8d1fc9938a1d9307425cb877",
      "source_sha256": "8a717701dd2e964b530320907a5b651d6a52c9334b3fd8dde57c58cba5af5d87",
      "translation": "你们在人类当中，战斗能力似乎也很出色。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8554f743f2e47d2ac0cb431725a560b38262583e3e155a96310f1ab186a4b34a",
      "source_sha256": "ce6b79153403e7f83c44e453fedd754284cf1d7d5a0f059b47af82ece36a03ca",
      "translation": "喵喵喵！刚才下了奇怪的雪，喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e93a98c32516ce08ffbfbdac63b6e19e2db38fe456813a371da01a9bc9e585a2",
      "source_sha256": "28683cf4e7b9a12c5c6cc22ec17fb95d0a44634aa31c2dc247217d841af38f57",
      "translation": "有股奇怪的气息，害我的毛一直竖着，喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ea0104ce8050dc8fcc36b5a797196221538a67ea918787be41e11267c9cead0",
      "source_sha256": "104e5aa2db677f2396c29e9fa8825ebc85479cff1abd590a0c317f1cef033913",
      "translation": "猫猫真的很可爱，不是吗？"
    },
    {
      "id": "coalesced:97779744fdcac7d876c1e2c182215dd9519c2c3d0ae56bf036fc2ab0e919e20f",
      "source_sha256": "0862d72090f98f069e74b053fdd283cd303f5aed3e58dfda6c255fabb9d57c43",
      "translation": "你去过柯塔马雷吗，喵？我们虽然分辨不出来，但听说马雷族全是俊男美女，喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc284e832c54fc8c9f2db389e29d6614419370c6daad9761e60335954952d55f",
      "source_sha256": "643f222f134abd9e62522937e0ac1f30c4d2bbbf73e3bfb782d6ea1ea15ff5a2",
      "translation": "马雷族的族长，是位非常善良的马雷，喵。"
    },
    {
      "id": "coalesced:0b3d9d914d6d2e1c96ca420b5e43416a6ebbba9b9b8264bb4dbe27d7b8ff9372",
      "source_sha256": "07e6b4c4f5d2f10f597542a9f100128fe77ecb67b70909058a6dc1e37b628cbc",
      "translation": "猫猫是居住在水边的种族，喵。阿巴泽特也有猫猫村庄，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddaf2e6f640e6a5cd005df34de82a24682bf2cb368300dc02ef4777742b14419",
      "source_sha256": "8186cfa8c00eaa9e581be0dfe56d98dc3e80e129d93f525a5796195b338f0860",
      "translation": "我们正在和黑猫猫争夺领地，喵～"
    },
    {
      "id": "coalesced:a4d1beb37ffa8209922e044f57a1996eea2834229585d0ff079872a53447d565",
      "source_sha256": "a87becb7e1c840c927aa2094362017ab0099d58997cba8706fbda43786d03ab8",
      "translation": "猫猫有各种各样的种类，喵～"
    },
    {
      "id": "coalesced:2b5b07968e2bd019fb4fde8ff94dd070dd4b4f9a1400f0faa445635e2b11bbe0",
      "source_sha256": "4c8ccc4d20ddaea2e8080be3e81a679d6bd0ae8b8c786d067daf50c5a5f6c068",
      "translation": "肚子饿了，喵。"
    },
    {
      "id": "coalesced:42c0ad530bb0a0c2e0802e0aa68373002421145baddb3f293db05a84d91acaef",
      "source_sha256": "e9f0a4fe48817f9b135d411ee548d39da41a40bca038efcfa00c7fe8ed5869ba",
      "translation": "好困，喵。请别跟我说话，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:395180c9ad848d4999e5cbc8cb97e06262b81651f72f4241aa8c260c0b126d11",
      "source_sha256": "b36531a32b4784bb325d3269c7933ea8bfc53abfb2c1818b96613342cfaa90a7",
      "translation": "既然都来到这里了，能不能帮我一个忙，喵？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f74bb285bab293ee9672d8082890481b24804cfa6e04d168f9e3ae73a4668e0",
      "source_sha256": "fa3fb51d7a38eadef7e25dfe306b54b84817e6f5d8f1d03f5b192c8d39c503d5",
      "translation": "我们的宿敌，那些黑猫猫，把我们的铃铛偷走了，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e61420a623efe86ecdffb7a891c87b4b3b2f828b99ca82bff8dac9c4f3d8262c",
      "source_sha256": "f5f706a63f1e85ab299f93b4bdd8dc22cc81a0a4c2b4193f381925429af90cf3",
      "translation": "那是象征我们猫猫骄傲的珍贵铃铛，喵。"
    },
    {
      "id": "coalesced:ab5ab58e23a36eb9d9536a987bd76c23df66fa6bd60b28db77cf97c6cf08cdbe",
      "source_sha256": "6c19a9a23a42c527e4192f4b76c3e8bc6c447b09f62a2f3d21740afe8fee263a",
      "translation": "能帮忙把铃铛夺回来吗，喵？我会酬谢的，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c7f6095ce8922b59b521b27feac27472907a4039518f197847d43285b8cba903",
      "source_sha256": "739b39b3455c9a3d93776626c9b69f4cd97623d855329baf0959bc51d78b22f5",
      "translation": "那些卑鄙的黑猫猫，把偷走的铃铛，藏在它们领地里的箱子中，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6da395ec96f39cd6e884ab729bc1aa637f5f2cd5bec04ee16f578a41f52412b",
      "source_sha256": "a0bc4b53ba4d0d7c20c4a376a4b7fa0635a65a3a3782f2c3960029619b0984fc",
      "translation": "打开箱子需要钥匙，应该藏在它们其中一个家伙身上，喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d0e52d527d49d55d33d5dcb97b3f55da3dff94aa9d0bbba8e5aa45b39cb4b42",
      "source_sha256": "dd3cd2b24cbde703a92ae31115ecfcfe91b42c7a0fad3328890d837ee442138a",
      "translation": "没办法，喵。我们会自己想办法的，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b557775d6e5cc20237560bddbcca7d437a42a47ccd55fd838e9b25e9e3f47c12",
      "source_sha256": "40ff91925b54cfd176955ab4ea4867945345e6e67496fbfefdcb316129b80fcf",
      "translation": "黑猫猫偷走的，是象征我们骄傲的珍贵铃铛，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8154a20cbb17246aaf7b0a8fe40491ebdd56f4219c5ad7c38647a480135a1a7",
      "source_sha256": "341869e5830b6c3ecf55a4a394d90d234422118b1fb9649f81caf3a8ab716be1",
      "translation": "喵喵喵喵喵！就是这个，喵！这就是我们的铃铛，喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e91a07e99c36f72c4ca46bc88f11ff07c85ffa570e77887dc33558258e3bb690",
      "source_sha256": "5605c3bd8846cc851ae7ebb1a01e25b04a0bf881028d860378f0ced5ed8be766",
      "translation": "没错，喵！太厉害了，喵！太了不起了，喵！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3df4543ebf57095c3aad616750ac8978e17e5fb1110618675cdc8c7408a7f5d5",
      "source_sha256": "836c9a571414312467f3f615dfb22c8103aa41e1bf4d09c4257e1568023097d5",
      "translation": "真的非常感谢，喵。南部军最棒了，喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ae70a26ab016835eb05cfeed1898772fd18c13e9b1ff1c746a9ff61f45224b83",
      "source_sha256": "8437fbbee9c84e8b3a86ea9a2249a69d1a1dc2b371c600bbde623e60a94c560b",
      "translation": "这是谢礼，喵。猫猫族特制的炸弹，喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88766659b823bfa7e4ab90cb10a9d19872c73b4cc9e8e9267c9ff34ea51c64c5",
      "source_sha256": "a22a7a66708be7b0e426c4bcd2484dcf9d53df258831abc1ecc809d444b80606",
      "translation": "比普通炸弹强得多，威力一定非常惊人，喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eeff719dede7aa4094b5f57d819aeb8d82a6980e439490bf67fb9091349c675b",
      "source_sha256": "b698ea8e090a9d496dfcea3abe53399aa501118d1c2d3e8c88ebc593307fbf95",
      "translation": "猫猫的骄傲"
    },
    {
      "id": "coalesced:c2c4d2180a1fb7a058c8d1d4fdb0263922edf34748e6cbcb79e86a73e02a96b1",
      "source_sha256": "a2c1f2a3307d6a7fbcf0ed36cd7698991fc9c5a25d697f8f992f8d37cec97adf",
      "translation": "夺回被黑猫猫偷走的[猫猫的铃铛]\\n要打开藏有铃铛的箱子\\n必须先从黑猫猫身上获得钥匙"
    },
    {
      "id": "coalesced:3d070bea2583dae04cf86e9a0b8fa2261cb19a5a32175757aaa529ee9439fe20",
