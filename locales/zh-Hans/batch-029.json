{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:f8f370b7fb41364a002fcb5e02989340d55d551e0c44bda0f11522f69ee9e8b6",
      "source_sha256": "2ff7e24905d9acb09b3899e5754f24a3706c862523d532f627f52d5860186187",
      "translation": "爷爷，我们回来了。"
    },
    {
      "id": "coalesced:f5a32cfa6750c825871b7a10469b6df4b1012e96bab47373ca0a1fb059a3df61",
      "source_sha256": "78a20c1265e08efcc8fd324c523454430a9b995967152b71ed1a7ba2548c0252",
      "translation": "嗯……辛苦你们了。"
    },
    {
      "id": "coalesced:4edf60f90ed61676ad5ef39e9c0129feec386ce08e1516455203100ec98c07ef",
      "source_sha256": "e2c0d3a21d8b21b1076019f9f28bf47d9213b54402802a401c6e774e931c38c2",
      "translation": "我实在无颜面对您。村民们遭到牺牲的时候，我们却没能帮上一点忙……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5f8bbe465558dfa69fe5c00524aa49ee494ae76c37f18b40ce938d50b02e27c1",
      "source_sha256": "00bfa2f947adad4426035d71222b331b661a28532dc5365145ee36986fa6d037",
      "translation": "您言重了。毕竟，今后不会再发生那种事了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77666e9963b4bb613bf606989dc6a4a827227a13b6a4e1fa04b2e63ca58c6050",
      "source_sha256": "c7e974720a188402e02de75095e5dc4a60edb264f195a48b7116a64335cef039",
      "translation": "不过，村长，我有件事想问。"
    },
    {
      "id": "coalesced:289ae21bfb69f9b841d6292a9bda4bb14200ad4fbe41b2bf40bf0f0258ca83a8",
      "source_sha256": "031fbb9cc16205d05e86f3d898d2c0c9efa07ffc33df88337c068db06be48383",
      "translation": "请讲。"
    },
    {
      "id": "coalesced:1b205a99df6651a89452ed16321b146655d8d5356f76bdb0e90f45fbdb21dff7",
      "source_sha256": "8bf14e53932951dc74f0b6d5c1ce956258637335c65b2e1bd2a8ef34a4be3615",
      "translation": "是谁把村民带进洞窟的？肯定是北部军吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dffbe57453619e56200541ac7062fbe8f68cca1d3a992cfd755060581a6bc299",
      "source_sha256": "e8b06ce029033410408b77e1294f5b7ce387a33f9ce63b0a3c84c4423a70d597",
      "translation": "这个……"
    },
    {
      "id": "coalesced:7bcaf8bb5a85f7bf233dd34954ce512fa5d7834c64bad3a3a5a76ed711de3551",
      "source_sha256": "6c965309f3205938b2225796ee5d7cc5674c4d256eeb9ccd2778e710db252372",
      "translation": "是艾尔加……和一个叫修亚伦的人。"
    },
    {
      "id": "coalesced:7c9e0fa843f01e7ae8f8f8017a10fcd757c13fcdcfe67018783a41101870ef23",
      "source_sha256": "c18136eed38919d11798bcfc94755d47932983178c9fafad91b4ee835ecb8001",
      "translation": "艾尔加？那家伙又来过这座岛！？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:46f7292ab9c41570b3cda3ed73766402b60c8931876a78b2887f276e482940c9",
      "source_sha256": "f1c25c5ac01ca91d6adc18f185d1af1efe65085fe7e61a71d153ca93133448d4",
      "translation": "是啊。占领岛屿之后……他们又来过。真是一群狠毒的家伙。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0697b683136cfc99e92b2334a511ba46dec3c5d4290e5d6ab494a30b8810b78d",
      "source_sha256": "e5c3ff86cf2bbb9f64cbf6355d271c071d43171bb7aada8540c6641ba741c5b9",
      "translation": "是吗……艾尔加……"
    },
    {
      "id": "coalesced:635b57fbd76e85033bc4c8cb87a23e4ab3da312fabdee854102466c2d7fd72f7",
      "source_sha256": "6e0eac194cd3b1ab021ab709dfda8851baf3cb447c8b82f436d69fe27136a505",
      "translation": "可恶！！"
    },
    {
      "id": "coalesced:f2f91c79fd3f7e9fff0a3c80ed7211a60631cbd69c5d3117e731c7b4aa5f2d50",
      "source_sha256": "d18408dc3eecce7be59668becb9a62a1400f0fdd3738b15c3b1d4db63a205351",
      "translation": "下次再见到他，我绝不会放过他！"
    },
    {
      "id": "coalesced:62d6376562b5fefdcf6cc50620dc474cb3a9444a854b70885452b510edeeec40",
      "source_sha256": "a1f62899789f6a286f01e0bd46f7355654e2115a3958e87b1215719ff3e8808d",
      "translation": "不行，朱特。那个人很强，你根本不是他的对手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8f48e47c096d38441f23785061e104f8230d4f35f951a30e2dc8a0a34651acf",
      "source_sha256": "a46b46964ea63c7405529b74d0b06d27d77c0366c4d2fb46afeac78f550ed49f",
      "translation": "他把村民害成那样，怎么能放着他不管！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c097124db84dd995b757fcf9fd7872f38a32474f9d7ce0839e50126976caf74",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:9f83245fda17cd316bb5a4db3c4810d3654e9241eed89349f071af2974b6e957",
      "source_sha256": "1c7e5d3e6096ec0f19db3dc4bd692a1ffde4716a7938056ba0df153fc2d3aee0",
      "translation": "喂，求你们收手吧！为什么一再把村民带走？你们到底想干什么……！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:901b25236633b33a90e7192713ddd5ce5d84abef3c26f1c3ec3c73a116cb7af4",
      "source_sha256": "05b9a18a6d2283c3c0b16f23b3a2d299193d31bd386b8acac218419784920649",
      "translation": "我会让这些毫无用处的虫豸变得有用，你们该感谢我。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d90f63741dd38192f9eb16cf463418af4023db940aabc4d0eba2fe31ab621978",
      "source_sha256": "9f076b98d6a14aa19b05e5078cfa39a5a2e46c2009822d8b5766db5fa486f8ca",
      "translation": "我、我们到底做错了什么？为什么要做这种事……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12c6a0a436da039097f365b450c684d67e6daf8eb5783bb914bbeea6249dccf2",
      "source_sha256": "c6d540e2a6bd99face34c498707a3d76f774a30605998dfe95f5037ebe411ca8",
      "translation": "你们并没有做错什么。"
    },
    {
      "id": "coalesced:8dd111c2026f73d5d5458a3049519e455b5f0df2fab000cc6c0c462cba5319c0",
      "source_sha256": "af40648907754a3efe02f2d20180cef59ef49631441a84809f78c6b61921e09f",
      "translation": "毕竟，我的目标，是让那家伙再也无处容身……"
    },
    {
      "id": "coalesced:f7efb715b284a745c8480c94cc8b243bc83cda607ee1745bb1dbd2df800e58a9",
      "source_sha256": "2b355531fa73ea5a9b6d0673938ccd107d4340f930808a109ae6b095d227fb23",
      "translation": "你在说什么？你、你们究竟是……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:88ee66987e0d989df6c484f6a32eafa49a660223d1521d99d38e204d79eef791",
      "source_sha256": "d7648d4ef22cc69f217ec80e7b853823321e85ff9debb094c9cf20e68e322d67",
      "translation": "呵呵呵……"
    },
    {
      "id": "coalesced:cd2bbbb9463eb9d649c47b544019d9d3042e9d33973ff3d93846cba56b639787",
      "source_sha256": "111af7ba94d38a300d7c80401f132096efa915ad82659ef705ffce83fd36a309",
      "translation": "嘻嘻嘻……接下来，总算能做些有趣的实验了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b8804edf5cb3e7bb3c8de2d28ba7117909d2b6bda6aced57055a10f4a303455",
      "source_sha256": "caf8d579a49a560021cf225ea95013a65c39abe9b79153f8dcfbf745b453d11b",
      "translation": "我不希望你去冒险战斗。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b20e259a7a26ea55dee136d9006641a8ddb7dca0cc6ca55c68f80c505eb023f1",
      "source_sha256": "0a67de240a67286c33066f92c76faef565ef817e5d7c36779d242d39de60cf3f",
      "translation": "爷爷……"
    },
    {
      "id": "coalesced:7bee7b0e83b795d702550e9849bb234b8e78459eeb38450f800038fc6e7de3c3",
      "source_sha256": "6de603909e9a61b2adb5e761e856e855c4aa4450f624baede93f94e8a8c6bad4",
      "translation": "回岛上来，怎么样？等梅莉莎伤好了，也让她回来，像从前那样过日子吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f02909cf750021b63cd9560c58eeaaa061de05a101222e4d2b7366e2ecda6256",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:d04c369abec7f3e9e965a4a71f8ad103e2e7bd14a90662d13729381ea5057485",
      "source_sha256": "c29fdf8fbc75930ab173762a70254acefd1c3cfeacd90121183d34600fff3b8d",
      "translation": "那个，梅莉莎……身体还没好。"
    },
    {
      "id": "coalesced:73728b874fd32801b1a89bf302975cf8e02c577b3b30335ecd8d67f749f490af",
      "source_sha256": "275428a0196b3f96c7728654d5a8efed5dcc005f053cf98e480f0aa7e70d6e43",
      "translation": "恐怕还需要些时间。等她好起来，我就回岛上来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4fb547b6b59e733c5f3419bc608340221a39f8d4f0376056b687afe042279be3",
      "source_sha256": "74e0244fac01749e0de46141f2aae9bcc76965d6831452f9e41d0c837228ec50",
      "translation": "嗯，就这样吧。总之，艾尔加太危险了，千万别想着和他战斗。知道吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7f287369d85dfb1d62490faba62b6435f5ea2506d036733b5766e93147034cc3",
      "source_sha256": "87d912ea257363562e62be47c5f472d645f9719a10349b5ef0212f280f5cf3fe",
      "translation": "嗯……我知道了。"
    },
    {
      "id": "coalesced:b3fd4a0f480779527e0190caa4b45ad429de4daec2fe5b82521ee5d7283e8384",
      "source_sha256": "a3d1728d52302c5a78f8ce6855a50d15df322263dabd0f753cac2799ff20f751",
      "translation": "我没能向爷爷说出真相。可是，总有一天……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:05b58b56a6fa82aced757d3b152bcecbbefbc17d93ee2c5e24b35754c495a238",
      "source_sha256": "f01d6f406554f9f4b203c3c26eab6d97ba5096138098570df72842f9f7e9fe58",
      "translation": "我一定会说服梅莉莎，带她回来。所以，在那之前，我不会回岛上去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1cee788905d2429aea94eb9b365050897cc1dc976d3cc32654114e92f2420871",
      "source_sha256": "9f3e32449e28958e7e9a47627afe53421743a53ffd3551f399c53ad3016458da",
      "translation": "怀着这样坚定的决心，我再次回到了阿巴泽特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:569c1b8094c1bdf2ba865c100e3292f2c486e9c5c403a4f307611076541262f4",
      "source_sha256": "70dae682132f774f7f468eee39e91a76dd494eac1bc4c29ff60958064537d060",
      "translation": "时机终于到了。为了这个世界所需的KAN，已经集齐了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:20e72bf15c2d196ee311fdad2cffbe59a402a32fba11ff352f43dd7cb876f1a8",
      "source_sha256": "f807ede90d39bf0c7a9c14a15721f59d3e50ce5030a7c93d0a6d1f5c72290f11",
      "translation": "而且，那块重要的卡蒙德，似乎也恰好成熟了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b6fda1df83d41a255eb5996a799e82c180a8be2b389788b3a11084ac47c34e21",
      "source_sha256": "17e9420adf0c256936052afbd531a2ad2ca928938a61b36a06838d634d3ad1fe",
      "translation": "通知亚历克斯。"
    },
    {
      "id": "coalesced:c29b4ddd2f61ebbe866e8c7b9657314a7e2a9e848bd6f9e8c26543afb9476328",
      "source_sha256": "ba0e751a567a8e2a72d98ae88e9e78baf4192f6c46a4b2e9d047bc39459614b2",
      "translation": "遵命，修恩扎伊特大人。"
    },
    {
      "id": "coalesced:cc4a7113c338cedac1aa0579882e9371e64a6e2119375c30aa0e8dfce0825727",
      "source_sha256": "6040c6403bcb3f8f44f3a30ef9da9b45e3b59ed52b1ec79a8e225e9218750ab4",
      "translation": "一切都按照您的计划实现了，修恩扎伊特大人。"
    },
    {
      "id": "coalesced:3578469968a0107b45284a101051f2c1d62f52551a500a400d8b7b9c8ce23c0a",
      "source_sha256": "c9786f84d4c9b1ceca34b68309bcc025b21d84605b6b1fdc02ccf587fe2d8a5f",
      "translation": "你也辛苦了。"
    },
    {
      "id": "coalesced:b8f1cec316aca2ac85ece6396dcdedeee99e12ec0944b59c7daa0e4657e166cc",
      "source_sha256": "b1cca3d99bd61782b3a173d60e4ba4fed80cb1fc4c8a48a4a5fdb16aa1121031",
      "translation": "哪里。我只要能进行哨兵实验，就心满意足了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:935fbc2ef3b2577fa5284c920d81002099a528209e428694021eed069d389fa2",
      "source_sha256": "dd019385711d04601bd7ff73e0239bd6f5a251d9bc584b055ea22cfffaf40abf",
      "translation": "濒死者的恐惧，以及让他们蜕变为全新存在的乐趣，真是令人愉快。嘻嘻。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:37de30bdb9f26b32faf3a1f993296658c1003f39ac141ebf6b482cbfaf4ab352",
      "source_sha256": "651758754374b666dc8439c0d9e1933931c47b298d24e757526dae5106defd93",
      "translation": "我们可不是为了享乐才做这些事的。别忘了我们的大义。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5277e321b3323e4da6487a3786e396b882e8997d1983a5de42ffeb43391eeeea",
      "source_sha256": "2ba3fdab9520073cf03526c4fa30864dc5be3d2555ada4f733c8af3a79ed10fc",
      "translation": "不过，正是多亏了这份大义，我才能尽情享受研究。说实话，我倒更想为此感谢您，嘻嘻嘻……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce196b1ae9feef6842f7febfade76d92caea85d87fbd70f6a7ee8e4d14bb9e15",
      "source_sha256": "8e51ae4316bba98ab1a56ba2cb692a64d6231e6b2b5c7ab8bedac7b115eb64ca",
      "translation": "……南部军夺回了岛屿？"
    },
    {
      "id": "coalesced:9f630cf39e45ff7313e0de72ffc18165b584267ea17515a04eea454fd2e6e2f1",
      "source_sha256": "b116db86b8321a1269e2eed538ff733a203c3a330bb55380125a783829e99a61",
      "translation": "是啊。北部军的主力部队，可是多亏了你才撤走的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:57ea9fe691090c8c2b5d2244969e1cd926ce4fa4b27a45e85ac4d1e15c2640e5",
      "source_sha256": "0b8b7677dcf40b93a07fff2abda44ca7998dcafaf8e65f87f1c2f21abe3cad65",
      "translation": "结果，南部军那帮家伙趁机把岛屿抢走了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16ecb61fa8a0e4c0b04bbb51ef19b8a3abc303be7c5a5634bf23f2848cdfcc55",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:fb4a7d2df027c351e16870ffb1a0171c8842af90cbf5a869249c53ecd8fe5ad6",
      "source_sha256": "4a88b4f09b7aea8194ca9c24817ee4616306252c6a36b736df5fda45f4dc6872",
      "translation": "没关系……朱特会好好保护岛民的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8cdc1af4159ad20ff428a8941678230a2d741f6baf6dff9e9b4cd43437efb8a8",
      "source_sha256": "75f9674d4dcc3534f87f1f7aaae15f6517072a963da0b80de2bfa63d944e5950",
      "translation": "你忘了，那家伙是我们的敌人吗？"
    },
    {
      "id": "coalesced:7399c6f0b66cc7513486332099bf5573da8c63b3fdb560ba53462dc233645f43",
      "source_sha256": "40ef3bb0310572e515ebe0e368ef87ec720333b6d06efbbfb91f3ccbbdf623bc",
      "translation": "朱特会回来的，只要他恢复记忆。"
    },
    {
      "id": "coalesced:924c7137d52ef4463b291ac17f145da14a4632e446d50cc0d83b1d5c3c62cec8",
      "source_sha256": "cc5bca7438fa3edf685527afb811c51806457d125cdef2212330787650e43615",
      "translation": "就算他回来，又能改变什么？我可不会放过他。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b4bf8eadcd20a968e514c0ddb662fd90c13410498464975e23366620d0f3100b",
      "source_sha256": "4341203662bb802866a4bdff52eb5846153dc1bb324f26740b2b638f4eb2d9eb",
      "translation": "你……是在害怕朱特吧？"
    },
    {
      "id": "coalesced:8e3b6aad3443002b3ffa7e02fda4fa4f0d31154fee9e593ea2e43d7b1f319fd1",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b92f8c6af0b7f185f18f0c6029a774e0fa65b0b9c10945df0dc3f502fa878038",
      "source_sha256": "2d5fc04b3d0165545ea87c8e7fcb41296555088b0463cb00e125e9db8f54a32b",
      "translation": "你要是再多说一句废话，这次我一定拧断你的脖子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22aa53ef249a30c70f45c9f4a198decb2ce1d0cbaf2e2868dcd7bc9bceeb7050",
      "source_sha256": "27570007dca87a8c618c2efa7e18f8c91c908549f78625ea4891f87f7cb6827d",
      "translation": "我要把朱特带回来。他该待的地方，是这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5d5fd37607cbee3267997d088b37327a2936d3cdd9e158000662e8713dbf9c40",
      "source_sha256": "caaac4ff50f5f40dc34a9f688f25d61c269a22c506ab49303dec2a13552dfe13",
      "translation": "那你就试着把他带回来啊？如果他相信你，早就该来这里了。不是吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e1b3a7c784387d5ad578ee63571b3df0793fbcc4bde3a0328c81323dc70e7bb",
      "source_sha256": "291e2a59704e054a59777d3dedd29aeae970b3f99cd2b9403851f4b56496a7a2",
      "translation": "还是说……他已经被公主迷得神魂颠倒了？"
    },
    {
      "id": "coalesced:ec5a777a3a9b299df6c26be8cc0da99f0815f92303d5e3898332ef0bd4104b96",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:f5266e8dc16978b04329a4a4e98dc15318a608b7d12444ad542e1a4557741867",
      "source_sha256": "503146bd10ab30712755c872f85c7bbf64036231be3d714e7e5b564c870f5f2d",
      "translation": "无论你怎么挣扎，那家伙都不会再回来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bac69002b90e0b8014b577c775cd95eb7f59a1c0038527a5c12dd944ff439f34",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:ffc7fe03501d83495b8d81ab3e7392c44ef925f976b2c6bfd1851c6e947bb2a6",
      "source_sha256": "d7648d4ef22cc69f217ec80e7b853823321e85ff9debb094c9cf20e68e322d67",
      "translation": "呵呵呵……"
    },
    {
      "id": "coalesced:458f5d35f4dbdc74788f9a5a26186c953609513edb1d836b4d9e0d72107f6c6d",
      "source_sha256": "540ae45f788a41668e7be8aeaff8c2c2e87514452a3705ec25156c2838f09cbe",
      "translation": "朱特！这不是朱特吗！"
    },
    {
      "id": "coalesced:c549d2f732106142d024f066893833c4d71443c956dcda445e006962fa177a50",
      "source_sha256": "427248b9ec314c6bf2c7733f46b3b67818e938a35ff573724f5bccb065aee4fc",
      "translation": "你还活着啊！真是太好了。那场大乱，你居然也挺过来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fff2791649d82df0838805c81e380138f1bec495d6b92b739cdf54ddce8639b2",
      "source_sha256": "94c568b94b5fc17e89cb86fb4a49799d53100bba64ec83a915c796efe6fa06d8",
      "translation": "不过……你加入南部军了？你竟然会拿起剑来战斗，真让人吃惊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:da9fbd277f449c92719310d58f5787927c7d200e5233c84a39faa318f458b6e5",
      "source_sha256": "f0c1ce2d4c26da6ac4f5969737074d09ede6500ade27da180d3da53f87f0169b",
      "translation": "总之，那天……我和几名守备队员为了躲避北部军，逃进了森林。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1eb9ba5ca439c7d379ccb80c1fd052ae1351d6f27c8e40c8645f0858e25fa425",
      "source_sha256": "b00744b8f81b31e0c9b07b2fe9ce2e9f32b1fbbea18d21fc504680b4d3aea3d6",
      "translation": "此后，我们一直在寻找夺回村庄的机会，",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3f8744563222368ff9fafeaf304a840412af305e0f5fc1885dd5ac20a924ba55",
      "source_sha256": "80c54c1d5828825be46cbdea98e60f6baab8b91da3d1141232eb0c854deb1c89",
      "translation": "可光凭我们的力量，似乎怎么也办不到，所以我就来阿巴泽特求援了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67c82d3c9003fd757ccc1c403bc0bd74810fecf79dd3f1c71f37cf0e9c46e831",
      "source_sha256": "e5d3cb56371a67fc771877272a6f5cde5a4c354509546061855663cee281ecec",
      "translation": "不过，从那里一路游到这里，看来还是太勉强了。我得休息一下。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0cd8b4a37ad8c5d08b7947662483b7e965379e258df95b2ea0c4c1b44afe1fd",
      "source_sha256": "3f21ca6ce10cb3b3e83622124d831ba5f258f37f9077e197b0dbc02cf6053857",
      "translation": "好了好了，这个人需要静养喵。"
    },
    {
      "id": "coalesced:3434a41217a24cbbad885e4797b60a11b1304d524891de9dc4388ce6283f6919",
      "source_sha256": "e163344770a67a0784fefb4bb34ddff52cb9ebbec6092c737a86bce716242d40",
      "translation": "他在水里待了太久，又累得厉害，身体变得很虚弱喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2151b17f835a0d8bfb7b5947ceca6fad5e25545f94f1cd7cba6855537d07c398",
      "source_sha256": "cf9a4767898d2b197092004c021d50f5ccbeef5217645e39cdd06badb8fcecea",
      "translation": "这种时候，要是有[幻之根]，就能很快治好他了，真可惜喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2c576448f2f419d8f1882db6be94c3f983089ceb4030dd1879568f6ef81110d",
      "source_sha256": "a1c451615d8f463ebe363700139141e5df3286c61ffd9a2fd21ff44cb71ed2c2",
      "translation": "要不是那帮黑猫猫占着那里就好了喵……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98ce6a8f29de6be9b4ebf5eb3504b3fe532134e4b8236c8946309378e985803f",
      "source_sha256": "7ca951d3932f5b5cdb47fc0a5ce81435981f20c72bdd10322a83c4ffa40ace65",
      "translation": "现在，黑猫猫聚集的地方，就长着幻之根喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db38c1315e87f0fce87c9de1cdf2ba1939656e1155d79b2e56dc737bb564651d",
      "source_sha256": "b8d585f88a1a3794aad1cb9e7f576d2c5f80fc53017333820db853ac599ff2df",
      "translation": "你真的要去找来喵？是长得像山参的根喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69230a1a33980a06b426db911c551e88df4a630bc93631247a51d6a3ee068ec8",
      "source_sha256": "87972b5e47e5c7580e0eea504b4b6e1cfff6b08c6c7c870becff749a0b563b30",
      "translation": "只要找来，就能马上治好这个人喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:90f368bdfeaa42ee37682af3b6281033350eca40ddbd2d9b9b83b8a637a8daf1",
      "source_sha256": "9049fa250fafed194220c501c88de45302c55675823e7c5ec723fb4544b68c01",
      "translation": "再让这个人这样下去，会有生命危险的喵！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdef81d1a5963e649005c3f689784ab64d14715558bdd37ce0509bb806c2452c",
      "source_sha256": "e95002e8ad40c99e0697a4db676a8d8e2d6666ec4d99f3d26dafe3c2a1730d36",
      "translation": "照顾这个人的事，就交给猫猫吧喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b23efc65fdcdcd38bcc485f649ed19cb3e7d57b37111c9f6f78d8a8cf5d95e6e",
      "source_sha256": "df1ca926a29c33ad3af9822270c9980abb934746e24ae9715a48d8816169064c",
      "translation": "哦！就是这个喵！绝对是幻之根喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7beebbf48d5aa09358d35e71946762a086e3deea2c8b1d770a2c004d71dd8106",
      "source_sha256": "b496857cbd753cfd1e2ade78defefc7da0588ccb7b0a8fc0ed3339d20426816c",
      "translation": "有了这个，就能马上治好他喵。稍等一下喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c9396ffaf58e139a9816315d0453024fe12d74d542588cafdc4918f2f708884d",
      "source_sha256": "1828f1bff9af186c51db25c28096f534924fd05300a02c6410124133378e3b17",
      "translation": "呜……这是什么啊。怎么感觉，浑身的疲劳突然一扫而空了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8cb65690822080b80a74811df748b6edf68e545a079569683c2547642e95ea36",
      "source_sha256": "6351c9892ac257dae45eae09498f9fabb9ff7c3a6d8d77138c3d4cd2c4dcba3b",
      "translation": "是这几位带来了药材喵。所以刚才才治好了你喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2abba542700518f2856ac243191732558a369269ffe246f2725fe550490a6ecd",
      "source_sha256": "e7e3a6b14b457522d282fda974631642a6342ab355470b0cb0c43ae83acb5f9f",
      "translation": "原来如此。谢谢你，朱特。欠你一个人情了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1d1a3f4d2c34a4cf23081247f2439574ef45d52d4b5994b9d3243b0ea8170c30",
      "source_sha256": "7dc4b3f7cb0fccb667cfe015c1193f0c032521c497af58a05af50c1bc5049981",
      "translation": "QUEST%s : 获得幻之根"
    },
    {
      "id": "coalesced:2bfbb4b83a6939ef2c9cb3d561019b921518318b8257f2db77034bfa43a8e5d9",
      "source_sha256": "29dff467c85931c32ee0ad8c40cda4cbe56691fae03031306581f2dc8b46f599",
      "translation": "幻之根"
    },
    {
      "id": "coalesced:e6c4d191122e2ecf16f5660a8ce929390ef0073ed2e86478ec7c2e3f129ea976",
      "source_sha256": "29dff467c85931c32ee0ad8c40cda4cbe56691fae03031306581f2dc8b46f599",
      "translation": "幻之根"
    },
    {
      "id": "coalesced:92bc540728aecc75ebedd830237b4291a6780b82ed52dc89a447b74bc87a7844",
      "source_sha256": "846765f9eea993b407594199221b8cc47df5bc910a4cdc149130ac494679646a",
      "translation": "必须找到用来治疗比尔特的[幻之根]。\\n幻之根生长在黑猫猫的地盘上"
    },
    {
      "id": "coalesced:972a044d27e13c4de353805a37f3f07cb2ff9f1502aff3faa42f610cb9e21ff3",
      "source_sha256": "b069ef20a4ed8e1c9d5704b7efa361bf803bde9141c89f8db438ee4abdde98cc",
      "translation": "把这个这样、这样、再这样弄一下喵……再这样合起来喵……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e37558e250ce62eda9b1fa33c93397b31548c0cff503f165da473278f75cd2c4",
      "source_sha256": "b4f00fdc222681369c68df9ec7ac8e5ed24389a025c6cf613a94f67f68372799",
      "translation": "这样……这样喵……"
    },
    {
      "id": "coalesced:b276c9efbad3c2fae12c645e672736b8208e22417141538ae918ac77ba3ffaf5",
      "source_sha256": "f723157ed71e0319b4953cda86002b37873a3ccb45cc9e915efb329f1664b43b",
      "translation": "好！完成了喵！！用这个就行了喵！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4188813bf9316efe779519da08c6820c11055fdf9b422b152e15af8c9de31e0",
      "source_sha256": "251c0e6d7a41c4a3cc090d5cd1a94b019fa1fa91095198d949e4971468d7c555",
      "translation": "来，把这个喝下去喵。"
    },
    {
      "id": "coalesced:242e11a438d8bc7b19773c81041bd2c1451707c125980e4274ba13ce276803ab",
      "source_sha256": "967c7132326f0c9c9a01e44cc3151839a5d94122839aa7efc6c398f17e96c707",
      "translation": "呜……呜呜呜……"
    },
    {
      "id": "coalesced:86716f79e8e73f8602b6ac3f877edd31101a380081618bd8769b5e839d7bca10",
      "source_sha256": "44da5742420afe45ac593ad745333c0db5833620500a70e25ba508630e2fa798",
      "translation": "谢谢你，朱特。真是欠了你一个大人情。"
    },
    {
      "id": "coalesced:e3570e2a5a0cd8d01aa069eb1424f4e0e982ee77ed4c5797b5f67ac6e0494a85",
      "source_sha256": "53e30bed3f2928546272ed00d78dad4f187be9c284367fc99b434cf1ae4604d2",
      "translation": "如今守着风息岛的，是名叫[杰巴萨]的北部军怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e591688a3e8484332de953fe2c90e810de3b652d93a4e4cfa86792d0e20f8a13",
      "source_sha256": "5e531934612186c8e2e6811115c6444abc2b1342da688256cd21697adf8d9370",
      "translation": "不打倒它，就不可能夺回岛屿。可是，那家伙非常强大。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e300a534f81a76f72b96be05807f070300d04c67d20f3a122cb6b222d0ad4b53",
      "source_sha256": "298a5011dadcb67c0ee80297614e90cb4aea05b8a54f071fc4592840d8213688",
      "translation": "守备队员为了躲避杰巴萨的耳目，分成两组藏了起来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec8a2b718b0ff2b3a8d10f57b5f1f1a3344334bdeeb7cb5984c0a3952da3053d",
      "source_sha256": "1520aea396e9b0ed5db6c6e228c530dbe627b371eea0bff93032bf56494148b1",
      "translation": "毕竟，岛屿实在太小，没法让所有人都躲在同一个地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:284d3b1fff71d97794b5093eea8b2e6fc0e8ec7f5aebf5728a44c500c87767d8",
      "source_sha256": "3b46b1a36d5b16a3656877694d1d561ac7e8f961fad57dcb6cc93b77d8d2ba26",
      "translation": "一组藏在风息海岸，另一组藏在青灵森林一带。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c604fead7dbed207d43f99949c2bdc984b5037317aee2150d24d56bc9967f17",
      "source_sha256": "ed2174b6fe43f4524159767b130b58cee1226b72dfb654c6e3aae00f6b9fe345",
      "translation": "去那边的话，应该能听到详细情况，也能得到帮助。去和他们谈谈吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4bbd0d489fdd2acfe11b77acc45df93fa211b2553ac3b274ef0e59f89100c62e",
      "source_sha256": "43bd92b88d24c6e3c5a953c6ea28e0b19935a29768927c6627c6f1e8ee52552a",
      "translation": "那我就相信你，再休息一会儿吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:898bb729a9955b0daacc4d09f02df88cd1d5eb06b5c2ec9a4f9ef165a5169d3e",
      "source_sha256": "61d010d19b6f1f38487f4511c150c33ae894381b67660a3f331095ea9e0cfe10",
      "translation": "难道南部军不打算拯救风息岛吗！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6467841a38494b507dce7b131683d2e9158190eb588c590c9b837d7d61fd2ebc",
      "source_sha256": "b6aaa92189a3bef8e9362959561a91e70d3fb01a2800ecdd071fc189f7e6affa",
      "translation": "呼噜呼噜～"
    },
    {
      "id": "coalesced:a0802c9bf44430383454f1a259d5b654db5e6fd3211c8973664c06f995bbf2d8",
      "source_sha256": "c68640ba84adc375734f40483626460e7e3c5d499964a07bb625543d219b134d",
      "translation": "朱特？你还活着啊！你之前到底在哪里？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44ef43820add2135e3be0c53bff86fc7828af0d4513ce1ff54917c5707386eb3",
      "source_sha256": "94fed8f40272409e2acc1f4e0cb0a762e58d71e5aa215fd59e8da9f04adacef1",
      "translation": "南部军？虽然迟了些，你们能来就好。不过，朱特，你竟然加入了南部军……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7c333f5fbc2913ede88d13823d3a5011cb3a91115e0e28aa3d43862d85764b82",
      "source_sha256": "8d5d690763b5115c0604644e2e21100b56e1da1b13bc16579effed7f86b8e466",
      "translation": "总之，只要是为了拯救岛屿，我们也会帮忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:51e2f30c14c80a482ac4b8039508089c68fd34b26ca713515a26f7c116834f75",
      "source_sha256": "511aaea30b20f89398a7cd876111bb82fb767f700192e32579a70079e449f26f",
      "translation": "风息守备队(森林)"
    },
    {
      "id": "coalesced:71a62ca8f176198cd2cd65334cbd2558adac7f85a24c9b9c5cf570756f4407ec",
      "source_sha256": "679c55a15753b58aecdbb1d8ca8536b3efee516948970911bf991110caf69a2d",
      "translation": "必须找到藏在风息岛青灵森林里的守备队员"
    },
    {
      "id": "coalesced:8b4431ca1b69c8e8efa06843bf3b7000c186bf99ec735bcf8579ebd7cab4812b",
      "source_sha256": "c3608d878727ec066637fc2af5c76dffcc5bef1605a6e94008e6c72092384e5a",
      "translation": "公主殿下……您平安无事啊。"
    },
    {
      "id": "coalesced:b85164dcd5f6d78a2fe758901864dff126bbf65e0b3925ecef1edd4999df7519",
      "source_sha256": "afc4f1bb9152be75cdfdc19a912f6a3912a79f2356408a110ad43124c14f378f",
      "translation": "公主殿下能亲自前来，这就足够了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ecd08b7703e513d11baef6257dcc1740e17d06569d4001e5b6c6e2cd0edc4bf8",
      "source_sha256": "4ee7b35b5b4fcf59005eba5d1110e86ab273cc3726a273ab0d2e356ca74e95c9",
      "translation": "有公主殿下在，我们就安心了。现在，夺回村庄只是时间问题了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7864937b2abdd54ee35c7a81a9c68ee8649f4e12ad4f9f539c7b58d6acf9845c",
      "source_sha256": "09257713c91830e782b2b24f7e80ba9148d788be6b2778022bf4df1e15038cf5",
      "translation": "风息守备队(海岸)"
    },
    {
      "id": "coalesced:05cd6d96b4aeebc4332f8b543ab751d97782a4c4855f0cd8b8967d5eece67c29",
      "source_sha256": "16e55e9206450984bf8699dc26ef7980624b123398621a96ab6d7a27d886036c",
      "translation": "必须找到位于风息岛海岸的守备队员"
    },
    {
      "id": "coalesced:917ac303c2a64a106f0c624374c22232d11767b566a46d746a6dd9f0dbf42ce5",
      "source_sha256": "167d072662a8f36d128f40717d2870e04ab00da9e92d033c7ddf0b14f6078e9b",
      "translation": "幻之根 "
    },
    {
      "id": "coalesced:d76e2fbfc4329a7b9e5f4c3367c042dbf12e8c5e46b4a89891fdb17e0f390da8",
      "source_sha256": "fdc0cf0608a80af421a4669ac6e9522150b54fa8bb33c29796bcc91e0064f385",
