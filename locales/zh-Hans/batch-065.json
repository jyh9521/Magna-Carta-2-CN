{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:baac434633f7f67494ee441ffe87268582b138b2e36ff6fd5b4fc534f6ef5368",
      "source_sha256": "fea79607c721947ebf909d7b54273ae7c6bfe1143acb0d20ff6aefeece4fb3ea",
      "translation": "劳德……"
    },
    {
      "id": "coalesced:f748001943226f6e8c8e6e1a289dccbf1f96c3b3e8a60321c463e780fff5a43f",
      "source_sha256": "814dfbf0c3702df6e68d8c9e9028d22551b57969696422d9f874cae3b4ed3cd0",
      "translation": "我做梦也没想到，竟会以这种方式，与公主殿下相见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:127e60010d27ef1dd4eb70a25128c975cdec012c1f2547c41abec1737aa75128",
      "source_sha256": "bf2bc0ea61ee712d593901b6610698826c3eb0cb6963a2bd96db19e69a1a0228",
      "translation": "我也一样。"
    },
    {
      "id": "coalesced:8731efa18c90339cd068ab15f957348803a472e4865d8ef59f83056e6b9e8e3d",
      "source_sha256": "0925a9bef6b68aa39c9c2b5c4b0408f91c14e06c1027573a6bda497488e8d668",
      "translation": "我……很想就这样，放公主殿下过去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0150629fd35a6aa3a6ac22c5ba67f7c5f410218b20c488daf5b54d907381c5c7",
      "source_sha256": "3f0831a85e566545038ec0bda1d9eeabf779a7ee265abf1ce06e17e61d136153",
      "translation": "可是，为了兰兹海姆，我不能这么做。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:75f1d49ec2ec306ab09c01928d6c0166f9cb0834a186bf5beb68480eef6652e1",
      "source_sha256": "6c060382ede8b1dca7af81c8020e5e32e0507985558b113023aece123873b7fd",
      "translation": "洁菲死了，世界也不会得救。即使如此，你也要阻止我们吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f9d3430671ca8bc8a13b0e90f185cf3eb0953e53375a38a99551dbbcf97bab69",
      "source_sha256": "c5dcda9802ae41b859e0c6e9f96a7e9589a1ccea085d8a16d36d81a5b4074d9c",
      "translation": "我也知道真相。可是，已经有数万人牺牲了，不是吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:25a1b72054e519c96edd761f95df980ac8ed6b3a74ed9615dacebc70c93c71ef",
      "source_sha256": "a1838ab7ad25fe7c9a17cd2cd8d413a22abccedab97a70245bbe67913f1ea820",
      "translation": "所以呢……？"
    },
    {
      "id": "coalesced:a5eff83dd4405699a5e9b16df28434864e768d1b7814641ddcec9f99f832c659",
      "source_sha256": "52a3ce001af95aaa359caf3c0cec9efcb628221b736825ec4a0a47f714de010d",
      "translation": "你的意思是，再多牺牲一个洁菲，也无所谓吗？"
    },
    {
      "id": "coalesced:4c0a5b5432908820ee59e114bbff93f79f231a7eb4bf34460eb8dcc3809f02ef",
      "source_sha256": "ec3a13d3ed7e915fc812da6f67faffbe50a66c21811a3a1222920bac00716e49",
      "translation": "虽然无颜面对公主殿下……但我认为，那才是正确的选择。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:19fb639695b03e3192b81ce4c09c6f4c9efaaa9ccd6e898ae8e938f75674d9b2",
      "source_sha256": "20cc166087ed2d9aae6f4947526a07bc97c23460d622d2a77786cf3ddd612413",
      "translation": "我只希望，今后的子孙能挽救这扭曲的乐园，斩断与灾祸种之间纠缠不休的因缘。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:534bd3a59b55afc71e5eaec2e9df6d393ca1be4c8a39fd9e7e82ff6217989246",
      "source_sha256": "3d9d9ba0db433d9a89634c818e98c0d6b81a40458f024567c0afa19abfb5bdd5",
      "translation": "那为什么，现在不去斩断？"
    },
    {
      "id": "coalesced:c2b1d4e8dd8e1c08a260a534c95ac41363fec268f15ecd180dabd2838d5b93a7",
      "source_sha256": "a4d65c671ccb56d6509ec403a33fde64bb123103b8ecceadd586bc027b66bbe1",
      "translation": "现在还为时过早。贸然行动，不知道会引发什么问题。你们打算无视这些吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7704d26ff9c84bb1cc4f2da9e33bf4e02b195c07ee1f216291149a870992cd5",
      "source_sha256": "926900c776e70e505b7ac996f23a050ceba127886d7d80b52e3a6e141ee062c3",
      "translation": "你是个胆小鬼。现在就能解决的问题，为什么要推给别人？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bedf812b8ec00a7d604a081c9e8816dcb7554314f5a3b24d1f7260480156a04",
      "source_sha256": "e1ad507cd45f8f5a9d49b4c42a2c4199bf458c3e778f146d77def77df6b64c3f",
      "translation": "明知道有办法，却还这样视而不见，才会让无辜的人不断死去！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4e4650330105840fed45e9a5c1c3d22bbdd53fdc9ee6a7b56f2b1c8cb23d52c",
      "source_sha256": "233d26e97f6469a0a7e0369bfb9ff2504cc5e0037df310c7600d18d62deebce4",
      "translation": "！！"
    },
    {
      "id": "coalesced:0d8d2a21c7402b275a49c8d9b6bbfa8326ee4c2c27f0bbbb16ce8cab13da88cc",
      "source_sha256": "35b0ecd08658d8979b04e92c79041c5be4a482e7611882a824f5713e0582edf7",
      "translation": "劳德，就不能让我们过去吗？你一直都很关心我，为我担忧，不是吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:04f2abd4ecf63e4f813b223e8f8b9ee87068474975b56f7b2e385304346b973d",
      "source_sha256": "9581be3f186d7745ec54ee2363f189a338000f1002c2b947a9c767c3406d71d4",
      "translation": "正因为如此，我才更不能退让。倒不如，由我亲手把公主殿下……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d18023ba0d7e293a6ae44edaaa47332dbed3125ac06aa9254202a8f2fdb7ca6",
      "source_sha256": "11d3f3f05c08c31b2b192517271a48fdc5ef4860d8aacce45ac3f5aa0357eb9b",
      "translation": "我明白了。如果，这就是你的决心。"
    },
    {
      "id": "coalesced:3fc51d137ab558de54bd1b01e6a6c758fbb178fff0167ca1f2e12d63139ffe85",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主殿下……"
    },
    {
      "id": "coalesced:2c35735119c8ce6b44a9a4272b5a4de0553d66a1b2bd7ae9badd2fcba185d82b",
      "source_sha256": "d2fcffc78d3c08eb73a4503add0611211587d354486f8579614c6de077fefd0c",
      "translation": "我会拯救世界。即使，这会辜负所有人的期待。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e07f20fc2474f5c7bd10e9a95e6417a1cb62816c015c24518a97098eaea83d1e",
      "source_sha256": "f0cc02058db2713cb812897e49a82cff770596e2021da4e88bdafc5b018cd795",
      "translation": "没能……陪您一起走下去……真的很抱歉。"
    },
    {
      "id": "coalesced:be2391758232878922dda971323f841710a645aa8dc0d07749aa79659f12bc1d",
      "source_sha256": "fea79607c721947ebf909d7b54273ae7c6bfe1143acb0d20ff6aefeece4fb3ea",
      "translation": "劳德……"
    },
    {
      "id": "coalesced:73e7ff2f9ad8db561fc2b31c6169e00f000dec58a9746af00414d03215537498",
      "source_sha256": "c7871f7e93cb021ccfab79d3fb0fe1a344f14e517c0dee8a45f0da99e59ea384",
      "translation": "公主殿下的想法……是对的。可是，我认为……自己的想法……也并没有错。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c8346292f474937564e3a1f46d8e8c2037c1ff70daa9f737069aaa96d3a2487b",
      "source_sha256": "e9bd625959da14bd20532b3d8dc50d500d07c287a4b3f88f0929323e41a9d798",
      "translation": "……是吗。"
    },
    {
      "id": "coalesced:6cf6de56a0927b11a07b8442abb48fefa77a0dfa6cca53861c6d7b686c2c65e1",
      "source_sha256": "02717827f3c6497f0af0c7f702c120f833d48d56792e7ab13d9ce40e91c496f6",
      "translation": "请走吧……公主殿下……"
    },
    {
      "id": "coalesced:ad022be68c955400329d887ddd7ff05a78c568062ac7486a85827af9a92db261",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:a111a6649b405afc2312c32d2ece72c21e930440ffa487f787f5f32f040829c3",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主殿下……"
    },
    {
      "id": "coalesced:69646ac53d4cc0540c565332ad70bc3a73060b89027f4caaa00e78c898a02be4",
      "source_sha256": "1ab53684ea359b58ad7e822576041fd8b3eb67b0c2578632e7c5885732e123d4",
      "translation": "……真遗憾。"
    },
    {
      "id": "coalesced:ebc68c1c2b5eaa3e76f8fe93d5d85cb33919aa3288959220f9708c9887d89e70",
      "source_sha256": "7a29c9d709ab793d4fd288b2d855fb74c4f681bfeaa8eb56b6ae30b83bc69fa4",
      "translation": "要是能更早知道真相，这场战争，原本就不会发生了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6983c9ea977ee23c7c00d8544e68b273b949de81637532b71d40e7f29b907340",
      "source_sha256": "ae6647c6c8649e1a580ed612329a6bf6a5b3eaf2c5863d7ffb9ba779db45f644",
      "translation": "所以，我们才要在一切变得更晚之前，结束这一切啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a8874f17db5d3551040ce2cc508b4f61d47f2faceb59e129c73b4255ba3025d",
      "source_sha256": "dfa5754149005940cd3b427112c75b8cf924f4ac292c91115595081f526106ee",
      "translation": "振作点。我们还有很长的路要走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbef9b694c4287cd0411278c2d674355edd6d601338a8bd25e0dc81e3558417c",
      "source_sha256": "8025c713f26164a6787608a6cbce1b8ac0cfe963a42e1416578db60193e95224",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:2d71bbb1ddf3ffcd8a31a9d31c6eba50a4222494599630f1863dbf36405830b9",
      "source_sha256": "13c33202d939b4fa98bf47b49df3f1dd70c93ce10cca03a2f9483e3ab8c4ce04",
      "translation": "看来，你们已经打倒劳德了。"
    },
    {
      "id": "coalesced:24ea30e8e6aba3cd3b4e872fc5f7141b330b4d1a9fdb6065e50f458a4a320442",
      "source_sha256": "6b9480037a778233a47ae57fac7d6583592888c04e0182fbc690f0e0a96b80e7",
      "translation": "这次轮到你了啊。"
    },
    {
      "id": "coalesced:fc219551cf34505b1f4a84c733ea1e6d3239a6aeeb0d411a9816974c2903962d",
      "source_sha256": "698cd3b13435798bb4c14f4f47782b419dc4a2643613a7aea9582506c919ca4b",
      "translation": "既然已经走到这里，想必，你们也听不进任何劝说了吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf60264983e6089689e15eba391c0c4707ce761b2bc24caaf761e9f138c11c68",
      "source_sha256": "4841e1f7b9ae274d94d1c0e379431e6a4c5401a5bf2c364f54542334c85809e6",
      "translation": "你……和修恩扎伊特联手，发动了这场战争。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9ef61e63f628b7cc96eb54ce60a3915b61919a3c6df67f361cf0adf732a0774",
      "source_sha256": "23f42966f6c65ced7da2c0b3ee5f7d5dbf328e40f7a113d2046b69a71a201b5c",
      "translation": "我并不是从一开始，就知道一切。我也是后来得知真相，才大吃一惊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3c98352c205b7f7984bd1e2bc28031b0745883720b6d178e3b75f34dda6407b7",
      "source_sha256": "6b8350f6f6488050e8f953632d298fa495130cd76c2eb3b61b734849a36a0d14",
      "translation": "得知要牺牲数万人的时候，你就没有一点良心上的不安吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b63651917e96602b2b75eb358fd8e882fa6d9c3aaa46937f7dd5fb73dc4b430",
      "source_sha256": "34a0e0e24b1e4d3734f88d8ac78f0a158a9ff04e3d2e640b17842f7194d96f41",
      "translation": "当然，面对像您这样，将被牺牲的少数人，我没有资格说任何话。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edda137aa6c1c4cc3f459617cbf101e28de46d74dbf2b3685e7da3f19497a2ec",
      "source_sha256": "38a6f2460df70873480d60d7ab181cc566d5b687ea630a64e454b5406211d92d",
      "translation": "可是，说到底，这一切不都是为了兰兹海姆吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dabfd6f31735e21a5d7ba1b095d064e66e8137f0e5311fa5a058355fb59956ae",
      "source_sha256": "da7d2a0e346fedd40d033a7c2875bfee1cd56a103c35e32244f13b78cef074ce",
      "translation": "你怎么可能，为了那么高尚的目的而行动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22e62e7ac51f75ac0e46773f43414668441e859a9ac053562d6a074d66983473",
      "source_sha256": "ebb4fb23c8edf73007a7bb0a144e01350460ef200116c4139a99d33b4e2f8ce6",
      "translation": "修恩扎伊特答应过你，只要杀了我，就把王位交给你吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:46a69befc50642288718bfe9c65715a16193e672ff6a81c210457e65831c4102",
      "source_sha256": "1710f2a5677af1b0d225669a57594b74f9ec1dfcce7fe9ee30fe2f9d8a8f482b",
      "translation": "呵呵呵……真敏锐。"
    },
    {
      "id": "coalesced:c9d1dacedf99dfc34cb5a1f44120a3827cb108003db2287ca58fb418186899aa",
      "source_sha256": "1f98fea18469913974023d787180c6510b214eb4c4ed4736b90d9c5af8dedac3",
      "translation": "看来，你真的很想得到，这座人造的虚假乐园啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a7546f150c08a85ab1dff0f4bfdf4d4696133e0f44930ad4751ead85135f84d",
      "source_sha256": "37fc4d4747b31a54dac795fe333f192158a4daf0f0e8b1f234c9330fa996376c",
      "translation": "你们以为，自己如今还能活着，是托了谁的福？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cd3b3d084343ea1721caec8d42ddc3131978ebe3c26b63d524107c0050330e12",
      "source_sha256": "ad515411f8355b6183c96154ec9514f8daa2a114beedbd128930008eb202d731",
      "translation": "什么？"
    },
    {
      "id": "coalesced:d1519cc2ac870bc991a36866fcbcbfd70158ec28fe87a6c21656efe38ae5188f",
      "source_sha256": "575067f64bb3fc8a30204ef3c59bb0621b3a80886bf4f7aa847cb68780d57032",
      "translation": "如果当初，斯特拉斯没有在卡尔塔大战中获胜，人类早就灭亡了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b974a94c02f82659506c6555b937ff550b69458eaf95b7e16382637fc22e1e3f",
      "source_sha256": "ac3f8f4d141c07f378bb1812a12aa8624d6a6831dd3d44dfca7b955d9ea30190",
      "translation": "怎么突然说起这些？"
    },
    {
      "id": "coalesced:b86cbe4ef4a35230fa477a2da73661456c3fbd47a6bf903699d6ee16d4d0c9e4",
      "source_sha256": "75b726992af393d585a96792943278205c3aa7a2d0906652e067ea0f8612c9a4",
      "translation": "如今，斯特拉斯想要守护世界，谁又胆敢阻止他？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92bfdf5f7b599aae3206d38dff0bc1e16e6bd19135183108cc3d3387076e0479",
      "source_sha256": "925357c3e8879c8d9e17b6784050c5d1893070ff035ebbe35977d109b62a4015",
      "translation": "这和斯特拉斯无关。说说你自己的想法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca46b5ae61b1ead9c6a44fa04ad4171afd3dee700c251ff7a620d8f9b5c2991d",
      "source_sha256": "0652e1b25009fb0dfc834260dbf9aad2e867de4ff64043a7d5495e8a86060084",
      "translation": "你觉得，这个世界是对的吗？一个只能靠这样的牺牲，来维持的世界？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2180e25a952f11e3e4b1b0bbec251738445fbacc965e8d4dfad42dbc345b5c23",
      "source_sha256": "9706c58f38fbe7c84339ac1109baca63926da18481030c166454e81afd9241e7",
      "translation": "兰兹海姆是乐园。我想统治的，正是这片美丽的土地。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3caf9b3e5dd1344303e3f3183836bcd44b549ccde6a71ccd537953f7a637744c",
      "source_sha256": "d4169efa95b10625e48d60528f7949b1837d8e413505a5b7342c49cd5db07f62",
      "translation": "可各位，为什么要把这座乐园，变成不毛之地？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2eabf5c764ce9ba9d6c9a2fc35b8bb6edfa11b5a1d1b33dc1bc95063c15851b9",
      "source_sha256": "90e3f476fc0f859167e00c70146d4f277fa2eaeef775bd37236c6976b8da8562",
      "translation": "这算什么乐园！"
    },
    {
      "id": "coalesced:193dc5e17a0286b8fe67bc4c05cb017c3316b09febb3181b533a38b7f7e48ccd",
      "source_sha256": "b214852a906c7e8f197b278251b548ca2e9862bd2c308e255c9dfb1d5bf80231",
      "translation": "正是因为这个地狱，才有那么多人牺牲！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dee100ecc701e0643583ecdebb18804b6a0d29831f0cfaf2cd6df455cf36c32a",
      "source_sha256": "6cf7a75f1e3755a5e2ddd5e5eb556675772995547184989eb2d46908521302d3",
      "translation": "看来，你们果然无法理解。"
    },
    {
      "id": "coalesced:c82a42f029c7e003b09519fbb3442e46c6543d8d276aeb61edb8e781906b8213",
      "source_sha256": "ab583d0de34716dd0f4de5d435ddbdd56e10d1abe1ab87017a44f238c9600dfb",
      "translation": "能理解的人，才奇怪吧！"
    },
    {
      "id": "coalesced:b77677b5af896b8c57ede7ce6f56700873773fc80746953efea5d4b2dad6bd24",
      "source_sha256": "9444314d616977225e2413274c472f187152955ac2609d4f3fab0442eaf00ac2",
      "translation": "唉……看来，最终也只能到此为止了。"
    },
    {
      "id": "coalesced:cb1592e24005d02a40c13dfd6a2b4fbbefae653c1ff96479f527a80224ee3dd2",
      "source_sha256": "b68e7fb23bb570b28ef15c399ac861b970f84ee125346903d06e0535174dcc22",
      "translation": "事情变成这样……我很遗憾。"
    },
    {
      "id": "coalesced:5833bf618ee46a26688157a8ae46a4898c6656b7b2a6fd3b4f0e1fbc417899d6",
      "source_sha256": "58feffe73473fc3dc80e514a38b9a06b672367f61accb3e1d3ad4decfd87383b",
      "translation": "要以这种方式，与公主殿下分别，我也很遗憾。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c162fec1572e0933acabd5e4b5a8ad7f786ddfdd945bb7c1febe53cf521467b9",
      "source_sha256": "4378e3c927f9bdb7ed0facb66106cf19c83c85d9500fa4983cd2adebdbe98bd6",
      "translation": "可是……我并不后悔，自己的选择……"
    },
    {
      "id": "coalesced:ecf0f6a2262e65ea15259696053382c084176171fd09cf109a3340606b67f5b1",
      "source_sha256": "3b5b0110a8cf961221ded7d17976a4dee2ced7a365d0417d496b8fd69d3eff0c",
      "translation": "因为，我……想成为王。"
    },
    {
      "id": "coalesced:5f079214cb68fde65d71b9984d01a6aa467bfe275dd4f1bd47cdc407527cd79a",
      "source_sha256": "9b98ca7f430ef51caf45b449c4f26cb4f25ad0d648a0e8a9b5a297681a1ff279",
      "translation": "真坦率……一点都不像你。"
    },
    {
      "id": "coalesced:75ba53dfecb7c5f1ca661546ad364d87d82a536e05593db104494e2d837bbc22",
      "source_sha256": "e23fc9122524656dba7aef13f6938a612ee4fcd8f257926e5fe5833959c0048d",
      "translation": "也许，是因为……该离开了吧……呵。"
    },
    {
      "id": "coalesced:0884ed19884ff8c9f8ec311dc9e9b14f770ea95c4532ec719ba69307c2730f35",
      "source_sha256": "de37c6ce9d6bb21cee448097ee41e643ee8da68b028c4cf3590bb15f8fd4e723",
      "translation": "……得知……他，修恩扎伊特，竟然连灾祸种都能操纵时，我也很吃惊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:915a09041d1f133c67c7363d47c5141fb341c3012d6339caad66d8189bfa1aeb",
      "source_sha256": "55aaa71d1404c893efec42a65bf1345f6e4b7e11f746fb0e7891c820a6f6a90a",
      "translation": "总觉得……像是做了一场虚幻的梦。我或许，是被他创造的世界……迷住了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69ab3fb43ac1c3b3a5108f8060085746d1f4d35ccb50d15c1eb5980dd53dac8d",
      "source_sha256": "a516aa7810e564081476882d2ed5938ad7acbc74cfa327b5f63052f2ae22c3ef",
      "translation": "亚历克斯……"
    },
    {
      "id": "coalesced:7eb3ec101029376c2e512ca58d1534ee3b0f79b04016b69b0b41bd7113cbb64e",
      "source_sha256": "17ce8139e86be4ed29b0d8143c2245a630cc38910932554e2b1f930f5918e81d",
      "translation": "公主殿下……我并不后悔利用您……但也确实，觉得对不起您。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a2405316a1f9f70fdefa3bc098a135b1e0328c3ddfb120ebeae42df694256823",
      "source_sha256": "492825d780a97bbc64c25a595c9321b57dbd57f7c262604dc3f23106bfef7b5a",
      "translation": "事到如今，再说这些，又能改变什么？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:972fc96ad08d7e64deae5be7e4b25b6d33e88fb8276cac481ae4c227ba9ce209",
      "source_sha256": "152db46a01968c535ecdfead245b68da8d3451675400f4bbb2d901273342b33d",
      "translation": "是啊。就算，说出这样的话……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:175fc8c14f2221ce8d867810db5038eb7095b81ed8ae7fd4324834dbbb356f77",
      "source_sha256": "3ac44e68202d998318c8d9aaa6fe20420f9e6a87698557d8b2df30a18c47f2b3",
      "translation": "也都毫无意义了吧……"
    },
    {
      "id": "coalesced:7a971ac4779f44a6952056cfc52803537986d1576cdedb24927878c614f52ceb",
      "source_sha256": "c73a18d4a4f46c0ee5ec64f4cf587ee608d494c3d108ac6965e01d53c691b0e5",
      "translation": "亚历克斯……不管目的是什么，你确实曾助我一臂之力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:470e2f03f53d98c0fd0b9f91a0012142e9721dfb0c2af080ef70f6a9d18b80d8",
      "source_sha256": "4d6b473829fd8579b638bb17dd9e1b88c583f300014402fb13266d70737ba13d",
      "translation": "唯独这件事……我是真心感谢你的。"
    },
    {
      "id": "coalesced:0489220192a10262cc917b30510d723e72ee3fbd52c6fbc7c4686eeb585f70d6",
      "source_sha256": "dfd2dd6510c8fe775d43c0cccf476b958ebd7995daa0f1fb31489b0825646574",
      "translation": "呵呵呵……没想到，在最后……还能听到您这样说……"
    },
    {
      "id": "coalesced:a69bb66fc52e450238aa91726d3885aa33a6f48ee0a79fa5a9c3cc7c050518cc",
      "source_sha256": "f4715dc35349f919b78ca49babd26e0d2579a8268615b11abebe81a00787b25b",
      "translation": "叛徒们！"
    },
    {
      "id": "coalesced:e5914d478080920e9aff77d620af1cc17d7d4d3c6b6957346e04ceb1cb4aae25",
      "source_sha256": "a45398b3f86ac335efb9aca065dc395b0c5e88cc5dccbe819a6fbbaa6cab3943",
      "translation": "站住！\\n公主必须被处决！"
    },
    {
      "id": "coalesced:2e8234b76f3674ba46ebd2a9a91db90c16c46b0c6fd6843150e812383d12c944",
      "source_sha256": "35ffb0d215a0fbcfd26733a0e212872a5d1d22ae44fa7718066ba267d7c1b168",
      "translation": "公主为了自己活命，\\n就要抛弃我们吗！"
    },
    {
      "id": "coalesced:3e5bd97d74925bf96d2bac0a9907c6061bf55f3cedfd0424849feccb3d9fe65a",
      "source_sha256": "eadaff065521a8ae1ff5158840ddc92a4a9eb201ff94bd77bf216296d29199da",
      "translation": "处决叛徒！"
    }
  ]
}
