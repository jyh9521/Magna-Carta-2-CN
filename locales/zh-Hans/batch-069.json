{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:5f17d9901696ababc404f76a5f5bbf11cb4a360ad474cd4567941889e2f2232b",
      "source_sha256": "d05d6e6417312afec9c0dc16a1302553bd54c41fa0d62211c7485f2881d092ca",
      "translation": "我一直在等您再次前来。"
    },
    {
      "id": "coalesced:fc5285a39e07d3886acd218cb7016467352e98c373c434c2c549c9d036f7720e",
      "source_sha256": "a7081089209c626e60df23b65626d823560c934a0bd6858314c87d844338a52c",
      "translation": "上次那个盗贼，这回又托我带句话。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73926ffea2a233054d4ede2f5685d2ad6743f50604ca8dd843e6594c2076d5bd",
      "source_sha256": "5a4dbfb2eae8243f6c064b4936199d05e86847208d679a46245c6f4a0c3aa023",
      "translation": "他说，[我会在雷恩波尔特废墟等着]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:03bb083dc089bec4437f002ebe9e955290f1da6df46512f68c74af8a202bc12e",
      "source_sha256": "16a4ae9286676ce0cae6730792fee9669fe24dd3ddf3068a85319dc4f1af6a53",
      "translation": "这次，又会是什么事呢……"
    },
    {
      "id": "coalesced:cc79973fb01fe8d0d426b370b0083063428338cf37b4ab38280e4eb0ecd1df13",
      "source_sha256": "3f6e1a60898ee455666353656e22e66d9eab3463d451fee691a2b199963fe1e2",
      "translation": "请务必小心。"
    },
    {
      "id": "coalesced:a7b4497fe9045b36fd3c73fd119fac3ccc35dea227c7f9e224e7257b9208d440",
      "source_sha256": "971527333103a092b9ec80e5831cb03399b4d38e7846ee0acefd3a0342a52ebd",
      "translation": "您想得很周到。那种家伙，还是不予理会最好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5995150ada523ac749c5ffa4726f55a42822e2392e89179b85ead216fcae8911",
      "source_sha256": "e4c0c9b8428c4fc04f29f100c6a56d578c3d3a67339efe5c45bee77d8cf7bb6b",
      "translation": "那个盗贼说，会在雷恩波尔特废墟等您，说完便走了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7ddaab4aa5071f73899227d6be3dda93a23eafef30beed0e1a0d3ee4909e5691",
      "source_sha256": "0dba126a8d943acde28e7d85f066ab0c04069d6b99460fa9d6086be12eff82e2",
      "translation": "请前往[雷恩波尔特废墟]与盗贼见面"
    },
    {
      "id": "coalesced:a96241f17d9eae5655c31e43c2456da4822ac46060746f545c9eb70af1b7392c",
      "source_sha256": "780e9170216b0d0f31ecee1f90051ea952a69a13c9aa2d3986ae15b267de11eb",
      "translation": "束缚的尽头"
    },
    {
      "id": "coalesced:6022ef817c10388ee47b5e450663452b282e9a843ca89e4b811e23d03f1449fa",
      "source_sha256": "4da2ab57e55efe43d1880ff715bf5beed21e7ee0f76583cedb0e42c410139eb2",
      "translation": "嘻嘻呵～您来了啊。"
    },
    {
      "id": "coalesced:510a7abb902a61fe6ac6505baf51b1749430e6d8ee9895aa3430f5f41898d48b",
      "source_sha256": "8e41ae7cfed2f7912c23425f9ff9162692c00415680e9a007ae398e8a65b84f5",
      "translation": "你是……？？"
    },
    {
      "id": "coalesced:df138da90cbbb6a5011d256345b867c26e270d253058ab63e8406c2beae7c0c6",
      "source_sha256": "02a420bc42a039d2d71587bfa50ec52a90870b7117b6bcab8a5201f9eb576b9b",
      "translation": "咦！我通过库布寄了信，看来您还没看。或者，是忘记了？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52b1808a7f354c00460e8ecdb704438a0345186e0a859d26267dfff3c5b66150",
      "source_sha256": "d5aa2e54784fda1d8a439004cf0baba7a74bfe3874f02b9988090a27d4ace82e",
      "translation": "哈哈，不过没关系。那不是重点。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9102beb3dada3c3b899f2b4e0ae8e579127e788a59eb68bdcfac813bf92f0b7d",
      "source_sha256": "3e681306877e9615f6bec14943f566b4eee7b4b776c0595ed11323f0ca3431d2",
      "translation": "这次，我有一笔能赚大钱的生意，可单凭我的力量，实在办不到，所以一直在找人帮忙。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:89c0e2982a4be51ef45bf900c35c98b58ce3c750d0cbc4144d7f3c6e345b438a",
      "source_sha256": "3a6fd080aceacbc239a43d1a3af6b1e1a94a8b1ae0bdd6d141b08ac9c361fc00",
      "translation": "后来，我的亲戚伊格顿说，各位打倒了海底洞窟的佐帕，我就联系了各位。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2050d48f2ac9dc7de74dd155927f54f87dbaf45bfefd9a95df526151c2f23594",
      "source_sha256": "1e0b54be70a4c1034d73f813ccaad9a809f344c9bd189d8f5d812a8e6eb20780",
      "translation": "这笔大生意，不是别的，就是狩猎怪物。当然，不是普通的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aac5cdc213958832ab41ed77ba056085a77909f4cdc8a18956396c54b1b4d602",
      "source_sha256": "0618810967773a088233384e31998178987571e4e7951bf83ab88987ddf71f54",
      "translation": "那是一种名叫[因费尔诺]的巨型怪物。只要抓到它，就能赚到相当可观的一笔钱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c5a7948d88d7be45b2c053a204561d2e9cd0c70ba3911f179ff26ae2ce26927d",
      "source_sha256": "a0cbac5610aa3c6e298f4deb671f0fefdc02f9485fc9567c1ad219707e019e41",
      "translation": "把因费尔诺的皮、爪子、骨头等加工后，就能制成售价高昂的高级物品。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c0ac14253687b196e880658a9d8b3dee7eca9fd7ab398101e4977911c712f46",
      "source_sha256": "0b467ccb43053d34e4a3872e8d1a6a6ff9eefbe9dc611f86cee7ff14fcc5fadf",
      "translation": "关于那家伙的详情，请问问旁边的[迈耶]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:67a1dae92cfee773d246d00bed158e17b160b6b340b4a4698dc15f7e5733b886",
      "source_sha256": "1322c6480e240ba2aef61e9835f5b43235ba1570ef7d215fa1b725f58dd36124",
      "translation": "迈耶是位猎人，还曾经与因费尔诺交过手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b8e78729dec464837f6217d83a707582027006785e991e76fdd251a24171cd9c",
      "source_sha256": "942af42c757af4821280d27194d7b468ef5feed4bac27f5fd5c39b6719fba0f6",
      "translation": "只要肯帮这一次，我一定会重重酬谢。请再考虑一下吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8ece0a4250e48d857671be0abd15b141704a16c12efc841e4f6e0117b8d9def",
      "source_sha256": "cc2e606da164caf92f60b1c93d916338941556892020ec34786b02fe9054a3b1",
      "translation": "关于那家伙的详情，请问问旁边的迈耶。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:234d47d8432364b19418e58ea63ea78e8d1d1909d46e8888d93ee7188d9fb707",
      "source_sha256": "4be24ec38255947871c7d33af22b4934e72fb88cb9fccadcf28125d5372fef6f",
      "translation": "您就是霍格顿一直在找的人啊。我旁边这位，就是霍格顿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e7c66920ea6055b839ce2742c720d823194001f2e3be099aec8f63cd6313297a",
      "source_sha256": "adbd86110659b9de50d769906ad6e2daf08ca5f75d9404ae68a85e7ebf5227c0",
      "translation": "霍格顿提议，通过狩猎因费尔诺赚上一笔。\\n有关因费尔诺的详情，请向[迈耶]询问。"
    },
    {
      "id": "coalesced:ac3eb30c778b07b7d286ae93b86a42916bb085858c33b5400ef5838f0d0c74a5",
      "source_sha256": "6db91a51985c45e63a482d9144d240eb51524bcbfca4121d6ff87d7d1e05b32d",
      "translation": "因费尔诺"
    },
    {
      "id": "coalesced:c8019a0748f4c4d0045fbae82a248351b1fdb3ef6d4259f982693a843d9d9873",
      "source_sha256": "c7de194c2e3ff9039c1f26f518ddc14a0c765fd53a9ac07921cc74b1964b7075",
      "translation": "因费尔诺是个非常强大的家伙。即使是经验老到的猎人，也几乎不可能抓到它。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8af56818d00f6263a6a277122dec5cd980c5524cea2852e34df0a48aa14e83e5",
      "source_sha256": "5839c10805588b72ce1a4fc5fbf6ec659df6a755564abbbc43068f120fff0723",
      "translation": "过去100年里，因费尔诺只被捕获过两次。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbf9d2d41362d93ee2299fa91269c67f854984812d7ed0d9cacfea30ad074b00",
      "source_sha256": "634c5592987efc631e7a885aeeb472feb01fcc2706fc294101acbe3f1a211183",
      "translation": "过去，我所属的猎人公会，也曾组建因费尔诺狩猎队，却以失败告终，最后连公会都解散了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c334906f9b58ae4c870466f4518a828a7364cabb41ed8f26e52f3a75c2dc25b7",
      "source_sha256": "c7c3bf50832a0d4c122edca8fc9be3f79d966e9d1823032b091c77936333e84a",
      "translation": "不过，用因费尔诺的骨头和皮制成的武器、防具，实在太珍贵，所以仍不断有人前去狩猎。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:00e90a487c6e3f7d6dd303db6a047ba174711c9bb3da0958b62e2c0aead17199",
      "source_sha256": "30ab88a7d4fd5078ac99aaa445f78c604bbe9e3f13affadc3043682273a3fe33",
      "translation": "我在霍格顿的资助下，一直寻找因费尔诺。不久前，终于在这座峡谷，找到了它的踪迹。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6bad228c9a33c79647ca2d718e76deda1650378829c65494191429ecc4226733",
      "source_sha256": "0dbf8f745ea03a84f1519d201b7e82d5147af00ff08f8b2e5adca323543d8318",
      "translation": "首先，要抓住因费尔诺，就得把它从藏身处引出来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c4b7b158bbbbe93beedd99f58965cef26c81736f97672b739728fccb1a60e02",
      "source_sha256": "07c8d74a688e721857b5b9cfe4f48c6f9002f53562dbc9d178d2286ba5dcedfa",
      "translation": "毕竟，闯进它的巢穴，不是个好办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:496ddcf71b4f6fef3b7ec5a7a8fbe6dc434eb085523a7dc47616586667329390",
      "source_sha256": "dd992c8a69345012ed67f632617a64df827f5bbff2889446e6c6cad3a34a5bde",
      "translation": "那家伙非常狡猾，不容易引出来。不过，长期追踪因费尔诺的猎人们，想出了一个办法。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59ddeeafbe419afbdbc1a09f0d94b67106db3dd9905b29b2934d441b2826d8e8",
      "source_sha256": "77e657aef79104c88e3cf24cceaae4ca3cbc5245b42188011634695878e2de3c",
      "translation": "那就是，利用因费尔诺的幼崽[布雷兹]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:abf4b76c7356f2bb1aa4c25df6c5ec9da03407240810b23eb73aa7a9cfb4e05e",
      "source_sha256": "3df3cf239ca27604b0c65ae3c30a28c873d24d11d1fbdee9ecc37a4369f2b5fd",
      "translation": "布雷兹也是危险的怪物，但还没有因费尔诺那么危险。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:12b714c97fffe592ae5e051a46c82839e24f47546009b34efb10c29885e99b94",
      "source_sha256": "1bdf081da09d0454cdae145cc319f2066b019a29c173a08a404b6ab8f3d39283",
      "translation": "听说，北部军还会训练布雷兹，把它们投入战争。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ae2c9ddb2d412345688ba047a7b5332c84dc2995733dc59e6d8330c11110519",
      "source_sha256": "71acbb6240240fd171b7155423da473b6809f1a0d02af303a52093152250dcf1",
      "translation": "只要拿来布雷兹之尾，我就能做出引它出来的诱饵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ba31541b90ddf7f04dcd4328c9859619c93beaa327dcbce4abb969a99819a96",
      "source_sha256": "d3270c1876c98a436490651bb17216ec342c6ced24234a158afcbffeb98c8c96",
      "translation": "请找来4条布雷兹之尾。"
    },
    {
      "id": "coalesced:ba76cb72c1b76e92aac98d28c53b51ff9efb95ebdb1e7253d88cedbc778d25f3",
      "source_sha256": "5f69b7998fac490b43819ed22d2f76d5799b9810afce77abce31629d05693410",
      "translation": "这样，我就能用那些尾巴，做出引诱因费尔诺的诱饵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5ec296ba0a47491381a3267fddd8140655d6adb7ee6cb161a96a2045cd0a76a",
      "source_sha256": "19444611d1ef8b04f3db50d433f294a5a8db7e9ed08b8c0591e35dcf01b444ae",
      "translation": "布雷兹就在老狐峡谷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d80ab87da153bbac715228ef791dbf0e1d09dfbf2ee57f16499e7e016159a61d",
      "source_sha256": "06ece0e6ed2f8a1a2fc4558a2cf5d9daa4898deea9aa946f55226e20083418a8",
      "translation": "这可是个好机会，请再考虑一下吧。"
    },
    {
      "id": "coalesced:6963408a7b5fde0c7762baf15866c87b7f97c07428df9cac4e9eff969ee31361",
      "source_sha256": "e7d57af4540702e7cb502922f10cb43102427cf41437b4561eed16e29b1eb6f9",
      "translation": "布雷兹遍布老狐峡谷各处。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e1616a35b77a66c6d2b47b860081bb1a77f44d73cef03c6b313b58c3a3f559a4",
      "source_sha256": "0592e30da85287c5d60cfc2af0e59bea7bdd81d669145a0bd4810db6c4549783",
      "translation": "关于因费尔诺，请向迈耶询问。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1d0803812655249b6f00193f610f24239e2dc38fbdb00a385b16e72f85d648d2",
      "source_sha256": "e7de0acbce95ef4edd3515550271c9da56ccfa012a312d4c30c2dbd034821327",
      "translation": "请稍等一下。马上就能准备好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c93692afb113926c7779d7c71d4e3b7536b024857e2c1c2270304d27a79e3f7",
      "source_sha256": "8e5133fa28eba27fd033f07203de6959806216b0b3e9e158d3f5a80894494471",
      "translation": "好了，诱饵已经准备好了。"
    },
    {
      "id": "coalesced:4f39a9626e4b92eb1aaeed32f2114bc9aee55c15c0716724e3945e1abfbc7cec",
      "source_sha256": "663d4149cd5c500721c1fdcc4bed8753ef5c89055391d375c7b4cdf5a7429fa2",
      "translation": "需要制作引诱因费尔诺的诱饵。\\n请收集4条[布雷兹之尾]，交给迈耶。"
    },
    {
      "id": "coalesced:9135a5a52a153cf876c00f678a6fc440b86c852f2cb6af40fe94fb6cb4c0d356",
      "source_sha256": "bc75f1bff75c53e4735e648040499a9d2b5fef745f33d663b2da2138da362232",
      "translation": "QUEST%s: 获得布雷兹之尾 (%s / %s)"
    },
    {
      "id": "coalesced:2f94e442a054e2bdacb0a7134e144a143b3dcca4e4dcbefd21647a4b7d6a93ae",
      "source_sha256": "6efe42f2a47b7c44ea76175baf6ea8fdf840ab813cc8fe00445a24d58a896bdf",
      "translation": "狩猎诱饵"
    },
    {
      "id": "coalesced:98cf3fd8c0d9e1ade08fea09ac9a380fba3f048ecdc00dc4f1f48aa07a5e9cd3",
      "source_sha256": "5b16e03a781484f2a65c1106a9e4d44eb56305cc164b788164077aa18e536c5f",
      "translation": "布雷兹之尾"
    },
    {
      "id": "coalesced:0827d50d5cc908e0b7182df8b74974f21bd0a03275985510b6fc0b4f6c1a3fe1",
      "source_sha256": "19c90fcd7522c3d42541e35f7db133fe63f039689799e8934972e2523e2cbe1e",
      "translation": "这是混入布雷兹之尾，制成的烟雾弹。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce778f12d16571d5c19c4bf91dd580a55a74bf74b53c420db5b100846d34573c",
      "source_sha256": "75074ebf7a165d9f2671cfd256f76e31a7f22a9e122689c16360048e6dd04a0f",
      "translation": "引爆后，因费尔诺闻到气味，就会现身。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6adf28182bd16f76a1b71acfeab5a723a3d954b8a673543750ecfa176f4457a5",
      "source_sha256": "4911995a0afb4c7c3190a52204bc22e3b98e419377a6332c2eb30f361e5b9233",
      "translation": "沿路一直走，就会到一片宽阔的空地。请在那里对付因费尔诺。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cef5d106f02086517e61a268d8fae32a0bb7c485bcbc6a0f996389b191e48cd6",
      "source_sha256": "3edb73b6b4631ac298af06b5f73624c1475395776f3b55fda6295b21c997f7db",
      "translation": "我只会碍手碍脚，就在这里等候吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5b9d521335faded7001a053c0c152f375a3c747d41903088c3f6e334424a848c",
      "source_sha256": "da393875aa40636fec3e893760c2fa72bc19f7fc6b073a4971eb78caa1d49fc4",
      "translation": "不知道那家伙什么时候，会转移到别处，得抓紧时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f92ada9794693e4d6fbed4c7e750981927589aef36bce2014b83953b38456b28",
      "source_sha256": "cf1f1ea189709a4c268bb0727fd40c05d2de92d15bad0280cff86c2f318073a2",
      "translation": "请一定要打倒因费尔诺～"
    },
    {
      "id": "coalesced:93d00e7f9ce4673306452f4c41fca9ec3dc84846a0451c31179d5be11877114a",
      "source_sha256": "d68ebfd75b18ae351d4b0c9750eba33b58b42f550b1d02f9f10cfc839afc1bdd",
      "translation": "成功了啊。请去找霍格顿吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a0f3775308f7072d43e775352f4502df51d995d163a07392e90dbde5a86942d",
      "source_sha256": "a99aed991b749c5bcba92b9718be7ce96f371c0be2bc30c770f9a57dbbf324e7",
      "translation": "啊，真了不起。多亏各位，我能赚上一大笔钱了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce3f066918be420a7b5524913213de5f315243e50c0fd63b47ccb0dd4d14712a",
      "source_sha256": "f31cb625c9a313ae0c181081d40130c8c7fa1ac5bf49dcebbfc7cdfb2c210a79",
      "translation": "这是我原本收藏的东西，相当珍贵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ef49aa580a37278a75662c87bc1293fd0c5e11415c2cca9c506e7b3fd75b3889",
      "source_sha256": "06fde3eb4cb7c56bac11284e5d8343e1ee17349142c801391534f906a4ba06e6",
      "translation": "QUEST : 讨伐因费尔诺"
    },
    {
      "id": "coalesced:ab1a5f516c8679ce055af066e3ef7f59d247be47ed73c6d3be95702508df102c",
      "source_sha256": "a1a59e59402df6ad7fbee75d50e596a11010ec954a82e597df0d14f00017dcce",
      "translation": "在迈耶指定的地点，引爆[反费尔诺弹]，\\n因费尔诺便会现身。\\n请讨伐因费尔诺。"
    },
    {
      "id": "coalesced:2a5244f9e7229bd4e6f13a967b6af5efb85b0eec6c5c95d18fc2bc6b897bff05",
      "source_sha256": "dc036b97c77ab6fd9a485b8448b67f9f55efd242cc75bc2d0722ae37131342a4",
      "translation": "讨伐因费尔诺"
    },
    {
      "id": "coalesced:d29fedd0c9f1892ca2f02273dc724e66d7691cfc3fc44c7cdc4d8a3e506851dc",
      "source_sha256": "dc036b97c77ab6fd9a485b8448b67f9f55efd242cc75bc2d0722ae37131342a4",
      "translation": "讨伐因费尔诺"
    },
    {
      "id": "coalesced:d87c00f3335e0e0a639fee634986b49afa3012ecd8db2ed30881bc8b2fe08099",
      "source_sha256": "8bbba01b16f8efc00e533e18cc3656f1cecf436cfb45af798f0739d180517438",
      "translation": "霍格顿"
    },
    {
      "id": "coalesced:d4e4273db316f6dece1561d9b1a15006a78b4ad8796d80ca6e7f5da583136da6",
      "source_sha256": "5aee105605969b6e83bc51f66e5a60619ff80f3d2614c6e056dce1cf522ef291",
      "translation": "迈耶"
    },
    {
      "id": "coalesced:ee5ddb78c45c7e8a7bdbe7edca1c783e1ba12fcf391345f1190831655269a669",
      "source_sha256": "5b16e03a781484f2a65c1106a9e4d44eb56305cc164b788164077aa18e536c5f",
      "translation": "布雷兹之尾"
    },
    {
      "id": "coalesced:e3fd59a7df50c17179bf201bc5399440feaf615db4d2eaf2825856765b413ef1",
      "source_sha256": "c4dcb0371232b73491d82cf9e17d447294ac831f35111875501e74a9ec1a3073",
      "translation": "用于制作因费尔诺诱饵的材料"
    },
    {
      "id": "coalesced:e1dc880486fc88dad9ac95ec58439e197ff154dc2ec275832a96b2e98caad5c7",
      "source_sha256": "75c6727c7c7047509550d23c94a764e5995194da204e60068ec6ba1e5b61fb1d",
      "translation": "反费尔诺弹 "
    },
    {
      "id": "coalesced:e291059e8192bc89e80b071930863bd26f7d03cf9b022d270583cd220f6de283",
      "source_sha256": "94609eff8ac940036b41fe23a3038073686e3d1fc11692c78672a7e35a68abdb",
      "translation": "混入布雷兹之尾加工而成的烟雾弹"
    },
    {
      "id": "coalesced:3840ec8fed7b083d77e19f4f79694b663f343630df754c0133ac39cf35b1ce7e",
      "source_sha256": "c168b2a07ae8277337edbcfed860333b327b98381478d757d36c4cf107e4c04f",
      "translation": "致击败佐帕的各位"
    },
    {
      "id": "coalesced:97b1798fcbcd2f43f5b8ddc04ad75ccd98c77d7775b9b8a8836646d9511b47ed",
      "source_sha256": "28c2cb7596cb2a0dd01245fc4907f5e4a470b9329fe89ede5b4259e90284f90d",
      "translation": "各位好。我叫[霍格顿]。\\n各位熟悉的伊格顿，是我的亲戚。\\n\\n我从伊格顿那里，听说各位已经打倒了\\n据说出没于海底洞窟的佐帕。\\n我有一笔大生意，可单凭我的力量，很难办成，\\n所以一直在找人帮忙。 \\n若各位有空，请来找我吧！ \\n\\n我会在老狐峡谷的阿维斯运输队旁边等候。"
    },
    {
      "id": "coalesced:a673259d26f23a7eeab6de214f940cfcdab50ed25d021819b3387b0d8959e53d",
      "source_sha256": "950badd279e8b2898efcfe896e9d1b7d84a3a000c11be40afb8f2ebf33d5b1d1",
      "translation": "拉·斯特拉达的宝箱"
    },
    {
      "id": "coalesced:05dd661f0ced6e6efa4d72bc9255e5e47f54edc8c950d32614256e0a900cbaef",
      "source_sha256": "09022a400a6687a145599192047b1c08328d9055e29161a14532e2d0517101bb",
      "translation": "啊，我曾在某处偶然看到过。\\n听说在拉·斯特拉达，要通过试炼，\\n才能前往下一个地方。\\n其中，好像有一场试炼，要保护继承卡尔塔血脉的人。\\n\\n不过，听说那个试炼场所的宝箱，\\n只有在接受试炼时，才会出现。\\n据说，那些宝箱里有不少贵重的东西。\\n不知能不能帮上忙呢～？"
    },
    {
      "id": "coalesced:824294a071a22ad98305df231b4de81da67a834ed91432ab98fdb93cea99bbf5",
      "source_sha256": "eebe940e6071e713b4fc23e115c6da1547840da7e863a8b317a647c68bd2d54c",
      "translation": "新增目的地"
    },
    {
      "id": "coalesced:df3b6692458b1a100e94d55580a4a72e1212b560eb0c0371c471bf7fa5568fb4",
      "source_sha256": "9e7a0af867437e3fd248679dc9b3ee9ea1f5d991eadbcc7bc0666858623763d5",
      "translation": "各位好，这里是阿维斯运输队。\\n这次来信，是为了通知新开通的目的地。\\n我们开始提供前往星光平原、贝尔福特与贝尔福特王城地区的服务。\\n阿维斯运输队会继续努力，\\n为各位提供更多服务。"
    }
  ]
}
