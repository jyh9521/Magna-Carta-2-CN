  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:1139969c1b4b55f2b947cedcf3b057d621cb6385630991423eb44eefddc70ceb",
      "source_sha256": "36144fdc90c24171218f1ebd265048509f30a1096267f19aa44faa5d2ea8bb5a",
      "translation": "贝卡斯"
    },
    {
      "id": "coalesced:9a117a0a990b795bb88d7e82b54547ddf33a06f5c44992e9ca3675c4e77d4cb6",
      "source_sha256": "0e28dba88e9b4743ecdddf63dcb83c5e7dd22b2360c9a944153ecbaebf04175d",
      "translation": "守卫第2哨所的贝卡斯\\n身怀剧毒，稍有不慎便容易陷入中毒状态。\\n\\n请备足解毒剂，再投入战斗。\\n祝反哨兵部队武运昌隆。"
    },
    {
      "id": "coalesced:13602819568bcd4ca21f522191956af518ca6def66febf2f15188a9575fd3bd5",
      "source_sha256": "76219d4e59ab0dc3a81783a3b8fe1df750a23499cb70e5bbde236528767eeecc",
      "translation": "利维坦"
    },
    {
      "id": "coalesced:85799044137a58feef006977ff0cba3d0a6d22f39b04c4c9fbbd442bd405d57c",
      "source_sha256": "994f3bbbe73da2d8f7e03c25abdbb1de3889b0c8e7a0fce340cb87ace4b94b82",
      "translation": "利维坦附近应该有3根柱子。\\n\\n利维坦会进行2阶段变身，体力耗尽时\\n便会逐一激活柱子。\\n各根柱子分别具有攻击、使我方中毒和恢复HP的功能，\\n悬浮在柱子上的眼睛会监视战况，\\n控制各根柱子。\\n\\n若想让战斗更加顺利，请摧毁柱子。"
    },
    {
      "id": "coalesced:321587e155840884def94dcca68869feb3b64c22340d8c5f1148ed43d8305443",
      "source_sha256": "7b5471f24672a57684e4eaa1aee82c4a2cf4c8d4c60c3c951452b6bdd7cf3d0c",
      "translation": "杜南丘陵的炸弹箱"
    },
    {
      "id": "coalesced:ead0aa56099fd4be04e94b64cd875f7c5439a01a2ddd57a6d794a83dff1114f3",
      "source_sha256": "acdbc67befd0ac471f75854f825296b4982ddfb45ecbc12ed1b8d71076b1c07e",
      "translation": "杜南丘陵有许多北部军为与南部军交战而储备的\\n炸弹箱。\\n杜南丘陵作战成功后，南部军虽会回收炸弹箱，\\n但点燃炸弹箱，将其引爆清除，\\n也是一种办法。\\n\\n克罗塞尔靠近炸弹箱并将其点燃后，几秒钟后\\n炸弹箱就会爆炸，对周围造成伤害。\\n请预判北部军接近的时机，将其引爆。"
    },
    {
      "id": "coalesced:9bb6f6c74d4732b35d228de8c2b5d8363a8dbd2f0a9ab5c800233aa5d27b45b4",
      "source_sha256": "d51d8ee20f5c499a2e5f4412683f65572e6dfdcda705fdf5ebae8e9cb37c7e73",
      "translation": "泽格隆"
    },
    {
      "id": "coalesced:7955cad990ae8de5cf520c6f5f4cdc4fe9b4a41408cce9fc808bb21f747daa39",
      "source_sha256": "32047d054fb0f5557a348bb23ff0228c99fab622218f6768239680fd07b756ea",
      "translation": "泽格隆身边有使用火焰的连环术师。\\n他们会点燃地面，并使人陷入烧伤状态。\\n\\n地面燃起火焰，产生[地面效果]后，就更容易陷入火属性的\\n异常状态。\\n尤其陷入[烧伤]状态后，会持续受到伤害，\\n还请多加小心。\\n祝武运昌隆。　"
    },
    {
      "id": "coalesced:39744e67b6c6352b57736ee61f4367cfebc1400db892fcbfb5600a8fc17ef50d",
      "source_sha256": "74f47689700f617458cd1ad43dfe6ad3e2a8771522d11c178b295740535644aa",
      "translation": "充分准备"
    },
    {
      "id": "coalesced:da8defc0eff08643920170cd27bb3aab1450e3e506aecce7605e4fc62b340e53",
      "source_sha256": "82b147c4bd6dc551cb474b9b76965bc6ddef233066bcea8ff8975d5eb2392457",
      "translation": "据说本次进攻目标杜南丘陵已部署了大量\\n北部军。\\n\\n其中还部署了许多连环术师，\\n预计会是一场苦战，必须做好充分准备。\\n除了恢复道具，还会需要能解除异常状态的道具，\\n请务必备足。\\n一切准备就绪后，请到总司令部来。"
    },
    {
      "id": "coalesced:dd6ed791401602fecc4d0744ef8c5abbf2e80cc6bbe678857d1d846e197166eb",
      "source_sha256": "594d07fed6036b89f8f3a7e072eeb50ec72a330c918c55a18a035a5db2e0f9ab",
      "translation": "请摧毁北部军哨所"
    },
    {
      "id": "coalesced:8493644dfe4e48aef58b4996233ee1f95d65dd78329be483203af2599e23f07b",
      "source_sha256": "653b8f60e4df66126427aad997d443030ae1406aa427464f7c71eb3b2bf7786f",
      "translation": "在阿巴泽特附近发现了北部军哨所，这意味着"
    },
    {
      "id": "coalesced:e134d6cb2919b26d2dd7a74c427695b68faae1b4ee5af2beac71f6cb3533b9b7",
      "source_sha256": "d51d8ee20f5c499a2e5f4412683f65572e6dfdcda705fdf5ebae8e9cb37c7e73",
      "translation": "泽格隆"
    }
  ]
}
