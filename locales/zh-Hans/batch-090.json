{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:49d654601c1b5c94b7430c0828956dba3fc39971d7026968d7c6e074aa5bb9e0",
      "source_sha256": "e23eab1119e7e60a705a8c39c3f1f43e0cabec4456e915e8e714e4efdc316017",
      "translation": "不好了，公主殿下！"
    },
    {
      "id": "coalesced:37020f960923c6f88be5fc125888e39b1a9d5e17d3342ecdb75a95c1fb5aadbe",
      "source_sha256": "b5f890d5736f929dc77e649a3b4a9bf40907d9c1fed1c28ae332c29b62c7cf47",
      "translation": "攻占这里时受伤的士兵，比预想的还要多。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cc659db1ae9454440dbba2c3cb7aede0bb16dcd13dace97f8a3d54716dd6a5a3",
      "source_sha256": "b6e048f47dfd219b323813b1aed1ca19010e1b22da2e84eb1740a9d3dbca9cdc",
      "translation": "目前，手头的救援物资不足。虽然，已经向阿巴泽特请求支援，",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69e574b7a83f7a0bfaff50fbd6e4e17e4be6899dd21a3707847c16418ffe97f9",
      "source_sha256": "7ad4e8be4f4b29882b2fd22ef444c36b624e313c0ceb57f717b12582928d02c9",
      "translation": "可伤兵们，恐怕撑不到物资送来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:90fbf413d8ea436b986da42cf4580fdbff67cdcb8f167177855b04299e261811",
      "source_sha256": "0d9151af532914e6030d7c5f0ae30e56c387a1ff7eadaa7da23017da961e4158",
      "translation": "失血太严重，用连环术治疗，也只能争取一些时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a42010f40bac50fe1be8e11bab906caefa1d0e7f1f4b60994221fe52befed11",
      "source_sha256": "7bc9770ebbb2c475b49523e6f6dae768c02af5c61112eceff5317f6d4f73bebb",
      "translation": "可是，即使如此，也得靠它，撑到救援物资抵达。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5d30382675c77fee866d0615c60482bbbbff37ddc9101de31336c3d4759fc769",
      "source_sha256": "19d71d4ec5e1e9fb09e7a73ea16bd888d7c764e036ff76c08a0a7c359294cd05",
      "translation": "能否请公主殿下，运用连环术，为我们争取时间？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ea2472e514df512eb482d857d411fa26ea2dd457f38e274321296558724e618",
      "source_sha256": "3b0c38f1eeafee30a6551b6b14f4c4813c43ac38b1a40f7489d1caebe6339ac4",
      "translation": "请在救援物资抵达前，全力保住所有士兵的性命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:69dd67a62f4bcf3481cb8626fe332821d168de6389b75f138be93f727c446a85",
      "source_sha256": "9d298d3dded2cf7418eedc49a611e47030162011e8b146842ab470d62d50940f",
      "translation": "呃……难道，士兵们的死活，都无所谓吗！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b394547708d67ba50c21a523944cd876a5e4ab0b888f9d9ffe45f5ef2ee85292",
      "source_sha256": "14af97c4c2d0eaff8f8cd803008147e3bab31c29dca72c02ec1d1d6c57b2ab5a",
      "translation": "辛苦您了。多亏有您，才能将兵力损失，降到最低。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9547c7aaf522b4aabe67419930b9258678067cfd323b2299faaeff9d27f49917",
      "source_sha256": "e4964c63056001d11c703cb1618951d23846a27ced8c3d5f04dfdfdd531d28d3",
      "translation": "接下来，我们会全力，将北部军赶到老狐峡谷的尽头。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:40934e04673f963850592c455ea6cb527ffe80aabc32ef2f00d5028a7333a8f2",
      "source_sha256": "053aba793960dd4e9656594e3ba786cad2c25854e00196812af372065677126c",
      "translation": "一切为了兰兹海姆！"
    },
    {
      "id": "coalesced:50e6bd06df1b525fd49a0af6ef839b1076bcde78358871cb144e0ac3926d5023",
      "source_sha256": "d01db7102ed7d10b003e2a0c8351effe22c6b4a06704b6b911c72800daaba700",
      "translation": "还是太勉强了吗……接下来的战斗，会更加艰难啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:673e5533ff4db346b350f399c94d59b9f3003008b9d9718f253f99f753594f82",
      "source_sha256": "03be263915fd52e8afbabeb72725097d608fede0fb412814e5c842d86aecadce",
      "translation": "在救援物资抵达前，为大量失血的伤员治疗\\n确保所有伤员，都不会死去"
    },
    {
      "id": "coalesced:5acbdca285bbe29c0f1e7d9275f16c59d9933590aeb49834e7143e51aef0242f",
      "source_sha256": "626be36c41f4cb626617fd7957ebeeff5020698f09380058724ba7150470bd17",
      "translation": "伤员救治"
    },
    {
      "id": "coalesced:d542ffe5ad9e50541d5d582a46bae808aefce04d534257c5915cab14fd62eee9",
      "source_sha256": "224753ee08c32cfc8d800d3316f5d47fdd0f7b49630f30f0c51f30381c20b314",
      "translation": "最近，有些北部军的家伙，在村庄东北边游荡。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4a365ac9aeda236f06c1f9080d2d5e3f5c76afe2a466b3fd298361a0c7975acb",
      "source_sha256": "cbd5889ed06bd1b735b28f4db3cd4c86a27f25f041655ca31049d91eb1d1d3e0",
      "translation": "虽然，看起来不像是要攻进村子，可放着不管，还是让人不放心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27f5f0080b2da7d823117fb28c19e014183107c5c77ac41f245e1df5bd4bb71c",
      "source_sha256": "a0ac1c7728a8a6562cb236b5c476c8f0ee8e869cf78d1148284a5f4eee494ede",
      "translation": "你能去，打倒那些北部军吗？"
    },
    {
      "id": "coalesced:2e04381ad81fc16f13a93304e2b0301b200e525d5592709069ec9ad34f87cef9",
      "source_sha256": "057685009d9dc53b76048d39377e333f7fc7f77e90e2f0414c667885f3ee4b97",
      "translation": "听说，那些家伙一直在村庄东北边活动，好好找找吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d63877da11e6c9dfb86e6452d719cec9fa8e4128906126106b3dc795d5a2d456",
      "source_sha256": "166d478d3be864949d87537c9c55432e747ea8945bfc8e8946dc14ca225105fc",
      "translation": "听说，他们是3人一组行动的。"
    },
    {
      "id": "coalesced:82f56b4107b31aa98b67bc4fb0803e05fd354484d3936738462d0d31ae6d252e",
      "source_sha256": "46c60c4165eb86cd1b85a0350426aa1611278d03e29795d86b00043e75acceee",
      "translation": "虽然有点碍眼，也只能放着不管了。"
    },
    {
      "id": "coalesced:c39a24b0d1009ed5dc3242bd548a62b93f2858673833b08fb5ea364ffd8525c0",
      "source_sha256": "057685009d9dc53b76048d39377e333f7fc7f77e90e2f0414c667885f3ee4b97",
      "translation": "听说，那些家伙一直在村庄东北边活动，好好找找吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0c68879be240f14dcad337347478904a5a13f357685e65fb2edf47b91da483c",
      "source_sha256": "9e0d5c5cdf1594196e6c107b4d9636d8492fae4340d2a3c8ff79a164bbc322bd",
      "translation": "干得好。那些家伙，果然是传令兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7dc445b0f43b996247496295d2b1febf000dd655daceeffd64c610be4740bd91",
      "source_sha256": "d7fdf5b29f852888c6aa663a07b4b2d0c0d7aa59f49edd59f5cf4da0aa60dc50",
      "translation": "幸好，在他们把消息送出去之前，就解决了。"
    },
    {
      "id": "coalesced:72411fb98fa4ab382792d443227c220a5399bab762431b61cc65eec12de0ae7c",
      "source_sha256": "251f86bad123192a09cdd89168f7e99ff12b58ef311219f2befa258ec4dfccc9",
      "translation": "令人不安的敌人"
    },
    {
      "id": "coalesced:8ee322364aefdbeef795323b34d4b58bfad34099efe2572a7a96a8f49b1e4e52",
      "source_sha256": "3af882fad0b0976176907312ab43109bbb7be4da7aa36c20c1f64b32eae5561d",
      "translation": "QUEST%s: 消灭北部军传令兵 (%s / %s)"
    },
    {
      "id": "coalesced:a155cc23e230d1b4013d238674dd718451f0f1eef19bb9b349086d1008aafd0d",
      "source_sha256": "a8f63eecb5f11abba8304a6e1869bfcf3c8c85b5b8f4a9de19af1050b46d8281",
      "translation": "消灭北部军传令兵"
    },
    {
      "id": "coalesced:2e43fc0dd57849bd6c31b46a6d4a551cbe3b79664e043212df96add367cea325",
      "source_sha256": "45cc192d468f21cb5c422c3e42655051fd38fe386f556aa650f8189fcc6b1c8b",
      "translation": "消灭在柯塔马雷东北边游荡的北部军\\n完成后，向委托人报告"
    },
    {
      "id": "coalesced:40010fec8bdb887063d27694e6533749f51dfe4875322749160d5f96ae82fe68",
      "source_sha256": "e15321eb4b642adf8a7ba694dc939a28fc907fd51fda8b608b8e8965ccef3227",
      "translation": "北部军的作战指令书！？拿过来，让我看看。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ddc42ad4d1d6fa0b3123ff9824ea524d2416592a3901b8e3700a26b5a5183543",
      "source_sha256": "a081602a205abf576f3c85a442c1ba17f036a6b62f646b0bee3c4cdd4d8017c6",
      "translation": "我看看……"
    },
    {
      "id": "coalesced:dd53506bcb6a6cf994fea1ebfb9ee0ee926ede32b0d89c3c512c289cc7e663d6",
      "source_sha256": "75d7abe0f46f79695bd2567bf26a73b921b169c29932602f6baea9beeb1ceedd",
      "translation": "……糟了！！"
    },
    {
      "id": "coalesced:a55509534737fa59e207cf21cef5d9198bb208a3bf7eabeb86a1b73fea0ac26c",
      "source_sha256": "7c761129ee58c5140a3b75ac08234f250bfcac9990ca8e81e04c0173a3971002",
      "translation": "嚣张的家伙！也不看看，这里是什么地方！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9b44c40aa3db2ba883698888066123758d3146256604ef3cf21678ed963006d2",
      "source_sha256": "aa1edc4d70d9bdee38715505d71558b4f0c34fdc91f7c68e09763d7312ae5008",
      "translation": "总之，得先把这件事，报告族长。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d540414554de03223d1941fbcebd2412161583e552aa700f8c1f54577f8b2ad6",
      "source_sha256": "c88abb7740808b7df9c4e88e8544d583b78d46c77fb2aed9aadc5c65feb29a36",
      "translation": "族长，我们得到情报，北部军打算攻打这里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a31cc050454a46b8f50fe52f7202951d9b1a003b158e2b81781b4b7165eb3c59",
      "source_sha256": "04090c03c03b0b60150e382cfaa2eb5b95a9175b8ad586c5423bfc8f2ab2cf01",
      "translation": "……什么！？"
    },
    {
      "id": "coalesced:8e00ee4a8f21aa55ace997972ebf8c2c02e91979c54411789545d7893b52c81d",
      "source_sha256": "6bff396635817b9638ea5f48040a2fb30a735bf03708f3f97e53707c12c8e16c",
      "translation": "我们已经掌握了北部军的位置，也可以先发制人。您看，该怎么办？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be7851980fc55cf35223c633c7de19a81c1296d50a4ff4621435c1d4a511bd01",
      "source_sha256": "50d592c59134eaa09cc7d39d4b0fbd31051c9b0390d5cf53492fbca320561a6a",
      "translation": "唔……"
    },
    {
      "id": "coalesced:eb4e138f84eb26f3e7c3330f899af1c85855f98f3097e0463d8bee3637b8832e",
      "source_sha256": "1e0087655f810eef729b595323089b45a34fe98ced4da253d23cd20c1dbdf5e0",
      "translation": "先吩咐大家，做好战斗准备。不过，不要主动进攻。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8f9069749bf207c1063588275b4751bf03de188ef23941bd12e1829f4ccda4e4",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:37b569e3c46b2b7b93f250753c9003c21eb630c99484c6bb1f92e84bb04e0d99",
      "source_sha256": "3586f8e62e322ea46764188ddbc288463ee0f3b0409f2381e3cf6de65684bd44",
      "translation": "从被打倒的北部军传令兵身上，获得了[作战指令书]\\n将这份指令书，交给柯塔马雷的[基洛蒂]"
    },
    {
      "id": "coalesced:a8f17be1d22a5a571884d18e2cf2279c20316cb3782f793326e4ef2644ae1383",
      "source_sha256": "869c46c781ab2747bb74e01e8ff5f235059b514f2dee02c1291f2dd8a7b050d1",
      "translation": "北部军的作战指令书"
    },
    {
      "id": "coalesced:a8cdf5a06a54e8a579907213d04415aa3ad42019a63bdc04264c56f8312e82dd",
      "source_sha256": "fd9de31b9f185377f7f255083eaf8a8234c84859e477eb9056d16a6362d9acac",
      "translation": "获得了北部军的作战指令书"
    },
    {
      "id": "coalesced:d3bcaf584ce9c4145d48104bd2e49c8677005260f6b22e055ae6a31c93cbbf6a",
      "source_sha256": "e64606aaf57b534101d370a4c82b8e6da86b9a3a7f60cca6029b08009dcc25d1",
      "translation": "不需要……"
    },
    {
      "id": "coalesced:37f454ec2de28fd053568d8115bcb5273f594c35f7667bbc517a384c822ce933",
      "source_sha256": "2d6944564a67323ebd036db207f8c51098574a5480d6e7b5282587e610ebcb2f",
      "translation": "我去向族长报告，稍等一下！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d624acbbc2fa92b738d341c8ffbbe0f99b5b35a3cbf5f3b87ad84cda562d192",
      "source_sha256": "e1a2796813db3de7ee3b93b755c96543a3a156d32348ca1af04f7759f4f72243",
      "translation": "族长现在，虽然不希望爆发大战，可这样下去，还是太危险了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d52a08320b1791f6b3c6cc53e7bbb0737de2943ebb8468105eb20671bb9d58a",
      "source_sha256": "c690deade74a77e4767e35d19300087064f048ab3e9c7d84a4eef27d8905bafc",
      "translation": "所以，我打算先解决，这份指令书上提到的，名叫[努伦斯]的北部军军官。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:245602da59503c517771c6efb4ca1fa6af02096a0440ba91a12afda399dc5ae6",
      "source_sha256": "5069c1757463e791b0cf3bcbb34d674176a45de1276e3d2e37fafc29057ed236",
      "translation": "愿意帮忙吗？"
    },
    {
      "id": "coalesced:bc52d0ad6f8980722315446d81894e35f223e536a4ffcc8c08db96b2c0cd61ec",
      "source_sha256": "fefb039d9d0df7e35688c399128c47091c767d3eb6e8578c249cee03fa616a5c",
      "translation": "谢谢你愿意帮忙。听说，[努伦斯]正在调查水色湿地各处的地形。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db51f7a10c00fa22e6280be4282d5e274383b04016c971e9e6bb522a408aa604",
      "source_sha256": "813e4178350608d09a7388a00a0eb4b2fed579d0441236da6f363d44c8c3f0c0",
      "translation": "现在，还不知道他在哪里，得亲自去找找。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a53c8f4568a4f1df8bc4f0b787721ad65f8388d4b5f2d3792cfc9e15884713e",
      "source_sha256": "251afa88d3c629f14a87c810a3868c4edcd487d9031bf011bc3b71a7689d077e",
      "translation": "眼下，马雷族的兵力，实在太少了。"
    },
    {
      "id": "coalesced:65e1a8b2d1ec45588396c734db89bcaf673a41c55762a44eeeeccc39f2c37fce",
      "source_sha256": "35bb9bfed4e6c1d525d47b3936ff8ddca9483cf42ec7ee8a5de0c4213c25d955",
      "translation": "真的不行吗？"
    },
    {
      "id": "coalesced:5a689425ee0ea0528c14e664f798eab7283f5d36485781af4e5cf5c579f26730",
      "source_sha256": "a8eb7832d2721974a5d712a6dca2f0881e3ee20ff62002edd4035771e93edbad",
      "translation": "听说，[努伦斯]正在调查水色湿地各处的地形。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:376162ade13dc82654679e2525aab90dcfe29358767cf7cb4d4ffd6cebb397c0",
      "source_sha256": "813e4178350608d09a7388a00a0eb4b2fed579d0441236da6f363d44c8c3f0c0",
      "translation": "现在，还不知道他在哪里，得亲自去找找。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c79973eff5212cf1946e06e0872f0f0033e82023ed103fc375690583c9c50568",
      "source_sha256": "dd291b00277e14b9abf52cab64147c83c107d9efe1d1f1d21bec976facb18728",
      "translation": "你打倒了[努伦斯]？"
    },
    {
      "id": "coalesced:3ed1ba92c59dcb8824958541127f0fc32ff9fcbecef1f277faa7bd59ef3aea55",
      "source_sha256": "1a32715b2c2b7d24d0838300a63f8f29a3830d5ec70b9d55415998de1674f8e1",
      "translation": "真了不起……这样一来，暂时就不用担心，那些家伙会攻过来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94f0d61e534aa68ed2d800e855d14f438f98e1ab3e3bf9c0103345a9b04b49d5",
      "source_sha256": "e0212e471ff155de713c855b9c4532146691650e91f0f39f502de61bb62b2142",
      "translation": "都是多亏了你们。不过，还不能掉以轻心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e103e70246c8f076e084a55385523ee450fe35c1b18753653a9065b03be607b3",
      "source_sha256": "38ab8e1e7952d2a8ea7e2902f34dfee5e05c981bf3687d0625d1308f40333b86",
      "translation": "击败北部军军官[努伦斯]\\n完成后，向[基洛蒂]报告"
    },
    {
      "id": "coalesced:a50480e7e8d40a172bae3fb2beacf05da7a615407afff8248923b421523f59e9",
      "source_sha256": "56aad885d27360d13485668ff424c8e70c7b53dd8327681546cb8594c0f11325",
      "translation": "QUEST%s: 消灭努伦斯"
    },
    {
      "id": "coalesced:1bbc7dfcab55d2a47b5c923608d80fefb94e8ceb3a9a342c56e70e6d9fcd9501",
      "source_sha256": "664a3f66db087704e86d7962569151cf4d73f7071c6dcdda4e729e877f76524d",
      "translation": "北部军军官努伦斯"
    },
    {
      "id": "coalesced:f4a2642ac638fa85b11b64e1d923d04ed29769efa0d60c2df24a1e0e9cfcfcd4",
      "source_sha256": "abd5a8cb73bcced742a16946e5fb1c3eab4308c80fcfb09c630c55b5cead7168",
      "translation": "消灭努伦斯"
    },
    {
      "id": "coalesced:e5e27f13a3002db67597e8c38a405a4e61ec58d4c604ea75582328a76219bfa5",
      "source_sha256": "626be36c41f4cb626617fd7957ebeeff5020698f09380058724ba7150470bd17",
      "translation": "伤员救治"
    },
    {
      "id": "coalesced:0ae75187896cba68fc097a010002b035fcc66820b40b1431b58cd918f3ffe19a",
      "source_sha256": "8f0eae01b2030540de0f5a99d67535d598ba690a4ddbf49cf5b7120a653f371a",
      "translation": "只有洁菲能进行伤员救治。\\n开始后，洁菲需要在众多伤兵之间奔走，\\n为他们治疗。\\n伤员的HP，会随着时间逐渐减少。"
    },
    {
      "id": "coalesced:efa969220d2d9dc43a4859a258b5225d936f1cf389cbcdddb48f1f41efe4460e",
      "source_sha256": "4ea54a15495532ab7c22945382f366f5bf4d0b430dc6fda63febc7b9d379056d",
      "translation": "请在伤员的HP降到0之前，使用[左摇杆]\\n移动洁菲，为伤员治疗。\\n\\n[A键]消耗一个KAN，进行小回复，\\n[X键]消耗两个KAN，进行大回复。"
    },
    {
      "id": "coalesced:1bd671a92e0b42d855d058d728a0041b72ae69b46c3d12a19443264b07139d0d",
      "source_sha256": "625a4f6a28744f16c3458d401e5a0ce460d3a5420d69189408cbe5aef22ef944",
      "translation": "每隔一段时间，就会生成一个KAN。\\n\\n请留意KAN与伤员的HP，\\n在急救药送到之前，\\n确保所有伤员都不会死去。"
    },
    {
      "id": "coalesced:edf74884713b2e1c79d14502100e3850401e930c4b8bd1ed0915196943ac9df1",
      "source_sha256": "d73a1bdfea7b12f40310e4699009777ea9922077d114e5dda542803b20e4d372",
      "translation": "作战指令书"
    },
    {
      "id": "coalesced:de128d0c9c32c76a5b3fcb0189e3f899fc855e38d27a700200aa0c7897f5d4f9",
      "source_sha256": "baad687c0cc3987db14b28acd1d9014d266b705f1e3f11a8a9a57cb6e207ed5f",
