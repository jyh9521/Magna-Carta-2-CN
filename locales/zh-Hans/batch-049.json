{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:a5a00032958efc84013b884badde982781c4c776fb3ff4308a599b021bf8f5eb",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:68bf8a8b6b2413b8025b1b93d9d8b791efd612d240182324440e93ed37b254a9",
      "source_sha256": "afa68c73627a8e2f9f552ecda00f10e1de12340a0f6d72640d895acb89a5713f",
      "translation": "喂，你……没事吧？"
    },
    {
      "id": "coalesced:6945a4496d89340835250bf277be80d8ca75f7f363a0e784998d411fa91af627",
      "source_sha256": "591d57a07fe6003335025b1f4c955f1046b8a0f51538de993a66e0a47875f972",
      "translation": "没事……快去救洁菲吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4448a4fa3e208f9534397017c675dba677acc2775efbb24c5a3daf471adfcd62",
      "source_sha256": "310a45791a1cf4a9c47dcafdfb2b2ae26a6c97be7f0d70db6e6e685fa6980f13",
      "translation": "姐姐会被带到哪里去呢？"
    },
    {
      "id": "coalesced:0f10d09731e22a90bd3c46ddd751a1f3d2e9b84dda7bee0b38cec6c6296bd053",
      "source_sha256": "ea3e87f82c7b524098397e82a11b8a2629fdfa8df00db994f0bcf76d92ca7ab2",
      "translation": "他们应该还没离开王城。我们快离开这间研究所吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:781e80b02f7525bf3202387b766639a8cd1af5c103ef1fae41955fe6fd16f8f9",
      "source_sha256": "f110b6f550d02147d364dc3d9e896fef9f9583cdf6212159cb04b457fdaca9a0",
      "translation": "什么，你到现在还没逃出研究所？"
    },
    {
      "id": "coalesced:7effefadfd7d9e3542e0dfcf577edcd8df0c6c868f1509531896a60a612d560d",
      "source_sha256": "46c5f2a01145736c3a51dfac1a4744e4db6c5e3e3e6329a406f139caaf6905cd",
      "translation": "不，那个……修恩扎伊特突然出现，我吓得躲了起来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:348a98ce17b9803b1b493955a05178b05d210d3abbd2ae222bf8ceabcc03eec4",
      "source_sha256": "64db331a1d03f027dfa31ce5b6c9ca5af9dc8791cb9ec45379ac5c28551ed606",
      "translation": "那家伙往哪里去了？"
    },
    {
      "id": "coalesced:c2823e0732e0e37032fcdd31b079e4de2981d8ef35cb08e6057a33f8c918b481",
      "source_sha256": "b62d4e8bc68b9492966d5364e1b07c429384778d0077ef914584491efc997797",
      "translation": "我看见他进了王城内部。公主也和他在一起，你们没能救出她吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b0cf848f591bf4581031cd215c4b06b8dca13442d5b9ea6cc2b66a4e5746cce",
      "source_sha256": "0b48cbe89d04f18474f73f0fff9e207fd4b3b456dbf534b19b19b1254e960e63",
      "translation": "王城内部？在哪边？"
    },
    {
      "id": "coalesced:7b74335fbc3b77d73cce525465fb0f86ed2b3b7bcfba5cb7b04c7b27e97243e7",
      "source_sha256": "d995eb59a8353e41973eff75367b14c87ca749f95dcab6690d2460a1348f43ba",
      "translation": "冷静点，露。现在进入王城内部太危险了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a7dc7181124cd457a323859ac6cd99e309253e0678dad39fc6a2cdc4292aeeb",
      "source_sha256": "55f12b77a59efa41e116693e3bb6f0599e4f3ef30be55a458ffe698d9f6901d8",
      "translation": "修恩扎伊特的亲卫队一定在王城里等着我们。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28c157fe47ee334744f6d04d0c1314cbdb653dbe4ecfe2fedac1bc4fff03b06c",
      "source_sha256": "67d15cafa339b761cdacdd576687cdad4e6868a1dc686b47637b4b26a3890f29",
      "translation": "可是，修恩扎伊特不知道会对公主做出什么。这一次，可能不只是幽禁那么简单。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a13dd3edc2e500b5b290b0b471821f535466ee6c2139e23c7f2a0d1b1aa702d8",
      "source_sha256": "daa7219167796b383e02ea3cb1bb711b39f1888aab4f0ccaedf40fb397b419a8",
      "translation": "修恩扎伊特不是命令过我，不准杀死洁菲吗？既然如此，洁菲暂时应该是安全的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:82356c89335ac620362eb8a4fc97bba67280b957f19bfc0576a246097be56803",
      "source_sha256": "76506a957b4d898e15a0e05a53d1055162e4eeb54b3b772d3b0632ab578c788c",
      "translation": "我们所有人都一样，想尽快救出洁菲。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:80c59834f4d6b108be338863365da47b650b097ab6e2473d7623388bc38b961f",
      "source_sha256": "2e3f6b46d6223a6d57dee88444b3ae92b7021287da7b65379746cabd93d7d369",
      "translation": "露，你一向很冷静的。镇定一点。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93fab7a11ea0228fda6cfdb0389e2d1bf9f072dd512bc99edd0410122dbea200",
      "source_sha256": "c5259b18c001356667c6a3bcfc004f5a70db6866090536fd174f5ed120e219fb",
      "translation": "贸然行动，只会让我们自己跳进陷阱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31d41225d2ae7559d18d53927716aa83f604d8162b7e927b4f68e4eb19187293",
      "source_sha256": "521877819f1f621f211d7f2de5de67a6e58ab0babca08b43eefad61bbe7c5b87",
      "translation": "……对不起。"
    },
    {
      "id": "coalesced:3f58a3fc75969cb54c4d09e617337fbed69377aadcc197b52de9e4cb5147756b",
      "source_sha256": "f13943bab2940869d183a93bd357ff58043e1ac487a9980a27993f0574ea5e7b",
      "translation": "先回南部军占领区，再找机会吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a692b9c418e43528116a11f22ef778db6604ff53cf880bbeabda9224109dc7da",
      "source_sha256": "8950589ded7bde701f8fad4654e913deac281fe2a9c542f5e19ac34c802c46ca",
      "translation": "要是洁菲遇到危险，到时候我就算拼上性命，也一定会把她救回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ae200bbf259a3a39858e2a8f5c90feb9602f21c13cbc5a6deadc7c8f69a711a",
      "source_sha256": "6677191a8ccb440b2f21153d2cb5df37d33c98b4d1a7b0b4f62da58422d9cbb4",
      "translation": "是啊……虽然不甘心，现在还是先忍一忍吧。都是为了抓住救出公主的机会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff28f75411e89500be31bd8210b9de6791b743c45341277f98fcd0c17748b21c",
      "source_sha256": "d08ba0c4d6634dd0041745aa0bd1576d276af3761f760c71df535a215902302e",
      "translation": "对！洁菲姐姐一定会没事的。"
    },
    {
      "id": "coalesced:9b1404dc44c11980a9454ae9bd57f326d8643d759e3d2f194ab56752c6bb0db7",
      "source_sha256": "30315422e64ada14f41399b304bb24f1ab7a8bc8cce733505c7f8ecaadfeba63",
      "translation": "表面上装作镇定，可我心中的不安却怎么也挥之不去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54450d11478bee514455776f7e584f41857e1c5b7466bb8171948e976d344d66",
      "source_sha256": "d91d8b7737dca79e7c02977f01a40ad3428d34db537f98f9b28ae748d5fef7e8",
      "translation": "洁菲带着自暴自弃的神情，不肯理会我们。这不像那个从不轻言放弃的她。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f043b47e9c4408706197380f9b167bbe5596bc4d544b9e9e49ecd4ad7921d7a",
      "source_sha256": "6bc59cc9e32b03a4226c52bf4014967e3a085704616f446e97e93df9b3bf6874",
      "translation": "然而，残酷的真相，终于撼动了我们。"
    },
    {
      "id": "coalesced:e40c44148ace4f29968e50d8f72eb090e3a3a1516950627b4f2e0e638d3a52c2",
      "source_sha256": "cac4e7be1a40a9ec7562373b457fda3c155c653b043aafcd044845ff78892067",
      "translation": "太好了！灾祸种停了。"
    },
    {
      "id": "coalesced:7b7f92ea7feba6303e3dee4ca8e5554349fe9c3859a192cca76a61403cccca5b",
      "source_sha256": "adae4b8593d1cb6ef0a433d2cad42a09d3a2dfe8e03883466108a8fe8032222c",
      "translation": "这样就能使用连环术了。"
    },
    {
      "id": "coalesced:2d5e53d0615e9e7b2fa25e7e78c4a0348fd7617238bff8885dd56bb2d2722bb8",
      "source_sha256": "f56a25df31e99eea995aff05ccaf78b6dd617fd6663a16e0e0f598a9ad4f847a",
      "translation": "不过，应该只是暂时的。必须抓住这个机会，救出公主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:062fdaae119f72ad3fac8eef06ff33bd7ab23ab8a1850edf20b1ea8168d8ed79",
      "source_sha256": "f147ba8871dcaa553b6ba0a7c3684841d6f088f3a188cfcf2f21dfd4d26f4340",
      "translation": "听说南部军的首领为了停战，来贝尔福特了。战争要结束了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4c74dbffa7e2a36c67d6e2655b6d4668a19d88874ab822eea4161f1d7b168d64",
      "source_sha256": "366dad63bcc8e61658db18f1d783e2f1d391f849359751187f2f3001fc544e8d",
      "translation": "唉……也该结束了。难道还要一直顶着灾祸种过日子吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2bb418d7c492fcd98bc79d58990996592af70549a00c9da31fc324dd07f08ee7",
      "source_sha256": "b13d9f659ce18fad60b4a46dc9e1f907fc52c588bbe09022db21f919197f6aaa",
      "translation": "不知道是不是因为这个，城堡前的广场上聚集了不少北部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce5db19db6706a952e1c7ae80376d164b1174ef8402eb05b4e99d3888ec0f76b",
      "source_sha256": "91dc10f39663ba83c018deefcd4ee3390e794d16082008ae9f029251a24fdf73",
      "translation": "是吗？那今天真的要宣布停战了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4d6c54f1e7592eef40d1208e650cba9a43f6832729918ea561350e7b54894b7",
      "source_sha256": "de12e8ee5abd00f232559f9e01baf01537fc1eda87db39f27e1802b4bb258c23",
      "translation": "停战……？"
    },
    {
      "id": "coalesced:308d6763c445f5d776b9d12ee205c67f54c1e6f7e9ec241e064c16eb7bf61b02",
      "source_sha256": "90eba79a001aeb173779581c93bbf964eac4d5933cfbe9ba6bfa4cd36f07e439",
      "translation": "南部军的首领，应该是指亚历克斯吧？可是，停战是怎么回事？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a77261662d647384f54acd972a6c6152c9433a30db917176aa00869c90aa0f6",
      "source_sha256": "c443aab75e9721eb53a3e06478c1f45b2d58cbda4a0fe575145e47a43978d9ba",
      "translation": "看来，传出了些奇怪的谣言。"
    },
    {
      "id": "coalesced:2f2a2434b77a5732d2f406a498612adf523d9d18c69e47e0c1d36aa1b2e7fa9f",
      "source_sha256": "1fea0010721a61753325a1ee127c60ec23c3404ba5e070304acfa69ccf944689",
      "translation": "不过，既然北部军聚集在广场上，大概确实会发生什么事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4de735087853741fe91b0db7330fe8ea9dcdd4c5a7dfe9751dfb2279fd750fa9",
      "source_sha256": "663c119dcc504bb322a8c7112aeef77ca97ae05f57749c46f03dafb1c9bd6a67",
      "translation": "怎么办？"
    },
    {
      "id": "coalesced:f181f8d48d5bbe8816ea8b6a8268bce057c389d30fbf92c64220a6238cf7cb35",
      "source_sha256": "fb10386b77002403fa8cf5b2370a541ff13af794baf126804719afbe50746877",
      "translation": "我先去广场打探一下。在我回来之前，请各位留在这里等候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d75637beb55ede780fa12d10c81b31ccb61af2d6a0f8ac02fd55a00214868fe",
      "source_sha256": "1de96b131d4743bb194385e17d9db53002aef63974a27545fb2aff2c0d5e641c",
      "translation": "您要我相信那种说法吗？"
    },
    {
      "id": "coalesced:384c0738eb920765b705db4f3f9ee4ddcf5ed508d3c9e25bb1bda203d8a2d760",
      "source_sha256": "9457f4e9e3811fbc09c99853b34fa1704ab440d824f4dcf45cef33d769b419c7",
      "translation": "不信又能怎样？难道你要杀了我？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1ff732236d99e521dd9016c7ce75084ed0f117244dc8591d51242467a66ac541",
      "source_sha256": "f266efb374c7f90fdf1354b817f0b6e0d2a3a63b9c3c16d881132315f99356da",
      "translation": "为什么……怎么能为了那种理由发动战争？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b55ce2e756f72950317bd7611f41df1f751171d664fe5f6145b33bdcdb07e7f",
      "source_sha256": "4026bb249d7f794d6f55c86626e89b06ab9de5c42b7f0b8829fed0b0474e69d0",
      "translation": "你比任何人都关心公主，一定很痛苦吧。可是，现在你必须做出选择。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5bb60144098fc62b66c345dcb3c118b49c9fab74b125f43bdf9512cce8f00d5b",
      "source_sha256": "ed5800fcaeb7d59ee60017472b3dd0911f68c4858cfa8222a5d327b5fa5e57fc",
      "translation": "兰兹海姆和公主，哪一个更重要？"
    },
    {
      "id": "coalesced:62729d570de491578dcafcb7f3ee3d2af5c61f2ebc5ca4d11289a135dd17c710",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:1d6575fa6213c8e14814d4e4b44911e5a2007ea9427dd33557173f3f5ecfc13b",
      "source_sha256": "a5f807cbe3cc669f60093dfc5c0f85571c87ba68676e7900bfdb6e98699f19a7",
      "translation": "为什么不从一开始就把这件事告诉公主？说不定还有其他解决办法。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:21fa9859d20ace68a88fe86a17fd071e3b3d9540cd79ecebbb1f47fb76163f32",
      "source_sha256": "e9d4a0d7151e9051cbfdf16c7e747398ce06f201f6b1f2524dac7bf33c8867e9",
      "translation": "您也不能断定……玛格纳卡尔塔就只有公主一人吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27de74735c817dd64b0b66d4356fce290491e8a33c5d528a25838754e74f6a40",
      "source_sha256": "159f6af1994a54648f5b3ebeab603b18024977063f763990bd69a43199ede8fb",
      "translation": "其实，那个艾尔加，正是作为“替代玛格纳卡尔塔”创造出来的。不过，人造的存在，似乎终究比不上真正的玛格纳卡尔塔。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bfa09ec24bf05a3c92a9e1747430e715008db7fd061bb1ab0077839d2c04f76a",
      "source_sha256": "89d443692cd1474a9c4a0c3e4ecf7feab48acd3866fe525d9ca0c2c7b8cda242",
      "translation": "唯有纯粹继承卡尔塔血脉的人，才有可能成为玛格纳卡尔塔。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1be54c81ab4bb0e4f656000ac025f82cf460a871d3d75552ed5b762efa96fecb",
      "source_sha256": "9139ee537c3c8a63e7897877853780aa87e6eb05116a314f734a0cd63f9b57a8",
      "translation": "修恩扎伊特调查了历来所有被称作玛格纳卡尔塔之人的血统。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:829ad868b04152b53218122c8e99975fbb6a4ddeeb3ed0fb4cdf1e3abe0541c4",
      "source_sha256": "7cc343aec47ee5f3d4629cd2bab063eee4c77f9458eb5bdebe311d176f33cd1b",
      "translation": "可惜，现存的最后玛格纳卡尔塔血脉，就只有王室了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:979bffcdb57e2f47f680363803fdef7d5d09421715bcb0a203e93a5cb40e35c6",
      "source_sha256": "7502eca742910b20f23e02c476e0ae7e967ecb6c1cd0c52b79587a412344878a",
      "translation": "那么，先王陛下是因为反对这件事，才驾崩的吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c6889444f0fb03f64a2b6af6da56f213402403b51952c21ae15befe7c8002485",
      "source_sha256": "1ccca479f2ca7d22307195a2836a152895fcf0beb17ee748df4506b99f27b656",
      "translation": "陛下不相信修恩扎伊特的话。真令人遗憾。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7af8e76018f016a94f293b13219777e4acae2f7848e63db062e22beba8b8caf6",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:ae63fbfdd3e9e53baf2855d7a6dc46f2d4f1bb9107c824475453eedfd99af430",
      "source_sha256": "ff9cb0f09e44b33b3f69b266c6c75bbc585031052aab7af8586eb3f121e134f7",
      "translation": "我们必须立刻去广场。那里聚集了很多人，看来像是要宣布什么。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:93c55aba7ed049e264dd7be12379617f591ef5231a27a9c4e89f491c1f509608",
      "source_sha256": "445b399bea1f2bbe84508e83613a408cfb319e862eb81bc7901d8806bf55be62",
      "translation": "是瞄准了灾祸种停止的时机啊。"
    },
    {
      "id": "coalesced:2087e13a3d04fc9649541f6f0e2a1e7d8436ba4121b217064ae5d8a6673d6759",
      "source_sha256": "8dcbf6273172bd41e524c56e4cb31552770be90f9c3c54ca3e282883cd132387",
      "translation": "要宣布停战吗？"
    },
    {
      "id": "coalesced:b4e6f3acfd461a2a69e196ccdd38c13ba30b53aacfb099fcd5dd23317bb5ed97",
      "source_sha256": "0299093bb09b53ffbde1360ff83f6ef5a01b445dbb798ef739ead71d74a96b2e",
      "translation": "目前看来是这样。不过，我总觉得，会不会有什么事与公主有关。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:461087828221f67fa4c851d206e654f470800ef0d7255b246e43ade39ef8915c",
      "source_sha256": "017da3753cb9e8084a41854e4988eb5ba82e0f543922dd20671604c0b971e04b",
      "translation": "得去广场了。"
    },
    {
      "id": "coalesced:5722bb213b4047febf621d336c6335d8eceaede739573ac27e515bb8d528665a",
      "source_sha256": "9faf431c83fd4eaa3b0b9f688fb676ccaeaa25934da6e580954c2ac0ccbc6bde",
      "translation": "我也……"
    },
    {
      "id": "coalesced:d1ea3cb3801315561bb8f0081ed5cc98bea17d81c58f633a9a5b9f340d39ff98",
      "source_sha256": "31e33583420d02fb59f7669e5cf9d7ca20645413ab5550f09b733da66086d365",
      "translation": "大叔，你还是算了吧。难道还想被北部军抓走？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:636533f97f8b1bdf75185ca2228f57fe336061eb346b3dd63134dcd41bce8b9b",
      "source_sha256": "635f8871c70ee7e3e48f03139a96207e5eb571e5c966f29389626ae30b155071",
      "translation": "可是……"
    },
    {
      "id": "coalesced:e11ec17c3877bb357ca5779fd594e3a1449b1e86872bc0ceb306f1a94b0da1d7",
      "source_sha256": "ba5bc3baf499b262bbe8e1e0e1b24ac42edad5a4e36d6c6dd79de669cf4ae37e",
      "translation": "是啊，尼克斯哥哥，你快逃吧。如果没地方去，就去我们的柯塔马雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:beb8916f8488e849556b7489829e3bec508d0af273f3c681f6da82c0e5fa60d0",
      "source_sha256": "cfd1eeb2c09e09e36fd3bc9c50300bd9a1c70dc1663812555b493469bdda00cf",
      "translation": "只要说是听了我的话才去的，马雷族就会接纳你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:860dc5fcedf556f5bb597f0fabe1a901af27f2398c4567c1dc3eab0ca3931702",
      "source_sha256": "4acde66c6acef739b1add6982db8383196390c784b712c83f058c416602b1cee",
      "translation": "唉……我果然还是帮不上忙。好像只有我一个人在逃命，真对不起。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7aa5526dfbddc779fa461743c810bb9ffa5e4e27df25d1349684e34fdedb926a",
      "source_sha256": "d41d2a48caf68d3323cf046141498cf8f3024fab7eaf299e81de6383a57101d1",
      "translation": "一定要活下来，在柯塔马雷等我们。回头见。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e06a2982c4c02d1d82afb8a7a2748500519c3ce0bfc8a543e6fabe0f7561b4a4",
      "source_sha256": "f55903077d0a3ecf29018b653158d146698ab223a23d0fa6633f467e5b618a3f",
      "translation": "我明白了。也祝各位平安无事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c568b86e5dbd87762eb8004ea4e36f21f8065d5fc0c407155165e7d830512334",
      "source_sha256": "5724f9af02da511999a9154d3168dc8467b8b17a4bb102130404ee7b08b40a01",
      "translation": "那么，出发吧。"
    },
    {
      "id": "coalesced:f97152aa930a4371a6bd64567544490490d90a9734bb3edc27b9520b55f29677",
      "source_sha256": "c8d61b41763f92ed9d2f7baee69d2f1bec7afde3854406615b946948cf4affd2",
      "translation": "（在露回来之前，先在住处休息吧。）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa41d5b4e31138d7b9a4f8944340416a118c6468368b8473f480ba3cf1a81391",
      "source_sha256": "1a1c63fa1837711df9375a19251eeeab1ac00b3c7a801400a0bd94e695f56abf",
      "translation": "（不是应该等露回来吗？）",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c17221dc38d541cd9fccc247283cc893c8a76ccbc07a6aa514873c8b106d755c",
      "source_sha256": "0c3a25ddaf0e3696f41028adbf2a96a127433b3afe8c6444a15e288402c32c97",
      "translation": "（不能丢下露，离开贝尔福特。）"
    },
    {
      "id": "coalesced:0ce6f34e9ba518a0610ba2054a499374676ca63e4189233bfc8ab288a6e78d62",
      "source_sha256": "a26bfa0e1a5817304c4e9527467b3b6c53f18bb26b975bb3d97ec6009c1dbd97",
      "translation": "（露说过，让我们在住处休息。）"
    },
    {
      "id": "coalesced:bfa1566355faaedc417fde55adffae7f38fc2690b81f76a9d9ee9a106f1f4fe1",
      "source_sha256": "4456464d9ab10f11183dd663a559cc79debaaecaff86a6c7ad669e474f247870",
      "translation": "拜泽恩的下落(3)"
    },
    {
      "id": "coalesced:18c01ecedc5acd9898cc598d1a396fa26ef576b272d3828fb6577e3c60b40e25",
      "source_sha256": "86c299ab5847b70cffc6f2260be2e0b84b20443d15d46b4c766883b2d61cc936",
      "translation": "找到可能知道拜泽恩下落的人，\\n向其打听拜泽恩的消息。"
    },
    {
      "id": "coalesced:e49a46b374b2f36d6de1f4c19458a6e80752bfb49f2d4b363c12b9538fa48055",
      "source_sha256": "0100945fb60db25201a01ff0aea7c024cc476ef7294596b6c73db48cbd1a0074",
      "translation": "拜泽恩？你们在找银白的拜泽恩吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f2f0f8133c2056399d16c3fad1807cca9007fc6d1fff41e5ecc84798d4dae5f",
      "source_sha256": "e0da4998547ed13be87a9ff1cec2514bff76359c9afe9a3839e1c9f3640c8243",
      "translation": "刚才因为妻子的事，有件事还没来得及告诉各位。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31822fc40a70c3c0e91c6aeed583e44e0c6383760b4b2364d8609325ccb54e8d",
      "source_sha256": "81f712bb9a73479d36cbda869ec9331906489b2279613f8471f523d01ea255e8",
      "translation": "就在我被抓来这里之前，我得到情报，北部军把一件贵重物品运进了这里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dcc794d769e03fe80b1b689bea52b3d725a6515783faf2650ad1be86b40331e4",
      "source_sha256": "9fd64c0cdf84f4471849e8d7d7927193845b0796347e33cd720efa21e9ca9648",
      "translation": "虽然没查明具体是什么，但似乎相当珍贵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff52226a0b5a912c29088841cc07dc9005d3cfde79b37987b705fc51fb47d524",
      "source_sha256": "f9c571f13cbfd98851de8def0154b6ea0450a0d79847d2f7f83441e69ca31bd6",
      "translation": "如果能拿到它，应该对各位有好处。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:515f5b3e375ab938dce40922033705fc531a1dc0177657c2f1959ee9c70fee38",
      "source_sha256": "04b2073a51b56e727a31dce3c97f0ea5e9acb614f3ed2cea991e8bf3839e7248",
      "translation": "那件东西一定还在这间研究所的某个地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:08214a1c3878b92f1eeca3c96f3ef51a50d1c0cbfbd17ac8ca4ac77d65402fac",
      "source_sha256": "2dc0c76986999fee1b82d00b71f26d1a221b2c39b6318991980d603841c71104",
      "translation": "如果各位还有更重要的事，那也没办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4eee2b9ca74abff440d74b49c4500850162aa65cceccb84d8fc7b7df20fa4d93",
      "source_sha256": "04b2073a51b56e727a31dce3c97f0ea5e9acb614f3ed2cea991e8bf3839e7248",
      "translation": "那件东西一定还在这间研究所的某个地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dba594ccf03baae390646bf594e078fc132b6953d16654e5ee47b069f4402916",
      "source_sha256": "f162f37fb9552fcd0021e521a320a6196ab9cf68be74b46235f4faba206f3583",
      "translation": "啊，你们是什么人？怎么进到这里来的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9eddd63eb1f85363dc6680e0d21fcdcce60ca9545e8a462871b88ccc0bdbb7e9",
      "source_sha256": "f80be1e97a6cbad873072f3ed164a1882bb79f7be2942a33789d2a9dd51c3160",
      "translation": "看来你们是冲着那件东西来的，休想得逞！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4733278785105c6727e99f9f6e367299db664f7ba86abea4e8bc6275d651675a",
      "source_sha256": "02b1628aa2026494ebeba689824abcc471c7dae588e9a689e7630e781c51cd85",
      "translation": "找到北部军运进研究所的贵重物品。\\n它应该在研究所的某间小研究室里。"
    },
    {
      "id": "coalesced:8b99bd5c58d250a2204557752029550e87f671e89d0d7f4cf10fe0249921381b",
      "source_sha256": "3a0920e5c4cd076b1441ee3e714bbf7d3c83a9c88976934e706da41d7e48cbca",
      "translation": "取得北部军的贵重物品"
    },
    {
      "id": "coalesced:f035bd82425d720e2ba01a1c3d896b14fdf78f0603c80b9315b2d88776bffedb",
      "source_sha256": "bba848af0f20fd8c4c619f4d1a8c47f0251a0b38a4ddb2f58a470c0fd9d1ba74",
      "translation": "获得北部军保管箱钥匙"
    },
    {
      "id": "coalesced:f3da772b1006aea7abd8613c194f41069b936e535161e34ea1ed6f56cfc04abe",
      "source_sha256": "0dc6501ad0844a677953c92f8fa156a890ec2a487987198553046cb56abf99d8",
      "translation": "北部军的贵重物品"
    },
    {
      "id": "coalesced:f37c7805aaac2eece82c1190ed7a0e54abce9cdc7cd0642b57b4ab2bc0ea8246",
      "source_sha256": "660c9172943e52bbfa1abadb5be3a4c208270257bc47b12e50b93c879937032c",
      "translation": "这把钥匙是开哪里的？"
    },
    {
      "id": "coalesced:7731838933c1097576e655e0ab09f7272173a07d1c940ce241cc96241973c4a4",
      "source_sha256": "9e3dd9a984795132b5dc20967547ff69dd63df55e732e3585841c10f33071ef5",
      "translation": "上面写着制造室钥匙。应该是制造怪物或哨兵的地方的钥匙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b1172f8e3a05dac8c3a073b0e1e4755838d71ac299e5cf4e0992c3122ddb3b0",
      "source_sha256": "a2d5acdf8e78ec21617fa39adb1caf8cebc20083f625ffc22b10786cb67a7984",
      "translation": "在下到中央研究室之前，先击败[杰巴萨]和[雷卡斯]。\\n杰巴萨和雷卡斯就在通往中央研究室路上的\\n[制造室]里。"
    },
    {
      "id": "coalesced:cd9ebb146f8fce869e023cfb1f8cd1a1f9c132baf8afef6e4196960b1fa10a2c",
      "source_sha256": "62b53d665c76d52ce1b318abb0a3c6ad9257da6be796a4196121c3ad4921cd3d",
      "translation": "如果是新制造的怪物，应该就在通往中央研究室路上的制造室里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee9d77dba3f5e30dd8a985845ec33418c5031526afcb0bf4d74d61fde4266ca8",
      "source_sha256": "343f7c1adcca27126d8ef16315edc12014796f856cab91ec9836614322ad7ea2",
      "translation": "用刚才拿到的[制造室钥匙]，就能进入制造室。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bee6d51d697aaff3f2dd62d4fbb220341a43535ad39e718180c503b8d1a7045f",
      "source_sha256": "e0dee18e5e13520a80cfec362873d77b9899ad7dd4d85f07a4433ede0c6e3a2a",
      "translation": "想进入制造室，得先找到钥匙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab1cc72a80e059b3891f8d1fcfde68acd910d22a480e5dde29ecc4c41c6d10bd",
      "source_sha256": "a95925e6ecf3da8379ccad5b65ddd606ca044fcaedecf7be5085731d962ccce1",
      "translation": "看来得先找到钥匙。"
    },
    {
      "id": "coalesced:bdfa9b30d143a70156a2c99dcd97a611445fcaefde1d4fd903d76863c277e5b5",
      "source_sha256": "0a7f8973708f6497b3bfefc069dd452a34900378b044263cfdbf045828eadc82",
      "translation": "QUEST%s：击败杰巴萨"
    },
    {
      "id": "coalesced:93573faf730ca3eaf3bd2a94e1a0d434f2438cf59299244f9ac732db2072676c",
      "source_sha256": "dde16a4b160545ef005d6bbc5b92499c5cc5ec1caacff0c75f5ca2d4f518c4ad",
      "translation": "QUEST%s：击败雷卡斯"
    },
    {
      "id": "coalesced:4627e44301168ceff4e7c837b62e1d2b9bf528156426198b7e2d293feb6c7f3d",
      "source_sha256": "4fab9f8b6fcaf1a12ea37ed11cc121e0e14b6f3e54f6f48928ca491a2a64fbfb",
      "translation": "击败杰巴萨"
    },
    {
      "id": "coalesced:834bfa5817c2d2f54617b65185e55796a820c564373788dd3d1c5796b258812c",
      "source_sha256": "43d9bdc0daee41f6a2985e392b913d50eac7a860ef25b05f6b884ab793b6e9cb",
      "translation": "击败雷卡斯"
    },
    {
      "id": "coalesced:8bba74cdcaa4121f3964e40ddc9c3a77d9726900b41a0575a78eb7e33cc3a170",
      "source_sha256": "9e8f3d2e7255922b77503b2e1fe5fb879fe46205773209fc87c100951c889527",
      "translation": "危险的敌人"
    },
    {
      "id": "coalesced:1cd88ecf2726946a44ca718c6c872b958c0377bef374d8da654abc81e2196900",
      "source_sha256": "3599c6d22fc86d8eb8a03185cbce54ee4eabd322152085f1b1d73957a290add0",
      "translation": "获得哨兵研究所的最新情报"
    },
    {
      "id": "coalesced:e85b5799aa8c8f58835807e041fe1312d857d5af549042923ab7f02c7b7c7a44",
      "source_sha256": "1d47cdfd76f81cb4273c87bb127a7d463faa6447c3c2b18b48064a1e2204051a",
      "translation": "刚得到消息，据说几天前，哨兵研究所已经\\n完成了战斗用怪物的制造。\\n听说他们重新制造出了不久前被反哨兵部队击败的\\n那两个家伙，名叫[杰巴萨]和[雷卡斯]。\\n\\n要是放着不管，之后救出公主再离开时，\\n恐怕会受到阻碍，所以可以的话，最好先解决它们。"
    },
