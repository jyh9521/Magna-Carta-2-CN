{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:7a5cc1720acf2bf482b7ccf63492113a77ec59fb9a061380a5a90e5f11b33d53",
      "source_sha256": "1d55f47eb67948e33746a6e9b9673478d31291c2139efa67b021d94690295de7",
      "translation": "客人也想试试吗？\\n只要1000SID。\\n怎么样？"
    },
    {
      "id": "coalesced:a696d0e3ec9c9e41017db79b15c9ffdfc8c14487199c393b270f95e02503c572",
      "source_sha256": "89e0c47bacb299363ae82ca66723cd1cf5b02669b36e65bc50e8328ab434b06d",
      "translation": "超过20分，还有奖品哦！"
    },
    {
      "id": "coalesced:e1d44e498baa88953c3f034252e810cc0b92c37f7c7627cfae839832fd73c81f",
      "source_sha256": "1578c84e968050214fc0185162ba6d207285d24e1fca72eead3df074e31aea0a",
      "translation": "嘻嘻呵——这个游戏，不管什么时候看，都觉得很难啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6d481ddf2a5d097ca31c93fb4fc70ce4233d237909637a7cb858c6a092da19f",
      "source_sha256": "32e7966b1a3d9a0cc131eaef20fc4fd787c71ec1bad771754214ba5158987be2",
      "translation": "我实在没有信心，能玩得来。"
    },
    {
      "id": "coalesced:c829a7c04c39fba08bfe05c0ef495d39de7ff3f1ebe6fb439d23d69631386078",
      "source_sha256": "e6111226c2e0807c82f5342902572469343a4d64636d73d6e149a4cc26ecd66e",
      "translation": "这里是抓蓬蓬的游戏场。想挑战的话，去跟前面的阿维斯说吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0e156a5315ba7b06d73f40b1dedaabf7df02435fb67dde48c8769d56ea8fce53",
      "source_sha256": "9376e7ad68f806825ef2ab648f614acd2db02c1cb97aadb25a35b29f71658652",
      "translation": "这次抓蓬蓬的奖品是……"
    },
    {
      "id": "coalesced:f7571f38274d572c5621aaf2f53259406d81cf24e083efbd70aaf9380354bd8d",
      "source_sha256": "061293cbdc0d6abbec83541857d1593a539d9eee0cf539f8bcc60ce8ad44fc7e",
      "translation": "20分: 治愈叶\\n25分: 疗愈花"
    },
    {
      "id": "coalesced:4bee559f5b7f3f128f6fcc79867e06251e651baaf5a0f04110e199bf32f29f3c",
      "source_sha256": "36bb108bcb17799e2cda14ac972f22d427123ad11acc1f0049838bc0b9621c9f",
      "translation": "30分: 英雄卡蒙德\\n不过，这个奖品只发放一次，\\n之后会改发苏生丸。"
    },
    {
      "id": "coalesced:3ad09d790d3408c0242a9d42750fdda88b16df44214723d4430aded2dc68d745",
      "source_sha256": "6c870248ed2cfa950a06281d2e1de8460959e11d6db0cede49c7c83ce05ffb85",
      "translation": "就是这些。"
    },
    {
      "id": "coalesced:a2bc6ee0769a98ebf939a9343160eb1cbc8734e49545dbd591dccd0b3d7b0dc5",
      "source_sha256": "d3934d98fdcd57780cda02d75146e3fa49f3e7bb6e5fa2b89defbf270fe9c8e9",
      "translation": "男朋友连一只都没抓到，真是太让人失望了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4786e5d4e113d1c14e6239af06e0693f80405534394e0a88877e03e57d4cac97",
      "source_sha256": "973c37f4c446d5178e60b003998c0b553b4f9a9b163f3468776504412802329e",
      "translation": "而且，我拿这事取笑他，他居然闹起别扭，直接回去了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5e632c794cc1034a49256e5100b67fc8520e09b5d40c5462f03449168c03fec4",
      "source_sha256": "7fc4cf27d2e3040f193986c91b4ccafa24a8386442f3ab2678325251592a21f1",
      "translation": "要是再年轻3岁，我一定能拿下最高分。真可惜啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:73f4357214112a1161ff4c37c3d24d541df61d66ce4b6ad220795cf065267838",
      "source_sha256": "047c94a7c3a3e4c2943fca8dcd6fd83b5c99a96bf0d2615e066a3e50cbbb8e4c",
      "translation": "啊，这个比看上去，还要难啊……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92d6601ceade0e734eb93df2a3f112c98c366dd5d8427c6b703ac53f46951844",
      "source_sha256": "e62f92a69204ed6d64a801eea4d28265c990b2343e872d4dcd6b8856b8f7069b",
      "translation": "蓬蓬到处乱蹦，弄得我手忙脚乱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:010ee3f032b8c1a2035adc43a13f9487b5cc9c91deb56f22cec1bb0f15a41688",
      "source_sha256": "4fde6bb5f53b734a6fd8e19a0136745cefe7e999eece13db4887f6ce354a36a3",
      "translation": "那边，那边！打啊！打啊！啊，你这个笨蛋！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:466d4bd9af3bd267397003c058062d3692d22d036b0a0ddc6d2f0da3acbc7cae",
      "source_sha256": "84735b83ded90e97de5e679ef87294b13cb50756ab641e36dea5bd613664d7a7",
      "translation": "嗯……蓬蓬太小了，不容易发现啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:92615a0a165b12300e9a11d01c5e352a0644f08bb4c1c1f9ca2ec465024ba964",
      "source_sha256": "a4fab4cc4459f3513360209f5cbb31168c64b7f227842fef7d80758e65485378",
      "translation": "想拿高分，得有开阔的视野才行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5ae4363c590a303d8ffa89e6f196af7aa668f56aa84ac0d922fc98eb75c2bd3",
      "source_sha256": "7ff8461eddb4c5f319d5bc794dd31f74fe26d9e6f7f0cb36951ab6683f787c9e",
      "translation": "居然能想到，经营这样的游戏……真是聪明啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:030a41d712365050bbd9fc3bd00a337f81412612c6a39a116491df1efbaf4ef8",
      "source_sha256": "bcb9ce6439b85a8f9043bb6f2b7103a4c5e3677a7e03292678af395170e8be0d",
      "translation": "要是我能先想到就好了，真可惜啊。嘻嘻呵——",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dab3c6bb1fb91836449323588a7c781108904f1a7e671f1f1bb162a5b132c6ad",
      "source_sha256": "a0cb41a6b2603f7644aa55d543100c786923af064a3dcfde41dc1e878178218b",
      "translation": "好想要蓬蓬玩偶。猫猫玩偶，应该也很可爱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f61b32734557226e3f040f911957c08b97c04183e9ef6a5a1c2caa83047ba62",
      "source_sha256": "e51f38c802cdbec66dddfebf2b19868d714b5b0cf7fd97633c9c97f27cbf51c2",
      "translation": "这次的最高分，会是谁呢？"
    },
    {
      "id": "coalesced:7500008485093dda2a07ea2fa682239f0f5c983d27f7301be5f8a85587e8924e",
      "source_sha256": "f6e2db4a0e4222c3f62ac09ac30856920c12e784257f07d3bdd099266cbe0f7e",
      "translation": "上次的最高分，真是低得不像话……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d31e05ac5d13f9cf089d7769c70eb0a1afb4047e434baf8a6f5ad4c277f9834f",
      "source_sha256": "d9a1e1d5b7373089ba85be76914a9f95de8b95ec78abee2d6cae1bdf28ed79cb",
      "translation": "唔……我也来挑战一次吧。"
    },
    {
      "id": "coalesced:fe2a2d55a6a6e88c0070d4b032d372cbccf4bba58106db17f17d2de5132647a9",
      "source_sha256": "aaa0d514a5e2b7bdcb2075dafa76c4bf745af457110c77649eef03b1d03df768",
      "translation": "啊～～连那个都打不中啊……"
    },
    {
      "id": "coalesced:3a6acd339ac4c7053a4fe6b3f36429da7e6d75a20216b01eab6ab239b483015d",
      "source_sha256": "1676b3c0f9bd34c5e0937ff7f3e6aa12049daafdec4751c461a37e29d560f57e",
      "translation": "喂！还不如让我来玩呢！"
    },
    {
      "id": "coalesced:2545b1aa3fd5e22ef8a1d74502418dfdc047182d50fecae5f935a8b4916c9090",
      "source_sha256": "211b1540c0de28159b76e3426bf28f0e641a26f51837979ee3f50671375ef9df",
      "translation": "治愈叶"
    },
    {
      "id": "coalesced:98b93a950bff2c61632abe0a97e03f93f92fa0960582fbf4a5ce4bba4b5327bb",
      "source_sha256": "9dc5eb999062d27a7036c080dc6b92891d429c0deaa6783c3b77cb5633b3dc92",
      "translation": "恢复1名我方成员700点体力 "
    },
    {
      "id": "coalesced:ee76f211ee1657a80d293e7f70a75471e6f2402f2e849aaa157779947a5d2838",
      "source_sha256": "ea4e8f034ab019421abafb8cc1d14c70de771556f9ee0ab9f8e1af5d8b3a9696",
      "translation": "恢复1名我方成员700点体力 "
    },
    {
      "id": "coalesced:7cfe814e22af36c7b322ee9d2282ff7484b07f3116fdd0598b5b4249c17a41ce",
      "source_sha256": "c23e7df020e293e58e790ac4272f01387e8a001324579357ccfec29969ad01ea",
      "translation": "苏生丸"
    },
    {
      "id": "coalesced:599277ead55552a0a975797104a3fe84452cf8e5a46f57fe3b4b7057556edce0",
      "source_sha256": "ea3fb2a764aaf8b284a4b8d533aa65f648c57388be5af342ed56f06ced24c305",
      "translation": "使全体无法战斗的我方成员以20%体力复苏 "
    },
    {
      "id": "coalesced:05c7f647209a224d5a7f3a72c1056dd72f84f0e6291c9606e86027089e6a5402",
      "source_sha256": "6745a2aca0d5c56d190afeb4d76ef92f01eae28c476fd04eadf7b7db37ebc281",
      "translation": "使全体无法战斗的我方成员\\n以20%体力复苏 "
    },
    {
      "id": "coalesced:5f129f4b43f088eed93616b15330d6d310aad1612bd18ea824a23343f11e98e1",
      "source_sha256": "e73dbe18079e97dbead9ec5c7e63cc215b5116412bf9f33f2118a050973aa18e",
      "translation": "疗愈花"
    },
    {
      "id": "coalesced:7b155df853409fcc43492d02df783b40fa3e351c59b52c5fcc5d49724746427e",
      "source_sha256": "116ee3c6c01b1b3a92630bb4bd658be48fae4a63ab58e07cd041d0380b0cabdb",
      "translation": "恢复全体我方成员1500点体力 "
    },
    {
      "id": "coalesced:b66c4e1b5965cb1fe6984bb57f303a70a06c50f267e6b556196f0d421afb7e40",
      "source_sha256": "4f89f355d323b59840aa8bfeb0c6c311a8702b4e8310eaef541356e1e128c078",
      "translation": "恢复全体我方成员1500点体力 "
    },
    {
      "id": "coalesced:aed2496d6f38cadc3d1f1963bfd0b70e1fc21b5675a26a0096290be4e54705a5",
      "source_sha256": "282c20dfa30a8b5a2268874afcd6edd983c3973c4fd7b0c856150b707f55d666",
      "translation": "英雄卡蒙德"
    },
    {
      "id": "coalesced:93bd003f5f8ad59afebb3d649deb858c053408e875f36c8a1fdba4c5a55b18a4",
      "source_sha256": "1e5a45b5f0c88312c23c9eeb4564e98a84f1744c7d0b6682e96efcf53aacc1ae",
      "translation": "攻击+10\\n防御+10"
    },
    {
      "id": "coalesced:661c85092ad73bfa2b4d66fc3ba674e9c5ccc8321ffbd6f7979ca89440a0fd14",
      "source_sha256": "a7badbf53cedf9a946a7c2ccbea6039aed62beabe5276d8267a327cadf0c9ee6",
      "translation": "特殊卡蒙德\\n攻击+10 防御+10"
    },
    {
      "id": "coalesced:e0736320af9ad8a0bd93fe9fa396626f058f796219524fcce9a42f2ff867a0d1",
      "source_sha256": "43af8d18ef9d7eb115360e49742f40e505a50188799ba7a83f7a8aa12abcdcd2",
      "translation": "捕捉怪物[蓬蓬]"
    },
    {
      "id": "coalesced:b48d7a5c0d4d71b3925cc948b69e7d67e0a56f3406d0405586147a6c70a0678a",
      "source_sha256": "52ff49ab47ac42433e89edaa8f92255e047c1205ef7ae86e5ccba6b0bffd5e57",
      "translation": "只有阿尔戈能参加抓蓬蓬。\\n游戏开始时，阿尔戈会手持锤子，周围的蓬蓬也会开始跑动。"
    },
    {
      "id": "coalesced:57816b010665160a01f5f4ea2678b64144a3613945cff9ddd1128c014356b691",
      "source_sha256": "13641b18d42c163a2c7c7f886786b9efc4069db1019d8faf7511783e6ea0cfad",
      "translation": "在限定时间内挥动锤子，捕捉蓬蓬。\\n抓得越多，得分就越高。"
    }
  ]
}
