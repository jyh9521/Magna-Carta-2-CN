    },
    {
      "id": "coalesced:71b027e988dd274f211c7d24e107afd40217420ba8d4a4e9afe6c01298a1a903",
      "source_sha256": "344bc447d57740da1b5f238bfa3df43e6061e0e0636bf10074d8d1f9fea1a268",
      "translation": "消灭黑猫猫"
    },
    {
      "id": "coalesced:fbd9f8b18e9a7fca1f24604b04345e85b5b8c478f71c70c1fe8d6d5ccabd74ce",
      "source_sha256": "7d4046ceb112e8d8ae97cd804786c27c6bcb9d3390d7a8771eb2f0d701cbc248",
      "translation": "拜泽恩"
    },
    {
      "id": "coalesced:3282c851bc46fbc0a6b77adb47b0108b1839647f46ff96c050571b260ddd813a",
