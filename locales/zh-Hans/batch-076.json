{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:4e91f93d06be38615faaac425877d6fdd42f90f36766500ca74486a6458f2289",
      "source_sha256": "96330a471dafdf89a67cf61bb0a1ee41eac6f295e937156478194e54523dbcce",
      "translation": "切，给我等着。总有一天，哪怕追到地狱尽头，我也一定要杀了你！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b601003e6aed7029f083020434a6649bc1c0a32048350be6ee0f341eabc1fce5",
      "source_sha256": "6d0d884fd53f1d00869ee1aee1f6c0fff8e7b4e3af42f77e0e1a1bbff147ddb8",
      "translation": "那家伙，到底是什么人？竟然说你是他父母的仇人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b53fa7c11a36c0af123e9057dff060b0f5c6d873acace560e276ba962494f635",
      "source_sha256": "ec7093a0bf14df674e71b9753c289c5d07706633befaa44e557dca4c78aac9af",
      "translation": "我也想知道，他究竟是谁。"
    },
    {
      "id": "coalesced:4bd99b59656881fb3739c67f421b71c1dce1afd8a03587cc8aca3fabf2dfce87",
      "source_sha256": "9b405afd0f7d181cb67d37206686caa464cfd2d13d30ac5f63111596e0b9774d",
      "translation": "也许是认错人了吧。朱特哥哥明明是个好人。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d701dac7c936cddc14219682b5c2d9106d438e7889cac8b9e0254f8dc8edbd7f",
      "source_sha256": "15d74862a4078de5e469eff389fdc094310cd5c0e8afa0d9f650251311f53705",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:670b122c66bfa3f557bf04231870b0b61a065b3e1ff848f33dcf910fdff533bc",
      "source_sha256": "0c6ed07c16363fdb7a93f22f5eb28a4ac1aebe2a154be63ce40d09e3ca0099ac",
      "translation": "切，给我等着。总有一天，哪怕追到地狱尽头，我也一定要杀了你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17ed65d22bf3bbb02b43d3637303d06089575e3fe1c7b42cd94197623256b4a0",
      "source_sha256": "cfa7e11b990a504f97b2c0a97717c3bc4c954051aa47b788b2e6ac9d6c9aced9",
      "translation": "毕竟艾尔加恶名远扬。像他这样的家伙，恐怕不止一两个吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eac1a1191ba88e1f9b6dcecb2e5a96516502adf7697238f764cd7db26961092d",
      "source_sha256": "853563553e682968932bbd08f03e50b266f690e0e91b19d1836d8721667c84c3",
      "translation": "……是啊。"
    },
    {
      "id": "coalesced:bcb40af12858c6c1cb6eb314161bbaeba5b0bb585eba694d25f1052e44e3c432",
      "source_sha256": "cef65074738e483e2cf4b3c7aff07817e76c065c649f69b0e0e6cd5a9ea9f73e",
      "translation": "克罗塞尔，你真是太过分了。也没必要说到这个地步吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b3e7697ee2e5ba531e5e9e90ba9411b1121aac22746ad99f850a4e7639a78a26",
      "source_sha256": "c6e077f0e5d34fad0df79bf874dc1515858db98121b429a97f90587e1d0d6a6a",
      "translation": "难道我说错了吗？不是已经有人，像那样嚷着要报父母之仇了吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:42af5c21360eac6f59ed29d0f1afd1a122f0c097aa99cddad337c246c667ba82",
      "source_sha256": "a7ec0b4b20d06e4940e4e975828886a0cbbba457db875ff2f7bcc1a67375d74a",
      "translation": "克罗塞尔，够了。"
    },
    {
      "id": "coalesced:eefba2f64734f4d2a3535a172087ca373bffba810309e347deb525f7303d878a",
      "source_sha256": "5da761ff6d44914aec3ade7f7badb909d4331d4d50ed5f887f5b8c28162e6921",
      "translation": "现在应该先救出公主。不是我们自己争吵，浪费时间的时候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:284e24862a5c88a9d5a2666d2e68817cfec05fd974860cdfb90b9c3d2ec0f93d",
      "source_sha256": "3b6133dbb68420782f4f000d961bb14cf1f2170d8370de9d79e738fe8ebe026a",
      "translation": "不过，今后要是你再背叛我们，到时候，我绝不会原谅你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f706e23864aa83deb05a855b4d155e6cc65f3113d8805793eea8a863438c248",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:6d488c8ad47a839e9104161914b3a613b4a9c1eac4002f0e6e7a06a6672db06e",
      "source_sha256": "0c6ed07c16363fdb7a93f22f5eb28a4ac1aebe2a154be63ce40d09e3ca0099ac",
      "translation": "切，给我等着。总有一天，哪怕追到地狱尽头，我也一定要杀了你。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df9360dc1ef4567f07ec48171cff94a849c31c73312f636e54a2bb74c616a046",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:841993d748e4ee4c34e635bc3f2aada98fbe49e60edfd84f60db6cdb9c7bd187",
      "source_sha256": "c585c9639137aa85a1e94ef1786daff89671fbc6c0d8bad90f5fbe5c76509d44",
      "translation": "朱特……"
    },
    {
      "id": "coalesced:f9f5f037f016cc78ccbfc21f12fd99e0f0044f13a8179dbc44170df545aa9c49",
      "source_sha256": "9e47798d69a20d4056e086a463135056d2a0115c015b017feacf134eb564b664",
      "translation": "即使并非出于我的意愿……我犯下过错，也是事实。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7297a82ca05e31032f3482c79597e2bb5140af8f5b0b613fc731c40483afbc9d",
      "source_sha256": "3808a5d8cf97716d59618989b844ddc327b4cfdc6719e49d121f432cd50e04c2",
      "translation": "等一切结束后，为了赎罪，我会再去找那家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d10351e68106f9be165802ced7ab98a6e003f03c06bb293af93343e2f370c9c1",
      "source_sha256": "25dc3ed680ee25ac597913a4e5f50d9c827a143dcbae38c22d1d71e425e3487f",
      "translation": "在那之前，绝对不准死。"
    },
    {
      "id": "coalesced:b65dd7f199ac40832fa737606ea90a5a3d6b621573b6b03cc8b27ed2e7fe7fbe",
      "source_sha256": "ef8835d6c876e57fe4f4c37782cad87953b2c1e217027058e6cff6355f37da1f",
      "translation": "当然。我会一直活到最后。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a50dfbf7fe37a9a41c377bc5259b5c87d418867ad4555287fd9984e1024dc581",
      "source_sha256": "9b73140f81bb865143fa563307a0e4f1c145b6cb092fea89cf374e02d60b5e4b",
      "translation": "对嘛～这样才是朱特哥哥。"
    },
    {
      "id": "coalesced:90fd9d723eace59d7fcc124cdf77306fd3e650fcd65ed83e20392d8dc9cd5f96",
      "source_sha256": "349b4355b54835e0c265e15ac4c124adf0400dea3aaa0075a5c50c8095f71eb9",
      "translation": "塞蕾丝汀的父亲，曾经在这里？"
    },
    {
      "id": "coalesced:0aeb5eca8a6d8e5b68237e648c64400663fc5c09f0bfc70923b065b832528325",
      "source_sha256": "cefda6d1841b9b9f6902c29ff57787d1eef8bd1d8eb6bbdfcb55c0693145468d",
      "translation": "不会错的。一定是爸爸！"
    },
    {
      "id": "coalesced:24d7cccc157e666746ef9ab6d0db1804b3d9bb9f3a7e17a2f944c370e53846da",
      "source_sha256": "8acad7e4396aaba5b7acf5183fed72fbe3823aeb5541781898857abd869b6d88",
      "translation": "先读读看吧。也许会有什么线索。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f284a02897ec9df165ff878aaa5edcad067df8a4fa944fd92d6a1ec121a989eb",
      "source_sha256": "92df90459aaf782fab931ecb074ac53d106451bd39e6c8147bebeef9dbd76731",
      "translation": "嗯！"
    },
    {
      "id": "coalesced:a5bb5ba0641aa79f4a35239411ad45b2e83761368ff6a9ec257850f079c10dd9",
      "source_sha256": "dbdc5143ad24bff3b906b14cb0c7c9f5ea58b5720d4e8230326fafa460a7f2d6",
      "translation": "从日记来看，爸爸好像曾经在这里，住过一小段时间。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab2a950343d9d59b09d4d6dccbfe500c2df9ad0d4f0a2cb82395d09da84fc3c5",
      "source_sha256": "b690799a2d86f3f106ea9f83d8aedbd036ae465007b2a161c95e7c45e236dce0",
      "translation": "爸爸在的时候，这里还不是废墟。虽然现在，已经没人住了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a124d5e5482e55ed551376b028981850165f18b844c063f56d1d7c953d95917",
      "source_sha256": "f581f28f7351b311aa6530502c747d28173bc47ab4197d8b9dbb02765c10ba2a",
      "translation": "后来北部军在这里闹事，把这里变成废墟，爸爸好像就打算前往贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2fde62e45b31404c728e0bff198a20ad5b0c0b3d75de95837cb45f1a425b5eca",
      "source_sha256": "3444e3a416568d8f70bb3b99be749369cf8aa8045531c59a983cd36cbd197826",
      "translation": "爸爸好像是想向北部军报仇，因为他们把这里变成了这样。日记里写着，他们干了非常残暴的事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ca8de5e581fd58d3568d5606e406487efdf64f408f8de0bb318bf46fde574988",
      "source_sha256": "0424385bb2dbdbf4f38b44dc3229c2c200271ae4211003d8a67fc7f29de73d3b",
      "translation": "原来如此。北部军在这里犯下的暴行，就是著名的“雷恩波尔特惨案”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bece14fb79de4ed707bf2866bc20e37e6ab294c06cbcfe356661deacc24a77cb",
      "source_sha256": "8fb9d894409f2897c544abcbb050ebed430d4836695aac3c86210404ce1ad3ba",
      "translation": "贝尔福特啊。去那里，也许会有人知道他的下落。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10d7d9f61c03e3855b826d81bfc26c3cc637c83ee16122ee4ccb2890a9425d4d",
      "source_sha256": "3b9826da26dae36bd02b546e51ab711aea7f9a3210597d169258afdf0081f3b5",
      "translation": "好！现在就去贝尔福特吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ebde9f947d73fcff138eba4c8cb22954230780a4fbdb137cd1f891fb015441ca",
      "source_sha256": "86c4f037c925b81436ec13932e9a2ffc3af8e9e43904bd361d69ea95c0756a56",
      "translation": "请冷静一点。我们还在执行任务。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:01e189cbd3d4b2b12a00f70ec40df62eea9894a6692f11912ac03e2f04b7fe81",
      "source_sha256": "3a0d3e2bc5a5d80d3c3f8ad63619d5703c37d28bf43e10bcf964fd117cb43d50",
      "translation": "唔，可是，在贝尔福特，应该有找到爸爸的线索。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d7855b93c50ef1dd681ae18e65b516344611334056876ae98fa124b23ad8a5a",
      "source_sha256": "797f4853ab0674cbb23f7c7c2862f281b74588b39f1714eb61ed4c68fdccddc5",
      "translation": "露说得对。"
    },
    {
      "id": "coalesced:4ecd256c025efad1b5345cd5cae33f221da44353bc3c6e2e6e934bc81b3909a3",
      "source_sha256": "9a3b23705813576100bf30f8a581d52c8e95d77602380fb1a5f823a5e1166a39",
      "translation": "现在，还是先回去吧。"
    },
    {
      "id": "coalesced:0863f18b786046f763728b951072559ba4990fafb0dfaae94aabde876a9c425c",
      "source_sha256": "0f8d8ef6b835c24fd53e444f455ac90abad363131427ecf9ebf49cd086e14f95",
      "translation": "救、救救我。我的腿受伤了，动不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d45875889bf83b20ee9daf5eafca923d1dcd2706fd282f336ae743f5789b07d1",
      "source_sha256": "cba292115069e859eaf7782e793fbe42617c248f831ed6f56b45a938d9b3b5d0",
      "translation": "拜托，救救我吧。我可不想在这没人的地方，孤零零地死掉啊～",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4269b21cc24a0c3bad30d7c869473651fdca4292addc6d16f95e5e721d25d01a",
      "source_sha256": "338a82ac8a74a0593321aa70c55df3f282359c76aed6b3d763d9446298385a02",
      "translation": "竟然在这种地方受伤，还真是个倒霉的家伙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c2a9cf51d673b91763c59063e360ab6893bc58f40a62509cda1b2cf55ef87621",
      "source_sha256": "c1f56630cc0e553a00fcf404a5efc4bb64e11aca64194f32cff75b9627e2b491",
      "translation": "看来是在执行任务时受伤的。赶紧治疗吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a6ea3562dd5736dd266ac169def44fc18ecae3a490af3cb76f78269ba23a25d1",
      "source_sha256": "2dc3980b5b742fc598dfd2d0d85ce0efc5d3823fa0c051681d60d48b1502db39",
      "translation": "谢谢。我的名字叫玛拉基亚。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:79461cd77084d93dc06b81c8b0073c3003f667ab3f9d4e519f39e78e7f756cf2",
      "source_sha256": "0ad4ce3c768547469cd7f8769083475cd9da3afb25e2b969319fc00db2c9944f",
      "translation": "咦……你是？这就是所谓的命运吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f4624438fa16357197a365ed2ad7ae429cde258c09ee18f9a69aa3e127c58ade",
      "source_sha256": "bbd491011cf407be52866faac4ad58f05629c0e2d7fc403bde1ae6df2d6f5355",
      "translation": "竟然会在这里遇见你……简直就像做梦一样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fd5148fb43e12b34cd92a7fe5d1a9233c543f3b85268206498735bed88d423eb",
      "source_sha256": "54a886cf9bd8f05f9c9faf10097ba416cf53fc9d2b542ecefbab332e51f67e29",
      "translation": "那、那个，可以告诉我，你的名字吗……？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3cd8f59d1c781909b6b008435aaa37d6a8916a6dbac0b3f41f5f44fe792461e8",
      "source_sha256": "66dfb1aa67efc4cae354d864ea28767e1f4352ed0ed973fd300f16c1edb1928e",
      "translation": "我叫露。"
    },
    {
      "id": "coalesced:b63cba35c880b5b2ceba00410b4ac2807630f76734fc3a41ffb9d2358f0452f5",
      "source_sha256": "af023798448444dfb2ffb60f0e03cd232025a6e650c0a6a214fe0d7fb72fc649",
      "translation": "这实在只能说，是幸运女神的祝福。所以，现在……我要告白！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72e5017a4be43fb33e09f4f4630c7bca2879016155edad3d80da3a2fa1b494c5",
      "source_sha256": "2b0bd7c37130362805b66873d60c1229f9b6c7bddd0f9f568c0a727a8ce0e792",
      "translation": "我就直说了。请和我结婚吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e55da970a18266014c90977db733efe944aad820000308e9cf3fedc2485c217b",
      "source_sha256": "f5de92dad8698b27d7976ce473217e6e39d2fb04872453a77f8582440da1a430",
      "translation": "呃，他怎么了？受伤的不是腿，是脑袋吗？"
    },
    {
      "id": "coalesced:56fc00d5953b3d908f57a43820420dc99e6f49f917d01ecc64514406487a7a0b",
      "source_sha256": "53d9214c3db83d5c3dda3b923a6a6b6768ea51f009347ad7a024bfe3883278a1",
      "translation": "哇，竟然突然求婚——太帅了～～！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17e6bfbfd348b5c256f70676059ab20970ef362e11bf2ab949feac28d178614c",
      "source_sha256": "1daec72be770ffb859cbf01a2402d5e379c007390d169cc7b632485b6d812669",
      "translation": "你是在说梦话吗？还是因为伤口，发起烧来了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94a03f179ca3905eecbefe3ca27607a13a9dd6cca36449e0e086faf9c21d9bb8",
      "source_sha256": "0f8b4a9a2a38fc3df0a00d24d446804b3fe2d7ff468a8a788d14823fad11b6e0",
      "translation": "啊，我、我是认真的！我对你一见钟情了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2e1393fb99c61966840b69f052a2edb022a93d3cb3f766a17785604e545cdba",
      "source_sha256": "61d04e77ab9dad26bbb9d57643b7b55be02b2406db1f400a83a14658d13953d4",
      "translation": "已经治疗好了。该出发了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6ae50ed4640ef0f0e70d063388298eda80879d582621091ed95f284ab019cb36",
      "source_sha256": "823545264d649cec64f057d7eb015ca4361f89247c94a2501e776a16964b579a",
      "translation": "露姐姐……这位哥哥说，他是认真的。你是不是太冷淡了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66012434393c9539c5fd2959f70a1ec90ebfb7bdf9b86fb2c0efd3541581e48e",
      "source_sha256": "aff9dc282324ba7b94fdafa841c2e6c7488a3db506c42700b6297d27e02e5eb0",
      "translation": "现在，不是为这种事分心的时候。"
    },
    {
      "id": "coalesced:ba9811d94227ed578fc5d690c23abdb1d69337d3bcfef3ef2ff33f997fafebcb",
      "source_sha256": "270d30a57b9f515abe6e7ded70b6b768110682e439618ab9f0c2669e87237495",
      "translation": "露，露……"
    },
    {
      "id": "coalesced:0e4935fb10f6be259819f77bc819129cfb8f841cd386305ffc456d4d04fc8f40",
      "source_sha256": "ca4e4771de6e719f198132870876113ee4a74dfbc88d9b2f26ad6f8126903a1f",
      "translation": "你说，你叫玛拉基亚，是吧？我对你，连一丁点兴趣都没有。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c651ebcf12f09e25e07e24bdb1237193d7953559e7bebc29495c900132c59a31",
      "source_sha256": "9ca3e16ee1cd8e5bf04c9e884b8c0cc48ead5a4c3b5d7662a20b3c60d82370b8",
      "translation": "玛拉基亚哥哥，别太失望。大家都是南部军士兵，你应该还能见到露姐姐的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a74316ca8127aff3fa13c2743d0a352f50bdedeaf1d64e2ac72d9004f89596ed",
      "source_sha256": "d7d741a8f2bc7b9051b1e2f6f1deabf03f46b7c877a92e4a57190c1469fa9402",
      "translation": "偏偏喜欢上露，你可真是挑错人了。真可怜。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3db9aa563959907cd7b36cc1715a9a0fcf714ca973676bb31c6faee5c591c631",
      "source_sha256": "55343558cfaeee85f65453af83bed349ae440d7bf49fad8538225c74b59a88eb",
      "translation": "玛拉基亚？你怎么会在这里？"
    },
    {
      "id": "coalesced:8fcd28052279e166d04c86a3c0f13818871c2e3d243dfe83eb51299d6b70ed58",
      "source_sha256": "127091d543924e2f45067888a8013ef88f12014507d0f57b41d081e5a4194b3e",
      "translation": "你真的来了……露！我好想见你。果然，塞娅之泪的传说是真的！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b43fec4507acc5cfccfa356741383fbe024a1970c4ee8751475272f8a80133aa",
      "source_sha256": "d48dc0308343b8b4446f36fe7513f1e8656c01c09d2d1d6461a4a79dc5d0874f",
      "translation": "塞娅之泪？"
    },
    {
      "id": "coalesced:c0203035d5b696e4537152470f6ed1c77c52b12a66c31de2833ae24c8151287e",
      "source_sha256": "85840e3012f614df1c28a0c9221f372b73c4cb9f8fcb3b1b8bc14f234e08f9c1",
      "translation": "是一种花，传说能让人，和心仪的对象结为眷属。在马雷族之间，挺有名的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4a7826443da426adb310084495e9c1fd9034dcfc4cf6aca85a8f1601a9c2c65a",
      "source_sha256": "c09d8bce9fb8a9bfd504f5b96cfc249d292bf8a4faf390054a8807e636d0b81e",
      "translation": "没错，你知道得真清楚。塞娅之泪，只有在这里才能找到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28a5fbe465810d22c296c1e77bbd82d5127f8960855691e612ec356e117f5f63",
      "source_sha256": "d50733ad7f3d76931923ee4278c03d9f5ca4033358c253668e956e6262424fef",
      "translation": "你怎么会相信，那种传说？"
    },
    {
      "id": "coalesced:2fb7ec1fbaa9165ab23e4c64c80c8ff64f27432588606b702da4811938c8ce35",
      "source_sha256": "28ea7b9f3ec0a69658dcbc79942833f52265695ea3b94822c00a0a3339803170",
      "translation": "可是，你不就来到这里了吗……这就是我的心意，传达给你的证据。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:71f0aa35bb1551f378c4b27218a42c0843402383c6661e03fb82c035831a9161",
      "source_sha256": "7b601643937b1e060c99a62437e3feb480ac31f3aab6c6439e8cbcc70501ccd7",
      "translation": "我对相信迷信的人，没有兴趣。这里很危险，请你快回村庄吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b4008c71d15ae45f7a675ea69632259ec9e18c21657312d1b31b8d45df5caa8",
      "source_sha256": "a8a5810815ca7d3f83d326faddb855109eb99a6af688c022772b893f0af31d8c",
      "translation": "可是……就算再危险，我也想得到塞娅之泪……无论如何，都想向你传达我的心意。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fcc343a4ab70e4f940ddd55d5bdfcc870d1c05ba79de3dc3448f6f0602ba68c2",
      "source_sha256": "5f65a6d4b5fb39a86a2725a21eb9b3a5f31ae72a8002df7eced9099d13c14dcc",
      "translation": "是吗？既然已经提醒过你，我就先回村庄了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2b3b2b3906660ea39495a9bdd5ae840d86bf8767732d30f689ede9a7b2e66351",
      "source_sha256": "ee48057cce790fb78cb8d5ff0f78dde768d08f799fb93f4eb2a984c0d2a50adb",
      "translation": "露……你要把我一个人丢下吗？别走，露！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ee3f88fbfb618da7800d7ced1e1fcd8121a83df13df23882b5c97ec3e9d4ca4",
      "source_sha256": "a6bd81cb5cbd53c0f766400f36947a903daf6a8584cc85f09161b51e765e5e25",
      "translation": "不过，看你没有干脆地对那家伙说讨厌，是不是也有那么一点意思？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:db10fc4be52094dec895839f50b9e07c3b054df47d887e15625f5876c876b59a",
      "source_sha256": "a4043c8b4deddb8feb7eab8f3934046c05a4bde50c26ee951298059f51facaa1",
      "translation": "你在胡说什么，克罗塞尔？赶紧走吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f7be938f47e6302c51538f4b8c58f65b2403af47fd83e89234cc2da1e096a8ca",
      "source_sha256": "c7dceac17ba6397fe5750f3aed3b86760254f94abe7357e86a7fdda87a99288e",
      "translation": "玛拉基亚"
    },
    {
      "id": "coalesced:10a94cbb377d3eef0035334409214367c9b53cd4e36bf317d8b9e5202fa80bbe",
      "source_sha256": "c7dceac17ba6397fe5750f3aed3b86760254f94abe7357e86a7fdda87a99288e",
      "translation": "玛拉基亚"
    }
  ]
}
