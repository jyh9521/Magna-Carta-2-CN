{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:55f12909d8047ca99dd03a267f38d4824cefc0c0eed25374d64cbaf187b1ad47",
      "source_sha256": "0d10cc3d5de632ab04b6becf00e2eb1c2416188fb9e3a4980e9267c16dfba854",
      "translation": "大家都睡得好吗？"
    },
    {
      "id": "coalesced:de7b1058aad200e6607df9429880a1f9d46e9bc14b51d37f2f1b550b7895cbe3",
      "source_sha256": "211f6d086e9fa262389bda710203b691b933c397236291a9e7e711e3e1264c5c",
      "translation": "今天，我们前往贝尔福特的同伴要回来了。我想大家一起去阿巴泽特入口迎接她。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec81607d32945ce09a8d8ef1eab0c7b9bf0552a643b47bbbf7a4ce8e2345f763",
      "source_sha256": "4d539b5a07e221d4eb708f067eca9ff1ff7b754befd45607f054e54d876b6034",
      "translation": "咦？反哨兵部队里还有我不认识的队员？是谁啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27bebbb78b9b37fb58e95e86f11c440cb988e19bbef292438a6be8e31dbd9203",
      "source_sha256": "c5331c5a0ac87382e8603a7c312ecc49dddaa44309f30fb2c0f391ef0f1dddf9",
      "translation": "她叫“露”。"
    },
    {
      "id": "coalesced:69e53c7a3c005b1d50e702ed2bbc29f92aaa109ad18a569b81fd0b1c0f78e68b",
      "source_sha256": "cfd88827dedeea3eee6d1bacae48c6aff25c304fd50fb484f9347b40abeebfd8",
      "translation": "呃……那家伙回来了啊。"
    },
    {
      "id": "coalesced:c289ca37c2cdab237c14cee3ce4aabe9f071946e69723f31ae4953f7340f4d8e",
      "source_sha256": "3e149647a87cd7ca32d11d3d2926302d732d25e0de3db254e96543807ae993ef",
      "translation": "那家伙……？"
    },
    {
      "id": "coalesced:2208e5281478a1f3e0f3cbb3c9b22411b8c647bbb7d5d9f31d6cec06be6ced08",
      "source_sha256": "7f625d207b1f9a2ee7afa0976338af3182c35d395f4e937e8d5090f8f64e6723",
      "translation": "唉……"
    },
    {
      "id": "coalesced:c112e934cd2953a9571e226003a5cb756704dc8301eac5bb7dcc3f74accdf0bb",
      "source_sha256": "c0dd2cf8109cc38e88937204c1569cf66b95ce03db228745748bb0dd31e8ab16",
      "translation": "是个什么样的人？男的？女的？"
    },
    {
      "id": "coalesced:4fc298fcd02521f174577c75aa8a89aa6c7768a36ece1f2ce5b76116abf12d70",
      "source_sha256": "d2974f3ca818deb14d9a2367a8ca5bef9ff7db1dd06896a910ea89163ede5f3f",
      "translation": "是个可爱的姑娘。"
    },
    {
      "id": "coalesced:7c98f6e5be7ddb8808131dfd98c75820a8e3cd8a52cca3290135ff05d554fad2",
      "source_sha256": "08b6d6b94b542ee676b31cdf148da893cc0a875575536ce1910534c570b61548",
      "translation": "她哪里可爱了……？"
    },
    {
      "id": "coalesced:5473aa85992e4a1653ef7d11aa25dd4f4cc5c7015974b5f1f041c5735f1334c3",
      "source_sha256": "e7e3f5eaceb56d66cea97e8a62ce60c49902e8bdc5b365c23b76aa5801e52a32",
      "translation": "那你是要我们违抗公主的命令吗？"
    },
    {
      "id": "coalesced:91531947377d999e3d496b16be1f10ae40f96ee7a89895015675f88f54433118",
      "source_sha256": "0ceebd0c892928ee751f223de701ca8a7fb748c098a2e37345de03e36e71fecf",
      "translation": "还有劝说这种好办法呢。你们两个真让我失望。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34eee93eb67eb49fc14391545b65d556db044a0c1ef6c2cfe55dd2113f5c05ee",
      "source_sha256": "7b4729d4910bad2e43a870e6ed363d5089481569204cf38cd052c89a76e99350",
      "translation": "露，是我自己要出去的，别太责怪他们两个了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5b2512211625a0d76a873ef7804244704eb816ed7af3b2ab24b7bbfe430c983",
      "source_sha256": "fd7622380f8aa7291db74976f6bee15445eadc8540e71f7a048da81edadf9283",
      "translation": "大家为了保护我，都辛苦了。"
    },
    {
      "id": "coalesced:8f26c8d92080df7b04412772786e48c552afd91f99f8e5fc1697e1431f982ccd",
      "source_sha256": "a797264edd85e302e9f28ec70c09bca0313d5e3c526de62399b6a9a86d2f39b9",
      "translation": "公主殿下，您是否也该稍微有点身为公主的自觉？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ebee804ca7b27d53c2329b2438ab6b2c523989efad042e5536a370d151dc4275",
      "source_sha256": "6a11434cffa867f7ac3f62a7f873e2c2adc1f004b78e6e4661ff3bd5f5067584",
      "translation": "倘若您有个什么闪失，我可就无颜面对已故的先王陛下了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aec960ffbe15abce4d9fab93abf443ec48f585bf959a5a946a7760548cbc3674",
      "source_sha256": "183a4865336f0e80be58c6e8363984437a41d945b1f4d7a143d128ed3ffa4df1",
      "translation": "所以我才不想离开公主，前往贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:965bda8424802f357a1733ca306b1f93a017ef1d980ff983c31e8c52726dfcb9",
      "source_sha256": "3b8ff0a51997ff434f86d5bd83e918801303de57f9cbc15d96bc4adf14939b93",
      "translation": "好啦，好啦，我知道了。露回来了，我也能放心了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:00166da9a0a496390c98edd5994cc057f05f8cb505c83fede48eae13bbc29c4c",
      "source_sha256": "2d8137a9e822152d56f248efd57e83b133a8180c66d4ae9fa62ef3b73456c690",
      "translation": "真是的，少了我，就什么事都办不成了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a140c4e34e754d1d6cfe2e8f80387fb71b72c5d095d493c32105b5c8ceb504d",
      "source_sha256": "0830990f0a1b2ed2e579bbf01ccb90e024a16bb0d732d03a5df23c497fc3bb08",
      "translation": "啊～求你别再念叨了，行不行？真想把耳朵堵起来过日子。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:331e3bd1852273082b30f7d12ce1d034e7af068ed12d77aa31d30392ba0ab7fc",
      "source_sha256": "8d176ff2b2522c7a593ea81705fba7d5f400a59fb092508302c261f3527f973c",
      "translation": "哇，真是位帅气的姐姐。明明个子比我还矮，却这么厉害！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:10605125621d5fef57b9a78f17f4e68de82690bfbcf43e297cea93c4f40fd39d",
      "source_sha256": "eb0f209f25b6b8acc5fec302205a1cc244e703a25de808c777559721e283654d",
      "translation": "冒昧问一句，您是哪位？"
    },
    {
      "id": "coalesced:cf19be29d63d8e8640d49c025cb1a762cd6fb6b2152d9cd7ca7eebc642199ab6",
      "source_sha256": "7e2c611ffceabec8ab48f27aed02c5ca485f241ce30c32e075ede38f01cf3bb6",
      "translation": "啊，忘了介绍。这是新加入的同伴塞蕾丝汀，是马雷族。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e6652998bd279d013ccb8b8a60cbb0a48223b3f695b9b4e38dc84617aa62cb5",
      "source_sha256": "d55830d2ea8e2d8b07b1f05307bf81fc9f8a7184a151cdfe4a8eba1ae2ffa15b",
      "translation": "塞蕾丝汀，这位是露。同样是反哨兵部队的队员，也负责担任我的护卫。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e391ffd87256e75b9da5f068b785acc083c7f30d26aea8891924460d85023791",
      "source_sha256": "dd87ccbed43d1301e54e996d67b3a10309ba2c5cd41355e682e7e23abff89276",
      "translation": "露的战斗本领可厉害了。"
    },
    {
      "id": "coalesced:638fe8475ea49e984e6c7499c2c7942535e608729df590630a2e8bfa39b5d949",
      "source_sha256": "28501f5619ef771ad99134962a9a10078f56e0557f4b5a9ecda0ba05fee04366",
      "translation": "她之前一直在贝尔福特侦察，直到现在才回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ede7b75e96549e83d7c28c256434639c9f37846d066e0a5c5695c728d95fefc7",
      "source_sha256": "5fd25bbd492acb6eaa062f68ef56dc6c20fe93b75a9bd63944d4ce827cbafae6",
      "translation": "很高兴认识你，露姐姐。"
    },
    {
      "id": "coalesced:f9de1335d01c44a160397cb631020a3f698e518dc265eb346992878ce9d2fe57",
      "source_sha256": "ffe0c2d88d2bdd17dcbe9591fc9ce16c7f6caa356b7e28c52751819fd99b9feb",
      "translation": "很高兴认识您，塞蕾丝汀。"
    },
    {
      "id": "coalesced:c8cb13e7b1f11b860d2fc7c59d9e40a1d118e91769f4a487304744d0089d31cc",
      "source_sha256": "c22caeca743bcf8eb66bf9b96a021c88f56a93b2d498d3d726f03f9616c2ab68",
      "translation": "嗯，还有这位是朱特。因为风息岛一战，他加入了我们的部队。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b1121c940f34d254b0d181d168f29983f47536dcca34741833d09c28e80d2ea",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:0bd172cdd7553492eabf05aa901d796ef5ffc43b050aa0026820e4a81f712c3d",
      "source_sha256": "00c58d5d25d6eec18bfaf9252a839222f3a0cc1ec20b75f9d64f5d610206cf64",
      "translation": "呃……怎么了？"
    },
    {
      "id": "coalesced:6a54049bccfebce5b063a9d512ed665a325eba72e52b15bfe80e84a3ae6545e9",
      "source_sha256": "af2d73142f9e77b767ee08fbf612412e21e1ce8d4d2777a0f1785acef02c7eb0",
      "translation": "冒昧问一句……我们以前是不是在哪里见过？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:053c8ab7f250eb97b975fe58ae8e4d120fd3dabefeb9b02ca453fe0dfcbd0041",
      "source_sha256": "0cfab5cbe7caac82596f968ffe28c8e86947d0127ffc6ff12033772df1074d4e",
      "translation": "是吗？"
    },
    {
      "id": "coalesced:09ca39f06a970ea88561ae58c5adf57d15b39dc908e90ea8cecfbcbddc5aa069",
      "source_sha256": "abb15f2224feb75c095c910f55782fe626f2d7bb5a94ce8d843b0bf0e4cd5347",
      "translation": "我……失去了记忆……你还记得是在哪里见过我吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f1e96393fdb2395925cc7d4b9474f68ea7a93923697f8acb9563f5fb2cb4bca0",
      "source_sha256": "f1b57ea994e56912d950b29968e73850fef4bbc5da120b1c3b1d82125c2719cf",
      "translation": "完全不记得……看来是我认错人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4ec4798d4ec999a05c86a7dda53d68df7867435c1376525cef6b9cda09898436",
      "source_sha256": "051e7f6570cb61e6f0b5aab9d91d3b50cd756074febca5580e82d53ae409aef0",
      "translation": "总之，很高兴认识您，朱特。"
    },
    {
      "id": "coalesced:177dcba30418ce0548c5dede718c812d6cc4400cb2b31bfe812e58c39a2bbf1a",
      "source_sha256": "3b0d9826e4237e54d8df9853c1c3951be03135aa45e5e5a7181f7090ba9eda9a",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:1615fcbb8116c5c2bb6b316e09bcc24ff780a0cf3ddf12a81818dc2e3e8423b3",
      "source_sha256": "1cb240cf060ae42cc2806f2c24cabb74e6afefc9237e4068bd4d78799907b76c",
      "translation": "公主殿下，请先随我前往总司令部。我有关于哨兵的消息要报告。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4223d7830286662e64b9289e6422e5c22fb88f57ec796c709e8c9bfa7d292970",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "好。"
    },
    {
      "id": "coalesced:682d03f352b7ed1e41c8ffd2f347daa3083f8d609f1194289554e9fc8e1be96d",
      "source_sha256": "6bf45c8d028948936d74a1fbdef0582781f8b690bece4245a549d3e619332d18",
      "translation": "听说各位已经知道，制造哨兵的材料，是将人类等生物合成而成的存在。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:17236aeb48a2676bdbca063a972200461dd73e58ec5afd37fe78d96a2c335636",
      "source_sha256": "8d019430c68ea5fb7bb3ec9fb58a17d8c36bd03a8bf5e32ea5bb4eed382b7d25",
      "translation": "而制造哨兵所需的另一种重要材料，就是卡蒙德。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2547ba8bbcaa5acf85a948346e66e1ad77a3b86e621da7929b94caae75c67262",
      "source_sha256": "f3f1e42b0a580a5b3b292b27fa3151da970a0a964dfbeee410d6a3951e2f0fbf",
      "translation": "卡蒙德是容纳KAN的容器，对哨兵来说，相当于心脏。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e6c0eeb4e041f00fa5d75fcd071362a040feac426cc7139388d23c7cc0ffcc36",
      "source_sha256": "ca1cc31144f8cf0dcd91f74e4330e9049599b12a674d4843f2b3ff4df3ef41f8",
      "translation": "要制造哨兵，就需要能容纳远超普通卡蒙德所能容纳的KAN的卡蒙德。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb71b70c85f18c8c36578a37da0e9ae1f4bf155c9937a48d504740fbf08dfef4",
      "source_sha256": "2b370cd4d8e72dfa7afd886ff58dd189cf88fc39647c12e658208854aa104889",
      "translation": "有了这种特殊的卡蒙德，哨兵的能力也会更强。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a1de2232201066a45a2dd483217903cce11fc35273b59edfd5050f0d8fff1ba7",
      "source_sha256": "6404c84b9c8018b0611a5090ae78b4edf937f11a98f5cb79b0d564da836d1aa6",
      "translation": "之后，以命令支配哨兵的人，也就是“主人”，会施展一种叫作“血之契约”的连环术。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f877033e7d44adbc79e251dbb3d55f4dad612e30d5054755925887f8092e8c7",
      "source_sha256": "29306c65843abb4d3d35a6afaf997e1064dcca708aa58d9b8820c4b5d03d696a",
      "translation": "通过这种连环术，将主人的一部分KAN注入哨兵的卡蒙德，再以主人独有的刻印封住。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5557e88796fe171a065af547a5558737d85b53cb1ec166a3839211b9edc7d10d",
      "source_sha256": "2e9f1b683dce8e96c17ad79cd4698b296c106ae251f649d9e603dd0910218512",
      "translation": "这样一来，就能为哨兵注入新的生命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:936aacad041e65a6ce43e9fe5f83aa19885dce7b66808cfe7e4523b23140d365",
      "source_sha256": "6dd44ed5bc140c4948a169cf2de1867d2c5337786dba3628ce23c9cb0b86d260",
      "translation": "此后苏醒的哨兵，就会成为只服从主人命令的存在。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34514db62ba9335cd416d1ab697344fe439f7988c0ae3bcdd709b55f12efb9cf",
      "source_sha256": "e4948494888b045fb95ed964864af5092cdba4e362c3dd3656db27b23cba3719",
      "translation": "血之契约……你也查明了施展这种连环术的方法吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b97d3b5ccbf212fb8ddcb306fd8c17c55bbf2853332137a5358f18117b1e8f5",
      "source_sha256": "10917dc6c93c5af2d48f89b0c46f83c557169c76b2cafc6091cee54d94bf9be9",
      "translation": "是的，这份情报也已经到手。即使在北部军内部，这也是绝密情报。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fa42642e7c9d99b8a53d938d57b8faabc05aae9d9ded01329488e7e4edf5385b",
      "source_sha256": "97649bad0be4461c1aa51f7f7ee3dc87e669c16f14d5af40810b1185d686d774",
      "translation": "不过，这种血之契约，一般的连环术师根本施展不了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2634e3e1e08d3cea9af3bf81b5d00a2a3f4af009e5a9a6275b85277b1b8302ad",
      "source_sha256": "f5ad3225706707f8b85399dc821e97090f3951f478168c5a6aa20a1fce191b5a",
      "translation": "因为必须消耗相当多的KAN，才能施展。即使知道方法，也无济于事。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b6aff042c2270002f10c8d0f33d23da8a519bcd440dbd999c607a9ef6f28903",
      "source_sha256": "d57b4d9893dc24f9cd29c520570f19d0f68b491ef0fd3f786d2fb7ff2d810423",
      "translation": "这么说，能够制造哨兵的连环术师并不多啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:280cb9ce04dd980bc2d49ac5f72a396035b79fabbd65d132efbe41382ce3ea30",
      "source_sha256": "0adbcda7d69902c6799e0b86df0f0b3580982b74ea9cad1315a399e5220046b4",
      "translation": "可是，我听说大部分哨兵都是修恩扎伊特制造的……他竟是那么厉害的连环术师吗……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f8bb89281d66b49c7f29d007192c0ab069312549c721a8682f2543890c4e215",
      "source_sha256": "ea404238a945977e81d37eebaabf200202ca2dc3bd33955eab21af280ea031d4",
      "translation": "我也对此存疑。毕竟，我从未听说过修恩扎伊特会使用连环术。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7e8ee5a34c64d7edb721e3f531c64dfe2f7df69af25961a2cf95ad646b7992d8",
      "source_sha256": "ae85b222acfe9dbe344620bbf621dc04e2bfd5ab5d57c995d5206589a1a34365",
      "translation": "也就是说，只要能施展血之契约，任何人都能制造哨兵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68a12948c1a0e7596586409d51bfca1b865b3b672d7101354a47a97db085cf90",
      "source_sha256": "2503772e0ab570427ee13de228b167fb2388720580060821d3ee5b3847570f0c",
      "translation": "当然，即使并非人人都能施展……这也很危险。"
    },
    {
      "id": "coalesced:e17f9e469155f141390052d74b6a86a6dcc8859d0a7737dc59d65ee647c88f37",
      "source_sha256": "da8c110b2e4dea035ac9966429ce0ca7b643a8925f64f81ccaaf041b3efb0718",
      "translation": "露，还有其他情报吗？"
    },
    {
      "id": "coalesced:4441f93b631d1c78b5e09520ed581f0bb1607f5d171fb1abb96a1d57761d7f46",
      "source_sha256": "ed056f6e716b0114ef54067fb59ab946f6359d796576b9ad673ba68fa02e0a18",
      "translation": "不久前，我听说北部军已大批撤离风息岛，返回贝尔福特。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbf10cca64a9fa49d4f1b60bcfebcb77ae695291cdd4ab4666252f1a236e8a4c",
      "source_sha256": "b69ab867c1feca26228c42847dbc6f0204555707d3d5c6f0a0394d549483f081",
      "translation": "岛上的守护者也早已被运往贝尔福特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3dba2437d5244b153e3aa04c3a40c7579796178e837d1144b43953df7f436e4d",
      "source_sha256": "6ecf2efb5957fa179108b76d06d6862c9de959e1c1c2bbeb7050b47fd920b160",
      "translation": "……！"
    },
    {
      "id": "coalesced:ca5a069be3fa59f34e688c55b7170d445a72ee52369120e5a97dfffcc30de889",
      "source_sha256": "53c0de04c21b1079c6513d19d7266d04425c14b02632dac07e0f41858f91c79c",
      "translation": "北部军回收被封印的守护者，似乎是为了研究它的能力，制造强化型哨兵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66e3cb72737719c4909494df6703d6c595a318132e3124f64aa60cf227142982",
      "source_sha256": "515fd13ec444b0de3d34aa4c55ce38dc72a176c18ba8b3bc65b2b79098d22e2d",
      "translation": "原来如此……"
    },
    {
      "id": "coalesced:8c7f0487555986c8144eadfebc94006e063024afebf2bf246f085116b8110009",
      "source_sha256": "ff555bbf7f7ef148b444be64373a964a38160456b1590a8ecb911d21bbcf5ad4",
      "translation": "如果出现比现在更强的哨兵，我们就不利了。看来这场战争不能再拖下去了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0250a71bd557b7ef7f82eaf28b9134d41011489b9db9a6254e6e866f26ce5dee",
      "source_sha256": "7ff6c6d09f66ccc91049215206c8e14b8710965ae705365d2d938a84b7959e50",
      "translation": "是啊。的确如此……"
    },
    {
      "id": "coalesced:c6b5f6291eb491440676b9963abf6db6301d49aebc94900162c5c2c4471a057c",
      "source_sha256": "927947733a990fd50bc0185f14aac15b6f747b8764140ea130f6adf75749ff49",
      "translation": "您为什么事到如今才说这种话？"
    },
    {
      "id": "coalesced:d5ed91eaf771b8305a856b9a75bfddaa629f8fcd39b06e843a718f056428b336",
      "source_sha256": "8f2fbe0eaf2f4cc3fc4ff3f3d642a39f97c7dec259538499c3cb827ce388e8d3",
      "translation": "如果北部军确实如露报告的那样撤退了，现在正是夺回岛屿的好机会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c728f2eb88a6802fa7fa4cf950b89f386152794c51cb963ddd2b94b0311527f1",
      "source_sha256": "7789fb362644617fa2bfb14089c1fc952b61aa207f1605826e261da46c056c54",
      "translation": "没想到，您至今还对风息岛念念不忘。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ec143138cb931ae7034e7ab86aa1cbc987a1d2b219e5306d7ce48e275b751f21",
      "source_sha256": "9057b390b21216c4d1e683c3d3feaae215651e908ed9c243cba1aa2989198161",
      "translation": "岛屿是因为我才变成那样的，我想负起责任。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:474d4e17fdd35e8d5528399cb6c447bae4790a43ce118fd17825148c3d2cbab4",
      "source_sha256": "cdad66d1f766b4ec3d999168c45ace512241ac06678aeeb5910f09a0efc3e6ed",
      "translation": "责任在于没有及时派船的我。"
    },
    {
      "id": "coalesced:5cc7e1a5965c983665a7d87473f7a9f91d2346db629bbf669f86a9240ed56c09",
      "source_sha256": "e0dd454cd31cf228fee7a5a75508fd940b46e70f844303e4859502b6017fab0f",
      "translation": "况且，既然北部军已经大批撤退，岛民应该也不会再受压迫了。事到如今，还有必要特意夺回那座岛吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52514a393ab9162be092495858a935010c66fbbe39fd069e1da4af233f28bb7f",
      "source_sha256": "951b93a2d86ddfaea9f19982acc1c197026023349c995941e1df03ce31938316",
      "translation": "可岛上还留有北部军。"
    },
    {
      "id": "coalesced:035629b92f52cdd9fac205d48b134f3b671a3692ccdefdc54c37d8d288f74869",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:99405516b686e1ab19d47e53c71304ed20b1631f491cca376a65918e093ca4e3",
      "source_sha256": "748655e5187cae278d125d54d70cec07d09940181e026a147758ec41e29ea787",
      "translation": "说件别的事……听说最近北部军有一位叫梅莉莎的军官崭露头角。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:889b441c85b46435efa544267b665a6d4786cd6d726147e7355ab48fe342a79b",
      "source_sha256": "f395ea9d1c9d6f94a362788cca99e4f4e399a07a5000377818f05199fdfa31c8",
      "translation": "传闻她出身风息岛，公主殿下也认识她吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:41330da9863f87e359b1b30d3c796f3883f0eb928de26a4f3bb97e89afc0b689",
      "source_sha256": "90764d12194eaa0578d18c2cb365264d2985c65d2201a3cb7f48afd9cfb885bc",
      "translation": "她……对朱特来说，是家人一般的存在。"
    },
    {
      "id": "coalesced:6427e5f3baec7312aa3d369a62d425df5c9076fcf6cee6e136bc40f48ccd10bc",
      "source_sha256": "6b56575b083a5184723d813f570f50b5e0008e9bb63beb01a9e17fafce248f25",
      "translation": "啊，原来如此……那么，朱特很难与她交战吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d5f17c6156cf87b40e65c4d0d09142bac9cf940ada3f28d468227a9723df57ca",
      "source_sha256": "1eb66b6df1592469879669390b4e7185cd4521c07eeafffddd736a3ac142d0b8",
      "translation": "谁也不愿意和自己的家人战斗吧。"
    },
    {
      "id": "coalesced:2bcf2cbdf16403be5acac63629d4fe7b4acbf282db88e2b38dee6ee3c7e972ba",
      "source_sha256": "029c51d66d54ff0d6a1b2b946b234ccb75352393d58b00b2823d0d6ffe056808",
      "translation": "您想夺回岛屿，是为了那个人吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e73eb6855334f03e6c6859db70408ab015094b9b6da1f07022476d70b81675ee",
      "source_sha256": "14d6c0ab3adcc6280ed5973b8f39f7f4c472ad53a4447b87f52d0ca92de215f4",
      "translation": "我想为自己给村民带来的苦难道歉。毕竟，我丢下岛屿逃走了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7206168e21c0a9c3f5688c2d96aa4d38ab509a5160c21d89d5f9dc03525f68a3",
      "source_sha256": "3e35c12f6a49033e9119973f4b03e14d78a23bfcae0ace61e20d38fb3771afc9",
      "translation": "对总司令部来说，那也许是一座毫无用处的岛，但岛民同样是兰兹海姆的子民，有权得到保护。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a3020fe7833b7c2d0f1130de44e70f197b7e23e85fdabb94d2614b029a7bd72d",
      "source_sha256": "98adff6ff9607c66fdecb0ac32d2ce41ba83edc141d460adbb31da517c4c5c2f",
      "translation": "拜托你了，亚历克斯。"
    },
    {
      "id": "coalesced:c10582def7385b181f8b7066d30b236ffef8eb0a9839a63209aeeccc32836c27",
      "source_sha256": "eb4a91a323a631c5760f0b49a6ff5895f568eebf0a39da3971b92bd7f156c68b",
      "translation": "在准备鲁哈尔特战役的这段时间里，应该足以夺回岛屿。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:65d3f9a3ccce2140f517a23b97273040d953880ca3d579771bcaea41ed0a6663",
      "source_sha256": "d4efe2937890babab39249cb9240878fc27f47b1bf11c1c1472635ddd8955bc2",
      "translation": "只让反哨兵部队出击，不会给其他部队添麻烦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a5b0e04d5c7095c41dec401e3f7df79c389d6558561159561b9f7baa6d8edf7a",
      "source_sha256": "ffe592a0e917cd69bfadf301bb21eb42a71d0122d3f7c44422a31824f5d58e48",
      "translation": "不过，我给不了您太多时间。如果拖得太久，我就会立刻派兵，把公主殿下接回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5cccbd28aff0957e2977b89ca5afd62d1d2f99d1e1ad1f4dfc17bcb4900fa85a",
      "source_sha256": "13742c440c7cebd0585d4eb25c271e2251acf2298ab2b692f7054353bd7129de",
      "translation": "我明白了。谢谢你，亚历克斯。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68790896f6e30138a2b006cda54a9c14ad08dc9db5d1981cbb6cbe99640f4f19",
      "source_sha256": "8a91f1ea28fe0474beab6e7a1ad2dca0b78a1d8051a1dd95c0ebd3e486714a25",
      "translation": "真拿她没办法……"
    },
    {
      "id": "coalesced:5601d6eecc4703802c8c0842123c404669da9a88800192bce14d381ea9ff6a2c",
      "source_sha256": "5f527d5f924c527ae2faaee65d1811a674954143bd89e3fcec7b2a3a17a06f3e",
      "translation": "每次都只想把力气花在毫无意义的事情上……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6d288765fa4f3c6add6e2cf172c855aa5808697077653bf87e4590511eb69970",
      "source_sha256": "80da13389c561c59cc86cf6f4bf5fd0d433ad3e3bea10e190847b5edd4d691d0",
      "translation": "岛屿还被北部军占领着，所以去不了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:496fc9a2b1d36c588480c88a553ac5cd105d09bfa7afa87225a8483a48f20cc3",
      "source_sha256": "dc2bd4170ba80f2311def68586420d35305f49c123c69223ee113a388beec631",
      "translation": "求你让我去吧！！就算有危险也没关系！！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:828cf60af616af661d34eca04b6ea287e20065284591134574e6b1fbda5a1fa2",
      "source_sha256": "9238d803ece7535553f59e49e2cec689cbe6257a215b8a889e63afc36e963ea2",
      "translation": "船倒是能坐……"
    },
    {
      "id": "coalesced:a31585deaf08392ab47ce18a6a26b7273443c5910073ebfe36ebd99b6273cb72",
      "source_sha256": "d6f5479ef43a12a25f1af1d07a372a81f4dbd92478a30ce065a9bee131f96c3d",
      "translation": "可听说只有执行部分作战任务的军人才能乘坐。什么嘛？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c296ae486e25eeb2b08b8eed7a42cc9d8537ee370b12bda53e4bb72ff42c33e7",
      "source_sha256": "be39c3e1a8be6b0e78b2a04f9f6dd0fe8bf928c55e569c1d0e7e1dbc06d78381",
      "translation": "我还是先回家，等恢复通航后再来吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb272b040f82e8e9a55be0d33003098d8970af5106b09ab35330bbaa70ff96e0",
      "source_sha256": "b262a622c120603c0659d3b218ec1a2a7db63eb098ab55b1691ebaa672abddc0",
      "translation": "再这样一直等下去，我都要变成老太婆了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44681511d79824e117a60e6a67056417509706fe3e5b88fb4923b1dac9e3ca14",
      "source_sha256": "a544cf47b552ee672d975ce6f46abc31b98b3a36b652ef6aad5cff0dcfa9dda5",
      "translation": "既然说都是为了安全才禁止通行，那也没办法……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d661e9d0576c676b9b9c496fc19f69092be3861ae166503cb455985789ebbd39",
      "source_sha256": "dfe559b78ce7ebcbff344d6c575c806143d852c933126795a855654cb3673aad",
      "translation": "您准备好前往风息岛了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4e09be04dcef34189c87ff5161faf1a53d1456d75282225f194840edd7cc4fff",
      "source_sha256": "af4cf56c29c963efa29537ebaa2c05847911b914c11d0799c62562ff022b6313",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 准备好了\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 还没准备好"
    },
    {
      "id": "coalesced:b49d63b1bd688b7ff20f3c5fd376e309bf8decf1beceb69fbe1e480e563d8a69",
      "source_sha256": "c6e18ae4132fecb21cf8110602f86c578da8bd0156282f06ba42b120e92cce91",
      "translation": "准备就绪的话，我们就出发了。"
    },
    {
      "id": "coalesced:c9f40c767be915676b69f3dade4f2e281688346f37f04b711597ebf9961d65da",
      "source_sha256": "43eb54f7d6a4bef1e5526fa650bf73dc9eec4f5f7ff1af0dbc906ca04e838e9c",
      "translation": "您还没准备好啊。等准备妥当后，请告诉我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    }
  ]
}
