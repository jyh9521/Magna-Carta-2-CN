{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:913ce46c5128aa19b01a32d1787aa00f0e15cb53e39c671b8b3b40db5d46bdea",
      "source_sha256": "db4555f344a2c4613d552588a8b22989c621949e6c7c638b7115f2d691c3d50a",
      "translation": "啊啊……我需要男人帮忙……女人不行。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee11ed5cc9eed15cfa5dae7c4ff184e9c2f00efb16a5e40cbeeb7c035ceffd70",
      "source_sha256": "1e7724d5ec2b49017d74f0b6cfe1767db9268ee7ace7294f6ee1ff48d4e50dc7",
      "translation": "我正好需要一位英俊的男士帮忙，您能帮帮我吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2ffc60d2d10e2880e9cf8db427b54042ab1e18fe8e9c4d1ffe4f920707f0ca19",
      "source_sha256": "e2fe99b6c43c1a6e3d604a8f74d95c11a9439a6bef8a65b680b101adb40a7cad",
      "translation": "其实，我有一个喜欢的人……当然，他也喜欢我。肯定没错！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ff27425923c31398cb546042a9f4cd39df1bac312178ee476fd226cdd87a524a",
      "source_sha256": "227246a9f631361f260d5e781bfcb117f1178dd59ed8a69db0fdac56a82a8ea6",
      "translation": "可是，这个男人就是迟迟不向我求婚。我一直都在等呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22b1506e97ff3c55376aacde096490a4c98ad98692603cb5e3c4d265f1a7d771",
      "source_sha256": "2ed84398ec94d7658bae32547ad76041f6e83482eeafac668f3324180e9b2174",
      "translation": "所以，就请您拿着象征热烈爱情的红色宝石，",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e8c555865819a5cbcae3d9d20c1c1004441df950280013a689dc82d407773db9",
      "source_sha256": "30827f784ffa0924dd4caf77d02ead8fca16fd608948372d26bcd5221d7e747a",
      "translation": "当着他的面，向我求婚！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:25826728884105d4130ab71e92d7d55034d9e393c4636bcf2bebafff7714b11b",
      "source_sha256": "0d4b374a69d0a2bdd413fe40b1a9580d7d77c3b2affa483c70d819392296709b",
      "translation": "这样一来，他就会大吃一惊，向我吐露真心了。"
    },
    {
      "id": "coalesced:d5cf41d722248d0c4e8ad7dbbe4a825af8a9892333f669410c4cde4398ed0af0",
      "source_sha256": "599ff5fb135424863dad61cc05f906e93e302de737fd058229f2151ee81df335",
      "translation": "然后我们就能直接结婚……啊啊，多么完美的计划啊……"
    },
    {
      "id": "coalesced:07306a7d4fe474f85b03ac9ee451073943e14709ffcdc913b76c8573a518234f",
      "source_sha256": "3382e683fd23497235fb359b05e38ceba50a698e65b4c80792e2a96d3e806c6e",
      "translation": "您会帮我的吧？"
    },
    {
      "id": "coalesced:8c3cff4f5937f791304cf6bf0c2d037fd8f91e047bb7dc1e99dc3cc914702150",
      "source_sha256": "be134fe9f149c9f9d530b1edbfc918937229440aa884a8fd352758e6849221e3",
      "translation": "首先，得弄到红色宝石。"
    },
    {
      "id": "coalesced:dcb8b70915ed48a56d79ab4c3822d88b06eac989a762c03f70133ebcee9f6a53",
      "source_sha256": "8c7ffadb995eeff51e142cd46e2ec91ac90013937373c98a93b0bf3fb19fc028",
      "translation": "南边星光平原的怪物身上，应该能找到红色宝石。"
    },
    {
      "id": "coalesced:eab78697607a9a0c78374feb844ac2f49e1c6a568bd5ccf5a6198524b2409e48",
      "source_sha256": "6ff63f5d15f0977e25ec026d61d312349c3aca3bd07458d5791957a5a40a43ba",
      "translation": "要是您不肯帮忙，我的人生就全毁了。呜呜呜呜呜……"
    },
    {
      "id": "coalesced:c7c8ba299f8a57e001e6d07677ff4a9ca4796418bf7b972e38476936d9fe222f",
      "source_sha256": "99fa124cbe8eea7333d0a7878d769a8d6c4edfd0d899860838f8a958feba9f1d",
      "translation": "南边星光平原的怪物身上有红色宝石。"
    },
    {
      "id": "coalesced:2fd56bae2178b3900cd9dba6e021693ea9ba7a479074e8d5d17ef161599fccf2",
      "source_sha256": "adc7af33c0d762f2283a5f7f1e02fe73a0c84c8136e30cff114ca90bb5d1f678",
      "translation": "您把红色宝石带来了！"
    },
    {
      "id": "coalesced:cd8e9e002c18f0f24f42949407f9d3f1d6f6eeef6f9a13407d99f465bb1f4f27",
      "source_sha256": "61899ebf11d2a45fd04098bb1be4293cd35c1be26e9bef9528ee4891a29d4c17",
      "translation": "谢谢您。那么，开始下一步计划吧？"
    },
    {
      "id": "coalesced:2271bec035699db9ffa4f1fc67527a920e7b5b89c2d5f6473f858038881b9682",
      "source_sha256": "0321fdedf972c99acf321b38148d176e4921e542233c76502ea314092590c7eb",
      "translation": "求婚大作战"
    },
    {
      "id": "coalesced:671e9e81f6a2c1e624bcb4637cb8aea49f7661b8f339915b370d4cb6cdb9e5dd",
      "source_sha256": "86ad922b54d163d6f2f75ab43ede5798cb4a8b9edae4cd2521c61bbb9c067b6d",
      "translation": "为了帮助一名想让心上人表白的女子，从星光平原的怪物身上取得红色宝石。"
    },
    {
      "id": "coalesced:7adc39bf7cbc2ac6a62ebfdcf503d8bf20e150906c65e28d7962af2c938d0ec9",
      "source_sha256": "2db92d0eebe8d1d83ca32394fd643c2ef4776dd5c319ff3e1f56785ec21a04d4",
      "translation": "Quest: 获得红色宝石"
    },
    {
      "id": "coalesced:c2c5778c9531114b29d3ce28e66d125e5be07bfa8cafa544893dbe889c6d29fc",
      "source_sha256": "ed057513269dd0aa2babf40cd4cd78b49c23637a61822c868fdbee865250c9db",
      "translation": "获得红色宝石"
    },
    {
      "id": "coalesced:3e5bd352574d51cf8cbc40c27854ddbf3bdc3fe0515058fae0e333e9ad12cc70",
      "source_sha256": "fbceade9f6a70f3aa4e7db1770a00c4e8d52cd1dda77833e1de839ab221eb5d8",
      "translation": "啊啊，我需要男人帮忙……可长得像怪物一样的特雷瓦也不行。"
    },
    {
      "id": "coalesced:e6c9282659a9fecfbf01013e2fa0def73cac771d09ae7bdcddb769cefa25ec8b",
      "source_sha256": "810567f640577509c05f0eb24ec2a5116a579be7be1838cee85f6cf561292c93",
      "translation": "我需要的是男人帮忙，不是女人。"
    },
    {
      "id": "coalesced:7565489fe716826e8954a9b098b24da82342f3df769c182f729028e5c6e41b05",
      "source_sha256": "b653a1ce0a46b55a9d5cc85e1c926421f48fb461af34c32ca0e44efee3355a49",
      "translation": "那么，接下来我会装作若无其事，走到那个男人身边。"
    },
    {
      "id": "coalesced:ea24e408fc9eea35faa1ddeb3319fdd6be509e5d9352eb09a39242a7c95ed33c",
      "source_sha256": "48f98c691b8b5f88e1efdc0b0f8219d9f287db6f33ae3c967d25e8fedada678b",
      "translation": "就是我现在看着的那个男人。您看清楚了吧？"
    },
    {
      "id": "coalesced:3fe71cb42248d498e41445b219c65a912609c13a9a60aae1f249363655d297c7",
      "source_sha256": "374592c5a26a0e5380f25db01da0d1b31c4e6e7116a02633c6989a2166cc9e90",
      "translation": "等我站在他身边时，您就过来，把这颗红色宝石送给我，向我求婚。"
    },
    {
      "id": "coalesced:2b7adfd72afeb0f3ae0581933c76261391727a4e1e5eee6ecd77a2fe8d5d6ef7",
      "source_sha256": "29686ca503d3a8fbf2e8d327891da44a50484facd822a55c178ac181d34e9149",
      "translation": "然后，我就假装大吃一惊，表现得很高兴。"
    },
    {
      "id": "coalesced:e8f91d7e03da6577a260404c33f0581a4f9a8d4f3cc507f547307064405a7e89",
      "source_sha256": "4d00a4eecf9055c7f8a384afdb1ccca61a3baf544c1122d45ae1b4afc9123057",
      "translation": "您会帮忙吧？"
    },
    {
      "id": "coalesced:db3beb0b970e802a35dd6b05a218ce8eb484bfcdbee50a96c578889aa3916c9b",
      "source_sha256": "fa6e1b99dbfd9389cfb8a0eb31b692cbaee91ba97ec5185df246d4ed925bb486",
      "translation": "哎呀？这是什么？这颗美丽的红色宝石……"
    },
    {
      "id": "coalesced:f12ee31e63c771c0f08141fe183f5a7d52ad55502f0106d5195bcd2499311284",
      "source_sha256": "6465014c9848fb0d20296ad73191bb59279dcf92ef3bb0b54bf5ce26eb99fa19",
      "translation": "这是我的心意。我爱着您。"
    },
    {
      "id": "coalesced:38b3ba25914311dcf8feea34456b2b7329ea9a405def54d41c5f88d68bd34a7a",
      "source_sha256": "4cb5ae9fcf11ad2f2262d365754458ef49a03091341a11c13b9deae9169b9e98",
      "translation": "什么！？啊啊，太高兴了。这么美丽的红色宝石，还有您的这份心意……"
    },
    {
      "id": "coalesced:0c3c0525d86d5fb7dcad528d72a93ed243e056ec68df4796bd2762d9aa4e1d29",
      "source_sha256": "d365d7c8a1c84dd9472d292a7458808e95df4a37a03d43854e23097f4d0a4e75",
      "translation": "您能高兴，我也很高兴。"
    },
    {
      "id": "coalesced:1c9e2d720d9a45a2f8214474717c593b279bad9fc4e740cb27f227c57534e5a5",
      "source_sha256": "e6f6457fb8fbbbd46435fb4bb9aafbc34e46fa1f60807a257c8a6f8a45a1ce91",
      "translation": "喂，等一下。你是什么人？这个女人，我……"
    },
    {
      "id": "coalesced:bd210f538ea79477795f30ba5bdda7bd30f8744aeb64aecd338f1131069d1a0c",
      "source_sha256": "5908ad97c84fb6fe3b92c3cec1e3ee19636be66895af4daa119bdebbbd9b1149",
      "translation": "我正在向这位女士求婚。你应该没资格插嘴吧？"
    },
    {
      "id": "coalesced:de11780cefbe99eead590956cfa401a60e8c6040a1bcfb78a438a118c7c86553",
      "source_sha256": "0f3bd7fea44808f44637d2e6a8dd8c33182794b6522418e221e30becfce321ab",
      "translation": "我有资格！这个女人是我的女人！"
    },
    {
      "id": "coalesced:d7341445d357160ca3a71d07048b60dac465371e430eda59e5e03f25ee561b93",
      "source_sha256": "79f5dd5ac5c77777b9d47926f899c38ceaec59747b81b7a8c36c2105c672e56a",
      "translation": "拉兹！！"
    },
    {
      "id": "coalesced:1816dc0e805eee8b8f8bd53998ef4aa3f2531956883fe69bb2c5cc2423f63961",
      "source_sha256": "a93c3e239de1bfa5a15fd5dfb5e4b0cd5162ce4b305da426ce5f6953eb1c788d",
      "translation": "斯特萝！你要明白，我心里只有你！"
    },
    {
      "id": "coalesced:1fc9dc35f96d94ed49dfc231e57e48d399cdf327b7158da15c8db841f8df5d4e",
      "source_sha256": "5626efda635353080bd95eb0fe69b8a3f1b9c8babd9ffd8dc7ebf2d99bee2699",
      "translation": "拉兹……你终于肯说出来了。"
    },
    {
      "id": "coalesced:f03b22e02d924b0b9f1a710587b01cb5e8fa92318c576df91f1d4a4d5786d749",
      "source_sha256": "7c13c95f31d3912d45afbb71e4709164e3aaded71f2d2fff270836a187e83172",
      "translation": "斯特萝！"
    },
    {
      "id": "coalesced:d6d3e614bf43d563a6f0941cf978e72eeff94c1e29fd670b6be57fda0be4db5a",
      "source_sha256": "79f5dd5ac5c77777b9d47926f899c38ceaec59747b81b7a8c36c2105c672e56a",
      "translation": "拉兹！！"
    },
    {
      "id": "coalesced:f7d9ebffb95c17ca3a959ea6b58cd56151f7466593d90e311d5e06a2ebc7151d",
      "source_sha256": "bc86c6c1a25d65bcb17705ea124ba1eb979a6495e8a1f6286aec5f1332e2a16f",
      "translation": "……我们还是回去吧。"
    },
    {
      "id": "coalesced:5c4eb880974c00ab411ee8f9d61bcc674e19f7cdb6da2e845e92f87c74b38676",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:09c153ee13151b5bcdfb9a9c3607d235f5f4558e66283d3a007152cb11fc2612",
      "source_sha256": "4655f6df27324504410d906f3b250355f3162bf61a4c5a5dedbc57d4b36d077e",
      "translation": "我说过需要男人帮忙吧？您根本就没打算帮我吗？"
    },
    {
      "id": "coalesced:507ddacf1283a1fc397a80afe230d48ecc7e10f91ef86c465cd96fadf3126c95",
      "source_sha256": "48a822c44b003de41f89a61211589e23aa625c69a085c249f907969778ac7047",
      "translation": "我不是说过，特雷瓦不行吗！"
    },
    {
      "id": "coalesced:285d54a9f530ed2dfb6d248251231d89941d9a92d234234d90c1458b37a08d6a",
      "source_sha256": "2945928f2d4b5cb409cf61109a4ddd355bd97503b9d8c833b84f51a8b5870729",
      "translation": "我们打算明天举行婚礼，有空的话，请一定要来。"
    },
    {
      "id": "coalesced:2e1b0db0b6386220e462c5951d6a0dfd5475cba482d0de2a6db47366e8ca75d6",
      "source_sha256": "a38b7da1ba64ebaca2abf120f87b2c06a08a1f98408cf39e22e5be945c91ccb5",
      "translation": "事情我都听说了。多亏了您，我才能把真心传达给她。"
    },
    {
      "id": "coalesced:d7dd0a061c651d8111262cbb463a2810dcba616338cfec40d47adfacd0384555",
      "source_sha256": "805ab3cc28746d3ccab9dd57ba9488072b03b6d1ff7ad4e85566e381c52017ee",
      "translation": "真的非常感谢您。"
    },
    {
      "id": "coalesced:28f2be3da9c5983a291489adb50f500172a3284f5af0d14f23f81f1d1470c073",
      "source_sha256": "cd8108341b6b85eed0a58f4ce443bb8f5ba36110a7f5c53604a747212ce74849",
      "translation": "求婚大作战(2)"
    },
    {
      "id": "coalesced:9e80ff6c14bd5219c7ca8a35780d4cd9624c9d0f0ba8c948b872a9ba4c382545",
      "source_sha256": "c8641ddb9e5d60855c716bab5d125d4a1cadb918a294aedbd0594277e3447ae6",
      "translation": "把握时机，在斯特萝站到拉兹身边时与她交谈，向她求婚。"
    },
    {
      "id": "coalesced:12e3f86af403a81c853a44680afad5470da414d1fd5d5050823775df501b6456",
      "source_sha256": "c2b66e076ad71d4fd55247a0f6ed209e60c508e533216cd496f3728d36dda0a0",
      "translation": "就算是男人，长得像怪物一样的特雷瓦也不行。"
    },
    {
      "id": "coalesced:8d6343a1232efb8ecbd9d0a703ece48bcdb3cecf72c8e5b1dbf2c871449cacb3",
      "source_sha256": "c535d64f29975bdb5f7df7bdd0f9ecb3bd036175e66dec8e184a20b014a349b7",
      "translation": "那我就过去了。您可要好好表现啊。"
    },
    {
      "id": "coalesced:44a3f75d94ba15302b1b83317aa97f59460ffc6c44c1d996b1ab1492d7a27c55",
      "source_sha256": "9decd77630b5ea57d3620baa44af91ccd29fa0d4ce2644bad21dee35e2a0907c",
      "translation": "都到这一步了，为什么突然犹豫起来了？"
    },
    {
      "id": "coalesced:41798abdbd36b14df4babdc88eed3b9007bb48fc2c16fc9ceabb66b762d85d4f",
      "source_sha256": "df5237af1321b8ac02feaf43d08395307f8f4517b00bb9932fa9b609b19d6f5f",
      "translation": "难道就算只是作战计划，向我这样的女人求婚，也让您这么为难吗？"
    },
    {
      "id": "coalesced:8aa33b99c53d8d385d0d0c3248c12ec278e09be1e9674689df364e6384d6bffd",
      "source_sha256": "96493f8b02d0f08007bf0a16266d63abf1d5c84362cb98002c1611fbefff90b0",
      "translation": "请把握好时机！重要的是，要在那个人身边进行啊。"
    },
    {
      "id": "coalesced:51ae38e1ada48c2676284c82dcf019abeeba768abaa0165d42863606ac0dc915",
      "source_sha256": "1363a332787809148bc87197a65d4e111f42a82095c8426739fcb6984d558323",
      "translation": "那个……"
    },
    {
      "id": "coalesced:dae4e3e8f4feb74a1e8e0a7c810e6cb6ae6ef15cbc20f6e9a1375c243c3900fe",
      "source_sha256": "d14156c16377b9cf0c9df5278dbc3e98f12c3571c1e8278b0f74a0aca8573e02",
      "translation": "能给我一点吃的吗？"
    },
    {
      "id": "coalesced:c15455b3dce8a8da7111db5d09ae866385fa22bd858ed83848f2a79dd8912a8d",
      "source_sha256": "8a2d5bcd18fc6695606a3616a84320e9dcce70ddb89ac3d2c530fbd6d28f3d56",
      "translation": "爸爸妈妈突然都不见了，也没有人给我东西吃。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f8d641cd6c9c55bade36de7108eff60a97dd2f231a09528fe2c654162c4eb1cb",
      "source_sha256": "6b87ebfd4b4d6a5207b48afc35f4ca74f9c69e7b0dd0540a33ecb3e4d67b6afb",
      "translation": "好饿啊。"
    },
    {
      "id": "coalesced:1af870c0396ea993e3d548addce40c3ed9c94d3145033979834bc774a8accc27",
      "source_sha256": "519cee0af6e5501b61804d6dd7b5cb757369b7d0aabf42bba16b0839b351a7bb",
      "translation": "真的吗？您要快点回来哦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ea15fc0c38b63c36c7314f06796ba68b29710f34499481f1b8ec7390dc7a22c",
      "source_sha256": "b273d01859f75789993b7848a5ecf60322e0f96ff0781ec49c57b5f7e27e8c98",
      "translation": "爸爸，妈妈，你们到底去哪里了……"
    },
    {
      "id": "coalesced:b056891a437317ba7a7148482832f3181bff2d6591ff3aa33ac3724b3d9abc65",
      "source_sha256": "c395c1c8cf62ab9cbb1160827616fb7ea31c088a7cf0c62b9865b1c26e3d18e7",
      "translation": "呜……呜……"
    },
    {
      "id": "coalesced:b2c0e6d280b4013ad99632a3cf3f2a9809b5bbd7b5c2f031405cad907a753a25",
      "source_sha256": "e12d17bbcc06841769b2f86ccaac203308189a6ae08c042ebb18ae1a30401796",
      "translation": "您要快点回来哦。"
    },
    {
      "id": "coalesced:4f765af6814f12b985611e009344f4e6bb0ba2c58769d5d3c1e8e135c79678ad",
      "source_sha256": "85422faaec592207923f71262af02834797ccdc0be221b68bac1d3f47f42c556",
      "translation": "啊，是吃的！"
    },
    {
      "id": "coalesced:adf5fcadbc6474e1dc0f51446ac3fd7d255d3e8c2f615ed1c115878a2e09ee60",
      "source_sha256": "cfad45bc5a1635964aa26e9c520e3b33765ceb268708bba6c30e8b90065e39bf",
      "translation": "嚼嚼，嚼嚼。我从来没吃过这么好吃的东西。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:422e20049219ddb6b07d9d9a824b030a3230cfee5066f50c2b25e6c587e2cc36",
      "source_sha256": "ace53ea7c59ce8f7310fee595158b3bd29082ba38c4ca3586acf43a625bac954",
      "translation": "嚼嚼。真的谢谢您。"
    },
    {
      "id": "coalesced:5fca631480a9ebc497719eb0de8fe1ebfe05fbdb6332e5fef52f9d1a0e9d81d8",
      "source_sha256": "f9d4f8a68067282c069f8d0191870a21a8b8223a6779d6a4677e29f87ebff9ea",
      "translation": "嚼嚼。这个送给您，当作谢礼。"
    },
    {
      "id": "coalesced:fc1de0fc70e16c5df5d6c621b2b8c0007e4fdacc87a835f3acf787ac473dafca",
      "source_sha256": "281e2680ba029eb32b750e5525aed272c1f11096161d9f3e377cd4add2667e5c",
      "translation": "为了饥饿的孩子，从北部军手中取得\\n[战斗口粮]，带回来交给他。"
    },
    {
      "id": "coalesced:c350771f586c37753e4db3893e3d17dc8bc051f34de2b89dd37c258279e11281",
      "source_sha256": "08e664240f3013507e3a06c98c22618c62a0baa3b99016ace2542ef233cbd480",
      "translation": "我好饿"
    },
    {
      "id": "coalesced:8e6f8a820eacad0aa537582d362183c42d386e255ce8260dbe53016bc32e510f",
      "source_sha256": "b3039006fd629469beb2cf52e8813b5f38997694f316755b9f99dca6e4f26a26",
      "translation": "获得战斗口粮"
    },
    {
      "id": "coalesced:3fc9313cdc80ac7892709fa54ca799324ed7d70b145ef303fe4840f1697d73f6",
      "source_sha256": "b3039006fd629469beb2cf52e8813b5f38997694f316755b9f99dca6e4f26a26",
      "translation": "获得战斗口粮"
    },
    {
      "id": "coalesced:9ad367d335dc8f49632020fd866478cd2ec171c46195092b2d1c0d352cfcf576",
      "source_sha256": "819c7d7ebbe69ec4053a03f19f3a3202f47f1dda75a773444953bdf0b728ca61",
      "translation": "看这情形，您应该也明白，这里绝不是安全的地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf9edbf475471c0e037db23e8fe03db5eb60bd26ce917a66294ef75a1e3cd8ad",
      "source_sha256": "224ca00e919ced670846f74816b40e2ea6eeeb06b08d42d5d864beb4ca2fcb5a",
      "translation": "只要稍微往外走，就会遇到大量怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:840bd9ded90aea9b86f76ba6ea4217478ec31e21f2135d3b7e52877e17ac2957",
      "source_sha256": "728bb7261f3c465804e3e351d705839e5e17676f3e0e889db76296ec147b4800",
      "translation": "这里的人们，一直生活在不安之中。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e4df29fb72c73bfafc98ba604e413c64ba172d1af46a010ef5c0fc9e1beb4bc4",
      "source_sha256": "f2d891bbfa63c73ac2d83f5da4405904836dbf63505dd67020c5ccd74de0677d",
      "translation": "所以，能否请您消灭一些附近的怪物？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72119239fafd99fd9d90a1856163d57da905fb17c97c76f1a7789a11ebb098a3",
      "source_sha256": "bd4c56f2b376324ae3d721d2a8fd3932ecad90c61524c4a463981cb93c9307d1",
      "translation": "谢谢您。我们光是守住这里，就已经竭尽全力了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:78a367429ca192617b6e9e00a4e961107ab0cb4ded2be44f54de06782c96404f",
      "source_sha256": "800f5f26547cf96531bf58cc4988ec195bb60210ac93fb5a115cbf5d4353e1df",
      "translation": "嗯……也没办法。这不是能够强求的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b1f0115829b0bad7577d2f0a8c4408499a8ec4c5f87d4882f2483972ddb57bc3",
      "source_sha256": "e9a0546d8ad8c0f81d7ccc736743fdf795cbdedb1a3d2866ed33526c0d84b054",
      "translation": "请消灭贝尔福特周围的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:57138b980cd3ad14d3c29e536ce9b852f38b7e83415cb4104fcb9c3ecaf9c65e",
      "source_sha256": "654fac901d4a56eca36d7b7fec888c5dc6b14681d89a9a98a8ee3fc79e13a09b",
      "translation": "多亏了您，帮了大忙。"
    },
    {
      "id": "coalesced:d5f6aa11d11e465390ccdf45a0c7f0a1599b438089942c7366004039c43a897d",
      "source_sha256": "ea65828e967e5eafc879ae7e225567157644e2636f621fefc4e89943217a9f09",
      "translation": "当然，这种做法只是一时之计。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:061088b09ad814a66fd20eb7f697bfe41803685b540015bdfd9a03f12718d3fc",
      "source_sha256": "69c0a035db78f897b77e6a6dd545b3bbbcc45c962a3ad4031665605f675cb342",
      "translation": "所以，还请各位为结束战争尽一份力。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0130425ab0be01525dc30e4c5471c13beb3732396a904e0f84475806b0bb4dc",
      "source_sha256": "7098711557967700a3c57565dee43a015c11b83d042f9ac5cec7cfc3f52cceb3",
      "translation": "消灭贝尔福特周围的10只怪物。\\n完成后，向贝尔福特南部军占领区的\\n南部军士兵报告。"
    },
    {
      "id": "coalesced:80adecc3f67b9d54d6f36591c8a3afc0bb8c9cc7dded66a5e4f492c499334f70",
      "source_sha256": "9d0ca38d9dd24b475125ae3cf75828f75dadc7763bbe848cfd8041a093d31d19",
      "translation": "防范危险"
    },
    {
      "id": "coalesced:bdbee09679bc5b19861fee3b3e3021aac398ac49a1ee151a582e5c0afd8e9da8",
      "source_sha256": "d8084d3ae2d9b47f4ca8e9a3ad61182e127363ce8974d0b51710926ff91d31a0",
      "translation": "QUEST%s: 消灭怪物 (%s/%s)"
    },
    {
      "id": "coalesced:185e03c9432989a4fb8b3d5d1287d48514cfb926bd99589b25f4bd8880adcf62",
      "source_sha256": "ccc1e979687d02ce89b368aaa72ea025038675f9aed61cd717ec91fe308a9445",
      "translation": "消灭怪物"
    },
    {
      "id": "coalesced:789ef2072243211be36a8368b3e03340ab918ce2e2844e541ca322b0671d240d",
      "source_sha256": "2946efafc9c0ab33e327733a75d5a1bea11554f0f21cff537b31763a3df9f9d4",
      "translation": "天气越来越冷，可我没有衣服穿，简直快要冻死了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e0da8b45df543224d3481b6707f73c6a0fd6710989c0d53376d0a2a04b1e200",
      "source_sha256": "0a80ec609e6eb6f42773fedce2810c1f543ae343d6f7ceafec3fc6f93f9d6986",
      "translation": "不只是我，贝尔福特的大多数居民都是如此。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:352e250a3137e5aa2afd1a631d3e0fd1c3dc61368b898e02edd49f0c869b6f27",
      "source_sha256": "3c6c7545b29541d68b300fd40f4e38113d9967cf2bc8e81186a38cd692bc30e8",
      "translation": "南方送来的援助也有极限，现在已经没有别的办法了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:472311673ef3cac60719dc0129fcf23d2ec614f5b5a9ea0be61f3615c2890835",
      "source_sha256": "3fbf043578f7e22c100a28534029e86590fca2b2365c86cce0b94a911f5ec2fa",
      "translation": "啊啊，要是能有些厚实的皮革，就能做衣服了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:49e0cf7c63837fed036ebe8d7824fbb7fb1b0dde382b42de640d3eeeb7efb847",
      "source_sha256": "5bf15b1a9919c5b43a6237847720aa239a63f6ff0016b254356940115720635d",
      "translation": "听说有些怪物身上能取得皮革。各位能帮忙弄来一些吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e154584db277bb20bda654d2ce7a796c56ace48d990171e74a419212fd969ec9",
      "source_sha256": "b8ffe2ef42c7a1a28b4b2385c1db078bd919c9369b76308fe1b11247ffbba4c1",
      "translation": "只要有皮革，这里的人们就能不再担心受冻了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ae5f364df3e0d2a01f99115e3490da65b052987e49847abfa7dd89c8e4f7a41",
      "source_sha256": "eff2eedbebd6b4f07cb52af5715fdd02191fcf32e002dde84bd8d83f3f9c571b",
      "translation": "您竟然这么狠心地拒绝我的请求……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab70e2ded6feaff1ee9887c668c182d0497dc21227f1c2b3826700087c44b07d",
      "source_sha256": "b8ffe2ef42c7a1a28b4b2385c1db078bd919c9369b76308fe1b11247ffbba4c1",
      "translation": "只要有皮革，这里的人们就能不再担心受冻了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8bb89d5d5b948256e43255475423e55a78876236127c362f5d6b12b948545c80",
      "source_sha256": "9aa61e9bf19295a05a3c35794c2a1553a5b88b7810822ee9d9876e7d87d0cd5e",
      "translation": "您真的找来了。谢谢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b0b7881425f4dce5c23f5a1c1c9dde59e9d35e44d0b12c9a209510bd48c6d27d",
      "source_sha256": "c319bffded95987ca35afe14ddb432910bef6a84b05506d4eea068af9787b119",
      "translation": "现在，我得发挥缝纫手艺，用这些皮革做成衣服，分给大家。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:faf9c5767d7a3db487477a287cb93fee6d258d07063679f90451c891b9e398d4",
      "source_sha256": "5feda91e919c9e5005455db7786ce282fc7c10e462a0ec86765077fecbfa2346",
      "translation": "分发的时候，我会告诉大家，这是各位的功劳。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52c2cce8ebf5e07a613bb88b63d91541790d81b166a39068b7aa0da85068d907",
      "source_sha256": "a09e9d2f81a8bd37d03cddbca6c71e1ade10e8518a89df21485d2243070daae3",
      "translation": "从栖息在星光平原的[野猪人]或[地行兽]身上，\\n取得3张[怪物皮]。"
    },
    {
      "id": "coalesced:9de09bf3cec44a18317affd2aba8470c969a9f7f99cd593a11d9b07c2cf52b25",
      "source_sha256": "c6b217174dd15cfa93935b9e7327b4da1112470f81fddb3252a4b78dafab8cd2",
