  "entries": [
    {
      "id": "coalesced:9108fed85be6e53b51aa1dcdd0ffcebe560b7cdeba8f9490eb3e5dc012d00c79",
      "source_sha256": "b162884f99b4160c97c4479ba2a834337ce9bacc811af8cb175bf7ae7d1dcf4f",
      "translation": "狼人盗贼一直来捣乱，卡蒙德开\\n采毫无进展。"
    },
    {
      "id": "coalesced:a47c87e826fe4f0a40bbb879c46d32542b4979e4003fcfb34d4970b04dc02243",
      "source_sha256": "d57a68c64ea933a822e0d7f257caee19fcf08c4f33104b5bdd09428e0f963cb0",
      "translation": "更换队长通常有3种方法。\\n\\n1.在“主菜单”的[编队]中更换。\\n2.在战斗菜单中更换队长。\\n3.在战斗模式下按[方向键]更换。"
    },
    {
      "id": "coalesced:f812388e996cde4ab1ad3bee92debc9e829dbda701437a8f6ca1848edeabe589",
      "source_sha256": "c62753073ed7a2090f86bc8362b214b6f8b5c61f8ed34a707e5f86285cb383aa",
      "translation": "要在编队菜单中更换队长，首先\\n按[开始]键，在主菜单中选择[编队]。 \\n然后选择所需角色，按[X键]\\n即可更换队长。"
    },
    {
      "id": "coalesced:f8a4efd920a9464ad576766a3adfaf61feb5ab4e361d355cf9a25359b67f7858",
      "source_sha256": "8f72783fed639b62aa6dd1bdd7325b50d173bdd5045df17d278b8a47b9f41352",
      "translation": "要发动连锁超限或连锁终结，\\n管理耐力消耗量十分重要。\\n\\n请尝试在主菜单[编队]中更换队员，\\n或在战斗菜单的\\n[AI设置]项目中更换AI等战术。 "
    },
    {
      "id": "coalesced:0d700f9eb697f3f503a8abd1628ccf456cd33006d4b50f6f4f78285d9f2613ea",
      "source_sha256": "e74404362e72098860a47ea224b36e1960e5a5d132b3cebe43c263dc8a939144",
      "translation": "请选择想观看的语音剧"
    },
    {
      "id": "coalesced:b479b2d24a9a5672938c11eec4136bfe96adbf296ccd1825e1c19e5659fab41a",
      "source_sha256": "f4ad84efcf15c2bffa9e4d9edc18e069df99b4f10f4ff7da68c43e6fb486dc22",
      "translation": "是否结束语音剧？"
    },
    {
      "id": "coalesced:79d8893a78d11934d1455bec265dc73086de281e740f3c73cf909c448bafbb2d",
      "source_sha256": "7d8d4bde248a2321647a2b0d1a1e631dc9167ae9263005188c0afbe87da2f260",
      "translation": "请通关《真名法典2》，\\n或从XboxLIVE卖场\\n下载语音剧。"
    },
    {
      "id": "coalesced:fc1f38914f271bc1f9f9f8f32c81445f1333170a267b4282f0b1029999742cae",
      "source_sha256": "ec44b18f322aba707d7ca5e8ef7d04b2b472caf2c4085507721f86ec60401427",
      "translation": "拥有对应的下载内容后，\\n即可欣赏语音剧。"
    },
    {
      "id": "coalesced:2693289e1f5d6fb085435e2c81092523b6de91c7caca4ee8ed10577ec016d01d",
      "source_sha256": "7ebb61e8a313f119228a9e5c94d684c4651b80be5a57a0903e99501e68a2f918",
      "translation": "发现下载内容中的语音剧。退出附加内容菜单后重新进入，即可欣赏语音剧。"
    }
  ]
}
