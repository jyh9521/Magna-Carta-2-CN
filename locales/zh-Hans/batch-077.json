{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:8776346ac497996cb8cdd5ef1f7cef0790af25173f4537620d9b49583779e226",
      "source_sha256": "9bf89ae4d885f363c70e8d6268337d2abe2eec34451f5c4ab222009fce659859",
      "translation": "啊……泽罗哈！"
    },
    {
      "id": "coalesced:039e4118eeb02798a795bdc33834538997d833a710a053b8227c43a101780a16",
      "source_sha256": "155ef7dd6289031d3cae9f2626ae4fcf51ce2948cff08caa9b7f8b4e6ac4eee8",
      "translation": "是露啊。你怎么会在这里……？"
    },
    {
      "id": "coalesced:5c841495deaa91c4ebb821b0f0f34c1f7bc6f52473548354ce72df6620805394",
      "source_sha256": "b5a76fc9412db028493a7f97360fde3e24fc957f93db72e2ade1e98c9a9dc5ac",
      "translation": "泽罗哈，你平安无事，真是太好了。"
    },
    {
      "id": "coalesced:01f18c8e4bd2788c2227caea93aa852ea5867ce8290d67f9a5d5bf3a1e741963",
      "source_sha256": "5c5b985f2954b6cb358296fd512ba19733f1fbc2336cf140195b9df5c8c926fc",
      "translation": "那边的！全都放下武器，投降！"
    },
    {
      "id": "coalesced:b23e56785f92cd1bd9987e7dfd2a2318859f5e7939db41309a7e430e955c4e9e",
      "source_sha256": "b85134d1720326f83c71e70782af26d1ccc3ec1be065857ce7c9bfba1424bf0d",
      "translation": "胆敢抵抗者，不问缘由，一律就地处决。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b7d047307c814c7dca1b91939c730e4eb379e8c805b176bd5dfb3442ad2fcf49",
      "source_sha256": "64838ffc6696b1725565c49f532b9633e9023d6a5cf374c51401814793b10f37",
      "translation": "看来，是没时间悠闲地叙旧了。"
    },
    {
      "id": "coalesced:389dc290879ad5032d4fa768e6922ab88d3909c51935624946071eee02f0dea8",
      "source_sha256": "3f8a802973ad4ede13b5234cfde1de539541a034b21fbf7bc7cf958d557c9a11",
      "translation": "先收拾掉那些家伙，再聊不就好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e2edbf5beaec94df6a736d4f3c0f155c04339f03fb3cf5e874dd759ec6a77f51",
      "source_sha256": "b714faa9d818d95cdd5446cf1fb1a8621e94f190e205c7dbd367bc9002a4120e",
      "translation": "你知道我爸爸的事吗？"
    },
    {
      "id": "coalesced:42cfb4c8406d62499abb96bf556e4ed744a3415e65aad7c6d5d52c7151435486",
      "source_sha256": "fd04c3385ede8f2ed6cbf3972d0b49e3b6c70628b77d5852fe4d816a8d9e26d2",
      "translation": "你爸爸？你……难道是拜泽恩的女儿？"
    },
    {
      "id": "coalesced:03e2b74e9241c1d110c8ac19606f4d46efd4eae6d4cf0fe2f61301171ab7f361",
      "source_sha256": "6df1bcc3b11f2537f25c164522e29c1083a0e215261469a6021c16fed9277098",
      "translation": "说起来，他偶尔会提起女儿……原来就是你啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:75f0e1ccdc3bcae27722e55702d6bab8e866f59405fc32b40b7ab63fc8b9a388",
      "source_sha256": "f67b809002128e486782855d37004106f3710158ab45ceaeaf73cb11832bc389",
      "translation": "爸爸，爸爸在哪里？现在就在这里吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:35784fb4e970b5233ab7a8aee58c3f839d0522f8b1dcac61b800267877cd8261",
      "source_sha256": "4eb2316c1e1b4e75889f9f2b8ad2caa9762500a799180c750aa8ca97a66375b9",
      "translation": "他以前，的确在这里……可是后来，被北部军……带走了……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7690b77d2542633749a2740739d70cd09bc93a2f696483f025b9080e8947580a",
      "source_sha256": "cc06a3a3fb20d78a2efddfd06aaab5635903ee27d85fea7f41590779ac61a803",
      "translation": "不过，去王城的话，也许能找到什么线索。没能帮上忙……对不起。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:407e1ef7cd223f3509c3f885218016e1a073388e90b3563152b03f91367a7ff5",
      "source_sha256": "ab02e016636f35ab824a03215d90c7bc9e166e43200de6f2a98e04e33c82714e",
      "translation": "这里就是我家，曾经的利登家族宅邸。虽然现在，已经成了这副模样……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f49f0557a41f0decd7f6f0c10eda65065346c081fbf3b99c9d433ced9e6b775",
      "source_sha256": "99b3aef79ac54d36ff7aa6c38841596ba5ad6a1c19f2de7f4885a7cd664a5c24",
      "translation": "啊，对了……克罗塞尔是贵族来着。玛莉丝姐姐，都叫你克罗塞尔大人呢。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9de02b127ea89215435c951ce341465eed85b4666afd6ed32fb48ca56dafc7ed",
      "source_sha256": "983dc8866fbd713e7ef0faa8016c7b2a74ad9278fd6998bc31ab868b9006f274",
      "translation": "话虽如此，也只是下级贵族。我们家，是个世代培养火之连环术师，颇有实力的武官世家。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8e14f201bfa13b19b75646e1fb7295d40cb491b8e7dff32f40f4a799a5ab0b64",
      "source_sha256": "26f41b7aaf51541300d1c7ea855ad561ae9faad1eab8da061ae113234ddf3f2d",
      "translation": "所以，我从小就接受训练，要成为火之连环术师。也正因为这样，我才能自如地操纵火焰。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a91be0a731996718d04ea60b5a045e192441066c6b336f7c16500355a6d1a1f",
      "source_sha256": "6fcdc3cc34249fcf62f7c05b25331c4571173d7e8e3f19546aec000354d05ff8",
      "translation": "说起来……这座宅邸里，有一道打不开的门。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e94bab88d5ce3d7f03d5e0644c40c94c6514e462baff84b28783b7ded0e25f5b",
      "source_sha256": "83b1bd739375a9b87be39ff650beb49bf7143b1bead2dd7e5e8f619f09d65175",
      "translation": "听说，只有用火之连环术，才能打开。所以父亲就拿它当金库用了。不知道里面，现在还留着什么。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2d0baedca7ab843872812dfd8678ef4d4f68232940f513ac2721807ceebc044",
      "source_sha256": "618c45c9187f28f0bb245e0335ca4669cde2f0db1fc7e491d178f0f85308ee38",
      "translation": "地方只有父亲知道……要找找看吗？"
    },
    {
      "id": "coalesced:cdfa76366728049abf53f54af35d6994d72785743abe3aa540a54a02e054d872",
      "source_sha256": "5fdbbc47a7f81f489ce8001fa8565b98cfd6274352adc0717b8aa24e9a575116",
      "translation": "什么啊，这么简陋的机关。父亲也真是的，到底在想什么啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:df1b96447b8575ca0f8558d958eddde4760ee34345f902af2004e63ea6ef4dba",
      "source_sha256": "7c52fe5cf85d82c349bdfe44198db4a1a9dd1cce5362f57193cf055735e7d71a",
      "translation": "只要点把火，就能打开。阿猫阿狗都能开吧……真是的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8d6d86e4fc0df4a48cd3ae82b01be43c42334ca2bc8ad462f81574ba6311f126",
      "source_sha256": "6e8dd0d071e078508baa0543c49e5f7ccf85366b36fd81fa43a66e1bb45f0865",
      "translation": "进去看看吧。"
    },
    {
      "id": "coalesced:10e76b164056a47388f5c122e941bb086a932fd187f96e7f1280e37ba463d50c",
      "source_sha256": "4534751b99384a2e9360fa4d9fdaf276e8927dcfc0cdf6cf684d20daee21ac94",
      "translation": "直到最后，都还在操心啊……"
    },
    {
      "id": "coalesced:00f8d1f6d3eecad43672f10b324bdcb5192c992684026b5c7203b98d37ac6861",
      "source_sha256": "e4f0b9771355bafb1bf9fcde19f0790112a834a93a83dd30493ceb37cfb676a5",
      "translation": "父亲，请您别再担心了。现在……我已经有了可靠的同伴。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb861cc9edaeaf3a7d22abe4c540b56ffa29ea309a813813324990ba5ab0c8ee",
      "source_sha256": "1e376a5591e19ccaf503439741a400178593b32650a1d05f3659ddf4d93584e9",
      "translation": "我也已经不再是，像以前那样，压不住怒火就胡闹的蠢货了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2657884eb5b61fdbb7ffc26f792d7f31fb5975b10d78fb0a15ea0fc2b8199805",
      "source_sha256": "4837d30858afd1e4f8829923bde96ae499e9cf68fd24ac87a3470bcbf0d5b863",
      "translation": "不过，唯独修恩扎伊特，我绝不会原谅。我会阻止他的野心……父亲，您其实也是这么希望的吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ab1012cf1300c8c70aebb6e6b96ff722d9bcab7788199696db4de289ed54f7c",
      "source_sha256": "a5c484e9ace0dd147d28db2e13df8a2f3d1aca2c2f2e4e16edaafb44f1e6693b",
      "translation": "需要从北部军的库布中，获取有关泽罗哈的情报。\\n追踪泽罗哈的位置，\\n抢在北部军之前找到他。"
    },
    {
      "id": "coalesced:0bd8941735faf8baed87d81d32a5022771363c20db6adcbdfaec8caf62b20146",
      "source_sha256": "2df93b65164393eb8c9c8c83143ace75b667f849764a203f4c53baa7a12cb17f",
      "translation": "泽罗哈的下落"
    },
    {
      "id": "coalesced:948cdd66314bac665c7f22b28f525864d7af31634544207016194caf8e9dae28",
      "source_sha256": "fbe7e926e1bedd87aee9a42c49603c1472031ed50301bfa253881cd657b4d231",
      "translation": "要救出洁菲，首先得去贝尔福特的南部军占领区。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98ae097edec37b9d6da8499b792f115010f10ae726f4da18f9980de40295a3b6",
      "source_sha256": "473ed111499c561d9f6e25c5a3f75f4fa2e8244a77245be0501e377ce12b41e6",
      "translation": "不管用什么办法，我都要进入哨兵研究所。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd9dbf9e8e94796064d85367030f35870b58d7aa1786a0f61a78c96befafd7f5",
      "source_sha256": "22fc596a194fab255166b4d2c0e0b8c2989904087318eac35b08671823957ef2",
      "translation": "快去贝尔福特的南部军占领区吧。"
    },
    {
      "id": "coalesced:8b69aed2852d4c1217028d4b2e2fc284c18fe7171dc0c74e5551305789c106d9",
      "source_sha256": "1cedcfeb1ccc0a0a796262617a8830797dd6ab7a544bf9774a75901050dcfa9a",
      "translation": "找个进入哨兵研究所的办法吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0cd5de1134a5542bd95f3943121767f2dee95295ee2d0cb9a99618f094ad3faa",
      "source_sha256": "22fc596a194fab255166b4d2c0e0b8c2989904087318eac35b08671823957ef2",
      "translation": "快去贝尔福特的南部军占领区吧。"
    },
    {
      "id": "coalesced:ce22c8ddcc4eca6e9473b94f3bfc6e6c1b68275348162f991db9710afe8f147b",
      "source_sha256": "4eef39ffc3a8d9286d94057e4b5c06f8d8faa103c1cacfff63be0a8ee35b4313",
      "translation": "我们得想出，进入哨兵研究所的办法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8ac078c05fc419125e1d069cd45759df20d92eb1dca3c90fc73dac5b1324a3a4",
      "source_sha256": "1620f2f43abf536eb604b3d99180efb1ccf5ae72d46e3f3cfd89c5cb0557120b",
      "translation": "我们快去贝尔福特的南部军驻地吧。"
    },
    {
      "id": "coalesced:82fe723c7d4a20831b9a4c6429f5d6ccc9787ffd1ef8e78af477b205e8d2fbc2",
      "source_sha256": "7a65bacfb1d8532205997596559709c050e96cf7e07126e8c7849fa8e1ff17e2",
      "translation": "情报员应该知道，进入哨兵研究所的办法。通过情报员打听一下吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:059b5478454f490024fb0cc7a9b555d27f8224e094a7fa08fbe30771b9d7ded3",
      "source_sha256": "ad1d4c6c76b267a1a2ffc5420dd85b27712e7082d14fe6e7c3ac9ce43574ca61",
      "translation": "得去救洁菲姐姐。快点去贝尔福特的南部军占领区吧！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a8a885e260d6ebed7f83f14d975886a22d697b1b78cab4ef167fb3017aa447a9",
      "source_sha256": "4df3a9933c845480de1db95d496db86b93cac13c489c1ee88e088652880a03b1",
      "translation": "要怎么进入哨兵研究所呢？"
    }
  ]
}
