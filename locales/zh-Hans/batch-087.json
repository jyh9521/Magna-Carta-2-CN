{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:9a209fc0056ca9e509d7afd126dc16abd77dae1a9252ebb40fc449c189f8c357",
      "source_sha256": "fd398dd8e610d0c19d01c1a2b446e4e17d8905a35ff35a08a74278ecc5d2ac01",
      "translation": "消灭克洛普斯"
    },
    {
      "id": "coalesced:63297f85893be182866e7eaa17b603896958e60cd7d4e641786ec657ca9fe9a7",
      "source_sha256": "dafd4ba86095cd2212ef2acc25d6179e1f2fbd53fc85f04b4ab0ac566066380d",
      "translation": "别磨磨蹭蹭的，快点行动。又不是只有你一个人在干活。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6fc9c68e10a766601f4ff9a8bc462a68a6e068c647ec144f8c05d9015b3710f4",
      "source_sha256": "5fae8912cf456e3e4529312ce7eeb0a639f1d30577e8086939ca023995357522",
      "translation": "你知道吧？为了防备北部军从海上入侵，大家正在海边修筑防壁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:585a2e54cd9927e8519e07e64e5e75328afbd3b0c3f9d7cbb71e13012c84a50e",
      "source_sha256": "5e1fd90aea480bb8f594d791dde93354a88106d6ea22c8bf02074ff706766897",
      "translation": "嗯，当然知道。"
    },
    {
      "id": "coalesced:6f767ebdacff3aca42c2f74aa800a420ee580f71f4d0655807cbd4be855405b2",
      "source_sha256": "afb0a01479534ac64abf31fb8454fc714b670f8a903a45ab726579b50a1f9553",
      "translation": "可是，怪物总是来袭击，好像给修筑防壁，添了不少麻烦。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf207294f261b84aa4e6911a15bcfcdc628c99192527d0d54d3da40690fc4bf0",
      "source_sha256": "13527097370b9927eefe2e3fd98c073206e5c9a7b2617de09dd2dc8d6001e847",
      "translation": "呃，你是要我，去打倒那些怪物？"
    },
    {
      "id": "coalesced:29afc249cfeba61ebd96beaf5d79010393c7ee99e7d2f0a499586a83e2940507",
      "source_sha256": "d407e50e0c963ac43789d123ea04b1ab1eb37f5322dac116372c4b8b2db1d431",
      "translation": "只要对付没有壳的[克洛普斯]就行。"
    },
    {
      "id": "coalesced:67b8dbf0aaa77f21066e7998f99f3244503c99f20468299b8706467f8f847114",
      "source_sha256": "5f2ad73848fb2e156df72be38410a8964444b220790698dc87427dc61f42e3aa",
      "translation": "有壳的[拉普斯]，壳很坚硬，用那把木剑，很难对付。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:226125f07a1327af2ba47911a4bde63953603d87cbca7c156c4a1fff909d99f2",
      "source_sha256": "a40395da47f6fc23cf99c1fb18ce4c30d08d13d91a97a61e9eb63aeb11629913",
      "translation": "没有壳的克洛普斯，应该还应付得来吧。大概3只？不多吧？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5df9d6878620e779f44eb63b8e0c173acbbb8c661ceb442023d0da1332c18b5",
      "source_sha256": "de47ba96d152186dc38b03974122e7f23223f2322c4e7fd55049ba50c64b5603",
      "translation": "我现在，有别的事要忙。"
    },
    {
      "id": "coalesced:d847048cd6292cffd956bee6ff03bd7f2da5607873f1bfaf8f04c4551d10394e",
      "source_sha256": "7c01aff60686579e3fcb8e3d7441d906c9940133d468242c7233a5cd26b871ef",
      "translation": "那就忙完再来。我会等你的。你敢不来试试。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:25be8974715e7f7fd01c288e27863bb3a14b8719166e36d1bb187e490c9b22aa",
      "source_sha256": "48d51bbc4cd9256406ac3cee0d92f486137f9bee1eeac5f0263d256e781b7ec6",
      "translation": "呃……"
    },
    {
      "id": "coalesced:d815a68322cf1903a2acc51e33746614941f06fc913e21bf59cac73c69225f07",
      "source_sha256": "b113aeac363d2192775ca55b3dd34406660e0053af8f6c0dec20a9fb117384ab",
      "translation": "我觉得，已经够多了……"
    },
    {
      "id": "coalesced:80b4850e9b66b88f0762120134b39cb596fba455b05ea2d30a295ded03d3fcdf",
      "source_sha256": "651a5443d87d906b9bad55e0cf7649678df31a88a96704479339936b171e2aa3",
      "translation": "好，这才像话。"
    },
    {
      "id": "coalesced:b989bc192edb1f32b4501bb625062e7fbdb5ec4e2ecf772dc1b583ba5faae4a4",
      "source_sha256": "b37e91a6dadded7333c81e01a3c8063c5ca58774f34ba58e2afb250dc7d771e1",
      "translation": "对了，还记得怎么战斗吗？上次教过你的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbf6cd64364db4dc7aecd67b95c8a29dd782e12cf1fee695826c0a8cacb739b9",
      "source_sha256": "c4570b4c324f300fdc6d892b10e4fe182d915b16acaa89919e707edc157acfbf",
      "translation": "当然记得。你以为我是笨蛋吗？"
    },
    {
      "id": "coalesced:b1a83932f0dbce32ffb2db8e7cf74409f35bbb5b49d7438459c57b598ea247c6",
      "source_sha256": "8025c713f26164a6787608a6cbce1b8ac0cfe963a42e1416578db60193e95224",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:14e57f9b9907aeb24625581df4a2861836b18ae7bc815c228f29bf90fa882e7f",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:ab76a7e0b47c388f955bc623ff2cccf347be26d7fdea904336557a6573d86983",
      "source_sha256": "e9d5ec1661e41d0011def9adf146ab0cdbf0288376074e06ce4d0fcddbd56790",
      "translation": "那就辛苦你了。我得去一趟风歌洞窟。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:893d23d4bbde67b2fe572d5736b610761e4750106f57049749488b377ca6674d",
      "source_sha256": "f717822b5409bd795510a3f3030004cd20818ceeeed5b17e27a1f3af4eb3dc07",
      "translation": "为什么？那里不是有很多南部军吗？非得去一趟吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e94d0d3ee87334bdd2ddd153e3ea1d7e0ba026922ccd3e52e0195f298b8685db",
      "source_sha256": "fbcd6923945c40ab07ed55a7a5951f3cd1fd7b832bc4920c70db1ce8f13de765",
      "translation": "我要去请他们，尽快把守护者带走。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ece1e556653d18d923dab0dbc0ffe77a9f931bccaa11218eb23cb3c6a33bc698",
      "source_sha256": "d5a3da96a53bfe34613785900cbb76a43afd9956dd5bf1ecf64c0af8ed3be483",
      "translation": "村民们，都很不安。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:00926ea5c06b5f508088965cbbd9e1b3755d620cfb2c2634e9c8237e69586a75",
      "source_sha256": "97e46f305f6fab073b5eafd8f759df0442bc57320470812847e00a9c8f72bdb9",
      "translation": "总之，后面的事，就拜托你了。做完以后，记得向比尔特大叔报告。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4b90172f662bb10381d010b2835cb4dc7d4e9e13551d556187656a9e54f899f3",
      "source_sha256": "e445f87776a55835ad1a5c4e2ae038382f487840071c22d788ab3cad8a2618aa",
      "translation": "比尔特大叔，应该正在海边，修筑防壁。"
    },
    {
      "id": "coalesced:9c02d108bdb67610819a0e8bff1d619a6316f31a5aa489d893a5371439738b87",
      "source_sha256": "a0bb3ef9fa325bcdf4ace7ea95b8ee2c22aabb116a140e33aeb4fb328936fa54",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:06a2aeaed57095a8bbf002940d3285fbd90f0ede69aa92715083aafc40bca384",
      "source_sha256": "c154e028cf2b5bda171139a28e9cf4fcac82bcf5328b41d7e4c67450ca395890",
      "translation": "唉……你这家伙，真是的……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:66f9dc0ddcd83eab38ad26ab95b3f04106b186d951c6bdceaa3c75b3086550a6",
      "source_sha256": "f97594db4ab29a18ce06ae231e762c7227fbef17fe243edfe54ac31d162adcf4",
      "translation": "那就去海边等着。虽然很忙，我还是再教你一次吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c043205c612dd9e84ff0bf7552d5932bbe48f9cd84624c3748e68f0c9522104",
      "source_sha256": "3fef5d4af13305953e23c324fbbb64e9d25fa57b44a5b13cbf462c26af2202d5",
      "translation": "快去海边。别磨磨蹭蹭的，赶紧行动。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ea824abf7197eae77ca94bc4e4cf9b7fc63b8dda8c8aee3cc6378cbfd9d1da15",
      "source_sha256": "2961816995b2071803971cecf5943ae7e9ea351c9dcd907bd0bd03fc295176d4",
      "translation": "克洛普斯，都已经打倒了？"
    },
    {
      "id": "coalesced:1f1421134e53a58d8e27b7b186e4da50d9f9d32312357dc982295622b7add8b9",
      "source_sha256": "0fc761c2a3222255e35896335b9728ffc33094caa3fe3593bad85f8a037c307b",
      "translation": "辛苦你了，朱特。干得不错。"
    },
    {
      "id": "coalesced:23cca6eafe2d69add23a0332c9f625e92a3e234f96e8707c2d677556cf1e0ec8",
      "source_sha256": "2780d20d3ffffbd854414b3a0ede7d626f2f9c5f16678eb422ce4a1a9c7f567b",
      "translation": "拉普斯壳里，有时会藏着道具。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:83c3e57c06adc95b841a199b4366508205d928b8304a97ae10d8efd857062488",
      "source_sha256": "209a642dc3f2f22354a3f0606878d9d21c515914a6aedb7ab1d7eb0067c20f4a",
      "translation": "不过，海边的拉普斯壳里，也可能藏着本体。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72481fbf838e1f24ea6352ef64d4471e7e95add3161caf7e96513177a528cdd8",
      "source_sha256": "7fcb491132855fde4e5a4038de7ce7d67770d786dff4d9f83bd6ea062de5233a",
      "translation": "别为了找道具，就勉强自己。万一受伤了，还不知道梅莉莎，会怎么唠叨我呢。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:010c3be2ce381362117acf4a18c61ef8dbeacfc036b7b476a77fb5b913f3166d",
      "source_sha256": "fed3370aa17bf7df1e2c231b9432ea10a03651bb77de033c8792d31fe016cc2a",
      "translation": "消灭克洛普斯！"
    },
    {
      "id": "coalesced:c54a0805eb97ebff1027bd5ddc264ac3d40890ac9763b06edc17809e7a05c319",
      "source_sha256": "bafb475c12422a310938f8d3e27a538c832aaf701c5d4eaee3fb06bf270117b2",
      "translation": "QUEST%s: 消灭克洛普斯 (%s / %s)"
    },
    {
      "id": "coalesced:65864290cc23cbbceb4ac842b354947f766fe2eb44188a61baef043bb0a8530a",
      "source_sha256": "f48c531d9a6c69fecbb5a55248ed80119aa5a63892b63ad4a78888f2886a5126",
      "translation": "QUEST: %s 开始"
    },
    {
      "id": "coalesced:aa3948078e1a71140ab2a2f39df40f2f11fdef766766212cc7cf88c080569fa3",
      "source_sha256": "11304b5710393e3b6d888d7091f1549fe2c84ff32f7018f1bda905e4d802870f",
      "translation": "QUEST: %s 完成"
    },
    {
      "id": "coalesced:a98ce3f3704a31eda17ab85c51942cac2778a980aea08c5042b81adf72499a86",
      "source_sha256": "9c971824be5a7cb29b4c62e65b05d25da7635214ad71bdf0558907c8d2c8710c",
      "translation": "<Styles:MC2_StyleFont_0>X<Styles:/> 不，那个……(进行教程)\\n<Styles:MC2_StyleFont_0>Y<Styles:/> 当然记得(跳过教程)"
    },
    {
      "id": "coalesced:76b26bb411643df1583a0b0b7bf0d10a732334c0acd4cb453c24734d49404fd7",
      "source_sha256": "0ff22ed425f41b9a1acbc7908538eef51d3bd2e5a6c6b9d11fafca51cf2d8177",
      "translation": "为了让村民能安全地工作，\\n请消灭海边的3只克洛普斯"
    },
    {
      "id": "coalesced:8db0ee226d0be970d989f19d3ffb86306185734f773df281a27c99cc4749f7e0",
      "source_sha256": "5c16364633e126d04a8297ca44d2df01418175c82327a252725e1b7a6aa848bf",
      "translation": "消灭克洛普斯"
    },
    {
      "id": "coalesced:10ad772bce8a707039e2d43f0de09dafc095455172861005df2013cd557792f9",
      "source_sha256": "40c3ae49fac876334cff26b6a2e2951498111660a72a2f79951103555813b2e5",
      "translation": "听梅莉莎说，你要去对付克洛普斯？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b5a26e2328dbaa58ca24c4ebebb85226a5633f99f50de4e24abd7e557df92e2",
      "source_sha256": "1fdc2062fe680dd4a418d4445342e3e08f94404d4c82923b073770af86e407df",
      "translation": "哈哈，加油吧。要是累了，就别勉强，去晶柱那里恢复一下吧～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f3db9718125fb00c88aa48208a247205b65685697078f412849704bb09e79297",
      "source_sha256": "45bcb0e10709075b91f0106db764e0796df86ac9f192ef5d1c38c4f44212244d",
      "translation": "露……请别担心我。期待下次，还能再见到你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    }
  ]
}
