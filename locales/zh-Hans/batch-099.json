      "id": "coalesced:166b6460626fc08531edeef9c53de77de279dfcc7ff09f3c33724677d02f09cd",
      "source_sha256": "380cbde2f5f2a12bb0b27db40b006a82336dbaef12107c179afbe58989fd46c3",
      "translation": "青灵森林一侧的港口"
    },
    {
      "id": "coalesced:d60b968f47c01e9a613350ad3586e8b7b9e38e9a704b0a1bd0f5ec6ca7260c3d",
      "source_sha256": "8f7101e7507413139bd177828c236b2f9dfcd13e3f75d0db4c147e06b4a98851",
      "translation": "阿巴泽特城镇前"
    },
    {
      "id": "coalesced:0b3ec980a4f40b116e67b082eff8f422d37fae735cf4461376f0dc7815836dca",
      "source_sha256": "dc382451ad3791e07c885750f2d0bb50aca87f41db293d10bbed8fadb7197a24",
      "translation": "阿巴泽特采掘场"
    },
    {
      "id": "coalesced:de52cb27bdd2738c230dd3e0e6f1e835e5941b8398fbf58c2861cf264109a3aa",
      "source_sha256": "e78168d5bc8267c7366f3b2d614dc53bf3104d33db8c7cb450d6060a581f76f1",
      "translation": "狼人据点前"
    },
    {
      "id": "coalesced:9ef7fa3492e75a46a4e7219595475f2ff8df78cc1d8cf3b931e1b0d9aad5c602",
      "source_sha256": "49e5d5699317ee50017ff12e4670d2a4269a9050250d24aa98c303f8c80c23cc",
      "translation": "阿巴泽特港口"
    },
    {
      "id": "coalesced:eb841c46079a798ec384a7cb94b7c11ccec28905418e210bcb9365c24934b872",
      "source_sha256": "64d32e197bb5a6bb0fc09fa25f7c027ec284549b8b282bc9b7db77d67a6edd2c",
      "translation": "水色湿地入口"
    },
    {
      "id": "coalesced:eada67716fcb894fd2adb43b65541794ed619bd470ceb67675a8914cb8720428",
      "source_sha256": "254078f80001a232fd29db45e00c405728873bcd6152a002367a241fbbbd704a",
      "translation": "水色湿地东部"
    },
    {
      "id": "coalesced:46eb04d092b8561689274373601b058363f8448ad7aba2c0f9c35c7f6122b943",
      "source_sha256": "7cd7fec33a0169ad1e64c5ccf2c2802cc57b7d84634f1cdb7a0651370196bb66",
      "translation": "柯塔马雷村庄前"
    },
    {
      "id": "coalesced:57cbfdada4bd329cfd887742b088978b353f88ba1b9bfd0f8cdfc5df244d9e8e",
      "source_sha256": "902120141b642a2e5f37463a8a322b2bd3f1f6d0f04ba9436e7a14e768059aaf",
      "translation": "更换队长"
    },
    {
      "id": "coalesced:a47c87e826fe4f0a40bbb879c46d32542b4979e4003fcfb34d4970b04dc02243",
      "source_sha256": "6b379c1d3051c0c9efedbd77326350b07f5e30e10d528178cfb73de78f41a236",
      "translation": "更换队长通常有3种方法。\\n\\n1.在“主菜单”的[编成]中更换。\\n2.在战斗菜单中更换队长。\\n3.在战斗模式下按[方向键]更换。"
    },
    {
      "id": "coalesced:f812388e996cde4ab1ad3bee92debc9e829dbda701437a8f6ca1848edeabe589",
      "source_sha256": "45a8207f60433d628b28559ef2077089106ed57f2a0a841d35f29d71c16de8f2",
      "translation": "要在编成菜单中更换队长，首先\\n按[开始]键，在主菜单中选择[编成]。 \\n然后选择所需角色，按[X键]\\n即可更换队长。"
    },
    {
      "id": "coalesced:0fb5869026bdde1fd5fd4d55abe1fa01fa789bee35419372d26e28bd7df4d6a7",
      "source_sha256": "bc635016c47f88459284714af148338fc5fe5ca33fe8dfdec7ba798dbd095585",
      "translation": "要在战斗菜单中更换队长，先按[Y键]\\n打开战斗菜单，再按[RB]或[LB]\\n选择[队长]项目。\\n在此选择所需角色，按[A键]， \\n即可更换队长。"
    },
    {
      "id": "coalesced:dd888b9deae4ecf3e1e7f504ce803c62a41a8d097a1ca5bfbd3b2993755a4f5a",
      "source_sha256": "293ae23877d27807696f589ebee4cb09f3cba127f3dc3f27449754c3c7d46621",
      "translation": "要在战斗模式下更换队长，首先\\n在战斗模式中，按照角色界面旁\\n箭头所示方向输入[方向键]，\\n即可立即切换至对应角色。"
    },
    {
      "id": "coalesced:b0d83eb6d4db6506fe67c95dce4e37be12d53a98f53581b49609da4f0504ad96",
      "source_sha256": "832017f7cd0be7bbfa17cbe0a224a4a8b80e92f35b97df54d66a5d70c11fc611",
      "translation": "注视模式"
    },
    {
      "id": "coalesced:d44c1cbe006af1bc7429c6cfb77489475d5e8c8ced589652bba35e8537f2e861",
      "source_sha256": "641409a53ffddacf4150106db321552ba127ef4f50057fb404f6fc024a193c48",
      "translation": "战斗模式下，向上或向下输入<Styles:MC2_StyleFont_0>U<Styles:/>即可进入注视模式。\\n注视模式便于掌握所注视队员的状态，也可以在此轻松更换队长。"
    },
    {
      "id": "coalesced:3612ed0ac078e09a2b457b198ea90446793b2c401822d66ae7e3a9de4664099a",
      "source_sha256": "b91f2bb774053211930606391a5ddb361524094219b52e96cd8593279b1d3f87",
      "translation": "要在注视模式中更换队长，先用注视模式选中所需队员，\\n再输入一次<Styles:MC2_StyleFont_0>U<Styles:/>即可更换队长。"
    },
    {
      "id": "coalesced:7eb1b367bf8ef69fac9d5b0af0ef4c8c5404a4f77707a80fd785565ccecbed9f",
      "source_sha256": "efd980aede4b35cb2749e5e5af017b340afdccccffdd2917c5f95b26ded70fa9",
      "translation": "角色切换提示"
    },
    {
      "id": "coalesced:9d77a1196e208e8f5534a43b6e45f55a28155fdbff662a507a077bc176ff632a",
      "source_sha256": "fee1e6058b3f03c886e702d73b80a5b833229af4e233aac0d0a9dc7b11300ed2",
      "translation": "战斗中，队长进入过热状态时会感到疲惫，在一段时间内无法攻击。"
    },
    {
      "id": "coalesced:bc28350bb8cff7b335a5b44c2259a1e54094045167f77e78583a3a06f113adff",
      "source_sha256": "f6f9c34b18dad17dcae3660f87a5eecee90f17905187fb85c68e4f5035a23df0",
      "translation": "此时，若疲惫程度达到耐力槽的50%以上，当前耐力最充裕的队员就会被自动选为注视模式的对象。"
    },
    {
      "id": "coalesced:93a59382f0e545fba366316ed85ce03768a832cb271f07410d07d097d602a33a",
      "source_sha256": "9af00f37e8b8fde490b0a9e08b894db544618e73ecf7e85b38cfae496c1ec63e",
      "translation": "此时，朝进入注视模式的角色方向输入<Styles:MC2_StyleFont_0>U<Styles:/>即可更换队长。\\n请注意，若全体队员均处于过热状态，就不会进入注视模式。"
    },
    {
      "id": "coalesced:73efbc1e43956a9ec75b24f3227f9d85b82bf3ca12eda5740bfc56ee2e76f939",
      "source_sha256": "6fcec789255fa47b2bbde291f03aaf3db7fc13873ef8b1d5d03c8142709a6902",
      "translation": "交流 1 ：救援请求"
    },
    {
      "id": "coalesced:958e86e3ae0849d566c7643902680df63d957ff0e4071b09044866122b3fa6dd",
      "source_sha256": "ab8880430a565134842ad1cfa1572b682cbf3ed21a5076a529b4d88ffbe9cbce",
      "translation": "先用注视模式选择要请求救援的角色。\\n然后向左输入<Styles:MC2_StyleFont_0>U<Styles:/>即可请求救援。"
    },
    {
      "id": "coalesced:29786ad7557e3bdccf5de0190a40e45d04db434600aeb89a865d40d3fb38a669",
      "source_sha256": "07d2e1440ca084086211337e5294c52e9815add28e0e0c10537f075f78c063c0",
      "translation": "发出救援请求后，对方会为队长恢复体力、解除异常状态等。\\n此外，若接受救援请求的角色会使用强化角色的连环术，也会为角色施加强化效果。"
    },
    {
      "id": "coalesced:4282a89443afca6d14356dbb9e67327107d8f56b80e47ac2e7a694197bae315e",
      "source_sha256": "d6bc8879833c94a973ee8c60ed1e42df3d498b80ccce7b5fc83c7e9fda325bc7",
      "translation": "若不再需要救援，再向左输入一次<Styles:MC2_StyleFont_0>U<Styles:/>即可取消。"
    },
    {
      "id": "coalesced:227fdd210d21d57dd7d38ede34b3625a282604cc5fbb35174e5ab5baeb86a569",
      "source_sha256": "c7ba107b85af92d14d4c38d68236c052d6088b38c2dfd053c555ed332b495d09",
      "translation": "交流 2 ：协同请求"
    },
    {
      "id": "coalesced:945597f8c7a2fdcb64071b94eae0695fbdd743f2bd82707510a512e47b79fa92",
      "source_sha256": "6e5dcf56f5b808d877da587821eff5788d90e38320284ad41e057c2407ea424f",
      "translation": "先用注视模式选择要请求协同的角色。\\n然后向右输入<Styles:MC2_StyleFont_0>U<Styles:/>即可请求协同。"
    },
    {
      "id": "coalesced:878be4fdb512599347d5e9aa6864db300905d267c991ff17f6f2a99a8b38d94c",
      "source_sha256": "c469a61f18447982c320bfab14bf450dfba700920d43c6237c9514228e8a8aa2",
      "translation": "收到协同请求的队员会以正与队长交战的敌人为目标进行战斗。\\n在该状态下击败锁定的敌人后，协同请求就会自动解除。"
    },
    {
      "id": "coalesced:0c09fd34135a9c9107ed37cd6acb676d0f4e06d92bf3e62d03c96a3cfd0baf7c",
      "source_sha256": "32a8a9789376c32b91bf13b69a8cc73395069b05e0990dbaceb3684de462dd2f",
      "translation": "大多数武器都可以使用卡蒙德进行[强化]。\\n\\n卡蒙德有以下3种。\\n\\n1.提高攻击力等属性的[能力]卡蒙德。\\n2.具有防御异常状态效果的[状态]卡蒙德。\\n3.拥有罕见特殊能力的[特殊]卡蒙德。 \\n\\n将卡蒙德嵌入武器，即可自定义武器。"
    },
    {
      "id": "coalesced:edbe097a1161877f94836ad26cd31be9e5287fa19f331d0a1ae64ded2b23d82c",
      "source_sha256": "19507b145b56173fe2de3eb03c6629e9914394eb7773a4de94118efe5cd5ea90",
      "translation": "打开主菜单的强化项目后，会显示武器列表，武器上有可嵌入卡蒙德的[卡蒙德盘]。\\n\\n用[LB]或[RB]选择角色，\\n用[方向键]选择武器后按[A键]，\\n即可在卡蒙德盘上移动光标。 \\n\\n但没有卡蒙德盘的武器， \\n不能嵌入卡蒙德。 "
    },
    {
      "id": "coalesced:b23710951e8116ed9cfebe0cbb293562fd22b6b59a2c7351a081c72eeec57914",
      "source_sha256": "d2f412fc262ac564d68538bd1083d7641057c07f0d51db9bf46dd0eb53c83ed0",
      "translation": "卡蒙德盘上有可嵌入卡蒙德的[孔位]，\\n可以嵌入与孔位颜色相同的卡蒙德。\\n\\n选择要嵌入卡蒙德的孔位后按[A键]，\\n就会显示可嵌入该孔位的卡蒙德列表，\\n请选择卡蒙德，再按[A键]确认。"
    },
    {
      "id": "coalesced:d138c99043c7457fffe694b111320c2e2ce2f749b9af3e6d4b2fb8850eb0887f",
      "source_sha256": "2f3aa0c18f2832db5fd9ccf353afbf39b177ae9a77126a5492af5cd62c39242f",
      "translation": "卡蒙德有红、蓝、黄等颜色，\\n可以嵌入与其颜色相同的孔位。\\n\\n但也有绿、紫、橙等混合色孔位。\\n这些混合色孔位可以嵌入构成该混合色的\\n所有基础色卡蒙德。\\n\\n例如，橙色孔位可以嵌入红色、黄色和橙色\\n卡蒙德。 \\n此外，粉色孔位可以嵌入粉色、红色与白色的\\n卡蒙德。"
    },
    {
      "id": "coalesced:2374196be36ae7e9dbd08c034d4bdc6237e53bdfd40c2e637655f81b51cf8708",
      "source_sha256": "64c543a0f7aa2a759ddc601de218c4057a453b8cb0d5c9006bb0181a72b745a4",
      "translation": "填满卡蒙德盘后，会扩展出新的\\n卡蒙德盘。 \\n填满包括隐藏卡蒙德盘在内的所有盘后，\\n有时会获得强化奖励。 \\n\\n尤其是阿尔戈和朱特的武器，强化奖励中\\n还可能附加火、冰、风、雷属性。"
    },
    {
      "id": "coalesced:0d7f3a1122505c13a9226d035adf61d7a4fcd70bdc596a29d886cb8da3a6ae9e",
      "source_sha256": "3c36875655ac5938d3236103e926269558420a01633df8e80403e04ed5e0f6ac",
      "translation": "武器上的卡蒙德可以反复更换。 \\n\\n可以将各种卡蒙德分别嵌入多把武器，\\n也可以集中嵌入一把武器，\\n获取强化奖励等，自由进行自定义。"
    },
    {
      "id": "coalesced:8aed2d6ab73bfff86c6d934fc156b60a04519fb9393c0bf945e4c60ad21a3bf1",
      "source_sha256": "720205bcef932350f59497ab45938b33698a821d800090b339dd20a4ce2bb583",
      "translation": "通常可以嵌入与孔位颜色相同的卡蒙德，但粉色孔位除了粉色卡蒙德，还能嵌入构成粉色的红色与白色卡蒙德。\\n选择特定孔位后，右侧窗口会显示可嵌入的卡蒙德列表，可据此判断嵌入哪种卡蒙德更有利。"
    },
    {
      "id": "coalesced:01dfc44a764647fe4ddad42cee1a796c4829d985338871213f11e399fb6f077a",
      "source_sha256": "d608a8396aef346206038bd135a89944e7d665aa37bbefd4491c3d6e337db820",
      "translation": "将卡蒙德盘中的一格全部填满后，有时会出现新的格子。\\n不同武器的卡蒙德盘格数不同，可以通过强化进行确认。"
    },
    {
      "id": "coalesced:c1ec7557e7e3baefebd0fca35c2e7c015f6e76206b67da2e416c038d735f572e",
      "source_sha256": "2d5238c3a1d14b8498353bbb64550e44a9638a15e2dbcffd706a1fc3b4cbc2cb",
      "translation": "持续强化，用卡蒙德填满所有格子后，会获得属性提升等奖励。此外，仅限朱特和阿尔戈这类使用力量KAN的角色，武器还可能附加火、冰、雷、风这4种属性中的一种。"
    },
    {
      "id": "coalesced:5f20a73fc76ade9d9b15d49ba9cf0ba72f95a2c27e18ca1fc2a8dd21dd82424d",
      "source_sha256": "21b7bedba74730ed8288576e331e33897ed7f691dee92302c49fe0c99b1fdb38",
      "translation": "风格与技能树"
    },
    {
      "id": "coalesced:d09d701cb8fc844fd6c8b68fb8b08feb456a6831876191dc9255f036a44fc4e4",
      "source_sha256": "ac25bbda9e3cb582c70ca3e2bb934ac6da9f5af669215fa515956f6b2a39a2f2",
      "translation": "武器种类与风格"
    },
    {
      "id": "coalesced:f5ac676e8111da63d34db8041107a581af00eb6327368bd55b2b948f5fe33bdc",
      "source_sha256": "2913fc2d335e7f10193459124b09f5fbfd9d56bfca2db3dc6010feef289d0992",
      "translation": "各角色升级时会获得技能点(SP)。 \\n使用这些技能点，可以习得新技能。 \\n\\n在主菜单中选择[技能]，即可显示各角色的风格与\\n[技能树]。"
    },
    {
      "id": "coalesced:b21c26e0345255b9016f0ba2843f0bd08c6c9ebca6eb0875fc60d073e57be6c3",
      "source_sha256": "81197265b914f290f650969f0fcfaf908a0654003f3ed8fe2d2b21a8e76cddb0",
      "translation": "在技能树中，可以查看该风格使用的技能，\\n并习得新技能。 \\n\\n用[LB]、[RB]选择角色，用[方向键]切换风格后，\\n按[A键]选择，即可进入技能树。"
    },
    {
      "id": "coalesced:9ca03b55ee7083c58462d5349b9bc70bc4412ee2a11409e41a4a3f830e4775e8",
      "source_sha256": "8e550b9245da12e75bd5513ae2abf1e82e09710e25cf9ed5b2e70373b6a80396",
      "translation": "在技能树中，将光标移至灰色项目，\\n按[A键]确认，即可消耗技能点(SP)习得该技能。\\n\\n习得新技能后，箭头相连的灰色项目便会解锁，\\n变为可习得状态。 "
    },
    {
      "id": "coalesced:5733a8c04f898d0667d9cb69b1b01f1a226a5509fb49522edef3c530e6c091d1",
      "source_sha256": "00702da02e44d606d8bdb15a0a9ad2840d12f0c394838c9b27af2188d50ce766",
      "translation": "技能树中的属性提升项目会作用于角色本身，\\n但各项技能属于该风格专有，仅在使用该风格的武器时生效。\\n\\n在技能树中习得技能后，可以额外消耗所需技能点(SP)\\n进行强化。"
    },
    {
      "id": "coalesced:4c8aa72ccea85aba1009153c8e40ec0b35db91cbeb77ed2366e035083ed07790",
      "source_sha256": "d15c29b8576a0f18403d03b2d2bff4762a64a3af4463807b15f7e31737784ce3",
      "translation": "各角色可以使用两种武器。 \\n\\n更换所装备的武器种类后，\\n攻击动作和使用的技能会有很大变化。"
    },
    {
      "id": "coalesced:67f4fdc9b31c76943496ab725daa6185a9171bc3ae768225ed3154fd92ced54c",
      "source_sha256": "c682bb9dccc01d65b8715f4dbf15ad109af235fcf06aca53691d0c20fd76e226",
      "translation": "例如，阿尔戈可以装备锤和斧。\\n\\n这里将武器种类称为[风格]，\\n更换所装备的武器种类后，\\n战斗中就会自动应用该武器种类的风格。 "
    },
    {
      "id": "coalesced:e22c80712bb12be900e0bc2d2df08dffaa813f1b3e968a16ecd7b06f39e62442",
      "source_sha256": "546afda179ee7dbdf6a8e92cae57e2a280e9981583f99896bd68a7dd1d357099",
      "translation": "更换风格后，使用的技能、固有技， \\n以及普通攻击次数等都会改变。\\n\\n例如，洁菲在法杖风格下可以使用[疗愈术]。 \\n请注意，切换为扇风格后，\\n便无法使用疗愈术。"
    },
    {
      "id": "coalesced:257e88609901ccd98c11da5cec0214c3abcf5c06f668d61fd1c92f5fafdb9815",
      "source_sha256": "12daebdf081bdce4fa2e5c9e39d256d3e864ebffaf5a5e24c26a60d3bd067714",
      "translation": "阻击拉提族"
    },
    {
      "id": "coalesced:9531336b202326f980fd8983723e773f0ea6e6a901781ea06af77c2c93fe62bb",
      "source_sha256": "3a1419fb220e1e273e8a96a44aa919d64dafbe23b1eca5b1586c4aa41b60da20",
      "translation": "小游戏开始后，拉提族就会出现。\\n拉提族会向塞蕾丝汀发射魔法，\\n或冲过来攻击。\\n\\n必须在塞蕾丝汀的HP降至0之前，\\n用塞蕾丝汀的冰箭击败所有拉提族。"
    },
    {
      "id": "coalesced:8c8b7fd9b126971c823dbf55960d34886747f20e42dbcf04f8eb8bea991df2bb",
      "source_sha256": "224babc08ea164f86fd8e2574de21d9d886cb2db69d922c1702114e1a04f461e",
      "translation": "使用[左摇杆]移动塞蕾丝汀脚下的\\n箭头，瞄准发射方向后，按[A键]\\n向拉提族发射箭矢，\\n即可对其造成伤害。"
    },
    {
      "id": "coalesced:a6fad9b50111cb6b3dfc1c5701b37af781d2cb3be5fac4b48a2d3b1b8388970c",
      "source_sha256": "e78ec4e171bacfe541060a0d7cee97f7b39f5c796e44fa46dbe0364946339d15",
      "translation": "除了弓箭攻击，塞蕾丝汀还可以使用2种\\n特殊攻击。\\n\\n[X键]冰爆箭：冰爆箭\\n比普通攻击更强，还会对周围敌人造成伤害。 \\n[B键]冰冻箭：冰冻箭会将拉提族\\n冻结，使其无法移动或攻击。\\n\\n每击败2名拉提族，\\n就会生成1个KAN。"
    },
    {
      "id": "coalesced:191c2341ba3b7948883f847e63df645ecb83f7af757ad04e8cbbe69e3b720d26",
      "source_sha256": "8e8f1f7d76a5337d2c653aa041e8037cb4c92d32eed76f4420ece0cec323aa28",
      "translation": "拆除KAN地雷"
    },
    {
      "id": "coalesced:51131399f2905dec24379ff083a2a00bd5135b8d24aa4fcd7619341152b90247",
      "source_sha256": "f4da894ff173ecf14749bf1affa7a22bbaa76b07e08545c39733998098495911",
      "translation": "踩中KAN地雷后移动， \\n或踩中后经过5秒，地雷就会爆炸。\\n此外，无论属性如何，只要生成一定量以上的KAN，\\n地雷也会爆炸。 "
    },
    {
      "id": "coalesced:0feef1839fe4a6b80da91587a665f853ebe870a47bd6e174ad1a86c6efdf3e6f",
      "source_sha256": "0de3bb1d9ce451ccdb66d51430bc4a3804b799dc087a059d0b109198abb24a21",
      "translation": "清除KAN地雷有2种方法。\\n\\n第一种是使用雷电炸弹。\\n将[雷电炸弹]选为场景动作道具后，\\n朝KAN地雷投掷，即可引爆地雷。"
    },
    {
      "id": "coalesced:8083aa5223db01e3768454dd2db3783de30e0aaec40a2c839fd6191a76bad687",
      "source_sha256": "88830792bbfca23731a69597315d8fa7af01a28e657482b962a31041817054ff",
      "translation": "第二种方法是让露拆除。\\n以露为队长，在移动模式下靠近KAN地雷，\\n[A键]就会激活。\\n\\n此时按[A键]，画面上会显示需要按下的\\n按钮，在时限内从左至右依序输入，\\n即可拆除KAN地雷。 \\n\\n靠近KAN地雷后，若未在一定时间内\\n按[A键]，经过5秒， \\nKAN地雷也会爆炸。"
    },
    {
      "id": "coalesced:235a81406587d4b75b795ee0c3d37bd20e826e6bef794fbf602fc0d5e1c344ab",
      "source_sha256": "ac78fe1415cfa2218a3c64230d80f95b7020ebd4579a2daf29a28dcbd84d69fc",
      "translation": "连锁"
    },
    {
      "id": "coalesced:03970a9299edb5d8a235ee491ce30802943d9c0058c849cbd367c4da6e4167e8",
      "source_sha256": "cf63562c729a394e430a4089a1f933aa4a37eaa20fe34a784d96359006710bba",
      "translation": "使用[方向键]更换队长，即可将超限状态的增强效果\\n传递给下一位队长。 \\n\\n这就叫作[连锁]。"
    },
    {
      "id": "coalesced:1fb9e93ed3f7ae8657009a74ecd075b8ed4b62c54695336a899b4ff6e4514a63",
      "source_sha256": "d663a5ceae53c0a2a9c77e4d4adb33a3ce83713d67de48791c6ed2ad075f3c6d",
      "translation": "要触发连锁，需要按以下顺序操作。\\n但在连锁状态下发动攻击后，若中断攻击，\\n连锁就会结束。\\n\\n1.在超限状态下使用技能。\\n2.在过热状态下使用[方向键]更换队长。"
    },
    {
      "id": "coalesced:3e784714e0463f7dd5373cab1bb551133a304a3117050887497ae42f3d0bd590",
      "source_sha256": "7aa3954e6bf7e95cdd737421987165b56512cfd587a6162c9ec877aeea08f07a",
      "translation": "进入连锁状态后，攻击力会变为1.5倍。\\n与超限状态相同，恢复技能等效果\\n也会增强。"
    },
    {
      "id": "coalesced:dac0bbfebdfdd5b9c19c28ffd01c0f9c4be9611dfc1e66da8dfc81f687fc9e9f",
      "source_sha256": "30563a8aa66017084d7147aad1820d80a493a697bb82afb37ab33a428329cc9f",
      "translation": "满足以下几种条件时，连锁就会结束。\\n\\n1.上一位队长解除过热前未发动攻击。\\n2.切换至移动模式。\\n3.上一位队长在连锁途中死亡。\\n4.连锁途中使用道具。"
    },
    {
      "id": "coalesced:a056973965e856f57577c5aa243e90603471aac8245ad97dd1946e1a7c1e789d",
      "source_sha256": "15bc68ea1f6d83e762b9cb0a2c927984e583abdd6bb59e34dd2c5d5109ecfa35",
      "translation": "连锁超限与连锁终结"
    },
    {
      "id": "coalesced:74c64677f41b0f621c855a0e5e86a3529618be08f079bc83e0662991c3347ed6",
      "source_sha256": "e5bf1887db8404f8e78fb359ed8529e91839790ab94f09fbd335f87ae883b1f7",
      "translation": "在连锁状态下消耗耐力，使量条变红后，攻击力会变为2倍。 \\n这称为[连锁超限]。\\n与超限相同，连锁超限结束后也会进入过热状态。\\n\\n但在连锁超限状态下使用技能，即可恢复全部耐力。 \\n这称为[连锁终结]。"
    },
    {
      "id": "coalesced:096e22d867197b7256985dbf85e51ae801f142fc4c461f91675f136afcd871f6",
      "source_sha256": "d66742d76578ebc3f578929cbd5e9b4e63e3c84e13baacdc9862f09b0b358e9a",
      "translation": "连锁终结成功后，连锁超限结束时不会进入过热状态，而会显示[ChainBreak]，并恢复全部耐力。 \\n当前队长与上一位队长的耐力都会全部恢复，请善加运用这一战术。\\n\\n但连锁不能传递至第3人。"
    },
    {
      "id": "coalesced:f8a4efd920a9464ad576766a3adfaf61feb5ab4e361d355cf9a25359b67f7858",
      "source_sha256": "24774ebd5c5545270b887281d4fad0c5295ca2c49a00fdebc189ac9a1c4b32e5",
      "translation": "要发动连锁超限或连锁终结，管理耐力消耗量十分重要。\\n\\n请尝试在主菜单[编成]中更换队员，或在战斗菜单的\\n[AI设置]项目中更换AI等战术。 "
    },
    {
      "id": "coalesced:5cc53af7526d739dbab3c9c1590a92011a0a10015a0fc2662d18d92469fdb30e",
      "source_sha256": "37180c71eb2224ef52018002cccfa877a33cad85c0aae725db425d55ae77c5b7",
      "translation": "环境KAN"
    },
    {
      "id": "coalesced:a17518b39aae1016f760b0317e0152f0fa31f3bf8d33d7b21468604501bd951f",
      "source_sha256": "90fd81ea8c37dd7cdf4114475e7270a7b6f569b987acd026dc072c1de0917892",
      "translation": "属性KAN"
    },
    {
      "id": "coalesced:c9a5b52d4688ddf18a5c0a09934e8f15f78ad3aa787bbd25bd4c30e0fcf59579",
      "source_sha256": "a841236564a15368994fe2e1140a8361d0991b0669b35e1a64fe5fca94295c15",
      "translation": "4大属性KAN分为2种类型。\\n1.环境KAN\\n2.属性KAN\\n\\n场景中原本就存在的KAN称为[环境KAN]。\\n环境KAN不会因使用而减少，\\n因此周围环境是战斗中的重要因素。"
    },
    {
      "id": "coalesced:5f01964c98890b562e96e6855ce21c05232193227dafb07e021ae709a99883c4",
      "source_sha256": "abb6ee586e0db2a90c709b8ed5cb78341e7339ee0b98701cea666c61a034d554",
      "translation": "环境KAN会显示在小地图旁的UI中。\\n\\n但战斗画面的KAN槽显示的是连环术师生成的属性KAN与\\n环境KAN相加后的数值。"
    },
    {
      "id": "coalesced:1284a7a0889ec6cca72042fd1e8a195acced6e9d0fb49628d6ea0793e2ec36aa",
      "source_sha256": "9956091c026e524974c4f80e472d5706a41141566cfae60fa6394d559d3b87a2",
      "translation": "世界上存在4大属性KAN与力量KAN。 \\n\\n4大属性KAN分别为火、冰、风、雷这4种，\\n连环术师会吸收其中一种KAN，\\n使用连环术。"
    },
    {
      "id": "coalesced:f6cf36c4b0d859ac394f813d02bc0b76f13120b7c5668aedee028d6adc42e13d",
      "source_sha256": "9f05c22027713a240d012c92b1f3821d82ca7a69c3d6b20c5718e7d73803af17",
      "translation": "使用对应属性KAN的连环术师\\n发动普通攻击，或使用特定道具，\\n即可生成属性KAN。 \\n\\n这些属性KAN可以在场景中看到，也会在UI中\\n显示。"
    },
    {
      "id": "coalesced:33259a6de1b3d094a8d48b0a822e59418395799bdf2ec3d5a94682db9e280eba",
      "source_sha256": "2fd6a106458ba5a0f47734b256868310434d11ca0aaa5bf1fc9bd4d25aa57b58",
      "translation": "离开KAN生成的区域后，属性KAN的使用\\n会受到限制，但它是施展连环术的必要因素，\\n因此在战术上十分重要。"
    },
    {
      "id": "coalesced:3032816aa69f2ab419fbac6074b0a2b80e585ff172777713a9eb79fbe08cc6d4",
      "source_sha256": "0b9605f87c94a1c85a3a3f2cde14e586e61131e0ad3d6a53bb844359b0639117",
      "translation": "此外，还可以用特定技能将属性KAN化为道具，\\n以便日后在需要时生成属性KAN。"
    },
    {
      "id": "coalesced:995ae735a16b50a3e91cd94675e582b4a6ac2340ec444e6c7648831285c6948e",
      "source_sha256": "99173b13175f83cc134af66aaa5f91d42a96ea6d5fd9040abe1f38f47e95648e",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/>下一步"
    },
    {
      "id": "coalesced:32f84979516468d673b9fd5bd3ba5002c5eff1fdb7b61c0a8ec5cae5f7cd0916",
      "source_sha256": "d15544b3137ca584ab4c859a37bdacddba7bf5e473e6bb4d85f87c2608b8ce49",
      "translation": "<Styles:MC2_StyleFont_0>A<Styles:/>结束"
    }
  ]
}
