{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:4e22d9d2bec3af84c8191f84885155ea418f3dce0382248d91d1cc58de8f1eeb",
      "source_sha256": "fd28e960522e5160ad12ea162b96c87c25f86231d0cc7eec9fc8781ba832231e",
      "translation": "咦，起得真早。睡得好吗？"
    },
    {
      "id": "coalesced:7cb1e237ca705874bc52d25b177b4a0c295e06c24aacbc38c59846bd0616ee3c",
      "source_sha256": "3b0d9826e4237e54d8df9853c1c3951be03135aa45e5e5a7181f7090ba9eda9a",
      "translation": "嗯……"
    },
    {
      "id": "coalesced:ec38c745d0bfaec01403ee82486859829cbe9d50a0e991a7875990908459f36a",
      "source_sha256": "054dc4370f4399d7ebbdc55daafbbb417c1bb0fb49f4f5845972969354d21e06",
      "translation": "本以为回阿巴泽特时，你就不会在身边了……结果，我们又像这样待在一起了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:839bf30044dfa1cba2b8905dffe25d4dfab2e643e7412ec80176711950f94300",
      "source_sha256": "292a547d6528abaa225d8f4489e7941fff161a3b3f30f10873ed6eae700972ff",
      "translation": "你是不是……觉得我太任性了？"
    },
    {
      "id": "coalesced:7955678d036d402feeb9c8cfb445b16683fb563a7737a9885e7409e5d64150a4",
      "source_sha256": "f0993048e3595ff0887748f07af6e6eaf20792cc34ae5fcfcbb62e27bf5f91ef",
      "translation": "嗯……一开始在风歌洞窟，你也一直固执到最后。不过，还是谢谢你愿意这样留在我身边。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f840df8068c5428054d4b03ff6ff3fe02985da68e20c1b49864bf84f248fbe17",
      "source_sha256": "73462b48d3e2b91616096db3eb1f5efafd98ed86d2158c9cfeae2725e084e65a",
      "translation": "我原本以为……你也许会去北方，去梅莉莎那里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:76b709b2ab8940058a385b18caad3841f30912491299555fb0e9bdd2e6793700",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:de11dc0b6f4257fd7413a455df388c52bd0190d12db744d8fff5cf6946acef65",
      "source_sha256": "5630fd73ddf5243f44d0fde32c8eb475f10e6fc15d4346a3af648404594defd2",
      "translation": "虽然不太会表达……总之，我对你……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f15d4383e8ef40df13a3629b1ff7b9cd409134dd5d419d13b54ce359db722b8c",
      "source_sha256": "b87464b402e4ce954553c12ca210cfbd72239e15578d2b04a84453a8cea85f96",
      "translation": "像这样……在这里……嗯……"
    },
    {
      "id": "coalesced:778f4f53addf24254e2cfb98a621ab2c58f8a9c192acccb80674fc36f1409ed1",
      "source_sha256": "5197b878c161d1d8e491a1194eba38bbe79fed1988a19e651cc9378d50a85489",
      "translation": "你是想说，谢谢我？"
    },
    {
      "id": "coalesced:e2f535d2fd818b68aff78359366fd0903208f0b40c0c6864cd3fc2a132832da7",
      "source_sha256": "a1b92bb5cda90d34b54f375a3fb880edc9edd9bc9ca8313994aeae02f623060f",
      "translation": "啊？啊……嗯。"
    },
    {
      "id": "coalesced:cf187f6dfe75d7431eb0d221e12132e1f78403b259d108ebdf7052c65bd957cb",
      "source_sha256": "5bbe69d67dabb10c065c90644e8d39ce59f03f16e6e1b9568bafd22e63cde4bb",
      "translation": "不用了。我又不是为了得到感谢才留下的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:30fc79885cd1507c37ce70732b3d6475bec5b22ab39daa63a8db8803b7a4a2c1",
      "source_sha256": "8c2f1bd870385587c5d3baca0bbb31a5f3882d823a29fea92220592098eff94c",
      "translation": "也是。"
    },
    {
      "id": "coalesced:9222a3291cc7eb1f3062a327c4db2e2773e51f5e11ae996a3b7930e94f972dce",
      "source_sha256": "36d1b21a38ead0a1dff199e77524e36384f7500ec87f0ddc5bbd3c76d214757e",
      "translation": "不过，洁菲，我有件事想问……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:be016bf1189e1a48eef2c58cb129e2b42a8dae6ff9afaec016b5e29231017de6",
      "source_sha256": "962976e9c06541e162e0493cd6007befcf093e981cfbc6c29fb866af66bed77a",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:0174964f8dd41e96b90e12bb51a0ed3d9ee2b41c9e83526f465afa6902dd6507",
      "source_sha256": "413222a99c4b805cf75bf15441430369bb7bab0895374554cf7d5acdd12f7ee2",
      "translation": "我们以前是不是见过？"
    },
    {
      "id": "coalesced:e934208ee472806feb6b702a00402250cc075b7e2e49cda92f6e3a444a850002",
      "source_sha256": "46eb7d5092bcdebc48b2e1ffabedec870805afac92c712039c53cde0cc282e1f",
      "translation": "这个嘛，我想，在岛上应该是第一次见面。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4eeb8e889e806cfb786f663398a564805fbbde1d8f530466ce83b2014ced7a3",
      "source_sha256": "ebbcac9746136273660de180da49766e59f2ba8b28d657a010dd56b07e40a6c1",
      "translation": "怎么了？难道你恢复记忆了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54e1ea96ed098bad99e6f3c9f34fd2832a659238d95a6cf49379fb7117136527",
      "source_sha256": "80c88ceb8fe6c1a888a32fde071d0fb96347fcb73b811b0647df002900b88d79",
      "translation": "啊，没有……"
    },
    {
      "id": "coalesced:3fd529f8af13ba54929b8a268765affebf22e00a832369e5fc6b1d2e95428661",
      "source_sha256": "6a8bfcdf6f792c34e830b144b457e75896e8a4cfa89b3dd315519391e26dd4a5",
      "translation": "那为什么问这种事？"
    },
    {
      "id": "coalesced:da89fc44c100883d21ac659931d9e46c44dfc0d1350925af42491986fdc6cddd",
      "source_sha256": "bf2068790b8dacd4e07ae8d37903fece2f29c6a23f09093b7082ae739211a18d",
      "translation": "没什么……只是随口问问……"
    },
    {
      "id": "coalesced:ce91b13a29fa8a35cf685aeab37019d00967323d290c6abac13b2fc48efa424a",
      "source_sha256": "30bfd2008fceb8d7dda39e09324a4cedcfc2739f08634b315a5645b172f4ec3e",
      "translation": "……？"
    },
    {
      "id": "coalesced:b981b62c0d3dbb0a96e516f44da58d413980c3e794b92ad7fc83f2754a3f83cf",
      "source_sha256": "b5c4e384170266f764b9b58c65c398a42849928d5e19ecfb69626adf43e32486",
      "translation": "公主殿下，原来您在这里。"
    },
    {
      "id": "coalesced:cece2aaf7281250ca379f65846fdcd37d33ad6e364be11fac74e6c45f6dd0403",
      "source_sha256": "f1c14893835365702cc721f9acd4373954af1fbd48908b43ed395e2ba6b3588a",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:14a6ac6757f9e0f1058250b545f9ae9aaf5eff2d45d5d15c792c6f2e406f7a11",
      "source_sha256": "a97369f69759859e5bb37aaf621f152d323fae55fefeade98791a516500a60bd",
      "translation": "为了鲁哈尔特战役，有些事情需要准备，我想向您说明。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16b663594fb046a356f45214e2361f117fcbcb69dcc5ce1e8ae0acace1f5a60f",
      "source_sha256": "a6127aa6f6225c8d12c1764ecc6c281e1a881fbf00a9ba89419323b2cc1f3d88",
      "translation": "是吗？那就让大家集合吧。"
    },
    {
      "id": "coalesced:aaf85de9efc3639fbae003771a158726f7f5dad6825369b386cea5423f9455ad",
      "source_sha256": "1aab7481296b6db3a58b7e99e0fddcb05dcc386616d4758e8be460be9bd35f6e",
      "translation": "那个……果然只是梦吧？"
    },
    {
      "id": "coalesced:6d5cd8b1f58251561d63115dfb9852fb93653d06d76023e5157745ba9dd0d80d",
      "source_sha256": "af6b6da9531a5e848b91aa5a6c36cce50a7d1fa583dded8fff50b4bbfd6ff8c5",
      "translation": "把它当作一场梦，是我的失误。那个噩梦，其实是我失去的记忆发出的警告。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:949eb6501a9675d451f57db1dfda8b88c8c6a0563573d35b36bda0f686e28ea9",
      "source_sha256": "e08eee37929a5d4afaa70984d9a7e3261a9defaccb4e2bbafe15ef280d3fffd8",
      "translation": "北部军似乎在鲁哈尔特盆地部署了新开发的KAN地雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:317902b63db92b0990058e0c6c6e8307a78cac31ad2f88d3d376d37b47f42702",
      "source_sha256": "f7e414400193041ee7b2d43e7e659a7b76229af5fa8679efd1f2c2bc24e0d142",
      "translation": "据说，KAN地雷和普通地雷一样，踩中后经过一段时间就会爆炸；即使只是周围生成了一定量的属性KAN，也会爆炸。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9e9055ec0ad784cb4f0fb04f721d84c51b9830048ed1e9787682dde237a50d8c",
      "source_sha256": "ad17f17d42cfc7702c2cc388844a2bc0409ae44442e7fbec51a50e9bfbb0031d",
      "translation": "北部军那帮家伙，真是的……"
    },
    {
      "id": "coalesced:79e618ca7aa0a2e5bbf6b7fd018003f2f40e634ed14fb84644e874f062b06fd5",
      "source_sha256": "407d3435364f6aa049cbc3b27a9981c5a7f14f542c27bdd6d656a992b846fdf5",
      "translation": "因此，为了减少地雷造成的伤害，我们打算准备“雷电炸弹”。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:06c032e674e035bcf7c44f159370f766bbaaabc51b257a2ffcbbe64f8848bc2d",
      "source_sha256": "2a9076984668053cf0899059ed46b992e786631063287c34896481b8b544c3e3",
      "translation": "雷电炸弹里装有雷之KAN，能够对金属产生反应，起到清除地雷的效果。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b2639e695d276d13ba1fadc08b1a69820e893106064054353afedf71d5da6992",
      "source_sha256": "31d8982d7e79100864075c710925d6eeb0514cf342c25872574553a404858f37",
      "translation": "经营武具店的法伊尔瓦因先生会帮忙制作雷电炸弹。我上次已经提前和他说过了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34614bbafa839543d86a8bd638f782864824fc37387ec24ebf4fa84b0b999fd6",
      "source_sha256": "ff3619733e4b7dc95d054c8b04ccdc868c5335fe45aa8e48e6c97f6aa0c803f3",
      "translation": "好。那就马上去见法伊尔瓦因先生吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b88270254a59426bb03336c1ca01f8594d66e87d40e01837e9c5e077b97f7deb",
      "source_sha256": "f60b63b2e31ff43ac8133d6c9952411f96f36e2291cf4c27b8bb513a6dca3b5f",
      "translation": "黑刃要塞即将举行鲁哈尔特战役的作战会议。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4d0d5a656fec2ffb77be23822b0106ce5af55db088b21e175f7bd4664dfb4abb",
      "source_sha256": "9c07355ccbf39951ea4999300265e3c432de06e0702b84cd03b3acd39a27565d",
      "translation": "有士兵正在阿巴泽特入口等候。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:314cdcf4f59ddddac842841226ec9784c41640fccd0b99afc932b68b78fc4209",
      "source_sha256": "ccd1df12e1181c44f6f07ef3c5942c441cc59f4fa621661092cd1d45831a8311",
      "translation": "跟随士兵的指引，就能乘坐卡尔玛前往杜南丘陵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a0ddb81686a8d9f4aeeebd68a8ef04e24cf0d6c052707671d3f8fd96fd8c21be",
      "source_sha256": "ad9c2dd1a3e35aad44c385a8413107e874a2e2d58de6a6e75fed54bdc16a378f",
      "translation": "我明白了。我们马上动身去黑刃要塞。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f960238e2b56903b8c768823bfd0ac29e36796b10680c8bdd43d079f94ba10c",
      "source_sha256": "f7f12c11a2dfeae0e41e2baa8afd45f5f5b4e49260bab64040046d72669aa505",
      "translation": "去杜南丘陵之前，我有件事要教给朱特。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94b1b0fd28031cd54c195a83ba317cb5417312a8b741b4010d2d89704cb128a8",
      "source_sha256": "962976e9c06541e162e0493cd6007befcf093e981cfbc6c29fb866af66bed77a",
      "translation": "什么事？"
    },
    {
      "id": "coalesced:f172216d13fc3814baea00d7d67e7420007f1fbdc308af83b631b7a8ebcd5c13",
      "source_sha256": "544dcdc255137c39ad5798b8bf075774fb8e2114d01832b0523d63a2e1d58597",
      "translation": "从现在起，我们可以使用“连携奥义”了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f657f477e10903462510315231a24d3d82ed6af19ae69f8d1b860071f90cb56",
      "source_sha256": "8d9ba57e1014574876541a8b7baa38d3aa64c063a3584a9223b428008d110e83",
      "translation": "连携奥义是什么？"
    },
    {
      "id": "coalesced:41c888ecf8405db6fbb4719f13ecf3346d12f693f1405f11ba110e2c7a08cda1",
      "source_sha256": "65b95a02e6d008410d6c02821f57e15e42f3c59342acc2e0018d1e8d4e62a454",
      "translation": "连携奥义是一种特殊技能，只有心意相通的两名队员，才能共同使用。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bdbf7f4717aff8920d224a2a1827dde50025c8e84b5f7892697240f494706a02",
      "source_sha256": "9cb5d53a7b35072e1ca0540e5de862386c8bd0e01e4077b4a94bb432620fe061",
      "translation": "真厉害。要怎么用？"
    },
    {
      "id": "coalesced:7962812dae9e79033a3c6b55400ac1aa44faea547d58d20ffa7f968101460939",
      "source_sha256": "753ae13c4bcc790e1f4357d537bd0da063c6e7224befde6e878dac75edc06b8c",
      "translation": "首先，你和我都必须切换成能够使用连携奥义的风格。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:77494b5a39cb1d4918a2b5229db8abcea4c1d21ed344ada1f3e674e66e6b0bae",
      "source_sha256": "fa05fff9ab84e212431f1abaf9788679cb30626e24c59137b5c4998f7728d09c",
      "translation": "你使用双手剑、我使用扇子时，我们就能施展连携奥义。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5bcddd3cbf02ea3d7e7c68957265ed58d115b625811a911c66a6ff71d6361f61",
      "source_sha256": "9a49d349e390812ecf9c6e3d92cbc72b7cc90d84dc411a11b7994ae866690a09",
      "translation": "双手剑和扇子？"
    },
    {
      "id": "coalesced:e7832d2fb8e23759afb2ebdd48d5303cc6640c1546b058d7c6ff643287370c13",
      "source_sha256": "dc8baa0eb0e4a2701b071018afb2ebe8b7ddef26bbf9f3f48210f8ba67c94208",
      "translation": "嗯。切换风格后，我们必须在战斗中各自积累5个KAN。你积累力量KAN，我积累风之KAN。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cf1bae3eaf3e1f922a0e344d43a3c4dedee0680a4696fe51f76100a2680833dc",
      "source_sha256": "114fb2b148b670feeefed05d0ad00e9055a4c460186b1fef45d8e08da07df728",
      "translation": "之后，我们两人一起发动连锁。"
    },
    {
      "id": "coalesced:8ac5791822241bcc0e5c8ea8a6e70db1224f0d6805c31a8afefb39734b525668",
      "source_sha256": "5dc894755c49100f35c88986345e2b281cad34ffdad67f2d23084aff7cf8b7be",
      "translation": "进入可以使用连携奥义的状态后，画面中央就会出现按方向键右的提示。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74b3b47fbd3ac5fd6b4e5917823f3da5d966531f93d9b3e1a25c642ed47bbada",
      "source_sha256": "1dfbb29a0c17745cf79049d0c566a12e779047b6f5cd6a68822a88f90a435340",
      "translation": "配合那个时机按下方向键右，就能施展连携奥义。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0a43654a635c23d57875cd8f58e18603d561d52b12f671e656b9a5f8e18c489a",
      "source_sha256": "7328ab993d295dd7c760499540218059aea7294dc16a9cdcbde4dae029b12ca1",
      "translation": "竟然需要5个KAN，看来很难经常使用啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1c780c76af53ff676305aa295843af5f2a6cd9885def7d3bb351eee580f0e5c7",
      "source_sha256": "a8b8c7cc0eee82120fa996b065d84c72d47f2cba36e9fb628f8abefa55a0e286",
      "translation": "连携奥义就是这么强大的招式。"
    },
    {
      "id": "coalesced:7bc762df1d885fbfdc175c08a3c7bfd3c283c00fba649aa4f4cbaa608619deef",
      "source_sha256": "588bc1f41da3835b3f9e73a268973c5c95180c61ed2beb002082af93cbb34005",
      "translation": "好好利用队员的AI设置，应该能更容易积累KAN。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9cbdb01b3e2d4e6ee357cd2f4ad167510319cf4fad4f1a768826af6326bce6f1",
      "source_sha256": "82560b87b9fd406fbb3247d78d4f6991af0ec7dd7f8c392eb8e8143877955f72",
      "translation": "不过，这条件还是挺苛刻的。要是能简单点就好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8332bac6dc10dafd11163129e5faf6872cdf3d24c8ac8283a3de34049dc45d90",
      "source_sha256": "23cb50364a53bb246070cb6ff14f406a268fed2f239cf0ff13ea83624cd0bba6",
      "translation": "所以才叫奥义啊。"
    },
    {
      "id": "coalesced:75bb051434886fa40d0076b77ce259d52036d1aa89db63d93197c56a47e77360",
      "source_sha256": "a05ea89793e5af5363d1104f41aff5070d143ab1f143d0cd1ff37ec50ff28f3d",
      "translation": "就在这次战斗中试试吧。"
    },
    {
      "id": "coalesced:a9a211bc9255efd65dca2b1904afa2b89b63dc94b6db7d34dd0a9687fefb1e8e",
      "source_sha256": "7cf69d7c6a98b03e10d7ac3df817b752c5eed5abf5a77f071ea9fc70164637e0",
      "translation": "公主殿下，我们一直在等您。"
    },
    {
      "id": "coalesced:0164518f61c5d838a50e8b53681bd7d29f49673b54218ce1666eed6debf10787",
      "source_sha256": "992e86298f031963a93d179369fe51a218a35006078b345765d839f21c018784",
      "translation": "嗯。那么，开始会议吧。"
    },
    {
      "id": "coalesced:e10e2159667aeae68a297aa00c64889b7e65d0cf4a4a01487fecff42e8b4b481",
      "source_sha256": "8445741d7d6a831276e8794b874cebee94940ba0e963d4f109bf72f437426789",
      "translation": "是。"
    },
    {
      "id": "coalesced:5f7ccc29a48efb6b94796bb893b90210e96c7a2eab1a27dd98993c446cb44e48",
      "source_sha256": "a6e57757a421b389558ff00d98fdcd4fd0425697b1b461e53db1ffcd423af287",
      "translation": "据说，鲁哈尔特盆地已经部署了北部军新开发的KAN地雷。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f5982aee131c152dc436bf6198bd6895a01aea30b89bd147f8fc1bbc785c4bc3",
      "source_sha256": "d55c41844d34a1d56e5680d55184429f2ded3e0cde046998ccc824bb5d34779b",
      "translation": "它虽与我们熟悉的反人员地雷相似，但KAN地雷会在KAN聚集时爆炸，恐怕会对周围造成严重伤害。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3faba12b3a66a3f8940f6ade964c3c2e87cc1ed467bdf65a6f744b97cdd9e3f2",
      "source_sha256": "464f510a28dae7f019911020ad60e83c13d6f3669f5552d95707f57f9d5be0f5",
      "translation": "这次鲁哈尔特战役，必须尤其小心KAN地雷。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e9688ee0abff6623b38ee69ca9575916b70245fbf08715496803959d825a8e8b",
      "source_sha256": "6e04e4d2f53bc2c432ac9d254d447d9ac41a62c0f9ff035793022da0939fc261",
      "translation": "鲁哈尔特盆地有两座晶柱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ba9c4ffaece20d2263b84c563359a74656732c7d19f877c51144efd96af17b85",
      "source_sha256": "f14d7250a22ddd1964b4f272982a9a1455c5ae5f61b8b6c536c4e05cab95c25a",
      "translation": "一座位于鲁哈尔特中央，需要经过北部军占领的桥梁，请多加小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f92beb3124996378ad113b3d96f64244b0ac09f3e3483ec57b8ece8a7f8b90fa",
      "source_sha256": "32e82511e891f1adadf62ee219784ee4e67abeab835f2cc0ced4892c792e4aec",
      "translation": "另一座位于鲁哈尔特东北部。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:95128438398caf70dd1c768b74090183baf8121ad4658015b190a6cf151bdfe6",
      "source_sha256": "08da3eab1404e88379aee911238e0eb1ba38aeb0411fb1b7226d665eb17c7237",
      "translation": "那里是聚集在鲁哈尔特盆地的北部军大本营，设有北部军营房。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e501846a0ef8639b095682ce367418aef18ac58b2c579df845a5a4d07b80ecce",
      "source_sha256": "f7fc5e0a8162acb53f9bdbca922dc2e64943524f6c81d7785d67c5f4e7d20c29",
      "translation": "目前，北部军已失去老狐峡谷和杜南丘陵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6c55306e0d950f3bfceafa260acb745890318116987e25c58367c2fced0e3b17",
      "source_sha256": "33797b3880615d00f814bb8190adbea88d123e5bf750015f1a7b7b2d22717a27",
      "translation": "而且，贝尔福特南部地区也在我军控制之下，鲁哈尔特的北部军因此被夹在中间，陷入孤立。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f7482ee348977ac1aade76627a2d7aa390387652225a5939325d306bbbca095",
      "source_sha256": "6346052d368b5c4793712e7036196440ad105d1e59da953fa57ee491fe36f05f",
      "translation": "据情报，北部军正在逐步撤走驻扎在鲁哈尔特的部队。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5857945a8bd66666c8ccdbd3781506d31ce8c15fac10ab9e2bc39f87ee256986",
      "source_sha256": "66d833af73bc309a215692523cdb92f8adea8c4c9ee59f79fac17eadc13145e2",
      "translation": "恐怕是想把全部战力集中到贝尔福特，一举发动反击。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:64b8f98250060f3adac2caf51b57b6d2ab349195e960e01382d434eebf01c1a0",
      "source_sha256": "6ae13d51a0003b0f6186365b1e0d8296415d5ede3a91a319c2d7ef713094cefd",
      "translation": "因此，现在正是占领鲁哈尔特盆地的绝佳机会。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d410e0fdc24e34164f8f6acd1e0c4bd9d11304fcef88654930babed83192356",
      "source_sha256": "02d059a17e7b915e667e05540a6ec3cef1f414201a4ee8373d8c3e6434d21f5a",
      "translation": "没错，不能错过这样的机会。我们马上前往鲁哈尔特盆地。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ceab2094bf5897314fa0bf721d5c421e98b08f7351f77a008bc7468b81c3bb03",
      "source_sha256": "6a1d60f43afaefc75c41f261884ba88b405c727ec502441e1fcb34b4e9545633",
      "translation": "若能赢得这次鲁哈尔特战役，贝尔福特就近在眼前了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f14111ef14f151bdf1549342364a5c71d2ca767c6b70680fb274d4edf3208a45",
      "source_sha256": "2f43478b2c17b896727161f8e175e2d6ca620e7ec786ed42ddffecbd22f61206",
      "translation": "这场漫长的战争，也即将画上句号了。"
    },
    {
      "id": "coalesced:0273f6cf646191c4ab56e305774e6994d77527cb02bf2ac675a0c92520417b83",
      "source_sha256": "52c5842ee81843ff461783af848498a21d78eaad947fc889b3b1305faecc6ba7",
      "translation": "如果能早点知道哨兵的弱点，战局早就改变了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0c39f997cfa881ef2793ac26b89c738d3c3b790ecd70d4c78d353ab9a1dbd5f",
      "source_sha256": "a251a841c86cd0ab5a02b6a53336eb542041e7066ef1cb32bba850ee8845c133",
      "translation": "去年……露确实曾成功取得哨兵的情报。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4364e7f2a54ec20b223ec5d42a7ee73a01709e914b5832f6e243b19cab369295",
      "source_sha256": "1fd3673da01ab555db80aad37b8a74d099dfded9869ef5e1d47ff460bb147b16",
      "translation": "可惜，因为受到艾尔加追击，丢失了宝贵的情报……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2a9eab77ec127d6a33030bdf9ebcc1be7622c181e13a168abb529568ebd4546b",
      "source_sha256": "ba6a75cfa4788de43c8f6808771ea5edfdb6bbe263c4698dba231e6854c9a5fd",
      "translation": "是公主打倒艾尔加的那次吗？"
    },
    {
      "id": "coalesced:ac9c9b1b477ad5532bbb9590205f9acac10f44a986225865280074f7c8d1b681",
      "source_sha256": "cd7e32201d4fb735183ba6d5d71bbacef8dbcae303b556cb8bdd3ee682a20d05",
      "translation": "是的……艾尔加出现得实在太突然了……"
    },
    {
      "id": "coalesced:2fc7df07bae9b0b0600efa83c903cb4cc140a65ec956b3db39b35d84ce844720",
      "source_sha256": "63dec6620d960540f6aa8e0a250f93b3df1fe921f5a64e348a7f3f6cfabe6344",
      "translation": "现在回想起来，确实很蹊跷。作战计划究竟是怎么泄露的……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8111c80e0f63ef7552edd8f5a81dd2774f69a3a0712912d8fd19257882761ed3",
      "source_sha256": "1beeabc62e3aa5e755560a9c3630f004955ab7f4823d5ce2e3ad4083aeb0ff7b",
      "translation": "所以，其实我也自行调查了这件可疑的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a9b6f310a483b78c0a00becbe533f5215ae8a20d4ded53b9591a36d6890fc80",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:2c77a9409a2e65536e7e04fc4ca7218f4c25b26137d34e2989d9a92722f80417",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:8920c48ab52fc877ab2fcd4743aeb3fdd2e040c083ae0b7b575fc056c4c09f53",
      "source_sha256": "d631a55348c5300c89bcbe721912a679e56c17b6137524a0bf230d511fd0bc76",
      "translation": "亚历克斯大人，传令兵送来了紧急消息。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5a7c7cb919d9198d87e93576d850e030d9a097c38cbccd33ff03477879f2ec5c",
      "source_sha256": "51fbbce47661185999b03a45042cf97b07d4ccf7ce4835225d4fc60ac3c49d12",
      "translation": "是吗？我知道了。"
    },
    {
      "id": "coalesced:ee68b6c48f20411ac72ca96ea1da5b97a6686bb5e4f8471c62273879b31ebf8e",
      "source_sha256": "02cf421948738903c9248c65088162830b1b13909f645d8f3c5b9642d7d8b4a7",
      "translation": "劳德，看来只能以后再谈了。"
    },
    {
      "id": "coalesced:afa5cff500c69fd8f41bde2b49fa35e8c53b54c55b56baaaf05faf5f9397c110",
      "source_sha256": "094644b1f9bce6e6e77af6d2c8d4f76d412d1c1337f3ac77caa6854f8f9a7136",
      "translation": "是……"
    },
    {
      "id": "coalesced:446187fc02386607c17218465b2a0a20b197b1393bdceddabbb41b0db98e41a9",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:58239d44f01528ad42b78940d885b2b97b1a89b3277b2404012414757cd5eacf",
      "source_sha256": "1aca9676a36e2b107f596c3e2318dfa007a0e1ce7d059ca6ce3381e67c18c24c",
      "translation": "哦，你们来了。听说你们需要[雷电炸弹]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0aadf8ff8b86b922db34cb4b0823454715be8b06674892a50cc39af3c22691ad",
      "source_sha256": "3051989774f396bf6b339994006cc7760218fa0658917a28220f344ebbd6d311",
      "translation": "不过，说到雷电炸弹，没有雷属性连环术师的帮助，是完成不了的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:68e2d9d1c8912292152cada5b3ab810d293f26bb467a91853f0ff0c72b27b3f3",
      "source_sha256": "d3d0e9ad381928e8c901cb721577e89200c729cf71a220d6765713a1b4ccac18",
      "translation": "它的原理是将雷之KAN凝聚在内部，再借助那股力量爆炸，所以需要能操纵雷之KAN的人。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:749d6c5c7685c60ab4e28db4a75acf1bc5739c22fad0fb699a7c0141a3523c07",
      "source_sha256": "d87835afd4693e4b5a8b516011281f5519bc9b2f592b7a27a98bd813c678b069",
      "translation": "其他部分都做好了，就只差给炸弹填入雷之KAN。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0510e867efe4700bd48b7f36f062bf2806524cb752fa00176653799aa4e9cba2",
      "source_sha256": "1c1e08b27dcc8faef699e3eb47276f1134a23809ad3b498bc26a7f3f6bf1b320",
      "translation": "不如你们直接把炸弹带走，去找雷属性连环术师，将它完成吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d38b0ab6b9f853285bc64675076fa414237b8cea610cee195f214d212d9cf8fa",
      "source_sha256": "5cb330282b75a65a5109527d98c29ac247c1c1bf03588df73930aaae9e7bcfd0",
      "translation": "等连环术师生成雷之KAN后，在那个地方使用未完成的炸弹，雷之KAN就会被填入炸弹。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:94e0708f2e909b733c8f1bc60f479407495ac3cea7ba025788a30e311dac5159",
      "source_sha256": "bbb7523cc7e8dbdefbd26d719c73bbb522b445b53ef09313808f4d88aae23502",
      "translation": "制作一个炸弹，需要2个雷之KAN。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e401ad03b79b26bf98ba8a1adf769874da50657102a0e58e31810cbb0bf26cb9",
      "source_sha256": "024ad73fd683398351f9d2640f2f43f4f39acd3caca668b3000378ffaaa3e7d2",
      "translation": "没有KAN的话，制作就会失败，最终做成的炸弹数量也会相应减少，要小心啊。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f6d3ed8451e5d57be801ce11720ad6097dc3120b9c26da38ea213e576f70b7c4",
      "source_sha256": "740d42af60e98b83177cfb621631638f287345ae5fb1a35ecdc7556ecc0ecb41",
      "translation": "来，先给你们5个未完成的炸弹。"
    },
    {
      "id": "coalesced:bba3de6242129a1a7f4332701379ef7105451a42760fe8a8f34a6eef74fe8a1a",
      "source_sha256": "857fc0743a01aaa5fca76a5a98ca0aeb84eeb87fde587ae4df51efb199ab7e08",
      "translation": "你们可以尝试5次，做成的就拿去吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:838e9aff7e22eb60a7e049a0da3ac16d0ef95e01d7478c3d82cd7b0c1e7c4a6e",
      "source_sha256": "8c16799b58607304e114001634c01bfd64f60980e8d5102cb1faad45dd511a9d",
      "translation": "那你们就等着吧，等我找到雷属性连环术师，再把它完成。要等多久，我可说不准。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b804a7eacae42f77b513742a6b05d087314411992fbe2c8554c3be058d5c86d0",
      "source_sha256": "5cb330282b75a65a5109527d98c29ac247c1c1bf03588df73930aaae9e7bcfd0",
      "translation": "等连环术师生成雷之KAN后，在那个地方使用未完成的炸弹，雷之KAN就会被填入炸弹。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0b3ae67ef58e950d0c13ad160e6823542b4bdf9ef76ed002f7ea154deda505a2",
      "source_sha256": "12b1e7be6e6621bf43cb2e62b72eeee700dfef7c315e4ea9ccce58716db95ba1",
      "translation": "这么快就完成了？"
    },
    {
      "id": "coalesced:822cd02aff7ca800a0671a842098b763964a9befe1d2289ab5389b0fe3af4751",
      "source_sha256": "23ae838e0ee6acbaf17fa6a444568fbcfa3369a270af3995d78685e9e961ac3b",
      "translation": "哦，原来露小姐就是雷属性连环术师。之前没看出来，真不好意思。呵呵呵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:51b94357a44dc0c3b12d75194b0a2d422aad0e3d0003cc9b170eea26b594548b",
      "source_sha256": "f4d2c8496396ac74525c15fc4e2ca9abcb9c432a61815fee09f9ef86656c2603",
      "translation": "我这边做成的5个，也全都给你们吧。"
    },
    {
      "id": "coalesced:a6d5726dc1f110b8a9901db3fbd40920d11b7f5792acd31fa39c8dcdcbbf19d4",
      "source_sha256": "e6a3675a25e011cff208490632f7788c81dd3235bc8d477af5149807b8fccb0e",
      "translation": "雷电炸弹要小心使用啊。"
    },
    {
      "id": "coalesced:fae58643523983abd4c156e9ef9b24c05e83b856f4601f46b3bc35a850ff4eb7",
      "source_sha256": "056aa76b2c9fad91b06733f50b611f86ca8b7557e5e8d7b0b017dfd803cd3532",
      "translation": "必须向未完成的炸弹中填入2个雷之KAN，\\n制成[雷电炸弹]。\\n在有雷之KAN的地方，通过场地行动\\n使用未完成的炸弹即可"
    },
    {
      "id": "coalesced:3febd3c034728f50fe123ee93943cec4ad2039c53d6132db53df873b815c9db4",
      "source_sha256": "268c28a2ac8a923a4b2f50402da315cd9431a6e42e40a1736ae765986ca1cb3e",
      "translation": "雷电炸弹"
    },
    {
      "id": "coalesced:c287e93b2f89e5a88e46cebee24a73be64244a6cb8ab7674fdf72936c4768641",
      "source_sha256": "47b2d328f371bbfe26debb78f671b4681a83e6a9e44ce92d215a8454d17b3a30",
      "translation": "QUEST%s : 尝试制作雷电炸弹 (%s / %s)"
    },
    {
      "id": "coalesced:83d63bedfcddb4536e54ff98a0c7310c17d8fd670fd6a2317ec8606e3ff0e53c",
      "source_sha256": "cf3dc154f613a42a5d0fcf0edf518d4401905e71398df8fc3fa97693b83866f7",
      "translation": "尝试制作雷电炸弹"
    },
    {
      "id": "coalesced:4e3cbbffb67c1800096647adadb424444ad53d06b6584e937a6d5f5201e3a6c9",
      "source_sha256": "9901bebd47f06cadb190a9c49e5971c40148190b82dd4b50611f99fe7f4319d3",
      "translation": "欢迎光临。欢迎来到兰兹海姆最大的商业城市，阿巴泽特。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e4f75c55c4ed2207d60396b736cb0a7a18c94ca08e40904d2eff0dcfa8a9046",
      "source_sha256": "234b7264ac7bd5fbb878a214baee75f16cc6fc4bfcfcbe3568496e04e2c9d5d6",
      "translation": "南部军接连获胜，最近阿巴泽特也兴旺起来了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e8013b9c7eaba8a26c70f0fcfaf000a7a9068d767442d9e218792df17b4c7016",
      "source_sha256": "04eddd2526547710230f224be1fff31b8965c8e97f74964095c68cc5a3a7902f",
      "translation": "我也该忘记了吧。忘记死去丈夫的事……当然，我还是很憎恨拉提族。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8caf6fe7d4255e6c16801599c051eb87634f87727ab94ff6c6a4a418611a3a0c",
      "source_sha256": "788f644c2e1dd91199a4be8029e9d7fcc85e803819fe3ec1038690c36740ce7c",
      "translation": "不过，活着的人，总得继续活下去……"
    },
    {
      "id": "coalesced:c3b18ffc0d5a67e966516ae789bdb0c949e28383e5e068fe6f352ebddbbd155a",
      "source_sha256": "d66bc710090dd3eb6b5b087f4eadcd75b4d34a012f54449f12e15d0fcc8cb382",
      "translation": "如果灾祸种一直这样降下，兰兹海姆会变成什么样？这是最近学者们关注的问题。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6b6de666280c2fd09494a74d8e1e0e5ad4540afb9b92b3105fb430c092912b6d",
      "source_sha256": "d0bf0aacf111bc82ba823a3375ac0917af17fa1a83048755837ba8e2e67afa39",
      "translation": "你知道吗？一千年前，也曾降下过灾祸种。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:749dd3c64823ce597e069d7d38892f01aad6b9deca6e184bd265091a6dee9755",
      "source_sha256": "f7223700764db34b0f7f359bf0d23e8db384606adfa7476049601a2a01835745",
      "translation": "当时，多亏了斯特拉斯的牺牲，世界再次充满KAN，灾祸种也随之停止。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:164b461ab104ac3241dbdeb27ee136ebb42f93e54fb35dfbc143e749aba10742",
      "source_sha256": "447e654831a2c097adb2120aa2bc05c08797bf7866b040d50dc7a98602cae8ff",
      "translation": "若灾祸种持续降下，就会无法使用连环术，卡蒙德也会被夺走KAN，效力逐渐减弱。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2e34e6850901798fa239372dfb5b0b6e2fe8923ba9033db73b2ee224d0415a6b",
      "source_sha256": "5d2b493b93caf81bc1c159dbeacd0ffaf3baabf034fa1d88eb6edafded88a2c7",
      "translation": "要是灾祸种一直这样降下……世界究竟会变成什么样……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ab70ea3ffea96413e2ce1f0ab05d43fb19e8863101545f896f6c2448e436f414",
      "source_sha256": "f153c6f07db1972144b32d163858c226e7f668595358a0bdaf8f955e79e7b134",
      "translation": "而且，如今大家都觉得，只要种下种子，作物很快就会长大，是理所当然的事……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0dfe851258242aa00204eb1804b30f544b23857f6786afb66c600eeda8d263ed",
      "source_sha256": "b1e0fd6e83d508fecb8a98bb771def5f9fb719879a8f5f76341427776c703830",
      "translation": "可事实上，这都是因为斯特拉斯的牺牲，让这个世界充满了KAN。 ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fc7fd02eefc18156df1c0f22b888c062cdf0e0ec71fad1a8dd66c7fb861210ef",
      "source_sha256": "ad3f4c12233ecf8fe50149c372cc39a21b22432db2ec4e06149eedafff96eb8f",
      "translation": "灾祸种之所以会降下，我想，也许就是因为那些KAN被消耗殆尽了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:96b03643b68ab3e7f07da44b0797902c0b4c5abacb1f98d9805b070f8604f3c7",
      "source_sha256": "3e9438ed3c873a2d42524d1c287668bb73b09d08d56872d871742bae1cf040dd",
      "translation": "我已经放弃走港口了。不过，南部军打了胜仗，陆路倒是通了！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:53ab4ca630c804310c82d6c0a822aec725636a404fe9d86cc0df55f29b3420af",
      "source_sha256": "9a9bee42b65a2d09bd9971bcc6a2723d78a04e6d0a1360ae005ac165ea4050b7",
      "translation": "虽然暂时还去不了贝尔福特，有点可惜，但也该重新开始做生意了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7756cb4e5712a70e3821860de8bfd19ce233fe75195d8a3d75a6e8d09baf73a2",
      "source_sha256": "8e4662120f879ec6b7b6b62a68aabd3fcc864728bfb7abd173f2b54de2ad4fcd",
      "translation": "来看看商品吧～嘻嘻哟～"
    },
    {
      "id": "coalesced:58fb9b7beb85a4d28aae6d6bf8fbceea757fc50d78aaacf77bf20ffd20b61238",
      "source_sha256": "47abdc006d9d2bc63783d4ba05c13be2b5c8fbe5b91ba10bdb791d6e187656ae",
      "translation": "胜利终于近在眼前了。北部军那帮家伙，该做好觉悟了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:381a30e2aab800128c5c955f8d959dcca3eb00e0d7a86fe6e7de0487a1d02424",
      "source_sha256": "e11160e15d59ecb4c2fe79aa929b038d07d8075dd23ca42ba954e3042c8e9f8a",
      "translation": "如今士气高涨，感觉不管在哪里打，都不会输。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1d8321dc81fd29fb4875f10ee84367b10c5e8b3a41fcc945afca26d93795bf01",
      "source_sha256": "717d453cc2dd8ddafaec658106444f0577ee477c87882a481ac24b45c0c2100a",
      "translation": "听说过去也曾降下过灾祸种……说来神奇，战争一结束，灾祸种也就停了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6fd8ebb229233639b48aef83aa1808b4ad2bf295fad19807bdb4a4cffa0fbe72",
      "source_sha256": "0c107a7ad008aee04f88ade80ee8d18c9a625a483ece6612b06634de9c2d8d59",
      "translation": "这次也会发生那样的奇迹吗？"
    },
    {
      "id": "coalesced:3f71ef8e2bfe010ce2b822c3897cc1e684a1bcd62346065132340ac02582e232",
      "source_sha256": "73533f1ff46f589aa2a1b3b428338145368e3c7a967e6c615895434e3b61a1d0",
      "translation": "这是出征鲁哈尔特之前的最后一杯酒了！"
    },
    {
      "id": "coalesced:274286c128cdad20203857ca058d675266acc2d0c06f10ed86431f7c24e8a736",
      "source_sha256": "dafd51aa247f38f8e8ca4fa3c4bc9d8387c5cbb3e6dc8b410ab5a807f67a3313",
      "translation": "法伊尔瓦因"
    },
    {
      "id": "coalesced:5db82d47783ae27168627b7691fd151b0f0b49fe12f5c455f7affdd8a2daee72",
      "source_sha256": "6c59e8c3713ccd9ed974e332fd23e3e7f819f732170fb21368c55f623623a429",
      "translation": "鲁哈尔特盆地"
    },
    {
      "id": "coalesced:bf335f3bc36c04f58f0f2932be693ccfe05d30a514513b8309456ea3bf1d5c9b",
      "source_sha256": "6c59e8c3713ccd9ed974e332fd23e3e7f819f732170fb21368c55f623623a429",
      "translation": "鲁哈尔特盆地"
    },
    {
      "id": "coalesced:70efca96138cba671d36ef14fdb57d1c985cbe2578d71cc7bfb066eb7dd2e5bf",
      "source_sha256": "268c28a2ac8a923a4b2f50402da315cd9431a6e42e40a1736ae765986ca1cb3e",
      "translation": "雷电炸弹"
    },
    {
      "id": "coalesced:87a725c9a8fa2d3e2bef72c8a33e66289fc2794f42fac62ce739e3bf9b08756f",
      "source_sha256": "21a7198ada98e92590ce975655150b1775c1e712276dc678b79531e740aa201d",
      "translation": "用于清除KAN地雷的炸弹"
    },
    {
      "id": "coalesced:afb6bfa35993155e5746c43a297b7162797fee90330f33340972c59746a8e1f8",
      "source_sha256": "b0eac5af27687c9176baf93480b3d10d3122b67a516831f221df47cdd1c5bcda",
      "translation": "未完成的雷电炸弹 "
    },
    {
      "id": "coalesced:74a2137dd45db0df55a70f371f087001eb677e325c3ecb93242939ffabf39031",
      "source_sha256": "cd30c42f79576a03d5ce46fe64f3a5ae45847cbbe65b8b53bbf808cc9f3627a1",
      "translation": "填入雷之KAN后即可完成雷电炸弹"
    }
  ]
}
