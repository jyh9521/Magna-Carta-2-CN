{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:549e87899069f408966516a1c03fc0095945eb7ef60b7dedcc1651661bba3d17",
      "source_sha256": "a765229266a408c1a697e1a0a26bcd14d04a82db631e087eeec2a7d024f487bc",
      "translation": "要去夺回风息岛……？"
    },
    {
      "id": "coalesced:666406e7da4a97d48ec6553ef234707f7e51296c2796e1cebfa135f3a20dbb24",
      "source_sha256": "c15645ee17f77b7f90b713465bf926bde623520a86d2ef95c6c198ea8ce49c03",
      "translation": "没错，现在正是好时机。看来岛上的北部军只剩少量残兵了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:edd6235b2bf63b6b41a246ffbf5b6c37aff93f7b52d67b351abbfb27169da2d2",
      "source_sha256": "c04dac54ef82cd3a1e06bd9f22b2e9aa4b9dc2b4dda231719832bda43cc24a74",
      "translation": "可我们还要准备鲁哈尔特战役，没关系吗？"
    },
    {
      "id": "coalesced:b131566c18d939e235e24a031a96993f1a0812e780382362c1c0e4c86406e7ac",
      "source_sha256": "d08e1a83625c26355c23925ec9de1802b83f157b67b5482ee29006cb63fc8ae6",
      "translation": "所以，我们不能在岛上停留太久。"
    },
    {
      "id": "coalesced:d600ae587d34372fb9fc5dd6c250a5e2f4fbbec96a2c454aa3bbfaae705e6bd1",
      "source_sha256": "1f11e7da7e23cb1ebff2900ba91793d8503845dea650617e2a24a9439868f4b4",
      "translation": "岛上的北部军现在似乎正守着森林和海岸，时刻警戒外来者入侵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0552c48eb497eab97f93abcd903321f28cf3a992dcbcd7c69c4d46d35094a8f2",
      "source_sha256": "c5d353a24e7b86d4f59da3d55d588dbc04d9918d67ab7646e46982d06059af58",
      "translation": "因此，我们要对付的就是这两个地方的北部军。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31e08e261d48d51123999f07a943b112cc676948d9317c4eb6878e5d1c78827d",
      "source_sha256": "e2041953b5545b9846c2d58c257fb02338569656e8282504d36f3d09022f388c",
      "translation": "青灵森林里的北部军，就交给露、塞蕾丝汀和朱特。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4def2b3fafba0e1125f035125f9490aedc008de85b9f2eee652f18276d5d062",
      "source_sha256": "de1c1c4430e5f6d0352407cb4d910180051ca00378d95563d327aaa2b4663e9e",
      "translation": "我、阿尔戈和克罗塞尔负责海岸，摧毁那里的死亡弩炮。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bb3cfb351b0966cc50c44acdb1d8b6bda40183b5d106f461ba12a779e3d3f7eb",
      "source_sha256": "a41b0d61732fb47404cb9f683a6e3075ff0bfcd45fe135a6dc80aaf441159417",
      "translation": "这次战斗虽然规模不大，但北部军可能会召唤哨兵，我们必须速战速决。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d547f4a52096a9f514428b0c7b1b0f151b20ac66253778ce4e74b626f1f13ba5",
      "source_sha256": "31ed163142377e5da9a129edb7c078710db5f96062f71485607a1f8aa0b9d91b",
      "translation": "明白了。"
    },
    {
      "id": "coalesced:175343e3be054b7cca38e95d219f1bcd52f657408070f3849c183905842d6d4c",
      "source_sha256": "88c26930149214545758670da6c7b7fdae96bbb2700c7d4fb10aa85eab128f4f",
      "translation": "谢谢您，公主殿下。谢谢您遵守约定……去夺回风息岛。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f8c4f82f90537804a4ba31fed9cd389b1c047dcf1295549de65ef6552ba7834",
      "source_sha256": "18ae19862b93e230b23d7007406fc81fc83c37b6872e36d8e4a139f448f03e06",
      "translation": "不用谢我。我本来就打算对岛屿负责。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:48289e26454e84d8a77872356b7f8ab9b9d427d334bf58dc3cc9b844ec22d07c",
      "source_sha256": "0e520909e82ed024727edc6cc29ed10a5ebf39797a08e20e2c615736cfa46701",
      "translation": "啊？……是。"
    },
    {
      "id": "coalesced:f4fd59b861b65e55a260a95ce92245996d57fe12a0e05d2eac6fe8a8bc2a4073",
      "source_sha256": "02e6d96cba59ade12365c05488081ded0ee320ff790f28073903ca04f3ff4ccf",
      "translation": "那么，大家抓紧准备吧。"
    },
    {
      "id": "coalesced:88dadf1e88036f7daf262e830f6b3052e8c76cf8bc08d7c4fd71ae8876b6d3d4",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:da63c65e98abdb27f2d73baa425507ee15baf18b79044f41fc2579c1b7394829",
      "source_sha256": "6f2ac6301f0bdaa5744e2bd7549d3a64b1a80220cebd52a8067f8ce10390c54b",
      "translation": "不能和阿尔戈哥哥一组，真是太可惜了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3d7b3862d5639120a397a74a6356b3c372a77de2fdaecd95bed58a8777b91074",
      "source_sha256": "3095d56f6ded9dd147623023e741bf3bb14d1213b0ee3d73f864108a6f291c5f",
      "translation": "阿尔戈，差点就大事不妙了，对吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4edd45f2d400d85a9e7542946f53cc7141ef593f2f9672e80a11ba7082adbfe8",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:569ae06b42df20b8a881202602073a56fad4998d5f132bc1dc7cc767de4f160f",
      "source_sha256": "405fc857a5fde3ade0685784e6aa2448a08bf49074b11016753c62410a8a633d",
      "translation": "那就准备好后，前往阿巴泽特港口吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:07cfa200e9f3af4795b4c0b8fdf0b95bb1a3e93f32c785041cd94370213b7d68",
      "source_sha256": "d0226cf992c190405416d241950dd4101e753298d31ed97d94e2ae93a8fa1f81",
      "translation": "去风息岛之前，我最后再说明一次。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7445ef04f452a1687ace4b76ce3610f958156d6df0ac77fd556c5d88cfa03c55",
      "source_sha256": "a375cc9af9207ded2f6026ab4a4c5c3a32ce708fee74ff8f3284973064898bc8",
      "translation": "朱特、露和塞蕾丝汀一组，我、阿尔戈和克罗塞尔一组。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d8e40c0f90b1e9463273dec97785ab942bdfdf7b73e1fad9ec4c5fc03515c5f",
      "source_sha256": "3079b6dde517b0c37789154cda4acc3a2a6f880cfb272c67ca32a7829fa218dc",
      "translation": "留在风息岛上的北部军士兵，大部分应该都部署在青灵森林一带。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fdb35a8f54665f609e6df07cfe8c001cf19425a3af2eeafb3ca6182a8b307d22",
      "source_sha256": "27aad4ebad04808e6eb63e4bcc60a0c7726f9fc0de9f2b3ef9cbdbaddbdb27da",
      "translation": "所以，由露和朱特对付他们，塞蕾丝汀在后方支援。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:154d724eb7332ded900e57e0ad536ddc91b1a462e86da33c27c8f30f5e15c0f2",
      "source_sha256": "1d930986b045ecd97d57bcac82d6b6c41af74c0f2eea178a225b51766ffbf632",
      "translation": "嗯，知道了！"
    },
    {
      "id": "coalesced:17ec50821354aa1c17b99d95436ca43670bdba1c325e736ca7fa12038d45d85c",
      "source_sha256": "5b50b36e283cd186a8f49e5aa53abdd6ffbcf8106e4eb00e522508b28465e934",
      "translation": "海岸那边，就由阿尔戈、克罗塞尔和我一起去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e323427549816c6319a675be14672473caccc872559e8fcb28977f8f1e36d3de",
      "source_sha256": "2577691b64ef1162e33c813cefd041f661678fcfb29bcc7da9f56736e002b39c",
      "translation": "有传闻说，攻城兵器死亡弩炮比以前更强了。大家要小心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f42414df1ff6b2778e2a21592f523724021353d3dfed4e4f52affd2a3b6e043c",
      "source_sha256": "d0ca3ae1f3df762d7077a3090b942d54fcc03525b8d4a5e66563474d51c4c70f",
      "translation": "究竟是哪里、如何强化了，看来得亲自去看看才知道。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:75684571549f9604d75db56f88392eeb7f4fabd86213982141ed51bd205c12dd",
      "source_sha256": "1544aa4b37eb8a3dc8ef83a3c72c7d7c8dc1aa95aaf74ad9d91680ea8c632a4f",
      "translation": "接下来，我们就分头行动吧。"
    },
    {
      "id": "coalesced:55af967d756acf528dff84954b621bc59fbe330031b8652f000f77f64eaf15f3",
      "source_sha256": "492040f8ef7095ba25e73ccbc678af0624acabe47ddc1bd1e8065a8ae0b39194",
      "translation": "啊……公主殿下，请多加小心。"
    },
    {
      "id": "coalesced:6489b0afea8ed96de8d218015cf1bd092f1a652ffcbac3574d1d9e45e3cddd2c",
      "source_sha256": "39fdcc04e8253080007329f785a232e51d000dad94879b16dbab49be6a28964d",
      "translation": "我们……在风息岛再见吧。"
    },
    {
      "id": "coalesced:083bac9f9d9bbf25b2dd33ac871f4c8c9805067409c736cf586d44920699b4b2",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b17ecea19de88685963cc0db44f3da055d48c1af9dd9a7c5742e255b32795430",
      "source_sha256": "ab482cf2661ee4a32691d5e92cd34fbd5123d646b4dd77f724b52ddf81038f13",
      "translation": "那个……听说你和公主很熟。"
    },
    {
      "id": "coalesced:fc4b368b459304a49285a7c9e1aa1ec76c3de2b65703f4eb481a658ceb9db880",
      "source_sha256": "19b1dd529a8ddd6b7ae63887ab96f7029417fc76f5bf150858811671bf381ad4",
      "translation": "有什么事吗？"
    },
    {
      "id": "coalesced:5560214c032ee8c13d867a9630b148b4edbbe0aefeff307c3dc350e6fa358b38",
      "source_sha256": "ba1bee175c62da1daf30b8e4918ea1e266fb5c46c162725dbb30d0a1fc0d2885",
      "translation": "公主是不是出了什么事？总觉得她心情不太好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:718c7a4fea9e5750e82db989cd2cdd3bc155d5886d59d064a98ca149718e8f44",
      "source_sha256": "407e486eed5da8a0e43af4f0dc28755cfa576cc25659bb8bfd382e870730bd48",
      "translation": "这个嘛……您何不直接问公主殿下？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:28e30703a6645c9fec29bbb833125324af7da9e49b830148581a364b25e07ad2",
      "source_sha256": "89e6ed49d602005ee9a7fa2d30fb36438fcd32172be0708af20aa97e18d562a6",
      "translation": "就是……有点不好开口问啊……"
    },
    {
      "id": "coalesced:a71796cfae0458a5baa782b9efabe1ea99f483e535c76a9b8bc0aa4f9cc894de",
      "source_sha256": "e2218cadc817ba7dfbc05f04b7aee742d8daca1dc754cbb8de26288c2dadaef4",
      "translation": "我也不知道。公主殿下的心情如何，不是我该随意谈论的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:47181d1b786a06d10d9b019defe9289b9805a189bfff9f90eb8b237493e8d3cd",
      "source_sha256": "f1ab25622a7a30563a33aeb41d63e9de739b6d15c16a2da431cbf29c34870b1d",
      "translation": "况且……身为男人，何不堂堂正正地亲自询问？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7fff2d12b69a638d329cae5615f80effd6493fb10620320726dc63e8f9f8acae",
      "source_sha256": "a51eba9022ae87366166d6724370e11982469e47a6c29f00c823ce90c723ee82",
      "translation": "这样在背后偷偷打听，可不怎么好看。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f47ae9acd8a25906350ed144ac918a7e0b12ad23f246b94ee477d5d1cf836a6",
      "source_sha256": "628c8681cc89aa97db1df1d4f3163b70c0b87cdaf3ee90dc24087395ac2bae6e",
      "translation": "知、知道了，知道了。别再念叨了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34d540e069c94b5e02bdb23f57b5b2ae738a80a82fb966aecc5e888001e4b31b",
      "source_sha256": "acf022b7457deec97b79a87b2ae570465bb3831d2fdbc2f2b722c4caf4ae5c46",
      "translation": "那就请您从一开始便注意言行，省得听我说这些。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:27a238b7536a39018a99079fbbe4e3253d1e7229a4a98c368d6c36f141a906ff",
      "source_sha256": "9204e3b9430734a0714e66644856b7c7a8386ca751aa5e0664f82aa3312aa5c0",
      "translation": "啊，我都说知道了，真是的……"
    },
    {
      "id": "coalesced:88d64d756855c2ebf5043b51c950aacb33860e7df856c4abcbf8921b827ec966",
      "source_sha256": "b7706e3d2c4f1ff126ba373b2ab5245bccbc07750ccfc9d6d0dd2cf32d91b9b7",
      "translation": "哇，露姐姐果然好帅气。说话多么干脆利落。我也希望有一天能变成那样。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9a0243b679d2f424c5d27b5f10c469b23475c63e2d263e33061ff36fc81c5f99",
      "source_sha256": "8264dce92cc4a1d30fd9a2c05380d8a2c7d9e6c5a682f7a95759c336f5004eeb",
      "translation": "唉……那也叫帅气？"
    },
    {
      "id": "coalesced:c1d296f17492b0d7251a97e9017487a129abbe0bf1778cf126ed306c630a6533",
      "source_sha256": "54aa51c98b6cee86deec288140ad3a5197dbddb88f9448c4ee288bc1eca031c6",
      "translation": "闲聊到此为止。别忘了，我们正在执行作战任务。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a5ba220921d4416bb309126ce1f4be0415d009ad4625efc6336a22f504c92a61",
      "source_sha256": "4a7011bc7297dfc6432026b6587478fc8ef4aa9a120d80c2b746c20a2b995556",
      "translation": "岛上剩余的北部军中，必须警惕的是杰巴萨。只要打倒杰巴萨，其余北部军就会逃跑。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8da15fbd2705e0f58be1228054b0f18e79a8c21880a9e0d1092604df1a76c569",
      "source_sha256": "b507b1b23f4205f56f6d7a97cbfde9d613bfe5aa1e460b5da51ec6d0570d5a74",
      "translation": "所以，我们必须集中精力对付杰巴萨。"
    },
    {
      "id": "coalesced:386b116d0beca01fe60b7f22d454b2de1837bc17e861dd3ac79410b71ef1dcde",
      "source_sha256": "ce5ff408cb9bbe8aa913e7b4f9baf1d61959382801365382e698c689d46ae79f",
      "translation": "呼……总算结束了。"
    },
    {
      "id": "coalesced:5db5dd9bfec91f4cb6cfd47962927254836aab8f532ba6c86df1ee375fb3bf5a",
      "source_sha256": "88407cca975c1d7c267eaaab5bb3898c80cae8df7301722da8bd572d9b32c077",
      "translation": "姐姐她们没事吧……？"
    },
    {
      "id": "coalesced:3bcd371e8de167feb4a19ae0958fdeb13525e033b4681d6155df4d5f17bf2976",
      "source_sha256": "41acc5da53bb781a0e8c5c3d2607289d619409289ac25c115ebda37d4a7c187a",
      "translation": "应该没事的。先稍微休息一下吧。"
    },
    {
      "id": "coalesced:3a4d09d15de12b3f6e862609e24448d0f88dd772a6c55b142add3ad91d2cbde3",
      "source_sha256": "606e1ffc63adc0b251c1f08c5a52cea35ec957d9f6debed3a47686427898989a",
      "translation": "据情报，死亡弩炮共有4台。而且每1台死亡弩炮周围，都有多名北部军士兵聚集守卫。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ff48e1b9f4caada6a8083be079dd167cda24d8921099440bad3934a6abcb4c0",
      "source_sha256": "cda5e6c5e765b664d4c231faabf5b7abaf6e485f258ea665afca862a7c5ce954",
      "translation": "要完全占领海岸，就必须摧毁所有死亡弩炮。我们出发吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c251ae44c3972ed7984150df8a35df317bd5b74a4d66e03133c969bfc9b4ff85",
      "source_sha256": "fdfe7e6071a4dea7ba41dbe48ad5c543599739d70477bf2525fbb6f3144c6b85",
      "translation": "和往常一样，别忘了，我们部队的目标就是谁也不准死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0bab8fcbaa0f74c0cbedc35f8710848627f541072f7e0a58ea22762c4265023",
      "source_sha256": "0c0479559c02bdc01577aaa05851d11c8fa23e0f515367100631c6802bde51fc",
      "translation": "那当然！那么，今天也大闹一场吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c21325ce9213d46076def2fc44060e8ed83751d74e2435d449654764fa840ce",
      "source_sha256": "99f6afbc13042ba809e922b2569d055bb9e7f8cec2550877d3155b076cf3c72d",
      "translation": "多亏了反哨兵部队，北部军的攻城兵器已经被彻底摧毁。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c0389d834d467a730a3781f24ed84a0e62253187c7bd3d536e371c8f14ee0c43",
      "source_sha256": "3b4afda172d176ed0aedbcdeadaec6d1f92c0db4d640812bcfddd43f555f5e23",
      "translation": "剩下的北部军由我们来处理，请公主殿下放心前往村庄。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:31dd6482341e2576badfc4f5563bd52a8f5546efa73c62cb9d7e8469be33363f",
      "source_sha256": "baf228ecb1713361c8990538d63dd1938cc0f60dc2b79957aa44831324cb7c62",
      "translation": "谢谢，接下来就拜托你们了。"
    },
    {
      "id": "coalesced:19347498abcc14cfbaafb4fd9a8a2450afaf1d323d313b5032c5de3a1bc9012f",
      "source_sha256": "d06c0c35b409385473871bdf38a9687cb56f9a66dc56c81de8166fbfbe83e16b",
      "translation": "那我们去村庄吧。"
    },
    {
      "id": "coalesced:2ab846c9c337d2f5183dafc2ee159d750a6f6703db24b72d82696015748eeae0",
      "source_sha256": "51378702c22c9eaec4296a57dae542cc33b6bea43a9cc311bc58b846205c37c7",
      "translation": "公主殿下。"
    },
    {
      "id": "coalesced:6eb3c434645359041b2d8a37dd252a25f07baf2deebe06434d56545dc0cb7dcc",
      "source_sha256": "bf44a392cf6090c788f163ad460a3890bfa012caae2888c8f75caf65579f2edb",
      "translation": "露，大家都平安无事啊。"
    },
    {
      "id": "coalesced:5c80d83753defe1dd26f93f6472113834c609cd755cd8c8bd4239b77c4d9c892",
      "source_sha256": "1b8a49fe29a42c2f07fe9711d8cc5dbf20481b89d01586b0f8d7d62da933b818",
      "translation": "是的，作战成功了。"
    },
    {
      "id": "coalesced:5a59b3f248482333046c0764c38a5ec1eb9bfba52f048faf7811edbeea845738",
      "source_sha256": "011b9068a4c9e79584304570341bc58dfd850124778b1130d787f9ac533982d9",
      "translation": "小子，恭喜你回到故乡了。"
    },
    {
      "id": "coalesced:8daa229c4722c20f966097b1d370eff854200d9d513cfe6a881bd904debde32e",
      "source_sha256": "ce482b7267646d8486e001e974282d66f2dc9e68557a038029bc4ba1afa1f06e",
      "translation": "嗯……真的谢谢大家。"
    },
    {
      "id": "coalesced:da1a4a9b2232300e009715f2ab83cdf20338afba498fce5e05d4fc0cd205e0bc",
      "source_sha256": "0ac5c09dc397be708b8a0f9b9c5ad97757bee7c12270941ac666c569072f560b",
      "translation": "太好了，朱特哥哥。"
    },
    {
      "id": "coalesced:b08f9e54b48fd85273463c938ccbc07750aa914f38447fd78cbe2b8df804d0ae",
      "source_sha256": "1a30f7a15e811054fc09fe4079371c5c183cd1069e049b5e65898b345d5c715d",
      "translation": "终于夺回岛屿了。"
    },
    {
      "id": "coalesced:e3a3c1c654037c7b7964531bdd9b222dc6c7f4ad85213b0b237f3b998ca0b8c9",
      "source_sha256": "87592dae9bf6e2d533c79591b4d5080e47254387ca0d4dc8cfe64baa34878232",
      "translation": "是啊……终于……"
    },
    {
      "id": "coalesced:b9ac46544a1b095803871ce67fde7a5e654035191ee83510fcea88a0e9d2ee63",
      "source_sha256": "3e066de49690fe1cd551df44cd437a8def74fe0be8ff64904c52c6b2cc30d60c",
      "translation": "我们去村庄吧。"
    },
    {
      "id": "coalesced:54f8cf25fccecd673815a04a3563175e150c1a4d0d128ef4afd0698b386e5a7c",
      "source_sha256": "b96484a147decc5de4bdeb26a65dfe3fffb50acd468bcbb15c3c998d0ac69a24",
      "translation": "公主殿下……"
    },
    {
      "id": "coalesced:07fa4632014de9622d62d55d412de03c707006e82d74ef665204b605e365362c",
      "source_sha256": "b3b34a9f80c99925a671e7703189015c81035ced7dd3d4d4291321d624834895",
      "translation": "好久不见。实在抱歉，这么晚才来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d187be23b75fcb246fff2765a1f654a1c64517a444688ebe22ff80bf0d42777",
      "source_sha256": "69f4ca363c95b3df4c38d77d69c5fadb302d3989bb63fa7677b086de4b9c0b1d",
      "translation": "爷爷！"
    },
    {
      "id": "coalesced:5f52c083b9904dd8f202440a6202f131cbce8c83300b62e5271e2584a468cc9b",
      "source_sha256": "dcbbd9e48d286bf0f705627772f76ca86384d841c80d52573cbb9927d788c118",
      "translation": "朱特……你还活着啊！"
    },
    {
      "id": "coalesced:734b2c1df5a6048604cd2733d61b80255e58b9438561d54439601d74c19b2f2c",
      "source_sha256": "8445741d7d6a831276e8794b874cebee94940ba0e963d4f109bf72f437426789",
      "translation": "是的。"
    },
    {
      "id": "coalesced:1a0572c2bf6f2c959fe75fa677b18ecc8f3e95dcc28b5686a85dcd28baa32b53",
      "source_sha256": "bb32c0413d29fc4a73c15095503506f14749cd1e8f6ebf18efe73f13defc224c",
      "translation": "能这样再次见到你，真是太好了。"
    },
    {
      "id": "coalesced:f0524fcfd8c51c8a388c909855777ecd59e15ca18fa3a64a9687b7545aba5b6a",
      "source_sha256": "9e07cf9e6b06c26ae14dadcf68b071f5619236f6599d08b226ec1dfe946e84d3",
      "translation": "这段时间，您过得怎么样？一定很辛苦吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9ee47ba7ce65e4fc350f76ecade9519b8bac3c81588bcf6e61fcb4ed58b49237",
      "source_sha256": "5a0e7d03d0726dd5293623d509a44841da14fe97a787a6c9fd3962fd0d65fad6",
      "translation": "因为北部军，我就没过上一天安心日子。"
    },
    {
      "id": "coalesced:2c655e0017be194178e0019cd4fc57733831d20962489843ea2ba469a7643adf",
      "source_sha256": "dda9b5d0eeb3962eee54d6f146647804ebadb8b2f427a8e529d5308503ed8a16",
      "translation": "不过，他们前些日子都撤退了，村庄也清静了不少。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1b960d0a635deb0a67b81ae187059e843960168891773d96ea2ed5463aa196b2",
      "source_sha256": "77570f6d714dbc843972b7ca2b3bf95a68768c66f57d72efb3e5bc4014d12a25",
      "translation": "那就好。"
    },
    {
      "id": "coalesced:af4f9b123dcc9bbb7489658e451689c487c78f18a481833b7f595c741f397c6e",
      "source_sha256": "1d52b05e0cd5272380d3c34a0082da21365c92b9b93d36a9d6185de99af893a8",
      "translation": "总之，非常感谢您拯救了岛屿，公主殿下。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5bbb61e70e3043ca9102153724c28ba594e54b3cc35f436b22a530fe0d4bc49",
      "source_sha256": "21534da578570cb5116e7c0221f4410b6c89fca7e2dd517ca381695b812f824e",
      "translation": "不必客气。这段时间，各位对南部军一定很失望，希望这次的事能让大家消消气。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:dc1b07abec03612ff03bb8279c1cfb831c1744c3eebf3272bc62179655c81d73",
      "source_sha256": "49944e8714122c3e4ea9d634d40a2ff9f9b6e93c5630fc0d070393b504064261",
      "translation": "事情已经过去了，村民们过些日子也都会理解的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:63a84e6ea5f0635dfd551756f005bb502a44cf535feaf965aae209bb2c5a007f",
      "source_sha256": "c25d1070371a22897d0a0ce387f06756d792943b807dfbd3351a5754f900b198",
      "translation": "对了，朱特，你知道梅莉莎怎么样了吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a5073c770a03fc94c9c497cb69c767d09dd657950870df35402c992cb038dbf7",
      "source_sha256": "43455dda899878e7bdc9a6486ea5847a9ffcfd8de4880bbb1ac40d40974f5169",
      "translation": "啊……？"
    },
    {
      "id": "coalesced:2c2da98e991751e87db49c5a582e8d9f5df8a204aa31656c5c66440e5ddbf7ed",
      "source_sha256": "298050db2b255fcba2e93514dbe216c0d2e72b10f8a310226e6964fb89f59c36",
      "translation": "那孩子在战乱中也失去了音讯。不知道她现在在哪里、在做什么。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4024b8aea15f7201010cbf133d2f78241fe3d5dba83f22433186f4edcd4330b5",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:b5de910f1c18e2cf884e1c7fbe5ca26154ee2f3c76c393fb49978c73b26625bf",
      "source_sha256": "b76a5c4f5426eacaf7971e9af7720ecb01417dccd6ad41f7fa6238aa94e0d152",
      "translation": "那个，梅莉莎……在阿巴泽特。我们一起逃出来了，不过，她在战斗中受的伤，到现在都还没好……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bf323648436eced0865dd31da5d746601d300b4ac4b1549dc3b27491da4cef28",
      "source_sha256": "c4efa728aaa1988b86a13678bc926c8e060c0727a8828a43b6a600fe38de8264",
      "translation": "她还托我向爷爷问好。"
    },
    {
      "id": "coalesced:1a5e7545be789d0e74fc41dd4c1f7699435dfab355babdce5d895f7e06350ad9",
      "source_sha256": "b4f0d29bf7f4404f7a48b112362faece3ae254e6d6dc73209276b5cbcf01a1d7",
      "translation": "是吗？拉·斯特拉达开恩了啊。只要还活着就好。真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14cd91e1b03f036ea2741b6280e64266b3184cc888d584ae89fb324cc379fbd3",
      "source_sha256": "38ed9030b1c30ddaba12411e6b4dca07ef5d3b2bb2e17367419cfcead4d25411",
      "translation": "各位帮了这么大的忙，我代表村庄，由衷地感谢大家。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:345c4fa1e4ebf200ae84e0413b4db251b5cf9c5edbb108d70568e1957be0fb5d",
      "source_sha256": "4182c15342a66c1f965de1c7f0f652b67d62fdb862a9bed8b13ce9c934cfb74c",
      "translation": "大家都累了吧？好好休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ae64dc2b2c70e249d80b55d21e4b953091db654dfee3719e56fe11fdfed6ba4",
      "source_sha256": "ac4fc5c04bbe84e6b872b7c64f696ccf3aaea1cb4340751a6aa2d01acefc10ba",
      "translation": "那我先去和村民们打个招呼。"
    },
    {
      "id": "coalesced:9088d53eddb3f9d602ace5097a03562ae322e3e34bdcf882145656f5bd849ec2",
      "source_sha256": "cd291e7523cc90f2915016052236de1ea5ba3dbd9678edd989ff84d30a26190c",
      "translation": "好，好。大家都会很高兴的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98f40197aa0f295cec83ab308db4f7783cde637d053603e5c4a73c9df843f64f",
      "source_sha256": "8fb1609efbf03c19077961d143f6a2aeb06e2b71568667adfcc499819ac131e7",
      "translation": "虽然迟了些，岛屿能这样得到解放，我还是很高兴啊。"
    },
    {
      "id": "coalesced:b48f38ca4466a82bdc49e7ab008f93cf465231067bdaeb9a6173d60ffb1a63b1",
      "source_sha256": "30c712d66418fb62f4275a623a14c499867b06beb793a1461d4e3b87f644bc40",
      "translation": "如今已不在这里的人们……也会高兴的吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ee919d159a962b98a8b4fb0647c0cec1571954162e53ed93857ed8a0633a17eb",
      "source_sha256": "7ccaccf3d73b9ed24295ebbb4e276b8aec41c2c39a7d59e0de959ae798a5cf77",
      "translation": "北部军那帮家伙根本不是人！！"
    },
    {
      "id": "coalesced:92674ee3ecd47d2cd03d18e8f8f10cbfd48708cab5dd33ccebbc15d3d8d5cdfa",
      "source_sha256": "c325bb84086b43eb431037b66d4d9f6eff17c725e83e94c1ad8b76c43fd3bdb4",
      "translation": "他们全都是恶魔！！"
    },
    {
      "id": "coalesced:3d953d4b23a175df18dc7811ab4f94e6c250d5ca11a6096c687d631a0c43c2d0",
      "source_sha256": "0f6ed6615f5799d2d26d2138b47f12d6c48f7fdc0b0a08d336ad1c068bd66337",
      "translation": "真是太可怕了。有好几次，人们被带去了不知什么地方，再也没回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:435ec7e52a1ee804ae8cf8c0ef72472932499b6edd7e2f375930945e3f8476d6",
      "source_sha256": "9c7e4ee760f15533c8d4287b5d4412394f225afc4b9313347f6dfa042bec9333",
      "translation": "我一直害怕得发抖，心想下一个会不会就轮到我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2c584172d252a9bcec92f003955bb2104d48ecb55cc447c3134d22600981bdb2",
      "source_sha256": "d19982fe6d21ec21047fb7dbd086cd74244f98cb82785441178a6c3c80964cf6",
      "translation": "谢谢各位帮助解放了岛屿。"
    },
    {
      "id": "coalesced:a322b549da03bcd8dcaeee5188891d25f903cb64b7b5c0c7d66348d0b0565fa2",
      "source_sha256": "e2a675f95d7a7d6ff53cba8a68cad7b635ab502a6dc1adb535414ede0ffb6950",
      "translation": "北部军会不会又打过来啊？"
    },
    {
      "id": "coalesced:d0bc8be4a93527bde010870f2b519db39c5a6bd9d7947f677557da010ba35438",
      "source_sha256": "ed43b30f446fa6ea0aed9acb2f1d496374a7e0b6eb5e06521505e344e6c5f14b",
      "translation": "北部军都快撤光了，才在这时候出现邀功，算什么啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9839d5fb34f08e27839b174ed8ed2a780bc151f90a1d526086b9af5c883f7c35",
      "source_sha256": "acc004dcb18fc3453e1b20942a2f645dcf6f8c3267db9db5eb61ff1f6065b834",
      "translation": "就是因为打起这种毫无意义的战争，才害得我们这些人遭殃。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0d7064f8ca2c23fa87671ad938d02e468eb517d41c8cb0799ba013c839ce9e8a",
      "source_sha256": "8c0ab543767b2df34e7e5dd726aa0f82398cd7b14e02461129f6cc4e95297505",
      "translation": "艾尔加……真是个可怕的人。我们丝毫不敢违抗他……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e6e1680ff82a49dcfe69332873408f0cd3f2c8103436b5bf00e094085bf2918e",
      "source_sha256": "4084d4780d274e14f7307d686de5c2c367c9f3086a44a6e7f185759b61899424",
      "translation": "朱特！果然，你也还活着啊。"
    },
    {
      "id": "coalesced:43c713fe8b68ae04d518154955853307b565e6342c02fcc91edf8214315656c2",
      "source_sha256": "9be22c6afe4c3580b6213f01ee59fcc3c6db7acf3b687e7dd0a579a05574fdac",
      "translation": "你这小子像蟑螂一样命硬，我就知道你肯定没死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f67385ec9a978da12ed10e3e8465e59927570b020c193809709d5d34e0992335",
      "source_sha256": "fdfc7d472eeb63b3b986e74c6811c0e7c0615eb2619b05acabeaae649f121f0f",
      "translation": "我们的岛屿遭受了非常严重的损失。"
    },
    {
      "id": "coalesced:2b9eaed834ea86a0a55d4465bffdb0058dc4dded649abea77ccb5624943ce02b",
      "source_sha256": "ea42abdefaaca04da09482107fcc4bdcac582a3bd335364b9545f6bfed4676e4",
      "translation": "即便北部军走了，伤痛也不会就此消失。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:60517614c44fca58c6699185592618c6b06b8b7ce884ea1faa4f44017cdd67a6",
      "source_sha256": "6af8f8263ac3637168845e4b257b0601c5507b18bf534da16c9198b3a12a5cd5",
      "translation": "就算岛屿解放了……就算那样……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:14a8ae303855b6bcfe469dccd089a80967b1e27aa3dc4725725f583a4cd9f1ba",
      "source_sha256": "6e6fffbf35827391a380964867e95249053067e55ec4ceed91b6facc9e9f6fee",
      "translation": "死去的丈夫也不会活着回来。你却要我高兴？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bd872c6bf5a888de27189e7c05c8fa9468de1473df1f461b4eed2a22686bb451",
      "source_sha256": "69769dfa0e282c966792544bf0ecdab0374d92ddf18879ef073ef01b52508b39",
      "translation": "我代表守备队，向各位致谢。"
    },
    {
      "id": "coalesced:5388f29b35935e595a06603f5d900070f28a0e77d24a878719e4837b4f0bee2f",
      "source_sha256": "fbf544d4a1303c929549bb9b6a775ea0767d2a7b999568b7e9ea28f4d105b971",
      "translation": "严格来说，北部军入侵，并不是南部军的错。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34cdacaa442f929626fc1c06e045fdb2039c9552b20e389c7383111e845ef52a",
      "source_sha256": "ddd8437895058998989b0af7bb6372d416b04f1c1de117469be4204cbf836ffc",
      "translation": "人们现在虽有很多不满，但随着时间过去，慢慢会好起来的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:decf36cd8c77f9bbe2bc1d311241d6659346f29574b1ebb3dd4fc2bca860cae1",
      "source_sha256": "4291a86036b4ac16c4d7d8d5c54bcb783830ae2f3d81685f9fa911eb437119e0",
      "translation": "朱特哥哥！你平安无事啊。太好了～",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5ecd6d893999304365ece807c53af64924353ea5bb6a9127b9761d984a475246",
      "source_sha256": "c13bb5391e5dfbd04572de5e1d34b95741630b70be7387a96f86f1f16b66c1a3",
      "translation": "可是，梅莉莎姐姐呢？你们两个不是在一起吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1f8582dbba2a51c2a1ae25bf0f8ff160b0644eb95b7889560df54e49e3313663",
      "source_sha256": "1b09164f82a8f1a7c277169a892679c5298eaf571a6ce1dac8bd02bb685caba5",
      "translation": "随着时间过去，风息岛也会恢复往日的样子吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ecebcda844f95487d819aeb0b3508bab565cd48e401a321e011bf3f219da360f",
      "source_sha256": "73130c25a780e4e163aa8f66fbfcfe2dc49dc6acb2b6974efb1dc5eb8bd14e64",
      "translation": "我们不能忘记这次的经历，必须做好准备，不让这种事再次发生。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:383e7cd3eb6c6160c496c2f1a20209ae5b6106f4c0af243027c4c735dd73859f",
      "source_sha256": "39aa1008de1335ad3eed7651c20235fc7ac18a86c40545ea6e0b86322a8aba64",
      "translation": "当时，南部军要是稍微再占些上风，岛屿也不至于这样被夺走……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7a4312fd74c944fbdd6d5f86621baa2b722ad5d033546851dc18fe4a97837dd3",
      "source_sha256": "b8b5ccdf1bf8f260f6db8280408dc3e597404bbb75712ff847cc9875dc2408bd",
      "translation": "有些北部军似乎逃进森林或海岸了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:36d558958e8895a6011c70407c22d8a82e34d435d94144adb4e3c1ff99a9586c",
      "source_sha256": "8b7c4a34bf56078c820b06f73b10f6ab29c8693ab4ec9188ceb12c56be2ab815",
      "translation": "我也能加入南部军吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a4223639781650f6c083780316891c8343170ae285a0ec0152828b9fad08d5fd",
      "source_sha256": "19c9a4903c58e0e7184e8e719db700a4121792151ac0603ffd706c9fade50810",
      "translation": "我想向北部军那帮家伙报仇。"
    },
    {
      "id": "coalesced:a8037d7ec330ca83e71a7daad0eb2c1a866f92d3e6ce148229e3fc14a7c049e3",
      "source_sha256": "53ae65dc477df40be4a4de13d7db0a5799f36907a5ff6153cfe8502f246fce4b",
      "translation": "应该趁这个机会，把他们统统消灭掉……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8013ef3449d4cb2756dd7cdf2c88d283c6651694bc3ea1d2da7d9d9cd3d684cc",
      "source_sha256": "7aabe1252b9e1978bc17545ba554cbf0ef0bd2eae4098247ce030cdfa59f42cd",
      "translation": "呜……呜呜呜。"
    },
    {
      "id": "coalesced:1847b0f071012374885c29c9899161fca389823702fd40cd44c9920ef0d9bf52",
      "source_sha256": "b6bee7dd8a03e850a63baaa8402ec7a31ef013c70cc799dafb47cd58f885dd8c",
      "translation": "欢迎……我还在继续做生意。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d582af2279e42410dd67f223a7d9eac9bf2ae9c18954df6cf03d8db991a3646b",
      "source_sha256": "93aa99990f0b4a53e2980e3f9dc912e8f015de7c122637c804de8430c3edd006",
      "translation": "听说各位要来，我们已经占领了最近的晶柱。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:030cc3ba0fa04933c8f23c63feacf6352d61b3af6fa3b30bd9e78d40261322b7",
      "source_sha256": "07ee19304776831a1abf8630320b34a7e95306b98b5671584f79ae26bd32f3c4",
      "translation": "不断击退北部军后，[杰巴萨]就会出现。请务必将他打倒。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e59839621ee524796d96ffb1772a8a0aadf38c5dd96a27e621814c4487c31871",
      "source_sha256": "8a5468fa2dea1d8462c56ffe7ef7e29ed1ebed01d48e2474593bad69b6b90e06",
      "translation": "各位需要什么物资吗？"
    },
    {
      "id": "coalesced:15b500a1d5f685c3f849faa4b4ba9b410e5ad6f60e53f985865b4fa6da56c5b9",
      "source_sha256": "d3f821b1e9d23db3207763617e8c69378c20df22c59f2b95bb2ace0441b9d009",
      "translation": "祝武运昌隆。各位需要什么吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7535325f7b63d6b32f242120458c2b6bd047b88c658703711f109583ee5ca67d",
      "source_sha256": "bfe8bf2f97eeccc0f23a69dcc72fc97b65527254328bbe30718b0b4d20f12d4c",
      "translation": "击败北部军 (1/15)"
    },
    {
      "id": "coalesced:a1183758dba02522abeddf84b9b33317fc16f26b5b544aa25c689090584a3ba6",
