{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:227b1f30aeaa3c4ed7ef8eadae3cd1bc413071fbbadc10305f66304764178674",
      "source_sha256": "3b0d9826e4237e54d8df9853c1c3951be03135aa45e5e5a7181f7090ba9eda9a",
      "translation": "唔……"
    },
    {
      "id": "coalesced:7b3d5bee6d16cc311b60ed2197725f340afab67d6e2bdc28d27ec76de72841d3",
      "source_sha256": "da4a3cc45adb51c01c8e5113527e57c51f2942bdbc27c532d76d7d1978899ae3",
      "translation": "你这家伙，醒得还真“早”啊。"
    },
    {
      "id": "coalesced:3a43ad138fa5576bf615cbfd5ffcf0a5e62916fab40473f17f5ea74723836f3f",
      "source_sha256": "671153f0bb5ceb0df1339b3f53a62ba110859e5cacde55f8db8fa8d0de575b9b",
      "translation": "这里是……？"
    },
    {
      "id": "coalesced:34cbf9051bc00eae18cda65545d890f91b571a5374350f38bf898cc855e61ad8",
      "source_sha256": "a8802022076ef89b4c4a632097f0caa26eac00b8391a603b50d67c0e706828b2",
      "translation": "柯塔马雷。哥哥，你能平安无事，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b27c806645adba837a0311e03fe440df5375cdc3ec44ed4cab24c0592359eaf3",
      "source_sha256": "60d475661e6e9c21b3b3854a6c9c91d5b83d3f2c7a47161f15df71364cf7ae4d",
      "translation": "不过……你这头发的颜色，还真够厉害的。"
    },
    {
      "id": "coalesced:95bd7dbee7dbf4560c71ade17dbc2d1fa225efcd951c66795740d00f14a41aa6",
      "source_sha256": "d5b95af8d31b45257294393a90c24e2449d6c7c7e4285b0b47f1a7c1a1fec0d5",
      "translation": "什么……我的头发怎么了？"
    },
    {
      "id": "coalesced:0167da29a0ebe39618358ede789af9dc6f9a635b3c3c48219a0b8d99cae0ac2c",
      "source_sha256": "c1fc82e71687ddb55436aeff2905c5fd9f937f1c0548fe087576d51961bb9d28",
      "translation": "看来，这是跨越过去、战胜死亡的证明。"
    },
    {
      "id": "coalesced:252bbcd95993cc0833e16622522b21554e720a71edebbba8234cc5edc73791d9",
      "source_sha256": "0a7a952ced81f84f34dd0c181596fb137e048c691a12c208563ef9d86ef84d8b",
      "translation": "很帅哦，哥哥。头发变得雪白了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2bc2fc8e24cd6843fc2dfe47e978297e555a15ca0a2d1d3f2a2937f44e8230d1",
      "source_sha256": "c841f15e10eadb08b1224421b47467148bec73481933a0c513db98b3cc164dd2",
      "translation": "简直像个老头。"
    },
    {
      "id": "coalesced:f4bde07dfbf6a5bd806f16122fc9141d9cb9a49894226ffd3b60b02cab2f06c5",
      "source_sha256": "9b234662488847296e08c426c60988ef5400117f03bd5e82b8eeda15841e33fb",
      "translation": "哈，白头发啊……"
    },
    {
      "id": "coalesced:98bf1304178882886ed9d69138f02a4380d0007afbf2b68bbfd1b209f8a9953b",
      "source_sha256": "91c5cf55affce57857e27749cdb20a4cac6349616a5bccbbffc36d6a7851fd70",
      "translation": "现在身体没事了吗？能活动吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:194e140d0f313f66cccc23354ee2ba351f52d3d33b0bd1aa658858e86694da80",
      "source_sha256": "684b1dfabece3463bf787863672e941aabeb606c889a34c4280ba7b067a24ab9",
      "translation": "嗯，应该没事了。……尼克斯，你也没事啊？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7d51c227dc200cb462493debf17997573775920a5c0fc0c3067f6fb2ad2e8ecb",
      "source_sha256": "e59f910b9fa6e839024af230246271649ecfd5c04d0c880fe55934327f78ebe0",
      "translation": "是的。多亏各位。"
    },
    {
      "id": "coalesced:8db033f44b31226a85ac8c02f5514bd28c59bc9a0f9de93e82f6ced13473587e",
      "source_sha256": "18a6b767ed45687dcf92f0da7d0f3eea9cfa4f73c39687c414afd97c981020db",
      "translation": "总觉得……像是睡了很久，才终于醒来。"
    },
    {
      "id": "coalesced:9286e2cd27e6ec73e8123724579d4e0229418599fad68c4190ea52d8517d21a2",
      "source_sha256": "19672e1c44612348eee58b1d2fa811742f8613e56890826b0d74be71f7b94e35",
      "translation": "您的确睡得很沉呢。"
    },
    {
      "id": "coalesced:4aad592d8d42b67f0d030fed6c5393dee424391e950173141206a4ee1f4381a7",
      "source_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404",
      "translation": "……"
    },
    {
      "id": "coalesced:a7b8b0156f30d6b82b78f3fa784dd1ca0fa0abe9563424b7422c67af87b9ef2b",
      "source_sha256": "8194459091322223024e794cafcbfa14c1044be700c74c237d033a92c52302ce",
      "translation": "真是的……让人担心得要命，好不容易去救你，你还那么任性……真像你的作风。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f56185320c576d5a48fc452f6b48af30ba3b26919ef10f79f5ca6ec3de43177e",
      "source_sha256": "1f879ad9494711c719cbf6920a2f824d49e6465ff607021b5e7b0c0bde74f08f",
      "translation": "可我要是不那么做，你说不定又会去找修恩扎伊特了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2433c8aa8d34d0bae2141254440805640bab18edfd2cf202d4e255b99567b3c6",
      "source_sha256": "88150550bd0dc28f5dfebdfa8f4e47038fb0582f30f2f5a0d933785e021a7d02",
      "translation": "好了，别再解释了。这是命令。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8ddb5e5ef51798af8d04340719347179d7e18730728a8bfbe93d08c8da0625c",
      "source_sha256": "5dcb8e5d0779e6620d401183d3db80dd7d0d4a3532bd069ab9a17ff317a3190f",
      "translation": "什么啊，我要是不那么说，你又会……唔！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8b307386dda7d954a533f3e24c585669cb9e53b620744ae06289262cc33eb450",
      "source_sha256": "37c1660339123d1e743c5cd49a36851311770fcf04b4a940d317823c0f76906d",
      "translation": "朱特！？"
    },
    {
      "id": "coalesced:e3a5f3373d7ecec3088343a3df2103b448d8665b378aaad43a8920cd58f893da",
      "source_sha256": "ea9afeb2a658388b4d7c23e41853cce75dd62dae5ad34fe1417f4a5eb8c28f6c",
      "translation": "怎么回事？刚才，朱特哥哥的手背发出蓝光了！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7f82f64c41e0c1698f08b0606f6f097f8f9cc5e885486dc100766888a58b0aa",
      "source_sha256": "a298b82775d90ae5d503dd9aa3cb167d588fb6598163d3d761254140117f16f0",
      "translation": "啊，那个……是因为，如今公主已经是朱特的主人了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9d1415f321013714a762547f8ff1f9da08eedaf54ef03f9b985ebf0eaf28156a",
      "source_sha256": "892b43ae331decb43ebd611d91e7748fc9e0bf713254a2bf1cbaea694050da77",
      "translation": "那……那是什么意思？"
    },
    {
      "id": "coalesced:5550ba5bec044f5a25ffb4a6c2a67823694e343f96f509871aa55a1e4a7544df",
      "source_sha256": "d27bc6d993b755054b5846d796325cd9d6303838284e8749d62b356bcf9a1504",
      "translation": "你的主人，已经从修恩扎伊特变成了公主。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2fb4d0e76499b35c7c71b8e39c9d9016cca91370b57c036e0fe727df6c3b932b",
      "source_sha256": "5d692c11715999370835845bdc529bf154496e42852432619099c6883273645c",
      "translation": "因为公主救了你，才会变成这样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3a18a69815ae802ccd9961aa5186d29e8456cabce4e0e1b5f7117ecac5c6dc00",
      "source_sha256": "a2073db78f03cd1bf3748a8b3af6157f133e4998e7df32cdf9de8ba2cd48a50a",
      "translation": "所以，今后不能违抗公主的命令。请务必记住。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b09690b72ec19624a1469a15ebf3b12ed8985cdd947e726e8f3b1df935400b9e",
      "source_sha256": "37d02dca08bbb54965dc26e4f430e68b8a13d980bac7365664a619809eaeebf5",
      "translation": "不然，就会像修恩扎伊特那时候一样，遭到灼伤。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb4714d4e47f9c01b9ee42951a2915412d5fae5e716d8b3c2639090e9be14490",
      "source_sha256": "5306a58302dbc4812fbe574bf43e4802a2a5a58cda67e1343f7848b844613285",
      "translation": "你说什么！？"
    },
    {
      "id": "coalesced:5a82e4dd78feaa5c9eea136a2ff05faaf185efd2e0afc69dac96db8ff8699bbb",
      "source_sha256": "2e6f96ade9ff683619b02dddbce07a7f488e7aee4b92d0b7383922fb91cfc8d4",
      "translation": "对不起，事情就是这样。都是为了救活你，实在没有别的办法。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:cbb57a399936cef2bc5b6abbf7373f2d0ccbb1c291dc18eed730c0518f3d4161",
      "source_sha256": "b52378c31deeb7f2b211673aa3519190b6ed12fa4213a62de1f5d4832b446a5c",
      "translation": "可是，这也太……"
    },
    {
      "id": "coalesced:e4764e33164eb69d2436b501d72722902afb336a6de787841552f86ac2aa6717",
      "source_sha256": "7cf6c1476aa36d2f91ce6e7a999fa3b706c89d8853b4a2e7c9ce3cda5a1cb0ba",
      "translation": "公主，不如趁这个机会，好好改改这家伙的坏毛病？现在叫他做什么，他都会照办了吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:52bd99c21be890c304aecfdb48bb4fd22f7971ac25210202fef9a4102607a092",
      "source_sha256": "223da1afe6aeecb36d8c96442f98e63a549b903c5bbaa5917b00e23fb21a703f",
      "translation": "确实。想想他过去犯下的过错，就算让他当一辈子仆人，都还不够。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:54ab6c0d36b6956b5e4e8c4f574c69a1af4fa3ecccb4b2dd909a8de98beaeb6b",
      "source_sha256": "c72e7908fc488298351ddfbceb96d3a6ab507e640f1160459d11aba3bb0c9fbd",
      "translation": "露，连你也这么说……"
    },
    {
      "id": "coalesced:b529443bb00ef0d2c7423a919455c6c984d214acd54c7a36556a3935cd97e68d",
      "source_sha256": "8089b0ccbba489e53964dd9191eca6c034416651433e0db8555638c545d91f77",
      "translation": "哈哈哈！哥哥，你脸都白了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:59456485f9a9caa096d056cff9e338eaae45c60df7204fba4f5ff4106c120aa8",
      "source_sha256": "a45295dbda0b90594c0eed303de85f396437057b576fafccbb76447feeeae542",
      "translation": "那么，我要下命令了。"
    },
    {
      "id": "coalesced:bd6b2ab29494a49a102ffb1fab97c2c6626754d7cb3c861e8a59591359c46092",
      "source_sha256": "8cf2f529c2a6e3a2a2c3c5846e9c6c7b5c9dd9672199de30480a25d75ded30ae",
      "translation": "什么，真的！？"
    },
    {
      "id": "coalesced:c347223e8fabae1adee54f3c677256cec50981873aedc5f3008668fed9aad702",
      "source_sha256": "48cc097e6fa0ebb77a596bff8dc1293bbfca16701085351c4ddf95f4d67c09b6",
      "translation": "首先……既然是伤员，就不准乱动，好好休息。"
    },
    {
      "id": "coalesced:01ebb668cc0b6e9e53c4c987655b1e34d6d06dd706c829cf21fe682cb6308395",
      "source_sha256": "c64afca3b32a5956616aab6ecda0a2c002bf3aaab1797ed5e803c009dadbbec6",
      "translation": "呼……"
    },
    {
      "id": "coalesced:ca068c418a75d09e18b17377ac4528f0df6afb81d671d87938317901ed5fe831",
      "source_sha256": "1655a0de406d0ab3f44e7134aab4d5200e5a120bba55100a6d292deafa011e22",
      "translation": "哎～这算什么命令嘛？"
    },
    {
      "id": "coalesced:a5bf64dc0a2883c1b2fc7082a03f1e76a3009a9662ce760f3fd5e072edcd7514",
      "source_sha256": "54b9c398dae86a1e3ce0bfda95be16d8103e8296bfb410e64e33a10040b38b92",
      "translation": "既然让我休息，那我就先休息……不过，你不会趁这段时间，自己跑去贝尔福特吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8c1ff28fe98920509298678ac221cd4187d0062b6e23900b5511bc5f2096541e",
      "source_sha256": "b5eec1f3ee1bedcbe2df5f5830a88cdcaac941050bc7c9ac07cb37d5495bbdfe",
      "translation": "我会阻止公主那么做的。"
    },
    {
      "id": "coalesced:e76c087874859c4d25963c2626b2c17a5737459f793ab8fa226850f365512686",
      "source_sha256": "d20170cb98b906462829857987222831b3811140b0afc5b5a438edc23c773d7f",
      "translation": "毕竟，我也和朱特约好了。所以，我想先调查一下过去发生过的战争。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a9ca05315e9e6c1bd6d5ba24ba923cc7e7a7fdb85b8cc4c41c0379b08e3de6f6",
      "source_sha256": "f7a7717df5fc4aa696836932724a9a63df9083c9a5155963a6c8bacf06ec9b0f",
      "translation": "想找出其中的关联吗？"
    },
    {
      "id": "coalesced:cf378cccd165e0fa2d2c054a7d6fd20ebb20318ac041a3af15721424f4de5e3c",
      "source_sha256": "a049bdc44487d09be6ace92df156e6037823175afc0cbb55061ca9abbcdbf634",
      "translation": "嗯。过去也降下过灾祸种，调查古代记录，说不定能得到什么信息。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:16ce2fd6cff6be7db93b114389af118ede795d25deac21bfdefc1bd92f374624",
      "source_sha256": "de3116889a8756f6d8bc1ac6accc8e6eb5dc3fa9f03df18a55e750c912acfb87",
      "translation": "而且，柯塔马雷是斯特拉斯大人的伴侣，阿塞莉娜大人曾经生活过的地方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5608832aa7b5c4e4fd58197504f2c3ff1ffe76299c4117ff069072b8798feff",
      "source_sha256": "d9e0c236db89b8007d3a9f14ce5796b877bb70468dc461d658ca38edfd593891",
      "translation": "因此，似乎还留有一些卡尔塔大战时期的记录。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f0b7877a2bf042e04723294e6c7ede55a9c12812c930aa9d592ce165cafc1f03",
      "source_sha256": "570da2f2fa3d2dc876de1faefaeda63b72e218abb43f91068b4eae34b12833a2",
      "translation": "另外，听说马雷族自己也留下了资料，应该能帮上忙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:50d4f2a3ab92731b86faaa6fff882ad9aa3d4164f3bac18e871c0d9bd2e8d775",
      "source_sha256": "d74a30cbfe6017f4d8a7eb01462d5771ccc13e857e1bf64c012c01486f9fb891",
      "translation": "嗯。一定要找到别的办法。绝不能就这样结束。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5297d9c94ace2a9978ab37b3272a27cfe68aa5aa06473e15749de586cd84c036",
      "source_sha256": "1655d672cc64c4e9bb9a5b12d453b5ca3ec89454c2d14a4bce824e670bb45520",
      "translation": "那明天去族长家吧。只有族长知道，资料都放在哪里。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b5d545a4b6bd1334f464f56374e48392d58839338362906c13b7e762bb15d9a5",
      "source_sha256": "3dfa858be5466905c4874b5bc92b2d2368dda7787b54bd35037a5b9d4e512dab",
      "translation": "知道我就是艾尔加时，你很吃惊吧？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a1f99e0f7a96087be6cc8a3d56b1354dc139e767a3d7796111aee1c6950df53f",
      "source_sha256": "8025c713f26164a6787608a6cbce1b8ac0cfe963a42e1416578db60193e95224",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:9d214d17502996e86f2780ea003e6bf078bcd4e9d41193b3890428f11263549f",
      "source_sha256": "ccc4f8eb1595896be7ddb96813fe170cf16f222ae76aba1eab077bcbd3785ba5",
      "translation": "我原以为，你再也不会见我了。也觉得，那是没办法的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6f56984e90bb303f8e4240088c9504bd791a33b8f9fbd5100162c505906496f0",
      "source_sha256": "bd720b382a23178f5c6df21de4ac7f7f28e56a8efbb4dd06c78d6a7fa3d06dea",
      "translation": "为什么？"
    },
    {
      "id": "coalesced:c1375e742f7af913da5e4735ede9d4c4e72f8decd0f65cfc55cc4d98fc58e435",
      "source_sha256": "f39e9f2857f1bb2d0951da9e8006b8ea6595bdf07c4ac405c3b7b1cb9c40242e",
      "translation": "因为我犯下了太多罪。就算是在不知情时做的，也不能因此得到原谅吧。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:98a2ee72ba52919318d5a3a10f427ce8b254c46259b4181a72a32744c34a1a93",
      "source_sha256": "3a7d0b8eca87ccec19759f73ff276175dbc075aacc345ae8a0f2483a897082e3",
      "translation": "可是……今后，我想一直赎罪，继续活下去。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9c174ca1c1af1101a46bc19f4a5a5eb6837f1e61f23db029f446f207fb27105e",
      "source_sha256": "ee96491a74dfe0564435ad228c5bca78fdb58bc2f8a5bd71abaddaf5fe5d4cea",
      "translation": "谢谢你……接纳了我。"
    },
    {
      "id": "coalesced:a8e73eaec8b980b6aeba47d02d03a6cd851e5c5beea197345ef11a75f4732ebd",
      "source_sha256": "867ece0f128af8bb15cf4c043922cf75d92a97f6f0eb80a35268e0baa678c139",
      "translation": "因为我说过，会相信你。"
    },
    {
      "id": "coalesced:d808765df2f37edffa512d026fa2bf29d103d0cb5e2e7dce278a4d008de2e09d",
      "source_sha256": "74ab1214f3b0a9ec9ea9bc815533f9c8cf820f6ae6df5e9c3b99f8c467915790",
      "translation": "洁菲……"
    },
    {
      "id": "coalesced:10d08c2c4a6f2ecc4a39a729ba977c268e50f79a41d0c11d2598f82c9b5505cc",
      "source_sha256": "3cdbc289068a36f2710d6cc20d5287acfc4238ede6fc6799ee125c370f5981a4",
      "translation": "而且……该说谢谢的人，其实是我。"
    },
    {
      "id": "coalesced:15238187f611411aaf95b694722c5d3f25ffe1ebe9e4939e96beb2bb47781409",
      "source_sha256": "35be98cc53614060694a006fbcb81b1d7efda7b55e7149ee1e1098a1a816a211",
      "translation": "我……其实不想死。即使牺牲自己，是身为公主的使命。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0f8c96d1602e176f1bafc17131d4df5d20d525dad177dbb1cb89ca1c2eb71269",
      "source_sha256": "ca31e8b1d2a5caf39793f5a9c5099e29b353ce681652767c06d7dffd066f9af2",
      "translation": "所以，当你说要寻找其他办法时，我觉得自己得救了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:02061233490381de5c9223b477ff49ff2f02537df03fe03eb7e08e9891757b49",
      "source_sha256": "7889837acd25665ad9dc7e0b66c518f77ee8a11c157ca6389f2fb25964a3848e",
      "translation": "我已经不再犹豫了。我不会就这样放弃。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ac6648b457433cc8bc7e698bf113de99af80f25326639743271ce73bcc2c9f8",
      "source_sha256": "e0463f9ba957fb53776fba271f675e3c9b2f0e977dff1fb6729d10308175278e",
      "translation": "嗯。一定要找到拯救世界的方法。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:307246ced70b6503e3fe85e0481ae57c8c84d51b20e6dc425be60f5d1a71b9e4",
      "source_sha256": "2df678a10df478786867baa18092457685117fcbcbe24b2ec5342def5630d493",
      "translation": "因为，我无法认可一个必须靠他人的牺牲，才能维系下去的世界。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:772d0f52455c51fa128abb51fb153b22c9a5a6d80b3ada62704f8cedd2b4c05e",
      "source_sha256": "47dd1707211c7354d813fcd6c66319369aef44dca3d28aedf2278035f5fb055c",
      "translation": "嗯。"
    },
    {
      "id": "coalesced:498a810c62b35285c7c1f7ff5ebd0d95d2b0efb16804d594540cef4934690768",
      "source_sha256": "e75c57ac5a16399b3efa3408ad6683b56cdbfedb36bf83479fa497bde2d2a677",
      "translation": "总之，先好好休息吧。你应该很累了。"
    },
    {
      "id": "coalesced:f1492ffa7369a57f3b36bf32731f1a9d55c72cfa192d3df8b43089748fcecd06",
      "source_sha256": "dd721a0afe55d0aeec39a94d65cd7efa4fa1c2f71d2589a31ec01a2fcef200cb",
      "translation": "既然接到了主人的命令，那就好好休息吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f91f038dd611ae82fbbd072853424cf70de4ddc94c6688ec96a502f1958c14d9",
      "source_sha256": "aa2be8bf39a92f3af4dfc2e29520fd5c74ab18b8e5b03f2e202f64dca3bdd871",
      "translation": "呵呵呵，以后，你就不能再擅自行动了吧？至少这一点，确实让人放心。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:acde9237c3c7642d5ef3764452d3d721761d82e956a1a6412d32c164bc0b920b",
      "source_sha256": "fad7cc4f4c533821435352368a89457268cdd7b5a7081884959780352b84051e",
      "translation": "唉，我的未来算是完了。"
    },
    {
      "id": "coalesced:3507cfd2a46acb33e150619884c8e862cd072a131f6a16c1d7424f68c3efbf98",
      "source_sha256": "a582916707786cd96809b0054f21bd28a9f1e1dd92c30331fdc5249dc6667875",
      "translation": "为什么？怕我下什么奇怪的命令吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:4f427011fdc4883d464a99340164329268d48edb041531b29381419e115953b1",
      "source_sha256": "1384c09c2ec4e323b807022057882980c3572ee50cf1356bda0bf0d98129c1f0",
      "translation": "不，就是……随口说说而已。"
    },
    {
      "id": "coalesced:66834f9e43438bfab9d06231eb8dd470b7fca100278324f482c79a57b539f848",
      "source_sha256": "7e3e647c78be1c47b70ae2bec526bb1824a7ab55d0c1ad4021714565b8b14bd4",
      "translation": "这或许也是命运。"
    },
    {
      "id": "coalesced:7f488441d3b5859e647a61171eb9ec42ffc049556b1a9fa670974d61bc16aaeb",
      "source_sha256": "a95e51248988ebef69627e2e4643cae3cd263f318266ffcba08fba25bc8ea4db",
      "translation": "洁菲竟然成了我的主人……心情有些微妙。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:86c50551ab1597588eb3a3c4ac4c4b811eb1d19270116b09e54b2fe5087c9d2c",
      "source_sha256": "5410791c9b1c3a2326ebb2785676e410f6e5b7e52a41d26015f1e0e14176e20b",
      "translation": "然而，那时我还不知道，这段关系会迫使我们做出意想不到的选择。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    }
  ]
}
