        "target_count": 0
      }
    },
    {
      "id": "coalesced:4becae18389dfb384481351dfdbda059b2b22f9723e57798742883fa62fff605",
      "source_sha256": "3cdee9c884a12a898dad6bfc08f6fc4b3f250accdb71004a4c8d327bb99ae2ca",
      "translation": "现在，我自己也能逃走了。"
    },
    {
      "id": "coalesced:3cf0dcfd9db2137c7f06858bff78228eaf80c8b70779114ffbe53930e0d56ad1",
      "source_sha256": "cb942546615244aba5260df0541eb5c243b5c2ef014c8fbcde857a7c6616d236",
      "translation": "真是太感谢了！这还是南部军头一次帮上我们的忙，哈哈哈！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:782ecfa183bae9e4c12bfa65bddb64079624e4327e6343a8190b92c6152b44bb",
      "source_sha256": "ef7b14bbc4bbb8c57c2deefb78c0724f66c5fd0acb0f23fbff83a9322c6f5c99",
      "translation": "我已经通知联盟总部了，去那里就能领取奖励。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
