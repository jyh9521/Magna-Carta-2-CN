{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:654c08d98674bd60c16bc37fda6ab11ad24aad49e7da6db6504fb9dc43ccee68",
      "source_sha256": "c926e6175e2f6299bfa27a125adc3d104835f09014dbb333c0523efbef6665d3",
      "translation": "唔……"
    },
    {
      "id": "coalesced:797c4e2266877413777a1ddc9ad6c12a181e7ba629a7691fdc7227e9dbf1bf64",
      "source_sha256": "f4293cd79e6d079cc6fe27687b650c393dad6d8f3ba2751a50f58edc9702202b",
      "translation": "怎么了？哪里不舒服吗？"
    },
    {
      "id": "coalesced:4f27e20c58523c270e0aaa6c031f2bd8b10ff969a7aca7d48d5794db20419d9e",
      "source_sha256": "19243be067349ce788fc26c981dd4eb2b438e012e9d48d59d19bb99d7f7e15f7",
      "translation": "没有。只是……胸口有点闷……"
    },
    {
      "id": "coalesced:87c9e4b25b250e6bfe1cce68390a754d101389af2bdafd994425060117345921",
      "source_sha256": "904ded2be4071e52ff951bdfcc71c881f486661b611267e43542ed4a56890a78",
      "translation": "让洁菲看看怎么样？她会帮你治疗的。"
    },
    {
      "id": "coalesced:d2b46358da321acbf53cded399925747f3e5a8f3ba93ac604d74ecac3974984d",
      "source_sha256": "24acf29d7760854acca54215912aab9c82d0b607364eee8f0c32a52c14186e33",
      "translation": "不用了。又没有受伤，现在已经没事了。"
    },
    {
      "id": "coalesced:62e615b619c0fbb8be46ce9fdd93b73d8450b6f8b3f36c45387c624277b87ade",
      "source_sha256": "a1adf1829c401de53dfdcec7c0ae0530f731b5f6106abf094ad008f88a239c95",
      "translation": "比起这个……"
    },
    {
      "id": "coalesced:bb82022db284aca3532cfbd27334349fba2aca61b7a670fc03e41578a3d1d0cf",
      "source_sha256": "15243bd6997bd676f50a04792808422f2c0d67f23e2cc538d44dafcad45e9ee7",
      "translation": "我差点忘了件重要的事。风息岛上的人怎么样了？大家都还好吗？",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2d34f2480c7628563e9be9ebcdd5d67dfab9778ffe1e9d77890b2df2154ed171",
      "source_sha256": "40ee100ed6367d843682ba8571077c2b419a3755badec30134dfe0f54117a954",
      "translation": "也是……你还没回过岛上吧。岛上已经没事了，大家都过得很好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1e065daaf041cc50ab60804324429a1a273795ac674c15d015b1f68a42d88d9d",
      "source_sha256": "f36b03409f5c5ba1fddc708ba1659a4af914f36b6ca7c5b4ee2add9c122b3648",
      "translation": "没想到，艾尔加竟然真的做出了那么残忍的事。"
    },
    {
      "id": "coalesced:1a089f5f18f71d1e1066d5c613ec2a701da420be0be9bed2b87aaf07c6987d1c",
      "source_sha256": "2ced06313186b46b5a8132401e9c613bc553b65a47102714904bb8ad1921a827",
      "translation": "那家伙，似乎是故意的。因为他以前就一直憎恨我。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f7bde83558d2baf65675e60bd9f60f67ca3ad83383b834c2d1d959fa11de94fa",
      "source_sha256": "3ac09bf99ef151167e813f7ecbdc67d3f3cc8383652ea090c9a1f1c1bf481db6",
      "translation": "所以，他大概无法容忍，那些接纳了我的村民吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b55372dee64c3478d726dd70d460f11c5f517d34ce2c17e11aa27da5516902c5",
      "source_sha256": "3a438dfbeb91d2561672f08123f1534e3d01156df1875d101dab412b2cdd5481",
      "translation": "嗯。艾尔加似乎确实对你怀有自卑感。"
    },
    {
      "id": "coalesced:db0b4e2564e908342144ea10635afb49eeebe04713959ab3080689bd1c136616",
      "source_sha256": "3ac1d6ac272472a502f24a54c8d15d6fba1f28adbe1fb6ba8bd3378a389361b2",
      "translation": "有点不是滋味啊。那家伙……说到底，也很可怜。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0c29765c9457fa177a521d237c3faa26870e7411de458725f3b65fd37633dfce",
      "source_sha256": "95655ef55996a9286d3f3d7f0a6fea41f62e1053bd97124726c24c0c2042716e",
      "translation": "因为，他也和我一样，只是被利用了而已。"
    },
    {
      "id": "coalesced:be32ed72d29c971d177579c80e1aaef65174eabf1c20bba99cfe72b44758b403",
      "source_sha256": "ddfc2d863d52d8361c49c580cea48cc78d245e3989e7629f9c05e37800aaed2f",
      "translation": "如今，一切都不会再……任修恩扎伊特摆布了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:463bc026d3e99e2d553d2adb69c51e48e8dae3aef3accc97081abd80018abdd3",
      "source_sha256": "e4b0a51d7c6574a5d0c78da7bdc4ef57368690752c5afa9d4ee1a50abfbf4281",
      "translation": "正是为了这个，我们才要前往拉·斯特拉达。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:43ad6c8a92e32b0e11d795fa576ac36b0bfc8d940eae10449a14bc3ffbdc5ace",
      "source_sha256": "59c25a3b43ad43794db9a01b50556d6ef40ada6333cad5a1ed9d78cf05d420cd",
      "translation": "就算我们之中，有人倒下了……也希望你不要放弃，一直战斗到最后。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:72a51e4dc9a7cf258f9ff205c814df452419db34695b1bf9006b044f0ee50100",
      "source_sha256": "13eb45e9586ff0d2578644f988ffece6e96187b5707c76ba51f224166c0fb482",
      "translation": "不会有人倒下的。大家一起去，就要一起回来。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1bfd9040a9a2f5413ae03e52a40cc8103b0d8b49ef4e4210d9a26d059b137884",
      "source_sha256": "c376fcb58d167e39e2201ebc15d92b7e3bd52043561ec1a5fc6f6274dbbcd440",
      "translation": "我们部队的目标，就是绝对不能死。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:5448c544667e4279386ca7980a48eda37de64183e85f405c070e377857f7216a",
      "source_sha256": "5e99bf21a804f721f4fd2ec13d7acbfff7b6ff171eba76c22c26738001bee5af",
      "translation": "梅莉莎，你也有信心吧？"
    },
    {
      "id": "coalesced:8c2501cec3fc54f896ce793ae17582a16ab9b6de5e6d73237a5cc60de30a11e2",
      "source_sha256": "4944d458d40dd1588de83289dd8b5bcaf97261481359f5d33858d033fd22776c",
      "translation": "啊，嗯。"
    },
    {
      "id": "coalesced:59a9f9b858d44eb552e2906994e6ac4bd225513a7e6a04c0e173f80779d8903e",
      "source_sha256": "2df526ffd8089a4cbba70b8af75155d416d916548d9c31e52b26b1ba70763c0e",
      "translation": "需要的材料，几乎都已经齐了，只差两样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ece802663383cf3e8220b0ec63623b6e81c3d8916486381964d9c2fa0c60ec32",
      "source_sha256": "a64497c52f1e9817edd7b9223d6e12cb3f703d7b77cb455265dbe31e8681ef07",
      "translation": "首先需要的，是用来制造装置核心的[特种合金]。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bba75945b9534ff4a8e53ac48fdbe01752cf2b9ce9442a236e54665da0b5528b",
      "source_sha256": "a7ae84b7c7b6da631d9926a3d8287ca9e62f30e06329b96905d6dade35307a00",
      "translation": "我问过柯塔马雷的同胞，据说去找住在水色湿地的猫猫，应该就能弄到。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5709f9967aa6a8cd533b30e94bf07991d7ccb3cd5e96cc84ae3231351977b55",
      "source_sha256": "dc73681b9c3cc1d4cc83183a144055993c38c394226eff05458d8938546e5a89",
      "translation": "猫猫有收集闪亮物品的习性。 ",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e41fa0e327b18a27db4804fbaabec359fa1d744b24748f01391a7cb9e1ba0ce0",
      "source_sha256": "8a00960afa1a41dcfa89725f6bb9cab67e8a31e6a6c4588f989d2f8271f58d83",
      "translation": "不过，想从猫猫那里得到什么，似乎得先替他们办一件想办的事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7da8a144348919639ae80c8bf7ff77989bd042081b2699869cdca1ce18da370e",
      "source_sha256": "fa095f60bba8a786836351da5ff04296f6f18c71dc4ae89737aebc347894281d",
      "translation": "他们大概不会白送吧？请去猫猫族那里，完成他们的请求，再把特种合金带回来。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d4b0e6f77af45551e559225da0dd960a4cba30f416934d7c5047cbe6e08c006a",
      "source_sha256": "45957e86868dd9adb4de099cd064c64c1dc6587e23d5fcec7cfff2d6e773d975",
      "translation": "据说，住在水色湿地的猫猫，持有制作核心所需的[特种合金]。\\n请去水色湿地\\n寻找猫猫。"
    },
    {
      "id": "coalesced:887a9da8d9526be8179dd1bccd2ed1d87039d417ce8c26aec9c587d394e417e4",
      "source_sha256": "43b30f606dc0b11bf7491350baf3793f215296cbc13f7479513f77a5714e2b3a",
      "translation": "核心的材料"
    },
    {
      "id": "coalesced:7b596b290b268294b9361e75b01486e72ebe55f4512f2ef4c6d459cb6a9a474f",
      "source_sha256": "9b021d919a24e205b8dda17820bcb00bae079dc4bff0484171d9465f32029e3c",
      "translation": "什么事喵？"
    },
    {
      "id": "coalesced:f31849e396ad0b80be27389afe467d70cc51e24338f49223ec5c9d3cef19b1ca",
      "source_sha256": "e1cf368632686f35de6a46d2f8375816df56de31525fc4cc6e061b3552ee7093",
      "translation": "特种合金，我们有喵。你们需要吗喵？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0ddc8bfd814724301efadd72f03b29a471d57023a24704f523f53931726c1a1e",
      "source_sha256": "bdd6dd9ef54fc8d36fe311b971b202ef58468cc44f1bebae4a7c2518e95ac067",
      "translation": "我们有想要的东西喵。你们要是能找来，就把特种合金给你们喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:854bfa5ecf7f8fe785af80f8cd4d226f3529d6edadad9f9542a85732b88236ce",
      "source_sha256": "a3f22fb65415d98acf106d300efe775bf125b8102ed62d843d5b18bda61cbaf7",
      "translation": "我们需要的，是[梅雷花粉]和[黑珍珠]喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f6f6a09385a99c8462fc62187c239c4b7477fd5021b7ff291f5887f2694b5ac",
      "source_sha256": "57cabdab6b4a38e92e0033b3acff12b6e31ca8f268c2e40a4897bfb23ec23bdd",
      "translation": "梅雷花粉，只要打倒水色湿地里的梅雷，应该就能得到喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eb87d25cfa0f076eb460b927082af53eb9ae5263d0d03879a558d54d6ea97794",
      "source_sha256": "d7a632639edc78057a8173d3a4dfb8951460ae304eac80dc6933e30a255878e7",
      "translation": "黑珍珠，只要打倒水色湿地里的布莱博拉和艾博拉，应该就能得到喵。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3c969d60acf816a284a4a30b196a641c9d662e733ed5aa3c1af8018a449cf9d8",
      "source_sha256": "e40f9a44674a3579ee3f391ba12a7ec4d38fbe446350aa646fc084d3ebe3c835",
      "translation": "请找来4份花粉、2颗珍珠喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d6b5964940ba2d83e27cae1a76a31a919cb899dda6dcbaa3eb6a842de55a47f7",
      "source_sha256": "6c059f0abc35fa5c7d9f058fe6bf6c8b2226f93f3d6a1a8cdf4861b11437fdf2",
      "translation": "快去快回喵。"
    },
    {
      "id": "coalesced:acd17a2de5c96592503e35cd6df74ab8b8d4a61f94ad66eca63b230d4bd33ea1",
      "source_sha256": "6d0cd61435cd6418fbb560832825fbe00b959096681e7e11e163fba1776d3ee9",
      "translation": "特种合金找来了吗？"
    },
    {
      "id": "coalesced:b56dc0cb533c458aca96f9f7d7c25dd6c3dbe9681b6bc12dbbbab7fe133fb135",
      "source_sha256": "90d366ee4119acb61e2251a689ab9a0c0df3ea2206bbc7bfb9e33ef62842d77e",
      "translation": "辛苦了喵。"
    },
    {
      "id": "coalesced:2804f4dba5a8ce28fb6eb679d90a0535ac63fea99a721c1939bed058ac544c2c",
      "source_sha256": "c09e511f0d693f3a7957314d1a3cb360c04f2086906caad9019f2dbc7f46c6c5",
      "translation": "猫猫答应，只要完成他们的请求，就会给我们特种合金。\\n打倒梅雷，收集4份[梅雷花粉]。\\n打倒布莱博拉和艾博拉，收集2颗[黑珍珠]，\\n然后带去交给猫猫。"
    },
    {
      "id": "coalesced:37dfc4cee1ab51c0b50fa1392b157918613806353704076a2a152fb67b33ceaf",
      "source_sha256": "76ce9343fb31e3b52f4e7fd5327f6d884b30e589ce31ced1c23c1d54727cfcfa",
      "translation": "QUEST%s: 梅雷花粉 (%s/%s)"
    },
    {
      "id": "coalesced:a6737b7691f883a7f922741c782e78c70ad6900616d3b68cf685f3834718be92",
      "source_sha256": "7222c3ecc4fcfd7b5b57a49cf8c3f4d74529166741014bd227c011e4173c7a68",
      "translation": "QUEST%s: 黑珍珠 (%s/%s)"
    },
    {
      "id": "coalesced:7bf3bb06b46d7727a87055ffd2fc3be3c394260690749256cda912f5c9ef8d1d",
      "source_sha256": "7df540fcbdf629c1de406841d455f35898ac440afeed92490eda353446591590",
      "translation": "梅雷花粉"
    },
    {
      "id": "coalesced:abb36c713135f5aa8090ff7438b187ce920357b57174edb9b066168c1c5d3949",
      "source_sha256": "411ae4ecc6dcc75953c0650cd28c85130c59cbbf1692a71824d12d8873f4b3d5",
      "translation": "黑珍珠"
    },
    {
      "id": "coalesced:4b8f083d5ebcbb1d3d6e945593e18dc685e195ff38e068a728b7036d3c027f4c",
      "source_sha256": "d13989cbe88d9e1e00fc0b4ffb74669bd3df3d0f02ea1dacddfdcbc666c4eabb",
      "translation": "帮助猫猫"
    },
    {
      "id": "coalesced:b5312b1464f396f6bd1935a61430eac5ce51fb3a28317be045c00b3da6edfe19",
      "source_sha256": "a7266b6693199b06fdb6f28b8772281dbcda600b89619b4ce98bf1ad380d88d3",
      "translation": "辛苦了喵。这就是特种合金喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c09522d3af75e2e0f199f6c548eb2a5c6f3b54ffd9eedc35f4d5dd256499c67c",
      "source_sha256": "32b65101307f4eebf5655719fb4aa0661e0a13c0f77b9fd57ad89d4f0b319021",
      "translation": "啊，你们来了。特种合金已经找到了，现在只差一样材料了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:00b883e1118a8d7d4448c5556d375ec01ea39f890a1f04aabbb0b9c1a7abf03f",
      "source_sha256": "8743cc9b2179c4915b94d5704389bb7ccbb1ba112bdb7fc136f896b2d716c7bb",
      "translation": "请把特种合金带给柯塔马雷的伊格顿"
    },
    {
      "id": "coalesced:b3c15a603f4b2faa5bff1a70294c8ea00ba17a19d67257041c6f382640e1b382",
      "source_sha256": "b5eaf4f6a6a107cf51bbd50a7cbc9199602a525bc1ce5a11bf2d0666f961b184",
      "translation": "回到伊格顿身边"
    },
    {
      "id": "coalesced:bfc110f1f2f2f07bdec7ebced092b8780cd9a7ede6d4f39fd8cd00d865a87cab",
      "source_sha256": "4160c21bd2b788b42156f1a8cc3eed5690ecc40b4aa378ccabcb8ef8de1eec5d",
      "translation": "下次还有需要，就再来找我们喵。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2390fca345e378ac0b8d9d75e7efdd7d25b0173acfa27c5e2f849dd53b23f6b1",
      "source_sha256": "878563dfe3ab1ace2ac10c4f4c5466572f6711ee31a64c08dc0a47156a9458a5",
      "translation": "最后剩下的材料，是卡蒙德。"
    },
    {
      "id": "coalesced:91451a8e04666d9fdc65826ac777fd4e1ce1298289fdfdca19b6256cc35faad6",
      "source_sha256": "d204890f6ee655fd5184fda09d3dc185d7ecedfb0e3eaecaa96d4578ffb9cdd7",
      "translation": "说真的，千年前的人，好像太依赖卡蒙德了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9561619370e583be611c534509b37cb59697c2433907a623cccddcbe9f76e643",
      "source_sha256": "5e0aa99a59491f57db98dac252cc728fc4aa678e3b1a29a60f8ad0117ef6273d",
      "translation": "不管想造什么，都要用到卡蒙德。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f36ecba79136490fb5a049e3051a9ee26a9939c750ab51494fed969e018d0cea",
      "source_sha256": "469cd80aec6c23e670b029b29e44117817eeb17a2b059dce3d350e3b5806d9a1",
      "translation": "不过，确实也没有比它更高效、更方便的燃料了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c13267d7b71c91a75f631e56036738b96971dcfbd4309100654168d041e92e1f",
      "source_sha256": "b48ef6a4b456c853b42d653648c47a4448216fcf5fc16c400fe0a2ec364a39b3",
      "translation": "那我们像救朱特哥哥时一样，找一颗大大的卡蒙德就行了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b465052411b3e3ba71caca5585a9e0e245b5a8456b47139207bbcfecb8a853c5",
      "source_sha256": "02c846c47967862519989b50b27e9fecaac6f17c24cbfd8e8aec4ada5ba67361",
      "translation": "那只要找来一颗，像当时救活我所用的那种巨大卡蒙德，就行了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:afd286cfa8edb88c2ea441004e550a488d7a1b945ad276adb1dcc9e78d393383",
      "source_sha256": "d2bf03ef0304547c1861dcdc20127ffc43342948c085e572527ee8fbccf215c0",
      "translation": "那像救朱特时一样，找来一颗巨大卡蒙德就行了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2118f765036185be8b171501be223b92317bdb24b5e2e156f88ba0ab0519c3ba",
      "source_sha256": "8a56b0cb5ccba9a2b64360981ec7cbcdce3c6c22ca0a0b7669c0726512d0b2bf",
      "translation": "对，只要有那样的卡蒙德，就能顺利造出来。应该没有想象中那么难。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b9256d7fe49c9ee478193d9b1966a873c5b439bd8b68efd180b48c6e59954968",
      "source_sha256": "a020066de5b0b0583259046a4a98cadc7f2fdc7ae6efa2daef53a534bb87edb8",
      "translation": "我曾听说，这附近会出现拥有巨大卡蒙德的怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:eed8fd42c780629174eb6f413ab1efb32b41636ed6752e13813b90b7bda76e12",
      "source_sha256": "9e0439ea1c2553a8384d6391af85cc522c9edf5acfedf07c6f0f178cc7709b7c",
      "translation": "不一定一次就能拿到卡蒙德，请耐心找找。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9b9248f60427e9d3266ff4dd8b6a0c0700d1330e943a73282ad99d4e005d9ff5",
      "source_sha256": "5a4415cf4cc6dc1fd222254d8ff46979ffe37d1b7361bddab82c5fc18af59c26",
      "translation": "带来了吗？"
    },
    {
      "id": "coalesced:9af227c0cd00db3ed13d3eb9fef25673b2a7a0f2ca7cd48e6bac51e1d422b593",
      "source_sha256": "3ecfc3222a04b672b8a52023982f0493a6b79dc1e286fb7178416775a27beb71",
      "translation": "这颗应该足够了。"
    },
    {
      "id": "coalesced:05263bbff05dfb639ce50602820e52b36bbfde0d0ca21c3044924aaac727bf01",
      "source_sha256": "045f09097b75077ac1d923e8a8f004ba483017b9d80675ea001463faeee0472b",
      "translation": "距离完成还需要一些时间，请稍等一下～也请各位务必保重！",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9029e0ba6637c7bd09764875d60899fa0e05429475782c50c686e8a78233854a",
      "source_sha256": "f505d5e8dcca4bd8676c60459c9d1479c521ae8e8dc0f0151e3c480f927719c5",
      "translation": "请打倒出现在水色湿地的巨大怪物，\\n找到用于制作核心的卡蒙德，并带给伊格顿。"
    },
    {
      "id": "coalesced:a2ed2341183c61db3beb828172a471678ae9e93493922acdb1efca41beda88a0",
      "source_sha256": "fac95290a4ce01a1f084162fea6fbb3eae3ab9844d5d42b94406144289916e67",
      "translation": "QUEST%s: 获得巨型卡蒙德"
    },
    {
      "id": "coalesced:f6ffdb8c6693bbda90990b2a4346aecbe6ab6615c6945a570aeb56f301782ab0",
      "source_sha256": "655c67b2863fa7ac8e84dec5d490fdbbceaf1886ca888c520b913b007fc9a65a",
      "translation": "获得巨型卡蒙德"
    },
    {
      "id": "coalesced:512d83e991f624d4bee3b9a2e4d1d54076e277929dcba37754f1248736a02cc7",
      "source_sha256": "ded93398877e5141dd409437ad2438a11b86ff3d7a71462dcab57f884c7e5b24",
      "translation": "最后的材料"
    },
    {
      "id": "coalesced:7fdf2f8288a4f30b2fea9fcb8f52f7d80315485a513b20815c2b694fae9dd30a",
      "source_sha256": "e886fcbd37f030d0d9cfc4984ccf46190fd2c18cca74ef6f1ca9838d238ff6c5",
      "translation": "（得找到传送装置的材料。）"
    },
    {
      "id": "coalesced:344307758a0ba0c0cbfcaf3c048d3cca1e11e1bfc7525b6bf7e1f1e403f813c3",
      "source_sha256": "5a61155573673ca8c019864e6237095a6e5ff23c1b494996c7cffad5f7b0db96",
      "translation": "（去找伊格顿拜托我们找的材料吧。）"
    },
    {
      "id": "coalesced:65445c1915c257558ea8646b1c024e6877adabe617fbef880edbfa0d9a8f20ff",
      "source_sha256": "76fa94fb5618ef43a84dcdcbdb4d0cb90fc91121256117df172a192e6a440279",
      "translation": "（去找伊格顿说的材料吧。）"
    },
    {
      "id": "coalesced:0a7a6614334a395995e9928d0f705c9ec96b4ed3c787864f129c41d9b9e3c697",
      "source_sha256": "4c8a0f479d20ad89c5716f87f53f0c86a6e668801aa427dead734077f9fe1f46",
      "translation": "（得找到伊格顿说的东西。）"
    },
    {
      "id": "coalesced:d7d1aa026e47fa87de8f969c819c50cc1f8639f962aa84b740eb995c1cbbbf5c",
      "source_sha256": "55fefd0e989931792efa1130ac49e7bd5e5b3e83f8b677bb878a21f5982a9b2d",
      "translation": "（得找到传送装置的材料。）"
    },
    {
      "id": "coalesced:2c8733a0577dc4bc8716581d1ab83221e012ae68067b7906c8f5128df3a38dbd",
      "source_sha256": "e3c1417625158bb92e39f63b601214f902d6ea03beb2dc73fb2283a241aef0bf",
      "translation": "（得找来传送装置的材料。）"
    },
    {
      "id": "coalesced:e0ba705f8e28a462e403ae51265e59fdc7b3f36ddd14c424e9be14ee7038543a",
      "source_sha256": "600aa77f9a7e00b35aacfea812baf844f245dacc5d7870507aaceca665ca39cf",
      "translation": "梅雷花粉 "
    },
    {
      "id": "coalesced:df8d590461bcd58011587b1190002dcf0e6a98f99ec6351669044747c1f8b663",
      "source_sha256": "3eee9ca2bf762fc3528bbe7846526a77d5f716b35caa378c9e0909bca68b2477",
      "translation": "可从梅雷背上的花中获取的花粉"
    },
    {
      "id": "coalesced:0579ed79909c032fb845f113dc044d31ca9745417c5513246cae68819f141ac3",
      "source_sha256": "22de212c97e29f34c9b4828f22ba485379b0df807ae1efeb0eac2c9818a9776a",
      "translation": "特种合金"
    },
    {
      "id": "coalesced:987f455e476fc07829335228cfdeebdeef920cd78ed83533e37b0d5ffc4c682a",
      "source_sha256": "11eeb4ac84b32ee7156b72570111717524b079f1dea56affc60ac17216bc7bd5",
      "translation": "比一般金属坚硬得多的金属"
    },
    {
      "id": "coalesced:7f971eefe614f10505870d5379cf87802cf927a8975242640514d0dbf8d2ccd9",
      "source_sha256": "2637073aff14b0451907710364ae641dc372bca7ad0a5ff05c6b335ba545545c",
      "translation": "永劫卡蒙德"
    },
    {
      "id": "coalesced:0990728da313b35875554df4542e46576152cb4fda94b8eea7b4e19758c0c153",
      "source_sha256": "35fc807d4dd95d0ea8f061e866a9e3ac29f4472ee2c73b08552dec8ddc2ef7f0",
      "translation": "历经漫长岁月凝聚了强大精气的巨型卡蒙德"
    },
    {
      "id": "coalesced:b1602f77a3208641b7052663675feed82f417ef5d5804162e085ee3b18aaf3cf",
      "source_sha256": "411ae4ecc6dcc75953c0650cd28c85130c59cbbf1692a71824d12d8873f4b3d5",
      "translation": "黑珍珠"
    },
    {
      "id": "coalesced:af72e80b7f35a02c268c6ded2fc96dc838acbeafde267fd4218ffa38466e38b4",
      "source_sha256": "24dc786b57546ceec12b0f490afe88578a6be4494a73b93807431b1d8b690f14",
      "translation": "委身于黑暗者体内形成的黑珍珠"
    },
    {
      "id": "coalesced:3014b00f626666f91605587eca7fd82247a453032daa0eb11b4f1966a015f677",
      "source_sha256": "0ac4aa983c646ff5db4bf4b4c47b3f9344d9acae46c3f17e67b19f29bc284478",
      "translation": "材料已经集齐了，现在带去交给伊格顿就行了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b01f5e84d449908f7fad093a388cdd7e99c7bd9d2222b61a77be04142c3ed3e0",
      "source_sha256": "a5fb804b5919d42a1e7feebc8465195f10bd223047beb927eafe88b0d820deb9",
      "translation": "嗯。比想象中更快完成，真是太好了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6fe8d55915c6d4a0400cabafb9e52dd83176a3217d5dec695e5ad12dd88123f6",
      "source_sha256": "80c23c54e41cde76b7fc94e9a967642b75f462d6954bcdfa8226c6c6469ee877",
      "translation": "这都多亏了梅莉莎。真的很谢谢你。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d8e38cbadd085600ea52d76e11b4731a47e92c46781423221c6912f8b6f46f6f",
      "source_sha256": "fa174593efa0fc09b63527673684a0e8df68baadc09912a85aa58b875027ec8c",
      "translation": "不敢当，公主殿下。"
    },
    {
      "id": "coalesced:331606242351272282ee890a85ab690ba474c8d647ec5906ffc56f0fad6c5092",
      "source_sha256": "ce31978b5b85e26a20fe244cc042b2a220684d664feed9142f1db47bd23859ba",
      "translation": "我只是，唔……！"
    },
    {
      "id": "coalesced:1e60cb839d2768d4e6aa3c950ab06c1318b4435168562f03294ad10a13834f31",
      "source_sha256": "3cbfa139a3f6b8379d828d55b6e5d32566d2734bb6a34cf413ebb3a4dbd0fd64",
      "translation": "梅莉莎？怎么了？"
    },
    {
      "id": "coalesced:705b5aa62b7127aa0dcdc72f3dfd226f83f8e34d8311ba28cee8b73518dc3e01",
      "source_sha256": "8ffafa5e55f8338172b7d9926a39eaa6a2a2cc7cb6efda46bd9fd71048ffa020",
      "translation": "唔……胸口……胸口像烧起来一样……呃。"
    },
    {
      "id": "coalesced:34f73593a2410ae4086445e921891038e4b5f3581203cdd22b2e09fabfcfb9ca",
      "source_sha256": "e22db1174f3720a618177d2f3d73f9baf91d0476d5f86ef528732e0482dccd1c",
      "translation": "梅莉莎！！"
    }
  ]
}
