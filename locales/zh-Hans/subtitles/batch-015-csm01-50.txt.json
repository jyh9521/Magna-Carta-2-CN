  "entries": [
    {
      "start": 2824,
      "end": 5615,
      "source_sha256": "bae3f36f46ca73c302d35877be7e267d18a33f672f8c9c9a0befcd5535068312",
      "translation": "朱特，没时间了！"
    },
    {
      "start": 10984,
      "end": 15282,
      "source_sha256": "c6b055219e14dfdd8afef3c81311b263e12bb609ec97a5d9e2fa54e275ee7f8b",
      "translation": "想报仇的话，<br>现在就得想办法活下去。"
    },
    {
      "start": 20790,
      "end": 26665,
      "source_sha256": "1e3dc97e1eaf7eba6b661c88f9ab46940a26065472cdda6cc8fd482c329bf40e",
      "translation": "对不起，梅莉莎……<br>没能救你……对不起。"
    },
    {
      "start": 28014,
      "end": 32707,
      "source_sha256": "e757af1a53c52d669b55163d6dc16ae5a8f1f91faefba1df2a175ae4191806f0",
      "translation": "失去珍视之物的悲伤，<br>对自身无力的怨恨。"
    },
    {
      "start": 33402,
      "end": 37011,
      "source_sha256": "b88ecad93ec7121df4409d12900d41bc3fed9e80f198eb834770bc0b1db8f9db",
      "translation": "即便赌上我的一切，<br>我也想让时间倒流。"
    },
    {
      "start": 37693,
      "end": 42642,
      "source_sha256": "dd96e407412f1a5eccde7532788683a55dc8fa03d3a156d2b4dc291b37d94ffa",
      "translation": "可如今，我能做的，<br>却只有逃跑。"
    }
  ]
}
