{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:6dded9b10ad97dca9d09298dff5b41b2b4e4e91915711b825624af6e5d5cda9e",
      "source_sha256": "92b892023ec6c3acda0b0ceaf43f22db5f7b11590c16259bd173ae3ef9117b34",
      "translation": "虽然只是个小小的休息站，不过杜南平原这处休息站还是有个助手的。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0eabb899f83060b3d976cf5d7bbca374bcebee53a20f7cdcd3a2f221567db6e2",
      "source_sha256": "4c1496e77de933a079d6486f9943d390631aa1e450454a945f07a47ebf4b06ef",
      "translation": "可这小子不干活，整天就爱到处乱跑。您也看到了，现在也不知道上哪儿偷懒去了……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3fd2e2811448e91bab36cd328e3fb0becfa681a0250327720a6279d99cde90ba",
      "source_sha256": "58aad04bd0c788e93eec9f484dfe78e752a8e2b0bc5932d5ea36b70e45888000",
      "translation": "前些天，他说自己在这里东边的雷恩波尔特废墟丢了东西，得去找找。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:618e20915266a125ff1806705788e8ec2aa2d258a8dbc5480633170013a53bc6",
      "source_sha256": "ca84b374bd36a820a85b06c215b164f83b21199a999698097f1cd46f22e1395d",
      "translation": "要是真在找东西，他现在应该还在那片废墟里……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9f11e2828919d2a05f4281129146004e10fba4004564eb34d6de5f7b32d56207",
      "source_sha256": "eff6bf1e51797e523b50e9e652544cb695922efb274f6c56692c9bd8b1216337",
      "translation": "能否替我捎句话，让他差不多该回来了？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:99996821555f3b6eb50dd2c47f299f0a622ee340ab4cce2bef8c8bcfae15c6da",
      "source_sha256": "8583dce24eb71d478d640915fac254e443bbd307260ac2813f0df476b630b972",
      "translation": "马上就要忙起来了。"
    },
    {
      "id": "coalesced:715b648dc4a7e0f1854a7dc17e28afa2fc6ca2de9227184a1dcbf94c1084f416",
      "source_sha256": "5fef25e898a157f807b9867261904c9462adfa8257c38eed0a59befc44f83cb5",
      "translation": "雷恩波尔特废墟就在东边。"
    },
    {
      "id": "coalesced:08d423944167990f465721e18feec82e7d508881f5207a92a2f64290943c32a5",
      "source_sha256": "8668ef045b6cc546966281108f5a0fd77597509e07aa33ef34f402e9ebfd9702",
      "translation": "那小子应该也在那里。"
    },
    {
      "id": "coalesced:399eccd3d5e701ef08721858fbd897b66d2dede782742fc1fa2e1371074d0de7",
      "source_sha256": "3fd434dc9ac72ef24e1a376416962f9605df4395890efec25d7201548f3b5eab",
      "translation": "要是不方便，那就算了。"
    },
    {
      "id": "coalesced:89500f7453a71307adc2fdca27318ff7507658b2f2b4ce3cf29fc59b7960231b",
      "source_sha256": "851837926bf5ca92e571729e9d809427ce2edb1d98397d3dbe3e19740e9a8288",
      "translation": "唉，这小子真让人头疼……等他回来，我非开了他不可！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5d124c1d7f2266d33757340bac82863d59b9f833c49b8841d99077b172cdaab",
      "source_sha256": "6e465ba5a6972131b85ee7dacc46e840d34c724147158a974ecb91a2efcf45c6",
      "translation": "雷恩波尔特废墟就在东边。麻烦转告他，差不多该回来了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a29951ac5725169254c6f40a51599573e62f5009e0023b7c243c1e712132a331",
      "source_sha256": "8fdd60011ca55591fcbe82a0a5b07d34d75c420938dcf051b4cbcdd2d330c367",
      "translation": "要是真在找东西，那小子应该也在那里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e3238aaf39a905e028f1cdcaaab262fae3e52eebcc9d7f78b5ac9a9fd675479c",
      "source_sha256": "705893611bdd600dc8c3605f227e51eb9016a3a423461d194e1edbc2697a3fa4",
      "translation": "啊，您在找我？"
    },
    {
      "id": "coalesced:095f832a5ebf8bb8c54bce3e9bc456f72dfea516359cd89b3f24309d29c47373",
      "source_sha256": "e7b4720130f98043aa7d1fce3d13fa1d8ba65e1b1adbcfef013bc2854781e150",
      "translation": "唔……这可难办了。我觉得再找一会儿就能找到了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:659a1a14ffb862f9e817d73061c0ff7462bb2ec9b8fb4c13896ceb26163a4f2a",
      "source_sha256": "2bebc017ce2bda5958bd0653d122d13336ea37f5d05d32119e0f8ac204464e0c",
      "translation": "前往雷恩波尔特废墟，寻找休息站的助手。\\n雷恩波尔特废墟位于东边。"
    },
    {
      "id": "coalesced:b15f94277f4ee18150d5e45e190912735937515a235f4f779b347582f362c521",
      "source_sha256": "021d16ab2d4fec334a91ff89e8b1897b3bbe1c060cb1ec87f77c0df341e11ca4",
      "translation": "寻找助手"
    },
    {
      "id": "coalesced:eccc2484ddc94b50de4af71861a87b76db31d78c08a868e2b812efbc265cd392",
      "source_sha256": "3130c19f9c497f73f77faebec3ce581eefcb2b2bcb8e74f740719a2c646b71a2",
      "translation": "我前几天在这里丢了些东西。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:23f576d780c45eb0b300f80eeb1f673486b1d044e3829e4d9d491f7a19e472b8",
      "source_sha256": "6a1ddf48fce440ff1049e47832d186042a5ea4ef314ece487f0ece9e21bcf298",
      "translation": "方便的话，能帮我找找吗？"
    },
    {
      "id": "coalesced:46915d1006b470135521ee0cbd1b8583d244929ff53a87fc68c3c2546717b439",
      "source_sha256": "3e1934aeb8be2b03c1d996cf4af7c0e0ea8c52e83f15ed9212bf82de56113aa8",
      "translation": "我要找的是我的[日记]，还有装着几样东西的[小袋子]。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:e5a7f03aa387fac38dd7c1fff24c2729c5ed02bcc19e9c5fc7ca1f47fcee71d8",
      "source_sha256": "696950199b41503efd4584735d6181e1bea168a78ff163ea523bedd69e1b7b8d",
      "translation": "应该掉在这片废墟的某个地方，可怎么都找不到。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c96460bfbc4dc5dbd5d463518811a41afbfbe3a8e030892972aa8869336fd60d",
      "source_sha256": "35640463217803b43a7b50c4ee80c263852939f244e045a751dc874643882a26",
      "translation": "谢谢您。"
    },
    {
      "id": "coalesced:c7907b0ecae56d4cfc50af393726600d5796ffcf028b541f142dd9fce71e7c2a",
      "source_sha256": "a6e82e1b2a11072f12967262982b6329728c1e1d9f7563d3399f11d4fe71f8cd",
      "translation": "我们一起抓紧找吧。"
    },
    {
      "id": "coalesced:0c92440ee9a071dfa4979dfb10a29011c6ecd084195e11343786b8fce2c44393",
      "source_sha256": "3940bee5fe4acf23f5fcd3edc1c43e63a24148e3770e426a5ea8d2711dea5957",
      "translation": "那也没办法了。只好明天再抽空来找。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:959566b4d8935eeabda68f8e8a4d5b7ebe43978cbf90ceaaf7607abb0bc3829b",
      "source_sha256": "ae6b2c3654fd617583c51ec3750789effb265fc4063998f5685643c3f88bdf6c",
      "translation": "我要找的是我的日记，还有装着几样东西的小袋子。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:8a66509a90757a44cd65d7f48a2e54536d77c47112b957a1a64c352a115dad81",
      "source_sha256": "4f150845dd5ff05aa6625fcabd7e9994e34e8b9949dc7caab350737655000511",
      "translation": "大概就掉在这附近的某个地方吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d7b0f1a39fc71d08879d502d445c2bb2249a77fa40ebae1cac0cd51e4a619448",
      "source_sha256": "1296e2f4568d5e11a1fd5a270bd3684cde7a378e82dc906dea2d584ab4584425",
      "translation": "找到了吗？"
    },
    {
      "id": "coalesced:4d17169822c82d2b7b1e2d711cdcee27f1aa2ab8a4a6d78e7a9f193a593722d6",
      "source_sha256": "b3a94939856939fe9b44b8760e83caaa39d3329a2c1d841cf015bf9cd47f2190",
      "translation": "没错，就是这个袋子。不过，这本日记……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:aa0834d8d2d36dc4eafc3ecb919ff8bb3f0ac9bceb0d7a687239fdca6f4a7ec6",
      "source_sha256": "200191ccc0346144413658f81a6f85ce45f9a0891f00c13a4732ef6169c025da",
      "translation": "我自己的刚刚已经找到了，这本到底是谁的日记呢？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:567d06f47eed3292b99a74fa8deae5e2f2044de71bce3c31dd6459ddba5781d7",
      "source_sha256": "36afe9d3aac56ad199b63428d0eb2cd2ede97bcd2fc92238e924187f755e67db",
      "translation": "嗯……名字是……"
    },
    {
      "id": "coalesced:c749a40ac07afd85acb85360b99f70231cd501d4f7dfdeb9a44377cb59adfabf",
      "source_sha256": "5b3f490c6e5c102fcec4f974d6913a0923ee2d9a0f8cf3acaf32e175297ead97",
      "translation": "拜……泽恩……拜泽恩？"
    },
    {
      "id": "coalesced:6245c5986b74e8823f5a35ce043abd643a68d736ff9dd80f5fcb825c0680c61b",
      "source_sha256": "50c17429fd5ae1feb63f4e55201ce8e7ff4480d2c494f79440b7a73d573c47eb",
      "translation": "寻找掉在雷恩波尔特废墟某处的[日记]和\\n[小袋子]。"
    },
    {
      "id": "coalesced:5d262bf95827ebd014b2a6f4a9c129404b032b550731efc70ab0deb840cfb2e7",
      "source_sha256": "d4f5ae94c0184ed308c1dd10301c774db818a2b38aff0921277dcac0bf807b84",
      "translation": "QUEST : 获得小袋子"
    },
    {
      "id": "coalesced:9e94bb3b717466e6aa03c9b21c398826f320c959c7e05c52e50779887a426c61",
      "source_sha256": "46645cb2e1cfbc18946bc1f9f6934dc82ac54ece7ba5edc195ab19fa95668674",
      "translation": "QUEST : 获得日记"
    },
    {
      "id": "coalesced:22ec9ce3162e40a5ba260e2a2c78b4b9c43b088ed648f715ab4965de4e1bf3da",
      "source_sha256": "98d1140033efb33d2110a082ef6a4e8036fcbb2012f0cd29b4013bf47fa93329",
      "translation": "获得小袋子"
    },
    {
      "id": "coalesced:bab695344c7adbc0bc3fdbcf520982954a824a0df0f6ddd2f080ba3e83aac5c5",
      "source_sha256": "f2c3708b65039f2f4521557f39fafe26edebc7117269f9eb4c936f23f0307a25",
      "translation": "获得日记"
    },
    {
      "id": "coalesced:17dd1ae9fc8e241d4e09657ac2463064b85f72278bfdea22c07d7201553c1cb7",
      "source_sha256": "a0ff5b12a007a3639f400a1cbfc5778be75c31638651ad8ab6d972ff1c31a360",
      "translation": "丢失的物品"
    },
    {
      "id": "coalesced:a10e89dfc85d701bcd248151e1ee767f7f0f7606772763994975cb990b644b3b",
      "source_sha256": "4039d03c486a1597089c77bf588c5da1ea4d23fd8a61af149b4d11b3d02c2d95",
      "translation": "有人吗？"
    },
    {
      "id": "coalesced:af27dfbe96340a4a28ed443593e381b95e290f859af79ecb653c02d318c5f45a",
      "source_sha256": "7eb6c869681af0e1e37895165d58635e8b04c080b59a60c982626fbf54bdd1f0",
      "translation": "求求你们，帮帮我。"
    },
    {
      "id": "coalesced:a3b9ceb497788a4cb1ef85b416ee67f8359fa2a925ab753964b2a1a70dc43bd7",
      "source_sha256": "55bb703c93f88a306478a0442cf649c8a75d9294b01fe9e41682d432ed4d5d6a",
      "translation": "听说南部军现在驻扎在那里。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:634e847540aca83d9a3474bc47721b7da71df569c12dc083dba56766df29cc63",
      "source_sha256": "27b810c44a6a76b3a2df68d40f200c143a7cea7befe40c1336f4db688aaca31b",
      "translation": "可我在去的路上遭到了怪物袭击……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:21a42f5df3f2d8848d0bd4cad9b19a8b9309771d97727c9b9aca66a44d1aeb3e",
      "source_sha256": "6af5121d41b5f2cf718fed50a26da93a2d14b19148cd44401fcd58b4fb62f372",
      "translation": "请带我到休息站去。我一定会酬谢你们的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7bf83c1b11951c44128ce3a29518278d1e84094125079ed1484cba5f253ab04e",
      "source_sha256": "f6741aac747b9de088b00a12eb5b5de5ca5d5d2b3b78f5bfa9be9e11bacd70bc",
      "translation": "我还能勉强走路。只要帮我对付附近那些危险的怪物就好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:d0a826fdeabe7e52d151df41b9880a7ff3f7fc2d880bc3360df8f96884e1109b",
      "source_sha256": "e9998d943946816d3c5e2536cfa61505d95724c403ef569a802694ab262dd4bb",
      "translation": "谢谢你们。啊啊……我还以为自己真要孤零零地死在这种地方了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:34bd816c8919ffa1c908f2fab7df00e28effbfe5f3f5fb14e9545a8e14574bdf",
      "source_sha256": "9d992ffad65706c2589f877cd11710ea6dd20fce4adcbc86a47e00c10bae4aa3",
      "translation": "那就拜托你们了。"
    },
    {
      "id": "coalesced:02257e3b7f9cdedccc81817bb6059e5f5b9bc366a4f4633f65b11f205932b5bd",
      "source_sha256": "e6a1402b2e31d16b2a220f5b8bf233742e812b0a93683a64dfad23a67a2825f0",
      "translation": "啊啊……把我一个人留在这种地方，我会……！",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2964605b805086f3df03786d0bd98c34cc224e34fdf15999b5004caa0104a0d4",
      "source_sha256": "2ccf026121b3ec6953c281129bb0be770e632940a44b941cbfde28d623a8f939",
      "translation": "求求你们，救救我！"
    },
    {
      "id": "coalesced:8ab3f08f969a7d4a8b772eab43eb386fdf29e21846dc061f136e66ee261815d8",
      "source_sha256": "136188b46dd7a12c597dd635b4478aa1a3f4da282664e898d872e6d26511d862",
      "translation": "啊啊，谢谢你们。我真不知道该怎么感谢才好……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:171e4134091e162b7ebadf10f52d12e4706ca70e1abe0c0d96d58ab23ac8a08d",
      "source_sha256": "7f025b7e495cee313ca27652838f57dac23cce02b2e5df904c321e61b4304ffd",
      "translation": "这是一点心意。请收下吧。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:45c2d30ccd401ec191f7a362bb74a8be0c8cb2a620436cd69cc2d41d7ae37d64",
      "source_sha256": "54350021e2a6b61afb51dfe29d6e69286252cd99fdd2df066757e527a5204696",
      "translation": "安全护送腿部受伤的旅人，\\n带他前往杜南平原的休息站。"
    },
    {
      "id": "coalesced:67f3a39d9d4521b474aa2d3878c7c62407381f7822ec12bb752f1bef53cccb01",
      "source_sha256": "d75f463c509c112044b11ae47130835981c6e11f14b0be80758b593545f7dfc5",
      "translation": "前往休息站"
    },
    {
      "id": "coalesced:5f7658047aa491598d6f12019115463b28c59589c66d9db1cba6f1e1995acfd5",
      "source_sha256": "ee3d5b01cca0539efacc1b48c2d19c59227ab080f554d11ba736b2c225e8fb75",
      "translation": "出现在拉诺阿拉湖的那头怪物真的非常巨大。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bef9f81430756d6a8faf0fdb8a18f4b9a0cf053237c2fbfdfe74c6faf080905f",
      "source_sha256": "53f5bfd5f661e506ab6fd486b6b9e33e16ca29cfce94bb9d2e825e4d4d3e1b93",
      "translation": "它只把头探出湖面，那颗脑袋就已经比我整个人还大了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9379ff3844d425da834d4c76d9793a4d5356131328f3b7f7e22f3850f8d84699",
      "source_sha256": "b08faabe96f435fbe0f3a923f73ecf1c165272f43507abe849f52f242bb06a96",
      "translation": "这样下去，前往湖边的旅人会有危险的。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:f2ec4dfda8dc2c03d370134606359db1a7f54976a9d38341fa9b5210e151ca5e",
      "source_sha256": "111fab77689553f6a15abb2f4d3456e0ae6feb501acd05aa29b933ba73a7c712",
      "translation": "所以我才冒着危险前往杜南丘陵，希望能得到南部军的帮助。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a94c7633fb81bf3046d614eb573c37292c1dd6813c269d76afee8eeccdab1b2c",
      "source_sha256": "0f8c7717455742602806b99aec72dc321fc4d1dc048999f73a184315c7f4258e",
      "translation": "你们看起来也很有本事，能帮忙消灭那头怪物吗？",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:05a1708ddcf256073d17b6aacb13db12dc5dea2e2ac8b7040d4c8ba0fc5a4a2c",
      "source_sha256": "dd5095204323f7a801be5127774cbcc47288af122e1d2d1dd9886e56f65c2698",
      "translation": "拜托你们了。请一定要打倒那头怪物。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:1a02c1ac9e9c46bc95f5af3e5b858f063d4b05c9d821315aea64f05fd4979a4e",
      "source_sha256": "2ae67cd0a09d924ad05f70ddde9f6bd220af1826f484ba62c7aa51966da99ca7",
      "translation": "拉诺阿拉湖位于杜南平原的西北方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:39c186432d593aeef679c358072c350413b3e74a10f3c5d389463527fd37b0b0",
      "source_sha256": "6b83cc9966b4bed885881f3894cfd1a58f78010d328e734b745c71408a18e11f",
      "translation": "要是放任不管，会有很多人受伤的！拉诺阿拉湖还是著名的阿塞莉娜大人宫殿遗址……",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:0fb0e7316093fad2cea8e3aa916732e7b7c2cdc0b5fa32e9a6841ef0e787c5d3",
      "source_sha256": "08a073ebc352c1b181fd2ade57c6adb582c5b42590cc9258b8a1ccc5411476f3",
      "translation": "求求你们了。"
    },
    {
      "id": "coalesced:e405fe2c1a87ec32a589b5bdb8f08b095d40ab0e3d78cfdfda0d65cb6ea11419",
      "source_sha256": "2ae67cd0a09d924ad05f70ddde9f6bd220af1826f484ba62c7aa51966da99ca7",
      "translation": "拉诺阿拉湖位于杜南平原的西北方。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:fde3a093b97f41dad59239a941542cfacb7a9e8a5d89de514ad77f0a6da0e82e",
      "source_sha256": "ef1aa5b756043b082fccd5d506bb5dfd209b07828a1cd2718776703ba3dbcaa8",
      "translation": "你们打倒那头怪物了！"
    },
    {
      "id": "coalesced:04087c957ed80126ca3a3b14b78b807b1728a55df250a9f84b181d0f5815ddfc",
      "source_sha256": "f628eee55b822ea682b7a56863026cbfdd5daa28c34f6a84e070ca9154e670c1",
      "translation": "真是太厉害了。拜托你们果然没错。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:b27d32ec840a7bdd2724f201c5b0b867caed924c22e01c25f8cfff7a6a72ed81",
      "source_sha256": "6736e78076ae62752209bf7d60e87f9e3da5ec2e86642f56d6130dbb4fb660b6",
      "translation": "这样一来，那些前来游览拉诺阿拉湖的旅人，就不会再因为那头怪物而遇险了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:bb2ac0649f927aa7b9a5b2ebfb58f7e3be9807dfd5e305375df8050afbe7b831",
      "source_sha256": "f11a4d189758fc77f679baea0fee78f4858cf2ca31265577de08530b959d3b0e",
      "translation": "打倒出现在拉诺阿拉湖的巨大怪物。\\n拉诺阿拉湖位于西北方。"
    },
    {
      "id": "coalesced:69b52a31a8b556fe70e7d356b27556b5b9504df0985769c8bc3b1523e5497306",
      "source_sha256": "a882260488a7c01455db93bfd33577e67cc385da6411b2eb9d7022b75ada8d70",
      "translation": "拉诺阿拉湖的怪物"
    },
    {
      "id": "coalesced:ae3778573ebe027c221002d61c40a4f516325a5758ed5f209fc1abb9778c1df4",
      "source_sha256": "81123f1f5190973d16e0b2a08c3535a16d7406bd89361d3ddd07bf76a0a175ae",
      "translation": "QUEST : 已消灭怪物"
    },
    {
      "id": "coalesced:26ec8ca081c7a94a815b1276776ee28ce3a608b4f93f7b227f42b5d783f29e7d",
      "source_sha256": "183d113fb90cd152af8a7ba844ca53bd97d23426abfe7151107c50445685663a",
      "translation": "已消灭怪物"
    },
    {
      "id": "coalesced:1a2358a61779c7669a982b0e5609dc836dfb5e79b923e045eeb4da483a8c28c3",
      "source_sha256": "95a5b2826a7ac90ca953dcab935e0cf7e399d24e8c450047d9e7c910e23f5f99",
      "translation": "拜泽恩！？那不是爸爸的名字吗！"
    },
    {
