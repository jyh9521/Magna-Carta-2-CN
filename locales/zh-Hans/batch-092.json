{
  "schema_version": 1,
  "source_mode": "sha256-utf8",
  "resource": "MC2Game/Localization/Coalesced.int",
  "input_sha256": "179e265cfc9e6d3e9f2586abe75b5da303b2af9b8484079851dab72f9f7edb8c",
  "entries": [
    {
      "id": "coalesced:17e88cba33c0137b5023829961a51f71b7736ac0f3d90c82a07e31210ec2b7b6",
      "source_sha256": "e41720dadb651ee49b7f2893462f1a2ce33f33a36cf2da5c35c368d8b518011e",
      "translation": "侦察水色湿地时，就能发现许多事情。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:22faba32b4859e6f0df11be8894bf7567e4446b13c3cf57fe07433eef118fe06",
      "source_sha256": "1cdbef77fe1aaa50164d5143e54167583e6e0c884044bd0992114d28b80c5d63",
      "translation": "比如，现在威胁马雷族的，可不只有北部军。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2f57ad7eecd5b41e9cdbd9e4b8e191b8a259cac0978b689f096417df619a25b1",
      "source_sha256": "f2f322963fd4fcea80a2e55fc96ba1d15c83fbf412eb5154eae543a7982190f6",
      "translation": "水色湿地北部，住着一群把灵魂卖给暗黑连环术，就连肉体也染上黑暗的家伙。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:74ec447b31767f8d0718dce10a7a90c9b165936cfb3208ce8b2206b601cf727c",
      "source_sha256": "100be303781b95976448b8f48c25e9bd69221c07d73423da4d74b12ca96d4dd7",
      "translation": "那些家伙，叫作[布莱博拉]……据说，他们加入了北部军，还帮着制造怪物。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:2457f075c4cb53510e2491b71dbbbdea9963ffb83920d86d9214352a0596a693",
      "source_sha256": "591507ba2b3bd6d58c38c9404066738c438cc147bb5defaaacd5a5e0a38690f2",
      "translation": "听说，是你们救了尼尔提。我相信你们的实力和为人，想拜托你们一件事。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7efad52243d8d32cdc434d70c52983425b6d1c5e58971bcebfd8cdba32c07e12",
      "source_sha256": "36fadf59eb17fd6bfd36b513ef3356893899434e37364bf9c9c7fb0702a22944",
      "translation": "请去西北方的暗影藏身处，打倒那些布莱博拉。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:299726e595bebeff48a4116c47761335749f6f0a8c77febd5955b08fb32aa5b5",
      "source_sha256": "f6594710599a60e79f18313da7a2efc73d24a4a9c5370b7b9679e27759c4ae9e",
      "translation": "不用勉强，打倒6人左右，就能让他们明白，我们绝不再容忍他们的决心。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:6a32c9f57e4edc86d5c5ef6da4b9acae10fba9c1304e360b5f9075d42e4cc0c3",
      "source_sha256": "489fdaf366f02b47b04813226c0603f65c8d17292eba1286420c4a1c5b71f8b9",
      "translation": "哼，原本请外人帮忙，就有些不踏实。你们拒绝了，我倒也痛快了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:44d4eaeb2d701fcc68e350a6476e62492fa660fdec300d1f85961ea7f4f74b16",
      "source_sha256": "15dab4e16c1ae3ddb4539ee2850fa6e292101b9edcd332ead27aef8f076aeb23",
      "translation": "请去北方的暗影藏身处，打倒6名布莱博拉就好。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:a678dadff4a4ca6d7e40264df4c2c419f6ef2000786ebb7f5b418692a4cdad45",
      "source_sha256": "857eee6a963f10f42c924873e57ceb27914742b42004001bf42211cf9de59db1",
      "translation": "干得好，不愧是能救出尼尔提的高手。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:912acc486dca83d1ba133aa74f5a4063e3b417c26e82654079baa62c51872dc4",
      "source_sha256": "9a91a9faaee5979cc0bfd063e4d9be647d0757b1c0c8f3cb26e60b0de69e4770",
      "translation": "这样一来，那些家伙，应该会安分一阵子了。辛苦了。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3eaea61325c792682b1d74414e4bbe734eadaf93816217a2fa2b9e508ba099b4",
      "source_sha256": "1106aa432777d0b954b5af4de16c0000e701a0795f8a58372bd58b81a32cd1e2",
      "translation": "前往北方的[暗影藏身处]，\\n打倒6名[布莱博拉]"
    },
    {
      "id": "coalesced:3576254a4e03aa6c4424a23e18c1e649a6db2c0c88717389cd008f56a92f0402",
      "source_sha256": "a4215dfd2f38dfc5e1c480871045c5904dca739ab2d1a2dc2018e06d8eb82a66",
      "translation": "QUEST%s: 讨伐布莱博拉 (%s / %s)"
    },
    {
      "id": "coalesced:232659e3c3f21e2b98bbe64d5b67d0ebc4a2e47611543df0c6773f9a8b3ef345",
      "source_sha256": "88dd8dade4d94af3ec50b1096228a5486b413c9f71cc341cc6e5bff512cf4aab",
      "translation": "暗黑连环术师"
    },
    {
      "id": "coalesced:f7a8f934bcd7b908bbe4a6bcee8d2fae56c97c7160397e4420dcdd32dd41de10",
      "source_sha256": "93f39e179cf3cacc0376195b5c14aae9e48a7b79805121f887b08a366e5ddae8",
      "translation": "讨伐布莱博拉"
    },
    {
      "id": "coalesced:176d238a29a5d94533ff09085f1ee77812abc745b9b11f8861ac66cf3b1c2f84",
      "source_sha256": "d030f54f3dd5b76d75080b08f02caf0560a1ba645e2f2da041a8899f202699ca",
      "translation": "啊啊……不该那么做的……"
    },
    {
      "id": "coalesced:172d7c663f5ba5edf4074c86b1e5de4cd12c790fd2583f399bf5766efe2d52cd",
      "source_sha256": "e92ef6ab2abdd6e34f95a4c9d305f8bf77a9ed5746d06978a42dfbbcc400c797",
      "translation": "违背族长的话，来到这里……不该那么做的。"
    },
    {
      "id": "coalesced:02bafd20efbb4db6ba6c45704cf652bae79efe5324b8dd7e7baf4d8e61e65480",
      "source_sha256": "446bd13b71c6cefe9ea9e85ab61646ea8f7828b4d58a100594266fc1ab34b3af",
      "translation": "这样下去，我也没法安心回去。请听听我的请求吧。"
    },
    {
      "id": "coalesced:4705e88472fada5df5744112f8e40d6892d993a4f427b1df432a10f2c0a03327",
      "source_sha256": "fce281012cc80dbf5f44813f531302f65201a4e17d1a3d9092a470fc95a539ab",
      "translation": "前面，住着吞吃了我的怪物。"
    },
    {
      "id": "coalesced:0c7a2688a0fb006d380cd71932292c6d45f47f2eb6d89fe338a771d1c621af90",
      "source_sha256": "3edf105d47b7aa5d0f2aee2141e9bc1db407cfee4fb8ce0309b58e57234be15e",
      "translation": "请打倒那只怪物，把它肚子里的项链，交给还在担心我的族长。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:9df0f0b9b82819cb8fc6e9ec696c5c74770f701df1474539c2225a61bad29681",
      "source_sha256": "f75ac409b692480d362ac8ecfa7a5fe000fa53d30d3f44502fb4c3b4e59f8ad8",
      "translation": "这样，我才能安心离开吧。"
    },
    {
      "id": "coalesced:3a52960fe57dfcc7fc50aa603f1441372c6f1aacff1295dbb2ed8e04374cc337",
      "source_sha256": "04023fe47ca42a29b2182d997ab0bc27e9c32fa245d8f239169399c628df18f6",
      "translation": "请小心，别变得和我一样……"
    },
    {
      "id": "coalesced:5b2d67d503f35e7e24ed20e89f7162d4abecf74ba7f302ad6c1097d5db200589",
      "source_sha256": "d2c1d864dc9543510433c35e077175b50a0cd5352c20060fca5e66c62edf0bff",
      "translation": "啊啊……求求你们，求求你们……我都不知道，已经多少年没遇见，能拜托这种事的人了。",
      "line_break_policy": {
        "source_count": 2,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:ce64fa89adb3b1772154301cc273e70267e7568a25f07d011ec156db9c33fd3f",
      "source_sha256": "59a4da3b22a88a683d57d4f5a828e4aa8953b523c5fc2baae0ed8271ac0dccc2",
      "translation": "请打倒里面的怪物，把我的吊坠，交给族长。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:3e0b691f68eeb5dabcbf402d8346d12342d4e29c312e4e6e5ec6c9dded6c6069",
      "source_sha256": "092bb820837136b24a2af8f28fc901c6f589bfe1581657a0dfd5408953c2585b",
      "translation": "啊啊……就是那枚吊坠。你们找到了啊。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:931441bce14590614747cce3c9cf781a5bf5fd4115e3d61725e4bef77abb6357",
      "source_sha256": "09fbc08ff0da0d955cc2e79c5c8befbad9b3600c7a6e1cbc979c9d46b9ee6983",
      "translation": "请把那枚吊坠，交给族长。"
    },
    {
      "id": "coalesced:b26c57f85d190be802020f81fc6b1ad110d3e19653fe33423d1a3572458d3280",
      "source_sha256": "f9ced5f94aab9af69047b0d3285fc1456c9809ecfeceeca02fecf8bdb6adb598",
      "translation": "这枚吊坠……啊啊啊……"
    },
    {
      "id": "coalesced:3e8133760e1e3dcef23d07b3d967375ac60a7ed31348b83e54a282ca173c40f3",
      "source_sha256": "84170c637f46206f90f2646938fa98e9ff52c27c3feb7be91ff76a682b39d14f",
      "translation": "那孩子……那孩子，竟然变成了这样。",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:7fa996970fd456abcbb0c6c439e81023764d91c8adb783f41c4eaf5f553eaf6f",
      "source_sha256": "b9292441ff7bf797f12513dc0f41793c3adce3fa6ab15278591889a7a22240ec",
      "translation": "那孩子，一直向往着外面的世界，我还以为，出去了以后，也过得很好……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:24c69fa7823843f47cd6a3815aff7cfc99c81b8c6400e38422aa818f4d33baa4",
      "source_sha256": "46da3e17c5b97e0a4fba7a729298154209ea33894f70b444479d0446f4dfc99c",
      "translation": "怎么会发生，这样的事……"
    },
    {
      "id": "coalesced:d7bfd2df64b2d9ec7a5700dd661f203c5c9d287b72619e9c9960dca0c3917791",
      "source_sha256": "2d5fbf740b044c8769106bb425014f191da8e7aac86d2e875e70bff9e75f14c9",
      "translation": "谢谢你们。如果不是你们，我恐怕永远都不会知道……",
      "line_break_policy": {
        "source_count": 1,
        "target_count": 0
      }
    },
    {
      "id": "coalesced:c043e125f1f57b1152660433ecbc5347196aaecce679dbbc4c4482d916700b2b",
      "source_sha256": "38b88c2af90aecac7a0d27f7b8b5d3e449f43b36ea65a272cddad718fb4553fb",
      "translation": "为了死后化为幽灵的马雷，打倒海底洞窟深处的怪物，取得吊坠，交给柯塔马雷的族长凯汀"
    },
    {
      "id": "coalesced:c9a69ef7794a809eca1aac051129a6a9fe126600e21201e6fefc2e5bfce7be26",
      "source_sha256": "548e131650022364516a740842c01fa8b7ac695d4f88b2fd3173be08fa8fbfb6",
      "translation": "Quest%s: 获得马雷的吊坠"
    },
    {
      "id": "coalesced:575159b8ebcb21ecfbe6f8d5d13242488df8efec11000caeb711a2a70a611a35",
      "source_sha256": "039c416fe6d69f215277725459a8bb62beb5d261e093a78dadae2225d01cd7d4",
      "translation": "马雷的幽灵"
    },
    {
      "id": "coalesced:dc89fac9d2ff05f98236057f164846b7717b1b4f3b6090a14d21bc41d063c685",
      "source_sha256": "35899f0c4f72e71d7ca2ad58dd21e0666b041d54dce6c9b3891381ff106b9549",
      "translation": "马雷族的尸体……"
    },
    {
      "id": "coalesced:3762d79af2e616721a27af01c27d054fe217a1826f74b22f1fb4180ecac3a310",
      "source_sha256": "3bd185023e67667663395ca882966902b9c05f64325c4da8438140210c150986",
      "translation": "暗影藏身处"
    },
    {
      "id": "coalesced:b9cbe065def56be94669d448ea1c91a28cb576844519c60dfc7c679d46365940",
      "source_sha256": "34bd0fdd93f4d8338542625d9d5986f0f67e2b84085be7edd2524c6ce4df8f24",
      "translation": "马雷的吊坠"
    },
    {
      "id": "coalesced:45a04fd3fbffc8c8a0c3f234508535229ab0e95a12068b82371bb606e7063014",
      "source_sha256": "86d0b321d3f27014bbb15109fb772263ee6ac766c2fafdfadacaf2d190795733",
      "translation": "被怪物杀死的马雷族留下的吊坠"
    }
  ]
}
